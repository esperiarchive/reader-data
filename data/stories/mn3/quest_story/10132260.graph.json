_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1013226002:1":{"key":"say:2:1013226002:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1013226002","action_index":"1","choice_index":"","choice_id":"","source_cn":"研究一定要顺顺利利的！我知道，阿莉雅喜欢月神遗殿的程度...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1013226003:1":{"key":"say:3:1013226003:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1013226003","action_index":"1","choice_index":"","choice_id":"","source_cn":"你才是，希望这一路上别惹什么麻烦。各位，菲就拜托你们了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1013226004:1":{"key":"say:5:1013226004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1013226004","action_index":"1","choice_index":"","choice_id":"","source_cn":"不过，说起月神和宝石，最近我倒是听到一个和两者有关的传说……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1013226005:1":{"key":"say:6:1013226005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1013226005","action_index":"1","choice_index":"","choice_id":"","source_cn":"哦？和宝石有关的传说，我要听！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1013226006:1":{"key":"say:7:1013226006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1013226006","action_index":"1","choice_index":"","choice_id":"","source_cn":"说是……向月神遗殿的泉眼投入月光石，可能会得到月神的启示。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1013226007:1":{"key":"say:8:1013226007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1013226007","action_index":"1","choice_index":"","choice_id":"","source_cn":"神启？感觉好有趣！老师，月神遗殿就在附近，我们去看看吧！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1013226008:2":{"key":"say:9:1013226008:2","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1013226008","action_index":"2","choice_index":"","choice_id":"","source_cn":"月神？不可能。谁都知道，月神早已陨落，艾雅才是唯一真神。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1013226009:2":{"key":"say:10:1013226009:2","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1013226009","action_index":"2","choice_index":"","choice_id":"","source_cn":"菲，我要是你，就不浪费珍贵的宝石了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1013226010:1":{"key":"say:12:1013226010:1","kind":"say","so