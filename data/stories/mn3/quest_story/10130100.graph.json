ActionNode","statementID":"1013010002","action_index":"2","choice_index":"","choice_id":"","source_cn":"我们只是尽力而为，真正的英雄是你们——大驾光临的圣堂骑士们！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:3:1013010002":{"key":"choice_prompt:3:1013010002","kind":"choice_prompt","source_node_id":"3","source_node_type":"__DT.MultiChooseNode","statementID":"1013010002","action_index":"","choice_index":"","choice_id":"","source_cn":"我们只是尽力而为，真正的英雄是你们——大驾光临的圣堂骑士们！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1013010003:2":{"key":"say:4:1013010003:2","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1013010003","action_index":"2","choice_index":"","choice_id":"","source_cn":"只是想说说看嘛。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1013010005:1":{"key":"say:5:1013010005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1013010005","action_index":"1","choice_index":"","choice_id":"","source_cn":"艾雅在上，我是隶属圣堂的圣骑士，目前带领一个小队途径圣石镇。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1013010006:1":{"key":"say:7:1013010006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1013010006","action_index":"1","choice_index":"","choice_id":"","source_cn":"我是副队卢修斯，我们抵达圣石镇不久，恰好碰上魔偶来袭……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1013010007:1":{"key":"say:8:1013010007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1013010007","action_index":"1","choice_index":"","choice_id":"","source_cn":"请允许我告知各位，如今被称为“魔偶”的怪物——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1013010008:1":{"key":"say:9:1013010008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1013010008","action_index":"1","choice_index":"","choice_id":"","source_cn":"与女神和圣堂有关，阻止它们为祸人间，也是我们的责任所在。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1013010009:1":{"key":"say:10:1013010009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1013010009","action_index":"1","choice_index":"","choice_id":"","source_cn":"“善意之路，通往深渊。”你们的女神，当初就不能少慈爱一点吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1013010010:2":{"key":"say:11:1013010010:2","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1013010010","action_index":"2","choice_index":"","choice_id":"","source_cn":"……你不够虔信，这并不是我的损失。","textdes_i