"document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1721602002:0":{"key":"say:2:1721602002:0","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1721602002","action_index":"0","choice_index":"","choice_id":"","source_cn":"王子殿下已安全返回王宫。我也加强了那边的巡防。我记得你...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1721602003:0":{"key":"say:3:1721602003:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1721602003","action_index":"0","choice_index":"","choice_id":"","source_cn":"……父亲，我想跟你谈谈圣古堂和佩吉的失踪案，我请求参与调查！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1721602004:2":{"key":"say:4:1721602004:2","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1721602004","action_index":"2","choice_index":"","choice_id":"","source_cn":"我记得我在王宫里已经说得很清楚了，这件事由我和梅林阁下...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1721602005:0":{"key":"say:5:1721602005:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1721602005","action_index":"0","choice_index":"","choice_id":"","source_cn":"你的任务是待在驻地，处理日常治安事件。怎么？我的命令现...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1721602006:0":{"key":"say:6:1721602006:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1721602006","action_index":"0","choice_index":"","choice_id":"","source_cn":"这不合理！父亲，我是守备军第一分队的队长，王室成员失踪...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1721602007:0":{"key":"say:7:1721602007:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1721602007","action_index":"0","choice_index":"","choice_id":"","source_cn":"更何况，佩吉不仅仅是公主，她还是我的朋友！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1721602008:0":{"key":"say:8:1721602008:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1721602008","action_index":"0","choice_index":"","choice_id":"","source_cn":"正因为你是队长，你才更要服从命令。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1721602009:2":{"key":"say:9:1721602009:2","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1721602009","action_index":"2","choice_index":"","choice_id":"","source_cn":"能够让整座圣古堂在所有人面前消失……这背后牵扯的势力、...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","docu