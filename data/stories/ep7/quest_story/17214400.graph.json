_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1721440008:1":{"key":"say:8:1721440008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1721440008","action_index":"1","choice_index":"","choice_id":"","source_cn":"但殿下他竟然晕船，刚出发就吐得厉害，现在病倒了，还躺着呢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1721440009:1":{"key":"say:9:1721440009:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1721440009","action_index":"1","choice_index":"","choice_id":"","source_cn":"病了……？！殿下他……严重吗？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1721440010:1":{"key":"say:10:1721440010:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1721440010","action_index":"1","choice_index":"","choice_id":"","source_cn":"不严重，吃点药调理调理就好了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1721440011:1":{"key":"say:11:1721440011:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1721440011","action_index":"1","choice_index":"","choice_id":"","source_cn":"不过嘛，这药得长期吃……你要是真想支持他，就再给点儿药费吧？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_