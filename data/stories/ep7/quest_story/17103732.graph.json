_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1710373205:1":{"key":"say:5:1710373205:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1710373205","action_index":"1","choice_index":"","choice_id":"","source_cn":"现在她女儿又跑去强拔石中剑……这对母女，分明是想窃取王权！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1710373206:1":{"key":"say:7:1710373206:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1710373206","action_index":"1","choice_index":"","choice_id":"","source_cn":"哎呀……现在回想起来，当时公主殿下的态度确实有些……太...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1710373207:1":{"key":"say:8:1710373207:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1710373207","action_index":"1","choice_index":"","choice_id":"","source_cn":"啧啧啧，那种势在必得的样子，真是对先祖毫无敬畏之心啊。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1710373208:1":{"key":"say:10:1710373208:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1710373208","action_index":"1","choice_index":"","choice_id":"","source_cn":"没错！当时连大法官阁下都劝阻她了，可公主殿下根本听不进...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_im