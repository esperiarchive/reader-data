006","action_index":"1","choice_index":"","choice_id":"","source_cn":"你的手……为什么这么凉？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1711166007:1":{"key":"say:8:1711166007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1711166007","action_index":"1","choice_index":"","choice_id":"","source_cn":"莫德琳……你失言了。你曾答应过我，无论发生什么都会照顾...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1711166008:1":{"key":"say:9:1711166008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1711166008","action_index":"1","choice_index":"","choice_id":"","source_cn":"但这份温度，这份触感，皆为真实。我把你从黑雾里拉回来了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1711166009:1":{"key":"say:10:1711166009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1711166009","action_index":"1","choice_index":"","choice_id":"","source_cn":"这里也不是说话的地方，马克西姆，我们先回你的寝殿吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1711166010:1":{"key":"say:11:1711166010:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1711166010","action_index":"1","choice_index":"","choice_id":"","source_cn":"你刚刚苏醒，身体依然需要休息。"