3","type":"end","source_node_id":"13"}},"text_entries":{"say:1:1710741201:0":{"key":"say:1:1710741201:0","kind":"say","source_node_id":"1","source_node_type":"__DT.ActionNode","statementID":"1710741201","action_index":"0","choice_index":"","choice_id":"","source_cn":"格温妮丝，快看，这个影子……好像你！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1710741202:0":{"key":"say:2:1710741202:0","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1710741202","action_index":"0","choice_index":"","choice_id":"","source_cn":"……不，她就是我。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1710741203:1":{"key":"say:3:1710741203:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1710741203","action_index":"1","choice_index":"","choice_id":"","source_cn":"原来，在这个漫长梦境的尽头，我要战胜的从来都不是什么巨龙……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1710741204:1":{"key":"say:4:1710741204:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1710741204","action_index":"1","choice_index":"","choice_id":"","source_cn":"而是那个总是害怕让父亲失望，总是觉得“不配”的我自己……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1710741205:0":{"key":"say:5:1710741205:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1710741205","action_index":"0","choice_index":"","choice_id":"","source_cn":"格温妮丝……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1710741206:1":{"key":"say:6:1710741206:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1710741206","action_index":"1","choice_index":"","choice_id":"","source_cn":"没关系，艾尔。我只是发现，那些旁人的质疑、嘲笑、否定…...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1710741207:1":{"key":"say:7:1710741207:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1710741207","action_index":"1","choice_index":"","choice_id":"","source_cn":"但其实，是我自己把它们捡了起来，藏在心底，一点点喂养成...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1710741208:1":{"key":"say:8:1710741208:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1710741208","action_index":"1","choice_index":"","choice_id":"","source_cn":"是我允许这个“自我怀疑”站在高处，时刻俯视着我，嘲弄我...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1710741209:1":{"key":"say:9:1710741209:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1710741209","action_index":"1","choice_index":"","choice_id":"","source_cn":"但现在，我不怕了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1710741210:1":{"key":"say:10:1710741210:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1710741210","action_index":"1","choice_index":"","choice_id":"","source_cn":"我不完美，我也许还会失败。但这都不重要了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1710741211:1":{"key":"say:11:1710741211:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1710741211","action_index":"1","choice_index":"","choice_id":"","source_cn":"我不需要再拼命向谁去证明，我有资格站在这里。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1710741212:1":{"key":"say:12:1710741212:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1710741212","action_index":"1","choice_index":"","choice_id":"","source_cn":"我是格温妮丝。手中的弓，就是我唯一的回答！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:玩偶艾尔":{"key":"speaker:玩偶艾尔","source":"玩偶艾尔"},"speaker:格温妮丝":{"key":"speaker:格温妮丝","source":"格温妮丝"}},"stats":{"source_node_count":14,"graph_node_count":13,"effect_event_count":0,"text_entry_count":12,"speaker_entry_count":2,"cast_state_line_count":12,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}