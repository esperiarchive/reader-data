8]._action","res_name":"Man","resource_path":"Character/NpcPart/pbsc_char_npc_man_lightbearers_ep7_craft.prefab","resource_code":"man_lightbearers_ep7_craft","resource_stem":"pbsc_char_npc_man_lightbearers_ep7_craft"}],"position_events":[{"dialogue_position":"1","event_type":"AppearActor","source_node_id":"15","action_index":"0","json_path":"nodes[15]._action"},{"dialogue_position":"5","event_type":"AppearActor","source_node_id":"17","action_index":"0","json_path":"nodes[17]._action"}],"active_actor_ids":[],"line_animation_set":"normal","line_json_path":"nodes[20]._action.actions[0]","line_action_type":"__NC.Tasks.Actions.BlackScene"}]}},"end:21":{"id":"end:21","type":"end","source_node_id":"21"}},"text_entries":{"document:0:626:0":{"key":"document:0:626:0","kind":"document","source_node_id":"0","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"我必须承认，M是真理赐予这个世界的最高杰作，那具毫无瑕疵的躯壳里，流淌着如同星辉般纯净的魔力。\n每当我看着<male>他</male><female>她</female>站在高塔之上，轻描淡写地修正那些足以让凡人发狂的魔法漏洞时，我的血液里仿佛有千万只毒虫在啃噬。\n<male>他</male><female>她</female>那傲慢的慈悲，那种对力量游刃有余的掌控感，无一不在嘲讽着我——嘲讽我这半生为了摸索真理边缘而付出的惨烈代价。\n我嫉妒<male>他</male><female>她</female>，嫉妒到发狂。我多想亲手撕碎<male>他</male><female>她</female>的优雅，将<male>他</male><female>她</female>那高洁的灵魂一点点剥扯开来，看那双深邃平静的眼睛里染上绝望与痛苦的底色……\n\n万幸……所有的禁术都有代价，这是不可撼动的铁律。\n 在我长期的观测与魔力侧写中，我发现M的灵魂结构极度特殊。<male>他</male><female>她</female>的魔力回路具有一种不可思议的<style=\"highlight\">绝对转化与滤过性</style>。\n<male>他</male><female>她</female>像是一个深不见底的渊口，无论投入多么暴戾的黑暗魔法，<male>他</male><female>她</female>都能将其同化、平复，甚至<style=\"highlight\">逆向转化为纯粹的生命本源</style>。\n这启发了我：既然<male>他</male><female>她</female>的身体是一个完美的<style=\"highlight\">转化器</style>，为什么不让<male>他</male><female>她</female>成为那个替所有牺牲者承载痛苦的受体呢？\n\n通过改造术式的底层逻辑，我可以建立一条隐秘的<style=\"highlight\">生命力与魔力的置换通道</style>。当施术者试图施展那些逆转生死、违背常理的禁咒时，产生的剧烈反噬与寿命衰减将不再作用于施术者本身。法阵会强制抽取梅林那庞大纯净的魔力与生命力，将其<style=\"highlight\">滤化为结果注入受益者体内</style>。\n而施术的代价——那些残疾、衰老、折损寿命以及灵魂被撕裂的剧痛，将顺着法阵，悉数倒灌入梅林的灵魂深处！\n\n我将这一完美的置换仪式称为<style=\"highlight\">救世主的加冕</style>。\n<male>他</male><female>她</female>既然那么爱拯救世人，那么我就帮<male>他</male><female>她</female>一把——我要让这位魔法师协会的“首席”，在无尽的黑暗中替所有人流血，成为我通向神明领域的、最完美的垫脚石！","textdes_id":"626","document_page_count":"1","document_title_cn":"","document_order":"1","document_object_id":"0","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_mapstory_item5.png","document_image_icon":"UI/Icon/Item/item_quest_mapstory_item5.png","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item5.prefab","document_pic":"","document_gender":"true"},"say:1:1711155001:0":{"key":"say:1:1711155001:0","kind":"say","source_node_id":"1","source_node_type":"__DT.ActionNode","statementID":"1711155001","action_index":"0","choice_index":"","choice_id":"","source_cn":"你猛地合上笔记，深吸了一口气。书页间似乎还残留着迪尔格...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1711155002:1":{"key":"say:3:1711155002:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1711155002","action_index":"1","choice_index":"","choice_id":"","source_cn":"将魔力滤化，把反噬转移给您……这种丧心病狂的“转化”，...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1711155003:0":{"key":"say:5:1711155003:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1711155003","action_index":"0","choice_index":"","choice_id":"","source_cn":"迪尔格雷是个疯子，但他在这方面的研究也启发了你。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"sa