nd":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1721204002","action_index":"1","choice_index":"","choice_id":"","source_cn":"我听说，你已经围绕着三项意象展开了不少调查，辛苦了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1721204003:1":{"key":"say:3:1721204003:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1721204003","action_index":"1","choice_index":"","choice_id":"","source_cn":"调查进展如何，有什么地方需要帮忙吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:4:1721204003":{"key":"choice_prompt:4:1721204003","kind":"choice_prompt","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1721204003","action_index":"","choice_index":"","choice_id":"","source_cn":"调查进展如何，有什么地方需要帮忙吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1721204004:1":{"key":"say:5:1721204004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1721204004","action_index":"1","choice_index":"","choice_id":"","source_cn":"你简单向王后阐述了目前的调查进度，以及追查到的相关线索。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1721204005:1":{"key":"say:6:1721204005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1721204005","action_index":"1","choice_index":"","choice_id":"","source_cn":"虽然已经查到了不少情报，但暂时还不能得到结论，还需要进...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1721204006:1":{"key":"say:7:1721204006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1721204006","action_index":"1","choice_index":"","choice_id":"","source_cn":"好。能查到这么多情报，说明我们现在的方向是正确的。按照...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1721204007:1":{"key":"say:8:1721204007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1721204007","action_index":"1","choice_index":"","choice_id":"","source_cn":"梅林，今天请你过来，其实还有另一件事想要与你商量。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1721204008:1":{"key":"say:9:1721204008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1721204008","action_index":"1","choice_index":"","choice_id":"","source_cn":"不知道你是否看过这份报道？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"document:10:508:0":{"key":"document:10:508:0","kind":"document","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"贵族圈最近出了一件大新闻。沉寂已久的鱼类市场，终于迎来了大新闻：一条价值百万的天价霓光鲤，横空出世！\n放出新闻的正是它目前的持有者，葛朗台男爵。这位豪横的贵族先生，昨日于他位处上城区黄金地段的豪宅中当众放话：\n“——这可不是一条普通的鲤鱼！而是价值百万金的<style=\"highlight\">霓光鲤</style>——”葛朗台男爵如此强调，“足足百万金！”\n男爵向我报透露：这是鲤鱼的稀有变种，一种富含魔力的“神鱼”。它真正的妙用不在于观赏，而是其药用价值……\n据说，喝了霓光鲤熬煮的汤，就能<style=\"highlight\">百病全消，长生不老</style>。\n此话一出，不少人第一时间联想到了如今病重的国王陛下。\n众所周知，陛下健康状态欠佳，一直由王后摄政。但遗憾的是，她似乎并不具备相应的政治天赋。\n不仅王位继承一事上纷争不断，班题斯与王国边境发生摩擦一事上，王后也未积极采取应战措施。\n倘若霓光鲤真的有如此神奇的药效，能够令陛下恢复健康，赛凡纳的政治局面或许又将发生剧变！\n同时，这不禁让我们心生疑惑：一位男爵都能找到应症的解药，为何声称一直在积极治疗的王室却始终没有找到治疗方法？\n或许是王后醉心权势，不愿放手？又或许与王位继承有关，毕竟佩吉公主年纪尚幼，适当拖延时间可以加大她的赢面？……","textdes_id":"508","document_page_count":"1","document_title_cn":"赛凡纳王室与贵族秘报","document_order":"1","document_object_id":"0","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_mapstory_item4.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item4.prefab","document_pic":"","document_gender":"false"},"choice:4:0:1":{"key":"choice:4:0:1","kind":"choice","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1721204001","action_index":"","choice_index":"0","choice_id":"1","source_cn":"对“蜘蛛”和“剑”的解读有些眉目……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:4:1:2":{"key":"choice:4:1:2","kind":"choice","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1721204001","action_index":"","choice_index":"1","choice_id":"2","source_cn":"有关“翅膀”的线索还没有查到","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:王后":{"key":"speaker:王后","source":"王后"},"speaker:旁白":{"key":"speaker:旁白","source":"旁白"}},"stats":{"source_node_count":12,"graph_node_count":11,"effect_event_count":0,"text_entry_count":12,"speaker_entry_count":2,"cast_state_line_count":8,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}