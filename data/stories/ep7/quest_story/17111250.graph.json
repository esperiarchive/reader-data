"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1711125008:1":{"key":"say:7:1711125008:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1711125008","action_index":"1","choice_index":"","choice_id":"","source_cn":"托它的福，“养狐狸”现在可是王都贵族们里最时髦的消遣！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1711125009:1":{"key":"say:8:1711125009:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1711125009","action_index":"1","choice_index":"","choice_id":"","source_cn":"我现在每天什么都不用干，只要打个哈欠、翻个肚皮，就能被...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:9:1711125009":{"key":"choice_prompt:9:1711125009","kind":"choice_prompt","source_node_id":"9","source_node_type":"__DT.MultiChooseNode","statementID":"1711125009","action_index":"","choice_index":"","choice_id":"","source_cn":"我现在每天什么都不用干，只要打个哈欠、翻个肚皮，就能被他们精心伺候。这种感觉……嗝，真是太美妙了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1711125010:1":{"key":"say:10:1711125010:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1711125010","action_index":"1","choice_index":"","choice_id":"","source_cn":"怎么？你打听这个干什么？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image