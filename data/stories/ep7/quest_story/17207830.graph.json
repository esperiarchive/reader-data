unt":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1720783003:0":{"key":"say:3:1720783003:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1720783003","action_index":"0","choice_index":"","choice_id":"","source_cn":"“……他倒在黎明之前，手中的断剑，化作了永恒的晨星……”","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1720783004:0":{"key":"say:4:1720783004:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1720783004","action_index":"0","choice_index":"","choice_id":"","source_cn":"无论是端着酒杯的贵族，还是忙碌的侍从，都停下了动作，被...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1720783005:0":{"key":"say:6:1720783005:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1720783005","action_index":"0","choice_index":"","choice_id":"","source_cn":"人群中，一位老妇人眼含热泪，静静地聆听着这如泣如诉的歌声。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1720783006:0":{"key":"say:8:1720783006:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1720783006","action_index":"0","choice_index":"","choice_id":"","source_cn":"殿下，感谢您让我来到这里。我只是向那位吟游诗人讲了朱利...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1720783007:0":{"key":"say:9:1720783007:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1720783007","action_index":"0","choice_index":"","choice_id":"","source_cn":"这歌声……真好。好像朱利诺正在我耳边说话，告诉我……他...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1720783008:0":{"key":"say:10:1720783008:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1720783008","action_index":"0","choice_index":"","choice_id":"","source_cn":"他当然没有白白牺牲。您看，这满堂的灯火，人们脸上的笑容...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1720783009:1":{"key":"say:11:1720783009:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1720783009","action_index":"1","choice_index":"","choice_id":"","source_cn":"从今往后，每当这首歌在赛凡纳响起，人们就会记起他的名字...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1720783010:1":{"key":"say:12:1720783010:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1720783010","action_index":"1","choice_index":"","choice_id":"","source_cn":"谢谢……谢谢您，殿下。作为一个母亲，这是我能收到的……...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_imag