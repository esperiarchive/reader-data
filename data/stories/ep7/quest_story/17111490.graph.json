":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1711149029:1":{"key":"say:10:1711149029:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1711149029","action_index":"1","choice_index":"","choice_id":"","source_cn":"必须得找到他！梅林大人，这件事就交给我和休来办吧，毕竟...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1711149030:1":{"key":"say:11:1711149030:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1711149030","action_index":"1","choice_index":"","choice_id":"","source_cn":"当然，请梅林大人在这里稍作等候。我和科丝蒂这就前往墓园...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:12:1711149030":{"key":"choice_prompt:12:1711149030","kind":"choice_prompt","source_node_id":"12","source_node_type":"__DT.MultiChooseNode","statementID":"1711149030","action_index":"","choice_index":"","choice_id":"","source_cn":"当然，请梅林大人在这里稍作等候。我和科丝蒂这就前往墓园，把他抓回来！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1711149031:1":{"key":"say:13:1711149031:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1711149031","action_index":"1","choice_index":"","choice_id":"","source_cn":"我们会注意的！科丝蒂，我们走！","textdes_id":"","document_page_count":"","document_title_cn":"","document