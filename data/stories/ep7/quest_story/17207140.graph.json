d":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1720714004:1":{"key":"say:5:1720714004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1720714004","action_index":"1","choice_index":"","choice_id":"","source_cn":"我知道你是好心。但是，佩吉，你知道对于一个手艺人来说，...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1720714005:1":{"key":"say:6:1720714005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1720714005","action_index":"1","choice_index":"","choice_id":"","source_cn":"是……健康？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1720714006:1":{"key":"say:7:1720714006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1720714006","action_index":"1","choice_index":"","choice_id":"","source_cn":"……健康当然也很重要啦，但我想对苏珊婆婆来说，最重要的...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1720714007:1":{"key":"say:8:1720714007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1720714007","action_index":"1","choice_index":"","choice_id":"","source_cn":"只要订单没有取消，哪怕再怎么努力也要完成，这就是我们生...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1720714008:1":{"key":"say:9:1720714008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1720714008","action_index":"1","choice_index":"","choice_id":"","source_cn":"再说了，比起休息，我想她更希望看到的，是你戴着她亲手制...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1720714009:1":{"key":"say:10:1720714009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1720714009","action_index":"1","choice_index":"","choice_id":"","source_cn":"……哼，谁稀罕闪闪发光啊。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1720714010:1":{"key":"say:11:1720714010:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1720714010","action_index":"1","choice_index":"","choice_id":"","source_cn":"……好吧好吧，这次是我考虑不周了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1720714011:1":{"key":"say:12:1720714011:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1720714011","action_index":"1","choice_index":"","choice_id":"","source_cn":"公主殿下今天竟然不嘴硬，这可太难得了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1720714012:1":{"key":"say:13:1720714012:1","kind":"say","source_node_