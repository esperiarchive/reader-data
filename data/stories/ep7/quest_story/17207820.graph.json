d":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1720782005","action_index":"1","choice_index":"","choice_id":"","source_cn":"谁说公主很凶的？我可听到了哦！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1720782006:1":{"key":"say:7:1720782006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1720782006","action_index":"1","choice_index":"","choice_id":"","source_cn":"参、参见……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1720782007:1":{"key":"say:8:1720782007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1720782007","action_index":"1","choice_index":"","choice_id":"","source_cn":"好啦，在我这里不用那么拘束。桌上的这些食物——流蜜黄金...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1720782008:1":{"key":"say:9:1720782008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1720782008","action_index":"1","choice_index":"","choice_id":"","source_cn":"听说你们之前受了不少苦……以后不会了。在耀光，每一个孩...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1720782009:1":{"key":"say:10:1720782009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1720782009","action_index":"1","choice_index":"","choice_id":"","source_cn":"公主姐姐……你的声音，和那个送我们去教堂的姐姐好像啊。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1720782010:1":{"key":"say:11:1720782010:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1720782010","action_index":"1","choice_index":"","choice_id":"","source_cn":"是、是吗？可能是因为……我们都希望你们能开开心心地长大吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1720782011:1":{"key":"say:12:1720782011:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1720782011","action_index":"1","choice_index":"","choice_id":"","source_cn":"好啦，快吃吧！今晚本公主特许你们——不用刀叉，直接用手...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1720782012:1":{"key":"say:13:1720782012:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1720782012","action_index":"1","choice_index":"","choice_id":"","source_cn":"嗯！谢谢公主姐姐！这里的肉饼……比我做梦梦到的还要香！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:小孩汤姆":{"key":"speaker:小孩汤姆","source":"小孩汤姆"},"speaker:小孩珍妮":{"key":"speaker:小孩珍妮","source":"小孩珍妮"},"speaker:小孩莫莉":{"key":"speaker:小孩莫莉","source":"小孩莫莉"},"speaker:佩吉":{"key":"speaker:佩吉","source"