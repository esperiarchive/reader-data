nt_gender":""},"say:7:1720969005:1":{"key":"say:7:1720969005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1720969005","action_index":"1","choice_index":"","choice_id":"","source_cn":"别急别急，每个人都有！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:8:1720969005":{"key":"choice_prompt:8:1720969005","kind":"choice_prompt","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1720969005","action_index":"","choice_index":"","choice_id":"","source_cn":"别急别急，每个人都有！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1720969006:0":{"key":"say:9:1720969006:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1720969006","action_index":"0","choice_index":"","choice_id":"","source_cn":"《赛凡纳之眼》？我不记得我卖过叫这个名字的报纸啊。您要...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:8:0:1":{"key":"choice:8:0:1","kind":"choice","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1720969001","action_index":"","choice_index":"0","choice_id":"1","source_cn":"你现在不推销《赛凡纳之眼》了？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1720969007:0":{"key":"say:10:1720969007:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1720969007","action_index":"0","choice_index":"","choice_id":"","source_cn":"嘿嘿，毕竟《赛凡纳晨报》可是现在的销冠，多亏了它，我的...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:8:1:2":{"key":"choice:8:1:2","kind":"choice","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1720969001","action_index":"","choice_index":"1","choice_id":"2","source_cn":"你现在改推销《赛凡纳晨报》了？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1720969008:0":{"key":"say:11:1720969008:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1720969008","action_index":"0","choice_index":"","choice_id":"","source_cn":"好嘞，这是您的报纸，请拿好！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"document:12:535:0":{"key":"document:12:535:0","kind":"document","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"<style=\"stress\">【德米特子爵，已招供！】</style>\n本报记者马斯卡\n日前在王都引起轩然大波的神秘报纸《赛凡纳之眼》，其幕后黑手——德米特子爵，已对其所有罪行供认不讳！\n调查显示，这位家道中落的子爵，在得到巨额资助后，秘密创办了《赛凡纳之眼》。他招募了一批有前科的混混，系统性地捏造、散播针对佩吉公主与王后的恶意谣言，其用心之险恶，令人发指。\n更令人震惊的是，在阴谋败露之际，狡猾的德米特子爵竟企图利用其负责市政管理的职权，通过水路潜逃。所幸，在有关人士的全力追捕下，他最终落网。\n尽管德米特子爵已经落网，但我们有理由相信，这起阴谋的背后，还隐藏着更庞大、更黑暗的势力。本报将持续关注此案的后续进展，为所有追求真相的读者带来第一手报道！\n\n<style=\"stress\">【惊情赛凡纳！】</style>\n<style=\"stress\">【实习记者的心跳之旅！】</style>\n作者赫蒂奇\n人物介绍\n菲莉帕：充满活力与好奇心的实习记者，虽然偶尔有些迷糊，但拥有敏锐的直觉和不畏艰险的勇气。为了追查少女失踪案，她意外闯入了一个充满魔法与危险的世界。\n夜瞳：身份成谜的强大魔法师，性格温柔，似乎背负着沉重的过去。他被赫蒂奇的纯真与执着所打动，决定协助她调查真相。在不经意间，他总会流露出对菲莉帕的温柔与保护。\n阿洛伊斯：居住在古堡中的吸血鬼贵族，也是少女失踪案的头号嫌疑人。传说他英俊、优雅，却又冷酷无情，守护着不为人知的秘密。\n……\n菲利帕的思绪飞速运转着，“古堡坐落于孤岛之上，没有桥梁与其他陆地相连……那么，那些失踪的少女前往古堡的唯一途径，只能是水路！”\n听着她清晰的推理，夜瞳的眼神，不由得露出一丝赞许。\n顺着这条线索，他们很快便查明：在旧港区码头，每逢午夜，都会有一艘未经登记的“幽灵船”悄然离港，终点不明。\n夜瞳指尖轻点，微光笼罩之下，菲利帕和夜瞳一瞬间化作两只毛茸茸的小仓鼠，悄无声息地溜上了那艘神秘的船只。\n船舱的阴影角落里，两只仓鼠紧紧地挤在一起取暖。夜瞳的声音从旁边传来，带着一丝笑意：“仓鼠的样子，倒也很适合你。”\n夜瞳的低语将菲利帕的思绪拉回片刻，但她的心，早已飞向了那座笼罩在月色下的孤岛古堡。那位神秘的古堡主人，阿洛伊斯伯爵……他真的如传闻那般，是一个冷酷无情的恶魔吗？还是说，在那副冰冷的面具之下，另有隐情……\n……\n（更多精彩，敬请期待下期《赛凡纳晨报》副刊！超人气小说《惊情赛凡纳！实习记者的心跳之旅！》火热连载中！）","textdes_id":"535","document_page_count":"2","document_title_cn":"晨报头条","document_order":"1","document_object_id":"0","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_mapstory_item4.png","document_image_icon":"UI/Icon/Item/item_quest_mapstory_item4.png","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item4.prefab","document_pic":"","document_gender":"false"},"choice:8:2:3":{"key":"choice:8:2:3","kind":"choice","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1720969001","action_index":"","choice_index":"2","choice_id":"3","source_cn":"我也要一份《赛凡纳晨报》","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:报童皮普":{"key":"speaker:报童皮普","source":"报童皮普"},"speaker:双眼放光的少女":{"key":"speaker:双眼放光的少女","source":"双眼放光的少女"},"speaker:狂热的少女":{"key":"speaker:狂热的少女","source":"狂热的少女"}},"stats":{"source_node_count":14,"graph_node_count":12,"effect_event_count":0,"text_entry_count":13,"speaker_entry_count":3,"cast_state_line_count":8,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}