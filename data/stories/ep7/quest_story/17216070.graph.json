cument_base_image":"","document_pic":"","document_gender":""},"say:7:1721607006:1":{"key":"say:7:1721607006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1721607006","action_index":"1","choice_index":"","choice_id":"","source_cn":"安慰玩偶嘛？这种软趴趴的东西，三岁小孩才玩吧？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1721607007:1":{"key":"say:8:1721607007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1721607007","action_index":"1","choice_index":"","choice_id":"","source_cn":"现在是自由活动时间。我的私人物品与你们无关。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1721607008:1":{"key":"say:9:1721607008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1721607008","action_index":"1","choice_index":"","choice_id":"","source_cn":"如果太闲，我不介意让你们加两组负重跑。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1721607009:2":{"key":"say:10:1721607009:2","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1721607009","action_index":"2","choice_index":"","choice_id":"","source_cn":"别这么严肃嘛，格温妮丝队长。我们只是觉得……这东西和守...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1721607010:1":{"key":"say:11:1721607010:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1721607010","action_index":"1","choice_index":"","choice_id":"","source_cn":"毕竟您是守备军，是战士。真正的军人，应该像我们一样强壮...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1721607011:1":{"key":"say:12:1721607011:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1721607011","action_index":"1","choice_index":"","choice_id":"","source_cn":"你这样子，可没有一点守备军的模样！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1721607012:1":{"key":"say:13:1721607012:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1721607012","action_index":"1","choice_index":"","choice_id":"","source_cn":"守备军的模样？你是说，像你们这样满嘴偏见、只会用粗鲁来...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1721607013:2":{"key":"say:14:1721607013:2","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1721607013","action_index":"2","choice_index":"","choice_id":"","source_cn":"你——！说谁无能？！别以为你是队长我们就怕你！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1721607014:1":{"key":"say:15:1721607014:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1721607014","action_index":"1","choice_index":"","choice_id":"","source_cn":"你不就是靠着你父亲才坐上这个位置的吗？还敢教训我们什么...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1721607015:1":{"key":"say:16:1721607015:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1721607015","action_index":"1","choice_index":"","choice_id":"","source_cn":"既然队长这么自信，不如让我们见识一下？还是说，您怕弄坏...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1721607016:1":{"key":"say:17:1721607016:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1721607016","action_index":"1","choice_index":"","choice_id":"","source_cn":"很好。既然你们对守备军这个词有这么大的误解，那我就免费...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1721607017:1":{"key":"say:18:1721607017:1","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1721607017","action_index":"1","choice_index":"","choice_id":"","source_cn":"这可是你自找的！别怪我们以多欺少！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:格温妮丝":{"key":"speaker:格温妮丝","source":"格温妮丝"},"speaker:守备军盖伊":{"key":"speaker:守备军盖伊","source":"守备军盖伊"},"speaker:守备军呼伦":{"key":"speaker:守备军呼伦","sou