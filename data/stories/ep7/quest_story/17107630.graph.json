ent_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1710763008:0":{"key":"say:11:1710763008:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1710763008","action_index":"0","choice_index":"","choice_id":"","source_cn":"奥利安殿下所言甚是。现在惊慌无用，我们只需要知道，该如...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1710763009:0":{"key":"say:13:1710763009:0","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1710763009","action_index":"0","choice_index":"","choice_id":"","source_cn":"没错，现在最重要的是，收起你们的恐惧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1710763010:0":{"key":"say:14:1710763010:0","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1710763010","action_index":"0","choice_index":"","choice_id":"","source_cn":"只要我奥利安还站在这里，我就会竭尽全力，保护诸位的安全。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1710763011:0":{"key":"say:15:1710763011:0","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1710763011","action_index":"0","choice_index":"","choice_id":"","source_cn":"我绝不会让任何人，在我的庇护下出事！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":