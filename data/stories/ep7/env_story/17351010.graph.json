ocument_gender":""},"say:2:1735101002:1":{"key":"say:2:1735101002:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1735101002","action_index":"1","choice_index":"","choice_id":"","source_cn":"加量不加价，整版刊登金牌作家赫蒂奇的小说！跌宕起伏，浪...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1735101003:1":{"key":"say:3:1735101003:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1735101003","action_index":"1","choice_index":"","choice_id":"","source_cn":"实不相瞒，这是我私藏的最后一份了，再晚了可就买不到了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:4:1735101003":{"key":"choice_prompt:4:1735101003","kind":"choice_prompt","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1735101003","action_index":"","choice_index":"","choice_id":"","source_cn":"实不相瞒，这是我私藏的最后一份了，再晚了可就买不到了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1735101004:0":{"key":"say:5:1735101004:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1735101004","action_index":"0","choice_index":"","choice_id":"","source_cn":"嘿嘿，您拿好，慢慢看！最好等晚上一个人在家的时候看！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"document:6:582:0":{"key":"document:6:582:0","kind":"document","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"<style=\"stress\">【惊情赛凡纳！实习记者的心跳之旅！】</style>\n……\n夜瞳的魔法在这座古堡中竟然失去了作用。阿洛伊斯轻轻一挥手，无数血红的荆棘破土而出，瞬间编织成一座无法逃脱的囚笼，将夜瞳死死困在其中。\n“别挣扎了，魔法师。”阿洛伊斯看都没看夜瞳一眼，径直走向宴会厅，“今晚，她是我的舞伴。”\n菲莉帕终于苏醒了过来，发现自己趴在长桌上，不知沉睡了多久。长桌上摆满了精致的银器和未动的佳肴，仿佛在等待一场盛宴开启。\n一个低沉而优雅的声音从从长桌对面传来。阿洛伊斯正好整以暇地端坐着，幽暗深邃的目光注视着她。\n“菲莉帕，我迷途的羔羊……这场宴会是专门为你准备的。我们，可以开始了么？”\n菲莉帕惊恐地环顾四周，寻找那个熟悉的身影。空荡荡的大厅里，只有烛火摇曳的影子。\n“夜瞳在哪！你把他怎么了！”菲莉帕想起夜瞳身上还带着刚痊愈不久的伤，第一次后悔将他牵扯了进来。\n“你很想见到那只讨人厌的虫子？那不如，先陪我跳完这一支舞吧。”\n阿洛伊斯苍白的指尖在虚空中轻轻一点，宴会厅里，华尔兹的旋律凭空响起。\n菲莉帕身不由己地随着阿洛伊斯的舞步旋转，她的目光却始终担忧地望向空荡荡的大厅尽头。\n就在舞曲进入高潮，阿洛伊斯即将俯身亲吻菲莉帕手背的那一刻——\n“轰——！”\n一声巨响震彻大厅。荆棘囚笼炸成了漫天飞舞的碎片。烟尘散去，夜瞳周身燃烧着幽蓝色的魔力火焰，一步步从阴影中走出。\n他的眼神不再温柔，而是充满了前所未有的暴戾与杀意。\n阿洛伊斯的嘴角勾起了一抹意味深长的微笑，“呵……有趣起来了呢。”\n……\n（更多精彩，敬请期待下期《赛凡纳晨报》！超人气小说《惊情赛凡纳！实习记者的心跳之旅！》火热连载中！）","textdes_id":"582","document_page_count":"1","document_title_cn":"《赛凡纳晨报》·特别版","document_order":"1","document_object_id":"0","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_mapstory_item4.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item4.prefab","document_pic":"","document_gender":"false"},"choice:4:0:1":{"key":"choice:4:0:1","kind":"choice","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1735101001","action_index":"","choice_index":"0","choice_id":"1","source_cn":"给我来一份！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1735101005:0":{"key":"say:8:1735101005:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1735101005","action_index":"0","choice_index":"","choice_id":"","source_cn":"老读者的话，可以悄悄给您打个八折哦！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1735101006:0":{"key":"say:9:1735101006:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1735101006","action_index":"0","choice_index":"","choice_id":"","source_cn":"报纸您拿好咯，慢慢看！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:4:1:2":{"key":"choice:4:1:2","kind":"choice","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1735101001","action_index":"","choice_index":"1","choice_id":"2","source_cn":"我是她的忠实读者！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:报童皮普":{"key":"speaker:报童皮普","source":"报童皮普"}},"stats":{"source_node_count":10,"graph_node_count":9,"effect_event_count":0,"text_entry_count":10,"speaker_entry_count":1,"cast_state_line_count":6,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}