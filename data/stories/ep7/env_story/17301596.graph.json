","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1730159605:1":{"key":"say:5:1730159605:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1730159605","action_index":"1","choice_index":"","choice_id":"","source_cn":"据说梅林周游伊索米亚时，曾发现过一种神奇的药水，能够疗...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1730159606:1":{"key":"say:6:1730159606:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1730159606","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以，究竟是谁带来奇迹，让陛下成功恢复了健康呢？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1730159607:1":{"key":"say:7:1730159607:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1730159607","action_index":"1","choice_index":"","choice_id":"","source_cn":"想了解更多八卦详情的话，请购买我们的报纸《你所不知道的...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:商贩哈尼":{"key":"speaker:商贩哈尼","source":"商贩哈尼"}},"stats":{"source_node_count":9,"graph_node_count":8,"effect_event_count":0,"text_entry_count":7,"speaker_entry_count":1,"cast_state_line_count":7,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}