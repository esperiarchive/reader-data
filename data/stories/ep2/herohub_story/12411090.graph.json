"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1241109005:1":{"key":"say:7:1241109005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1241109005","action_index":"1","choice_index":"","choice_id":"","source_cn":"主人你又忘了！最开始弃船的时候，我们一起游到了小岛上！...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1241109006:1":{"key":"say:8:1241109006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1241109006","action_index":"1","choice_index":"","choice_id":"","source_cn":"那你之前还被呛得够呛？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1241109007:1":{"key":"say:9:1241109007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1241109007","action_index":"1","choice_index":"","choice_id":"","source_cn":"……那是因为这身骑士盔甲太沉了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1241109008:1":{"key":"say:10:1241109008:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1241109008","action_index":"1","choice_index":"","choice_id":"","source_cn":"还有这把沉甸甸的骑士剑！满满为了拿起它，可是拼命锻炼了...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","docum