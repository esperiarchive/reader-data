","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1241137006:1":{"key":"say:6:1241137006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1241137006","action_index":"1","choice_index":"","choice_id":"","source_cn":"我的剑上，曾经溅上过他们厮杀时的血。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1241137007:1":{"key":"say:7:1241137007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1241137007","action_index":"1","choice_index":"","choice_id":"","source_cn":"你们见过人类和亡灵的战斗吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:8:1241137007":{"key":"choice_prompt:8:1241137007","kind":"choice_prompt","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1241137007","action_index":"","choice_index":"","choice_id":"","source_cn":"你们见过人类和亡灵的战斗吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1241137008:1":{"key":"say:9:1241137008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1241137008","action_index":"1","choice_index":"","choice_id":"","source_cn":"虽然我不愿意承认，但死潮舰队的亡灵，简直是一群不知疲倦...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_ge