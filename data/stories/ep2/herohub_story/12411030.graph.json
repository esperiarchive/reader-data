nt_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1241103004:1":{"key":"say:6:1241103004:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1241103004","action_index":"1","choice_index":"","choice_id":"","source_cn":"是啊，我们身处锈锚港，少不了要乘船出海，满满又不愿意脱...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:7:1241103004":{"key":"choice_prompt:7:1241103004","kind":"choice_prompt","source_node_id":"7","source_node_type":"__DT.MultiChooseNode","statementID":"1241103004","action_index":"","choice_index":"","choice_id":"","source_cn":"是啊，我们身处锈锚港，少不了要乘船出海，满满又不愿意脱下那套沉重的骑士盔甲，我只能从魔法上想想办法了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1241103005:1":{"key":"say:8:1241103005:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1241103005","action_index":"1","choice_index":"","choice_id":"","source_cn":"我、我也想过找<style=stress><playe...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1241103006:1":{"key":"say:9:1241103006:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1241103006","action_index":"1","choice_index":"","choice_id":"","source_cn":"更何况你也需要休息！我不想用这样一件小事麻烦你。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1241103007:1":{"key":"say:10:1241103007:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1241103007","action_index":"1","choice_index":"","choice_id":"","source_cn":"我已经想好怎么做了——用防水魔法制作护符，让满满戴在身...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1241103008:1":{"key":"say:11:1241103008:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1241103008","action_index":"1","choice_index":"","choice_id":"","source_cn":"嘿，不是我说，你们既然都用上魔法了，干嘛不更直接一点？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1241103009:1":{"key":"say:12:1241103009:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1241103009","action_index":"1","choice_index":"","choice_id":"","source_cn":"比如，直接让人飞起来！想去哪就去哪！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1241103010:1":{"key":"say:13:1241103010:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1241103010","action_index":"1","choice_index":"","choice_id":"","source_cn":"这么说来，有没有能让人变成鸟的魔法，给我用用？雨燕，贼...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_