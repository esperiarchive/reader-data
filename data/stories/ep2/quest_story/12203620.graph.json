_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1220362008:1":{"key":"say:9:1220362008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1220362008","action_index":"1","choice_index":"","choice_id":"","source_cn":"除了给他们做饭，大当家还让我教他们一些生存技巧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1220362009:0":{"key":"say:10:1220362009:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1220362009","action_index":"0","choice_index":"","choice_id":"","source_cn":"只要能够靠自己生活下去，等他们长大，也就不再是海中漂泊...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1220362010:1":{"key":"say:13:1220362010:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1220362010","action_index":"1","choice_index":"","choice_id":"","source_cn":"你好像很喜欢小孩子。我知道你有一个女儿，你想过回去见她吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1220362011:1":{"key":"say:14:1220362011:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1220362011","action_index":"1","choice_index":"","choice_id":"","source_cn":"我……我没脸见她。起码现在还没有。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1220362012:1":{"key":"say:15:1220362012:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1220362012","action_index":"1","choice_index":"","choice_id":"","source_cn":"现在每天和孩子们相处，我感觉自己的腰杆一点点直了起来。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1220362013:0":{"key":"say:16:1220362013:0","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1220362013","action_index":"0","choice_index":"","choice_id":"","source_cn":"说不定，在很多年以后，我会有勇气回去见莉莉。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1220362014:1":{"key":"say:17:1220362014:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1220362014","action_index":"1","choice_index":"","choice_id":"","source_cn":"见到莉莉，我一定又会想起那个小姑娘吧……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1220362015:1":{"key":"say:18:1220362015:1","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1220362015","action_index":"1","choice_index":"","choice_id":"","source_cn":"她一定去了很美的地方，你也要好好生活，别让她担心。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:19:1220362