3005:1":{"key":"say:6:1220513005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1220513005","action_index":"1","choice_index":"","choice_id":"","source_cn":"哎……不用担心，我会好好收着它的。不管怎么说，也是我丈...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:7:1220513005":{"key":"choice_prompt:7:1220513005","kind":"choice_prompt","source_node_id":"7","source_node_type":"__DT.MultiChooseNode","statementID":"1220513005","action_index":"","choice_index":"","choice_id":"","source_cn":"哎……不用担心，我会好好收着它的。不管怎么说，也是我丈夫和儿子留下来的遗物……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1220513006:1":{"key":"say:8:1220513006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1220513006","action_index":"1","choice_index":"","choice_id":"","source_cn":"……都过去多少年了，我早就没事了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1220513007:1":{"key":"say:9:1220513007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1220513007","action_index":"1","choice_index":"","choice_id":"","source_cn":"再说了，我们这种靠海吃饭的人，早就知道会有这么一天。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1220513009:1":{"key":"say:11:1220513009:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1220513009","action_index":"1","choice_index":"","choice_id":"","source_cn":"抱歉，我们不是故意惹你伤心的……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1220513010:1":{"key":"say:12:1220513010:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1220513010","action_index":"1","choice_index":"","choice_id":"","source_cn":"对、对不起！满满也不知道，这个铃铛对你这么重要……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1220513011:1":{"key":"say:13:1220513011:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1220513011","action_index":"1","choice_index":"","choice_id":"","source_cn":"行了，别往心里去！我早就接受现实了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1220513012:1":{"key":"say:14:1220513012:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1220513012","action_index":"1","choice_index":"","choice_id":"","source_cn":"只不过，偶尔，很偶尔的时候……我还是会想他们。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:7:0:1":{"key":"choice:7:0:1","kind":"choice","source_node_id":"7","source_node_type":"__DT.MultiChooseNode","statementID":"1220513001","action_in