"document_gender":""},"say:4:1220246002:1":{"key":"say:4:1220246002:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1220246002","action_index":"1","choice_index":"","choice_id":"","source_cn":"打不过，我们认栽，这些管子归你们了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1220246003:1":{"key":"say:5:1220246003:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1220246003","action_index":"1","choice_index":"","choice_id":"","source_cn":"我们要水管干嘛？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1220246004:1":{"key":"say:6:1220246004:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1220246004","action_index":"1","choice_index":"","choice_id":"","source_cn":"不抢水管，你们打我们干嘛？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1220246005:1":{"key":"say:7:1220246005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1220246005","action_index":"1","choice_index":"","choice_id":"","source_cn":"不许再破坏这些水管了！整个锈锚港的运水和净水系统，就靠...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1220246006:1":{"key":"say:8:1220246006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1220246006","action_index":"1","choice_index":"","choice_id":"","source_cn":"要是再来，老子打断你们的腿，都丢进海里！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1220246007:1":{"key":"say:9:1220246007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1220246007","action_index":"1","choice_index":"","choice_id":"","source_cn":"我们知错了。但这些水管流出来的水又贵，又不好喝，我们都...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1220246008:1":{"key":"say:12:1220246008:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1220246008","action_index":"1","choice_index":"","choice_id":"","source_cn":"和你们说不通，总之，你们只需要知道，从今以后水会变好喝...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1220246009:1":{"key":"say:13:1220246009:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1220246009","action_index":"1","choice_index":"","choice_id":"","source_cn":"对，看见没，这位是索尼娅和卢卡委托的净水系统改造工匠，...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1220246010:1":{"key":"say:16:1220246010:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1220246010","action_index":"1",