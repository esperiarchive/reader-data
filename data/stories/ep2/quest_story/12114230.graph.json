cument_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1211423002:0":{"key":"say:3:1211423002:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1211423002","action_index":"0","choice_index":"","choice_id":"","source_cn":"我猜也是。\\n看你这傻大个的模样，船员聚在一起讨论战术...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1211423003:1":{"key":"say:4:1211423003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1211423003","action_index":"1","choice_index":"","choice_id":"","source_cn":"胡说！我知道！但我忠诚，我不说！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1211423004:1":{"key":"say:5:1211423004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1211423004","action_index":"1","choice_index":"","choice_id":"","source_cn":"说不出来就承认嘛，我又不会笑你。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1211423005:1":{"key":"say:6:1211423005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1211423005","action_index":"1","choice_index":"","choice_id":"","source_cn":"一艘船上总有那么几个不被重视的边缘人物，没事，不丢人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1211423006:1":{"key":"say:7:1211423006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1211423006","action_index":"1","choice_index":"","choice_id":"","source_cn":"不……不！我知道！我参与了作战会议！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1211423007:1":{"key":"say:8:1211423007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1211423007","action_index":"1","choice_index":"","choice_id":"","source_cn":"哎哟，谁信呐。你不就是个搬炸药的苦力么？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1211423008:1":{"key":"say:9:1211423008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1211423008","action_index":"1","choice_index":"","choice_id":"","source_cn":"我不是！船长派我在这里保护炼金术师！我的工作很重要！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1211423009:1":{"key":"say:10:1211423009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1211423009","action_index":"1","choice_index":"","choice_id":"","source_cn":"这话我也能编，我还说我是霍德希金安插在锈锚港的间谍呢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1211423010:1":{"key":"say:11:121