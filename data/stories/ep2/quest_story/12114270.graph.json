age_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1211427004:1":{"key":"say:7:1211427004:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1211427004","action_index":"1","choice_index":"","choice_id":"","source_cn":"你们想问什么……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1211427005:1":{"key":"say:8:1211427005:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1211427005","action_index":"1","choice_index":"","choice_id":"","source_cn":"你的好队友说，你能打开那些特殊的门。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1211427006:0":{"key":"say:9:1211427006:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1211427006","action_index":"0","choice_index":"","choice_id":"","source_cn":"呵呵呵……不错，我可以。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1211427007:0":{"key":"say:10:1211427007:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1211427007","action_index":"0","choice_index":"","choice_id":"","source_cn":"但是你们刚才突然闯过来攻击我，我一哆嗦，钥匙掉进坩埚里...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1211427008:0":{"key":"say:12:1211427008:0","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1211427008","action_index":"0","choice_index":"","choice_id":"","source_cn":"钥匙不可能只有一把，赶紧把备用钥匙交出来！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1211427009:1":{"key":"say:14:1211427009:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1211427009","action_index":"1","choice_index":"","choice_id":"","source_cn":"备用钥匙当然有，只不过，在船长手里。恐怕你们得去找他要了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1211427010:0":{"key":"say:15:1211427010:0","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1211427010","action_index":"0","choice_index":"","choice_id":"","source_cn":"我看 你是欠揍——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1211427011:0":{"key":"say:16:1211427011:0","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1211427011","action_index":"0","choice_index":"","choice_id":"","source_cn":"冷静，辛巴达！剩下的交给梅林吧！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1211427012:1":{"key":"say:17:1211427012:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"12