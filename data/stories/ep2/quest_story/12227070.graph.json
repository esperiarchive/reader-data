"document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1222707003:1":{"key":"say:4:1222707003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1222707003","action_index":"1","choice_index":"","choice_id":"","source_cn":"不用，放心！我这次准备的金币多得能直接打一条黄金鱼出来...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1222707004:1":{"key":"say:6:1222707004:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1222707004","action_index":"1","choice_index":"","choice_id":"","source_cn":"可是，你要怎么把金币做成鱼饵呢？它肯定不能直接挂在鱼钩上。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1222707005:1":{"key":"say:7:1222707005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1222707005","action_index":"1","choice_index":"","choice_id":"","source_cn":"哈哈，那你们就瞧好了——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1222707006:1":{"key":"say:9:1222707006:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1222707006","action_index":"1","choice_index":"","choice_id":"","source_cn":"——哇啊！你……你怎么把所有金币都扔进河里了？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1222707007:1":{"key":"say:10:1222707007:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1222707007","action_index":"1","choice_index":"","choice_id":"","source_cn":"这叫“打窝”——把一大团鱼饵扔进水里，吸引鱼聚集过来。...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1222707008:1":{"key":"say:11:1222707008:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1222707008","action_index":"1","choice_index":"","choice_id":"","source_cn":"好了，接下来就是我一展身手的时候了！你们就耐心等待鱼儿...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:13:1222707009:1":{"key":"narration:13:1222707009:1","kind":"narration","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1222707009","action_index":"1","choice_index":"","choice_id":"","source_cn":"","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1222707010:1":{"key":"say:14:1222707010:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1222707010","action_index":"1","choice_index":"","choice_id":"","source_cn":"真奇怪……黄金孔雀怎么还没出现……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1222707011:1":{"key":"say:16:1222707011:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1222707011","action_index":"1","choice_index":"","choice_id":"","source_cn":"既然是“传说中的鱼王”，肯定不会那么容易上钩的。再多一...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1222707012:1":{"key":"say:17:1222707012:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1222707012","action_index":"1","choice_index":"","choice_id":"","source_cn":"唉，说的也是……如果那么容易就钓到，我也不用亲自——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1222707013:1":{"key":"say:18:1222707013:1","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1222707013","action_index":"1","choice_index":"","choice_id":"","source_cn":"——鱼漂！鱼漂动了！有鱼上钩了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:3:0:1":{"key":"choice:3:0:1","kind":"choice","source_node_id":"3","source_node_type":"__DT.MultiChooseNode","statementID":"1222707001","action_index":"","choice_index":"0","choice_id":"1","source_cn":"需要我帮你钓吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:约克逊":{"key":"speaker:约克逊","source":"约克逊"},"speaker:满满":{"key":"speaker:满满","source":"满满"},"speaker:漫漫":{"key":"speak