ount":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1221013003:1":{"key":"say:4:1221013003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1221013003","action_index":"1","choice_index":"","choice_id":"","source_cn":"唉，这就说来话长了，连我自己也没太搞明白。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1221013004:0":{"key":"say:5:1221013004:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1221013004","action_index":"0","choice_index":"","choice_id":"","source_cn":"能麻烦您帮我解释一下都发生了什么吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:6:1221013004":{"key":"choice_prompt:6:1221013004","kind":"choice_prompt","source_node_id":"6","source_node_type":"__DT.MultiChooseNode","statementID":"1221013004","action_index":"","choice_index":"","choice_id":"","source_cn":"能麻烦您帮我解释一下都发生了什么吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1221013005:1":{"key":"say:7:1221013005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1221013005","action_index":"1","choice_index":"","choice_id":"","source_cn":"没错，就是这样。虽然这件事听起来很诡异，但我身上的伤确...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1221013006:1":{"key":"say:8:1221013006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1221013006","action_index":"1","choice_index":"","choice_id":"","source_cn":"要是真像你们说的那样，这座岛也太古怪了……不过大海之上...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1221013007:0":{"key":"say:9:1221013007:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1221013007","action_index":"0","choice_index":"","choice_id":"","source_cn":"对了，还没来得及和您道谢，魔法师大人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:10:1221013007":{"key":"choice_prompt:10:1221013007","kind":"choice_prompt","source_node_id":"10","source_node_type":"__DT.MultiChooseNode","statementID":"1221013007","action_index":"","choice_index":"","choice_id":"","source_cn":"对了，还没来得及和您道谢，魔法师大人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1221013010:0":{"key":"say:11:1221013010:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1221013010","action_index":"0","choice_index":"","choice_id":"","source_cn":"那位水鬼帮小哥……也谢谢你了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"