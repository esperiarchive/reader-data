ender":""},"say:9:1222575008:1":{"key":"say:9:1222575008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1222575008","action_index":"1","choice_index":"","choice_id":"","source_cn":"谢谢啦——还有你，辛巴达！这次也不能忘了你的功劳！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1222575009:0":{"key":"say:11:1222575009:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1222575009","action_index":"0","choice_index":"","choice_id":"","source_cn":"嘿嘿，还好啦。毕竟你一直在称我为英雄。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1222575010:0":{"key":"say:12:1222575010:0","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1222575010","action_index":"0","choice_index":"","choice_id":"","source_cn":"至少这次，我觉得自己真正担起了英雄的名号。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1222575011:0":{"key":"say:15:1222575011:0","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1222575011","action_index":"0","choice_index":"","choice_id":"","source_cn":"塔西，哈拉克现在被封在瓶中，那你和奥曼斯以后还要继续看...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1222575012:0":{"key":"say:16:1222575012:0","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1222575012","action_index":"0","choice_index":"","choice_id":"","source_cn":"嗯……是呢！不会像之前那么自由了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1222575013:1":{"key":"say:17:1222575013:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1222575013","action_index":"1","choice_index":"","choice_id":"","source_cn":"不过放心，对于我和奥曼斯爷爷来说，这只是漫长时间中一段...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1222575014:1":{"key":"say:18:1222575014:1","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1222575014","action_index":"1","choice_index":"","choice_id":"","source_cn":"我也会找机会偷溜去别人的梦里玩耍。也许哪一天，你们就又...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:19:1222575015:0":{"key":"say:19:1222575015:0","kind":"say","source_node_id":"19","source_node_type":"__DT.ActionNode","statementID":"1222575015","action_index":"0","choice_index":"","choice_id":"","source_cn":"该说再见了，塔西。别让他们的步伐为我们而停。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:20:1222575016:0":{"key":"say:20:1222575016:0","kind":"say","source_node_id":"20","source_node_type":"__DT.ActionNode","statementID":"1222575016",