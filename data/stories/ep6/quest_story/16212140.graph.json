t_base_image":"","document_pic":"","document_gender":""},"say:5:1621214005:1":{"key":"say:5:1621214005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1621214005","action_index":"1","choice_index":"","choice_id":"","source_cn":"哈梅尔小心地将药缓缓喂给松鼠。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1621214006:1":{"key":"say:6:1621214006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1621214006","action_index":"1","choice_index":"","choice_id":"","source_cn":"它……好点了吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1621214007:1":{"key":"say:7:1621214007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1621214007","action_index":"1","choice_index":"","choice_id":"","source_cn":"舒缓药可不像魔法那样立竿见影，还得等上一会儿。魔法师朋...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:8:1621214008:0":{"key":"narration:8:1621214008:0","kind":"narration","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1621214008","action_index":"0","choice_index":"","choice_id":"","source_cn":"等待期间，哈梅尔坐在一旁吹起了笛子。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:9:1621214009:0":{"key":"narrati