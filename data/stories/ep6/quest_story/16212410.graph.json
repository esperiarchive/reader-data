偷猎者们至今都抓...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1621241005:1":{"key":"say:5:1621241005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1621241005","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以你一开始就知道小蓝的存在？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1621241006:1":{"key":"say:6:1621241006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1621241006","action_index":"1","choice_index":"","choice_id":"","source_cn":"是的，从一开始我就知道……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1621241007:1":{"key":"say:7:1621241007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1621241007","action_index":"1","choice_index":"","choice_id":"","source_cn":"我觉得我的余生都无法忘记遇见它的瞬间了，我仿佛看见了一...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1621241008:1":{"key":"say:8:1621241008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1621241008","action_index":"1","choice_index":"","choice_id":"","source_cn":"那一刻，我知道，这个世界上，有些东西值得用生命去守护。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","docum