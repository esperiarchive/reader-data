能为莱希拉姆学生。","textdes_id":"455","document_page_count":"1","document_title_cn":"乡间小路","document_order":"1","document_object_id":"1102500","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_gallery10.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item11.prefab","document_pic":"UI/Icon/Item/item_quest_gallery10.png","document_gender":"false"},"say:2:1610551501:0":{"key":"say:2:1610551501:0","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1610551501","action_index":"0","choice_index":"","choice_id":"","source_cn":"这幅画很有趣，是雷蒙校长的亲笔画。据说是他打赌输给了奈...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:3:1610551501":{"key":"choice_prompt:3:1610551501","kind":"choice_prompt","source_node_id":"3","source_node_type":"__DT.MultiChooseNode","statementID":"1610551501","action_index":"","choice_index":"","choice_id":"","source_cn":"这幅画很有趣，是雷蒙校长的亲笔画。据说是他打赌输给了奈尔森老师，才画了这幅画的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1610551502:0":{"key":"say:4:1610551502:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1610551502","action_index":"0","choice_index":"","choice_id":"","source_cn":"是啊，校长除了魔法还擅长很多东西……在进入莱希拉姆之前...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:5:1610551502":{"key":"choice_prompt:5:1610551502","kind":"choice_prompt","source_nod