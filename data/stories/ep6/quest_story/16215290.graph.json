:"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1621529006:1":{"key":"say:6:1621529006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1621529006","action_index":"1","choice_index":"","choice_id":"","source_cn":"不过……即便是一场碾压的决斗，凭我对喵丽丝的了解，她绝...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1621529007:1":{"key":"say:7:1621529007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1621529007","action_index":"1","choice_index":"","choice_id":"","source_cn":"她就像风，哪怕今天停了，明天依旧可能卷土重来。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1621529008:1":{"key":"say:8:1621529008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1621529008","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以，我们不能松懈，我们的小队必须永远保持警觉。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1621529009:1":{"key":"say:9:1621529009:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1621529009","action_index":"1","choice_index":"","choice_id":"","source_cn":"你愿意继续支持我，对抗未来的风暴吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"