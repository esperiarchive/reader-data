:1:1621120001:0","kind":"say","source_node_id":"1","source_node_type":"__DT.ActionNode","statementID":"1621120001","action_index":"0","choice_index":"","choice_id":"","source_cn":"作为安泽的得力助手，我以为你多忙呢，结果在审查所呆了几天？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:2:1621120001":{"key":"choice_prompt:2:1621120001","kind":"choice_prompt","source_node_id":"2","source_node_type":"__DT.MultiChooseNode","statementID":"1621120001","action_index":"","choice_index":"","choice_id":"","source_cn":"作为安泽的得力助手，我以为你多忙呢，结果在审查所呆了几天？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1621120002:1":{"key":"say:3:1621120002:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1621120002","action_index":"1","choice_index":"","choice_id":"","source_cn":"这么快就忘了？我是安泽招聘助手的候选人！那天要不是你耍...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:4:1621120002":{"key":"choice_prompt:4:1621120002","kind":"choice_prompt","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1621120002","action_index":"","choice_index":"","choice_id":"","source_cn":"这么快就忘了？我是安泽招聘助手的候选人！那天要不是你耍了点花样，如今站在安泽身边的人该是我才对。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1621120003:0":{"key":"say:5:1621120003:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1621120003","action_index":"0","choice_index":"","choice_id":"","source_cn":"别走！你听我说！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1621120004:1":{"key":"say:6:1621120004:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1621120004","action_index":"1","choice_index":"","choice_id":"","source_cn":"我不是来跟你斗嘴的，来找你是想……想搞点甜甜冻，能帮个忙不？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1621120005:1":{"key":"say:7:1621120005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1621120005","action_index":"1","choice_index":"","choice_id":"","source_cn":"钱不是问题，多少钱都可以，你开个价。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:8:1621120005":{"key":"choice_prompt:8:1621120005","kind":"choice_prompt","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1621120005","action_index":"","choice_index":"","choice_id":"","source_cn":"钱不是问题，多少钱都可以，你开个价。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1621120006:1":{"key":"say:9:1621120006:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1621120006","action_index":"1","choice_index":"","choice_id":"","source_cn":"你是跟我装傻还是怎么着？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1621120007:1":{"key":"say:10:1621120007:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1621120007","action_index":"1","choice_index":"","choice_id":"","source_cn":"安泽要的是魔法道具，我现在手里根本没有了！难道去偷去抢吗？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:11:1621120007":{"key":"choice_prompt:11:1621120007","kind":"choice_prompt","source_node_id":"11","source_node_type":"__DT.MultiChooseNode","statementID":"1621120007","action_index":"","choice_index":"","choice_id":"","source_cn":"安泽要的是魔法道具，我现在手里根本没有了！难道去偷去抢吗？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1621120008:1":{"key":"say:12:1621120008:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1621120008","action_index":"1","choice_index":"","choice_id":"","source_cn":"跟你有什么关系？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1621120010:1":{"key":"say:13:1621120010:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1621120010","action_index":"1","choice_index":"","choice_id":"","source_cn":"真是笑话，蹲过审查所的人，现在开始教我如何走路了？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1621120011:1":{"key":"say:14:1621120011:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1621120011","action_index":"1","choice_index":"","choice_id":"","source_cn":"你知不知道那场面试，我原本能进最后一轮的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1621120012:1":{"key":"say:15:1621120012:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1621120012","action_index":"1","choice_index":"","choice_id":"","source_cn":"我花了那么多时间准备……安泽只要一个人，结果你空降过来...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1621120013:2":{"key":"say:16:1621120013:2","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1621120013","action_index":"2","choice_index":"","choice_id":"","source_cn":"芬恩话音一顿，目光移向一旁，声音低了下去。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1621120014:0":{"key":"say:17:1621120014:0","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1621120014","action_index":"0","choice_index":"","choice_id":"","source_cn":"我几乎把所有魔力道具都拿去换甜甜冻了……可其中有一件，...","textdes_