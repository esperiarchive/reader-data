_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1620619006","action_index":"0","choice_index":"","choice_id":"","source_cn":"啧啧，洛兰，其实我一直想问——你是为了什么才想当魔法师的？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1620619007:0":{"key":"say:7:1620619007:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1620619007","action_index":"0","choice_index":"","choice_id":"","source_cn":"为了什么……？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1620619008:0":{"key":"say:8:1620619008:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1620619008","action_index":"0","choice_index":"","choice_id":"","source_cn":"当然得有个理由吧，就像饿了会吃饭，渴了会喝水一样。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1620619009:0":{"key":"say:9:1620619009:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1620619009","action_index":"0","choice_index":"","choice_id":"","source_cn":"我……这个……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1620619010:0":{"key":"say:10:1620619010:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1620619010","action_index":"0","choice_index":"","choice_id":"","source_cn":"比如说，我的魔法启蒙，是镇上的一位魔法师老奶奶教的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1620619011:0":{"key":"say:11:1620619011:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1620619011","action_index":"0","choice_index":"","choice_id":"","source_cn":"那会儿我们镇老是闹旱灾，她的魔法总能带来温润的小雨，救...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1620619012:0":{"key":"say:12:1620619012:0","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1620619012","action_index":"0","choice_index":"","choice_id":"","source_cn":"让我真正对魔法燃起兴趣的，是她对我说的——<style...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1620619013:0":{"key":"say:13:1620619013:0","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1620619013","action_index":"0","choice_index":"","choice_id":"","source_cn":"就因为这句话，我才一直坚持学水魔法，希望有一天能像她那...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1620619014:0":{"key":"say:14:1620619014:0","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1620619014","action_index":"0","choice_index":"","choice_id":"","source_cn":"所以学术对我来说是为了实现目标而存在的，不然就是本末倒置。","te