","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1620925003:1":{"key":"say:3:1620925003:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1620925003","action_index":"1","choice_index":"","choice_id":"","source_cn":"你想，雷蒙校长每天要处理很多事情，他在的地方总是很热闹...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1620925004:1":{"key":"say:4:1620925004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1620925004","action_index":"1","choice_index":"","choice_id":"","source_cn":"而且，他还随身携带着《莱希拉姆笑话大全》，时不时就来一...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1620925005:1":{"key":"say:5:1620925005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1620925005","action_index":"1","choice_index":"","choice_id":"","source_cn":"说起来，他还和我约好，以后要一起打一局百物牌，比比谁翻...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:奈特利":{"key":"speaker:奈特利","source":"奈特利"}},"stats":{"source_node_count":7,"graph_node_count":6,"effect_event_count":0,"text_entry_count":5,"speaker_entry_count":1,"cast_state_line_count":5,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}