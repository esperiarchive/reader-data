_entries":{"say:2:1611036101:0":{"key":"say:2:1611036101:0","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1611036101","action_index":"0","choice_index":"","choice_id":"","source_cn":"格墨文……<key:dialog2>","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1611036102:0":{"key":"say:3:1611036102:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1611036102","action_index":"0","choice_index":"","choice_id":"","source_cn":"事已至此，你还要隐瞒你的腿伤已经痊愈的事实吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1611036103:0":{"key":"say:4:1611036103:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1611036103","action_index":"0","choice_index":"","choice_id":"","source_cn":"你来找我，是为这个？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1611036104:0":{"key":"say:5:1611036104:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1611036104","action_index":"0","choice_index":"","choice_id":"","source_cn":"我的腿伤治不好，这是所有人都知道的事情。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1611036105:0":{"key":"say:6:1611036105:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1611036105","action_index":"0","choice_index":"","choice_id":"","source_cn":"对一个无法行走的人提出这种问题……是一种羞辱。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1611036106:0":{"key":"say:7:1611036106:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1611036106","action_index":"0","choice_index":"","choice_id":"","source_cn":"你那引以为傲的骑士精神到哪儿去了？你仍然将我视为朋友吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1611036107:0":{"key":"say:8:1611036107:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1611036107","action_index":"0","choice_index":"","choice_id":"","source_cn":"如果是的话，你今天就不该再来！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1611036108:0":{"key":"say:9:1611036108:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1611036108","action_index":"0","choice_index":"","choice_id":"","source_cn":"格墨文，你是我最好的朋友！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1611036109:0":{"key":"say:10:1611036109:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1611036109","action_index":"0","choice_index":"","choice_id":"","source_cn":"