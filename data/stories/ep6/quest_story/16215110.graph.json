e_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1621511003:1":{"key":"say:4:1621511003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1621511003","action_index":"1","choice_index":"","choice_id":"","source_cn":"我们怕暴露，只能丢下书……他们好像把它带回了图书馆。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1621511004:1":{"key":"say:5:1621511004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1621511004","action_index":"1","choice_index":"","choice_id":"","source_cn":"什么！？那可是一本极其邪恶的魔法书！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1621511005:1":{"key":"say:6:1621511005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1621511005","action_index":"1","choice_index":"","choice_id":"","source_cn":"如果落到喵丽丝那个魔王的手里，整个莱希拉姆都得变成猫抓板！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1621511006:1":{"key":"say:8:1621511006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1621511006","action_index":"1","choice_index":"","choice_id":"","source_cn":"现在……怎么办呢？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1621511007:1":{"key":"say:9:1621511007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1621511007","action_index":"1","choice_index":"","choice_id":"","source_cn":"喵丽丝肯定已经察觉书丢了，现在一定提高警惕了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1621511008:1":{"key":"say:10:1621511008:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1621511008","action_index":"1","choice_index":"","choice_id":"","source_cn":"既然我们没法销毁那本书，就只能赶在她得逞之前，正面对决...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1621511009:1":{"key":"say:12:1621511009:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1621511009","action_index":"1","choice_index":"","choice_id":"","source_cn":"什、什么！？你疯……疯了吧汪达尔！你要跟喵丽丝硬碰硬？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1621511010:1":{"key":"say:13:1621511010:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1621511010","action_index":"1","choice_index":"","choice_id":"","source_cn":"听说她只用一根猫胡须就能施法，把整群麻雀卷成个毛球飞走！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1621511011:1":{"key":"say:14:1621511011:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1621511011","action_index":"1","choice_index":"","choice_id":"","source_cn":"谁也没真见过她出手，但大家都说她的风魔法超可怕……你、...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1621511012:1":{"key":"say:15:1621511012:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1621511012","action_index":"1","choice_index":"","choice_id":"","source_cn":"你一个人去吧！我可不想变成猫奴！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1621511013:1":{"key":"say:16:1621511013:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1621511013","action_index":"1","choice_index":"","choice_id":"","source_cn":"阿就、就……我还有饭没吃完，我先走了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1621511014:1":{"key":"say:18:1621511014:1","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1621511014","action_index":"1","choice_index":"","choice_id":"","source_cn":"几只狗狗一哄而散，转眼就跑得不见踪影。只剩下汪达尔站在...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:20:1621511015:1":{"key":"say:20:1621511015:1","kind":"say","source_no