t_gender":""},"document:4:476:0":{"key":"document:4:476:0","kind":"document","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"尊敬的希尔蒂同学：\n你好，我是普兰德，我注意你已经很久了！\n我学习魔法已经四年了，但每次看到你，我的咒语都会出错。昨天，我想变一朵玫瑰花给你，结果变成了一颗会说话的白菜，它说它喜欢你，但我觉得还是我亲自说比较有诚意。\n老实说吧，我想邀请你一起去魔法训练场散步，如果你不喜欢，地点换成图书馆也行，我可以借给你我爸爸的魔药书，上面有他的笔记。\n如果你愿意和我约会，请给我一个信号，比如在炼金课上把你的坩埚向左转三圈。如果你不愿意，就把它向右转三圈，我会理解的。\n\n<align=\"right\">你的朋友（也许能成为男朋友？），普兰德","textdes_id":"476","document_page_count":"1","document_title_cn":"写给希尔蒂同学","document_order":"1","document_object_id":"0","document_item_id":"6801960","document_icon":"UI/Icon/Item/item_quest_mapstory_item3.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item3.prefab","document_pic":"","document_gender":"false"},"say:5:1631305003:1":{"key":"say:5:1631305003:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1631305003","action_index":"1","choice_index":"","choice_id":"","source_cn":"这封情书直白得可爱，却也稚拙得惊人，就这样递出，大概率...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1631305004:1":{"key":"say:6:1631305004:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1631305004","action_index":"1","choice_index":"","choice_id":"","source_cn":"或者……凭借你丰富的情书书写经验，不妨调整一下措辞，一...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1631305005:1":{"key":"say:7:1631305005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1631305005","action_index":"1","choic