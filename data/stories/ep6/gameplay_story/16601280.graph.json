ument_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1660128002:0":{"key":"say:2:1660128002:0","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1660128002","action_index":"0","choice_index":"","choice_id":"","source_cn":"这一切都欢乐都是因你而生呢，梅林大人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1660128003:0":{"key":"say:3:1660128003:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1660128003","action_index":"0","choice_index":"","choice_id":"","source_cn":"啊，对了，这里还有一封刚刚送达的信件，来自白山公国。应...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"document:4:507:0":{"key":"document:4:507:0","kind":"document","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"致我们远方的朋友，梅林：\n春焰庆安乐。不知远方的你是否一切安好？我与卡列琳娜、柳博米尔等人都牵挂着你。\n自雪米拉一家搬来白山，这片寂静的疆土——亡灵与活死人聚集之地，似乎也因他们的到来而多了一些……温暖。往昔独行的同伴，如今开始在柳博米尔的永寂庄园廊下轻声交谈，分享着各自尘封的记忆。这份久违的生命力，或许是春焰庆最出乎意料的礼物。\n值此佳节，我们——我、柳博米尔、卡列琳娜、铐兰、雪米拉、尼汝和可爱的戴蒙，以及许多你或许叫不出名字的朋友——正聚集在永寂庄园里。幽火在壁炉中安静地燃烧，映照着不再孤单的身影。尽管我们无法亲身感受生者们热闹欢乐的庆典，也不便前往阿瓦隆，但我们的心绪早已跨越生与死的界限，与所有人一同享受这节日的氛围。\n愿此信能借由春焰的暖意，平安抵达你的手中。也愿春焰的星火，为你照亮新岁的每一段旅程。\n你永恒的朋友，\n瓦丽卡\n春焰庆前夕，于永寂庄园","textdes_id":"507","document_page_count":"1","document_title_cn":"","document_order":"1","document_object_id":"0","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_mapstory_item13.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item13.prefab","document_pic":"","document_gender":"false"},"say:5:1660128004:0":{"key":"say:5:1660128004:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1660128004","action_index":"0","choice_index":"","choice_id":"","source_cn":"春焰庆快乐，愿新岁的晨光永远照耀你的旅途。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:多莉":{"key":"speaker:多莉","source":"多莉"}},"stats":{"source_node_count":7,"graph_node_count":6,"effect_event_count":0,"text_entry_count":5,"speaker_entry_count":1,"cast_state_line_count":4,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}