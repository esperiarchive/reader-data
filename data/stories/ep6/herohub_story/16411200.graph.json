ActionNode","statementID":"1641120006","action_index":"1","choice_index":"","choice_id":"","source_cn":"可是，殿下……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1641120007:1":{"key":"say:8:1641120007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1641120007","action_index":"1","choice_index":"","choice_id":"","source_cn":"没什么可是的！我可没少见罗万吃这些东西，他也没出什么事。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1641120008:1":{"key":"say:9:1641120008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1641120008","action_index":"1","choice_index":"","choice_id":"","source_cn":"再说啦，就算真的有问题，不是还有你们吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1641120009:1":{"key":"say:10:1641120009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1641120009","action_index":"1","choice_index":"","choice_id":"","source_cn":"要不这样，你们跟我一起吃好了！全部由本公主请客！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1641120010:1":{"key":"say:11:1641120010:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1641120010","action_index":"1","choice_index":"","choice_id":"","source_cn":