unt":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1641127007:1":{"key":"say:7:1641127007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1641127007","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以不管别人怎么说，我都会把它们好好收藏起来的！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:皮帕":{"key":"speaker:皮帕","source":"皮帕"}},"stats":{"source_node_count":9,"graph_node_count":8,"effect_event_count":0,"text_entry_count":7,"speaker_entry_count":1,"cast_state_line_count":7,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}