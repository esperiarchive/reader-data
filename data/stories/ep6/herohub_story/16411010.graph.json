,"document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1641101009:1":{"key":"say:10:1641101009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1641101009","action_index":"1","choice_index":"","choice_id":"","source_cn":"韦恩教授初研此术，旨在给儿子传信，却因魔法波动导致儿子...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1641101010:1":{"key":"say:11:1641101010:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1641101010","action_index":"1","choice_index":"","choice_id":"","source_cn":"此后，韦恩教授倾其一生钻研此术，至临终方使其稳定安全。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1641101011:1":{"key":"say:12:1641101011:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1641101011","action_index":"1","choice_index":"","choice_id":"","source_cn":"由此，韦恩教授破例得以安葬于莱希拉姆墓园。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:13:1641101011":{"key":"choice_prompt:13:1641101011","kind":"choice_prompt","source_node_id":"13","source_node_type":"__DT.MultiChooseNode","statementID":"1641101011","action_index":"","choice_index":"","choice_id":"","source_cn":"由此，韦恩教授破例得以安葬于莱希拉姆墓园。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","docu