前的非凡故事，多已隐入尘封的卷册内。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1641101002:1":{"key":"say:2:1641101002:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1641101002","action_index":"1","choice_index":"","choice_id":"","source_cn":"令我至今沉淀于心的，是五十七年前秋分夜，东侧第二排一座...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1641101003:1":{"key":"say:3:1641101003:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1641101003","action_index":"1","choice_index":"","choice_id":"","source_cn":"一位身着褴褛黑袍的亡魂，驻足注视墓碑所刻之名——韦恩。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1641101004:1":{"key":"say:4:1641101004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1641101004","action_index":"1","choice_index":"","choice_id":"","source_cn":"莱希拉姆传奇魔法师之一，曾因实验失控一度被除名。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1641101005:1":{"key":"say:5:1641101005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1641101005","action_index":"1","choice_index":"","choice_id":"","source_cn":"我彻夜观察，亡魂未曾有惊扰活人、玷污死者的举动，仅在空...","textdes_id":"","document_page_count":"","document_title_