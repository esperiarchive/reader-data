tionNode","statementID":"1030408203","action_index":"1","choice_index":"","choice_id":"","source_cn":"听说金穗村的大火就是她引发的，真是作孽啊……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1030408204:1":{"key":"say:5:1030408204:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1030408204","action_index":"1","choice_index":"","choice_id":"","source_cn":"可是，魔女姐姐那么漂亮，我不觉得她像坏人！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1030408205:1":{"key":"say:6:1030408205:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1030408205","action_index":"1","choice_index":"","choice_id":"","source_cn":"你这孩子，怎么这么容易就被外表迷惑了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1030408206:1":{"key":"say:7:1030408206:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1030408206","action_index":"1","choice_index":"","choice_id":"","source_cn":"很多虚伪之人，都会披上一层道貌岸然的伪装，为的就是欺骗...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1030408207:1":{"key":"say:8:1030408207:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1030408207","action_index":"1","choice_index":"","choice_id":"","source_cn":"可我觉得，您也挺漂亮的，难道……您也是在骗我？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1030408208:1":{"key":"say:9:1030408208:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1030408208","action_index":"1","choice_index":"","choice_id":"","source_cn":"噢？仅仅是“挺漂亮”吗？来，我带你回去洗洗眼睛。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:言辞犀利的母亲":{"key":"speaker:言辞犀利的母亲","source":"言辞犀利的母亲"},"speaker:阳光开朗小女孩":{"key":"speaker:阳光开朗小女孩","source":"阳光开朗小女孩"}},"stats":{"source_node_count":11,"graph_node_count":9,"effect_event_count":0,"text_entry_count":8,"speaker_entry_count":2,"cast_state_line_count":8,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}