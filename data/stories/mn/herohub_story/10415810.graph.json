_index":"1","choice_index":"","choice_id":"","source_cn":"拳套？我没有拳套啊。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1041581003:1":{"key":"say:3:1041581003:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041581003","action_index":"1","choice_index":"","choice_id":"","source_cn":"至于手臂上的……你说的是这两块鳞甲吧？说是护腕应该也没...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041581004:1":{"key":"say:4:1041581004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041581004","action_index":"1","choice_index":"","choice_id":"","source_cn":"噢！抱歉抱歉，我还以为你也和我一样，是个擅长用拳的摔角手呢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041581005:1":{"key":"say:5:1041581005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041581005","action_index":"1","choice_index":"","choice_id":"","source_cn":"是吗？原来我看起来很像摔角手啊！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041581006:1":{"key":"say:6:1041581006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041581006","action_index":"1","choice_index":"","choice_id":"","source_cn":"可惜我的武技其实不算很出众。要不是有这身还算坚硬的鳞甲...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041581007:1":{"key":"say:7:1041581007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041581007","action_index":"1","choice_index":"","choice_id":"","source_cn":"如果你是在找摔角对手的话，可能要让你失望了，抱歉啦。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041581008:1":{"key":"say:8:1041581008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041581008","action_index":"1","choice_index":"","choice_id":"","source_cn":"不不不，不要这样说。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041581009:1":{"key":"say:9:1041581009:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041581009","action_index":"1","choice_index":"","choice_id":"","source_cn":"像你这么年轻又坚毅的孩子，还与生俱来这么出众的天赋，怎...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041581010:1":{"key":"say:10:1041581010:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041581010","action_index":"1","choice_index":"","choice_id":"","source_cn":"我虽然没有去过沙漠，但也听说过生活在那种环境下有多艰苦...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041581011:1":{"key":"say:11:1041581011:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041581011","action_index":"1","choice_index":"","choice_id":"","source_cn":"“是金子总会发光”！你只是恰巧生在沙漠里，被漫天的沙子...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041581012:1":{"key":"say:12:1041581012:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041581012","action_index":"1","choice_index":"","choice_id":"","source_cn":"咳咳……谢谢你的夸奖……很少有人这么夸奖我呢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041581013:1":{"key":"say:13:1041581013:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041581013","action_index":"1","choice_index":"","choice_id":"","source_cn":"也许你说得对，我该离开沙漠外出旅行一趟——呃，不过要先...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041581014:1":{"key":"say:14:1041581014:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041581014","action_index":"1","choice_index":"","choice_id":"","source_cn":"到时候，我可以去绿裔的领地上看看！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1041581015:1":{"key":"say:15:1041581015:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1041581015","action_index":"1","choice_index":"","choice_id":"","source_cn":"哈哈，那就一言为定！我会去迎接你的！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1041581016:1":{"key":"say:16:1041581016:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1041581016","action_index":"1","choice_index":"","choice_id":"","source_cn":"要是到时你发现了自己的摔角天赋，千万别忘了和我痛快地比...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:坦布尔":{"key":"speaker:坦布尔","source":"坦布尔"},"speaker:阿尔萨":{"key":"speaker:阿尔萨","source":"阿尔萨"}},"stats":{"source_node_count":18,"graph_node_count":17,"effect_event_count":0,"text_entry_count":16,"speaker_entry_count":2,"cast_state_line_count":16,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}