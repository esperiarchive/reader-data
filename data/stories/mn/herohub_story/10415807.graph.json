ype":"__NC.Tasks.Actions.SayBase"}]}},"end:16":{"id":"end:16","type":"end","source_node_id":"16"}},"text_entries":{"say:1:1041580701:1":{"key":"say:1:1041580701:1","kind":"say","source_node_id":"1","source_node_type":"__DT.ActionNode","statementID":"1041580701","action_index":"1","choice_index":"","choice_id":"","source_cn":"阿妮芮尔……你是阿妮芮尔！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1041580702:1":{"key":"say:2:1041580702:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1041580702","action_index":"1","choice_index":"","choice_id":"","source_cn":"艾雅在上，你怎么会变成这副模样？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1041580703:1":{"key":"say:3:1041580703:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041580703","action_index":"1","choice_index":"","choice_id":"","source_cn":"……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041580704:1":{"key":"say:4:1041580704:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041580704","action_index":"1","choice_index":"","choice_id":"","source_cn":"你不认得我了吗？我是亚莉克希啊，以前我们——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041580705:1":{"key":"say:5:1041580705:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041580705","action_index":"1","choice_index":"","choice_id":"","source_cn":"别惺惺作态了，亚莉克希。凡人的情绪不适合出现在你脸上。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041580706:1":{"key":"say:6:1041580706:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041580706","action_index":"1","choice_index":"","choice_id":"","source_cn":"你那无趣的观察凡人的爱好果然把你害得不浅。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041580707:1":{"key":"say:7:1041580707:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041580707","action_index":"1","choice_index":"","choice_id":"","source_cn":"你是半神，别自降身份。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041580708:1":{"key":"say:8:1041580708:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041580708","action_index":"1","choice_index":"","choice_id":"","source_cn":"……你怎么能说出这样的话？这根本不像你，阿妮芮尔！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041580709:1":{"key":"say:9:1041580709:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041580709","action_index":"1","choice_index":"","choice_id":"","source_cn":"——<shk>别再这样称呼我！阿妮芮尔早就死了！</shk>","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041580710:1":{"key":"say:10:1041580710:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041580710","action_index":"1","choice_index":"","choice_id":"","source_cn":"再怎么否认也没用，所有神兵都认得你！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041580711:1":{"key":"say:11:1041580711:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041580711","action_index":"1","choice_index":"","choice_id":"","source_cn":"你失踪了那么久，今天我一定要把你带回去。无论你犯下了什...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041580712:1":{"key":"say:12:1041580712:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041580712","action_index":"1","choice_index":"","choice_id":"","source_cn":"……够了。<key:dialog18>","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041580713:1":{"key":"say:13:1041580713:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041580713","action_index":"1","choice_index":"","choice_id":"","source_cn":"你不是救世主，我更不需要你来救赎。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041580714:1":{"key":"say:14:1041580714:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041580714","action_index":"1","choice_index":"","choice_id":"","source_cn":"恶魔的身份是我自己的选择。从那一刻起，我们就已经是敌人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1041580715:1":{"key":"say:15:1041580715:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1041580715","action_index":"1","choice_index":"","choice_id":"","source_cn":"下一次，如果你不拿起你的翼弓，我会用轮锯取走你的命。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:亚莉克希":{"key":"speaker:亚莉克希","source":"亚莉克希"},"speaker:恩妮瑞尔":{"key":"speaker:恩妮瑞尔","source":"恩妮瑞尔"}},"stats":{"source_node_count":17,"graph_node_count":16,"effect_event_count":0,"text_entry_count":15,"speaker_entry_count":2,"cast_state_line_count":15,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}