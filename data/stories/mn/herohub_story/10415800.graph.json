t":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1041580002:1":{"key":"say:2:1041580002:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1041580002","action_index":"1","choice_index":"","choice_id":"","source_cn":"请恕我冒昧，它们出自何处？或许可以作为我下一场演出的布景。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1041580003:0":{"key":"say:3:1041580003:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041580003","action_index":"0","choice_index":"","choice_id":"","source_cn":"这是我庄园内的永寂花。拿去吧，无需给我报酬。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041580004:1":{"key":"say:4:1041580004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041580004","action_index":"1","choice_index":"","choice_id":"","source_cn":"除了我手中这一束，其他永寂花都会凋零。作为舞台布景来说...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041580005:1":{"key":"say:5:1041580005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041580005","action_index":"1","choice_index":"","choice_id":"","source_cn":"没关系。它们只会在合适的时刻登场，以最美好的姿态，为观...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041580006:1":{"key":"say:6:1041580006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041580006","action_index":"1","choice_index":"","choice_id":"","source_cn":"而这一幕，足以成为永恒。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041580007:1":{"key":"say:7:1041580007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041580007","action_index":"1","choice_index":"","choice_id":"","source_cn":"所谓的永恒，不过是相对凡人有限的生命而言。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041580008:1":{"key":"say:8:1041580008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041580008","action_index":"1","choice_index":"","choice_id":"","source_cn":"对亡灵来说，存在本身已经是一种永恒。而记忆存续的时间未...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041580009:1":{"key":"say:9:1041580009:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041580009","action_index":"1","choice_index":"","choice_id":"","source_cn":"或许。但至少于此刻的我而言，永恒是一种美好的延续。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041580010:1":{"key":"say:10:1041580010:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041580010","action_index":"1","choice_index":"","choice_id":"","source_cn":"生命赐予我的时间太少，让我无法为舞台倾尽所有；而现在，...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041580011:1":{"key":"say:11:1041580011:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041580011","action_index":"1","choice_index":"","choice_id":"","source_cn":"死亡赐予我新生，观众与舞台也从未抛弃我，我理应为他们献...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041580012:1":{"key":"say:12:1041580012:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041580012","action_index":"1","choice_index":"","choice_id":"","source_cn":"这正是我生前未曾做到的事。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041580013:1":{"key":"say:13:1041580013:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041580013","action_index":"1","choice_index":"","choice_id":"","source_cn":"…………","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041580014:1":{"key":"say:14:1041580014:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041580014","action_index":"1","choice_index":"","choice_id":"","source_cn":"你还是一位年轻的亡灵。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1041580015:1":{"key":"say:15:1041580015:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1041580015","action_index":"1","choice_index":"","choice_id":"","source_cn":"也许有一天你会改变想法，不再追求所谓的永恒；又也许永远...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1041580016:1":{"key":"say:16:1041580016:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1041580016","action_index":"1","choice_index":"","choice_id":"","source_cn":"又或许哪一天，你能真正向我证明，永恒的意义。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:塞涅":{"key":"speaker:塞涅","source":"塞涅"},"speaker:柳博米尔":{"key":"speaker:柳博米尔","source":"柳博米尔"}},"stats":{"source_node_count":18,"graph_node_count":17,"effect_event_count":0,"text_entry_count":16,"speaker_entry_count":2,"cast_state_line_count":16,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}