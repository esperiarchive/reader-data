:1:1041547901:1","kind":"say","source_node_id":"1","source_node_type":"__DT.ActionNode","statementID":"1041547901","action_index":"1","choice_index":"","choice_id":"","source_cn":"这儿真是个好地方，要是再来点音乐就更好了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1041547902:1":{"key":"say:2:1041547902:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1041547902","action_index":"1","choice_index":"","choice_id":"","source_cn":"莱卡，你想不想听我讲讲旅行中遇到的趣事？正好配上音乐！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1041547903:1":{"key":"say:3:1041547903:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041547903","action_index":"1","choice_index":"","choice_id":"","source_cn":"你刚刚喝了不少刺激性饮料，现在唱歌不会跑调吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041547904:1":{"key":"say:4:1041547904:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041547904","action_index":"1","choice_index":"","choice_id":"","source_cn":"还记得小时候，有一次你错把发酵的露酿当成山泉饮，一口气...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041547905:1":{"key":"say:5:1041547905:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041547905","action_index":"1","choice_index":"","choice_id":"","source_cn":"那首歌唱得实在是……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041547906:1":{"key":"say:6:1041547906:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041547906","action_index":"1","choice_index":"","choice_id":"","source_cn":"还、还有这种事？！我怎么一点都不记得？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041547907:1":{"key":"say:7:1041547907:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041547907","action_index":"1","choice_index":"","choice_id":"","source_cn":"你只唱到一半就睡着了，当然没印象。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041547908:1":{"key":"say:8:1041547908:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041547908","action_index":"1","choice_index":"","choice_id":"","source_cn":"要不是达赫妮婆婆及时发现，用速生藤托住了你，你肯定会顺...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041547909:1":{"key":"say:9:1041547909:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041547909","action_index":"1","choice_index":"","choice_id":"","source_cn":"后来雅顿贤者来月湖村时，还问婆婆那天唱歌的人是谁，怎么...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041547910:1":{"key":"say:10:1041547910:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041547910","action_index":"1","choice_index":"","choice_id":"","source_cn":"什么？！连老爷子也听到了……我的形象全毁了……！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041547911:1":{"key":"say:11:1041547911:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041547911","action_index":"1","choice_index":"","choice_id":"","source_cn":"那时候你还小呢，雅顿贤者不会往心里去的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041547912:1":{"key":"say:12:1041547912:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041547912","action_index":"1","choice_index":"","choice_id":"","source_cn":"给我讲讲你最近的旅行故事吧，用唱歌的方式也可以。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041547913:1":{"key":"say:13:1041547913:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041547913","action_index":"1","choice_index":"","choice_id":"","source_cn":"好久没有听到你唱歌跑调了，也有点怀念呢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041547914:1":{"key":"say:14:1041547914:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041547914","action_index":"1","choice_index":"","choice_id":"","source_cn":"——我现在绝对不会跑调的！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:洛桑":{"key":"speaker:洛桑","source":"洛桑"},"speaker:莱卡":{"key":"speaker:莱卡","source":"莱卡"}},"stats":{"source_node_count":16,"graph_node_count":15,"effect_event_count":0,"text_entry_count":14,"speaker_entry_count":2,"cast_state_line_count":14,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}