,"document_base_image":"","document_pic":"","document_gender":""},"say:3:1041576102:1":{"key":"say:3:1041576102:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041576102","action_index":"1","choice_index":"","choice_id":"","source_cn":"为何这么问？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041576103:1":{"key":"say:4:1041576103:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041576103","action_index":"1","choice_index":"","choice_id":"","source_cn":"我能看出来……你的眼神中有着与我相似的执着。或者说，与...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041576104:0":{"key":"say:5:1041576104:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041576104","action_index":"0","choice_index":"","choice_id":"","source_cn":"我曾对自己的“生命”不屑一顾，在漫长的永生中寻找着真正...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041576105:1":{"key":"say:6:1041576105:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041576105","action_index":"1","choice_index":"","choice_id":"","source_cn":"……这样啊。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041576106:0":{"key":"say:7:1041576106:0","