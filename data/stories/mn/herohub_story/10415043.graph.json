","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041504304","action_index":"1","choice_index":"","choice_id":"","source_cn":"你刚从海里被船长捞上来的时候，也说了这句话。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041504305:1":{"key":"say:6:1041504305:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041504305","action_index":"1","choice_index":"","choice_id":"","source_cn":"够了，别和我提以前！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041504306:1":{"key":"say:7:1041504306:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041504306","action_index":"1","choice_index":"","choice_id":"","source_cn":"我还说过别靠近我，我不想叫你姐姐！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041504307:1":{"key":"say:8:1041504307:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041504307","action_index":"1","choice_index":"","choice_id":"","source_cn":"再盯着我，我也不管这里是不是别人的地盘了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041504308:1":{"key":"say:9:1041504308:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041504308","action_index":"1","choice_inde