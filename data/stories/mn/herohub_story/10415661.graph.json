document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041566103:1":{"key":"say:4:1041566103:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041566103","action_index":"1","choice_index":"","choice_id":"","source_cn":"我曾经听闻过外界相关的传闻，美丽的孩子，你就是亡灵吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041566104:1":{"key":"say:5:1041566104:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041566104","action_index":"1","choice_index":"","choice_id":"","source_cn":"你现在知道了，让开。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041566105:0":{"key":"say:6:1041566105:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041566105","action_index":"0","choice_index":"","choice_id":"","source_cn":"亡灵的传闻，还是伟大的女王陛下为我等讲述的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041566106:1":{"key":"say:7:1041566106:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041566106","action_index":"1","choice_index":"","choice_id":"","source_cn":"沙利叶那孩子当时还提了一个失礼的问题。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041566107:1":{"key":"say:8:1041566107:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041566107","action_index":"1","choice_index":"","choice_id":"","source_cn":"——“对亡灵来说，杀死他们的是仇人，还是造就他们的父母呢？”","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041566108:1":{"key":"say:9:1041566108:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041566108","action_index":"1","choice_index":"","choice_id":"","source_cn":"……你再说一句，我就不客气了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041566109:1":{"key":"say:10:1041566109:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041566109","action_index":"1","choice_index":"","choice_id":"","source_cn":"我在你的眼中看到了一些有趣的光芒，美丽的孩子。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041566110:1":{"key":"say:11:1041566110:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041566110","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以，你有着为你赋予生命的长者，你是如此感激又依赖着对...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041566111:1":{"key":"say:12:1041566111:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041566111","action_index":"1","choice_index":"","choice_id":"","source_cn":"我有，但我认为那是基本的忠诚。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041566112:1":{"key":"say:13:1041566112:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041566112","action_index":"1","choice_index":"","choice_id":"","source_cn":"那当然是忠诚，孩子，但我认为，那感情更胜于朴素的忠义或...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041566113:1":{"key":"say:14:1041566113:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041566113","action_index":"1","choice_index":"","choice_id":"","source_cn":"我愿意称之为——信仰。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1041566114:1":{"key":"say:15:1041566114:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1041566114","action_index":"1","choice_index":"","choice_id":"","source_cn":"……真是浪费时间，说到底还是个疯了的神棍。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1041566115:1":{"key":"say:16:1041566115:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1041566115","action_index":"1","choice_index":"","choice_id":"","s