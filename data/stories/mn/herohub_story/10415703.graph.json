DT.ActionNode","statementID":"1041570303","action_index":"1","choice_index":"","choice_id":"","source_cn":"相似？我看不出任何相似点。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041570304:1":{"key":"say:5:1041570304:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041570304","action_index":"1","choice_index":"","choice_id":"","source_cn":"我的家园早已倾覆。现在，我属于巫毒神庙。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041570305:1":{"key":"say:6:1041570305:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041570305","action_index":"1","choice_index":"","choice_id":"","source_cn":"至于我的族人，他们都死在了保卫家园与自由的战争里。他们...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041570306:1":{"key":"say:7:1041570306:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041570306","action_index":"1","choice_index":"","choice_id":"","source_cn":"……吾能听出汝之伤痛。请节哀！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041570307:1":{"key":"say:8:1041570307:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041570307","action_index":"1","choice_index":"","choice_id":"","source_cn":"我早已学会忍耐。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041570308:1":{"key":"say:9:1041570308:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041570308","action_index":"1","choice_index":"","choice_id":"","source_cn":"忍耐！何需如此？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041570309:1":{"key":"say:10:1041570309:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041570309","action_index":"1","choice_index":"","choice_id":"","source_cn":"吾等生存于世，难免心中郁结，宣泄压力为人之常情。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041570310:1":{"key":"say:11:1041570310:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041570310","action_index":"1","choice_index":"","choice_id":"","source_cn":"汝可以像吾一般，外出奔跑，感受风与自然。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041570311:1":{"key":"say:12:1041570311:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041570311","action_index":"1","choice_index":"","choice_id":"","source_cn":"呵，我的确会这样做。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041570312:1":{"key":"say:13:1041570312:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041570312","action_index":"1","choice_index":"","choice_id":"","source_cn":"追逐飞射的箭矢，追逐落日，追逐自由，都会让人心情愉悦。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041570313:1":{"key":"say:14:1041570313:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041570313","action_index":"1","choice_index":"","choice_id":"","source_cn":"正是如此！趁着奔跑后的平静时刻梳理毛发，亦是一种别样享受。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1041570314:1":{"key":"say:15:1041570314:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1041570314","action_index":"1","choice_index":"","choice_id":"","source_cn":"……看来你我之间，确实有不少共同语言。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1041570315:1":{"key":"say:16:1041570315:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1041570315","action_index":"1","choice_index":"","choice_id":"","source_cn":"外族的战士，赞东与你立约，待职责卸去，与我来一场速度的较量！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1041570316:1":{"key":"say:17:1041570316:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1041570316","action_index":"1","choice_index":"","choice_id":"","source_cn":"在奔跑一事上，我还从未尝败绩。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1041570317:1":{"key":"say:18:1041570317:1","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1041570317","action_index":"1","choice_index":"","choice_id":"","source_cn":"咕唔！吾正有此意！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:卡夫拉":{"key":"speaker:卡夫拉","source":"卡夫拉"},"speaker:赞东":{"key":"speaker:赞东","source":"赞东"}},"stats":{"source_node_count":20,"graph_node_count":18,"effect_event_count":0,"text_entry_count":17,"speaker_entry_count":2,"cast_state_line_count":17,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}