":"say:4:1041503903:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041503903","action_index":"1","choice_index":"","choice_id":"","source_cn":"你每天除了喝酒还是喝酒，吾从没见你干过什么正事。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041503904:1":{"key":"say:5:1041503904:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041503904","action_index":"1","choice_index":"","choice_id":"","source_cn":"对于年轻人，你实在是个太坏的榜样。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041503905:1":{"key":"say:6:1041503905:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041503905","action_index":"1","choice_index":"","choice_id":"","source_cn":"顿里尔，你从不懂光阴珍贵，只知道拨弄你那些陈腐的乐章。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041503906:1":{"key":"say:7:1041503906:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041503906","action_index":"1","choice_index":"","choice_id":"","source_cn":"如果哪个年轻人听了你的教诲，才是不幸提前踏上了生之暮路。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041503907:1":{"key":"say:8:1041503907:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041503907","action_index":"1","choice_index":"","choice_id":"","source_cn":"萨基塔里斯，你不仅轻浮，而且愚蠢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041503908:1":{"key":"say:9:1041503908:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041503908","action_index":"1","choice_index":"","choice_id":"","source_cn":"顿里尔，你不仅迂腐，还肚量狭隘。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041503909:1":{"key":"say:10:1041503909:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041503909","action_index":"1","choice_index":"","choice_id":"","source_cn":"我只不过诚实地说出了自己的想法，就被你盖上了轻浮愚蠢的帽子。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041503910:1":{"key":"say:11:1041503910:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041503910","action_index":"1","choice_index":"","choice_id":"","source_cn":"放轻松，我是来小酌的，不是来法庭争辩的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041503911:1":{"key":"say:12:1041503911:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041503911","action_index":"1","choice_index":"","choice_id":"","source_cn":"哼，搬弄口舌的雀鸟都不如你会说。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041503912:1":{"key":"say:13:1041503912:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041503912","action_index":"1","choice_index":"","choice_id":"","source_cn":"那可真是谢谢夸奖。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041503913:1":{"key":"say:14:1041503913:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041503913","action_index":"1","choice_index":"","choice_id":"","source_cn":"早知道你在，吾不如回去谱乐！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1041503914:1":{"key":"say:15:1041503914:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1041503914","action_index":"1","choice_index":"","choice_id":"","source_cn":"说真的，我很欣赏你的音乐。它们宏大激昂，一听就让人振奋。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1041503915:1":{"key":"say:16:1041503915:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1041503915","action_index":"1","choice_index":"","choice_id":"","source_cn":"但有的时候，你得学会在生活中插入一些舒缓悠闲的小调。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1041503916:1":{"key":"say:17:1041503916:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1041503916","action_index":"1","choice_index":"","choice_id":"","source_cn":"就好像此刻……杯中美酒满溢，实在不适合发生这么严肃无趣...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:萨基塔里斯":{"key":"speaker:萨基塔里斯","source":"萨基塔里斯"},"speaker:顿里尔":{"key":"speaker:顿里尔","source":"顿里尔"}},"stats":{"source_node_count":19,"graph_node_count":17,"effect_event_count":0,"text_entry_count":16,"speaker_entry_count":2,"cast_state_line_count":16,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}