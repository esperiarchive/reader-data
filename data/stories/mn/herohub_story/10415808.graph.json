:1041580801:1","kind":"say","source_node_id":"1","source_node_type":"__DT.ActionNode","statementID":"1041580801","action_index":"1","choice_index":"","choice_id":"","source_cn":"一位亡灵女士，一尊雕像，一只蝙蝠。看来你就是这个世界上...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1041580802:1":{"key":"say:2:1041580802:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1041580802","action_index":"1","choice_index":"","choice_id":"","source_cn":"我曾经是，但拥有这个身份的人并不止我一个。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1041580803:1":{"key":"say:3:1041580803:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041580803","action_index":"1","choice_index":"","choice_id":"","source_cn":"有什么事？希望你不是来找我告状的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041580804:1":{"key":"say:4:1041580804:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041580804","action_index":"1","choice_index":"","choice_id":"","source_cn":"没什么，我只是好奇梅林的导师的教学水平如何，能否教会我...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041580805:1":{"key":"say:5:1041580805:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","sta