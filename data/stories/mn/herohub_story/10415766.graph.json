","choice_id":"","source_cn":"皮帕，下次你烤松果的时候一定要带上我！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041576611:1":{"key":"say:11:1041576611:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041576611","action_index":"1","choice_index":"","choice_id":"","source_cn":"诶？可是……可是很危险的，要是点燃了你的裙子怎么办？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041576612:1":{"key":"say:12:1041576612:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041576612","action_index":"1","choice_index":"","choice_id":"","source_cn":"那就换一条裙子嘛，这有什么大不了的！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041576613:1":{"key":"say:13:1041576613:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041576613","action_index":"1","choice_index":"","choice_id":"","source_cn":"能亲眼看到你的混沌魔法的奇妙变化，才是最酷的体验好吗！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:佩吉":{"key":"speaker:佩吉","source":"佩吉"},"speaker:皮帕":{"key":"speaker:皮帕","source":"皮帕"}},"stats":{"source_node_count":15,"graph_node_count":14,"effect_event_count":0,"text_entry_count":13,"speaker_entry_count":2,"cast_state_line_count":13,"pat