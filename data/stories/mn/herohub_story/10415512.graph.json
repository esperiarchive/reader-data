ument_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041551205:1":{"key":"say:5:1041551205:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041551205","action_index":"1","choice_index":"","choice_id":"","source_cn":"我有所耳闻。无可抵挡的强大怪兽，与使用火焰与智慧，模仿...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041551206:1":{"key":"say:6:1041551206:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041551206","action_index":"1","choice_index":"","choice_id":"","source_cn":"很多人都认为，那或许象征着古老的神明与魔法师……是人类...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041551207:1":{"key":"say:7:1041551207:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041551207","action_index":"1","choice_index":"","choice_id":"","source_cn":"那么，你认为那真实的吗？还是只是古老故事的演绎？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041551208:1":{"key":"say:8:1041551208:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041551208","action_index":"1","choice_index":"","choice_id":"","source_cn":"历史的真实与否我不敢断言……但，至少有一点我想是不可否认的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041551209:1":{"key":"say:9:1041551209:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041551209","action_index":"1","choice_index":"","choice_id":"","source_cn":"用血肉之躯对抗无情的恶兽，用自己的双手创造崭新的黎明。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041551210:1":{"key":"say:10:1041551210:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041551210","action_index":"1","choice_index":"","choice_id":"","source_cn":"我相信，那份洋溢于心的勇气，无论多少时光流淌，都绝非虚假。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:瓦丽卡":{"key":"speaker:瓦丽卡","source":"瓦丽卡"},"speaker:柳博米尔":{"key":"speaker:柳博米尔","source":"柳博米尔"}},"stats":{"source_node_count":12,"graph_node_count":11,"effect_event_count":0,"text_entry_count":10,"speaker_entry_count":2,"cast_state_line_count":10,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}