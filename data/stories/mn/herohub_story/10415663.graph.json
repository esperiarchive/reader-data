03:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041566303","action_index":"1","choice_index":"","choice_id":"","source_cn":"毕竟岁数到了，又要经常挥舞武器，常运动的地方就常有损耗。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041566304:1":{"key":"say:5:1041566304:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041566304","action_index":"1","choice_index":"","choice_id":"","source_cn":"噢，看起来你也是一位身经百战的战士。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041566305:1":{"key":"say:6:1041566305:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041566305","action_index":"1","choice_index":"","choice_id":"","source_cn":"你这手臂上的伤真了不得，多少年了？看着恢复得也不错。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041566306:1":{"key":"say:7:1041566306:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041566306","action_index":"1","choice_index":"","choice_id":"","source_cn":"记不清了，总有十几二十年了，现在每逢刮风下雨骨头缝那其...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041566307:1":{"key":"say:8:1041566307:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041566307","action_index":"1","choice_index":"","choice_id":"","source_cn":"难免的，我身上没你这么重的伤，到潮湿的地方也发痒。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041566308:1":{"key":"say:9:1041566308:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041566308","action_index":"1","choice_index":"","choice_id":"","source_cn":"至于这假肢，是某位发明家帮我弄的，附带了魔法，能减轻发力。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041566309:1":{"key":"say:10:1041566309:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041566309","action_index":"1","choice_index":"","choice_id":"","source_cn":"只不过用久了，该疼的地方也还是疼，只能自己多拉伸。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041566310:1":{"key":"say:11:1041566310:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041566310","action_index":"1","choice_index":"","choice_id":"","source_cn":"是啊，治疗魔法最多也就止痛，经常派不上用场。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041566311:1":{"key":"say:12:1041566311:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041566311","action_index":"1","choice_index":"","choice_id":"","source_