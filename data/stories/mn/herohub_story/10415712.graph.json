nt_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1041571202:1":{"key":"say:2:1041571202:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1041571202","action_index":"1","choice_index":"","choice_id":"","source_cn":"唔……我做了一个很……很混乱的梦。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1041571203:1":{"key":"say:3:1041571203:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041571203","action_index":"1","choice_index":"","choice_id":"","source_cn":"我梦到了一片沙漠，沙漠的天空中飞翔着一只巨大的鲸鱼……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041571204:1":{"key":"say:4:1041571204:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041571204","action_index":"1","choice_index":"","choice_id":"","source_cn":"啊……那你一定会觉得它很孤单！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041571205:1":{"key":"say:5:1041571205:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041571205","action_index":"1","choice_index":"","choice_id":"","source_cn":"嗯，没错……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041571206:1":{"key":"say:6:1041571206:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041571206","action_index":"1","choice_index":"","choice_id":"","source_cn":"“要是，它能见到同伴，就好了”……我这样想了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041571207:1":{"key":"say:7:1041571207:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041571207","action_index":"1","choice_index":"","choice_id":"","source_cn":"然后，沙漠就下起了暴雨……水面上升，最后变成一片汪洋。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041571208:1":{"key":"say:8:1041571208:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041571208","action_index":"1","choice_index":"","choice_id":"","source_cn":"简直就像……经历了一场海啸……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041571209:1":{"key":"say:9:1041571209:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041571209","action_index":"1","choice_index":"","choice_id":"","source_cn":"塔西，我好像在梦里的沙漠见过你……你没有被海水吞没吧？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041571210:1":{"key":"say:10:1041571210:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041571210","action_index":"1","choice_index":"","choice_id":"","source_cn":"哦……我、我一点事也没有！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041571211:1":{"key":"say:11:1041571211:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041571211","action_index":"1","choice_index":"","choice_id":"","source_cn":"我可是梦境妖精，怎么会在梦里受伤呢……？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041571212:1":{"key":"say:12:1041571212:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041571212","action_index":"1","choice_index":"","choice_id":"","source_cn":"嗯，那就好……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041571213:1":{"key":"say:13:1041571213:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041571213","action_index":"1","choice_index":"","choice_id":"","source_cn":"我……我觉得我需要再睡一觉，感觉很累……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041571214:1":{"key":"say:14:1041571214:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041571214","action_index":"1","choice_index":"","choice_id":"","source_cn":"没错没错，你还是再休息一会吧！我也要去——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1041571215:0":{"key":"say:16:1041571215:0","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1041571215","action_index":"0","choice_index":"","choice_id":"","source_cn":"<shk>——塔西！你竟然在这里！</shk>","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1041571216:0":{"key":"say:17:1041571216:0","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1041571216","action_index":"0","choice_index":"","choice_id":"","source_cn":"你这坏心眼的小蝴蝶！竟然把奥萝菈的梦搅得一塌糊涂！那海...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:19:1041571217:1":{"key":"say:19:1041571217:1","kind":"say","source_node_id":"19","source_node_type":"__DT.ActionNode","statementID":"1041571217","action_index":"1","choice_index":"","choice_id":"","source_cn":"……咦？是塔西做的？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:20:1041571218:1":{"key":"say:20:1041571218:1","kind":"say","source_node_id":"20","source_node_type":"__DT.ActionNode","statementID":"1041571218","action_index":"1","choice_index":"","choice_id":"","source_cn":"我、我不是故意的！奥萝菈想让鲸鱼见见同伴，我只是想帮个...","textdes_id":"","document_page_count":"","document_titl