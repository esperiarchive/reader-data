x":"0","choice_index":"","choice_id":"","source_cn":"请恕我冒昧。但它们看起来非常奇特。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1041570603:1":{"key":"say:3:1041570603:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041570603","action_index":"1","choice_index":"","choice_id":"","source_cn":"没关系，这是我一位朋友发明的速生藤义肢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041570604:1":{"key":"say:4:1041570604:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041570604","action_index":"1","choice_index":"","choice_id":"","source_cn":"如你所见，我曾是一名士兵，双臂都毁于战场上。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041570605:1":{"key":"say:5:1041570605:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041570605","action_index":"1","choice_index":"","choice_id":"","source_cn":"幸好我运气不错，偶然结识了达米安，他是个小发明家。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041570606:1":{"key":"say:6:1041570606:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041570606","action_index":"1","choice_index":"","choice_id":"","source_cn":"藤蔓义肢……果然神奇。","textdes_id":"","document_page_count":