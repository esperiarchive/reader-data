ource_cn":"春焰庆啊，真是个不错的节日……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1041551002:1":{"key":"say:2:1041551002:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1041551002","action_index":"1","choice_index":"","choice_id":"","source_cn":"到处都是灯光与焰火，缤纷的色彩让诗意涌上心头——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1041551003:1":{"key":"say:3:1041551003:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041551003","action_index":"1","choice_index":"","choice_id":"","source_cn":"噢？我怎么记得有些人小时候曾经抱怨过，外面太吵，唱歌都...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041551004:1":{"key":"say:4:1041551004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041551004","action_index":"1","choice_index":"","choice_id":"","source_cn":"最后差点因为别人没能听到自己的表演而哭鼻子……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041551005:1":{"key":"say:5:1041551005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041551005","action_index":"1","choice_index":"","choice_id":"","source_cn":"那、那是很久以前啦，婆婆！我都这么大了，早就不是爱出风...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041551006:1":{"key":"say:6:1041551006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041551006","action_index":"1","choice_index":"","choice_id":"","source_cn":"哈哈哈，上岁数了就是喜欢回忆过往。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041551007:1":{"key":"say:7:1041551007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041551007","action_index":"1","choice_index":"","choice_id":"","source_cn":"转眼间，你也长成大小伙子了，年年在外，难得回来一趟。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041551008:1":{"key":"say:8:1041551008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041551008","action_index":"1","choice_index":"","choice_id":"","source_cn":"不过今年春焰庆倒是不一样了，不仅是你，好像大家都说过要...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041551009:1":{"key":"say:9:1041551009:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041551009","action_index":"1","choice_index":"","choice_id":"","source_cn":"是吗？那就交给我吧！婆婆！我去把他们叫来，绝不会错过您...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041551010:1":{"key":"say:10:1041551010:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041551010","action_index":"1","choice_index":"","choice_id":"","source_cn":"到时候我给您放个大烟花！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041551011:1":{"key":"say:11:1041551011:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041551011","action_index":"1","choice_index":"","choice_id":"","source_cn":"真是，这孩子根本还是一样爱出风头嘛……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:洛桑":{"key":"speaker:洛桑","source":"洛桑"},"speaker:达赫妮婆婆":{"key":"speaker:达赫妮婆婆","source":"达赫妮婆婆"}},"stats":{"source_node_count":13,"graph_node_count":12,"effect_event_count":0,"text_entry_count":11,"speaker_entry_count":2,"cast_state_line_count":11,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}