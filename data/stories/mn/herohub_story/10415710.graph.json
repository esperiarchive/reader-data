"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1041571002:0":{"key":"say:2:1041571002:0","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1041571002","action_index":"0","choice_index":"","choice_id":"","source_cn":"你不喜欢雨天吗？空气会很清新。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1041571003:1":{"key":"say:3:1041571003:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041571003","action_index":"1","choice_index":"","choice_id":"","source_cn":"下雨……不舒服。心情不好。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041571004:1":{"key":"say:4:1041571004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041571004","action_index":"1","choice_index":"","choice_id":"","source_cn":"如果雨很大，羽毛会被打湿……这很危险。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041571005:1":{"key":"say:5:1041571005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041571005","action_index":"1","choice_index":"","choice_id":"","source_cn":"你可以躲起来，避雨。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041571006:1":{"key":"say:6:1041571006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041571006","action_index":"1","choice_index":"","choice_id":"","source_cn":"不，不行。主君给我的任务，还没有完成……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041571007:1":{"key":"say:7:1041571007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041571007","action_index":"1","choice_index":"","choice_id":"","source_cn":"主君？那是谁？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041571008:1":{"key":"say:8:1041571008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041571008","action_index":"1","choice_index":"","choice_id":"","source_cn":"主君……就是主君。救了我的人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041571009:1":{"key":"say:9:1041571009:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041571009","action_index":"1","choice_index":"","choice_id":"","source_cn":"你的主君是个好人吗？会给你食物，照顾你吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041571010:1":{"key":"say:10:1041571010:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041571010","action_index":"1","choice_index":"","choice_id":"","source_cn":"照顾……我？主君不该做这种事。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041571011:1":{"key":"say:11:1041571011:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041571011","action_index":"1","choice_index":"","choice_id":"","source_cn":"我是主君的仆人……不，我和仆人不一样。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041571012:1":{"key":"say:12:1041571012:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041571012","action_index":"1","choice_index":"","choice_id":"","source_cn":"我只要完成任务……不需要，照顾主君。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041571013:1":{"key":"say:13:1041571013:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041571013","action_index":"1","choice_index":"","choice_id":"","source_cn":"你的主君给你什么任务？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041571014:1":{"key":"say:14:1041571014:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041571014","action_index":"1","choice_index":"","choice_id":"","source_cn":"……抓老鼠。讨厌的、捣乱的老鼠。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1041571015:1":{"key":"say:15:1041571015:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1041571015","action_index":"1","choice_index":"","choice_id":"","source_cn":"这里没有老鼠。我不太明白你要做什么。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1041571016:1":{"key":"say:16:1041571016:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1041571016","action_index":"1","choice_index":"","choice_id":"","source_cn":"但是，和我一起躲雨吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1041571017:1":{"key":"say:17:1041571017:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1041571017","action_index":"1","choice_index":"","choice_id":"","source_cn":"在雨天，所有鸟儿都有休息的权力。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:翼":{"key":"speaker:翼","source":"翼"},"speaker:五月":{"key":"speaker:五月","source":"五月"}},"stats":{"source_node_count":19,"graph_node_count":18,"effect_event_count":0,"text_entry_count":17,"speaker_entry_count":2,"cast_state_line_count":17,"path_dependent_cast_state_count":0,"cinem