,"document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1041580902:0":{"key":"say:2:1041580902:0","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1041580902","action_index":"0","choice_index":"","choice_id":"","source_cn":"陛下，是什么事惹您烦扰？属下愿意替您分忧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1041580903:0":{"key":"say:3:1041580903:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041580903","action_index":"0","choice_index":"","choice_id":"","source_cn":"只怕你帮不上忙。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041580904:1":{"key":"say:4:1041580904:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041580904","action_index":"1","choice_index":"","choice_id":"","source_cn":"是属下无能。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041580905:0":{"key":"say:5:1041580905:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041580905","action_index":"0","choice_index":"","choice_id":"","source_cn":"不是你无能，而是治理国家之事，无法假手他人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041580906:0":{"key":"say:6:1041580906:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041580906","action_index":"0","choice_index":"","choice_id":"","source_cn":"即便那个人是你，我最忠诚的禁卫。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041580907:0":{"key":"say:7:1041580907:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041580907","action_index":"0","choice_index":"","choice_id":"","source_cn":"绝对不会再有人敢背叛您，陛下。即便真有胆大妄为的家伙，...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041580908:0":{"key":"say:8:1041580908:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041580908","action_index":"0","choice_index":"","choice_id":"","source_cn":"我从不怀疑你的忠心，格瑞泽尔勒。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041580909:0":{"key":"say:9:1041580909:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041580909","action_index":"0","choice_index":"","choice_id":"","source_cn":"但信任是一件奢侈的东西。即使如今我面对的是亡灵，也一样。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041580910:0":{"key":"say:10:1041580910:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041580910","action_index":"0","choice_index":"","choice_id":"","source_cn":"活人和死人都会被权利和欲望侵染，没必要再冒这个险。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041580911:0":{"key":"say:11:1041580911:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041580911","action_index":"0","choice_index":"","choice_id":"","source_cn":"属下会牢记您的教诲。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041580912:0":{"key":"say:12:1041580912:0","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041580912","action_index":"0","choice_index":"","choice_id":"","source_cn":"陛下对我的信任，属下也一直铭记于心，永远都不会辜负。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041580913:0":{"key":"say:13:1041580913:0","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041580913","action_index":"0","choice_index":"","choice_id":"","source_cn":"为了陛下，为了班题斯，属下必定竭尽全力为您搜罗更多忠诚...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041580914:0":{"key":"say:14:1041580914:0","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041580914","action_index":"0","choice_index":"","choice_id":"","source_cn":"伊索米亚，终有一