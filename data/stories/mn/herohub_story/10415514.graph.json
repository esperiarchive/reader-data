","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041551410:1":{"key":"say:10:1041551410:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041551410","action_index":"1","choice_index":"","choice_id":"","source_cn":"啊——别说得好像你不喜欢这种模棱两可的囫囵故事一样！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041551411:1":{"key":"say:11:1041551411:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041551411","action_index":"1","choice_index":"","choice_id":"","source_cn":"我有多沉迷那些稀奇古怪的乐子，你就有多中意这些打着谜语...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041551412:1":{"key":"say:12:1041551412:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041551412","action_index":"1","choice_index":"","choice_id":"","source_cn":"既然已经到了这会儿，就放弃思考，尽情地沉沦于欢乐当中吧！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:贝利尔":{"key":"speaker:贝利尔","source":"贝利尔"},"speaker:普鲁斯托":{"key":"speaker:普鲁斯托","source":"普鲁斯托"}},"stats":{"source_node_count":14,"graph_node_count":13,"effect_event_count":0,"text_entry_count":12,"speaker_entry_count":2,"cast_state_line_count":12,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}