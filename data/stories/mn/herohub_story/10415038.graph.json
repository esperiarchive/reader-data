ction_index":"1","choice_index":"","choice_id":"","source_cn":"我不像你，随时都能像看到耗子的猫一样逗他们玩。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041503804:1":{"key":"say:5:1041503804:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041503804","action_index":"1","choice_index":"","choice_id":"","source_cn":"等等……你这是在夸我还是在骂我？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041503805:1":{"key":"say:6:1041503805:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041503805","action_index":"1","choice_index":"","choice_id":"","source_cn":"我偶尔也需要一点自己喝酒的时间。你请便。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041503806:1":{"key":"say:7:1041503806:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041503806","action_index":"1","choice_index":"","choice_id":"","source_cn":"嘿，知道吗？你越是这么说，我就越不想走了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041503807:1":{"key":"say:8:1041503807:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041503807","action_index":"1","choice_index":"","choice_id":"","source_cn":"我听说过一个酒方，朗姆加鼠矛草的汁液和清晨的雪露，如何？","textdes_id":""