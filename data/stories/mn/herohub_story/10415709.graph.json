1","source_node_type":"__DT.ActionNode","statementID":"1041570901","action_index":"0","choice_index":"","choice_id":"","source_cn":"可惜，何等可惜！只差一厘，你就是完美的形态！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1041570902:0":{"key":"say:2:1041570902:0","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1041570902","action_index":"0","choice_index":"","choice_id":"","source_cn":"还在追求你那病态的审美吗，雷内亚？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1041570903:0":{"key":"say:3:1041570903:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1041570903","action_index":"0","choice_index":"","choice_id":"","source_cn":"我当然可以变成你所期望的样子——绝对对称的美人。可我为...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041570904:1":{"key":"say:4:1041570904:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041570904","action_index":"1","choice_index":"","choice_id":"","source_cn":"都用不着探测你心底的欲望，轻而易举就能猜中，呵呵。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041570905:1":{"key":"say:5:1041570905:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041570905","action_index":"1","choice_