nt_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041567203:1":{"key":"say:4:1041567203:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041567203","action_index":"1","choice_index":"","choice_id":"","source_cn":"不过，年轻人们也开始走上台前，我们老一辈也到了放手的时候了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041567204:1":{"key":"say:5:1041567204:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041567204","action_index":"1","choice_index":"","choice_id":"","source_cn":"一代人有一代人的选择，就像丛林的兴衰更替。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041567205:1":{"key":"say:6:1041567205:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041567205","action_index":"1","choice_index":"","choice_id":"","source_cn":"新生、成长、衰老、死亡——这样的轮回，才是最有益于生存的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041567206:1":{"key":"say:7:1041567206:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041567206","action_index":"1","choice_index":"","choice_id":"","source_cn":"……古树可以存在千百年，为何统治就不能如此呢？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041567207:1":{"key":"say:8:1041567207:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041567207","action_index":"1","choice_index":"","choice_id":"","source_cn":"呵呵呵，那是因为，我们生活在丛林中，但我们并非草木啊。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041567208:1":{"key":"say:9:1041567208:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041567208","action_index":"1","choice_index":"","choice_id":"","source_cn":"我们成长得更快，比树木能做的事情更多，所以我们的消亡也...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041567209:1":{"key":"say:10:1041567209:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041567209","action_index":"1","choice_index":"","choice_id":"","source_cn":"如果一个国家，从国王到国民，都有着无比漫长的悠久生命……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041567210:1":{"key":"say:11:1041567210:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041567210","action_index":"1","choice_index":"","choice_id":"","source_cn":"那么那个国度，想必节奏也是同样的缓慢——或许直至今日还...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041567211:1":{"key":"say:12:1041567211:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041567211","action_index":"1","choice_index":"","choice_id":"","source_cn":"那么，如果统治者生命长久，而国民则恰好相反呢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041567212:1":{"key":"say:13:1041567212:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041567212","action_index":"1","choice_index":"","choice_id":"","source_cn":"失去了土壤的植物，最终自己也会衰亡。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041567213:1":{"key":"say:14:1041567213:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041567213","action_index":"1","choice_index":"","choice_id":"","source_cn":"我想，你其实是懂得这个道理的，对吧？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1041567214:1":{"key":"say:15:1041567214:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1041567214","action_index":"1","choice_index":"","choice_id":"","source_cn":"……我只是一介武夫。仅此而已。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:都铎":{"key":"speaker:都铎","source":"都铎"},"speaker:雅顿":{"key":"speaker:雅顿","source":"雅顿"}},"stats":{"sou