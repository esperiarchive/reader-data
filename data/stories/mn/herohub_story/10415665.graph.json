ument_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1041566503:0":{"key":"say:4:1041566503:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1041566503","action_index":"0","choice_index":"","choice_id":"","source_cn":"你混哪边的？你要是到荒角沙漠这边，就报我诡草的大名！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1041566504:0":{"key":"say:5:1041566504:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1041566504","action_index":"0","choice_index":"","choice_id":"","source_cn":"我？我哪里都逛逛，饿了就挣点钱，不饿就玩！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1041566505:0":{"key":"say:6:1041566505:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1041566505","action_index":"0","choice_index":"","choice_id":"","source_cn":"沙漠啊，太晒了吧，又到处都是沙子，而且阿爆说那边有个烦...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1041566506:0":{"key":"say:7:1041566506:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1041566506","action_index":"0","choice_index":"","choice_id":"","source_cn":"你放心，在沙漠有我在，不管什么人找麻烦都不用怕！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1041566507:0":{"key":"say:8:1041566507:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1041566507","action_index":"0","choice_index":"","choice_id":"","source_cn":"到时候我带你坐坐炽翼冲锋者，他可是全沙漠速度第一！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1041566508:0":{"key":"say:9:1041566508:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1041566508","action_index":"0","choice_index":"","choice_id":"","source_cn":"哦！这就是炽翼冲锋者吗？你给坐骑起的名字也很帅啊！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1041566509:0":{"key":"say:10:1041566509:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1041566509","action_index":"0","choice_index":"","choice_id":"","source_cn":"不止是坐骑，还是我的哥们儿，伙伴，朋友！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1041566510:0":{"key":"say:11:1041566510:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1041566510","action_index":"0","choice_index":"","choice_id":"","source_cn":"我明白我明白，我也有这样的好朋友！就是我刚刚说的阿爆！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1041566511:0":{"key":"say:12:1041566511:0","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1041566511","action_index":"0","choice_index":"","choice_id":"","source_cn":"你不仅懂时尚，还懂义气！如今这样的人越来越少见了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1041566512:0":{"key":"say:13:1041566512:0","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1041566512","action_index":"0","choice_index":"","choice_id":"","source_cn":"那帮烦人的老家伙一天到晚说什么奇装异服的，根本不懂时尚嘛！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1041566513:0":{"key":"say:14:1041566513:0","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1041566513","action_index":"0","choice_index":"","choice_id":"","source_cn":"没错！总有一天，得让那帮过时的老家伙们闭嘴！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:库露露":{"key":"speaker:库露露","source":"库露露"},"speaker:诡草":{"key":"speaker:诡草","source":"诡草"}},"stats":{"source_node_count":16,"graph_node_count":14,"effect_event_count":0,"text_entry_count":13,"speaker_entry_count":2,"cast_state_line_count":13,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}