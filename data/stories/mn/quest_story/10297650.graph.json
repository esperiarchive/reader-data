:"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1029765002:1":{"key":"say:3:1029765002:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1029765002","action_index":"1","choice_index":"","choice_id":"","source_cn":"到处都是商铺和游客，比祭典那会儿都不差多少！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1029765003:1":{"key":"say:4:1029765003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1029765003","action_index":"1","choice_index":"","choice_id":"","source_cn":"可不是，旅馆的客人也是一拨接着一拨，天天客满啊！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1029765004:1":{"key":"say:5:1029765004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1029765004","action_index":"1","choice_index":"","choice_id":"","source_cn":"只不过我听着客人们聊天，发现里头有不少人都在抱怨，说路...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:6:1029765004":{"key":"choice_prompt:6:1029765004","kind":"choice_prompt","source_node_id":"6","source_node_type":"__DT.MultiChooseNode","statementID":"1029765004","action_index":"","choice_index":"","choice_id":"","source_cn":"只不过我听着客人们聊天，发现里头有不少人都在抱怨，说路上太麻烦了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1029765005:1":{"key":"say:7:1029765005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1029765005","action_index":"1","choice_index":"","choice_id":"","source_cn":"嗯，来旅店住宿的不仅是游客，有不少都是送货的商人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1029765006:1":{"key":"say:8:1029765006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1029765006","action_index":"1","choice_index":"","choice_id":"","source_cn":"那些蛮血商人说，他们在这边采购了武器零件什么的，总得回...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1029765007:1":{"key":"say:9:1029765007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1029765007","action_index":"1","choice_index":"","choice_id":"","source_cn":"绕路不说，圣石镇那边的审查又特别严格，一来一回浪费不少时间。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1029765008:1":{"key":"say:10:1029765008:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1029765008","action_index":"1","choice_index":"","choice_id":"","source_cn":"是啊，和罗德里戈聊了聊，发现雪松镇这边类似的抱怨和请愿...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1029765009:1":{"key":"say:11:1029765009:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1029765009","action_index":"1","choice_index":"","choice_id":"","source_cn":"他们都希望能让雪松镇与荒角沙漠——乌尔氏族的人直接往来。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1029765010:1":{"key":"say:12:1029765010:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1029765010","action_index":"1","choice_index":"","choice_id":"","source_cn":"要是能建立直接往来的通道，估计蛮血的游客也会增加不少。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1029765011:1":{"key":"say:13:1029765011:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1029765011","action_index":"1","choice_index":"","choice_id":"","source_cn":"哼，我是不喜欢那些只会打架的笨蛋，不过嘛，他们吃喝玩乐...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1029765012:1":{"key":"say:14:1029765012:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1029765012","action_index":"1","choice_index":"","choice_id":"","source_cn":"我的温泉里还有没人敢挑战的超高温，最适合那帮笨蛋的厚皮毛了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1029765013:0":{"key":"say:17:1029765013:0","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1029765013","action_index":"0","choice_index":"","choice_id":"","source_cn":"很好的想法，我刚刚看了看地图，路线和商品都能保证。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1029765014:0":{"key":"say:18:1029765014:0","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1029765014","action_index":"0","choice_index":"","choice_id":"","source_cn":"只需要取得两个地方的许可，用现有的贸易站就完全能够实行了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:19:1029765014":{"key":"choice_prompt:19:1029765014","kind":"choice_prompt","source_node_id":"19","source_node_type":"__DT.MultiChooseNode","statementID":"1029765014","action_index":"","choice_index":"","choice_id":"","source_cn":"只需要取得两个地方的许可，用现有的贸易站就完全能够实行了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:20:1029765015:0":{"key":"say:20:1029765015:0","kind":"say","source_node_id":"20","source_node_type":"__DT.ActionNode","statementID":"1029765015","action_index":"0","choice_index":"","choice_id":"","source_cn":"嗯，事不宜迟，我们快出发吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:19:0:1":{"key":"choice:19:0:1","kind":"choice","source_node_id":"19","source_node_type":"__DT.MultiChooseNode","statementID":"1