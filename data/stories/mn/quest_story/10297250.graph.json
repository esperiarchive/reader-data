,"document_base_image":"","document_pic":"","document_gender":""},"say:5:1029725003:1":{"key":"say:5:1029725003:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1029725003","action_index":"1","choice_index":"","choice_id":"","source_cn":"好久不见，我与锈锚港的所有人都非常期待与你重逢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1029725005:1":{"key":"say:6:1029725005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1029725005","action_index":"1","choice_index":"","choice_id":"","source_cn":"那么，这位新朋友就是信中提到的——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1029725006:0":{"key":"say:7:1029725006:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1029725006","action_index":"0","choice_index":"","choice_id":"","source_cn":"你好，我是罗万，这次代表秘银商会，想要调查下锈锚港这里...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1029725007:0":{"key":"say:8:1029725007:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1029725007","action_index":"0","choice_index":"","choice_id":"","source_cn":"罗万向索尼娅和卢卡快速地介绍了他的计划、愿景与本次行动...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1029725008:0":{"key":"say:9:1029725008:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1029725008","action_index":"0","choice_index":"","choice_id":"","source_cn":"——综上所述，如果一切顺利，有秘银商会背书，锈锚港就可...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1029725009:0":{"key":"say:10:1029725009:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1029725009","action_index":"0","choice_index":"","choice_id":"","source_cn":"棒极了，那么，我会尽快研究下你的计划书，并且整理出目前...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1029725010:0":{"key":"say:11:1029725010:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1029725010","action_index":"0","choice_index":"","choice_id":"","source_cn":"至于货品……就在锈锚港内到处考察下吧，看看罗万有什么想...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1029725011:0":{"key":"say:12:1029725011:0","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1029725011","action_index":"0","choice_index":"","choice_id":"","source_cn":"唔，但这样的话，我恐怕没法陪你们同行太久……卢卡？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1029725012:0":{"key":"say:14:1029725012:0","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1029725012","action_index":"0","choice_index":"","choice_id":"","source_cn":"没问题，交给我就好。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1029725013:0":{"key":"say:15:1029725013:0","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1029725013","action_index":"0","choice_index":"","choice_id":"","source_cn":"那就这么定了，我先陪诸位到处逛逛，后续详细的介绍就交给...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1029725014:0":{"key":"say:18:1029725014:0","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1029725014","action_index":"0","choice_index":"","choice_id":"","source_cn":"还是一样雷厉风行啊，索尼娅。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:19:1029725015:0":{"key":"say:19:1029725015:0","kind":"say","source_node_id":"19","source_node_type":"__DT.ActionNode","statementID":"1029725015","action_index":"0","choice_index":"","choice_id":"","source_cn":"这正是我理想的合作对象——无论此前的蛮血部落还是锈锚港...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:20:1029725016:0":{"key":"say:20:1029725016:0","kind":"say","source_node_id":"20","source_node_type":"__DT.ActionNode","statementID":"1029725016","action_index":"0","choice_index":"","choice_id":"","source_cn":"那么，接下来能否拜托二位带我到你们这里比较有代表性的市...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:21:1029725017:0":{"key":"say:21:1029725017:0","kind":"say","source_node_id":"21","source_node_type":"__DT.SayBaseNode","statementID":"1029725017","action_index":"0","choice_index":"","choice_id":"","source_cn":"当然，请跟我来，锈锚港最大的鱼市就在那边。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:4:0:1":{"key":"choice:4:0:1","kind":"choice","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1029725001","action_index":"","choice_index":"0","choice_id":"1","source_cn":"好久不见，索尼娅！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:23:1029725004:1":{"key":"say:23:1029725004:1","kind":"say","source_node_id":"23","source_node_type":"__DT.ActionNode","statementID":"1029725004","action_index":"1","choice_index":"","choice_id":"","source_cn":"很好，看到你也像之前一样健康，想必你的日子也一样不错。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:4:1:2":{"key":"choice:4:1:2","kind":"choice","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1029725001","action_index":"","choice_index":"1","choice_id":"2","source_cn":"最近过得怎么样？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:索尼娅":{"key":"speaker:索尼娅","source":"索尼娅"},"speaker:罗万":{"key":"speaker:罗万","source":"罗万"},"speaker:旁白":{"key":"speaker:旁白","source":"旁白"},"speaker:卢卡":{"key":"speaker:卢卡","source":"卢卡"},"speaker:漫漫":{"key":"speaker:漫漫","source":"漫漫"}},"stats":{"source_node_count":24,"graph_node_count":19,"effect_event_count":0,"text_entry_count":20,"speaker_entry_count":5,"cast_state_line_count":17,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}