ocument_gender":""},"say:5:1024107004:0":{"key":"say:5:1024107004:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1024107004","action_index":"0","choice_index":"","choice_id":"","source_cn":"昨天晚上，它对着鹅群叫了几声，然后我含辛茹苦养大的白鹅...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1024107005:0":{"key":"say:6:1024107005:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1024107005","action_index":"0","choice_index":"","choice_id":"","source_cn":"不只是我，<style=highlight>秘银商会的...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1024107006:0":{"key":"say:7:1024107006:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1024107006","action_index":"0","choice_index":"","choice_id":"","source_cn":"真是对不起，秘银商会一定会赔偿您的损失，请笑纳！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1024107007:0":{"key":"say:8:1024107007:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1024107007","action_index":"0","choice_index":"","choice_id":"","source_cn":"那么，您的鹅圈——不，您的府邸，在哪里呢？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1024107008:0":{"key":"say:9:1024107008:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1024107008","action_index":"0","choice_index":"","choice_id":"","source_cn":"我家就在圣石镇西边。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1024107009:0":{"key":"say:10:1024107009:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1024107009","action_index":"0","choice_index":"","choice_id":"","source_cn":"话说小哥，你住哪里？我都把住址告诉你了，咱们以后可以多...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1024107010:0":{"key":"say:11:1024107010:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1024107010","action_index":"0","choice_index":"","choice_id":"","source_cn":"——感谢小姐垂青，我还有事要忙，之后一定！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:维伦":{"key":"speaker:维伦","source":"维伦"},"speaker:养鹅的农妇":{"key":"speaker:养鹅的农妇","source":"养鹅的农妇"},"speaker:罗万":{"key":"speaker:罗万","source":"罗万"}},"stats":{"source_node_count":13,"graph_node_count":11,"effect_event_count":0,"text_entry_count":10,"speaker_entry_count":3,"cast_state_line_count":10,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}