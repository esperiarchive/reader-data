dex":"1","choice_index":"","choice_id":"","source_cn":"那么，你在这里买了什么好东西吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1029782008:1":{"key":"say:10:1029782008:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1029782008","action_index":"1","choice_index":"","choice_id":"","source_cn":"当然了，给每个人都带了礼物，我还遇到了一位蛮血的年轻朋...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1029782009:1":{"key":"say:11:1029782009:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1029782009","action_index":"1","choice_index":"","choice_id":"","source_cn":"那孩子很像伊戈尔，虽然外表成熟，但内心还是个小孩子——...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1029782010:1":{"key":"say:12:1029782010:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1029782010","action_index":"1","choice_index":"","choice_id":"","source_cn":"那是噜噜，荒角沙漠的大画家！他画的画可好看了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1029782011:1":{"key":"say:13:1029782011:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1029782011","action_index":"1","choice_index":"","choice_id":"","source_cn":"呵呵，我不太懂艺术，但我也能感觉到，所以我带了些他的创...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1029782012:1":{"key":"say:14:1029782012:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1029782012","action_index":"1","choice_index":"","choice_id":"","source_cn":"说不定他们之间会成为笔友呢——毕竟现在也有通信渠道了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1029782013:1":{"key":"say:15:1029782013:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1029782013","action_index":"1","choice_index":"","choice_id":"","source_cn":"啊，对了，瓦丽卡，我们来找你是想邀请你——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:16:1029782013":{"key":"choice_prompt:16:1029782013","kind":"choice_prompt","source_node_id":"16","source_node_type":"__DT.MultiChooseNode","statementID":"1029782013","action_index":"","choice_index":"","choice_id":"","source_cn":"啊，对了，瓦丽卡，我们来找你是想邀请你——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1029782014:1":{"key":"say:17:1029782014:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1029782014","action_index":"1","choice_index":"","choice_id":"","source_cn":"真的吗？听起来很有趣。那我就参加了你组织的活动后再走吧。","textdes_id":"","document_page_count":"