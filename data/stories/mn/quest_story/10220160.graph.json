ctionNode","statementID":"1022016001","action_index":"1","choice_index":"","choice_id":"","source_cn":"你应该认识那位灰烬魔女吧，太好了，能不能帮我劝劝她？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1022016002:0":{"key":"say:3:1022016002:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1022016002","action_index":"0","choice_index":"","choice_id":"","source_cn":"最近不知道为什么，她总是在附近徘徊，然后突如其来——砰...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1022016003:1":{"key":"say:4:1022016003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1022016003","action_index":"1","choice_index":"","choice_id":"","source_cn":"说实话，我对灰烬魔女本人没什么偏见，但钓不上鱼就炸鱼这...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1022016004:1":{"key":"say:5:1022016004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1022016004","action_index":"1","choice_index":"","choice_id":"","source_cn":"那你怎么不直接和她说啊？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1022016005:1":{"key":"say:6:1022016005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1022016005","action_index":"1","choice_index":"","choice_id":"",