05001","action_index":"1","choice_index":"","choice_id":"","source_cn":"阿爸，这些大哥哥大姐姐是谁？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1012605002:1":{"key":"say:4:1012605002:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1012605002","action_index":"1","choice_index":"","choice_id":"","source_cn":"来，孩子，我们一起感谢这些林隐村的恩人，是他们清理了魔物。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1012605003:1":{"key":"say:5:1012605003:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1012605003","action_index":"1","choice_index":"","choice_id":"","source_cn":"谢谢大哥哥大姐姐们！林隐村给你们添麻烦了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1012605004:1":{"key":"say:6:1012605004:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1012605004","action_index":"1","choice_index":"","choice_id":"","source_cn":"这是我们的职责，事后要感谢就谢梅林吧。\\n布莱恩，刚才...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1012605005:1":{"key":"say:9:1012605005:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1012605005","action_index":"1","choice_index":"","choice_id":"","source_cn":"有，那些人都很害怕，为了不惊动他们我没有声张。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1012605006:1":{"key":"say:10:1012605006:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1012605006","action_index":"1","choice_index":"","choice_id":"","source_cn":"孩子，和你一起逃出来的村民都在这里吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1012605007:1":{"key":"say:11:1012605007:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1012605007","action_index":"1","choice_index":"","choice_id":"","source_cn":"是的！有人受伤了，我是为了找药草才出来的！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1012605008:1":{"key":"say:14:1012605008:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1012605008","action_index":"1","choice_index":"","choice_id":"","source_cn":"我们看到了他刚才的无畏，你有个勇敢的儿子，伊凡。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1012605009:1":{"key":"say:15:1012605009:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1012605009","action_index":"1","choice_index":"","choice_id":"","source_cn":"是啊，这孩子将来一定会成为个好村长，至少比我要称职……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1012605010:1":{"key":"say:16:1012605010:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1012605010","action_index":"1","choice_index":"","choice_id":"","source_cn":"带我们去找其他村民吧，药草的事我们一起想办法。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:凯尔温":{"key":"speaker:凯尔温","source":"凯尔温"},"speaker:村长伊凡":{"key":"speaker:村长伊凡","source":"村长伊凡"},"speaker:埃隆":{"key":"speaker:埃隆","source":"埃隆"},"speaker:布莱恩":{"key":"speaker:布莱恩","source":"布莱恩"}},"stats":{"source_node_count":18,"graph_node_count":11,"effect_event_count":0,"text_entry_count":10,"speaker_entry_count":4,"cast_state_line_count":10,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}