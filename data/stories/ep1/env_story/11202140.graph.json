ce_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1120214004","action_index":"1","choice_index":"","choice_id":"","source_cn":"……你！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1120214005:1":{"key":"say:6:1120214005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1120214005","action_index":"1","choice_index":"","choice_id":"","source_cn":"等等，我没听错吧？索恩是……奥格的儿子？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1120214006:1":{"key":"say:7:1120214006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1120214006","action_index":"1","choice_index":"","choice_id":"","source_cn":"原来你的同伴们还不知道这件事？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1120214007:1":{"key":"say:8:1120214007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1120214007","action_index":"1","choice_index":"","choice_id":"","source_cn":"索恩是我的兄弟，也是父亲的儿子。但因为他出生时太过孱弱...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1120214008:1":{"key":"say:9:1120214008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1120214008","action_index":"1","choice_index":"","choice_id":"","source_cn":"即使是族长之子，弱小也依然会被丢弃。这就是我们黑嚎氏族...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1120214009:1":{"key":"say:10:1120214009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1120214009","action_index":"1","choice_index":"","choice_id":"","source_cn":"……你是怎么做到用如此稀疏平常的语气，说出这么可怕的话的？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1120214010:1":{"key":"say:11:1120214010:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1120214010","action_index":"1","choice_index":"","choice_id":"","source_cn":"毫无人情，只论实力的黑嚎氏族。你们总是擅自给别人打下强...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1120214011:1":{"key":"say:12:1120214011:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1120214011","action_index":"1","choice_index":"","choice_id":"","source_cn":"而在看到昔日的“弱者”凭借自身的力量变强之后，你们又一...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1120214012:1":{"key":"say:13:1120214012:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1120214012","action_index":"1","choice_index":"","choice_id":"","source_cn":"真是太可笑了，我要离开这里!","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:库金":{"key":"speaker:库金","source":"库金"},"speaker:索恩":{"key":"speaker:索恩","source":"索恩"},"speaker:阿尔萨":{"key":"speaker:阿尔萨","source":"阿尔萨"}},"stats":{"source_node_count":15,"graph_node_count":13,"effect_event_count":0,"text_entry_count":12,"speaker_entry_count":3,"cast_state_line_count":12,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}