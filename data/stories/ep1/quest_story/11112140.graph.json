_base_image":"","document_pic":"","document_gender":""},"say:6:1111214004:1":{"key":"say:6:1111214004:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1111214004","action_index":"1","choice_index":"","choice_id":"","source_cn":"小孩子闹脾气，肯定是躲起来了呗。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1111214005:1":{"key":"say:7:1111214005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1111214005","action_index":"1","choice_index":"","choice_id":"","source_cn":"安丹小姐，既然卡卡她对当地很熟悉，应该不需要特别担心吧？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1111214006:1":{"key":"say:8:1111214006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1111214006","action_index":"1","choice_index":"","choice_id":"","source_cn":"嗯……她可能正躲在暗处偷偷观察我们，这样下去是找不到的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1111214007:1":{"key":"say:9:1111214007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1111214007","action_index":"1","choice_index":"","choice_id":"","source_cn":"小孩子的怒火来去匆匆，就像这沙漠的天气。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1111214008:1":{"key":"say:10:1111214008:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1111214008","action_index":"1","choice_index":"","choice_id":"","source_cn":"等她饿到肚子咕咕叫的时候，自然就会出来了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1111214009:1":{"key":"say:11:1111214009:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1111214009","action_index":"1","choice_index":"","choice_id":"","source_cn":"看那孩子的模样，我就知道她是个幸运的家伙，不会有事的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1111214010:1":{"key":"say:12:1111214010:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1111214010","action_index":"1","choice_index":"","choice_id":"","source_cn":"好吧，或许是我多虑了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1111214011:1":{"key":"say:13:1111214011:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1111214011","action_index":"1","choice_index":"","choice_id":"","source_cn":"抱歉，因为我耽误了大家的行程。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1111214012:1":{"key":"say:14:1111214012:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1111