nt_base_image":"","document_pic":"","document_gender":""},"say:5:1111312004:0":{"key":"say:5:1111312004:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1111312004","action_index":"0","choice_index":"","choice_id":"","source_cn":"宴会要开始了！正好，一起！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1111312005:1":{"key":"say:6:1111312005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1111312005","action_index":"1","choice_index":"","choice_id":"","source_cn":"但是，你不能和我抢肉吃！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1111312006:1":{"key":"say:7:1111312006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1111312006","action_index":"1","choice_index":"","choice_id":"","source_cn":"我才没那么无聊！再说……怎么莫名其妙来了一场宴会啊？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1111312007:1":{"key":"say:8:1111312007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1111312007","action_index":"1","choice_index":"","choice_id":"","source_cn":"你不喜欢宴会？但是安丹姐姐喜欢宴会，我也喜欢！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1111312008:1":{"key":"say:9:1111312008:1","kind":