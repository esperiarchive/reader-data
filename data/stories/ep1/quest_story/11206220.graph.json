source_node_type":"__DT.ActionNode","statementID":"1120622003","action_index":"1","choice_index":"","choice_id":"","source_cn":"我……我叫切西格，听说在这里无论做什么都很赚钱，就从家...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1120622004:1":{"key":"say:7:1120622004:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1120622004","action_index":"1","choice_index":"","choice_id":"","source_cn":"可那群天杀的劫匪！出了咸水镇没多久，我就被他们给劫啦！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1120622005:1":{"key":"say:8:1120622005:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1120622005","action_index":"1","choice_index":"","choice_id":"","source_cn":"他们抢了我的财物，还把我打晕，丢在这里自生自灭！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1120622006:1":{"key":"say:9:1120622006:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1120622006","action_index":"1","choice_index":"","choice_id":"","source_cn":"又是匪徒！唉，我记得还有人说咸水镇是个民风淳朴的地方呢……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1120622007:1":{"key":"say:10:1120622007:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1120622007","action_inde