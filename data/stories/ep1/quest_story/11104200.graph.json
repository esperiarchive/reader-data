em_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1110420003:1":{"key":"say:4:1110420003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1110420003","action_index":"1","choice_index":"","choice_id":"","source_cn":"看来你就是索恩。我早该注意到的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1110420004:1":{"key":"say:5:1110420004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1110420004","action_index":"1","choice_index":"","choice_id":"","source_cn":"我相信你有自己的道理，但道理在我哥哥率领的黑嚎是行不通的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:6:1110420004":{"key":"choice_prompt:6:1110420004","kind":"choice_prompt","source_node_id":"6","source_node_type":"__DT.MultiChooseNode","statementID":"1110420004","action_index":"","choice_index":"","choice_id":"","source_cn":"我相信你有自己的道理，但道理在我哥哥率领的黑嚎是行不通的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1110420006:1":{"key":"say:7:1110420006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1110420006","action_index":"1","choice_index":"","choice_id":"","source_cn":"伟大的血脉将我们连接在一起。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1110420007:1":{"key":"say:9:1110420007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1110420007","action_index":"1","choice_index":"","choice_id":"","source_cn":"但是，你能跟我们对话，而不是直接战斗……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1110420008:1":{"key":"say:10:1110420008:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1110420008","action_index":"1","choice_index":"","choice_id":"","source_cn":"你，并不完全认同奥格的想法吧？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1110420009:1":{"key":"say:11:1110420009:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1110420009","action_index":"1","choice_index":"","choice_id":"","source_cn":"我从没说过那样的话。我忠于奥格——作为血亲，也作为族人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1110420010:1":{"key":"say:12:1110420010:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1110420010","action_index":"1","choice_index":"","choice_id":"","source_cn":"他命令我拦住你们，现在我拦住了。但同时——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1110420011:1":{"key":"say:13:1110420011:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1110420011","action_index":"1","choice_index":"","choice_id":"","source_cn":"我也是一名战士。真正的黑嚎战士，面对勇士，绝不会无动于衷。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1110420012:1":{"key":"say:14:1110420012:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1110420012","action_index":"1","choice_index":"","choice_id":"","source_cn":"那么，战斗吧。如果你们能堂堂正正赢了我，我就放你们走！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:6:0:1":{"key":"choice:6:0:1","kind":"choice","source_node_id":"6","source_node_type":"__DT.MultiChooseNode","statementID":"1110420001","action_index":"","choice_index":"0","choice_id":"1","source_cn":"奥格是你的哥哥？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1110420005:1":{"key":"say:16:1110420005:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1110420005","action_index":"1","choice_index":"","choice_id":"","source_cn":"我们确实是黑嚎一脉相承的亲兄弟。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:6:1:2":{"key":"choice:6:1:2","kind":"choice","source_node_id":"6","source_node_type":"__DT.MultiChooseNode","statementID":"1110420001","action_index":"","choice_index":"1","choice_id":"2","source_cn":"你和奥格长得似乎不太像","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:克鲁格":{"key":"speaker:克鲁格","source":"克鲁格"},"speaker:索恩":{"key":"speaker:索恩","source":"索恩"},"speaker:阿尔萨":{"key":"speaker:阿尔萨","source":"阿尔萨"}},"stats":{"source_node_count":17,"graph_node_count":14,"effect_event_count":0,"text_entry_count":15,"speaker_entry_count":3,"cast_state_line_count":12,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}