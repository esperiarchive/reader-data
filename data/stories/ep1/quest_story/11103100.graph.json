_id":"14","source_node_type":"__DT.ActionNode","statementID":"1110310013","action_index":"2","choice_index":"","choice_id":"","source_cn":"战斗中，什么都可能发生，没有哪场战斗必定会输。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1110310014:1":{"key":"say:15:1110310014:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1110310014","action_index":"1","choice_index":"","choice_id":"","source_cn":"强者不会逃避。到了约定之日，阿尔萨……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1110310015:1":{"key":"say:16:1110310015:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1110310015","action_index":"1","choice_index":"","choice_id":"","source_cn":"随便你去不去。我一个人也会准时赴约的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:2:0:1":{"key":"choice:2:0:1","kind":"choice","source_node_id":"2","source_node_type":"__DT.MultiChooseNode","statementID":"1110310001","action_index":"","choice_index":"0","choice_id":"1","source_cn":"她团起来了","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:2:1:2":{"key":"choice:2:1:2","kind":"choice","source_node_id":"2","source_node_type":"__DT.MultiChooseNode","statementID":"1110310001","action_index":"","choice_index":"1","choice_id":