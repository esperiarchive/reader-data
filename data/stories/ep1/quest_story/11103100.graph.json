":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:2:1110310001":{"key":"choice_prompt:2:1110310001","kind":"choice_prompt","source_node_id":"2","source_node_type":"__DT.MultiChooseNode","statementID":"1110310001","action_index":"","choice_index":"","choice_id":"","source_cn":"如果要对付布鲁特斯大人——阿尔萨？喂，阿尔萨！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1110310002:1":{"key":"say:3:1110310002:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1110310002","action_index":"1","choice_index":"","choice_id":"","source_cn":"你这家伙又不肯面对现实了吗？给我出来！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1110310003:1":{"key":"say:4:1110310003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1110310003","action_index":"1","choice_index":"","choice_id":"","source_cn":"别拽我别拽我！索恩，你是疯了吗？你是真的想挑战战神布鲁...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1110310004:1":{"key":"say:5:1110310004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1110310004","action_index":"1","choice_index":"","choice_id":"","source_cn":"你看到他那把大剑砍下来的力道了吧！即使他宽大为怀，留我...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1110310005:1":{"key":"say:6:1110310005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1110310005","action_index":"1","choice_index":"","choice_id":"","source_cn":"你这是什么意思……还没开打，就想着输？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1110310006:1":{"key":"say:7:1110310006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1110310006","action_index":"1","choice_index":"","choice_id":"","source_cn":"我还想问你是什么意思！你莫非觉得你有机会赢？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1110310007:1":{"key":"say:8:1110310007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1110310007","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以，你想临阵脱逃？你想放弃和战神做对手的机会？阿尔萨...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1110310008:1":{"key":"say:9:1110310008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1110310008","action_index":"1","choice_index":"","choice_id":"","source_cn":"老爹将氏族托付给我们，所以，我们要向整片沙漠证明乌尔氏族——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","docu