ent_pic":"","document_gender":""},"choice_prompt:4:1111007002":{"key":"choice_prompt:4:1111007002","kind":"choice_prompt","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1111007002","action_index":"","choice_index":"","choice_id":"","source_cn":"这蛮血少年是你的新搭档？不错啊，看起来身手不差。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1111007003:1":{"key":"say:5:1111007003:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1111007003","action_index":"1","choice_index":"","choice_id":"","source_cn":"当然，赏金猎人常常结伴而行，要是出了意外，能有人收敛遗...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1111007004:1":{"key":"say:6:1111007004:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1111007004","action_index":"1","choice_index":"","choice_id":"","source_cn":"我不会再找搭档了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1111007005:1":{"key":"say:7:1111007005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1111007005","action_index":"1","choice_index":"","choice_id":"","source_cn":"你是怎么被绑的？这事要是传出去，哪个雇主还会找你。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1111007006:1":{"key":"say:8:1111007006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1111007006","action_index":"1","choice_index":"","choice_id":"","source_cn":"哼，就旁边那个旅商，他们商队领头人雇的我。要我保护他们...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1111007007:1":{"key":"say:9:1111007007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1111007007","action_index":"1","choice_index":"","choice_id":"","source_cn":"你又为什么来这里？难道，你还要找弗兰克……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1111007008:1":{"key":"say:10:1111007008:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1111007008","action_index":"1","choice_index":"","choice_id":"","source_cn":"不错。找那家伙过过招。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1111007009:1":{"key":"say:11:1111007009:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1111007009","action_index":"1","choice_index":"","choice_id":"","source_cn":"就你一个人？你准备单枪匹马闯进流沙之爪主营？我听说他比...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1111007010:1":{"key":"say:12:1111007010:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1111007010","action_index":"1","choice_index":"","choice_id":"","source_cn":"我知道你对枪法很自信，但……别重蹈<style=hig...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:13:1111007010":{"key":"choice_prompt:13:1111007010","kind":"choice_prompt","source_node_id":"13","source_node_type":"__DT.MultiChooseNode","statementID":"1111007010","action_index":"","choice_index":"","choice_id":"","source_cn":"我知道你对枪法很自信，但……别重蹈<style=highlight>怀亚特</style>的覆辙。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1111007011:1":{"key":"say:14:1111007011:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1111007011","action_index":"1","choice_index":"","choice_id":"","source_cn":"一把枪的名字。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1111007012:1":{"key":"say:15:1111007012:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1111007012","action_index":"1","choice_index":"","choice_id":"","source_cn":"杰布，你的枪没以前快了，竟然会被这几个流沙之爪俘获。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1111007013:1":{"key":"say:16:1111007013:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1111007013","action_in