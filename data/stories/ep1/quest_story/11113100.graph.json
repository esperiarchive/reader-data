ocument_base_image":"","document_pic":"","document_gender":""},"say:7:1111310005:1":{"key":"say:7:1111310005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1111310005","action_index":"1","choice_index":"","choice_id":"","source_cn":"不止是陆行鸟，我喜欢所有动物！它们很有灵性，什么都懂，...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1111310006:0":{"key":"say:8:1111310006:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1111310006","action_index":"0","choice_index":"","choice_id":"","source_cn":"我的坐骑叫炽翼冲锋者，它经常能预感到危险，救了我好几次。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1111310007:1":{"key":"say:9:1111310007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1111310007","action_index":"1","choice_index":"","choice_id":"","source_cn":"这些陆行鸟，是我最好的伙伴。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1111310008:0":{"key":"say:10:1111310008:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1111310008","action_index":"0","choice_index":"","choice_id":"","source_cn":"那个……我没想到你们会帮忙，谢、谢谢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1111310009:0":{"key":"s