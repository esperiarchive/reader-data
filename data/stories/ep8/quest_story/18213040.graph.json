cument_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1821304012:1":{"key":"say:16:1821304012:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1821304012","action_index":"1","choice_index":"","choice_id":"","source_cn":"幸运的是，你恰好掌握保存记忆的魔法术式——无数个储存在...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:17:1821304012":{"key":"choice_prompt:17:1821304012","kind":"choice_prompt","source_node_id":"17","source_node_type":"__DT.MultiChooseNode","statementID":"1821304012","action_index":"","choice_index":"","choice_id":"","source_cn":"幸运的是，你恰好掌握保存记忆的魔法术式——无数个储存在群星之塔中的<style=highlight>记忆之星</style>就是最好的证明。早在宫廷魔法师选拔赛期间，你就记下了它的制作方式。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:19:1821304013:1":{"key":"say:19:1821304013:1","kind":"say","source_node_id":"19","source_node_type":"__DT.ActionNode","statementID":"1821304013","action_index":"1","choice_index":"","choice_id":"","source_cn":"可否为我详细说明？无需顾虑，我会尽我所能地满足你的需求。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:20:1821304013":{"key":"choice_prompt:20:1821304013","kind":"choice_prompt","source_node_id":"20","source_node_type":"__DT.MultiChooseNode","statementID":"1821304013","action_index":"","choice_index":"","choice_id":"","source_cn":"可否为我详细说明？无需顾虑，我会尽我所能地满足你的需求。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:21:1821304014:1":{"key":"say:21:1821304014:1","kind":"say","source_node_id":"21","source_node_type":"__DT.ActionNode","statementID":"1821304014","action_index":"1","choice_index":"","choice_id":"","source_cn":"纸笔在这里，请随意使用。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:23:1821304015:0":{"key":"narration:23:1821304015:0","kind":"narration","source_node_id":"23","source_node_type":"__DT.ActionNode","statementID":"1821304015","action_index":"0","choice_index":"","choice_id":"","source_cn":"你深吸一口气，开始奋笔疾书……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:24:1821304016:0":{"key":"narration:24:1821304016:0","kind":"narration","source_node_id":"24","source_node_type":"__DT.ActionNode","statementID":"1821304016","action_index":"0","choice_index":"","choice_id":"","source_cn":"幸好，这一次你的记忆力没有拖后腿","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"document:25:638:0":{"key":"document:25:638:0","kind":"document","source_node_id":"25","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"记忆之星是回溯性质的景象，不能记录使用者视角之外的事情，也不能揭露使用者当时内心的旁白。\n若无制作记忆之星的魔法仪器，只能采用基础的制作方式：\n1.施展提取、切割、保存记忆法术的魔法师，需通过莱希拉姆魔法学院专业认证，有2名以上任教老师作为担保，课程均分为“优秀“；\n2.存放记忆的媒介必须是<style=\"highlight\">稳定性极高的魔法素材</style>，还需进行完善的绝缘处理，保证其三百年内都不会变质；\n3.施法前，需准备封存记忆碎片的<style=\"highlight\">时凝液</style>；\n4.必须使用多种<style=\"highlight\">魔导材料</style>来协助施法，否则几乎无法为记忆之星附魔；\n5.施法时，记忆的主人必须集中精神，意志坚定，保证情绪不能和当时有过大差异，以防情感反噬；\n6.提取记忆必须在安静且安全的环境中进行。若为他人施法，也会经受同等的情绪冲击，需做好心理准备；\n7.提取完毕后需及时服用安神药剂，以避免情绪残留或是感官混淆；\n8.一个记忆之星只能储存一段回忆，使用时需向其中注入魔力；\n9.可将记忆之星进行切割与加工，做成使用者喜欢的样子。不要是瓶子、罐子！","textdes_id":"638","document_page_count":"1","document_title_cn":"制作记忆之星术式","document_order":"1","document_object_id":"0","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_mapstory_item13.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item13.prefab","document_pic":"","document_gender":"true"},"choice:20:0:1":{"key":"choice:20:0:1","kind":"choice","source_node_id":"20","source_node_type":"__DT.MultiChooseNode","statementID":"1821304005","action_index":"","choice_index":"0","choice_id":"1","source_cn":"讲着好累，我还是写下来吧","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:20:1:2":{"key":"choice:20:1:2","kind":"choice","source_node_id":"20","source_node_type":"__DT.MultiChooseNode","statementID":"1821304005","action_index":"","choice_index":"1","choice_id":"2","source_cn":"结果还是要再写一遍……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:17:0:1":{"key":"choice:17:0:1","kind":"choice","source_node_id":"17","source_node_type":"__DT.MultiChooseNode","statementID":"1821304004","action_index":"","choice_index":"0","choice_id":"1","source_cn":"我知道方法，但它非常复杂","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id