tions[0]","res_name":"Thane","resource_path":"character/hero/pbsc_char_hero_thane.prefab","resource_code":"thane","resource_stem":"pbsc_char_hero_thane"}],"position_events":[{"dialogue_position":"1","event_type":"AppearActor","source_node_id":"3","action_index":"0","json_path":"nodes[3]._action"}],"active_actor_ids":["2669"],"line_animation_set":"think","line_json_path":"nodes[16]._action.actions[0]","line_action_type":"__NC.Tasks.Actions.SayBase"}]}}},"text_entries":{"say:0:1820616001:0":{"key":"say:0:1820616001:0","kind":"say","source_node_id":"0","source_node_type":"__DT.ActionNode","statementID":"1820616001","action_index":"0","choice_index":"","choice_id":"","source_cn":"亡灵猫刨出了一个小小的土坑，从里面拽出了一个沾满尘土的...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:1:1820616002:0":{"key":"say:1:1820616002:0","kind":"say","source_node_id":"1","source_node_type":"__DT.ActionNode","statementID":"1820616002","action_index":"0","choice_index":"","choice_id":"","source_cn":"你忍不住捡起笔记本，好奇地看了起来。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"document:2:623:0":{"key":"document:2:623:0","kind":"document","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"今天，妈妈给我讲了一个故事。\n很久很久以前有一个小男孩，他一直很向往成为魔法师，想要什么就能变出来什么，不会为任何事忧愁。有一次，他遇到了一个友善的婆婆。婆婆对他说，她有一瓶可以实现愿望的神奇药水，只要喝下它，再睡上一天一夜，他就能实现自己的心愿，永远不用再为任何事担心。虽然没办法让他变成魔法师，但可以让他做到其他人做不到的事，比如飞翔、潜入深海，甚至是倒挂在岩壁上！\n妈妈问我想不想像故事的小男孩一样，没有任何担忧地生活，我当然想了！之后妈妈告诉我，明天<style=\"highlight\">穆婆婆会用魔法实现我的愿望</style>，只要我乖乖喝药，乖乖睡上一觉，就可以<style=\"highlight\">像爸爸一样变成可爱的小猫了</style>。\n我变成动物以后会是什么样子呢？好期待呀！","textdes_id":"623","document_page_count":"1","document_title_cn":"皮普的日记","document_order":"1","document_object_id":"0","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_mapstory_item13.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item13.prefab","document_pic":"","document_gender":"false"},"say:4:1820616003:0":{"key":"say:4:1820616003:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1820616003","action_index":"0","choice_index":"","choice_id":"","source_cn":"人类……变成动物？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1820616004:1":{"key":"say:5:1820616004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1820616004","action_index":"1","choice_index":"","choice_id":"","source_cn":"你和瑟恩面面相觑，沉默半晌，谁也没有说话。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1820616005:0":{"key":"say:6:1820616005:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1820616005","action_index":"0","choice_index":"","choice_id":"","source_cn":"看着眼前这只围着玩具打转的“猫”，你忍不住回想起日记本...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:7:1820616005":{"key":"choice_prompt:7:1820616005","kind":"choice_prompt","source_node_id":"7","source_node_type":"__DT.MultiChooseNode","statementID":"1820616005","action_index":"","choice_index":"","choice_id":"