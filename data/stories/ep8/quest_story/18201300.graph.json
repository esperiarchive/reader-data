document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1820130004:1":{"key":"say:4:1820130004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1820130004","action_index":"1","choice_index":"","choice_id":"","source_cn":"唉……薇薇娅就拜托你了，辛苦你多照顾她一下吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:5:1820130004":{"key":"choice_prompt:5:1820130004","kind":"choice_prompt","source_node_id":"5","source_node_type":"__DT.MultiChooseNode","statementID":"1820130004","action_index":"","choice_index":"","choice_id":"","source_cn":"唉……薇薇娅就拜托你了，辛苦你多照顾她一下吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1820130005:1":{"key":"say:6:1820130005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1820130005","action_index":"1","choice_index":"","choice_id":"","source_cn":"哈哈，你太谦虚了。像你这样刚死不久，还能这么沉稳的亡灵...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1820130006:1":{"key":"say:7:1820130006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1820130006","action_index":"1","choice_index":"","choice_id":"","source_cn":"不过，你好像有些太过沉稳了。有些……沉默？你有什么心事吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_ima