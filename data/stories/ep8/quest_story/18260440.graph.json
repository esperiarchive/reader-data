_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1826044010:1":{"key":"say:12:1826044010:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1826044010","action_index":"1","choice_index":"","choice_id":"","source_cn":"否则一旦惹怒了她，说不准……连海歌剧院都会被她夷为平地。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1826044011:1":{"key":"say:13:1826044011:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1826044011","action_index":"1","choice_index":"","choice_id":"","source_cn":"……领主阁下不会那么做。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1826044012:1":{"key":"say:14:1826044012:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1826044012","action_index":"1","choice_index":"","choice_id":"","source_cn":"我知道，只是开个玩笑。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1826044013:1":{"key":"say:15:1826044013:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1826044013","action_index":"1","choice_index":"","choice_id":"","source_cn":"塞涅小姐，还请不要误会我是在危言耸听。打搅了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","d