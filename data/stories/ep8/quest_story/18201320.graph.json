,"document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1820132002:1":{"key":"say:3:1820132002:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1820132002","action_index":"1","choice_index":"","choice_id":"","source_cn":"怎么，他敢欺负你吗？等着，姨妈现在就去把他的胳膊掰下来——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1820132003:1":{"key":"say:4:1820132003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1820132003","action_index":"1","choice_index":"","choice_id":"","source_cn":"——不不不，他没有欺负我！他给所有人的汇率都是一样的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1820132004:1":{"key":"say:5:1820132004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1820132004","action_index":"1","choice_index":"","choice_id":"","source_cn":"但他给出的汇率实在高得吓人！有人想讲讲价，那个商人还大...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1820132005:1":{"key":"say:6:1820132005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1820132005","action_index":"1","choice_index":"","choice_id":"","source_cn":"有人不服，当场就打算去月弯街尽头的那个酒馆问问价。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1820132006:1":{"key":"say:7:1820132006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1820132006","action_index":"1","choice_index":"","choice_id":"","source_cn":"要不是我赶时间，非得跟着他们一起去一趟……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1820132007:1":{"key":"say:8:1820132007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1820132007","action_index":"1","choice_index":"","choice_id":"","source_cn":"薇薇娅，不要随便去那个酒馆哦。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1820132008:1":{"key":"say:9:1820132008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1820132008","action_index":"1","choice_index":"","choice_id":"","source_cn":"那附近常有活人出没，酒馆甚至可以正当光明地使用耀光金币。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1820132009:1":{"key":"say:10:1820132009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1820132009","action_index":"1","choice_index":"","choice_id":"","source_cn":"如此毫不遮掩，班题斯却从不管。那地方不简单，肯定背靠着...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1820132010:1":{"key":"say:11:1820132010:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1820132010","action_index":"1","choice_index":"","choice_id":"","source_cn":"在诺珐斯期间，一定要尽量避开那个地方。记住了吗，我亲爱...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1820132011:1":{"key":"say:12:1820132011:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1820132011","action_index":"1","choice_index":"","choice_id":"","source_cn":"嗯嗯，记住啦！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1820132012:1":{"key":"say:13:1820132012:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1820132012","action_index":"1","choice_index":"","choice_id":"","source_cn":"不管怎么说，我已经换到了足够的黑铁币了。老板，请帮我把...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1820132013:1":{"key":"say:14:1820132013:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1820132013","action_index":"1","choice_index":"","choice_id":"","source_cn":"唉，你这孩子……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1820132014:1":{"key":"say:15:1820132014:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1820132014","action_i