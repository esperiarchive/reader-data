on":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1820218002:0":{"key":"say:2:1820218002:0","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1820218002","action_index":"0","choice_index":"","choice_id":"","source_cn":"奥克塔维亚！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1820219001:0":{"key":"say:4:1820219001:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1820219001","action_index":"0","choice_index":"","choice_id":"","source_cn":"问答比赛现场，薇薇娅依然在热火朝天地作答。看起来她答得...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1820219002:0":{"key":"say:5:1820219002:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1820219002","action_index":"0","choice_index":"","choice_id":"","source_cn":"就在此时，你忽然听到背后有人用一种极为夸张的语调，唱出...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1820219003:1":{"key":"say:7:1820219003:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1820219003","action_index":"1","choice_index":"","choice_id":"","source_cn":"“抱歉，小姐，我不是故意打扰你，只是听到有人哭泣……”","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1820219004:1":{"