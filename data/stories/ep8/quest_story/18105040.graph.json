":"","document_pic":"","document_gender":""},"say:9:1810504005:0":{"key":"say:9:1810504005:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1810504005","action_index":"0","choice_index":"","choice_id":"","source_cn":"请不必紧张，我不会将刚才发生的事告诉苔佩希阁下。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1810504006:0":{"key":"say:10:1810504006:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1810504006","action_index":"0","choice_index":"","choice_id":"","source_cn":"作为交换，可否请你们高抬贵手，放过面前这几位朋友？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1810504007:1":{"key":"say:11:1810504007:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1810504007","action_index":"1","choice_index":"","choice_id":"","source_cn":"这……可是他们和修缮屋有关，行迹可疑……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1810504008:0":{"key":"say:12:1810504008:0","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1810504008","action_index":"0","choice_index":"","choice_id":"","source_cn":"好啊，你们不放人，那我就告诉所有人，你说了领主的坏话！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1810504009:1":{"key":"say:13:1810504009:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1810504009","action_index":"1","choice_index":"","choice_id":"","source_cn":"你——你这是诬陷！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1810504010:0":{"key":"say:14:1810504010:0","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1810504010","action_index":"0","choice_index":"","choice_id":"","source_cn":"有吗？不知道领主阁下更愿意听塞涅小姐的话，还是你们这些...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1810504011:0":{"key":"say:15:1810504011:0","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1810504011","action_index":"0","choice_index":"","choice_id":"","source_cn":"他们是曾看过我“忌辰”演出的观众，甚至还有一位曾是主演...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1810504012:1":{"key":"say:16:1810504012:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1810504012","action_index":"1","choice_index":"","choice_id":"","source_cn":"好、好吧……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:守卫骨斯特":{"key":"speaker:守卫骨斯特","source":"守卫骨斯特"},"speaker:守卫腐莱彻":{"key":"speaker:守卫腐莱彻","source":"守卫腐莱彻"},"spea