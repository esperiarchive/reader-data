","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1831514007:1":{"key":"say:6:1831514007:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1831514007","action_index":"1","choice_index":"","choice_id":"","source_cn":"就在你仔细查看配方时，另外一排原材料的名字更是让你寒毛...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1831514008:1":{"key":"say:7:1831514008:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1831514008","action_index":"1","choice_index":"","choice_id":"","source_cn":"……够了，真的够了。这绝对是世界上最可怕的东西！你陷入...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:8:1831514008":{"key":"choice_prompt:8:1831514008","kind":"choice_prompt","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1831514008","action_index":"","choice_index":"","choice_id":"","source_cn":"……够了，真的够了。这绝对是世界上最可怕的东西！你陷入了深深的纠结。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1831514009:1":{"key":"say:9:1831514009:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1831514009","action_index":"1","choice_index":"","choice_id":"","source_cn":"你在脑海中回忆了一下这瓶药剂“生前”的模样，然后默默地...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_