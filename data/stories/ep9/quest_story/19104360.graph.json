nt_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:7:1910436006":{"key":"choice_prompt:7:1910436006","kind":"choice_prompt","source_node_id":"7","source_node_type":"__DT.MultiChooseNode","statementID":"1910436006","action_index":"","choice_index":"","choice_id":"","source_cn":"……塔拉萨的海裔虽然脑筋有点不灵光，但他们——变成那群深海疯子的样子？咱……咱不敢想……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1910436007:1":{"key":"say:8:1910436007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1910436007","action_index":"1","choice_index":"","choice_id":"","source_cn":"水行器已经修好了，咱倒是随时都能走。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1910436008:1":{"key":"say:9:1910436008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1910436008","action_index":"1","choice_index":"","choice_id":"","source_cn":"可是，咱不能这样离开。那群浅海裔……咱虽然不理解他们那...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1910436009:1":{"key":"say:10:1910436009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1910436009","action_index":"1","choice_index":"","choice_id":"","source_cn":"卡什澜没有胆小鬼，咱——卡什澜的图澜，更不会一个人逃跑！！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1910436010:1":{"key":"say:11:1910436010:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1910436010","action_index":"1","choice_index":"","choice_id":"","source_cn":"咱想好了，水行器速度快，能载人，咱先送你们回塔拉萨。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1910436011:1":{"key":"say:12:1910436011:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1910436011","action_index":"1","choice_index":"","choice_id":"","source_cn":"真出事了，咱就用水行器带你们逃，能带几个就带几个。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1910436012:1":{"key":"say:13:1910436012:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1910436012","action_index":"1","choice_index":"","choice_id":"","source_cn":"呸！咱不是说那群海底人一定会出事……唉，你就当咱没说前...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:14:1910436012":{"key":"choice_prompt:14:1910436012","kind":"choice_prompt","source_node_id":"14","source_node_type":"__DT.MultiChooseNode","statementID":"1910436012","action_index":"","choice_index":"","choice_id":"","source_cn":"呸！咱不是说那群海底人一定会出事……唉，你就当咱没说前面那句话。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","documen