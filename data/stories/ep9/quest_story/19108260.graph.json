,"document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1910826005:1":{"key":"say:5:1910826005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1910826005","action_index":"1","choice_index":"","choice_id":"","source_cn":"——就、就这样了！别想听咱说第二次！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1910826006:1":{"key":"say:6:1910826006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1910826006","action_index":"1","choice_index":"","choice_id":"","source_cn":"我很喜欢。真的，很喜欢！谢谢你们！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1910826007:1":{"key":"say:7:1910826007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1910826007","action_index":"1","choice_index":"","choice_id":"","source_cn":"这是你们送我的幸运符，是家人亲手制作的宝贵礼物！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1910826008:1":{"key":"say:8:1910826008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1910826008","action_index":"1","choice_index":"","choice_id":"","source_cn":"我会一直戴着它，永远永远都不摘下来！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1910826009:1":{"key":"say:9:1910826009:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1910826009","action_index":"1","choice_index":"","choice_id":"","source_cn":"是啊，家人赠送的珍贵宝物，要永永远远保存下来。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1910826010:1":{"key":"say:10:1910826010:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1910826010","action_index":"1","choice_index":"","choice_id":"","source_cn":"可惜，凡人终有一天会消失，“永远”只是个谎言。多么悲伤啊。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1910826011:1":{"key":"say:11:1910826011:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1910826011","action_index":"1","choice_index":"","choice_id":"","source_cn":"……图澜？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1910826012:1":{"key":"say:12:1910826012:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1910826012","action_index":"1","choice_index":"","choice_id":"","source_cn":"但不用担心，不会再有悲伤的事发生了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1910826013:1":{"key":"say:13:1910826013:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1910826013","action_index":"1","choice_index":"","choice_id":"","source_cn":"不，不要……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1910826014:1":{"key":"say:16:1910826014:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1910826014","action_index":"1","choice_index":"","choice_id":"","source_cn":"你和你的家人们会永远在一起，永远也不会分开。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1910826015:1":{"key":"say:17:1910826015:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1910826015","action_index":"1","choice_index":"","choice_id":"","source_cn":"你们与陆地的凡人并不一样。去真正属于你的地方，与我们重...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1910826016:1":{"key":"say:18:1910826016:1","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1910826016","action_index":"1","choice_index":"","choice_id":"","source_cn":"永远永远。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:EP9-灵体版图澜":{"key":"speaker:EP9-灵体版图澜","source":"EP9-灵体版图澜"},"speaker:EP9-灵体版艾菲拉":{"key":"speaker:EP9-灵体版艾菲拉","source":"EP9-