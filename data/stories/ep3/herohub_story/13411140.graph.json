_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1341114002:0":{"key":"say:3:1341114002:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1341114002","action_index":"0","choice_index":"","choice_id":"","source_cn":"格尔达女士，你不会想家吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1341114003:1":{"key":"say:4:1341114003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1341114003","action_index":"1","choice_index":"","choice_id":"","source_cn":"亲爱的，当然会想了！我的家乡也有座高山，但只有冬天才下...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1341114004:1":{"key":"say:5:1341114004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1341114004","action_index":"1","choice_index":"","choice_id":"","source_cn":"我记得那宏伟又连绵不断的山脉，河水从山上奔腾咆哮着流下...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:6:1341114004":{"key":"choice_prompt:6:1341114004","kind":"choice_prompt","source_node_id":"6","source_node_type":"__DT.MultiChooseNode","statementID":"1341114004","action_index":"","choice_index":"","choice_id":"","source_cn":"我记得那宏伟又连绵不断的山脉，河水从山上奔腾咆哮着流下，还有一个巨大的河谷平原——我的族人就生活在那儿。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1341114005:1":{"key":"say:7:1341114005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1341114005","action_index":"1","choice_index":"","choice_id":"","source_cn":"没错！又壮观，又美丽，又丰饶，再不会有别的地方比那里更好了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1341114006:1":{"key":"say:8:1341114006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1341114006","action_index":"1","choice_index":"","choice_id":"","source_cn":"看来格尔达女士很喜欢自己的家乡啊，为什么不留在那里，而...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1341114007:1":{"key":"say:9:1341114007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1341114007","action_index":"1","choice_index":"","choice_id":"","source_cn":"亲爱的，你肯定知道第二次神魔战争吧？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1341114008:0":{"key":"say:10:1341114008:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1341114008","action_index":"0","choice_index":"","choice_id":"","source_cn":"当然了！但那是二十年前的事情了……难道……那次战争的时...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_i