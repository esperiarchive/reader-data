ind":"say","source_node_id":"1","source_node_type":"__DT.ActionNode","statementID":"1341126001","action_index":"1","choice_index":"","choice_id":"","source_cn":"请允许我再次多谢各位的馈赠。那株冰蓝灵蔓根对我的画来说...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:2:1341126001":{"key":"choice_prompt:2:1341126001","kind":"choice_prompt","source_node_id":"2","source_node_type":"__DT.MultiChooseNode","statementID":"1341126001","action_index":"","choice_index":"","choice_id":"","source_cn":"请允许我再次多谢各位的馈赠。那株冰蓝灵蔓根对我的画来说意义重大。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1341126002:1":{"key":"say:3:1341126002:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1341126002","action_index":"1","choice_index":"","choice_id":"","source_cn":"这不是客气，是真心的感谢。这幅画很重要。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1341126003:1":{"key":"say:4:1341126003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1341126003","action_index":"1","choice_index":"","choice_id":"","source_cn":"我生前画过许多幅画，但我所说的这幅画，是我生前所有画作...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1341126004:1":{"key":"say:6:1341126004:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1341126004","action_index":"1","choice_index":"","choice_id":"","source_cn":"唯一留下来的？那其他的画都去哪里了？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1341126005:1":{"key":"say:7:1341126005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1341126005","action_index":"1","choice_index":"","choice_id":"","source_cn":"我死之后，有少部分画作被别的贵族买回去收藏，毕竟我过去...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1341126006:1":{"key":"say:8:1341126006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1341126006","action_index":"1","choice_index":"","choice_id":"","source_cn":"这幅画能够保留下来，是因为你用魔法了吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1341126007:1":{"key":"say:9:1341126007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1341126007","action_index":"1","choice_index":"","choice_id":"","source_cn":"不，我没有用魔法附灵，而是每隔十年进行一次修复，填上褪...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1341126008:1":{"key":"say:11:1341126008:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1341126008","action_index":"1","choice_index":"","choice_id":"","source_cn":"而那幅画里最漂亮的蓝色，需要用青金石粉末和冰蓝灵蔓根粉...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1341126009:1":{"key":"say:12:1341126009:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1341126009","action_index":"1","choice_index":"","choice_id":"","source_cn":"这些年来，冰蓝灵蔓根越来越难找了，即便是我也得花费很大...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:13:1341126009":{"key":"choice_prompt:13:1341126009","kind":"choice_prompt","source_node_id":"13","source_node_type":"__DT.MultiChooseNode","statementID":"1341126009","action_index":"","choice_index":"","choice_id":"","source_cn":"这些年来，冰蓝灵蔓根越来越难找了，即便是我也得花费很大的心力。所以你瞧，我并没有夸大其词，你们的礼物真的很重要。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1341126010:1":{"key":"say:14:1341126010:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1341126010","action_index":"1","choice_index":"","choice_id":"","source_cn":"有些人喜欢留着第一份作品，因为它代表着开始；有些人则喜...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1341126011:1":{"key":"say:15:1341126011:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1341126011","action_index":"1","choice_index":"","choice_id":"","source_cn":"我的父母曾对着它日夜哭泣哀悼，所以后来我悄悄拿走了它。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1341126012:1":{"key":"say:16:1341126012:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1341126012","action_index":"1","choice_index":"","choice_id":"","source_cn":"那之后，他们终于意识到死亡就是终结，是生命的必经之路。...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1341126013:1":{"key":"say:17:1341126013:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1341126013","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以……我会一直留着它，直到我自己彻底地、真正地死亡那天。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:13:0:1":{"key":"choice:13:0:1","kind":"choice","source_node_id":"13","source_node_type":"__DT.MultiChooseNode","statementID":"1341126002","action_index":"","choice_index":"0","choice_id":"1","source_cn":"那幅画对你来说一定很有意义","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:13:1:2":{"key":"choice:13:1:2","kind":"choice","source_node_id":"13","source_node_type":"__DT.MultiChooseNode","statementID":"1341126002","action_index":"","choice_index":"1","choice_id":"2","source_cn":"为什么你要保留着那幅画？","textdes_id":"","document_page_count":"",