asks.Actions.SayBase"}]}}},"text_entries":{"say:2:1341120001:1":{"key":"say:2:1341120001:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1341120001","action_index":"1","choice_index":"","choice_id":"","source_cn":"咦，柳博米尔？！你怎么会跑到这里来？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1341120002:1":{"key":"say:3:1341120002:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1341120002","action_index":"1","choice_index":"","choice_id":"","source_cn":"我来为亚莲娜送行。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1341120003:1":{"key":"say:4:1341120003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1341120003","action_index":"1","choice_index":"","choice_id":"","source_cn":"我明白了，你也一定很难过吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1341120004:1":{"key":"say:5:1341120004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1341120004","action_index":"1","choice_index":"","choice_id":"","source_cn":"不，谈不上难过。我只是想到她是瓦勒沙家最后一个继承人，...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1341120005:1":{"key":"say:6:1341120005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1341120005","action_index":"1","choice_index":"","choice_id":"","source_cn":"虽然我并不会去参加她的葬礼，不过我依旧会为她献上一束花...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:7:1341120005":{"key":"choice_prompt:7:1341120005","kind":"choice_prompt","source_node_id":"7","source_node_type":"__DT.MultiChooseNode","statementID":"1341120005","action_index":"","choice_index":"","choice_id":"","source_cn":"虽然我并不会去参加她的葬礼，不过我依旧会为她献上一束花——永寂花，和她不怎么搭，但和死亡很衬。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1341120006:1":{"key":"say:8:1341120006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1341120006","action_index":"1","choice_index":"","choice_id":"","source_cn":"至少公国内没有了。至于其他地方，我不知道。或许有些瓦勒...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1341120007:1":{"key":"say:9:1341120007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1341120007","action_index":"1","choice_index":"","choice_id":"","source_cn":"第一次神魔大战之后，耀光帝国建立。杰斯瓦夫·瓦勒沙将军...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1341120008:1":{"key":"say:10:1341120008:1","kind":"say","source_node_id":"10","source_n