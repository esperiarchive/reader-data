":"3","source_node_type":"__DT.ActionNode","statementID":"1311127001","action_index":"1","choice_index":"","choice_id":"","source_cn":"客人们，请坐，想要喝一杯茶吗？我可以用我的脑袋为您沏一...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1311127002:1":{"key":"say:4:1311127002:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1311127002","action_index":"1","choice_index":"","choice_id":"","source_cn":"呃……我就不用了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1311127003:1":{"key":"say:5:1311127003:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1311127003","action_index":"1","choice_index":"","choice_id":"","source_cn":"好呀，满满想要来一杯！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1311127004:1":{"key":"say:7:1311127004:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1311127004","action_index":"1","choice_index":"","choice_id":"","source_cn":"茶壶先生，你在这个废墟……呃，庄园中，服务多久了？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1311127005:1":{"key":"say:8:1311127005:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1311127005","action_index":"1","choice_index":"","choic