t_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1322027004:0":{"key":"say:6:1322027004:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1322027004","action_index":"0","choice_index":"","choice_id":"","source_cn":"爸爸妈妈才带我搬到这里。我们……咳，我们不太喜欢人多的...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1322027005:1":{"key":"say:7:1322027005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1322027005","action_index":"1","choice_index":"","choice_id":"","source_cn":"但你可以白天来找我们玩呀！白天的雪松镇也很漂亮，你一定...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1322027006:1":{"key":"say:8:1322027006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1322027006","action_index":"1","choice_index":"","choice_id":"","source_cn":"对啊。晚上出来大人们会担心，他们觉得你是坏人，要绑架我们！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1322027007:1":{"key":"say:9:1322027007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1322027007","action_index":"1","choice_index":"","choice_id":"","source_cn":"啊？我……我不是坏人，请你们相信我……咳，对不起，但是...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_b