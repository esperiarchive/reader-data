document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1321008002:1":{"key":"say:4:1321008002:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1321008002","action_index":"1","choice_index":"","choice_id":"","source_cn":"呼，不用谢！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1321008003:1":{"key":"say:5:1321008003:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1321008003","action_index":"1","choice_index":"","choice_id":"","source_cn":"整理画具听上去很简单，没想到做起来居然这么费时间。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1321008004:1":{"key":"say:6:1321008004:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1321008004","action_index":"1","choice_index":"","choice_id":"","source_cn":"你平时的工作也很繁重呢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1321008005:2":{"key":"say:7:1321008005:2","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1321008005","action_index":"2","choice_index":"","choice_id":"","source_cn":"这些，不算什么的……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1321008006:1":{"key":"say:8:1321008006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1321008006","action_index":"1","choice_index":"","choice_id":"","source_cn":"我不像茶壶先生那样，陪伴了子爵先生很多年，所以只能做一...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1321008007:1":{"key":"say:9:1321008007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1321008007","action_index":"1","choice_index":"","choice_id":"","source_cn":"别这样说。对于柳博米尔这样的艺术家而言，管理画具是一件...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1321008008:1":{"key":"say:10:1321008008:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1321008008","action_index":"1","choice_index":"","choice_id":"","source_cn":"是啊，要是柳博米尔不重视你，他为什么要为你附魔呢？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1321008009:1":{"key":"say:11:1321008009:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1321008009","action_index":"1","choice_index":"","choice_id":"","source_cn":"或许是因为……我是子爵先生父母亲手种下的永寂花，所以对...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1321008010:1":{"key":"say:12:1321008010:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1321008010","action_index":"1","choice_index":"","choice_id":"","source_cn":"又或者是，子爵先生刚好需要一个仆人，所以选中了在旁边的我……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1321008011:1":{"key":"say:13:1321008011:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1321008011","action_index":"1","choice_index":"","choice_id":"","source_cn":"呃，我们还是换个话题吧……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1321008012:1":{"key":"say:14:1321008012:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1321008012","action_index":"1","choice_index":"","choice_id":"","source_cn":"对了，要去茶壶先生那边喝杯茶吗？他刚才特地请我们邀请你去呢！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1321008013:1":{"key":"say:15:1321008013:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1321008013","action_index":"1","choice_index":"","choice_id":"","source_cn":"啊，茶壶先生，邀请我……？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1321008014:1":{"key":"say:16:1321008014:1","kind":"say","sourc