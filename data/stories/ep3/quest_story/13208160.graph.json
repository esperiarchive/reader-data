ocument_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1320816003:1":{"key":"say:4:1320816003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1320816003","action_index":"1","choice_index":"","choice_id":"","source_cn":"说什么大话！刚才我们不来你就被咬断喉咙了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1320816004:1":{"key":"say:5:1320816004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1320816004","action_index":"1","choice_index":"","choice_id":"","source_cn":"没事！我应付得来！我的铁镐和榔头都很有力量！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1320816005:1":{"key":"say:6:1320816005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1320816005","action_index":"1","choice_index":"","choice_id":"","source_cn":"无论发生什么，安全比什么都重要！突发情况的应对措施也在...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1320816006:1":{"key":"say:7:1320816006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1320816006","action_index":"1","choice_index":"","choice_id":"","source_cn":"知道了……但是也不能误工！我还有活儿要干，不能再耽搁了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"