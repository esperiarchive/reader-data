nd":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1322034007","action_index":"1","choice_index":"","choice_id":"","source_cn":"对对对，就是那个喜欢找人玩，到处搞恶作剧的亡灵！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1322034008:1":{"key":"say:8:1322034008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1322034008","action_index":"1","choice_index":"","choice_id":"","source_cn":"咳，其实这段时间大家也都渐渐知道了，他没什么坏心思，就...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1322034009:1":{"key":"say:9:1322034009:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1322034009","action_index":"1","choice_index":"","choice_id":"","source_cn":"刚才我在外面看到他，担心他晚上又会跑进镇子来，吓到小孩...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1322034010:1":{"key":"say:10:1322034010:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1322034010","action_index":"1","choice_index":"","choice_id":"","source_cn":"放在其他时候还好，但前阵子镇上才出了小孩子半夜被带走的...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1322034011:1":{"key":"say:11:1322034011:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode",