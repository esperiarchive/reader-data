","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1320304002:1":{"key":"say:3:1320304002:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1320304002","action_index":"1","choice_index":"","choice_id":"","source_cn":"别紧张，没那么严重。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1320304003:2":{"key":"say:4:1320304003:2","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1320304003","action_index":"2","choice_index":"","choice_id":"","source_cn":"我是替柳博米尔来的，他请我帮忙找一位画家。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1320304004:1":{"key":"say:5:1320304004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1320304004","action_index":"1","choice_index":"","choice_id":"","source_cn":"但是顶着活死人的身份，做什么都不方便。即使是我，对雪松...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1320304005:1":{"key":"say:6:1320304005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1320304005","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以，只请找你们帮忙。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1320304006:1":{"key":"say:7:1320304006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1320304006","action_index":"1","choice_index":"","choice_id":"","source_cn":"我也这样问柳博米尔，但他也不知道对方的名字。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1320304007:1":{"key":"say:8:1320304007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1320304007","action_index":"1","choice_index":"","choice_id":"","source_cn":"总好过我和柳博米尔出面，那样只会吓到雪松镇里的人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1320304008:1":{"key":"say:9:1320304008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1320304008","action_index":"1","choice_index":"","choice_id":"","source_cn":"具体的情况，等到了永寂庄园，让柳博米尔自己和你说吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:漫漫":{"key":"speaker:漫漫","source":"漫漫"},"speaker:瓦丽卡":{"key":"speaker:瓦丽卡","source":"瓦丽卡"}},"stats":{"source_node_count":11,"graph_node_count":9,"effect_event_count":0,"text_entry_count":8,"speaker_entry_count":2,"cast_state_line_count":8,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}