:"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1310911008:1":{"key":"say:8:1310911008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1310911008","action_index":"1","choice_index":"","choice_id":"","source_cn":"你们知道，这里的人们从古至今，一直虔诚地信仰这位伟大的女神。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1310911009:1":{"key":"say:9:1310911009:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1310911009","action_index":"1","choice_index":"","choice_id":"","source_cn":"如果没有女神的赐福，人们根本无法战胜恶魔，也就不会有现...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1310911010:1":{"key":"say:10:1310911010:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1310911010","action_index":"1","choice_index":"","choice_id":"","source_cn":"没有祂就无法战胜恶魔……呵，你说得对。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1310911011:1":{"key":"say:11:1310911011:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1310911011","action_index":"1","choice_index":"","choice_id":"","source_cn":"所谓“英雄”与凡人的力量，与神明相比毫无意义。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_