"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1320817004:1":{"key":"say:4:1320817004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1320817004","action_index":"1","choice_index":"","choice_id":"","source_cn":"我也准备收工了，等把开凿出来的矿石运到冶炼处，我就回家。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1320817005:1":{"key":"say:5:1320817005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1320817005","action_index":"1","choice_index":"","choice_id":"","source_cn":"再见，朋友们！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1320817006:1":{"key":"say:7:1320817006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1320817006","action_index":"1","choice_index":"","choice_id":"","source_cn":"我的同胞如此认真负责，坚守到最后一刻。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1320817007:1":{"key":"say:8:1320817007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1320817007","action_index":"1","choice_index":"","choice_id":"","source_cn":"好了，你们之前说想参观雕像制作的全流程。一队工匠开凿冰...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1320817008:1":{"key":"say:9:1320817008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1320817008","action_index":"1","choice_index":"","choice_id":"","source_cn":"——跟我来，我们也该回<style=highlight...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:呼金":{"key":"speaker:呼金","source":"呼金"},"speaker:大嗓门矿工":{"key":"speaker:大嗓门矿工","source":"大嗓门矿工"}},"stats":{"source_node_count":11,"graph_node_count":9,"effect_event_count":0,"text_entry_count":8,"speaker_entry_count":2,"cast_state_line_count":8,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}