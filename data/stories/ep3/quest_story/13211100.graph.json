ocument_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1321110006:1":{"key":"say:7:1321110006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1321110006","action_index":"1","choice_index":"","choice_id":"","source_cn":"别装了，我还不知道你？总之……这次你不许告诉阿尔希普！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1321110007:1":{"key":"say:8:1321110007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1321110007","action_index":"1","choice_index":"","choice_id":"","source_cn":"对了，我正好有个问题想问你，你肯定能答上来！\\n——你...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1321110008:1":{"key":"say:9:1321110008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1321110008","action_index":"1","choice_index":"","choice_id":"","source_cn":"……这是“你说最美风景会在哪呢”的前置问题？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1321110009:1":{"key":"say:10:1321110009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1321110009","action_index":"1","choice_index":"","choice_id":"","source_cn":"——你又和我顶嘴！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","documen