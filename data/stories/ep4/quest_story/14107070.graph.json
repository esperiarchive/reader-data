ument_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1410707006:1":{"key":"say:6:1410707006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1410707006","action_index":"1","choice_index":"","choice_id":"","source_cn":"杜恩加尔根本不可能被仿造！毋庸置疑，那是真品！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1410707007:1":{"key":"say:7:1410707007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1410707007","action_index":"1","choice_index":"","choice_id":"","source_cn":"怪了……那把弓上附有阴暗黏腻的气息。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1410707008:1":{"key":"say:8:1410707008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1410707008","action_index":"1","choice_index":"","choice_id":"","source_cn":"虽然气息很微弱，但我认为那绝对不是神明的力量。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:9:1410707008":{"key":"choice_prompt:9:1410707008","kind":"choice_prompt","source_node_id":"9","source_node_type":"__DT.MultiChooseNode","statementID":"1410707008","action_index":"","choice_index":"","choice_id":"","source_cn":"虽然气息很微弱，但我认为那绝对不是神明的力量。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","docume