","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1421446003:1":{"key":"say:10:1421446003:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1421446003","action_index":"1","choice_index":"","choice_id":"","source_cn":"啊，难道您会是新的主祭？天啊，我得到了如此的荣耀——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:2:1:2":{"key":"choice:2:1:2","kind":"choice","source_node_id":"2","source_node_type":"__DT.MultiChooseNode","statementID":"1421446001","action_index":"","choice_index":"1","choice_id":"2","source_cn":"我可不是祭司","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:被释放的平民":{"key":"speaker:被释放的平民","source":"被释放的平民"},"speaker:沙利叶":{"key":"speaker:沙利叶","source":"沙利叶"}},"stats":{"source_node_count":11,"graph_node_count":9,"effect_event_count":0,"text_entry_count":10,"speaker_entry_count":2,"cast_state_line_count":7,"path_dependent_cast_state_count":1,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}