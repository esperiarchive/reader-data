m_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1422660003:0":{"key":"say:3:1422660003:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1422660003","action_index":"0","choice_index":"","choice_id":"","source_cn":"我也同样。因度厄，你的身手强悍，坚韧，每次碰撞，我都能...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1422660004:1":{"key":"say:4:1422660004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1422660004","action_index":"1","choice_index":"","choice_id":"","source_cn":"那并非热血上头的莽撞，而是知晓一切恐怖，却仍然一往无前...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1422660005:0":{"key":"say:5:1422660005:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1422660005","action_index":"0","choice_index":"","choice_id":"","source_cn":"请原谅我之前的无礼。鹿灵的情绪影响了我的判断。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1422660006:0":{"key":"say:6:1422660006:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1422660006","action_index":"0","choice_index":"","choice_id":"","source_cn":"现在我确信，鹿灵对你的排斥不可能来源于你个人的过错。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1422660007:0":{"key":"say:7:1422660007:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1422660007","action_index":"0","choice_index":"","choice_id":"","source_cn":"我想更详细地了解你们的经历。能否从你们的角度为我讲述？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:8:1422660007":{"key":"choice_prompt:8:1422660007","kind":"choice_prompt","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1422660007","action_index":"","choice_index":"","choice_id":"","source_cn":"我想更详细地了解你们的经历。能否从你们的角度为我讲述？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1422660008:1":{"key":"say:9:1422660008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1422660008","action_index":"1","choice_index":"","choice_id":"","source_cn":"能够与龙交锋，颠覆千百年来的历史与扭曲，这份勇气确实令...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1422660009:1":{"key":"say:10:1422660009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1422660009","action_index":"1","choice_index":"","choice_id":"","source_cn":"弥萨忒一向重视公正与真实，不会无故责难寻求真相的人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:1