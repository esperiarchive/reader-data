n":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1421218003:0":{"key":"say:3:1421218003:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1421218003","action_index":"0","choice_index":"","choice_id":"","source_cn":"没关系，我们可以让它们重新活跃起来。大王蜻蜓爱吃新鲜的...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1421218004:0":{"key":"say:4:1421218004:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1421218004","action_index":"0","choice_index":"","choice_id":"","source_cn":"我们得在旁边钓些新鲜的盲泡鱼来。不只是喂食，还要先陪它...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:5:1421218004":{"key":"choice_prompt:5:1421218004","kind":"choice_prompt","source_node_id":"5","source_node_type":"__DT.MultiChooseNode","statementID":"1421218004","action_index":"","choice_index":"","choice_id":"","source_cn":"我们得在旁边钓些新鲜的小鱼来。不只是喂食，还要先陪它们玩捕食的游戏。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1421218005:1":{"key":"say:6:1421218005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1421218005","action_index":"1","choice_index":"","choice_id":"","source_cn":"那我就留在这里，试试能不能让它们开心起来。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1421218007:0":{"key":"say:7:1421218007:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1421218007","action_index":"0","choice_index":"","choice_id":"","source_cn":"拜托两位大人了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1421218008:1":{"key":"say:8:1421218008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1421218008","action_index":"1","choice_index":"","choice_id":"","source_cn":"想想斐利尔大人教的……轻轻靠近它们……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:9:1421218009:0":{"key":"narration:9:1421218009:0","kind":"narration","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1421218009","action_index":"0","choice_index":"","choice_id":"","source_cn":"丽芙留在林地里陪伴大王蜻蜓，而你和因度厄则在一旁的池塘...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1421218010:0":{"key":"say:10:1421218010:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1421218010","action_index":"0","choice_index":"","choice_id":"","source_cn":"看来斐利尔把她教得很好。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"",