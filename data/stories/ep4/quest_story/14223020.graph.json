,"document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1422302005:1":{"key":"say:6:1422302005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1422302005","action_index":"1","choice_index":"","choice_id":"","source_cn":"我只是没脸见人……我该怎么面对弗瑞达和塔莉……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1422302006:1":{"key":"say:7:1422302006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1422302006","action_index":"1","choice_index":"","choice_id":"","source_cn":"我叫哈尔格，是个铁匠。三年前，我从家里出来的时候满口承...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1422302007:1":{"key":"say:8:1422302007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1422302007","action_index":"1","choice_index":"","choice_id":"","source_cn":"弗瑞达和塔莉很支持我，虽然她们在信里从不说家里的困难，...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1422302008:1":{"key":"say:9:1422302008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1422302008","action_index":"1","choice_index":"","choice_id":"","source_cn":"结果我呢，一个子没赚到，兜里空空的就这样回来了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon