001:0":{"key":"say:2:1421231001:0","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1421231001","action_index":"0","choice_index":"","choice_id":"","source_cn":"真像是斐利尔大人会想出来的方法……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1421231002:0":{"key":"say:3:1421231002:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1421231002","action_index":"0","choice_index":"","choice_id":"","source_cn":"斐利尔真是……每次都把简单的事情弄得这么复杂。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1421231003:0":{"key":"say:4:1421231003:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1421231003","action_index":"0","choice_index":"","choice_id":"","source_cn":"宝藏会被施加魔法的蹦蹦菇灵指引嘛……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1421231004:0":{"key":"say:5:1421231004:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1421231004","action_index":"0","choice_index":"","choice_id":"","source_cn":"看来我们要跟着蹦蹦菇灵，走一段有趣的路了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:6:1421231004":{"key":"choice_prompt:6:1421231004","kind":"choice_prompt","source_node_id":"6","source_node_t