rce_cn":"谢谢你，不过我还得再坐一会儿，腿还是有些软。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1411407103:0":{"key":"say:4:1411407103:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1411407103","action_index":"0","choice_index":"","choice_id":"","source_cn":"别待太久，很可能还会发生余震。对了，这附近还有别人吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1411407104:1":{"key":"say:5:1411407104:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1411407104","action_index":"1","choice_index":"","choice_id":"","source_cn":"有吧，挺多的人的，我刚还看到有人一下没站稳，摔在地上滚...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1411407105:1":{"key":"say:6:1411407105:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1411407105","action_index":"1","choice_index":"","choice_id":"","source_cn":"还有人躲到角落去，被石头砸了下脑袋，嗷嗷叫个不停。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1411407106:1":{"key":"say:7:1411407106:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1411407106","action_index":"1","choice_index":"","choice_id":"","source_cn":"不过都没什么大事，跑出来的和像我这样摔倒的还是占多数。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1411407107:1":{"key":"say:8:1411407107:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1411407107","action_index":"1","choice_index":"","choice_id":"","source_cn":"队长等会儿也会安排人救助的，你们不用担心，矿洞可是我们...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1411407108:1":{"key":"say:9:1411407108:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1411407108","action_index":"1","choice_index":"","choice_id":"","source_cn":"好，记得和你们队长说，要做好登记，有什么问题随时找我汇报！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:摔倒的矮人":{"key":"speaker:摔倒的矮人","source":"摔倒的矮人"},"speaker:祖娅":{"key":"speaker:祖娅","source":"祖娅"}},"stats":{"source_node_count":11,"graph_node_count":9,"effect_event_count":0,"text_entry_count":8,"speaker_entry_count":2,"cast_state_line_count":8,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}