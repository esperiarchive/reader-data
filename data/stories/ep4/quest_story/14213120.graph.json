ype":"__NC.Tasks.Actions.SayBase"}]}}},"text_entries":{"say:1:1421312001:1":{"key":"say:1:1421312001:1","kind":"say","source_node_id":"1","source_node_type":"__DT.ActionNode","statementID":"1421312001","action_index":"1","choice_index":"","choice_id":"","source_cn":"<style=stress><player_name>...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:2:1421312001":{"key":"choice_prompt:2:1421312001","kind":"choice_prompt","source_node_id":"2","source_node_type":"__DT.MultiChooseNode","statementID":"1421312001","action_index":"","choice_index":"","choice_id":"","source_cn":"<style=stress><player_name></style>，怎么了？我看你在这停留了好久了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1421312002:1":{"key":"say:3:1421312002:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1421312002","action_index":"1","choice_index":"","choice_id":"","source_cn":"啊，我知道这个，应该是这矿洞里专门出产的特殊矿脉。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1421312004:1":{"key":"say:4:1421312004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1421312004","action_index":"1","choice_index":"","choice_id":"","source_cn":"我感觉曾经见过类似的矿，在我小时候……那会儿印象还挺深的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1421312005:1":{"key":"say:5:1421312005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1421312005","action_index":"1","choice_index":"","choice_id":"","source_cn":"但矿石这种东西，说实话长得都差不多，很多看起来一模一样...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:6:1421312005":{"key":"choice_prompt:6:1421312005","kind":"choice_prompt","source_node_id":"6","source_node_type":"__DT.MultiChooseNode","statementID":"1421312005","action_index":"","choice_index":"","choice_id":"","source_cn":"但矿石这种东西，说实话长得都差不多，很多看起来一模一样的东西效果天差地别。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1421312006:1":{"key":"say:7:1421312006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1421312006","action_index":"1","choice_index":"","choice_id":"","source_cn":"真是，魔法师就是外行！告诉你，我的专业是机械研发，对材...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1421312007:1":{"key":"say:8:1421312007:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1421312007","action_index":"1","choice_index":"","choice_id":"","source_cn":"其余矿产什么的，包括这里剩余的矿石，只能说是靠我作为矮...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1421312008:1":{"key":"say:9:1421312008:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1421312008","action_index":"1","choice_index":"","choice_id":"","source_cn":"就像铁矿铜矿什么的，是个人走过去都能判断吧？对我没有专...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:10:1421312008":{"key":"choice_prompt:10:1421312008","kind":"choice_prompt","source_node_id":"10","source_node_type":"__DT.MultiChooseNode","statementID":"1421312008","action_index":"","choice_index":"","choice_id":"","source_cn":"就像铁矿铜矿什么的，是个人走过去都能判断吧？对我没有专精的矿产，我也就了解到这个程度。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1421312009:1":{"key":"say:11:1421312009:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1421312009","action_index":"1","choice_index":"","choice_id":"","source_cn":"你是魔法师嘛。唔，所以，这里的天青矿，得再找找在这边的...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1421312010:1":{"key":"say:12:1421312010:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1421312010","action_index":"1","choice_index":"","choice_id":"","source_cn":"我就不信，所有人都跟那个酒鬼一样哭天抢地的——等等。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1421312011