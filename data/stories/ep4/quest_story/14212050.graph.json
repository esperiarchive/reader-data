.prefab","resource_code":"children_darkelf_ep4interngirl","resource_stem":"pbsc_char_npc_children_darkelf_ep4interngirl"}],"position_events":[{"dialogue_position":"1","event_type":"AppearActor","source_node_id":"0","action_index":"1","json_path":"nodes[0]._action.actions[0]"},{"dialogue_position":"5","event_type":"AppearActor","source_node_id":"0","action_index":"2","json_path":"nodes[0]._action.actions[1]"}],"active_actor_ids":["1164"],"line_animation_set":"approve","line_json_path":"nodes[20]._action.actions[0]","line_action_type":"__NC.Tasks.Actions.SayBase"}]}},"end:21":{"id":"end:21","type":"end","source_node_id":"21"}},"text_entries":{"say:1:1421205001:1":{"key":"say:1:1421205001:1","kind":"say","source_node_id":"1","source_node_type":"__DT.ActionNode","statementID":"1421205001","action_index":"1","choice_index":"","choice_id":"","source_cn":"太好了！斐利尔大人的笔记……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1421205002:1":{"key":"say:2:1421205002:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1421205002","action_index":"1","choice_index":"","choice_id":"","source_cn":"多谢你，<style=stress><player_n...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1421205003:0":{"key":"say:3:1421205003:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1421205003","action_index":"0","choice_index":"","choice_id":"","source_cn":"我们打开看看吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"document:4:173:0":{"key":"document:4:173:0","kind":"document","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"今天又找到了一份珍贵的手札！\n我们旧日生活的薄暮丛林真是太美了……\n手札里记载了那里会有永不凋零的花朵，而阳光穿过树叶时会洒下斑驳的光影。\n一想到这么美的故乡被恶魔毁了，我的心就好痛！\n薄暮丛林明明是那么美好的地方……\n所以，我决定了——\n既然不能重返故乡，我就试试在这里复现一小片薄暮丛林的景象吧！\n<align=\"right\">——斐利尔</align>","textdes_id":"173","document_page_count":"1","document_title_cn":"斐利尔的研究笔记·第一页","document_order":"1","document_object_id":"508800046","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_littleflamen_notebook.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item18.prefab","document_pic":"","document_gender":"false"},"say:5:1421205004:0":{"key":"say:5:1421205004:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1421205004","action_index":"0","choice_index":"","choice_id":"","source_cn":"这是……斐利尔大人在研究旧手札。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1421205005:1":{"key":"say:6:1421205005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1421205005","action_index":"1","choice_index":"","choice_id":"","source_cn":"看样子他找到了薄暮丛林的相关资料，并且心怀向往。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:7:1421205005":{"key":"choice_prompt:7:1421205005","kind":"choice_prompt","source_node_id":"7","source_node_type":"__DT.MultiChooseNode","statementID":"1421205005","action_index":"","choice_index":"","choice_id":"","source_cn":"看样子他找到了薄暮丛林的相关资料，并且心怀向往。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1421205006:1":{"key":"say:8:1421205006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1421205006","action_index":"1","choice_index":"","choice_id":"","source_cn":"我不确定，后面好像还有内容，我们接着看吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"document:9:174:0":{"key":"document:9:174:0","kind":"document","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"今天设计好了实验林地的草图。\n注意事项是得用魔法控制好湿度和温度，\n还要调配特殊的营养液……\n之后再实际考察一下具体的位置吧！\n希望找个暂时不被大家发现的地方！\n啊！搞这个的时间太久了，差点耽误了明天的仪式！\n得赶紧去准备仪式用品了。\n但愿能早日完成这个小实验……\n让大家一起重新体味地表的美好！\n<align=\"right\">——斐利尔</align>","textdes_id":"174","document_page_count":"1","document_title_cn":"斐利尔的研究笔记·第二页","document_order":"1","document_object_id":"508800047","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_littleflamen_notebook.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item18.prefab","document_pic":"","document_gender":"false"},"say:10:1421205007:1":{"key":"say:10:1421205007:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1421205007","action_index":"1","choice_index":"","choice_id":"","source_cn":"怪不得……斐利尔大人经常不见人影。原来，他是去林地做实验了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1421205008:1":{"key":"say:11:1421205008:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1421205008","action_index":"1","choice_index":"","choice_id":"","source_cn":"……我总算明白当时斐利尔为什么跟着你们去地表了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1421205009:1":{"key":"say:12:1421205009:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1421205009","action_index":"1","choice_index":"","choice_id":"","source_cn":"他应该一直都很向往地表，所以才会设计实验林地，为了复刻...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:13:1421205009":{"key":"choice_prompt:13:1421205009","kind":"choice_prompt","source_node_id":"13","source_node_type":"__DT.MultiChooseNode","statementID":"1421205009","action_index":"","choice_index":"","choice_id":"","source_cn":"他应该一直都很向往地表，所以才会设计实验林地，为了复刻想象中的美好。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1421205010:1":{"key":"say:14:1421205010:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1421205010","action_index":"1","choice_index":"","choice_id":"","source_cn":"我不知道，他也没有跟我提过。我们接着看下去吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"document:15:175:0":{"key":"document:15:175:0","kind":"document","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"找到合适的地方了！\n就在<style=\"highlight\">银月祭庭的西北角</style>，那里几乎没有人去……\n平民们进不了祭庭，祭司们也不会去偏僻的那里。\n我仔细观察过了，周围的魔法能量很稳定……\n地面的土壤也很适合培育植物，那里的光线和手札中描述的月色很像！\n今天偷偷搬了一些培育工具过去，希望不会被巡逻的卫兵发现。\n<align=\"right\">——斐利尔</align>","textdes_id":"175","document_page_count":"1","document_title_cn":"斐利尔的研究笔记·第三页","document_order":"1","document_object_id":"508800048","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_littleflamen_notebook.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item18.prefab","document_pic":"","document_gender":"false"},"say:16:1421205011:1":{"key":"say:16:1421205011:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1421205011","action_index":"1","choice_index":"","choice_id":"","source_cn":"斐利尔大人，好、好厉害！我印象中，祭司大人们基本不会去那里。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1421205012:1":{"key":"say:17:1421205012:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1421205012","action_index":"1","choice_index":"","choice_id":"","source_cn":"嗯，确实是个隐蔽的地方。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1421205013:1":{"key":"say:18:1421205013:1","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1421205013","action_index":"1","choice_index":"","choice_id":"","source_cn":"一般而言，卫兵们也不会去银月祭庭的西北角巡逻。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:19:1421205014:1":{"key":"say:19:1421205014:1","kind":"say","source_node_id":"19","source_node_type":"__DT.ActionNode","statementID":"1421205014","action_index":"1","choice_index":"","choice_id":"","source_cn":"我撞见过几次斐利尔大人独自前往，我还以为他……是去进行仪式。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:20:1421205015:1":{"key":"say:20:1421205015:1","kind":"say","source_node_id":"20","source_node_type":"__DT.ActionNode","statementID":"1421205015","action_index":"1","choice_index":"","choice_id":"","source_cn":"我们去看看吧，也许……他的实验还留在那里。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:13:0:1":{"key":"choice:13:0:1","kind":"choice","source_node_id":"13","source_node_type":"__DT.MultiChooseNode","statementID":"1421205002","action_index":"","choice_index":"0","choice_id":"1","source_cn":"这片林地还在吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:7:0:1":{"key":"choice:7:0:1","kind":"choice","source_node_id":"7","source_node_type":"__DT.MultiChooseNode","statementID":"1421205001","action_index":"","choice_index":"0","choice_id":"1","source_cn":"这就是他的愿望吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:丽芙":{"key":"speaker:丽芙","source":"丽芙"},"speaker:因度厄":{"key":"speaker:因度厄","source":"因度厄"}},"stats":{"source_node_count":22,"graph_node_count":21,"effect_event_count":0,"text_entry_count":22,"speaker_entry_count":2,"cast_state_line_count":15,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}