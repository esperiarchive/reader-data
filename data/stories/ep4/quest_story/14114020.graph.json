Node","statementID":"1411402001","action_index":"1","choice_index":"","choice_id":"","source_cn":"唔，真有点紧张了，还好你们来得及时。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1411402002:2":{"key":"say:2:1411402002:2","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1411402002","action_index":"2","choice_index":"","choice_id":"","source_cn":"怎么了，祖娅？你之前不是接待过伊芙吗？怎么看起来这么紧张？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1411402003:1":{"key":"say:3:1411402003:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1411402003","action_index":"1","choice_index":"","choice_id":"","source_cn":"对了，还没问你，伊芙那边最后对深岩村定下哪种方案了？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1411402004:1":{"key":"say:4:1411402004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1411402004","action_index":"1","choice_index":"","choice_id":"","source_cn":"给的方案还是挺宽松的，我和海拉主要负责武器和材料方面的...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1411402005:1":{"key":"say:5:1411402005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1411402005","action_index":"1","choice_index":"","choice_id":"",