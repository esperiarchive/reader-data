nt_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1410458103:0":{"key":"say:4:1410458103:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1410458103","action_index":"0","choice_index":"","choice_id":"","source_cn":"一群平民突然冲向台座，与我们发生了冲突，随后更多的平民...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1410458104:0":{"key":"say:5:1410458104:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1410458104","action_index":"0","choice_index":"","choice_id":"","source_cn":"更令人震怒的是，那些身负惩罚印记的罪人也参与其中。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1410458105:0":{"key":"say:6:1410458105:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1410458105","action_index":"0","choice_index":"","choice_id":"","source_cn":"其他守卫正在追捕这些亵渎恩典之人，我奉命前来紧急通报此事。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1410458106:0":{"key":"say:7:1410458106:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1410458106","action_index":"0","choice_index":"","choice_id":"","source_cn":"……我了解了，你快去汇报给沙利叶殿下。殿下应该在紫藤会...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1410458107:0":{"key":"say:8:1410458107:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1410458107","action_index":"0","choice_index":"","choice_id":"","source_cn":"我跟梅林先赶去平民区处理此事。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1410458108:1":{"key":"say:9:1410458108:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1410458108","action_index":"1","choice_index":"","choice_id":"","source_cn":"遵命，属下告退！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1410458109:1":{"key":"say:10:1410458109:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1410458109","action_index":"1","choice_index":"","choice_id":"","source_cn":"太奇怪了，怎么会突然发生这种事？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:11:1410458109":{"key":"choice_prompt:11:1410458109","kind":"choice_prompt","source_node_id":"11","source_node_type":"__DT.MultiChooseNode","statementID":"1410458109","action_index":"","choice_index":"","choice_id":"","source_cn":"太奇怪了，怎么会突然发生这种事？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1410458110:1":{"key":"say:12:1410458110