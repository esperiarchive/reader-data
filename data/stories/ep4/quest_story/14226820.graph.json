document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1422682004:1":{"key":"say:4:1422682004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1422682004","action_index":"1","choice_index":"","choice_id":"","source_cn":"我、我不知道啊！我也是想着这里肯定安全，才出来弄吃的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1422682005:1":{"key":"say:5:1422682005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1422682005","action_index":"1","choice_index":"","choice_id":"","source_cn":"沙利叶不至于在这种事上玩忽职守，恐怕是防守的人手不够……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1422682006:1":{"key":"say:6:1422682006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1422682006","action_index":"1","choice_index":"","choice_id":"","source_cn":"……也可能是孽化的情况更严重了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1422682007:1":{"key":"say:7:1422682007:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1422682007","action_index":"1","choice_index":"","choice_id":"","source_cn":"你回去找沙利叶，把遇袭和见到我的事情跟他说清楚。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1422682008:1":{"key":"say:8:1422682008:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1422682008","action_index":"1","choice_index":"","choice_id":"","source_cn":"好、好的。因度厄大人，我先过去！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1422682009:1":{"key":"say:11:1422682009:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1422682009","action_index":"1","choice_index":"","choice_id":"","source_cn":"因度厄，刚刚我们面对的那个怪物，就是你们提到的孽化的…...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1422682010:1":{"key":"say:12:1422682010:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1422682010","action_index":"1","choice_index":"","choice_id":"","source_cn":"是的，一开始长出鳞片，接着肢体扭曲，最终连理智都烧尽了……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1422682011:1":{"key":"say:13:1422682011:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1422682011","action_index":"1","choice_index":"","choice_id":"","source_cn":"彻底沦为怪物。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1422682012:1":{"key":"say:14:1422682012:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1422682012","action_index":"1","choice_index":"","choice_id":"","source_cn":"这简直……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1422682013:1":{"key":"say:15:1422682013:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1422682013","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以，比起被塔兰河冲刷的痛苦来说，孽化才是真正的折磨。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1422682014:1":{"key":"say:16:1422682014:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1422682014","action_index":"1","choice_index":"","choice_id":"","source_cn":"孽化，除了诅咒外，也可以说是龙对我们的窃取与贪婪的惩戒吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1422682015:1":{"key":"say:17:1422682015:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1422682015","action_index":"1","choice_index":"","choice_id":"","source_cn":"龙的惩戒，弥萨忒的惩戒……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1422682016:1":{"key":"say:18:1422682016:1","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1422682016","action_index":"1","choice_index":"","choice_id":"","source_cn":"我们艾塞勒最终在两种惩戒交织下沉沦。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:19:1422682017:1":{"key":"say:19:1422682017:1","kind":"say","source_node_id":"19","source_node_type":"__DT.ActionNode","statementID":"1422682017","action_index":"1","choice_index":"","choice_id":"","source_cn":"……所以，我必须要加快脚步，否则，不知道还有多少人会继...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:20:1422682018:1":{"key":"say:20:1422682018:1","kind":"say","source_node_id":"20","source_node_type":"__DT.ActionNode","statementID":"1422682018","action_index":"1","choice_index":"","choice_id":"","source_cn":"……我明白了。我们去找纯净的土元素吧。时间不等人。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:遇袭的平民":{"key":"speaker:遇袭的平民","source":"遇袭的平民"},"speaker:因度厄":{"key":"speaker:因度厄","source":"因度厄"},"speaker:埃隆":{"key":"speaker:埃隆","source":"埃隆"}},"stats":{"source_node_count":22,"graph_node_count":19,"effect_event_count":0,"text_entry_count":18,"speaker_entry_count":3,"cast_state_line_count":18,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}