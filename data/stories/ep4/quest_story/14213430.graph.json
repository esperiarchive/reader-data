rce_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1421343002","action_index":"1","choice_index":"","choice_id":"","source_cn":"本来是想事先在这里与你们联络一下，没想到这里居然有别人在。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1421343003:1":{"key":"say:5:1421343003:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1421343003","action_index":"1","choice_index":"","choice_id":"","source_cn":"说什么重建帝国之类的……我刚一露面她就突然对我攻击。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1421343004:1":{"key":"say:6:1421343004:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1421343004","action_index":"1","choice_index":"","choice_id":"","source_cn":"真是多亏你了，因度厄，幸好你把她制服了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1421343005:1":{"key":"say:7:1421343005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1421343005","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以，小丫头，你就是伊娜？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1421343006:1":{"key":"say:8:1421343006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1421343006","action_index":"1","choice_index":"","choice_id":"","source_cn":"哈！你们捆住我的手脚，但捆不住矮人智慧的光芒！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1421343007:1":{"key":"say:9:1421343007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1421343007","action_index":"1","choice_index":"","choice_id":"","source_cn":"这里所有的机关我都已经改造过了！我刚刚已经按下了开关！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1421343008:1":{"key":"say:10:1421343008:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1421343008","action_index":"1","choice_index":"","choice_id":"","source_cn":"只要我不亲手操作，这里立刻就会爆炸！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1421343009:1":{"key":"say:13:1421343009:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1421343009","action_index":"1","choice_index":"","choice_id":"","source_cn":"伊娜！你、你怎么……怎么办，这怎么办？！伊娜绝对不会吹...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1421343010:1":{"key":"say:14:1421343010:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1421343010","action_index":"1","choice_index":"","choice_id":"","source_cn":"我们同归于尽吧，为了尊严与骄傲——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1421343011:1":{"key":"say:15:1421343011:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1421343011","action_index":"1","choice_index":"","choice_id":"","source_cn":"哈，可笑，在我的地盘，用我的材料，改造我的机关，炸我的人？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:因度厄":{"key":"speaker:因度厄","source":"因度厄"},"speaker:祖娅":{"key":"speaker:祖娅","source":"祖娅"},"speaker:伊娜":{"key":"speaker:伊娜","source":"伊娜"},"speaker:海拉":{"key":"speaker:海拉","source":"海拉"}},"stats":{"source_node_count":17,"graph_node_count":12,"effect_event_count":0,"text_entry_count":11,"speaker_entry_count":4,"cast_state_line_count":11,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}