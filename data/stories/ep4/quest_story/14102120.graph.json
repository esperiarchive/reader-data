410212003","action_index":"1","choice_index":"","choice_id":"","source_cn":"咦？！不应该啊，矿洞的人怎么会……啊，我知道了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1410212004:1":{"key":"say:5:1410212004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1410212004","action_index":"1","choice_index":"","choice_id":"","source_cn":"这真是，今天安排欢迎仪式的时候把老灰给叫过去了，估计是...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1410212005:1":{"key":"say:6:1410212005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1410212005","action_index":"1","choice_index":"","choice_id":"","source_cn":"不管哪边的岔子，现在的东西可不能耽搁了，弗林！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1410212006:1":{"key":"say:8:1410212006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1410212006","action_index":"1","choice_index":"","choice_id":"","source_cn":"说到干活一点也不客气了，这才是我们熟悉的矮人嘛。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1410212007:1":{"key":"say:10:1410212007:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1410212007","action_index":"1","choice_index":"","choice_id":"","source_cn":"弗林村长，既然事情是因我们而起，不如我们也搭把手？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1410212008:1":{"key":"say:11:1410212008:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1410212008","action_index":"1","choice_index":"","choice_id":"","source_cn":"正好，我也想见识见识贵地的冶炼工艺。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1410212009:1":{"key":"say:12:1410212009:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1410212009","action_index":"1","choice_index":"","choice_id":"","source_cn":"不行不行……哪能让耀光特使来干这些脏活儿累活儿？多不好...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1410212010:1":{"key":"say:14:1410212010:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1410212010","action_index":"1","choice_index":"","choice_id":"","source_cn":"弗林！别客套了！冶炼所那边又又又又在催！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1410212011:1":{"key":"say:15:1410212011:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1410212011","action_index":"1","choice_index":"","choice_id":"","source_cn":"呃……我立刻安排更多人手！一定不能让尊贵的客人参与生产——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1410212012:1":{"key":"say:17:1410212012:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1410212012","action_index":"1","choice_index":"","choice_id":"","source_cn":"弗林村长，别客气。就让我们来吧，就当是参观环节的一部分了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1410212013:1":{"key":"say:18:1410212013:1","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1410212013","action_index":"1","choice_index":"","choice_id":"","source_cn":"这……一切听特使您的！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:工匠铁须":{"key":"speaker:工匠铁须","source":"工匠铁须"},"speaker:弗林":{"key":"speaker:弗林","source":"弗林"},"speaker:漫漫":{"key":"speaker:漫漫","source":"漫漫"},"speaker:霍根":{"key":"speaker:霍根","source":"霍根"}},"stats":{"source_node_count":20,"graph_node_count":14,"effect_event_count":0,"text_entry_count":13,"speaker_entry_count":4,"cast_state_line_count":13,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0}}