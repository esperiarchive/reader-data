"line_json_path":"nodes[18]._action.actions[0]","line_action_type":"__NC.Tasks.Actions.SayBase"}]}}},"text_entries":{"say:2:1410524001:1":{"key":"say:2:1410524001:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1410524001","action_index":"1","choice_index":"","choice_id":"","source_cn":"祭司小子，我们待会要直接离开了，你记得原路返回。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1410524002:1":{"key":"say:3:1410524002:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1410524002","action_index":"1","choice_index":"","choice_id":"","source_cn":"咦！你们要回去了？呃，我是说，你们就直接把我放走了？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:4:1410524002":{"key":"choice_prompt:4:1410524002","kind":"choice_prompt","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1410524002","action_index":"","choice_index":"","choice_id":"","source_cn":"咦！你们要回去了？呃，我是说，你们就直接把我放走了？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1410524003:1":{"key":"say:5:1410524003:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1410524003","action_index":"1","choice_index":"","choice_id":"","source_cn":"你们可是邪恶的潜入者，我怎么可能和你们同行……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1410524005:1":{"key":"say:6:1410524005:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1410524005","action_index":"1","choice_index":"","choice_id":"","source_cn":"那就好，你快点回去吧，毕竟你们艾塞勒似乎是无法踏足地表的。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1410524006:1":{"key":"say:7:1410524006:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1410524006","action_index":"1","choice_index":"","choice_id":"","source_cn":"哼，毕竟地表上毫无可取之处，我们深居的地底才是真正的乐...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:8:1410524006":{"key":"choice_prompt:8:1410524006","kind":"choice_prompt","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1410524006","action_index":"","choice_index":"","choice_id":"","source_cn":"哼，毕竟地表上毫无可取之处，我们深居的地底才是真正的乐园……！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1410524007:1":{"key":"say:9:1410524007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1410524007","action_index":"1","choice_index":"","choice_id":"","source_cn":"唔……女王所说的就是事实。女王恩泽萨洛克兰，没理由骗我们！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1410524009:1":{"key":"say:10:1410524009:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1410524009","action_index":"1","choice_index":"","choice_id":"","source_cn":"你还真是个小孩子啊，天真！这世界的残酷真相之一就是其他...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1410524010:1":{"key":"say:11:1410524010:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1410524010","action_index":"1","choice_index":"","choice_id":"","source_cn":"你！不许你这么说！既然如此，我反倒要跟着你们了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1410524011:1":{"key":"say:12:1410524011:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1410524011","action_index":"1","choice_index":"","choice_id":"","source_cn":"走吧！我要看看，你们说的地表到底是怎样的情况！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1410524012:1":{"key":"say:13:1410524012:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1410524012","action_index":"1","choice_index":"","choice_id":"","source_cn":"这是你自己说的哦！待会看到真相后可不要哇哇大哭。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1410524013:1":{"key":"say:14:1410524013:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1410524013","action_index":"1","choice_index":"","choice_id":"","source_cn":"走吧，那边有个矿车。看着像是能正常使用的样子！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1410524014:1":{"key":"say:15:1410524014:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1410524014","action_index":"1","choice_index":"","choice_id":"","source_cn":"别担心，就算坏掉，我也能很快修好！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:8:0:1":{"key":"choice:8:0:1","kind":"choice","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1410524002","action_index":"","choice_index":"0","choice_id":"1","source_cn":"你亲眼见过地表吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1410524008:1":{"key":"say:17:1410524008:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1410524008","action_index":"1","choice_index":"","choice_id":"","source_cn":"女王的教诲绝不可能出错！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:8:1:2":{"key":"choice:8:1:2","kind":"choice","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1410524002","action_index":"","choice_index":"