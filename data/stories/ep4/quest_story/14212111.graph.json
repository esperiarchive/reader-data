se"},"say:2:1421211101:1":{"key":"say:2:1421211101:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1421211101","action_index":"1","choice_index":"","choice_id":"","source_cn":"这里……最下面，斐利尔大人写了针对枯枯藤门消融药剂的配方。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:3:1421211101":{"key":"choice_prompt:3:1421211101","kind":"choice_prompt","source_node_id":"3","source_node_type":"__DT.MultiChooseNode","statementID":"1421211101","action_index":"","choice_index":"","choice_id":"","source_cn":"这里……最下面，斐利尔大人写了针对枯枯藤门消融药剂的配方。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1421211102:1":{"key":"say:4:1421211102:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1421211102","action_index":"1","choice_index":"","choice_id":"","source_cn":"不好意思……我、我有点激动了。我只是……也很喜欢植物呢。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1421211103:1":{"key":"say:5:1421211103:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1421211103","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以，斐利尔大人写的这些东西，我知道在哪里能找到。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1421211104:0":{"key":"say:6:1421211104:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1421211104","action_index":"0","choice_index":"","choice_id":"","source_cn":"祭庭旁就有月光兰，随时可以去采集露水。盛放的蚀芯花的话...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1421211105:1":{"key":"say:7:1421211105:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1421211105","action_index":"1","choice_index":"","choice_id":"","source_cn":"丽芙，你对这些东西很熟悉，你带我们去吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1421211106:1":{"key":"say:8:1421211106:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1421211106","action_index":"1","choice_index":"","choice_id":"","source_cn":"嗯！那、那两位大人，请跟我来吧。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:3:0:1":{"key":"choice:3:0:1","kind":"choice","source_node_id":"3","source_node_type":"__DT.MultiChooseNode","statementID":"1421211101","action_index":"","choice_index":"0","choice_id":"1","source_cn":"……这么快就给门起了名字","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:丽芙":{"key":"speaker:丽芙","source":"丽芙"},"speaker:因度厄":{"key":"speaker:因度厄","source":"因度厄"}},"stats":{"source_node_count":10,"gr