":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:5:1521919005:0":{"key":"narration:5:1521919005:0","kind":"narration","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1521919005","action_index":"0","choice_index":"","choice_id":"","source_cn":"南茜讲述起她的回忆……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1521919006:1":{"key":"say:8:1521919006:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1521919006","action_index":"1","choice_index":"","choice_id":"","source_cn":"南茜！今天感觉怎么样，身体有没有什么不舒服的地方？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1521919007:1":{"key":"say:9:1521919007:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1521919007","action_index":"1","choice_index":"","choice_id":"","source_cn":"你真是个操心的爸爸……我每天就在广场上晒晒太阳，能有什...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1521919008:1":{"key":"say:10:1521919008:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1521919008","action_index":"1","choice_index":"","choice_id":"","source_cn":"瞧瞧你，脸上都是汗……麦子都割完了吧，累不累？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","documen