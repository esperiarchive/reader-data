11002","action_index":"0","choice_index":"","choice_id":"","source_cn":"你这是什么态度？呼临城有丰饶神庇护，不需要魔法师协会的拯救！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:4:1522111002":{"key":"choice_prompt:4:1522111002","kind":"choice_prompt","source_node_id":"4","source_node_type":"__DT.MultiChooseNode","statementID":"1522111002","action_index":"","choice_index":"","choice_id":"","source_cn":"你这是什么态度？呼临城有丰饶神庇护，不需要魔法师协会的拯救！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1522111004:1":{"key":"say:5:1522111004:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1522111004","action_index":"1","choice_index":"","choice_id":"","source_cn":"她一直试图干涉呼临城的内政！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1522111005:0":{"key":"say:6:1522111005:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1522111005","action_index":"0","choice_index":"","choice_id":"","source_cn":"从我们向兽人宣战开始，她就三番五次地来到呼临城，请求觐...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1522111006:0":{"key":"say:7:1522111006:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1522111006","action_index":"0","choice_index":"","choice_id":"","source_cn":"阿邦德不肯见她，她就敢直接找上珀尔修斯和我！真是不知天...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1522111007:0":{"key":"say:8:1522111007:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1522111007","action_index":"0","choice_index":"","choice_id":"","source_cn":"如果她不改变她的态度，就算她再字字珠玑，再直点要害，呼...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:9:1522111007":{"key":"choice_prompt:9:1522111007","kind":"choice_prompt","source_node_id":"9","source_node_type":"__DT.MultiChooseNode","statementID":"1522111007","action_index":"","choice_index":"","choice_id":"","source_cn":"如果她不改变她的态度，就算她再字字珠玑，再直点要害，呼临城也不会听从她的劝诫。她那点嘴皮功夫，不如去劝兽人与我们和谈，或许还唬得住！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1522111008:0":{"key":"say:10:1522111008:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1522111008","action_index":"0","choice_index":"","choice_id":"","source_cn":"那又如何？置之死地而后生！就是因为呼临城被天灾逼上了绝...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1522111009:0":{"key":"say:11:1522111009:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1522111009","action_index":"0","choice_index":"","choic