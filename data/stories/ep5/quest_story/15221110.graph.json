"","source_cn":"别再打听了。事关呼临城内政，我不可能告诉你那么多。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1522111014:1":{"key":"say:16:1522111014:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1522111014","action_index":"1","choice_index":"","choice_id":"","source_cn":"你们只要知道，和平和战争都不易，这就足够了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:13:0:1":{"key":"choice:13:0:1","kind":"choice","source_node_id":"13","source_node_type":"__DT.MultiChooseNode","statementID":"1522111004","action_index":"","choice_index":"0","choice_id":"1","source_cn":"你们的领主也不能吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1522111012:0":{"key":"say:18:1522111012:0","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1522111012","action_index":"0","choice_index":"","choice_id":"","source_cn":"声望和民心有时是同一个东西，有时又不是。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:13:1:2":{"key":"choice:13:1:2","kind":"choice","source_node_id":"13","source_node_type":"__DT.MultiChooseNode","statementID":"1522111004","action_index":"","choice_index":"1","choice_id":"2","source_cn":"珀尔修斯不是很有声望吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_o