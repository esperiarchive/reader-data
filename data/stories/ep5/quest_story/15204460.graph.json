"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1520446003:0":{"key":"say:4:1520446003:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1520446003","action_index":"0","choice_index":"","choice_id":"","source_cn":"没关系……已经足够了。魔法师大人，谢谢你们！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1520446004:0":{"key":"say:5:1520446004:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1520446004","action_index":"0","choice_index":"","choice_id":"","source_cn":"我也已经想好了，我还是回营地，继续照顾大家。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1520446005:0":{"key":"say:6:1520446005:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1520446005","action_index":"0","choice_index":"","choice_id":"","source_cn":"还有……关于真相……希望你们可以继续帮我一起保密，暂时...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1520446006:0":{"key":"say:7:1520446006:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1520446006","action_index":"0","choice_index":"","choice_id":"","source_cn":"当然，我们也认为这样处理比较好。另外，我们刚刚商量了一下……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_