ocument_base_image":"","document_pic":"","document_gender":""},"say:8:1510416005:1":{"key":"say:8:1510416005:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1510416005","action_index":"1","choice_index":"","choice_id":"","source_cn":"闭嘴，野兽！我没和你说话！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1510416006:0":{"key":"say:11:1510416006:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1510416006","action_index":"0","choice_index":"","choice_id":"","source_cn":"怎么回事，珀尔修斯，你又开始相信兽人了？他们就是一群没...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1510416007:0":{"key":"say:12:1510416007:0","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1510416007","action_index":"0","choice_index":"","choice_id":"","source_cn":"够了！这些魔法师救治过水泽营地的兄弟，别质疑我的决定。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1510416008:0":{"key":"say:13:1510416008:0","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1510416008","action_index":"0","choice_index":"","choice_id":"","source_cn":"魔法师们，我去通报<style=highlight>阿...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:15104160