:[{"index":1,"actors":[{"dialogue_position":"1","actor_id":"1553","character_name":"Man","appearance_clip_slots":["1"],"appearance_source_node_id":"23","appearance_action_index":"1","appearance_json_path":"nodes[23]._action.actions[0]","animation_set":"happy","animation_source_node_id":"24","animation_action_index":"1","animation_json_path":"nodes[24]._action.actions[0]","res_name":"Man","resource_path":"Character/NpcPart/pbsc_char_npc_man_lightbearers_ep5candy.prefab","resource_code":"man_lightbearers_ep5candy","resource_stem":"pbsc_char_npc_man_lightbearers_ep5candy"},{"dialogue_position":"5","actor_id":"1440","character_name":"Gala","appearance_clip_slots":["2"],"appearance_source_node_id":"23","appearance_action_index":"2","appearance_json_path":"nodes[23]._action.actions[1]","animation_set":"normal","animation_source_node_id":"25","animation_action_index":"1","animation_json_path":"nodes[25]._action.actions[0]","res_name":"Gala","resource_path":"character/npc/pbsc_char_npc_gala.prefab","resource_code":"gala","resource_stem":"pbsc_char_npc_gala"}],"position_events":[{"dialogue_position":"1","event_type":"AppearActor","source_node_id":"23","action_index":"1","json_path":"nodes[23]._action.actions[0]"},{"dialogue_position":"5","event_type":"AppearActor","source_node_id":"23","action_index":"2","json_path":"nodes[23]._action.actions[1]"}],"active_actor_ids":["1440"],"line_animation_set":"normal","line_json_path":"nodes[25]._action.actions[0]","line_action_type":"__NC.Tasks.Actions.SayBase"}]}},"end:26":{"id":"end:26","type":"end","source_node_id":"26"}},"text_entries":{"document:0:231:0":{"key":"document:0:231:0","kind":"document","source_node_id":"0","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"奎莉，那场战争已经过去了三十天……只有一场朴素的葬礼。一切都那么草率。\n奇迹真的不会发生了吗？明明你是为呼临城而战……你<style=\"highlight\">受丰饶神的庇护</style>啊！\n伟大的神，他会不会<style=\"highlight\">再一次救你</style>？就像你误入水淀枯林时那样，在你饥肠辘辘时，将果腹的<style=\"highlight\">弥纹花伞</style>送到你眼前？\n你告诉我，你在幻梦中看见了我和你妈妈。当你醒来时，美梦成真，我们真的到了你眼前。\n其他人都说，那是因为弥纹花伞致幻。可你我都知道，那是真正的神迹……是丰饶神指引我们找到你的！\n<style=\"highlight\">那只为我引路的野猪</style>，它那样强壮……必定是<style=\"highlight\">丰饶神的眷属</style>！\n奎莉，我想你已经回到了他的怀抱，我不会妄图从神手中抢走你。我只求神应允我唯一的祈愿：\n<style=\"highlight\">让我在梦里，再见你一面……</style>","textdes_id":"231","document_page_count":"1","document_title_cn":"致奎莉","document_order":"1","document_object_id":"0","document_item_id":"0","document_icon":"UI/Icon/Item/spui_icon_item_daifula_fomula.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item14.prefab","document_pic":"","document_gender":"false"},"say:2:1520638001:1":{"key":"say:2:1520638001:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1520638001","action_index":"1","choice_index":"","choice_id":"","source_cn":"野猪是丰饶神的眷属？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1520638002:0":{"key":"say:3:1520638002:0","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1520638002","action_index":"0","choice_index":"","choice_id":"","source_cn":"没错。在有关丰饶神的记载中，<style=highli...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1520638003:0":{"key":"say:4:1520638003:0","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1520638003","action_index":"0","choice_index":"","choice_id":"","source_cn":"传说，丰饶神在赐予我们天上的甘露、地上的沃土后，就让这...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1520638004:0":{"key":"say:5:1520638004:0","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1520638004","action_index":"0","choice_index":"","choice_id":"","source_cn":"正因他如此仁慈，始终庇护着我们，我们才这么信仰他。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1520638005:1":{"key":"say:7:1520638005:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1520638005","action_index":"1","choice_index":"","choice_id":"","source_cn":"你和加拉对视了一眼。很显然，你们都不想在一个呼临人面前...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1520638006:1":{"key":"say:9:1520638006:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1520638006","action_index":"1","choice_index":"","choice_id":"","source_cn":"下面还有一封信。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"document:10:232:0":{"key":"document:10:232:0","kind":"document","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"果然，奎莉，那果然是丰饶神赐下的神迹！<style=\"highlight\">这种蘑菇居然可以制糖</style>！\n还记得爸爸给你做的糖吗？你最喜欢吃了！你总说糖果甜甜的，吃一颗就能忘记烦恼。\n奎莉，糖果的妙处不仅在味道……还应该包括它带来的，真正的幸福……\n<style=\"highlight\">能让人在美梦中幸福的糖果，才是真正的甜蜜！</style>\n只要吃下它，那些饥荒中挨饿的、失去亲人的、孤苦无依的孩子们，就会幸福，就能撑到饥荒结束那天了……\n神啊，您还是降下了仁慈与怜悯！孩子们啊，称颂他的名吧！\n（后面的字迹愈发扭曲，你已经无法辨认了……）","textdes_id":"232","document_page_count":"1","document_title_cn":"奎莉，生活是甜蜜的！","document_order":"1","document_object_id":"0","document_item_id":"0","document_icon":"UI/Icon/Item/spui_icon_item_daifula_fomula.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item14.prefab","document_pic":"","document_gender":"false"},"say:11:1520638007:1":{"key":"say:11:1520638007:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1520638007","action_index":"1","choice_index":"","choice_id":"","source_cn":"等等……用蘑菇制糖？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1520638008:1":{"key":"say:12:1520638008:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1520638008","action_index":"1","choice_index":"","choice_id":"","source_cn":"马修用会致幻的弥纹花伞制糖？！还把这种糖……分给孩子们吃？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:13:1520638008":{"key":"choice_prompt:13:1520638008","kind":"choice_prompt","source_node_id":"13","source_node_type":"__DT.MultiChooseNode","statementID":"1520638008","action_index":"","choice_index":"","choice_id":"","source_cn":"马修用会致幻的弥纹花伞制糖？！还把这种糖……分给孩子们吃？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1520638009:0":{"key":"say:14:1520638009:0","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1520638009","action_index":"0",