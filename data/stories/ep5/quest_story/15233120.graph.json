t_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:2:1523312002:1":{"key":"say:2:1523312002:1","kind":"say","source_node_id":"2","source_node_type":"__DT.ActionNode","statementID":"1523312002","action_index":"1","choice_index":"","choice_id":"","source_cn":"旁边这份卷轴是……派翁的研究笔记？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"document:3:366:0":{"key":"document:3:366:0","kind":"document","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"丰饶神神降一月前，小麦生长完全停滞。神降期间，小麦持续出现小范围枯萎。初步推断，随着神堕加深，小麦所受负面影响也将逐步深化。必须尽快寻找其他可食用作物。\n……\n神降期间，和其他作物相比，<style=\"highlight\">苦苞穗</style>受影响较小。\n初步推测原因：丰饶神执掌农耕，对野生植物的影响远小于农作物。\n推论：如果丰饶神彻底神堕，呼临境内小麦大量枯萎，改良的野生作物受影响或许较小，能够帮助失去粮食的人类存活。\n改良方向：可尝试人工选育，保留具有类农作物优良性状的个体持续选育。选育方向：产量多、籽粒饱满、耐旱、抗虫害、谷穗口感好、生长周期短等……\n……\n改良进度：生长周期、产量选育已完成。\n下一步选育方向……","textdes_id":"366","document_page_count":"1","document_title_cn":"","document_order":"1","document_object_id":"1004786","document_item_id":"0","document_icon":"UI/Icon/Item/item_quest_mapstory_item3_21.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item3_21.prefab","document_pic":"","document_gender":"false"},"say:4:1523312003:1":{"key":"say:4:1523312003:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1523312003","action_index":"1","choice_index":"","choice_id":"","source_cn":"笔记到这里就结束了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":""