_id":"","source_cn":"当首领，不是一件好差事。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1541106007:0":{"key":"say:9:1541106007:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1541106007","action_index":"0","choice_index":"","choice_id":"","source_cn":"优秀的战士该去追逐猎物，不该被困在主树厅里，整天和枯燥...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1541106008:0":{"key":"say:10:1541106008:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1541106008","action_index":"0","choice_index":"","choice_id":"","source_cn":"只有巫祭，还有因为体弱，不能成为战士的人，才会学习文字。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1541106009:1":{"key":"say:11:1541106009:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1541106009","action_index":"1","choice_index":"","choice_id":"","source_cn":"但是，为了先祖的话语得到传承，前首领的后代会学习文字。...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:12:1541106009":{"key":"choice_prompt:12:1541106009","kind":"choice_prompt","source_node_id":"12","source_node_type":"__DT.MultiChooseNode","statementID":"1541106009","action_index":"","choice_index":"","choice_id":"","source_cn":"但是，为了先祖的话语得到传承，前首领的后代会学习文字。他