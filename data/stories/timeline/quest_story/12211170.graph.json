se_image":"","document_pic":"","document_gender":""},"cinematic_dialogue:2:1221116003:":{"key":"cinematic_dialogue:2:1221116003:","kind":"cinematic_dialogue","source_node_id":"2","source_node_type":"__DT.PlayTimelineNode","statementID":"1221116003","action_index":"","choice_index":"","choice_id":"","source_cn":"妈妈，妈妈，你快来看！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1221117001:1":{"key":"say:5:1221117001:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1221117001","action_index":"1","choice_index":"","choice_id":"","source_cn":"妈妈，你看——！好漂亮的鱼！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1221117002:1":{"key":"say:6:1221117002:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1221117002","action_index":"1","choice_index":"","choice_id":"","source_cn":"这……这是是幻彩鲷？！可这种鱼应该只有海岛上才有，怎么...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1221117003:1":{"key":"say:7:1221117003:1","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1221117003","action_index":"1","choice_index":"","choice_id":"","source_cn":"——是大海实现了我的愿望！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1221117004:1":{"key":"say:8:1221117004:1","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1221117004","action_index":"1","choice_index":"","choice_id":"","source_cn":"……大海？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1221117005:1":{"key":"say:9:1221117005:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1221117005","action_index":"1","choice_index":"","choice_id":"","source_cn":"嗯！爸爸说过，只要我乖乖听话，不给你添麻烦，大海就会实...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1221117006:1":{"key":"say:10:1221117006:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1221117006","action_index":"1","choice_index":"","choice_id":"","source_cn":"妈妈最近总是叹气，所以我偷偷写了一封许愿信，希望大海能...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1221117007:1":{"key":"say:11:1221117007:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1221117007","action_index":"1","choice_index":"","choice_id":"","source_cn":"妈妈，安尔姆希望你能开心一点，爸爸和哥哥肯定也是这么想的！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1221117008:1":{"key":"say:12:1221117008:1","kind":"say","source_node_id":"12","source_node_type":"_