ment_pic":"","document_gender":""},"say:9:1220436003:0":{"key":"say:9:1220436003:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1220436003","action_index":"0","choice_index":"","choice_id":"","source_cn":"你们到底想说什么？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1220436004:0":{"key":"say:10:1220436004:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1220436004","action_index":"0","choice_index":"","choice_id":"","source_cn":"大老板的意思呢，是让你最近这三场拳赛再放放水。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1220436005:0":{"key":"say:11:1220436005:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1220436005","action_index":"0","choice_index":"","choice_id":"","source_cn":"什么？你们上次说只打一场假拳的！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1220436006:0":{"key":"say:12:1220436006:0","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1220436006","action_index":"0","choice_index":"","choice_id":"","source_cn":"兄弟，大老板很看好你。他的意思是，这几场拳赛打完，你就...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1220436007:0":{"key":"say:13:1220436007:0","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1220436007","action_index":"0","choice_index":"","choice_id":"","source_cn":"以后你跟着大老板赚大钱，吃香喝辣，你妹妹自然也是没人敢...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1220436008:0":{"key":"say:14:1220436008:0","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1220436008","action_index":"0","choice_index":"","choice_id":"","source_cn":"就是！以后就不用再打拳赛了，又累又苦，又不赚钱！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1220436009:0":{"key":"say:15:1220436009:0","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1220436009","action_index":"0","choice_index":"","choice_id":"","source_cn":"你们会这么好心？我妹妹……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1220436010:0":{"key":"say:16:1220436010:0","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1220436010","action_index":"0","choice_index":"","choice_id":"","source_cn":"只要你点头，打完这三场拳赛，我们就把你妹妹送回来，保证...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1220436011:0":{"key":"say:17:1220436011:0","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1220436011","action_index":"0","choice_index":"","choice_id":"","source_cn":"你还不是为了好生活才当了拳手？放心，大老板绝对不会亏待你的！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:18:1220436012:0":{"key":"say:18:1220436012:0","kind":"say","source_node_id":"18","source_node_type":"__DT.ActionNode","statementID":"1220436012","action_index":"0","choice_index":"","choice_id":"","source_cn":"我……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:19:1220436013:0":{"key":"say:19:1220436013:0","kind":"say","source_node_id":"19","source_node_type":"__DT.ActionNode","statementID":"1220436013","action_index":"0","choice_index":"","choice_id":"","source_cn":"这么好的事儿，别人求都求不来，还犹豫什么？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:20:1220436014:0":{"key":"say:20:1220436014:0","kind":"say","source_node_id":"20","source_node_type":"__DT.ActionNode","statementID":"1220436014","action_index":"0","choice_index":"","choice_id":"","source_cn":"就这么说定了啊！三场拳赛，别忘了！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:24:12020443:0":{"key":"narration:24:12020443:0","kind":"narration","source_node_id":"24","source_node_type":"__DT.ActionNode","statementID":"12020443","action_index":"0","choice_index":"","choice_id":"","source_cn":"你们来寻找斯坦顿时，刚好撞见了他和庄家打手交谈