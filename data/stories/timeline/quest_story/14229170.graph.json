nt_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:7:1422917003:0":{"key":"say:7:1422917003:0","kind":"say","source_node_id":"7","source_node_type":"__DT.ActionNode","statementID":"1422917003","action_index":"0","choice_index":"","choice_id":"","source_cn":"这个体型和力量，十有八九是了！鱼王竟然咬了你的钩，看来...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1422917004:0":{"key":"say:8:1422917004:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1422917004","action_index":"0","choice_index":"","choice_id":"","source_cn":"所以那个杜兰姆真的是在骗人吗……他卖给我的赤虾饵不光鱼...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1422917005:0":{"key":"say:9:1422917005:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1422917005","action_index":"0","choice_index":"","choice_id":"","source_cn":"总算开始怀疑了？看来你还没有笨得彻底嘛。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1422917006:0":{"key":"say:10:1422917006:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1422917006","action_index":"0","choice_index":"","choice_id":"","source_cn":"那些鱼饵里八成掺了气味呛鼻的滑鳞粉，一旦放入水中，周围...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic