","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1410325007:1":{"key":"say:12:1410325007:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1410325007","action_index":"1","choice_index":"","choice_id":"","source_cn":"如果我们能够——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1410325008:1":{"key":"say:13:1410325008:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1410325008","action_index":"1","choice_index":"","choice_id":"","source_cn":"想想女王，想想萨洛克兰的子民们，你要为了几个外来者违背...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1410325009:0":{"key":"say:14:1410325009:0","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1410325009","action_index":"0","choice_index":"","choice_id":"","source_cn":"遵命……冕下。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"cinematic_dialogue:16:1410324001:":{"key":"cinematic_dialogue:16:1410324001:","kind":"cinematic_dialogue","source_node_id":"16","source_node_type":"__DT.PlayTimelineNode","statementID":"1410324001","action_index":"","choice_index":"","choice_id":"","source_cn":"因度厄卫队长听令——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","docu