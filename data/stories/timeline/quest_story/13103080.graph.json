":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1310308002:0":{"key":"say:6:1310308002:0","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1310308002","action_index":"0","choice_index":"","choice_id":"","source_cn":"呃，满满他……晕了？他还好吧？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:7:1310308002":{"key":"choice_prompt:7:1310308002","kind":"choice_prompt","source_node_id":"7","source_node_type":"__DT.MultiChooseNode","statementID":"1310308002","action_index":"","choice_index":"","choice_id":"","source_cn":"呃，满满他……晕了？他还好吧？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:8:1310308004:0":{"key":"say:8:1310308004:0","kind":"say","source_node_id":"8","source_node_type":"__DT.ActionNode","statementID":"1310308004","action_index":"0","choice_index":"","choice_id":"","source_cn":"啊……没事就好。我就说嘛，满满也是个经历丰富的小骑士，...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1310308005:0":{"key":"say:9:1310308005:0","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1310308005","action_index":"0","choice_index":"","choice_id":"","source_cn":"哈哈，和你们一样，我也是来参加“鬼影密室”的。只不过我...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1310308006:0":{"key":"say:10:1310308006:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1310308006","action_index":"0","choice_index":"","choice_id":"","source_cn":"工作人员？你的工作就是在这里扮尸体？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1310308007:0":{"key":"say:11:1310308007:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1310308007","action_index":"0","choice_index":"","choice_id":"","source_cn":"咳，当然！这是为了衬托“鬼影密室”那种惊险刺激、让人心...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1310308008:0":{"key":"say:14:1310308008:0","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1310308008","action_index":"0","choice_index":"","choice_id":"","source_cn":"没想到我们的兔先生还真有一套。这样吧，你在旅店的所有花...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1310308009:0":{"key":"say:15:1310308009:0","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1310308009","action_index":"0","choice_index":"","choice_id":"","source_cn":"哇哦，太棒了！你真是我见过的最慷慨、最大方、最豪爽的老板娘！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1310308010:0":{"key":"say:16:1310308010:0","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1310308010","action_index":"0","choice_index":"","choice_id":"","source_cn":"咦？只是最大方最豪爽，不是最美丽的吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1310308011:0":{"key":"say:17:1310308011:0","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1310308011","action_index":"0","choice_index":"","choice_id":"","source_cn":"不不不，当然也是最美丽的！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:20:1310308012:0":{"key":"say:20:1310308012:0","kind":"say","source_node_id":"20","source_node_type":"__DT.ActionNode","statementID":"1310308012","action_index":"0","choice_index":"","choice_id":"","source_cn":"——等等，等等！这到底是怎么回事？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:21:1310308013:0":{"key":"say:21:1310308013:0","kind":"say","source_node_id":"21","source_node_type":"__DT.ActionNode","statementID":"1310308013","action_index":"0","choice_index":"","choice_id":"","source_cn":"洛桑，你怎么会到雪松镇来？！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:7:0:1":{"key