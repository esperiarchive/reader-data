r":""},"say:9:1410820206:1":{"key":"say:9:1410820206:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1410820206","action_index":"1","choice_index":"","choice_id":"","source_cn":"万一……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1410820207:1":{"key":"say:10:1410820207:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1410820207","action_index":"1","choice_index":"","choice_id":"","source_cn":"万一他回心转意，喝下恩典灵露……那就更好了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1410820208:1":{"key":"say:11:1410820208:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1410820208","action_index":"1","choice_index":"","choice_id":"","source_cn":"他就会明白女王大人的良苦用心。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1410820209:1":{"key":"say:12:1410820209:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1410820209","action_index":"1","choice_index":"","choice_id":"","source_cn":"但是……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1410820210:1":{"key":"say:13:1410820210:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1410820210","action_index":"1","choice_index":"","choice_id":"","source_cn":"这是陛下的意思。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1410820211:0":{"key":"say:14:1410820211:0","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1410820211","action_index":"0","choice_index":"","choice_id":"","source_cn":"我明白了。众士兵听令，停止追击——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:15:1410820212:0":{"key":"narration:15:1410820212:0","kind":"narration","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1410820212","action_index":"0","choice_index":"","choice_id":"","source_cn":"与此同时，你、祖娅和因度厄也成功传送到赫托神殿……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:17:140108119:0":{"key":"narration:17:140108119:0","kind":"narration","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"140108119","action_index":"0","choice_index":"","choice_id":"","source_cn":"你们紧急传送离开了宫殿，都铎试图继续追击时，被奎茵拦了下来。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""}},"speaker_entries":{"speaker:都铎":{"key":"speaker:都铎","source":"都铎"},"speaker:奎茵":{"key":"speaker:奎茵","source":"奎茵"},"speaker:黑屏字幕":{"key":"speaker:黑屏字幕","source":"黑屏字幕"}},"stats":{"source_no