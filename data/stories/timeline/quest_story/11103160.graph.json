e_image":"","document_pic":"","document_gender":""},"cinematic_dialogue:8:1110317003:":{"key":"cinematic_dialogue:8:1110317003:","kind":"cinematic_dialogue","source_node_id":"8","source_node_type":"__DT.PlayTimelineNode","statementID":"1110317003","action_index":"","choice_index":"","choice_id":"","source_cn":"阿尔萨，你……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1110316004:1":{"key":"say:11:1110316004:1","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1110316004","action_index":"1","choice_index":"","choice_id":"","source_cn":"布鲁特斯大人，如您所见，乌尔氏族的代表是两个人！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1110316005:1":{"key":"say:12:1110316005:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1110316005","action_index":"1","choice_index":"","choice_id":"","source_cn":"您看，我们……可以再得到一次试炼的机会吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1110316006:1":{"key":"say:13:1110316006:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1110316006","action_index":"1","choice_index":"","choice_id":"","source_cn":"战歌节的规则并没有涵盖你们这种情况。也就是说，裁量权在我——","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":"