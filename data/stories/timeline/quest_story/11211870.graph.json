_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:19:1121187011:1":{"key":"say:19:1121187011:1","kind":"say","source_node_id":"19","source_node_type":"__DT.ActionNode","statementID":"1121187011","action_index":"1","choice_index":"","choice_id":"","source_cn":"所以，我们就在此分别吧，为了下一次相遇。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:20:1121187012:1":{"key":"say:20:1121187012:1","kind":"say","source_node_id":"20","source_node_type":"__DT.ActionNode","statementID":"1121187012","action_index":"1","choice_index":"","choice_id":"","source_cn":"再会，愿你们今后的旅途洒满阳光，永远温暖明亮！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:27:1101021182:0":{"key":"narration:27:1101021182:0","kind":"narration","source_node_id":"27","source_node_type":"__DT.ActionNode","statementID":"1101021182","action_index":"0","choice_index":"","choice_id":"","source_cn":"塔琳与你们告别后，再次踏上追逐对抗恶魔的旅程。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:14:0:1":{"key":"choice:14:0:1","kind":"choice","source_node_id":"14","source_node_type":"__DT.MultiChooseNode","statementID":"1121187001","action_index":"","choice_index":"0","choice_id":"1","source_cn":"你要离开了吗？","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_