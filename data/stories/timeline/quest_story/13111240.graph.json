","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1311124008:1":{"key":"say:16:1311124008:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode","statementID":"1311124008","action_index":"1","choice_index":"","choice_id":"","source_cn":"瓦茨拉夫，是我。我们来拜访柳博米尔是有要事相询——很重...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:17:1311124009:1":{"key":"say:17:1311124009:1","kind":"say","source_node_id":"17","source_node_type":"__DT.ActionNode","statementID":"1311124009","action_index":"1","choice_index":"","choice_id":"","source_cn":"啊！是瓦丽卡女士，请原谅我的失礼，但这几位并非亡灵……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice_prompt:19:1311124009":{"key":"choice_prompt:19:1311124009","kind":"choice_prompt","source_node_id":"19","source_node_type":"__DT.MultiChooseNode","statementID":"1311124009","action_index":"","choice_index":"","choice_id":"","source_cn":"啊！是瓦丽卡女士，请原谅我的失礼，但这几位并非亡灵……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:20:1311124010:1":{"key":"say:20:1311124010:1","kind":"say","source_node_id":"20","source_node_type":"__DT.ActionNode","statementID":"1311124010","action_index":"1","choice_index":"","choice_id":"","source_cn":"没错，这几位都是很好的人，他们还为柳博米尔带来了一份礼物。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document