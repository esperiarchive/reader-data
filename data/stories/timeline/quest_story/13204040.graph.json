":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1320404004:0":{"key":"say:10:1320404004:0","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1320404004","action_index":"0","choice_index":"","choice_id":"","source_cn":"……笨满满，水里有很多石头，你可以坐在上面。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:11:1320404005:0":{"key":"say:11:1320404005:0","kind":"say","source_node_id":"11","source_node_type":"__DT.ActionNode","statementID":"1320404005","action_index":"0","choice_index":"","choice_id":"","source_cn":"这可不能怪我！温泉里人那么多，舒适的位置早就被占住了。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1320404006:0":{"key":"say:12:1320404006:0","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1320404006","action_index":"0","choice_index":"","choice_id":"","source_cn":"那等下次人少的时候，你再试试吧！我们现在先去找老板娘，...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"narration:14:13020412:0":{"key":"narration:14:13020412:0","kind":"narration","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"13020412","action_index":"0","choice_index":"","choice_id":"","source_cn":"你们找了一块清静的地方，舒服地泡了一会儿温泉。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_i