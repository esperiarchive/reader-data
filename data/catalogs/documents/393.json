{"entry":{"textdes_id":"393","page_count":"1","order":"1","object_id":"0","item_id":"0","gender":"false","title_cn":"","title_source":"textdes","title_source_note":"","content_cn":"第一步，将受损武器表面均匀涂抹<style=\"highlight\">冷火油</style>。\n第二步，研磨<style=\"highlight\">金色火纹铁矿</style>直至其成为粉末，将粉末撒在武器受损部位，粉末用量必须足够修复损伤部位。\n第三步，将你的<style=\"highlight\">佩剑</style>完全浸入<style=\"highlight\">酸蚀液</style>，并加热至微微沸腾。\n第四步，使用经典炼金魔法阵，进行魔法反应。","icon":"UI/Icon/Item/item_quest_mapstory_item4.png","image_icon":"","base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item4.prefab","pic":"","pages":[{"order":"1","content_cn":"第一步，将受损武器表面均匀涂抹<style=\"highlight\">冷火油</style>。\n第二步，研磨<style=\"highlight\">金色火纹铁矿</style>直至其成为粉末，将粉末撒在武器受损部位，粉末用量必须足够修复损伤部位。\n第三步，将你的<style=\"highlight\">佩剑</style>完全浸入<style=\"highlight\">酸蚀液</style>，并加热至微微沸腾。\n第四步，使用经典炼金魔法阵，进行魔法反应。"}],"references":[{"reference_type":"nodecanvas","asset_key":"ep6/quest_story_16107560","asset":"ep6/quest_story/NodeCanvas__DialogueTree__ep6__quest_story_16107560.decoded.json","node_id":"0","action_index":"0","mechanisms":["dialogue_open_textdes"]},{"reference_type":"nodecanvas","asset_key":"ep6/quest_story_16107650","asset":"ep6/quest_story/NodeCanvas__DialogueTree__ep6__quest_story_16107650.decoded.json","node_id":"0","action_index":"0","mechanisms":["dialogue_open_textdes"]}],"locations":[],"quests":[{"line_id":"16010107","title_cn":"“合理”的推断","title_i18n":{"cn":"“合理”的推断","en":"Fractured Answer","jp":"「合理的」な推測","kr":"“합리적인” 추론"},"catalog_title_status":"exact_hash","title_record_index":"43103","route":"#/season-6/main/16010107","evidence":[{"relation":"document_quest_plot","reference":{"reference_type":"nodecanvas","asset_key":"ep6/quest_story_16107560","asset":"ep6/quest_story/NodeCanvas__DialogueTree__ep6__quest_story_16107560.decoded.json","node_id":"0","action_index":"0","mechanisms":["dialogue_open_textdes"]},"quest_asset":{"reference_order":52,"plot_id":"16107560","asset_key":"ep6/quest_story_16107560","physical_section":"ep6