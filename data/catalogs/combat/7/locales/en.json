[{"start":16,"end":22,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/en",[{"start":37,"end":43,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":1,"end":5,"tooltip_key":"keyword:weakest"},{"start":11,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/en",[{"start":15,"end":22,"tooltip_key":"keyword:weakest"},{"start":32,"end":47,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","回复量提升至-290% − 30% ATK。"],["/skills/1/variants/1/description_i18n/en","Increases HP recovery to -290% − 30% ATK."],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":11,"end":17,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/en",[{"start":30,"end":36,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":6,"end":21,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/en",[{"start":25,"end":40,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","回复量提升至-300% − 30% ATK。"],["/skills/1/variants/2/description_i18n/en","Increases HP recovery to -300% − 30% ATK."],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":11,"end":17,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/en",[{"start":30,"end":36,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":6,"end":21,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/en",[{"start":25,"end":40,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","伊温释放终极技能“祈雨”期间，每3秒会令最虚弱的1名友军接受1次本技能的效果。"],["/skills/1/variants/3/description_i18n/en","Hewynn's skill grants this effect once every 3s to 1 weakest ally while casting her Ultimate."],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":20,"end":24,"tooltip_key":"keyword:weakest"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/en",[{"start":53,"end":60,"tooltip_key":"keyword:weakest"}]],["/skills/2/name_i18n/cn","焕然"],["/skills/2/name_i18n/en","Revitalize"],["/skills/2/simple_description_i18n/cn","伊温治疗友军时，可以移除其身上所有可驱散的负面状态。"],["/skills/2/simple_description_i18n/en","Hewynn heals allies and removes their dispellable debuffs."],["/skills/2/variants/0/description_i18n/cn","伊温治疗友军时，如果这名友军的当前生命值百分比低于50%，使其额外回复120% ATK的生命值，该效果对每名友军每8 − 1秒至多生效1次。"],["/skills/2/variants/0/description_i18n/en","Hewynn heals an ally, granting an extra 120% ATK HP if their HP ratio is below 50%. This effect can trigger once every 8 − 1s per ally."],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":58,"end":62,"power_type":"skill","parameter":"SArg5"}]],["/skills/2/variants/0/description_power_spans_i18n/en",[{"start":120,"end":124,"power_type":"skill","parameter":"SArg5"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":35,"end":43,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/en",[{"start":40,"end":48,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","伊温治疗友军时，如果这名友军身上有可驱散的负面状态，则移除其身上所有可驱散的负面状态，该效果对每名友军每6 − 1秒至多生效1次。"],["/skills/2/variants/1/description_i18n/en","Heals an ally and removes all their dispellable debuffs, triggering once every 6 − 1s per ally."],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":53,"end":57,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_power_spans_i18n/en",[{"start":80,"end":84,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_i18n/cn","额外治疗对每名友军每6 − 1秒至多生效1次，驱散效果对每名友军每4 − 1秒至多生效1次。"],["/skills/2/variants/2/description_i18n/en","Heals once every 6 − 1s per ally, and removes dispellable debuffs once every 4 − 1s per ally."],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":11,"end":15,"power_type":"skill","parameter":"SArg5"},{"start":34,"end":38,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_power_spans_i18n/en",[{"start":18,"end":22,"power_type":"skill","parameter":"SArg5"},{"start":78,"end":82,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_i18n/cn","额外治疗的回复量提升至130% ATK。"],["/skills/2/variants/3/description_i18n/en","Increases the extra healing amount to 130% ATK."],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":11,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/en",[{"start":38,"end":46,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/en","Hero Focus"],["/skills/3/simple_description_i18n/cn","提高自身攻击力，首次释放大招后攻击力进一步提高。"],["/skills/3/simple_description_i18n/en","Hewynn increases her ATK during battle. She gains extra ATK after casting Rain Prayer for the first time."],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的攻击力提升9%，首次释放终极技能结束后，自身攻击力额外提升6%。"],["/skills/3/variants/0/description_i18n/en","Hewynn increases her ATK by 9% during battle. She gains an extra 6% ATK after casting Rain Prayer for the first time."],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的攻击力提升12%，首次释放终极技能结束后，自身攻击力额外提升8%。"],["/skills/3/variants/1/description_i18n/en","Hewynn increases her ATK by 12% during battle. She gains an extra 8% ATK after casting Rain Prayer for the first time."],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的攻击力提升14%，首次释放终极技能结束后，自身攻击力额外提升10%。"],["/skills/3/variants/2/description_i18n/en","Hewynn increases her ATK by 14% during battle. She gains an extra 10% ATK after casting Rain Prayer for the first time."],["/skills/4/name_i18n/cn","静谧"],["/skills/4/name_i18n/en","Tranquility"],["/skills/4/simple_description_i18n/cn","释放“祈雨”时，伊温在数秒内免疫控制效果。“祈雨”期间降低友军受到的一定比例的伤害。"],["/skills/4/simple_description_i18n/en","Hewynn is immune to control effects and reduces damage taken by allies while casting Rain Prayer."],["/skills/4/variants/0/description_i18n/cn","释放“祈雨”时，伊温获得持续6秒的霸体状态。“祈雨”期间，所有友军受到的伤害下降30%。"],["/skills/4/variants/0/description_i18n/en","Hewynn is unaffected for 6s while casting Rain Prayer. During this time, all allies take 30% less damage."],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":17,"end":19,"tooltip_key":"keyword:uncontrol"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/en",[{"start":10,"end":20,"tooltip_key":"keyword:uncontrol"}]],["/skills/4/variants/1/description_i18n/cn","伊温拥有300点初始能量。“祈雨”期间，所有友军受到的伤害下降32%。"],["/skills/4/variants/1/description_i18n/en","Hewynn has 300 Initial Energy. While Rain Prayer is effective, all allies take 32% less damage."],["/skills/4/variants/2/description_i18n/cn","释放“祈雨”时，伊温每次治疗都会附带“焕然”的技能效果。“祈雨”期间，所有友军受到的伤害下降34%。"],["/skills/4/variants/2/description_i18n/en","While Rain Prayer is effective, all allies take less 34% damage and receive buffs from Revitalize."],["/skills/4/variants/3/description_i18n/cn","“祈雨”期间，所有友军受到的伤害下降36%。"],["/skills/4/variants/3/description_i18n/en","While Rain Prayer is effective, all allies take 36% less damage."],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/en","Enhance Force"],["/skills/5/simple_description_i18n/cn","技能“焕然”还会提高目标急速，持续数秒。"],["/skills/5/simple_description_i18n/en","Hewynn increases the target's Haste for seconds when Revitalize is in effect."],["/skills/5/variants/0/description_i18n/cn","技能“焕然”生效时，还会使目标友军在6秒内提升30点急速。"],["/skills/5/variants/0/description_i18n/en","Hewynn also grants the healed ally 30 Haste for 6s when Revitalize is in effect."],["/exclusive_equipment/name_i18n/cn","春雨的叶脉"],["/exclusive_equipment/name_i18n/en","Spring Petrichor"]]}