,"power_type":"ultimate","parameter":"SArg1"}]],["/skills/0/variants/3/description_tooltip_spans_i18n/cn",[{"start":12,"end":25,"tooltip_key":"stat:ATK"},{"start":38,"end":52,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/3/description_tooltip_spans_i18n/jp",[{"start":10,"end":23,"tooltip_key":"stat:ATK"},{"start":39,"end":53,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_i18n/cn","连续攻击造成的伤害提升至100% + 10% ATK，最后一击造成的伤害提升至240% + 20% ATK。"],["/skills/0/variants/4/description_i18n/jp","連続攻撃のダメージが100% + 10% ATKにUPし、最後の一撃のダメージが240% + 20% ATKにUP"],["/skills/0/variants/4/description_power_spans_i18n/cn",[{"start":16,"end":22,"power_type":"ultimate","parameter":"PlusRatio"},{"start":43,"end":49,"power_type":"ultimate","parameter":"SArg1"}]],["/skills/0/variants/4/description_power_spans_i18n/jp",[{"start":14,"end":20,"power_type":"ultimate","parameter":"PlusRatio"},{"start":44,"end":50,"power_type":"ultimate","parameter":"SArg1"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/cn",[{"start":12,"end":26,"tooltip_key":"stat:ATK"},{"start":39,"end":53,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/jp",[{"start":10,"end":24,"tooltip_key":"stat:ATK"},{"start":40,"end":54,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","迅猛鲨袭"],["/skills/1/name_i18n/jp","シャークストライク"],["/skills/1/simple_description_i18n/cn","快速位移至最虚弱的敌人脚下对其造成伤害并击飞。"],["/skills/1/simple_description_i18n/jp","最も弱っている敵の足元まで素早く移動し、対象にダメージを与え、打ち上げ、後退させる"],["/skills/1/variants/0/description_i18n/cn","潜入水中，快速移动至最虚弱的敌人身下，对其造成220% + 25% ATK伤害并击飞1格。哈拉克在水中会处于无敌状态，且参与击败角色会立即重置“迅猛鲨袭”的冷却时间。"],["/skills/1/variants/0/description_i18n/jp","水中に潜り、最も弱っている敵の足元まで素早く移動し、対象に220% + 25% ATKのダメージを与え、打ち上げ、1マス後退させる。水中にいる間、自身は無敵状態になり、キャラクターの撃破に関与した場合、直ちに「シャークストライク」のCDをリセット"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":27,"end":33,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":33,"end":39,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":10,"end":14,"tooltip_key":"keyword:weakest"},{"start":23,"end":37,"tooltip_key":"stat:ATK"},{"start":54,"end":56,"tooltip_key":"keyword:invincible"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":6,"end":13,"tooltip_key":"keyword:weakest"},{"start":29,"end":43,"tooltip_key":"stat:ATK"},{"start":76,"end":78,"tooltip_key":"keyword:invincible"}]],["/skills/1/variants/1/description_i18n/cn","伤害提高至230% + 25% ATK。"],["/skills/1/variants/1/description_i18n/jp","ダメージが230% + 25% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","伤害提高至240% + 25% ATK。"],["/skills/1/variants/2/description_i18n/jp","ダメージが240% + 25% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","伤害提高至250% + 25% ATK。"],["/skills/1/variants/3/description_i18n/jp","ダメージが250% + 25% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","吞食欲望"],["/skills/2/name_i18n/jp","捕食衝動"],["/skills/2/simple_description_i18n/cn","战斗开始时获得“暴食”效果大幅提升战斗能力，参与击败角色会刷新“暴食”效果时长。“暴食”效果结束时，哈拉克会不分敌我地吞食一名英雄。"],["/skills/2/simple_description_i18n/jp","戦闘開始時、自身に「暴食」を付与し、戦闘能力を大幅に強化。キャラクター撃破に関与するたびに、「暴食」の持続時間をリセット。「暴食」効果終了時、敵味方問わずに1体の英雄を呑み込む"],["/skills/2/variants/0/description_i18n/cn","被动地，战斗开始时，哈拉克获得“暴食”效果，暴击提高35 + 6点，急速提升50点，持续12秒，参与击败角色会刷新“暴食”时长。\n哈拉克在“暴食”状态结束后会失去理智，不分敌我地吞食一名全场最虚弱的非召唤物角色，使其立即被击败，吞食期间自身处于霸体状态。吞食的敌人的当前生命值最多不超过哈拉克200% ATK。在挑战首领的模式中，哈拉克在尝试吞食友军时，会优先将初始站位靠前的友军作为目标。"],["/skills/2/variants/0/description_i18n/jp","パッシブ効果：戦闘開始時、自身に「暴食」を付与し、12秒間、クリティカル+35 + 6、速度+50。キャラクターの撃破に関与するたび、「暴食」の持続時間をリセット\n「暴食」状態終了後、自身は理性を失い、敵味方問わずにフィールド上の最も弱っている召喚ユニット以外のキャラクター1体を呑み込み、対象を即撃破する。呑み込む間、自身はスーパーアーマー状態になる。現在HPがハラックの200% ATKより高い敵は吞み込めない。ボス挑戦モードの場合、ハラックが味方を吞み込もうとする時、初期配置の位置が最も前の味方を優先的に対象に選択"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":28,"end":32,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":39,"end":43,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":95,"end":99,"tooltip_key":"keyword:weakest"},{"start":122,"end":124,"tooltip_key":"keyword:uncontrol"},{"start":146,"end":154,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":115,"end":122,"tooltip_key":"keyword:weakest"},{"start":163,"end":171,"tooltip_key":"keyword:uncontrol"},{"start":187,"end":195,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","“暴食”效果附带的暴击提升至40 + 6点。"],["/skills/2/variants/1/description_i18n/jp","「暴食」効果によるクリティカル上昇量が40 + 6にUP"],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":16,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_power_spans_i18n/jp",[{"start":21,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_i18n/cn","“暴食”效果附带的暴击提升至45 + 6点。"],["/skills/2/variants/2/description_i18n/jp","「暴食」効果によるクリティカル上昇量が45 + 6にUP"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":16,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":21,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_i18n/cn","“暴食”效果附带的暴击提升至50 + 6点。"],["/skills/2/variants/3/description_i18n/jp","「暴食」効果によるクリティカル上昇量が50 + 6にUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":16,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":21,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提高自身生命汲取，参与击败角色后生命汲取获得额外提升。"],["/skills/3/simple_description_i18n/jp","自身のライフスティールがUP。キャラクターの撃破に関与するたびに、追加でライフスティールUP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身生命汲取提升8点，每参与击败1名角色，额外提升1点，最多提升4点。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身のライフスティール+8。キャラクターの撃破に関与するたびに、追加でライフスティール+1、最大で+4まで"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身生命汲取提升10点，每参与击败1名角色，额外提升2点，最多提升8点。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身のライフスティール+10。キャラクターの撃破に関与するたびに、追加でライフスティール+2、最大で+8まで"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身生命汲取提升12点，每参与击败1名角色，额外提升3点，最多提升12点。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身のライフスティール+12。キャラクターの撃破に関与するたびに、追加でライフスティール+3、最大で+12まで"],["/skills/4/name_i18n/cn","噬体消化"],["/skills/4/name_i18n/jp","貪欲な呑噬者"],["/skills/4/simple_description_i18n/cn","参与击败角色提升哈拉克的攻击力和最大生命值。"],["/skills/4/simple_description_i18n/jp","キャラクターの撃破に関与するたびに、自身の攻撃力とHP上限がUP"],["/skills/4/variants/0/description_i18n/cn","哈拉克参与击败角色时，获得该角色60%的攻击力和60%的最大生命值，累计最多获得自身220%的基础攻击力和自身220%的基础最大生命值。"],["/skills/4/variants/0/description_i18n/jp","自身がキャラクター撃破に関与するたびに、撃破されたキャラクターの攻撃力×60%とHP上限×60%を獲得。1度の戦闘につき、この効果によるステータス獲得量はそれぞれ最大で自身の基礎攻撃力×220%、自身の基礎HP上限×220%まで"],["/skills/4/variants/1/description_i18n/cn","累计最多获得自身240%的基础攻击力和自身240%的基础最大生命值。"],["/skills/4/variants/1/description_i18n/jp","累計で獲得できるステータスは、それぞれ最大で自身の基礎攻撃力×240%、自身の基礎HP上限×240%まで"],["/skills/4/variants/2/description_i18n/cn","累计最多获得自身260%的基础攻击力和自身260%的基础最大生命值。"],["/skills/4/variants/2/description_i18n/jp","累計で獲得できるステータスは、それぞれ最大で自身の基礎攻撃力×260%、自身の基礎HP上限×260%まで"],["/skills/4/variants/3/description_i18n/cn","哈拉克参与击败角色时，还会立即回复生命值，回复量等同于被击败角色50%的最大生命值。"],["/skills/4/variants/3/description_i18n/jp","自身がキャラクターの撃破に関与するたびに、自身のHPを撃破したキャラクターのHP上限×50%分回復"],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","参与击败若干角色后，释放终极技能返还一定能量。"],["/skills/5/simple_description_i18n/jp","キャラクターの撃破に一定数関与した後、必殺技発動時にSPを回復"],["/skills/5/variants/0/description_i18n/cn","哈拉克参与击败2名角色后，释放终极技能返还700点能量。"],["/skills/5/variants/0/description_i18n/jp","自身が撃破に関与したキャラクターの数が2体に達した後、必殺技発動時にSPを700回復"],["/exclusive_equipment/name_i18n/cn","噬欲之剑"],["/exclusive_equipment/name_i18n/jp","欲喰いの剣"]]}