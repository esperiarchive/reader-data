":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","伤害提升至240% + 25% ATK。"],["/skills/1/variants/3/description_i18n/jp","ダメージが240% + 25% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","附灵吸髓"],["/skills/2/name_i18n/jp","霊憑き吸収"],["/skills/2/simple_description_i18n/cn","“冥蛇”会定期进行撕咬，造成伤害。"],["/skills/2/simple_description_i18n/jp","「冥蛇」は一定時間ごとに敵に噛みつき、ダメージを与える"],["/skills/2/variants/0/description_i18n/cn","在战斗过程中每过3秒，“冥蛇”会进行一次撕咬，对所有被“冥蛇”附身的敌人造成一次65% ATK伤害。主动释放时，牺牲10%最大生命值使得下一次撕咬获得强化，造成140% ATK伤害，并扣除目标60 + 15点能量。"],["/skills/2/variants/0/description_i18n/jp","戦闘中、「冥蛇」は3秒ごとに噛みつき攻撃を行い、憑依されている敵に65% ATKのダメージを与える。アクティブ効果：HP上限×10%を消費し、次の噛みつき攻撃を強化：ダメージが140% ATKにUPし、ヒットした対象のSPを60 + 15減少させる"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":98,"end":103,"power_type":"skill","parameter":"SArg3"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":114,"end":119,"power_type":"skill","parameter":"SArg3"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":40,"end":47,"tooltip_key":"stat:ATK"},{"start":80,"end":88,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":33,"end":40,"tooltip_key":"stat:ATK"},{"start":88,"end":96,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","普通撕咬的伤害提升至75% ATK。"],["/skills/2/variants/1/description_i18n/jp","通常噛みつき攻撃のダメージが75% ATKにUP"],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":10,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/jp",[{"start":14,"end":21,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","强化撕咬的伤害提升至150% ATK。"],["/skills/2/variants/2/description_i18n/jp","強化噛みつき攻撃のダメージが150% ATKにUP"],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":10,"end":18,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/jp",[{"start":14,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","扣除目标100 + 15点能量。"],["/skills/2/variants/3/description_i18n/jp","対象のSP減少量が100 + 15にUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":7,"end":12,"power_type":"skill","parameter":"SArg3"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":12,"end":17,"power_type":"skill","parameter":"SArg3"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提高自身急速。"],["/skills/3/simple_description_i18n/jp","自身の速度UP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的急速提升12点。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身の速度+12"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的急速提升16点。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身の速度+16"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的急速提升20点。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身の速度+20"],["/skills/4/name_i18n/cn","血祭蛇舞"],["/skills/4/name_i18n/jp","血祭の蛇舞"],["/skills/4/simple_description_i18n/cn","当生命值较高时，会牺牲生命值对全体敌人造成高额伤害。"],["/skills/4/simple_description_i18n/jp","HPが高い場合、HPを消費して敵全体に大ダメージを与える"],["/skills/4/variants/0/description_i18n/cn","战斗开始10秒后，若当前生命值比例大于90%，牺牲30% HP生命值，对全体敌人造成420% ATK伤害，施法期间处于霸体状态。该技能在30秒内至多触发一次。"],["/skills/4/variants/0/description_i18n/jp","戦闘開始から10秒後、HP割合が90%より高い場合、HPを30% HP分消費し、敵全体に420% ATKのダメージを与える。発動中、スーパーアーマー状態になる。このスキルは30秒ごとに1回まで発動可能"],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":25,"end":31,"tooltip_key":"stat:HP"},{"start":42,"end":50,"tooltip_key":"stat:ATK"},{"start":59,"end":61,"tooltip_key":"keyword:uncontrol"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/jp",[{"start":29,"end":35,"tooltip_key":"stat:HP"},{"start":44,"end":52,"tooltip_key":"stat:ATK"},{"start":66,"end":74,"tooltip_key":"keyword:uncontrol"}]],["/skills/4/variants/1/description_i18n/cn","伤害提升至450% ATK。"],["/skills/4/variants/1/description_i18n/jp","ダメージが450% ATKにUP"],["/skills/4/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/2/description_i18n/cn","该技能释放后“冥蛇”们获得2次强化。"],["/skills/4/variants/2/description_i18n/jp","このスキルを発動するたびに、「冥蛇」の噛みつき攻撃が2回強化される"],["/skills/4/variants/3/description_i18n/cn","伤害提升至480% ATK。"],["/skills/4/variants/3/description_i18n/jp","ダメージが480% ATKにUP"],["/skills/4/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","“蛇灵祭礼”派出的“冥蛇”附身的敌人被击败时，“冥蛇”会返回自身，并回复生命值和能量。"],["/skills/5/simple_description_i18n/jp","「蛇霊の祭祀」の「冥蛇」に憑依されている敵が撃破されると、「冥蛇」はヴェパリアンのもとに戻り、HPとSPを回復"],["/skills/5/variants/0/description_i18n/cn","“蛇灵祭礼”派出的“冥蛇”所附身的敌人被击败时，“冥蛇”会返回自身，并回复14% HP的生命值和80点能量。"],["/skills/5/variants/0/description_i18n/jp","「蛇霊の祭祀」の「冥蛇」に憑依されている敵が撃破されると、「冥蛇」はヴェパリアンのもとに戻り、14% HPのHPと80のSPを回復"],["/skills/5/variants/0/description_tooltip_spans_i18n/cn",[{"start":37,"end":43,"tooltip_key":"stat:HP"}]],["/skills/5/variants/0/description_tooltip_spans_i18n/jp",[{"start":47,"end":53,"tooltip_key":"stat:HP"}]],["/skills/5/variants/1/description_i18n/cn","“冥蛇”造成的伤害将附带10点生命汲取。每有一名敌人生命值百分比首次低于60%时，可额外派出一条“冥蛇”，优先选择未被“冥蛇”附身或当前造成伤害最高的敌人，每名敌人至多被2条“冥蛇”附身。"],["/skills/5/variants/1/description_i18n/jp","「冥蛇」でダメージを与える時のライフスティール+10。各敵のHPが初めて60%より低くなった時、追加で冥蛇を1体送り出し、まだ冥蛇が憑依されていない敵、または与ダメージが最も高い敵を優先的に対象に選ぶ。同じ敵に憑依できる冥蛇は最大2体まで"],["/exclusive_equipment/name_i18n/cn","附灵蛇骸"],["/exclusive_equipment/name_i18n/jp","霊憑き蛇骨"]]}