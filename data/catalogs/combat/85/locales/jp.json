祭命宝珠"],["/skills/1/name_i18n/jp","命の宝珠"],["/skills/1/simple_description_i18n/cn","对直线范围内的敌人造成伤害。"],["/skills/1/simple_description_i18n/jp","直線上の敵にダメージを与える"],["/skills/1/variants/0/description_i18n/cn","雪米拉消耗当前生命的10%，从4格外的幽冥裂隙中召唤悲怆宝珠，对飞行路径上的敌人造成320% + 40% ATK伤害。"],["/skills/1/variants/0/description_i18n/jp","現在HPの10%を消費し、4マス離れた幽冥の裂目から悲愴の宝珠を召喚し、宝珠の飛行経路上の敵に320% + 40% ATKのダメージを与える"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":46,"end":52,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":51,"end":57,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":42,"end":56,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":47,"end":61,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","造成的伤害提升至340% + 40% ATK。"],["/skills/1/variants/1/description_i18n/jp","ダメージが340% + 40% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":12,"end":18,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":8,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","造成的伤害提升至360% + 40% ATK。"],["/skills/1/variants/2/description_i18n/jp","ダメージが360% + 40% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":12,"end":18,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":8,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","造成的伤害提升至380% + 40% ATK。"],["/skills/1/variants/3/description_i18n/jp","ダメージが380% + 40% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":12,"end":18,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":8,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","换命夺魂"],["/skills/2/name_i18n/jp","魂の生成"],["/skills/2/simple_description_i18n/cn","消耗生命造成伤害，消耗幽魂将造成额外范围伤害。"],["/skills/2/simple_description_i18n/jp","HPを消費して敵にダメージを与え、幽魂を消費することで、追加で範囲ダメージを敵に与える"],["/skills/2/variants/0/description_i18n/cn","雪米拉消耗当前生命的15%，对单个敌方单位造成其最大生命值24% + 3%真实伤害，最高不超过自身800% ATK。若雪米拉拥有幽魂，则消耗1道幽魂，牵引幽冥之力对目标及周围1格敌方造成其最大生命值20% + 2%真实伤害，最高不超过自身500% ATK。被动地，我方消耗的生命或护盾达到雪米拉生命上限的50%时，在雪米拉身侧凝聚1道幽魂，至多存在5道幽魂。"],["/skills/2/variants/0/description_i18n/jp","現在HPの15%を消費し、敵1体にその敵のHP上限×24% + 3%の確定ダメージを与える。このダメージはシェミーラの800% ATKを超えない。シェミーラが幽魂を持っている場合、幽魂を1体消費し、さらに幽冥の力で対象とその周囲1マスの敵にそれぞれのHP上限×20% + 2%の確定ダメージを与える。この確定ダメージはシェミーラの500% ATKを超えない。パッシブ効果：味方が減少したHPとシールド値の合計値が「シェミーラのHP上限の50%」に達するたびに、シェミーラのそばに幽魂を1体生成。同時に存在できる幽魂は最大5体まで"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":32,"end":37,"power_type":"skill","parameter":"SArg1"},{"start":102,"end":107,"power_type":"skill","parameter":"SArg2"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":29,"end":34,"power_type":"skill","parameter":"SArg1"},{"start":133,"end":138,"power_type":"skill","parameter":"SArg2"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":49,"end":57,"tooltip_key":"stat:ATK"},{"start":119,"end":127,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":59,"end":67,"tooltip_key":"stat:ATK"},{"start":165,"end":173,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","对单个敌方单位造成的最大生命值伤害提升至26% + 3%。"],["/skills/2/variants/1/description_i18n/jp","敵1体に与えるダメージがHP上限×26% + 3%にUP"],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":23,"end":28,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/1/description_power_spans_i18n/jp",[{"start":20,"end":25,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/2/description_i18n/cn","对单个敌方单位造成的最大生命值伤害提升至28% + 3%。"],["/skills/2/variants/2/description_i18n/jp","敵1体に与えるダメージがHP上限×28% + 3%にUP"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":23,"end":28,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":20,"end":25,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/3/description_i18n/cn","对单个敌方单位造成的最大生命值伤害提升至30% + 3%。"],["/skills/2/variants/3/description_i18n/jp","敵1体に与えるダメージがHP上限×30% + 3%にUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":23,"end":28,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":20,"end":25,"power_type":"skill","parameter":"SArg1"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提高自身攻击回能，召唤3道幽魂后额外提升攻击回能。"],["/skills/3/simple_description_i18n/jp","自身の攻撃SP回復力UP。幽魂を3体生成した後、追加で攻撃SP回復力UP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身攻击回能提升24%，召唤3道幽魂后额外提升6%攻击回能。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身の攻撃SP回復力+24%。幽魂を3体生成した後、追加で攻撃SP回復力+6%"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身攻击回能提升32%，召唤3道幽魂后额外提升8%攻击回能。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身の攻撃SP回復力+32%。幽魂を3体生成した後、追加で攻撃SP回復力+8%"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身攻击回能提升40%，召唤3道幽魂后额外提升10%攻击回能。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身の攻撃SP回復力+40%。幽魂を3体生成した後、追加で攻撃SP回復力+10%"],["/skills/4/name_i18n/cn","幽冥护身"],["/skills/4/name_i18n/jp","幽冥の加護"],["/skills/4/simple_description_i18n/cn","将幽魂转化为护盾，溢出护盾将转化为全场范围伤害。"],["/skills/4/simple_description_i18n/jp","幽魂をシールドに変え、余ったシールド値をフィールド上の敵全体への範囲ダメージに変換"],["/skills/4/variants/0/description_i18n/cn","累计受到生命上限30%伤害或召唤幽魂达到上限后，会消耗1道幽魂生成护盾，持续5秒，护盾能够抵挡雪米拉250% ATK伤害，持续时间结束时，雪米拉将剩余的护盾能量宣泄而出，对全场敌人造成等同于剩余护盾量的伤害。"],["/skills/4/variants/0/description_i18n/jp","合計被ダメージがHP上限×30%に達する、または生成した幽魂が上限に達するたびに、幽魂を1体消費し、シェミーラの250% ATK分のシールドを5秒間獲得。シールドの持続時間終了時、フィールド上の敵全体に残りのシールド値と同じ分のダメージを与える"],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":50,"end":58,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/jp",[{"start":56,"end":64,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_i18n/cn","护盾抵挡的伤害提高至270% ATK。"],["/skills/4/variants/1/description_i18n/jp","シールドで防げるダメージが270% ATKにUP"],["/skills/4/variants/1/description_tooltip_spans_i18n/cn",[{"start":10,"end":18,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_tooltip_spans_i18n/jp",[{"start":13,"end":21,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/2/description_i18n/cn","幽魂攻击时会额外造成目标最大生命值3%真实伤害，最高不超过自身90% ATK，并造成等同于伤害量的生命削减。"],["/skills/4/variants/2/description_i18n/jp","幽魂が攻撃する時、追加で対象のHP上限×3%の確定ダメージを与える。この追加ダメージはシェミーラの90% ATKを超えない。さらに、与えたダメージ分のHP上限減少効果を与える"],["/skills/4/variants/2/description_tooltip_spans_i18n/cn",[{"start":31,"end":38,"tooltip_key":"stat:ATK"},{"start":49,"end":53,"tooltip_key":"keyword:hpCut"}]],["/skills/4/variants/2/description_tooltip_spans_i18n/jp",[{"start":49,"end":56,"tooltip_key":"stat:ATK"},{"start":75,"end":81,"tooltip_key":"keyword:hpCut"}]],["/skills/4/variants/3/description_i18n/cn","护盾抵挡的伤害提高至300% ATK。"],["/skills/4/variants/3/description_i18n/jp","シールドで防げるダメージが300% ATKにUP"],["/skills/4/variants/3/description_tooltip_spans_i18n/cn",[{"start":10,"end":18,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/jp",[{"start":13,"end":21,"tooltip_key":"stat:ATK"}]],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","英雄单位死亡时，获得一道幽魂。"],["/skills/5/simple_description_i18n/jp","英雄ユニットが戦闘不能になるたびに、幽魂を1体生成"],["/skills/5/variants/0/description_i18n/cn","每个英雄单位死亡时，雪米拉额外获得1道幽魂。"],["/skills/5/variants/0/description_i18n/jp","英雄ユニットが戦闘不能になるたびに、シェミーラは幽魂を1体生成"],["/exclusive_equipment/name_i18n/cn","悲怆宝珠"],["/exclusive_equipment/name_i18n/jp","悲愴の宝珠"]]}