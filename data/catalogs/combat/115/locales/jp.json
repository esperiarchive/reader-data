io"},{"start":54,"end":60,"power_type":"skill","parameter":"SArg1"},{"start":98,"end":104,"power_type":"skill","parameter":"SArg3"},{"start":116,"end":122,"power_type":"skill","parameter":"SArg4"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":22,"end":28,"power_type":"skill","parameter":"PlusRatio"},{"start":42,"end":48,"power_type":"skill","parameter":"SArg1"},{"start":96,"end":102,"power_type":"skill","parameter":"SArg3"},{"start":116,"end":122,"power_type":"skill","parameter":"SArg4"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":23,"end":37,"tooltip_key":"stat:ATK"},{"start":94,"end":108,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":18,"end":32,"tooltip_key":"stat:ATK"},{"start":92,"end":106,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","“本相”形态：降低的急速提升至70点；“变形”形态：造成的伤害提升至390% + 45% ATK。"],["/skills/1/variants/1/description_i18n/jp","「元の姿」：速度減少量が70にUP。「アウルベア」形態：ダメージが390% + 45% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":38,"end":44,"power_type":"skill","parameter":"SArg3"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":37,"end":43,"power_type":"skill","parameter":"SArg3"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":34,"end":48,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":33,"end":47,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","“本相”形态：降低的急速提升至80点；“变形”形态：造成的伤害提升至420% + 45% ATK。"],["/skills/1/variants/2/description_i18n/jp","「元の姿」：速度減少量が80にUP。「アウルベア」形態：ダメージが420% + 45% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":38,"end":44,"power_type":"skill","parameter":"SArg3"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":37,"end":43,"power_type":"skill","parameter":"SArg3"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":34,"end":48,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":33,"end":47,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","“本相”形态：降低的急速提升至90点；“变形”形态：造成的伤害提升至450% + 45% ATK。"],["/skills/1/variants/3/description_i18n/jp","「元の姿」：速度減少量が90にUP。「アウルベア」形態：ダメージが450% + 45% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":38,"end":44,"power_type":"skill","parameter":"SArg3"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":37,"end":43,"power_type":"skill","parameter":"SArg3"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":34,"end":48,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":33,"end":47,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","紧急避险"],["/skills/2/name_i18n/jp","緊急回避"],["/skills/2/simple_description_i18n/cn","“本相”形态：使一名友军持续恢复生命。“变形”形态：使多名友军持续恢复生命并获得护盾。"],["/skills/2/simple_description_i18n/jp","「元の姿」：味方1体のHPを持続的に回復。「アウルベア」形態：複数の味方のHPを持続的に回復し、シールドを付与"],["/skills/2/variants/0/description_i18n/cn","“本相”形态：赫普对最虚弱的友军施加治愈术，使目标在6秒内每秒恢复130% + 16% ATK生命值。\n“变形”形态：赫普对最虚弱的3名友军施加治愈术和坚硬皮肤，使目标在6秒内每秒恢复130% + 16% ATK生命值，并使其获得400% + 64% ATK护盾，持续15秒。"],["/skills/2/variants/0/description_i18n/jp","「元の姿」：最も弱っている味方に自然回復を付与。自然回復状態の味方は6秒間、毎秒130% + 16% ATKのHPを回復\n「アウルベア」形態：最も弱っている味方3体に6秒間の自然回復と15秒間のアイアンスキンを付与。自然回復：毎秒130% + 16% ATKのHPを回復。アイアンスキン：400% + 64% ATKのシールド値を獲得"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":37,"end":43,"power_type":"skill","parameter":"SArg1"},{"start":96,"end":102,"power_type":"skill","parameter":"SArg1"},{"start":119,"end":125,"power_type":"skill","parameter":"SArg3"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":44,"end":50,"power_type":"skill","parameter":"SArg1"},{"start":119,"end":125,"power_type":"skill","parameter":"SArg1"},{"start":148,"end":154,"power_type":"skill","parameter":"SArg3"}]],["/skills/2/variants/0/description_tooltip_spa