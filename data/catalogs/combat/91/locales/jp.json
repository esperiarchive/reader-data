-60% + 2%"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":29,"end":34,"power_type":"skill","parameter":"PlusRatio"},{"start":64,"end":69,"power_type":"skill","parameter":"SArg0"},{"start":77,"end":83,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":27,"end":32,"power_type":"skill","parameter":"PlusRatio"},{"start":57,"end":63,"power_type":"skill","parameter":"SArg1"},{"start":100,"end":105,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":26,"end":38,"tooltip_key":"stat:ATK"},{"start":49,"end":51,"tooltip_key":"keyword:uncontrol"},{"start":73,"end":87,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":24,"end":36,"tooltip_key":"stat:ATK"},{"start":53,"end":67,"tooltip_key":"stat:ATK"},{"start":77,"end":85,"tooltip_key":"keyword:uncontrol"}]],["/skills/2/variants/1/description_i18n/cn","每次造成的伤害提升至25% + 3% ATK。"],["/skills/2/variants/1/description_i18n/jp","1回ごとのダメージが25% + 3% ATKにUP"],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":13,"end":18,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_power_spans_i18n/jp",[{"start":13,"end":18,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":10,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/jp",[{"start":10,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","每次造成的伤害提升至30% + 3% ATK。"],["/skills/2/variants/2/description_i18n/jp","1回ごとのダメージが30% + 3% ATKにUP"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":13,"end":18,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":13,"end":18,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":10,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/jp",[{"start":10,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","每次造成的伤害提升至35% + 3% ATK。"],["/skills/2/variants/3/description_i18n/jp","1回ごとのダメージが35% + 3% ATKにUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":13,"end":18,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":13,"end":18,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":10,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/jp",[{"start":10,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提高自身暴击。"],["/skills/3/simple_description_i18n/jp","自身のクリティカルUP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的暴击提升12点，对累计造成伤害最高的敌人造成伤害时暴击额外提升30点。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身のクリティカル+12。合計与ダメージが最も高い敵にダメージを与える場合、追加でクリティカル+30"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的暴击提升16点，对累计造成伤害最高的敌人造成伤害时暴击额外提升40点。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身のクリティカル+16。合計与ダメージが最も高い敵にダメージを与える場合、追加でクリティカル+40"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的暴击提升20点，对累计造成伤害最高的敌人造成伤害时暴击额外提升50点。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身のクリティカル+20。合計与ダメージが最も高い敵にダメージを与える場合、追加でクリティカル+50"],["/skills/4/name_i18n/cn","圣诫裁决"],["/skills/4/name_i18n/jp","神託裁決"],["/skills/4/simple_description_i18n/cn","多次释放“执罚迅锋”时能够追加斩击次数造成额外伤害。"],["/skills/4/simple_description_i18n/jp","「処刑の刃」を複数回発動するたびに、追加で敵にダメージを与える"],["/skills/4/variants/0/description_i18n/cn","每第二次释放“执罚迅锋”时，会额外对战场上两条敌人数量最多的直线路径进行“神圣斩击”，对路径上的敌人造成200% ATK伤害，优先选择与本次“执罚迅锋”冲刺路径不同的直线路径。"],["/skills/4/variants/0/description_i18n/jp","「処刑の刃」を2回発動するたびに、フィールド上の敵の数が最も多い直線経路2本を狙って「神聖斬撃」を繰り出し、経路上の敵に200% ATKのダメージを与える。「神聖斬撃」の経路は、直前の「処刑の刃」の突進経路と違う直線経路を優先的に選択"],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":30,"end":34,"tooltip_key":"keyword:standardline"},{"start":52,"end":60,"tooltip_key":"stat:ATK"},{"start":83,"end":87,"tooltip_key":"keyword:standardline"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/jp",[{"start":32,"end":36,"tooltip_key":"keyword:standardline"},{"start":60,"end":68,"tooltip_key":"stat:ATK"},{"start":106,"end":110,"tooltip_key":"keyword:standardline"}]],["/skills/4/variants/1/description_i18n/cn","造成的伤害提升至240% ATK。"],["/skills/4/variants/1/description_i18n/jp","ダメージが240% ATKにUP"],["/skills/4/variants/1/description_tooltip_spans_i18n/cn",[{"start":8,"end":16,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/2/description_i18n/cn","造成的伤害提升至280% ATK。"],["/skills/4/variants/2/description_i18n/jp","ダメージが280% ATKにUP"],["/skills/4/variants/2/description_tooltip_spans_i18n/cn",[{"start":8,"end":16,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/3/description_i18n/cn","“执罚迅锋”期间阿塔利娅额外提升50点终结，且参与击败敌人或者释放终极技能后，立刻重置“执罚迅锋”的冷却时间。"],["/skills/4/variants/3/description_i18n/jp","敵の撃破に関与する、または必殺技を発動するたびに、「処刑の刃」のCDをリセット。さらに、「処刑の刃」の期間中、自身の処断+50。"],["/skills/4/variants/3/description_tooltip_spans_i18n/cn",[{"start":23,"end":27,"tooltip_key":"keyword:takedown"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/jp",[{"start":2,"end":7,"tooltip_key":"keyword:takedown"}]],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","降低敌人护盾的抵御值。"],["/skills/5/simple_description_i18n/jp","敵のシールドを削る"],["/skills/5/variants/0/description_i18n/cn","技能“执罚迅锋”和“神圣斩击”还会击碎目标身上的护盾，击碎护盾的抵御值至多为自身800% ATK。"],["/skills/5/variants/0/description_i18n/jp","スキル「処刑の刃」と「神聖斬撃」はダメージを与える時に対象のシールドを削れるようになる。削れるシールド値は最大で自身の800% ATKまで"],["/skills/5/variants/0/description_tooltip_spans_i18n/cn",[{"start":40,"end":48,"tooltip_key":"stat:ATK"}]],["/skills/5/variants/0/description_tooltip_spans_i18n/jp",[{"start":59,"end":67,"tooltip_key":"stat:ATK"}]],["/exclusive_equipment/name_i18n/cn","圣辉骑枪"],["/exclusive_equipment/name_i18n/jp","聖なるランス"]]}