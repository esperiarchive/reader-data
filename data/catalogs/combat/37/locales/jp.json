d":49,"power_type":"skill","parameter":"PlusRatio"},{"start":72,"end":78,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":44,"end":50,"power_type":"skill","parameter":"PlusRatio"},{"start":82,"end":88,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":39,"end":53,"tooltip_key":"stat:ATK"},{"start":68,"end":82,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":40,"end":54,"tooltip_key":"stat:ATK"},{"start":78,"end":92,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","伤害提升至155% + 15% ATK，治疗效果提升至155% + 15% ATK。"],["/skills/2/variants/1/description_i18n/jp","ダメージが155% + 15% ATKにUPし、回復量が155% + 15% ATKにUP"],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"},{"start":31,"end":37,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"},{"start":32,"end":38,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"},{"start":27,"end":41,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"},{"start":28,"end":42,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","宝石会根据主目标的伤害类型而变化成不同形态，并对受影响目标产生不同的额外效果：若主目标造成物理伤害则变为红宝石，降低敌人10%护甲并提升友军10%护甲，持续5秒；若主目标造成魔法伤害则变为蓝宝石，降低敌人10%魔抗并提升友军10%魔抗，持续5秒。"],["/skills/2/variants/2/description_i18n/jp","宝石は敵のダメージタイプにより色が異なり、様々な追加効果を与える。物理ダメージの敵の場合、赤い宝石：敵の物理防御-10%、味方の物理防御+10%、5秒間持続。魔法ダメージの敵の場合、青い宝石：敵の魔法防御-10%、味方の魔法防御+10%、5秒間持続"],["/skills/2/variants/3/description_i18n/cn","伤害提升至160% + 15% ATK，治疗效果提升至160% + 15% ATK。"],["/skills/2/variants/3/description_i18n/jp","ダメージが160% + 15% ATKにUPし、回復量が160% + 15% ATKにUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"},{"start":31,"end":37,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"},{"start":32,"end":38,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"},{"start":27,"end":41,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"},{"start":28,"end":42,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提高自身生命值。"],["/skills/3/simple_description_i18n/jp","自身のHPがUP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的生命值提升17%。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身のHP+17%"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的生命值提升23%。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身のHP+23%"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的生命值提升29%。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身のHP+29%"],["/skills/4/name_i18n/cn","华丽开场"],["/skills/4/name_i18n/jp","オープニングダンス"],["/skills/4/simple_description_i18n/cn","开局时对身前的友军施加单体的强化和持续治疗效果。"],["/skills/4/simple_description_i18n/jp","戦闘開始時、前方の味方1体を強化し、持続的な回復効果を与える"],["/skills/4/variants/0/description_i18n/cn","战斗开始时，立即对布阵在自己身前一格上的友方英雄施加“舞动生息”和“宝石愈疗”技能的持续增益效果。"],["/skills/4/variants/0/description_i18n/jp","戦闘開始時、自身の前方1マスに配置された味方英雄に「ハッピーダンス」と「クリスタルヒール」の持続するバフを付与"],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":14,"end":18,"tooltip_key":"keyword:frontonehex"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/jp",[{"start":9,"end":14,"tooltip_key":"keyword:frontonehex"}]],["/skills/4/variants/1/description_i18n/cn","同时还会使该友方英雄提高15点受愈，持续至战斗结束。"],["/skills/4/variants/1/description_i18n/jp","さらに永続的に味方英雄の治癒+15"],["/skills/4/variants/2/description_i18n/cn","该友方英雄获得的受愈提高至20点。"],["/skills/4/variants/2/description_i18n/jp","味方英雄の治癒上昇量が20UP"],["/skills/4/variants/3/description_i18n/cn","该友方英雄获得的受愈提高至25点。"],["/skills/4/variants/3/description_i18n/jp","味方英雄の治癒上昇量が25UP"],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","技能“宝石愈疗”持续期间，目标生命值过低时会获得一次强力治疗。"],["/skills/5/simple_description_i18n/jp","「クリスタルヒール」の効果持続中、対象のHPがかなり減少すると大回復を1回行う"],["/skills/5/variants/0/description_i18n/cn","技能“宝石愈疗”施加的治愈法术持续期间，目标生命值百分比首次低于50%时，会立即获得一次强力治疗，恢复自身200% ATK的生命值。每次释放该技能，最多只能触发一次强力治疗的效果。"],["/skills/5/variants/0/description_i18n/jp","「クリスタルヒール」の治療効果持続中、対象のHP割合が初めて50%より低くなった時、直ちに対象のHPをフィーの200% ATK分回復。この大回復効果は「クリスタルヒール」を1回放つごとに1回まで発動可能"],["/skills/5/variants/0/description_tooltip_spans_i18n/cn",[{"start":53,"end":61,"tooltip_key":"stat:ATK"}]],["/skills/5/variants/0/description_tooltip_spans_i18n/jp",[{"start":55,"end":63,"tooltip_key":"stat:ATK"}]],["/exclusive_equipment/name_i18n/cn","拉拉指挥棒"],["/exclusive_equipment/name_i18n/jp","激励のバトン"]]}