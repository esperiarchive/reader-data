ills/2/name_i18n/kr","잔월 베기"],["/skills/2/simple_description_i18n/cn","对前方敌人造成范围伤害并击倒。"],["/skills/2/simple_description_i18n/kr","전방의 적군에게 광역 대미지를 입히고 넘어뜨린다."],["/skills/2/variants/0/description_i18n/cn","用弯刀横扫前方2格半径的扇形区域，造成310% + 30% ATK伤害并击倒敌人1.5秒。"],["/skills/2/variants/0/description_i18n/kr","시미터로 전방 2칸 반경의 부채꼴 구역을 휩쓸어 310% + 30% ATK의 대미지를 입히고 적군을 1.5초 동안 넘어뜨린다."],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":23,"end":29,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_power_spans_i18n/kr",[{"start":31,"end":37,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":19,"end":33,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/kr",[{"start":27,"end":41,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","伤害提升至320% + 30% ATK。"],["/skills/2/variants/1/description_i18n/kr","대미지가 320% + 30% ATK로 증가한다."],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_power_spans_i18n/kr",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/kr",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","伤害提升至330% + 30% ATK。"],["/skills/2/variants/2/description_i18n/kr","대미지가 330% + 30% ATK로 증가한다."],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_power_spans_i18n/kr",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/kr