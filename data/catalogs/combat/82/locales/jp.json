n/jp","ダークボールを3個召喚し、敵が最も密集しているエリアに向けて1つずつ放ち、着地点の周囲1マス範囲内の敵に65% + 7% ATKのダメージを与える"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":38,"end":43,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":55,"end":60,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":35,"end":47,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":52,"end":64,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","伤害值提升至70% + 7% ATK。"],["/skills/1/variants/1/description_i18n/jp","ダメージが70% + 7% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":9,"end":14,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":6,"end":18,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","伤害值提升至75% + 7% ATK。"],["/skills/1/variants/2/description_i18n/jp","ダメージが75% + 7% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":9,"end":14,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":6,"end":18,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","伤害值提升至80% + 7% ATK。"],["/skills/1/variants/3/description_i18n/jp","ダメージが80% + 7% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":9,"end":14,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":6,"end":18,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","巫影魔爪"],["/skills/2/name_i18n/jp","魔の影爪"],["/skills/2/simple_description_i18n/cn","使用魔法抓取最近的敌人，并将其砸向敌方最密集区域。"],["/skills/2/simple_description_i18n/jp","魔法で最も近い敵を掴み、そして敵が最も密集しているエリアに向けて投下"],["/skills/2/variants/0/description_i18n/cn","使用魔法将最靠近自己的1名敌人抓到半空禁锢1秒，随后将其砸向敌方最密集区域并使其倒地0.5秒，对其周围1格范围内的敌人造成150% + 10% ATK伤害。优先选择范围内不处于霸体或稳定状态的敌人。"],["/skills/2/variants/0/description_i18n/jp","魔法で自身から最も近い敵1体を掴み、空中に1秒間拘束する。その後、対象を敵が最も密集しているエリアに向けて投下し、0.5秒間ノックダウンさせ、着地点の周囲1マス範囲内の敵に150% + 10% ATKのダメージを与える。範囲内にいるスーパーアーマーや安定状態以外の敵を優先的に選択"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":65,"end":71,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":90,"end":96,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":61,"end":75,"tooltip_key":"stat:ATK"},{"start":88,"end":90,"tooltip_key":"keyword:uncontrol"},{"start":91,"end":93,"tooltip_key":"keyword:stable"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":86,"end":100,"tooltip_key":"stat:ATK"},{"start":116,"end":124,"tooltip_key":"keyword:uncontrol"},{"start":125,"end":127,"tooltip_key":"keyword:stable"}]],["/skills/2/variants/1/description_i18n/cn","伤害值提升至160% + 10% ATK。"],["/skills/2/variants/1/description_i18n/jp","ダメージが160% + 10% ATKにUP"],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":10,"end":16,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":6,"end":20,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","伤害值提升至170% + 10% ATK。"],["/skills/2/variants/2/description_i18n/jp","ダメージが170% + 10% ATKにUP"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":10,"end":16,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":6,"end":20,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","伤害值提升至180% + 10% ATK。"],["/skills/2/variants/3/description_i18n/jp","ダメージが180% + 10% ATKにUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":10,"end":16,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":6,"end":20,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提高自身暴击。"],["/skills/3/simple_description_i18n/jp","自身のクリティカルUP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身暴击提高18点，终极技能“魔渊之引”击败过敌人后额外提高12点。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身のクリティカル+18。必殺技「深淵の引力」で敵を撃破している場合、追加で自身のクリティカル+12"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身暴击提高24点，终极技能“魔渊之引”击败过敌人后额外提高16点。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身のクリティカル+24。必殺技「深淵の引力」で敵を撃破している場合、追加で自身のクリティカル+16"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身暴击提高30点，终极技能“魔渊之引”击败过敌人后额外提高20点。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身のクリティカル+30。必殺技「深淵の引力」で敵を撃破している場合、追加で自身のクリティカル+20"],["/skills/4/name_i18n/cn","邃黯回响"],["/skills/4/name_i18n/jp","闇の残響"],["/skills/4/simple_description_i18n/cn","模仿记忆中的术式，在战斗开始时增强自身并对敌方发动攻击。"],["/skills/4/simple_description_i18n/jp","記憶に残る術式を模倣し、戦闘開始時に自身を強化し、敵を攻撃"],["/skills/4/variants/0/description_i18n/cn","模仿梅林释放过且令人记忆深刻的术式，在战斗开始时，迪尔格雷依次释放以下技能：\n启明术：使自身获得30点急速持续8秒，持续期间处于霸体状态；\n禁锢术：对最靠后的1名敌人造成25% ATK伤害，并将其禁锢1.5秒，被禁锢的敌人无法行动；\n星陨术：制造一道黑暗焰流攻击场上所有敌人，对其造成40% ATK真实伤害，并使其攻击速度降低20点持续5秒。"],["/skills/4/variants/0/description_i18n/jp","記憶に鮮明に残るマーリンの術式を模倣し、戦闘開始時、以下のスキルを順番に発動する：\n明星術：8秒間、自身の速度+30。持続期間中、自身はスーパーアーマー状態になる\n拘束術：最も後ろにいる敵1体に25% ATKのダメージを与え、1.5秒間拘束する。拘束された敵は行動不能になる\n星墜術：暗黒の炎でフィールド上の敵全体を攻撃し、40% ATKの確定ダメージを与え、5秒間、対象の攻撃速度-20"],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":64,"end":66,"tooltip_key":"keyword:uncontrol"},{"start":75,"end":78,"tooltip_key":"keyword:backest"},{"start":85,"end":92,"tooltip_key":"stat:ATK"},{"start":142,"end":149,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/jp",[{"start":68,"end":76,"tooltip_key":"keyword:uncontrol"},{"start":86,"end":93,"tooltip_key":"keyword:backest"},{"start":97,"end":104,"tooltip_key":"stat:ATK"},{"start":162,"end":169,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_i18n/cn","黑暗焰流的伤害提升至45% ATK。"],["/skills/4/variants/1/description_i18n/jp","暗黒の炎のダメージが45% ATKにUP"],["/skills/4/variants/1/description_tooltip_spans_i18n/cn",[{"start":10,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_tooltip_spans_i18n/jp",[{"start":10,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/2/description_i18n/cn","若梅林出现在敌方战场，则在战斗开始时将其沉默8秒，沉默期间梅林无法释放技能，其原本在战斗开始时释放的技能会在沉默结束后释放，当沉默结束时，迪尔格雷损失5%当前生命值；若梅林未出现在敌方战场，则战斗开始时使自身永久提高10%攻击力。"],["/skills/4/variants/2/description_i18n/jp","敵にマーリンがいる場合、戦闘開始時にそのマーリンに8秒間の沈黙を付与。沈黙状態のマーリンはスキル（残響や霊器など）発動不可になり、戦闘開始時発動のスキルは沈黙状態解除後に発動する。沈黙状態終了時、ディアグレスは現在HPの5%を失う。敵にマーリンがいない場合、戦闘開始時から永続的に自身の攻撃力+10%"],["/skills/4/variants/3/description_i18n/cn","黑暗焰流的伤害提升至50% ATK。"],["/skills/4/variants/3/description_i18n/jp","暗黒の炎のダメージが50% ATKにUP"],["/skills/4/variants/3/description_tooltip_spans_i18n/cn",[{"start":10,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/jp",[{"start":10,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","额外获得初始能量。"],["/skills/5/simple_description_i18n/jp","初期SPがUP"],["/skills/5/variants/0/description_i18n/cn","额外获得200点初始能量。"],["/skills/5/variants/0/description_i18n/jp","初期SP+200"],["/exclusive_equipment/name_i18n/cn","黯影魔杖"],["/exclusive_equipment/name_i18n/jp","暗影の杖"]]}