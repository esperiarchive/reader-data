spans_i18n/cn",[{"start":9,"end":15,"power_type":"ultimate","parameter":"PlusRatio"}]],["/skills/0/variants/4/description_power_spans_i18n/kr",[{"start":9,"end":15,"power_type":"ultimate","parameter":"PlusRatio"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/kr",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","声若洪钟"],["/skills/1/name_i18n/kr","위대한 울림"],["/skills/1/simple_description_i18n/cn","对面前的敌人造成伤害，并根据指定的秩序附带额外的效果。"],["/skills/1/simple_description_i18n/kr","전방의 적에게 대미지를 입히고 지정한 질서에 따라 추가 효과를 부여한다."],["/skills/1/variants/0/description_i18n/cn","发射音波，对面前3格宽、3格长的区域的敌人造成4段40% + 5% ATK伤害，秩序钟形态为“<sprite name=\"spui_oldgod_icon_1\">禁咒”时，额外降低敌人60点攻击速度，持续4秒；秩序钟形态为“<sprite name=\"spui_oldgod_icon_2\">抑生”时，额外附带敌人已损失生命值3%的伤害，该伤害最高不超过自身30%攻击力。"],["/skills/1/variants/0/description_i18n/kr","음파를 발사해 전방 가로 3칸, 세로 3칸 범위의 적에게 40% + 5% ATK의 대미지를 4회 입힌다. 질서의 종 형태가 <sprite name=\"spui_oldgod_icon_1\">주문 봉인일 시, 추가로 4초 동안 적의 공격 속도를 60 감소시킨다. 질서의 종 형태가 <sprite name=\"spui_oldgod_icon_2\">치유 억제일 시, 적이 잃은 HP 3%의 대미지를 추가로 입힌다. 해당 대미지는 자신의 공격력 30%를 초과하지 않는다."],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":28,"end":33,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/kr",[{"start":35,"end":40,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":25,"end":37,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/kr",[{"start":32,"end":44,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","伤害提升至45% + 5% ATK。"],["/skills/1/variants/1/description_i18n/kr","대미지가 45% + 5% ATK로 증가한다."],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/kr",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/kr",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","伤害提升至50% + 5% ATK。"],["/skills/1/variants/2/description_i18n/kr","대미지가 50% + 5% ATK로 증가한다."],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/kr",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/kr",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","伤害提升至55% + 5% ATK。"],["/skills/1/variants/3/description_i18n/kr","대미지가 55% + 5% ATK로 증가한다."],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/kr",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/kr",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","守护音壁"],["/skills/2/name_i18n/kr","수호의 소리벽"],["/skills/2/simple_description_i18n/cn","每当满足指定的秩序所需的条件时，获得护盾。"],["/skills/2/simple_description_i18n/kr","지정한 질서에 필요한 조건을 충족할 때마다 실드를 획득한다."],["/skills/2/variants/0/description_i18n/cn","若秩序钟形态为“<sprite name=\"spui_oldgod_icon_1\">禁咒”，每当敌人释放终极技能时，顿里尔获得可以抵御130% + 20% ATK伤害的护盾，持续到战斗结束；若秩序钟形态为“<sprite name=\"spui_oldgod_icon_2\">抑生”，每当自身累计损失20%最大生命值时，获得可以抵御130% + 20% ATK伤害的护盾，持续到战斗结束。"],["/skills/2/variants/0/description_i18n/kr","질서의 종 형태가 <sprite name=\"spui_oldgod_icon_1\">주문 봉인일 시, 적이 궁극기를 시전할 때마다 던릴은 130% + 20% ATK의 대미지를 막을 수 있는 실드를 전투가 끝날 때까지 획득한다. 질서의 종 형태가 <sprite name=\"spui_oldgod_icon_2\">치유 억제일 시, 던릴은 잃은 누적 최대 HP가 20%에 도달할 때마다 130% + 20% ATK의 대미지를 막을 수 있는 실드를 전투가 끝날 때까지 획득한다."],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":71,"end":77,"power_type":"skill","parameter":"SArg0"},{"start":169,"end":175,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_power_spans_i18n/kr",[{"start":78,"end":84,"power_type":"skill","parameter":"SArg0"},{"start":212,"end":218,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":67,"end":81,"tooltip_key":"stat:ATK"},{"start":165,"end":179,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/kr",[{"start":74,"end":88,"tooltip_key":"stat:ATK"},{"start":208,"end":222,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","护盾抵御的伤害提升至140% + 20% ATK。"],["/skills/2/variants/1/description_i18n/kr","실드로 막는 대미지가 140% + 20% ATK까지 증가한다."],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":14,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_power_spans_i18n/kr",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":10,"end":24,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/kr",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","护盾抵御的伤害提升至150% + 20% ATK。"],["/skills/2/variants/2/description_i18n/kr","실드로 막는 대미지가 150% + 20% ATK까지 증가한다."],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":14,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_power_spans_i18n/kr",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":10,"end":24,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/kr",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","护盾抵御的伤害提升至160% + 20% ATK。"],["/skills/2/variants/3/description_i18n/kr","실드로 막는 대미지가 160% + 20% ATK까지 증가한다."],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":14,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_power_spans_i18n/kr",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":10,"end":24,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/kr",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/kr","영웅 마스터리"],["/skills/3/simple_description_i18n/cn","自身受到的伤害降低。"],["/skills/3/simple_description_i18n/kr","자신이 받는 대미지가 감소한다."],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的受到的伤害降低10%，秩序生效期间，自身受到的伤害额外降低5%。"],["/skills/3/variants/0/description_i18n/kr","전투 중, 자신이 받는 대미지가 10% 감소하고, 질서 적용 중에 자신이 받는 대미지가 추가로 5% 감소한다."],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的受到的伤害降低12%，秩序生效期间，自身受到的伤害额外降低6%。"],["/skills/3/variants/1/description_i18n/kr","전투 중, 자신이 받는 대미지가 12% 감소하고, 질서 적용 중에 자신이 받는 대미지가 추가로 6% 감소한다."],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的受到的伤害降低16%，秩序生效期间，自身受到的伤害额外降低8%。"],["/skills/3/variants/2/description_i18n/kr","전투 중, 자신이 받는 대미지가 16% 감소하고, 질서 적용 중에 자신이 받는 대미지가 추가로 8% 감소한다."],["/skills/4/name_i18n/cn","赦免之声"],["/skills/4/name_i18n/kr","관용의 소리"],["/skills/4/simple_description_i18n/cn","使得最远的一名友军不受到秩序的约束。"],["/skills/4/simple_description_i18n/kr","가장 멀리 있는 아군 1명이 질서의 제약을 받지 않는다."],["/skills/4/variants/0/description_i18n/cn","顿里尔庇佑备战时离自身距离最远的非召唤物友军，使其不受到自身秩序的约束，直至其被击败。"],["/skills/4/variants/0/description_i18n/kr","전투 준비 시, 던릴이 자신으로부터 가장 멀리 떨어진 소환물이 아닌 아군에게 처치당할 때까지 질서의 제약을 받지 않도록 가호를 내린다."],["/skills/4/variants/1/description_i18n/cn","庇佑的角色攻击力提高2%。"],["/skills/4/variants/1/description_i18n/kr","가호를 받은 유닛의 공격력이 2% 증가한다."],["/skills/4/variants/2/description_i18n/cn","庇佑的角色攻击力提高4%。"],["/skills/4/variants/2/description_i18n/kr","가호를 받은 유닛의 공격력이 4% 증가한다."],["/skills/4/variants/3/description_i18n/cn","庇佑的角色急速提高20点。"],["/skills/4/variants/3/description_i18n/kr","가호를 받은 유닛의 급속이 20 증가한다."],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/kr","각성의 힘"],["/skills/5/simple_description_i18n/cn","主动释放终极技能时，为友军提升攻击速度或生命汲取。"],["/skills/5/simple_description_i18n/kr","액티브로 궁극기 사용 시, 아군의 공격 속도 또는 생명 흡수가 증가한다."],["/skills/5/variants/0/description_i18n/cn","主动使用终极技能时，若宣告“<sprite name=\"spui_oldgod_icon_1\">禁咒”秩序，还会使所有友军获得50点攻击速度，持续6秒；若宣告“<sprite name=\"spui_oldgod_icon_2\">抑生”秩序，还会使所有友军获得25点生命汲取，持续6秒。"],["/skills/5/variants/0/description_i18n/kr","액티브로 궁극기 사용 시, <sprite name=\"spui_oldgod_icon_1\">주문 봉인 질서를 선고했을 경우, 모든 아군이 6초 동안 공격 속도를 50 획득하고, <sprite name=\"spui_oldgod_icon_2\">치유 억제 질서를 선고했을 경우, 모든 아군이 6초 동안 생명 흡수를 25 획득한다."],["/skills/5/variants/1/description_i18n/cn","每当秩序结束或被刷新时长时，若自身依然存活，则根据秩序钟形态触发额外效果：\n“<sprite name=\"spui_oldgod_icon_1\">禁咒”：所有敌人失去150点能量，并降低10点急速，持续8秒。\n“<sprite name=\"spui_oldgod_icon_2\">抑生”：所有敌人失去150% ATK生命值，并降低50点受愈，持续8秒。"],["/skills/5/variants/1/description_i18n/kr","질서 효과가 종료되거나 시간이 갱신될 때마다, 자신이 생존해 있을 시 질서의 종 형태의 추가 효과가 발동된다.\n<sprite name=\"spui_oldgod_icon_1\">주문 봉인: 모든 적군이 150의 에너지를 잃고 8초 동안 급속이 10 감소한다.\n<sprite name=\"spui_oldgod_icon_2\">치유 억제: 모든 적군이 150% ATK의 HP를 잃고 8초 동안 활력이 50 감소한다."],["/skills/5/variants/1/description_tooltip_spans_i18n/cn",[{"start":150,"end":158,"tooltip_key":"stat:ATK"}]],["/skills/5/variants/1/description_tooltip_spans_i18n/kr",[{"start":190,"end":198,"tooltip_key":"stat:ATK"}]],["/exclusive_equipment/name_i18n/cn","旭辉洪钟"],["/exclusive_equipment/name_i18n/kr","빛나는 종"]]}