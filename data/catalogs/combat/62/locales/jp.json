io"}]],["/skills/0/variants/4/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"ultimate","parameter":"PlusRatio"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","声若洪钟"],["/skills/1/name_i18n/jp","鐘の轟音"],["/skills/1/simple_description_i18n/cn","对面前的敌人造成伤害，并根据指定的秩序附带额外的效果。"],["/skills/1/simple_description_i18n/jp","前方の敵にダメージを与え、秩序の鐘の形態に応じた追加効果を与える"],["/skills/1/variants/0/description_i18n/cn","发射音波，对面前3格宽、3格长的区域的敌人造成4段40% + 5% ATK伤害，秩序钟形态为“<sprite name=\"spui_oldgod_icon_1\">禁咒”时，额外降低敌人60点攻击速度，持续4秒；秩序钟形态为“<sprite name=\"spui_oldgod_icon_2\">抑生”时，额外附带敌人已损失生命值3%的伤害，该伤害最高不超过自身30%攻击力。"],["/skills/1/variants/0/description_i18n/jp","音波を放ち、前方3×3マス範囲内の敵に40% + 5% ATKのダメージを4回与える。秩序の鐘の形態が「<sprite name=\"spui_oldgod_icon_1\">禁呪」の場合はさらに4秒間、対象の攻撃速度-60、「<sprite name=\"spui_oldgod_icon_2\">抑制」の場合は追加でそれぞれのHP減少量×3%のダメージを与える。追加ダメージはドレアルの攻撃力×30%を超えない"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":28,"end":33,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":22,"end":27,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":25,"end":37,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":19,"end":31,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","伤害提升至45% + 5% ATK。"],["/skills/1/variants/1/description_i18n/jp","ダメージが45% + 5% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","伤害提升至50% + 5% ATK。"],["/skills/1/variants/2/description_i18n/jp","ダメージが50% + 5% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","伤害提升至55% + 5% ATK。"],["/skills/1/variants/3/description_i18n/jp","ダメージが55% + 5% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":8,"end":13,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","守护音壁"],["/skills/2/name_i18n/jp","音壁の守り"],["/skills/2/simple_description_i18n/cn","每当满足指定的秩序所需的条件时，获得护盾。"],["/skills/2/simple_description_i18n/jp","秩序の鐘の形態に応じた条件を満たすたびに、シールドを獲得"],["/skills/2/variants/0/description_i18n/cn","若秩序钟形态为“<sprite name=\"spui_oldgod_icon_1\">禁咒”，每当敌人释放终极技能时，顿里尔获得可以抵御130% + 20% ATK伤害的护盾，持续到战斗结束；若秩序钟形态为“<sprite name=\"spui_oldgod_icon_2\">抑生”，每当自身累计损失20%最大生命值时，获得可以抵御130% + 20% ATK伤害的护盾，持续到战斗结束。"],["/skills/2/variants/0/description_i18n/jp","秩序の鐘の形態が「<sprite name=\"spui_oldgod_icon_1\">禁呪」の場合、敵が必殺技を発動するたびに、ドレアルは130% + 20% ATK分のシールドを永続的に獲得。秩序の鐘の形態が「<sprite name=\"spui_oldgod_icon_2\">抑制」の場合、ドレアルが合計HP上限×20%のHPを失うたびに、130% + 20% ATK分の永続シールドを獲得"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":71,"end":77,"power_type":"skill","parameter":"SArg0"},{"start":169,"end":175,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":73,"end":79,"power_type":"skill","parameter":"SArg0"},{"start":176,"end":182,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":67,"end":81,"tooltip_key":"stat:ATK"},{"start":165,"end":179,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":69,"end":83,"tooltip_key":"stat:ATK"},{"start":172,"end":186,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","护盾抵御的伤害提升至140% + 20% ATK。"],["/skills/2/variants/1/description_i18n/jp","シールドで防げるダメージ量が140% + 20% ATKにUP"],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":14,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_power_spans_i18n/jp",[{"start":18,"end":24,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":10,"end":24,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/jp",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","护盾抵御的伤害提升至150% + 20% ATK。"],["/skills/2/variants/2/description_i18n/jp","シールドで防げるダメージ量が150% + 20% ATKにUP"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":14,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":18,"end":24,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":10,"end":24,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/jp",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","护盾抵御的伤害提升至160% + 20% ATK。"],["/skills/2/variants/3/description_i18n/jp","シールドで防げるダメージ量が160% + 20% ATKにUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":14,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":18,"end":24,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":10,"end":24,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/jp",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","自身受到的伤害降低。"],["/skills/3/simple_description_i18n/jp","自身の被ダメージDOWN"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的受到的伤害降低10%，秩序生效期间，自身受到的伤害额外降低5%。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身の被ダメージ-10%。秩序効果持続中の場合、追加で自身の被ダメージ-5%"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的受到的伤害降低12%，秩序生效期间，自身受到的伤害额外降低6%。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身の被ダメージ-12%。秩序効果持続中の場合、追加で自身の被ダメージ-6%"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的受到的伤害降低16%，秩序生效期间，自身受到的伤害额外降低8%。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身の被ダメージ-16%。秩序効果持続中の場合、追加で自身の被ダメージ-8%"],["/skills/4/name_i18n/cn","赦免之声"],["/skills/4/name_i18n/jp","赦免の音"],["/skills/4/simple_description_i18n/cn","使得最远的一名友军不受到秩序的约束。"],["/skills/4/simple_description_i18n/jp","最も遠い味方1体が秩序による制限を受けなくなる"],["/skills/4/variants/0/description_i18n/cn","顿里尔庇佑备战时离自身距离最远的非召唤物友军，使其不受到自身秩序的约束，直至其被击败。"],["/skills/4/variants/0/description_i18n/jp","ドレアルは戦闘準備時に自身から最も遠い召喚ユニット以外の味方に庇護を与え、撃破されるまでの間、秩序による制限を受けないようにする"],["/skills/4/variants/1/description_i18n/cn","庇佑的角色攻击力提高2%。"],["/skills/4/variants/1/description_i18n/jp","庇護を受けた味方の攻撃力+2%"],["/skills/4/variants/2/description_i18n/cn","庇佑的角色攻击力提高4%。"],["/skills/4/variants/2/description_i18n/jp","庇護を受けた味方の攻撃力+4%"],["/skills/4/variants/3/description_i18n/cn","庇佑的角色急速提高20点。"],["/skills/4/variants/3/description_i18n/jp","庇護を受けた味方の速度+20"],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","主动释放终极技能时，为友军提升攻击速度或生命汲取。"],["/skills/5/simple_description_i18n/jp","必殺技をアクティブで発動する時、味方の攻撃速度かライフスティールがUP"],["/skills/5/variants/0/description_i18n/cn","主动使用终极技能时，若宣告“<sprite name=\"spui_oldgod_icon_1\">禁咒”秩序，还会使所有友军获得50点攻击速度，持续6秒；若宣告“<sprite name=\"spui_oldgod_icon_2\">抑生”秩序，还会使所有友军获得25点生命汲取，持续6秒。"],["/skills/5/variants/0/description_i18n/jp","必殺技をアクティブで発動する時、「<sprite name=\"spui_oldgod_icon_1\">禁呪」を宣告した場合はさらに6秒間、味方全体の攻撃速度+50、「<sprite name=\"spui_oldgod_icon_2\">抑制」を宣告した場合はさらに6秒間、味方全体のライフスティール+25"],["/skills/5/variants/1/description_i18n/cn","每当秩序结束或被刷新时长时，若自身依然存活，则根据秩序钟形态触发额外效果：\n“<sprite name=\"spui_oldgod_icon_1\">禁咒”：所有敌人失去150点能量，并降低10点急速，持续8秒。\n“<sprite name=\"spui_oldgod_icon_2\">抑生”：所有敌人失去150% ATK生命值，并降低50点受愈，持续8秒。"],["/skills/5/variants/1/description_i18n/jp","秩序が終了する時、または秩序の持続時間が更新された時に自身が生存している場合、秩序の鐘の形態に応じて追加効果を発動：\n「<sprite name=\"spui_oldgod_icon_1\">禁呪」：敵全体のSPが150減少し、8秒間、速度-10\n「<sprite name=\"spui_oldgod_icon_2\">抑制」：敵全体のHPが150% ATK分減少し、8秒間、治癒-50"],["/skills/5/variants/1/description_tooltip_spans_i18n/cn",[{"start":150,"end":158,"tooltip_key":"stat:ATK"}]],["/skills/5/variants/1/description_tooltip_spans_i18n/jp",[{"start":168,"end":176,"tooltip_key":"stat:ATK"}]],["/exclusive_equipment/name_i18n/cn","旭辉洪钟"],["/exclusive_equipment/name_i18n/jp","旭日の鐘"]]}