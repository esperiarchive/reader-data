/4/variants/3/description_power_spans_i18n/cn",[{"start":19,"end":25,"power_type":"skill","parameter":"PlusRatio"},{"start":47,"end":53,"power_type":"skill","parameter":"SArg1"}]],["/skills/4/variants/3/description_power_spans_i18n/en",[{"start":38,"end":44,"power_type":"skill","parameter":"PlusRatio"},{"start":71,"end":77,"power_type":"skill","parameter":"SArg1"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/cn",[{"start":15,"end":29,"tooltip_key":"stat:ATK"},{"start":43,"end":57,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/en",[{"start":34,"end":48,"tooltip_key":"stat:ATK"},{"start":67,"end":81,"tooltip_key":"stat:ATK"}]],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/en","Enhance Force"],["/skills/5/simple_description_i18n/cn","技能“灼骨烈焰”时间延长。"],["/skills/5/simple_description_i18n/en","Mirael increases the burning duration of Bone Sear."],["/skills/5/variants/0/description_i18n/cn","技能“灼骨烈焰”造成点燃的持续时间延长4秒。"],["/skills/5/variants/0/description_i18n/en","Mirael increases the burning duration of Bone Sear by 4s."],["/skills/5/variants/1/description_i18n/cn","技能“灼骨烈焰”的冷却时间提升12秒，烧伤的敌人数量增加3个，并在释放后还会使自身提升300点攻击速度，持续18秒。"],["/skills/5/variants/1/description_i18n/en","Increases Bone Sear's cooldown by 12s and the number of enemies it burns by 3. Bone Sear also increases Mirael's ATK SPD by 300 for 18s."],["/exclusive_equipment/name_i18n/cn","业火黑梦"],["/exclusive_equipment/name_i18n/en","Sinner's Nightmare"]]}