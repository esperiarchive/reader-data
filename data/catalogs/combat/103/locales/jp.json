ter":"PlusRatio"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","伤害提升至360% + 40% ATK。"],["/skills/2/variants/2/description_i18n/jp","ダメージが360% + 40% ATKにUP"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","伤害提升至390% + 40% ATK。"],["/skills/2/variants/3/description_i18n/jp","ダメージが390% + 40% ATKにUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提升自身暴击，叠加裂伤可进一步增加暴击。"],["/skills/3/simple_description_i18n/jp","自身のクリティカルUP。敵に一定量の切創を付与した後、追加で自身のクリティカルUP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的暴击提高24点，自身累计对敌方叠加15层裂伤后，额外提升12点暴击。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身のクリティカル+24。自身が敵に合計15スタックの切創を付与した後、追加で自身のクリティカル+12"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的暴击提高30点，自身累计对敌方叠加15层裂伤后，额外提升15点暴击。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身のクリティカル+30。自身が敵に合計15スタックの切創を付与した後、追加で自身のクリティカル+15"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的暴击提高36点，自身累计对敌方叠加15层裂伤后，额外提升18点暴击。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身のクリティカル+36。自身が敵に合計15スタックの切創を付与した後、追加で自身のクリティカル+18"],["/skills/4/name_i18n/cn","索敌碎击"],["/skills/4/name_i18n/jp","囲い狩り"],["/skills/4/simple_description_i18n/cn","友方角色对狩猎对象造成伤害时也会叠加裂伤。"],["/skills/4/simple_description_i18n/jp","味方キャラクターが狩猟対象にクリティカルダメージを与えた時にも、切創を付与"],["/skills/4/variants/0/description_i18n/cn","那非的“狩猎对象”抗暴击降低16点，并且当其他友方角色对“狩猎对象”造成暴击时，也会对其叠加1层裂伤，每名友军每秒最多通过此种方式叠加1层。"],["/skills/4/variants/0/description_i18n/jp","「狩猟対象」のクリティカル抵抗-16。自身以外の味方キャラクターが「狩猟対象」にクリティカルダメージを与えた時、対象に切創を1スタック付与。毎秒、「狩猟対象」に付与できる切創は味方1体につき、1スタックまで重複可能"],["/skills/4/variants/1/description_i18n/cn","“狩猎对象”的抗暴击降低24点。"],["/skills/4/variants/1/description_i18n/jp","「狩猟対象」のクリティカル抵抗減少量が24にUP"],["/skills/4/variants/2/description_i18n/cn","“狩猎对象”身上的裂伤不低于15层时，受愈降低50点，受到伤害增加12%。"],["/skills/4/variants/2/description_i18n/jp","「狩猟対象」が持つ切創が15スタック以上の場合、さらに対象の治癒-50、被ダメージ+12%"],["/skills/4/variants/3/description_i18n/cn","“狩猎对象”的抗暴击降低32点。"],["/skills/4/variants/3/description_i18n/jp","「狩猟対象」のクリティカル抵抗減少量が32にUP"],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","造成暴击时，提升此次伤害的暴击增幅。"],["/skills/5/simple_description_i18n/jp","自身がクリティカルダメージを与える時のクリティカル増幅UP"],["/skills/5/variants/0/description_i18n/cn","每当那非造成暴击伤害时，自身每1%的暴击率会使本次伤害额外提高0.8点暴击增幅。"],["/skills/5/variants/0/description_i18n/jp","自身がクリティカルダメージを与える時、自身のクリティカル率1%につき、そのダメージのクリティカル増幅+0.8"],["/exclusive_equipment/name_i18n/cn","追踪投矛"],["/exclusive_equipment/name_i18n/jp","追尾の投げ槍"]]}