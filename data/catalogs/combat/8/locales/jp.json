l","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":19,"end":33,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","伤害提升至165% + 15% ATK。"],["/skills/1/variants/1/description_i18n/jp","ダメージが165% + 15% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","伤害提升至175% + 15% ATK。"],["/skills/1/variants/2/description_i18n/jp","ダメージが175% + 15% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","伤害提升至185% + 15% ATK。"],["/skills/1/variants/3/description_i18n/jp","ダメージが185% + 15% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","妖术雪球"],["/skills/2/name_i18n/jp","妖術の雪玉"],["/skills/2/simple_description_i18n/cn","总是会召唤雪球围绕自身，敌人被控制时，雪球会自动攻击造成伤害。"],["/skills/2/simple_description_i18n/jp","自身の周囲に雪玉を生成。雪玉は行動阻害状態の敵を自動で攻撃し、ダメージを与える"],["/skills/2/variants/0/description_i18n/cn","制造4个雪球围绕自身，每过3秒自动发射一枚雪球攻击目标。另外，当有敌人处于控制状态下，雪球会自动攻击该目标造成130% + 10% ATK伤害，每个敌人受到雪球的攻击有2.5秒间隔。当雪球全部使用后，卡列琳娜会再次制造雪球。"],["/skills/2/variants/0/description_i18n/jp","自身の周囲に雪玉を4個生成する。雪玉は3秒ごとに1回攻撃。行動阻害状態の敵がいる場合、雪玉は直ちにその敵を攻撃し、130% + 10% ATKのダメージを与える。雪玉による攻撃は、敵1体につき、2.5秒ごとに1回まで発動可能。雪玉がなくなると、カレリーナは再び雪玉を生成する"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":59,"end":65,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":61,"end":67,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":55,"end":69,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":57,"end":71,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","伤害提升至140% + 10% ATK。"],["/skills/2/variants/1/description_i18n/jp","ダメージが140% + 10% ATKにUP"],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","伤害提升至150% + 10% ATK。"],["/skills/2/variants/2/description_i18n/jp","ダメージが150% + 10% ATKにUP"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","每个敌人受到雪球攻击最短间隔缩短至1.5秒。"],["/skills/2/variants/3/description_i18n/jp","自動攻撃は敵1体につき、1.5秒ごとに1回まで発動可能"],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提高自身暴击，当使用多次“妖术雪球”后进一步提升暴击。"],["/skills/3/simple_description_i18n/jp","自身のクリティカルUP。「妖術の雪玉」を複数回発動している場合、追加で自身のクリティカルUP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身提高14点暴击，且当使用5次“妖术雪球”后，额外提升18点暴击。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身のクリティカル+14。「妖術の雪玉」を5回発動している場合、追加で自身のクリティカル+18"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身提高19点暴击，且当使用5次“妖术雪球”后，额外提升24点暴击。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身のクリティカル+19。「妖術の雪玉」を5回発動している場合、追加で自身のクリティカル+24"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身提高24点暴击，且当使用5次“妖术雪球”后，额外提升30点暴击。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身のクリティカル+24。「妖術の雪玉」を5回発動している場合、追加で自身のクリティカル+30"],["/skills/4/name_i18n/cn","冰寒漩涡"],["/skills/4/name_i18n/jp","氷の渦"],["/skills/4/simple_description_i18n/cn","妖术雪球会造成更高伤害，可造成范围伤害并降低魔法抗性。"],["/skills/4/simple_description_i18n/jp","「妖術の雪玉」のダメージUP。範囲ダメージを与え、魔法防御をDOWNさせる"],["/skills/4/variants/0/description_i18n/cn","卡列琳娜每次使用“妖术雪球”，会永久提升雪球10%伤害，至多提升7次。从第三次使用“妖术雪球”开始，新雪球会造成1格范围的范围伤害并额外降低敌人15%的魔抗，持续6秒。"],["/skills/4/variants/0/description_i18n/jp","「妖術の雪玉」を発動するたびに、永続的に雪玉のダメージ+10%、最大7スタック。3回目以後の「妖術の雪玉」は1マスの範囲ダメージを与えるようになり、さらに6秒間敵の魔法防御-15%"],["/skills/4/variants/1/description_i18n/cn","卡列琳娜的普通攻击攻击被控制的敌人时，使1枚雪球攻击该敌人。"],["/skills/4/variants/1/description_i18n/jp","行動阻害を受けている敵を通常攻撃で攻撃する時、対象に雪玉を1つ発射する"],["/skills/4/variants/2/description_i18n/cn","降低魔抗的效果提升至25%。"],["/skills/4/variants/2/description_i18n/jp","魔法防御減少量が25%にUP"],["/skills/4/variants/3/description_i18n/cn","降低魔抗的效果提升至30%。"],["/skills/4/variants/3/description_i18n/jp","魔法防御減少量が30%にUP"],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","“妖术雪球”造成伤害时也会施加“霜冻”。"],["/skills/5/simple_description_i18n/jp","「妖術の雪玉」でダメージを与えた時、対象に「凍傷」を付与"],["/skills/5/variants/0/description_i18n/cn","技能“妖术雪球”的雪球造成伤害时也会施加“霜冻”。"],["/skills/5/variants/0/description_i18n/jp","「妖術の雪玉」の雪玉がダメージを与えた時、対象に「凍傷」を付与"],["/exclusive_equipment/name_i18n/cn","拉季诺夫家族烛台"],["/exclusive_equipment/name_i18n/jp","ラジノフ家の燭台"]]}