":"ultimate","parameter":"SArg9"}]],["/skills/0/variants/3/description_tooltip_spans_i18n/cn",[{"start":13,"end":25,"tooltip_key":"stat:ATK"},{"start":41,"end":55,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/3/description_tooltip_spans_i18n/en",[{"start":50,"end":62,"tooltip_key":"stat:ATK"},{"start":111,"end":125,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_i18n/cn","鲜血法阵每秒造成伤害提升至80% + 8% ATK，法阵结束时造成的真实伤害提升至400% + 40% ATK。"],["/skills/0/variants/4/description_i18n/en","Increases the blood circle's damage per second to 80% + 8% ATK and the true damage it deals when it expires to 400% + 40% ATK."],["/skills/0/variants/4/description_power_spans_i18n/cn",[{"start":16,"end":21,"power_type":"ultimate","parameter":"PlusRatio"},{"start":45,"end":51,"power_type":"ultimate","parameter":"SArg9"}]],["/skills/0/variants/4/description_power_spans_i18n/en",[{"start":53,"end":58,"power_type":"ultimate","parameter":"PlusRatio"},{"start":115,"end":121,"power_type":"ultimate","parameter":"SArg9"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/cn",[{"start":13,"end":25,"tooltip_key":"stat:ATK"},{"start":41,"end":55,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/en",[{"start":50,"end":62,"tooltip_key":"stat:ATK"},{"start":111,"end":125,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","血蝠之唤"],["/skills/1/name_i18n/en","Bloodbat Swarm"],["/skills/1/simple_description_i18n/cn","在“眷属”身周召唤蝙蝠群造成伤害。"],["/skills/1/simple_description_i18n/en","Tephesia summons a swarm of bats around the thrall to damage nearby enemies."],["/skills/1/variants/0/description_i18n/cn","苔佩希消耗当前生命的8%，在“眷属”身周召唤蝙蝠群，对周围2格的敌人造成240% + 30% ATK伤害，之后蝙蝠会在敌人身上寄生5秒，每秒造成48% + 6% ATK伤害。"],["/skills/1/variants/0/description_i18n/en","Tephesia sacrifices 8% of her current HP to summon a swarm of bats around her thrall, dealing 240% + 30% ATK damage to enemies within 2 tiles. The bats then latch on to those enemies for 5s, dealing 48% + 6% ATK damage per second."],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":40,"end":46,"power_type":"skill","parameter":"PlusRatio"},{"start":75,"end":80,"power_type":"skill","parameter":"SArg2"}]],["/skills/1/variants/0/description_power_spans_i18n/en",[{"start":98,"end":104,"power_type":"skill","parameter":"PlusRatio"},{"start":202,"end":207,"power_type":"skill","parameter":"SArg2"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":36,"end":50,"tooltip_key":"stat:ATK"},{"start":72,"end":84,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/en",[{"start":94,"end":108,"tooltip_key":"stat:ATK"},{"start":199,"end":211,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","蝙蝠群伤害提升至260% + 30% ATK，寄生伤害提升至每秒52% + 6% ATK。"],["/skills/1/variants/1/description_i18n/en","Increases the bat swarm's initial damage to 260% + 30% ATK. Once the bats latch on, they deal 52% + 6% ATK damage per second."],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":12,"end":18,"power_type":"skill","parameter":"PlusRatio"},{"start":35,"end":40,"power_type":"skill","parameter":"SArg2"}]],["/skills/1/variants/1/description_power_spans_i18n/en",[{"start":48,"end":54,"power_type":"skill","parameter":"PlusRatio"},{"start":97,"end":102,"power_type":"skill","parameter":"SArg2"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":8,"end":22,"tooltip_key":"stat:ATK"},{"start":32,"end":44,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/en",[{"start":44,"end":58,"tooltip_key":"stat:ATK"},{"start":94,"end":106,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","蝙蝠群伤害提升至280% + 30% ATK，寄生伤害提升至每秒56% + 6% ATK。"],["/skills/1/variants/2/description_i18n/en","Increases the bat swarm's initial damage to 280% + 30% ATK. Once the bats latch on, they deal 56% + 6% ATK damage per second."],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":12,"end":18,"power_type":"skill","parameter":"PlusRatio"},{"start":35,"end":40,"power_type":"skill","parameter":"SArg2"}]],["/skills/1/variants/2/description_power_spans_i18n/en",[{"start":48,"end":54,"power_type":"skill","parameter":"PlusRatio"},{"start":97,"end":102,"power_type":"skill","parameter":"SArg2"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":8,"end":22,"tooltip_key":"stat:ATK"},{"start":32,"end":44,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/en",[{"start":44,"end":58,"tooltip_key":"stat:ATK"},{"start":94,"end":106,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","蝙蝠群伤害提升至300% + 30% ATK，寄生伤害提升至每秒60% + 6% ATK。"],["/skills/1/variants/3/description_i18n/en","Increases the bat swarm's initial damage to 300% + 30% ATK. Once the bats latch on, they deal 60% + 6% ATK damage per second."],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":12,"end":18,"power_type":"skill","parameter":"PlusRatio"},{"start":35,"end":40,"power_type":"skill","parameter":"SArg2"}]],["/skills/1/variants/3/description_power_spans_i18n/en",[{"start":48,"end":54,"power_type":"skill","parameter":"PlusRatio"},{"start":97,"end":102,"power_type":"skill","parameter":"SArg2"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":8,"end":22,"tooltip_key":"stat:ATK"},{"start":32,"end":44,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/en",[{"start":44,"end":58,"tooltip_key":"stat:ATK"},{"start":94,"end":106,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","怠惰烙印"],["/skills/2/name_i18n/en","Dilapidating Languor"],["/skills/2/simple_description_i18n/cn","对“眷属”输出伤害最多的敌人施加“怠惰徽记”，造成伤害并降低其急速。"],["/skills/2/simple_description_i18n/en","Tephesia places the Mark of Languor on the enemy who has dealt the most damage to the thrall, dealing damage and reducing the enemy's Haste."],["/skills/2/variants/0/description_i18n/cn","苔佩希选择对“眷属”累计输出最高的敌方英雄施加“怠惰徽记”，对其造成300% + 40% ATK的伤害并使其在接下来6秒内降低90点急速、50%的攻击力和50%的移动速度。"],["/skills/2/variants/0/description_i18n/en","Tephesia places the Mark of Languor on the enemy hero who has dealt the most damage to her thrall, dealing 300% + 40% ATK damage. For 6s, the target loses 90 Haste, 50% ATK, and 50% movement speed."],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":38,"end":44,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_power_spans_i18n/en",[{"start":111,"end":117,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":34,"end":48,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/en",[{"start":107,"end":121,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","伤害提升至330% + 40% ATK。"],["/skills/2/variants/1/description_i18n/en","Increases damage to 330% + 40% ATK."],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_power_spans_i18n/en",[{"start":24,"end":30,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/en",[{"start":20,"end":34,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","伤害提升至360% + 40% ATK。"],["/skills/2/variants/2/description_i18n/en","Increases damage to 360% + 40% ATK."],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_power_spans_i18n/en",[{"start":24,"end":30,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/en",[{"start":20,"end":34,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","伤害提升至390% + 40% ATK。"],["/skills/2/variants/3/description_i18n/en","Increases damage to 390% + 40% ATK."],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_power_spans_i18n/en",[{"start":24,"end":30,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/en",[{"start":20,"end":34,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/en","Hero Focus"],["/skills/3/simple_description_i18n/cn","战斗中提高攻击力，“眷属”生命值高于一定比例时额外提高攻击力。"],["/skills/3/simple_description_i18n/en","Tephesia increases her ATK during battle, with a further increase while her thrall's HP ratio is high enough."],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的攻击力提高9%，当“眷属”生命值比例不低于60%时，额外提升6%的攻击力。"],["/skills/3/variants/0/description_i18n/en","Tephesia gains 9% ATK during battle. When her thrall's HP ratio is at or above 60%, she gains an extra 6% ATK."],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的攻击力提高12%，当“眷属”生命值比例不低于60%时，额外提升8%的攻击力。"],["/skills/3/variants/1/description_i18n/en","Tephesia gains 12% ATK during battle. When her thrall's HP ratio is at or above 60%, she gains an extra 8% ATK."],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的攻击力提高15%，当“眷属”生命值比例不低于60%时，额外提升10%的攻击力。"],["/skills/3/variants/2/description_i18n/en","Tephesia gains 15% ATK during battle. When her thrall's HP ratio is at or above 60%, she gains an extra 10% ATK."],["/skills/4/name_i18n/cn","引血为奉"],["/skills/4/name_i18n/en","Blood Tribute"],["/skills/4/simple_description_i18n/cn","“鲜血法阵”额外生成血珠，并且生成血珠时回复一定生命值。"],["/skills/4/simple_description_i18n/en","The blood circle generates extra blood orbs. Each orb restores HP to Tephesia and her thrall."],["/skills/4/variants/0/description_i18n/cn","展开“鲜血法阵”时，会在最初的3秒内额外生成3颗血珠。每次生成血珠时，眷属和苔佩希回复相当于苔佩希200% ATK的生命值。"],["/skills/4/variants/0/description_i18n/en","In the first 3s after a blood circle is deployed, it generates 3 extra blood orbs. Whenever an orb is generated, Tephesia and her thrall each recover HP equal to 200% ATK of Tephesia's ATK."],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":49,"end":57,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/en",[{"start":162,"end":170,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_i18n/cn","每次生成血珠时的回复量提升至250% ATK。"],["/skills/4/variants/1/description_i18n/en","Increases the healing each time a blood orb is generated to 250% ATK."],["/skills/4/variants/1/description_tooltip_spans_i18n/cn",[{"start":14,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_tooltip_spans_i18n/en",[{"start":60,"end":68,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/2/description_i18n/cn","苔佩希会为眷属赋予永久的霸体状态，眷属在“鲜血渴望”状态下参与击败敌方非召唤物时，会立即回复40% HP生命值。"],["/skills/4/variants/2/description_i18n/en","Tephesia makes her thrall permanently unaffected. Whenever the thrall assists or defeats a non-summoned enemy while in Bloodlust state, it immediately recovers 40% HP HP."],["/skills/4/variants/2/description_tooltip_spans_i18n/cn",[{"start":12,"end":14,"tooltip_key":"keyword:uncontrol"},{"start":29,"end":33,"tooltip_key":"keyword:takedown"},{"start":46,"end":52,"tooltip_key":"stat:HP"}]],["/skills/4/variants/2/description_tooltip_spans_i18n/en",[{"start":38,"end":48,"tooltip_key":"keyword:uncontrol"},{"start":70,"end":88,"tooltip_key":"keyword:takedown"},{"start":160,"end":166,"tooltip_key":"stat:HP"}]],["/skills/4/variants/3/description_i18n/cn","每次生成血珠时的回复量提升至300% ATK。"],["/skills/4/variants/3/description_i18n/en","Increases the healing each time a blood orb is generated to 300% ATK."],["/skills/4/variants/3/description_tooltip_spans_i18n/cn",[{"start":14,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/en",[{"start":60,"end":68,"tooltip_key":"stat:ATK"}]],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/en","Enhance Force"],["/skills/5/simple_description_i18n/cn","“鲜血渴望”在满足击败或持续条件后永久持续，并提升眷属造成的伤害。"],["/skills/5/simple_description_i18n/en","Once it has assisted or defeated enough enemies or spent enough time in Bloodlust state, Bloodlust becomes permanent and the thrall deals more damage."],["/skills/5/variants/0/description_i18n/cn","当眷属在“鲜血渴望”状态下累计参与击败敌方非召唤物达到2次或累计处于“鲜血渴望”状态12秒后，该状态将永久持续。并且使眷属造成的伤害提升30%。"],["/skills/5/variants/0/description_i18n/en","Once the thrall assists or defeats a total of 2 non-summoned enemies during Bloodlust, or spends a total of 12s in Bloodlust state, Bloodlust becomes permanent and the thrall deals 30% more damage."],["/skills/5/variants/0/description_tooltip_spans_i18n/cn",[{"start":15,"end":19,"tooltip_key":"keyword:takedown"}]],["/skills/5/variants/0/description_tooltip_spans_i18n/en",[{"start":16,"end":34,"tooltip_key":"keyword:takedown"}]],["/exclusive_equipment/name_i18n/cn","遮月蝠翼伞"],["/exclusive_equipment/name_i18n/en","Nightwing Parasol"]]}