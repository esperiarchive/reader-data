ls/0/variants/4/description_tooltip_spans_i18n/kr",[{"start":22,"end":34,"tooltip_key":"stat:HP"}]],["/skills/1/name_i18n/cn","重压飞锤"],["/skills/1/name_i18n/kr","해머 프레셔"],["/skills/1/simple_description_i18n/cn","对目标造成多次伤害并击倒目标和其周围的敌人。"],["/skills/1/simple_description_i18n/kr","목표에게 여러 차례 대미지를 입히고 목표와 주변 적을 넘어뜨린다."],["/skills/1/variants/0/description_i18n/cn","挥动流星锤对目标造成2次160% ATK伤害，随后重锤地面，对前方矩形范围内的敌人造成150% + 20% ATK伤害并击倒。"],["/skills/1/variants/0/description_i18n/kr","스텔라 해머를 휘둘러 목표에게 160% ATK의 대미지를 2회 입힌다. 지면을 내리쳐 전방 직사각형 범위 내의 적에게 150% + 20% ATK의 대미지를 입히고 넘어뜨린다."],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":47,"end":53,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/0/description_power_spans_i18n/kr",[{"start":70,"end":76,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":12,"end":20,"tooltip_key":"stat:ATK"},{"start":43,"end":57,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/kr",[{"start":17,"end":25,"tooltip_key":"stat:ATK"},{"start":66,"end":80,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","最后一击造成的伤害提升至170% + 20% ATK。"],["/skills/1/variants/1/description_i18n/kr","마지막 일격 대미지가 170% + 20% ATK로 증가한다."],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/1/description_power_spans_i18n/kr",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/kr",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","最后一击造成的伤害提升至200% + 20% ATK。"],["/skills/1/variants/2/description_i18n/kr","마지막 일격 대미지가 200% + 20% ATK로 증가한다."],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/2/description_power_spans_i18n/kr",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/kr",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","最后一击造成的伤害提升至220% + 20% ATK。"],["/skills/1/variants/3/description_i18n/kr","마지막 일격 대미지가 220% + 20% ATK로 증가한다."],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/3/description_power_spans_i18n/kr",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/kr",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","不朽护葬"],["/skills/2/name_i18n/kr","불멸의 장례"],["/skills/2/simple_description_i18n/cn","将护盾所抵御的伤害积蓄为自身力量，积蓄达到一定值时，主动释放造成范围伤害。"],["/skills/2/simple_description_i18n/kr","실드로 막는 대미지를 힘으로 축적한다. 힘을 일정 이상 축적한 후 액티브로 시전해 광역 대미지를 입힌다."],["/skills/2/variants/0/description_i18n/cn","在战斗过程中，将自身护盾抵御的伤害值的25% + 1%积蓄为力量，主动使用时，将这个力量释放，对周围2格范围内的敌人造成等量的伤害。当积蓄的力量超过350% ATK时才会使用本技能，单次至多释放600% ATK力量，超过的部分将被保留至下一次释放。"],["/skills/2/variants/0/description_i18n/kr","전투 중 자신이 실드로 막 는 대미지의 25% + 1%를 힘으로 축적한다. \n액티브: 이 힘을 폭발시켜 주변 2칸 범위 내 적에게 같은 양의 대미지를 입히며, 축적된 힘이 350% ATK를 초과해야 해당 스킬을 사용할 수 있다. 1회 최대 600% ATK의 힘을 시전할 수 있으며 초과분은 다음 시전까지 유지된다."],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":22,"end":27,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_power_spans_i18n/kr",[{"start":25,"end":30,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":74,"end":82,"tooltip_key":"stat:ATK"},{"start":97,"end":105,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/kr",[{"start":96,"end":104,"tooltip_key":"stat:ATK"},{"start":134,"end":142,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","将自身护盾抵御的伤害值的28% + 1%积蓄为力量。"],["/skills/2/variants/1/description_i18n/kr","자신이 실드로 막는 대미지의 28% + 1%를 힘으로 축적한다."],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":15,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_power_spans_i18n/kr",[{"start":19,"end":24,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_i18n/cn","将自身护盾抵御的伤害值的31% + 1%积蓄为力量。"],["/skills/2/variants/2/description_i18n/kr","자신이 실드로 막는 대미지의 31% + 1%를 힘으로 축적한다."],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":15,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_power_spans_i18n/kr",[{"start":19,"end":24,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_i18n/cn","将自身护盾抵御的伤害值的35% + 1%积蓄为力量。"],["/skills/2/variants/3/description_i18n/kr","자신이 실드로 막는 대미지의 35% + 1%를 힘으로 축적한다."],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":15,"end":20,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_power_spans_i18n/kr",[{"start":19,"end":24,"power_type":"skill","parameter":"SArg0"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/kr","영웅 마스터리"],["/skills/3/simple_description_i18n/cn","提高自身受愈。"],["/skills/3/simple_description_i18n/kr","자신의 활력이 증가한다."],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的受愈提升11点。"],["/skills/3/variants/0/description_i18n/kr","전투 중, 자신의 활력이 11 증가한다."],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的受愈提升15点。"],["/skills/3/variants/1/description_i18n/kr","전투 중, 자신의 활력이 15 증가한다."],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的受愈提升19点。"],["/skills/3/variants/2/description_i18n/kr","전투 중, 자신의 활력이 19 증가한다."],["/skills/4/name_i18n/cn","怨怒暝眩"],["/skills/4/name_i18n/kr","원망의 황혼"],["/skills/4/simple_description_i18n/cn","每场战斗一次，当自身或友军生命值较低时，对周围敌人造成大量伤害和眩晕。"],["/skills/4/simple_description_i18n/kr","자신 또는 아군의 HP가 낮을 때, 주변 적에게 대량의 대미지를 입히고 스턴시킨다(해당 효과는 전투당 1회만 발동)."],["/skills/4/variants/0/description_i18n/cn","每场战斗仅释放一次，当自身或场上任意一名非召唤物友军的生命值低于30%时释放一次怒吼，对全体敌人造成8次50% ATK伤害和0.5秒眩晕。释放期间处于霸体状态。"],["/skills/4/variants/0/description_i18n/kr","전투마다 1회만 발동하며, 자신 또는 필드에 소환물이 아닌 임의 아군 1명의 HP가 30%보다 낮을 때, 분노에 찬 포효를 내질러 모든 적군에게 50% ATK의 대미지 8회를 입히고 0.5초간 스턴시킨다. 시전 중에는 제어 면역 효과가 된다."],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":52,"end":59,"tooltip_key":"stat:ATK"},{"start":75,"end":77,"tooltip_key":"keyword:uncontrol"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/kr",[{"start":81,"end":88,"tooltip_key":"stat:ATK"},{"start":122,"end":127,"tooltip_key":"keyword:uncontrol"}]],["/skills/4/variants/1/description_i18n/cn","伤害提升至60% ATK。"],["/skills/4/variants/1/description_i18n/kr","대미지가 60% ATK로 증가한다."],["/skills/4/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":12,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_tooltip_spans_i18n/kr",[{"start":5,"end":12,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/2/description_i18n/cn","眩晕时长提升至2秒。"],["/skills/4/variants/2/description_i18n/kr","스턴 시간이 2초로 증가한다."],["/skills/4/variants/3/description_i18n/cn","伤害提升至70% ATK。"],["/skills/4/variants/3/description_i18n/kr","대미지가 70% ATK로 증가한다."],["/skills/4/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":12,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/kr",[{"start":5,"end":12,"tooltip_key":"stat:ATK"}]],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/kr","각성의 힘"],["/skills/5/simple_description_i18n/cn","获得护盾时可以回复一定量生命值。"],["/skills/5/simple_description_i18n/kr","실드 획득 시 일정량의 HP를 회복한다. "],["/skills/5/variants/0/description_i18n/cn","获得任意护盾时，立即回复等同于护盾最大值15%的生命值。"],["/skills/5/variants/0/description_i18n/kr","임의 실드 획득 시, 즉시 실드 최대치 15%의 HP를 회복한다."],["/skills/5/variants/1/description_i18n/cn","战斗开始时获得的护盾提升至600% HP，为周围2格范围友军承担的伤害比例提升至80%。并且自身从该状态中结束后起身的速度加快50%。"],["/skills/5/variants/1/description_i18n/kr","전투 시작 시 획득하는 실드가 600% HP로 증가한다. 주변 2칸 범위 내 아군 대신 받는 대미지 비율이 80%로 증가하고, 해당 상태 종료 시 자신이 일어나는 속도가 50% 증가한다."],["/skills/5/variants/1/description_tooltip_spans_i18n/cn",[{"start":13,"end":20,"tooltip_key":"stat:HP"}]],["/skills/5/variants/1/description_tooltip_spans_i18n/kr",[{"start":17,"end":24,"tooltip_key":"stat:HP"}]],["/exclusive_equipment/name_i18n/cn","封墓连枷"],["/exclusive_equipment/name_i18n/kr","무덤의 철퇴"]]}