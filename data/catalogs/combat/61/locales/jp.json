on_tooltip_spans_i18n/jp",[{"start":21,"end":33,"tooltip_key":"stat:HP"}]],["/skills/1/name_i18n/cn","重压飞锤"],["/skills/1/name_i18n/jp","流星錘プレス"],["/skills/1/simple_description_i18n/cn","对目标造成多次伤害并击倒目标和其周围的敌人。"],["/skills/1/simple_description_i18n/jp","対象に複数回ダメージを与え、対象とその周囲にいる敵をノックダウンさせる"],["/skills/1/variants/0/description_i18n/cn","挥动流星锤对目标造成2次160% ATK伤害，随后重锤地面，对前方矩形范围内的敌人造成150% + 20% ATK伤害并击倒。"],["/skills/1/variants/0/description_i18n/jp","流星錘で対象に160% ATKのダメージを2回与え、その後、地面を強く打ち、前方の長方形範囲内の敵に150% + 20% ATKのダメージを与え、ノックダウンさせる"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":47,"end":53,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":54,"end":60,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":12,"end":20,"tooltip_key":"stat:ATK"},{"start":43,"end":57,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":7,"end":15,"tooltip_key":"stat:ATK"},{"start":50,"end":64,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","最后一击造成的伤害提升至170% + 20% ATK。"],["/skills/1/variants/1/description_i18n/jp","最後の一撃のダメージが170% + 20% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":15,"end":21,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","最后一击造成的伤害提升至200% + 20% ATK。"],["/skills/1/variants/2/description_i18n/jp","最後の一撃のダメージが200% + 20% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":15,"end":21,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","最后一击造成的伤害提升至220% + 20% ATK。"],["/skills/1/variants/3/description_i18n/jp","最後の一撃のダメージが220% + 20% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":16,"end":22,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":15,"end":21,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","不朽护葬"],["/skills/2/name_i18n/jp","不朽の守護"],["/skills/2/simple_description_i18n/cn","将护盾所抵御的伤害积蓄为自身力量，积蓄达到一定值时，主动释放造成范围伤害。"],["/skills/2/simple_description_i18n/jp","シールドが防いだダメージを蓄積し、蓄積ダメージが一定量を超えた時、アクティブで発動して範囲ダメージを与える"],["/skills/2/variants/0/description_i18n/cn","在战斗过程中，将自身护盾抵御的伤害值的25% + 1%积蓄为力量，主动使用时，将这个力量释放，对周围2格范围内的敌人造成等量的伤害。当积蓄的力量超过350% ATK时才会使用本技能，单次至多释放600% ATK力量，超过的部分将被保留至下一次释放。"],["/skills/2/variants/0/description_i18n/jp","戦闘中、自身のシールドが防いだダメージの25% + 1%を蓄積する。アクティブ効果：蓄積したダメージを放出し、周囲2マス範囲内の敵に同量のダメージを与える。このスキルは蓄積ダメージ量が350% ATKを超えている場合のみ発動でき、1回に放出できる蓄積ダメージ量は600% ATKまで、残りの蓄積ダメージは次の放出まで温存"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":22,"end":27,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":23,"end":28,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":74,"end":82,"tooltip_key":"stat:ATK"},{"start":97,"end":105,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp