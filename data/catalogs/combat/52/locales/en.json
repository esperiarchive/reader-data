t:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/en",[{"start":20,"end":34,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","落石术"],["/skills/2/name_i18n/en","Rolling Boulder"],["/skills/2/simple_description_i18n/cn","对最近所有受控制的敌人造成一次伤害。"],["/skills/2/simple_description_i18n/en","Alsa deals damage to all enemies recently affected by control effects."],["/skills/2/variants/0/description_i18n/cn","阿尔萨感应地脉震动，定位到最近受到过控制效果的所有敌人，在目标头顶生成落岩造成250% + 25% ATK伤害。"],["/skills/2/variants/0/description_i18n/en","Alsa senses the vibrations of leylines to locate all enemies recently affected by control effects, then drops boulders on them, dealing 250% + 25% ATK damage."],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":43,"end":49,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_power_spans_i18n/en",[{"start":140,"end":146,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":39,"end":53,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/en",[{"start":136,"end":150,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","伤害提升至260% + 25% ATK。"],["/skills/2/variants/1/description_i18n/en","Increases damage to 260% + 25% ATK."],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_power_spans_i18n/en",[{"start":24,"end":30,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/en",[{"start":20,"end":34,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","伤害提升至270% + 25% ATK。"],["/skills/2/variants/2/description_i18n/en","Increases damage to 270% + 25% ATK."],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_power_spans_i18n/en",[{"start":24,"end":30,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/en",[{"start":20,"end":34,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","伤害提升至280% + 25% ATK。"],["/skills/2/variants/3/description_i18n/en","Increases damage to 280% + 25% ATK."],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_power_spans_i18n/en",[{"start":24,"end":30,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/en",[{"start":20,"end":34,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/en","Hero Focus"],["/skills/3/simple_description_i18n/cn","提高自身急速。"],["/skills/3/simple_description_i18n/en","Increases Haste during battle."],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的急速提升10点，且当进入“战斗姿态”后，额外提升6点急速。"],["/skills/3/variants/0/description_i18n/en","Increases Haste by 10 during battles, gaining an extra 6 Haste after entering the Combat Stance status."],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的急速提升14点，且当进入“战斗姿态”后，额外提升7点急速。"],["/skills/3/variants/1/description_i18n/en","Increases Haste by 14 during battles, gaining an extra 7 Haste after entering the Combat Stance status."],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的急速提升18点，且当进入“战斗姿态”后，额外提升8点急速。"],["/skills/3/variants/2/description_i18n/en","Increases Haste by 18 during battles, gaining an extra 8 Haste after entering the Combat Stance status."],["/skills/4/name_i18n/cn","大地恩赐"],["/skills/4/name_i18n/en","Don of Terra"],["/skills/4/simple_description_i18n/cn","提升“战斗姿态”下的战斗能力。"],["/skills/4/simple_description_i18n/en","Increases combat capabilities under the Combat Stance status."],["/skills/4/variants/0/description_i18n/cn","每次使用“活跃突进”造成伤害后，下次“活跃突进”造成的伤害增加50% ATK，至多增加2次。每次使用“迅疾撤离”后，下次“迅疾撤离”提供的护盾值增加最大生命值5%的护盾，至多增加2次。"],["/skills/4/variants/0/description_i18n/en","Alsa increases the damage of Vigorous Slam by 50% ATK after dealing damage with the skill, stacking up to 2 times. She also increases the shield value of Swift Evasion by 5% of her max HP after casting it, stacking up to 2 times."],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":31,"end":38,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/en",[{"start":46,"end":53,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_i18n/cn","“活跃突进”叠加至满层后，该技能的能量消耗降低至400点。"],["/skills/4/variants/1/description_i18n/en","Reduces the Energy cost to 400 when the Vigorous Slam buff is stacked to its maximum."],["/skills/4/variants/2/description_i18n/cn","“迅疾撤离”叠加至满层后，该技能的冷却时间缩短至6秒。"],["/skills/4/variants/2/description_i18n/en","Reduces the cooldown to 6s when the Swift Evasion buff is stacked to its maximum."],["/skills/4/variants/3/description_i18n/cn","下次“活跃突进”造成的伤害增加55% ATK，至多增加2次。"],["/skills/4/variants/3/description_i18n/en","Increases the damage dealt by the next Vigorous Slam by 55% ATK. This effect can stack up to 2 times."],["/skills/4/variants/3/description_tooltip_spans_i18n/cn",[{"start":15,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/en",[{"start":56,"end":63,"tooltip_key":"stat:ATK"}]],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/en","Enhance Force"],["/skills/5/simple_description_i18n/cn","“落石术”对近期受到多次控制效果的敌人伤害提升。"],["/skills/5/simple_description_i18n/en","Rolling Boulder deals extra damage to enemies recently affected by multiple control effects."],["/skills/5/variants/0/description_i18n/cn","“落石术”对近期受到过多次控制效果的敌人造成的伤害增加180% ATK。"],["/skills/5/variants/0/description_i18n/en","Rolling Boulder deals an extra 180% ATK damage to enemies recently affected by multiple control effects."],["/skills/5/variants/0/description_tooltip_spans_i18n/cn",[{"start":27,"end":35,"tooltip_key":"stat:ATK"}]],["/skills/5/variants/0/description_tooltip_spans_i18n/en",[{"start":31,"end":39,"tooltip_key":"stat:ATK"}]],["/skills/5/variants/1/description_i18n/cn","每累计对4名敌人释放“落石术”后，该技能将生成一颗巨型落岩，对最密集的2格范围内敌人造成250% ATK伤害，并使命中的目标在10秒内魔抗降低30%。"],["/skills/5/variants/1/description_i18n/en","Every time Rolling Boulder triggers on a total of 4 enemies, Alsa summons a massive boulder that crashes into the 2-tile area with the most enemies, dealing 250% ATK damage and reducing the Magic DEF of enemies hit by 30% for 10s."],["/skills/5/variants/1/description_tooltip_spans_i18n/cn",[{"start":44,"end":52,"tooltip_key":"stat:ATK"}]],["/skills/5/variants/1/description_tooltip_spans_i18n/en",[{"start":157,"end":165,"tooltip_key":"stat:ATK"}]],["/exclusive_equipment/name_i18n/cn","地灵鳞甲"],["/exclusive_equipment/name_i18n/en","Terra Scales"]]}