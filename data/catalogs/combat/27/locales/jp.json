n",[{"start":55,"end":61,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":50,"end":56,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":37,"end":45,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":30,"end":38,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","伤害提升至290% ATK。"],["/skills/1/variants/1/description_i18n/jp","ダメージが290% ATKにUP"],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","伤害提升至300% ATK。"],["/skills/1/variants/2/description_i18n/jp","ダメージが300% ATKにUP"],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","伤害提升至320% ATK。"],["/skills/1/variants/3/description_i18n/jp","ダメージが320% ATKにUP"],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":13,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","丛林之敌"],["/skills/2/name_i18n/jp","森林の敵"],["/skills/2/simple_description_i18n/cn","降低携带“丛林印记”的敌人的护甲，并且在击败他时得到增益。"],["/skills/2/simple_description_i18n/jp","「森の印」状態の敵は物理防御DOWN。その敵を撃破するとバフを獲得"],["/skills/2/variants/0/description_i18n/cn","“丛林印记”能够降低敌人6%护甲，携带“丛林印记”的敌人被击败时，这名敌人周围2格内的友军每0.375秒回复-100% − 15% ATK生命值，持续1.125秒。"],["/skills/2/variants/0/description_i18n/jp","「森の印」が付与されている敵は物理防御-6%。その敵が撃破された時、対象の周囲2マス以内の味方は、1.125秒間、0.375秒ごとにHPが-100% − 15% ATK回復"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":59,"end":65,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":74,"end":80,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":54,"end":69,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":69,"end":84,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","下降护甲的幅度提升至9%。"],["/skills/2/variants/1/description_i18n/jp","物理防御減少量が9%にUP"],["/skills/2/variants/2/description_i18n/cn","下降护甲的幅度提升至12%。"],["/skills/2/variants/2/description_i18n/jp","物理防御減少量が12%にUP"],["/skills/2/variants/3/description_i18n/cn","下降护甲的幅度提升至15%。"],["/skills/2/variants/3/description_i18n/jp","物理防御減少量が15%にUP"],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提高自身攻击力。"],["/skills/3/simple_description_i18n/jp","自身の攻撃力UP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的攻击力提升12%。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身の攻撃力+12%"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的攻击力提升16%。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身の攻撃力+16%"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的攻击力提升20%。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身の攻撃力+20%"],["/skills/4/name_i18n/cn","无情驱逐"],["/skills/4/name_i18n/jp","冷酷なる駆逐"],["/skills/4/simple_description_i18n/cn","有敌人治疗携带“丛林印记”的敌人时，对其进行突击。"],["/skills/4/simple_description_i18n/jp","「森の印」状態の敵を回復した治療者に突撃"],["/skills/4/variants/0/description_i18n/cn","携带“丛林印记”的敌人受到来自其他敌人的治疗时，卡夫拉跳跃至治疗来源附近对其发起攻击，造成250% ATK伤害，并使其在5秒内降低40点急速。过程中卡夫拉处于霸体状态。"],["/skills/4/variants/0/description_i18n/jp","「森の印」を持つ敵が他の敵による回復を受ける時、治療者の近くにジャンプし、治療者に250% ATKのダメージを与え、5秒間、対象の速度-40。攻撃中、自身はスーパーアーマー状態になる"],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":45,"end":53,"tooltip_key":"stat:ATK"},{"start":79,"end":81,"tooltip_key":"keyword:uncontrol"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/jp",[{"star