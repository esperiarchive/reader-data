/cn",[{"start":14,"end":20,"power_type":"ultimate","parameter":"PlusRatio"}]],["/skills/0/variants/4/description_power_spans_i18n/jp",[{"start":16,"end":22,"power_type":"ultimate","parameter":"PlusRatio"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/cn",[{"start":10,"end":24,"tooltip_key":"stat:ATK"},{"start":35,"end":42,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/jp",[{"start":12,"end":26,"tooltip_key":"stat:ATK"},{"start":49,"end":56,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","圣佑之刃"],["/skills/1/name_i18n/jp","加護の剣"],["/skills/1/simple_description_i18n/cn","使用十字剑祈祷，使自身获得护盾并对敌人造成伤害。"],["/skills/1/simple_description_i18n/jp","十字剣を構えながら祈り、自身はシールドを獲得し、敵にダメージを与える"],["/skills/1/variants/0/description_i18n/cn","将十字剑放在胸前祈祷，自身获得可抵御200% + 20% ATK伤害的护盾，持续6秒，并为剑附上圣洁的力量，对目标造成250% + 25% ATK伤害。若释放该技能时，自身带有友军施加的非永久属性提升效果，伤害类型变为真实伤害。"],["/skills/1/variants/0/description_i18n/jp","十字剣を胸の前に構えながら祈り、自身は200% + 20% ATK分のシールドを6秒間獲得し、聖なる力で対象に250% + 25% ATKのダメージを与える。このスキルを発動する時、自身に味方による非永続的なステータス上昇効果が付与されている場合、このスキルのダメージは確定ダメージになる"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":22,"end":28,"power_type":"skill","parameter":"SArg0"},{"start":63,"end":69,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":23,"end":29,"power_type":"skill","parameter":"SArg0"},{"start":59,"end":65,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":18,"end":32,"tooltip_key":"stat:ATK"},{"start":59,"end":73,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":19,"end":33,"tooltip_key":"stat:ATK"},{"start":55,"end":69,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","对目标造成的伤害提升至260% + 25% ATK。"],["/skills/1/variants/1/description_i18n/jp","対象に与えるダメージが260% + 25% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","对目标造成的伤害提升至270% + 25% ATK。"],["/skills/1/variants/2/description_i18n/jp","対象に与えるダメージが270% + 25% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","对目标造成的伤害提升至280% + 25% ATK。"],["/skills/1/variants/3/description_i18n/jp","対象に与えるダメージが280% + 25% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","约誓圣言"],["/skills/2/name_i18n/jp","誓いの聖言"],["/skills/2/simple_description_i18n/cn","使用符器庇护自身和一名友军，获得攻击力提升和对周围一格的眩晕效果。"],["/skills/2/simple_description_i18n/jp","自身と対象味方の攻撃力UP、それぞれの周囲1マス範囲内の敵にダメージを与え、スタンを付与"],["/skills/2/variants/0/description_i18n/cn","备战时，选择1格范围内的一名友方英雄缔约圣言（优先选择更靠近身后的友军）。主动释放时，为自身和该英雄提升12% + 1.5%攻击力，持续10秒，持续时间结束后会再次释放此效果。在持续时间内，每3秒对增益持有者1格范围内的敌人造成0.5秒眩晕和100% ATK伤害。"],["/skills/2/variants/0/description_i18n/jp","戦闘準備時、周囲1マスの味方英雄1体を選択し、聖言の契約を締結（自身の後方1マスに最も近い味方英雄を優先的に選択）。アクティブ効果：10秒間、自身と選択対象の味方英雄の攻撃力+12% + 1.5%。持続時間終了後、再度この効果を発動。持続期間中、3秒ごとにバフ所持者の1マス範囲内の敵に0.5秒間のスタンを付与し、100% ATKのダメージを与える"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":55,"end":62,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":91,"end":98,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":121,"end":129,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":157,"end":165,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","为自身和友军提升的攻击力提升至13% + 1.5%。"],["/skills/2/variants/1/description_i18n/jp","自身と対象味方の攻撃力上昇量が13% + 1.5%にUP"],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":18,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_power_spans_i18n/jp",[{"start":18,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_i18n/cn","为自身和友军提升的攻击力提升至14% + 1.5%。"],["/skills/2/variants/2/description_i18n/jp","自身と対象味方の攻撃力上昇量が14% + 1.5%にUP"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":18,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":18,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_i18n/cn","为自身和友军提升的攻击力提升至15% + 1.5%。"],["/skills/2/variants/3/description_i18n/jp","自身と対象味方の攻撃力上昇量が15% + 1.5%にUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":18,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":18,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提高自身急速。"],["/skills/3/simple_description_i18n/jp","自身の速度UP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身提高12点急速。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身の速度+12"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身提高16点急速。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身の速度+16"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身提高20点急速。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身の速度+20"],["/skills/4/name_i18n/cn","邪灵挽歌"],["/skills/4/name_i18n/jp","邪霊の挽歌"],["/skills/4/simple_description_i18n/cn","法阵存在时，自身获得增强，法阵内敌人受到额外的真实伤害。"],["/skills/4/simple_description_i18n/jp","魔法陣の存在期間中、自身を強化し、魔法陣内の敵に追加の確定ダメージを与える"],["/skills/4/variants/0/description_i18n/cn","当法阵存在时，使用“圣佑之刃”替换普攻，获得的护盾值不超过600% ATK。每次友军对法阵内敌人造成伤害时，将附带友军攻击力75%的真实伤害，每名友军1秒内最多触发1次附加伤害。"],["/skills/4/variants/0/description_i18n/jp","魔法陣の存在期間中、通常攻撃が「加護の剣」に変化し、獲得するシールド値は600% ATKを超えない。味方が魔法陣内の敵にダメージを与えるたびに、追加でその味方の攻撃力×75%の確定ダメージを与える。1体の味方につき、1秒ごとに1回まで追加ダメージを発動可能"],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":29,"end":37,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/jp",[{"start":36,"end":44,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_i18n/cn","附带的真实伤害提升至友军攻击力的80%。"],["/skills/4/variants/1/description_i18n/jp","追加の確定ダメージが味方の攻撃力×80%にUP"],["/skills/4/variants/2/description_i18n/cn","每场战斗一次，法阵内敌人被击败时，使自身获得10%的攻击力，并使法阵永久强化，半径扩大到2格。"],["/skills/4/variants/2/description_i18n/jp","1度の戦闘につき、1回まで発動可能。魔法陣内の敵が撃破された時、自身の攻撃力+10%。さらに魔法陣を永続的に強化し、魔法陣の半径が2マスにUP"],["/skills/4/variants/3/description_i18n/cn","附带的真实伤害提升至友军攻击力的85%。"],["/skills/4/variants/3/description_i18n/jp","追加の確定ダメージが味方の攻撃力×85%にUP"],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","降低法阵内敌人复活后的受愈。"],["/skills/5/simple_description_i18n/jp","魔法陣内の敵が復活した場合、復活開始時から永続的に対象の治癒DOWN"],["/skills/5/variants/0/description_i18n/cn","若法阵内的敌人在生命值归零后再次复活，则使其受愈下降50点。"],["/skills/5/variants/0/description_i18n/jp","魔法陣内の敵が、HPが0になった後に復活した場合、復活開始時から永続的に対象の治癒-50"],["/exclusive_equipment/name_i18n/cn","誓言之心"],["/exclusive_equipment/name_i18n/jp","誓いの心"]]}