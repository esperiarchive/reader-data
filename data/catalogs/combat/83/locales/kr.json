nts/4/description_power_spans_i18n/cn",[{"start":14,"end":20,"power_type":"ultimate","parameter":"PlusRatio"}]],["/skills/0/variants/4/description_power_spans_i18n/kr",[{"start":18,"end":24,"power_type":"ultimate","parameter":"PlusRatio"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/cn",[{"start":10,"end":24,"tooltip_key":"stat:ATK"},{"start":35,"end":42,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/kr",[{"start":14,"end":28,"tooltip_key":"stat:ATK"},{"start":46,"end":53,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","圣佑之刃"],["/skills/1/name_i18n/kr","그레이스 블레이드"],["/skills/1/simple_description_i18n/cn","使用十字剑祈祷，使自身获得护盾并对敌人造成伤害。"],["/skills/1/simple_description_i18n/kr","십자검을 사용해 기도하여, 자신은 실드를 획득하며 적에게 대미지를 입힌다."],["/skills/1/variants/0/description_i18n/cn","将十字剑放在胸前祈祷，自身获得可抵御200% + 20% ATK伤害的护盾，持续6秒，并为剑附上圣洁的力量，对目标造成250% + 25% ATK伤害。若释放该技能时，自身带有友军施加的非永久属性提升效果，伤害类型变为真实伤害。"],["/skills/1/variants/0/description_i18n/kr","십자검을 가슴에 대고 기도해 자신이 6초 동안 200% + 20% ATK의 대미지를 막을 수 있는 실드를 획득하고, 검에 거룩한 힘을 부여해 목표에게 250% + 25% ATK의 대미지를 입힌다. 해당 스킬 시전 시, 만약 자신에게 아군이 부여한 비영구 속성 상승 효과가 있다면, 대미지 유형이 고정 대미지로 변경된다."],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":22,"end":28,"power_type":"skill","parameter":"SArg0"},{"start":63,"end":69,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/kr",[{"start":30,"end":36,"power_type":"skill","parameter":"SArg0"},{"start":88,"end":94,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":18,"end":32,"tooltip_key":"stat:ATK"},{"start":59,"end":73,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/kr",[{"start":26,"end":40,"tooltip_key":"stat:ATK"},{"start":84,"end":98,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","对目标造成的伤害提升至260% + 25% ATK。"],["/skills/1/variants/1/description_i18n/kr","목표에게 입히는 대미지가 260% + 25% ATK로 증가한다."],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/kr",[{"start":18,"end":24,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/kr",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","对目标造成的伤害提升至270% + 25% ATK。"],["/skills/1/variants/2/description_i18n/kr","목표에게 입히는 대미지가 270% + 25% ATK로 증가한다."],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/kr",[{"start":18,"end":24,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/kr",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","对目标造成的伤害提升至280% + 25% ATK。"],["/skills/1/variants/3/description_i18n/kr","목표에게 입히는 대미지가 280% + 25% ATK로 증가한다."],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/kr",[{"start":18,"end":24,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/kr",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","约誓圣言"],["/skills/2/name_i18n/kr","성스러운 맹세"],["/skills/2/simple_description_i18n/cn","使用符器庇护自身和一名友军，获得攻击力提升和对周围一格的眩晕效果。"],["/skills/2/simple_description_i18n/kr","부적으로 자신과 아군 1명을 보호하여 공격력을 증가시키고, 주변 1칸을 스턴시킨다."],["/skills/2/variants/0/description_i18n/cn","备战时，选择1格范围内的一名友方英雄缔约圣言（优先选择更靠近身后的友军）。主动释放时，为自身和该英雄提升12% + 1.5%攻击力，持续10秒，持续时间结束后会再次释放此效果。在持续时间内，每3秒对增益持有者1格范围内的敌人造成0.5秒眩晕和100% ATK伤害。"],["/skills/2/variants/0/description_i18n/kr","전투 준비 시 1칸 범위 내의 아군 영웅(후방에 가장 가까운 아군 우선 선택) 1명을 선택하여 성스러운 계약을 맺는다.\n액티브: 자신과 해당 영웅의 공격력이 10초 동안 12% + 1.5% 증가하며, 지속 시간 종료 후 해당 효과를 다시 시전한다. 지속 시간 동안 3초마다 버프 보유자 1칸 범위 내의 적을 0.5초 동안 스턴시키고 100% ATK의 대미지를 입힌다."],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":55,"end":62,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_power_spans_i18n/kr",[{"start":98,"end":105,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":121,"end":129,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/kr",[{"start":186,"end":194,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","为自身和友军提升的攻击力提升至13% + 1.5%。"],["/skills/2/variants/1/description_i18n/kr","자신과 아군의 증가하는 공격력이 13% + 1.5%로 증가한다."],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":18,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_power_spans_i18n/kr",[{"start":21,"end":28,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_i18n/cn","为自身和友军提升的攻击力提升至14% + 1.5%。"],["/skills/2/variants/2/description_i18n/kr","자신과 아군의 증가하는 공격력이 14% + 1.5%로 증가한다."],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":18,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_power_spans_i18n/kr",[{"start":21,"end":28,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_i18n/cn","为自身和友军提升的攻击力提升至15% + 1.5%。"],["/skills/2/variants/3/description_i18n/kr","자신과 아군의 증가하는 공격력이 15% + 1.5%로 증가한다."],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":18,"end":25,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_power_spans_i18n/kr",[{"start":21,"end":28,"power_type":"skill","parameter":"SArg0"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/kr","영웅 마스터리"],["/skills/3/simple_description_i18n/cn","提高自身急速。"],["/skills/3/simple_description_i18n/kr","자신의 급속이 증가한다."],["/skills/3/variants/0/description_i18n/cn","战斗中，自身提高12点急速。"],["/skills/3/variants/0/description_i18n/kr","전투 중, 자신의 급속이 12 증가한다."],["/skills/3/variants/1/description_i18n/cn","战斗中，自身提高16点急速。"],["/skills/3/variants/1/description_i18n/kr","전투 중, 자신의 급속이 16 증가한다."],["/skills/3/variants/2/description_i18n/cn","战斗中，自身提高20点急速。"],["/skills/3/variants/2/description_i18n/kr","전투 중, 자신의 급속이 20 증가한다."],["/skills/4/name_i18n/cn","邪灵挽歌"],["/skills/4/name_i18n/kr","이블 레퀴엠"],["/skills/4/simple_description_i18n/cn","法阵存在时，自身获得增强，法阵内敌人受到额外的真实伤害。"],["/skills/4/simple_description_i18n/kr","마법진 존재 시 자신이 버프를 획득한다. 마법진 내의 적은 추가로 고정 대미지를 받는다."],["/skills/4/variants/0/description_i18n/cn","当法阵存在时，使用“圣佑之刃”替换普攻，获得的护盾值不超过600% ATK。每次友军对法阵内敌人造成伤害时，将附带友军攻击力75%的真实伤害，每名友军1秒内最多触发1次附加伤害。"],["/skills/4/variants/0/description_i18n/kr","마법진이 존재하는 동안 일반 공격 대신 그레이스 블레이드를 사용하고 600% ATK를 초과하지 않는 실드 수치를 획득한다. 아군이 마법진 내의 적에게 대미지를 입힐 때마다 추가로 아군의 공격력 75%에 해당하는 고정 대미지를 입히고, 1초마다 각 아군의 추가 대미지는 최대 1회 발동된다."],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":29,"end":37,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/kr",[{"start":38,"end":46,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_i18n/cn","附带的真实伤害提升至友军攻击力的80%。"],["/skills/4/variants/1/description_i18n/kr","추가 고정 대미지가 아군 공격력의 80%로 증가한다."],["/skills/4/variants/2/description_i18n/cn","每场战斗一次，法阵内敌人被击败时，使自身获得10%的攻击力，并使法阵永久强化，半径扩大到2格。"],["/skills/4/variants/2/description_i18n/kr","마법진 내의 적이 처치당할 시 자신은 10%의 공격력을 획득하고 마법진을 영구적으로 강화하여 반경을 2칸으로 확대한다(해당 효과는 전투당 1회만 발동)."],["/skills/4/variants/3/description_i18n/cn","附带的真实伤害提升至友军攻击力的85%。"],["/skills/4/variants/3/description_i18n/kr","추가 고정 대미지가 아군 공격력의 85%로 증가한다."],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/kr","각성의 힘"],["/skills/5/simple_description_i18n/cn","降低法阵内敌人复活后的受愈。"],["/skills/5/simple_description_i18n/kr","마법진 내 부활한 적의 활력이 감소한다."],["/skills/5/variants/0/description_i18n/cn","若法阵内的敌人在生命值归零后再次复活，则使其受愈下降50点。"],["/skills/5/variants/0/description_i18n/kr","만약 마법진 내 적의 HP가 0으로 된 이후 다시 부활하면 활력이 50 감소한다."],["/exclusive_equipment/name_i18n/cn","誓言之心"],["/exclusive_equipment/name_i18n/kr","서약의 마음"]]}