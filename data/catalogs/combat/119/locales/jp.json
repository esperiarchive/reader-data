ower_type":"ultimate","parameter":"SArg2"}]],["/skills/0/variants/3/description_tooltip_spans_i18n/cn",[{"start":21,"end":35,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/3/description_tooltip_spans_i18n/jp",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_i18n/cn","“末日陨星”对范围内所有敌人造成伤害提升至550% + 50% ATK。"],["/skills/0/variants/4/description_i18n/jp","「終末隕石」のダメージが550% + 50% ATKにUP"],["/skills/0/variants/4/description_power_spans_i18n/cn",[{"start":25,"end":31,"power_type":"ultimate","parameter":"SArg2"}]],["/skills/0/variants/4/description_power_spans_i18n/jp",[{"start":16,"end":22,"power_type":"ultimate","parameter":"SArg2"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/cn",[{"start":21,"end":35,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/jp",[{"start":12,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","轰炸引擎"],["/skills/1/name_i18n/jp","砲撃機関"],["/skills/1/simple_description_i18n/cn","进行多次炮击，对目标范围的敌人造成伤害。"],["/skills/1/simple_description_i18n/jp","砲撃を複数回行い、範囲内の敵にダメージを与える"],["/skills/1/variants/0/description_i18n/cn","连续进行6次炮击，每次炮击对锁定目标周围1格范围内的所有敌人造成65% + 8% ATK伤害。若场上存在“灾厄枢纽”，则“灾厄枢纽”也会同步发动6次协同攻击，对锁定目标造成0.5秒眩晕和6% + 0.5%最大生命值的伤害，该伤害最高不超过勒图姆100% ATK。"],["/skills/1/variants/0/description_i18n/jp","砲撃を連続で6回行い、1回につき、ロック対象とその周囲1マス以内の敵に65% + 8% ATKのダメージを与える。フィールド上に「災厄中枢」が存在する場合、「災厄中枢」も同時に連携攻撃を6回行い、ロック対象にそのHP上限×6% + 0.5%のダメージを与え、0.5秒間のスタンを付与。連携攻撃のダメージはレトゥムの100% ATKを超えない"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":35,"end":40,"power_type":"skill","parameter":"PlusRatio"},{"start":95,"end":102,"power_type":"skill","parameter":"SArg1"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":38,"end":43,"power_type":"skill","parameter":"PlusRatio"},{"start":113,"end":120,"power_type":"skill","parameter":"SArg1"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":32,"end":44,"tooltip_key":"stat:ATK"},{"start":122,"end":130,"toolt