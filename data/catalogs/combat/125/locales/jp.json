tart":9,"end":23,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/jp",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","勇者瞬袭"],["/skills/1/name_i18n/jp","勇者の瞬撃"],["/skills/1/simple_description_i18n/cn","瞬间移动至两名敌人身旁发动斩击并将其击倒。"],["/skills/1/simple_description_i18n/jp","敵2体の近くに瞬間移動し、斬撃で対象をノックダウンさせる"],["/skills/1/variants/0/description_i18n/cn","先后瞬移到累计造成伤害最高的2名敌人身旁，分别对其造成340% + 40% ATK伤害并将其击倒2秒，随后回到原位置。辛美尔在本技能释放期间获得霸体状态。"],["/skills/1/variants/0/description_i18n/jp","合計与ダメージが最も高い敵2体の近くに順番に瞬間移動し、それぞれの対象に340% + 40% ATKのダメージを与え、2秒間ノックダウンさせ、その後、元の位置に戻る。このスキルの発動中、自身はスーパーアーマー状態になる"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":31,"end":37,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":40,"end":46,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":27,"end":41,"tooltip_key":"stat:ATK"},{"start":72,"end":74,"tooltip_key":"keyword:uncontrol"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":36,"end":50,"tooltip_key":"stat:ATK"},{"start":96,"end":104,"tooltip_key":"keyword:uncontrol"}]],["/skills/1/variants/1/description_i18n/cn","伤害提高至360% + 40% ATK。"],["/skills/1/variants/1/description_i18n/jp","ダメージが360% + 40% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","伤害提高至380% + 40% ATK。"],["/skills/1/variants/2/description_i18n/jp","ダメージが380% + 40% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","伤害提高至400% + 40% ATK。"],["/skills/1/variants/3/description_i18n/jp","ダメージが400% + 40% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","冒险伙伴"],["/skills/2/name_i18n/jp","冒険の仲間"],["/skills/2/simple_description_i18n/cn","辛美尔在战斗开始时组建“冒险伙伴”；主动使用时，对前方敌人造成伤害。"],["/skills/2/simple_description_i18n/jp","戦闘開始時、「冒険の仲間」を集める。アクティブ効果：前方の敵にダメージを与える"],["/skills/2/variants/0/description_i18n/cn","战斗开始时，若辛美尔周围1格范围内同时存在法师、坦克与辅助职业的友军各一名，则与这三位友军组建“冒险伙伴”。辛美尔的精神会鼓舞所有“冒险伙伴”，提高其12% + 1%的基础属性，并且共享一个相当于辛美尔初始攻击力1500% + 100%的永久护盾。主动使用时，辛美尔对目标敌人造成4次120% + 20% ATK攻击力的伤害，并将造成伤害的30% + 2%转化为对所有“冒险伙伴”的治疗。"],["/skills/2/variants/0/description_i18n/jp","戦闘開始時、自身の周囲1マス以内にメイジ、タンク、サポートの味方がそれぞれ1体存在する場合、自身と対象の味方たちは「冒険の仲間」になる。「冒険の仲間」は基本ステータス+12% + 1%、ヒンメルの初期攻撃力×1500% + 100%分の永続シールドを共有する。アクティブ効果：対象の敵に120% + 20% ATKのダメージを4回与え、与えたダメージの30% + 2%を「冒険の仲間」全員へのHP回復量に変換"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":78,"end":83,"power_type":"skill","parameter":"SArg0"},{"start":111,"end":118,"power_type":"skill","parameter":"SArg1"},{"start":146,"end":152,"power_type":"skill","parameter":"PlusRatio"},{"start":173,"end":178,"power_type":"skill","parameter":"SArg3"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":87,"end":92,"power_type":"skill","parameter":"SArg0"},{"start":109,"end":116,"power_type":"skill","parameter":"SArg1"},{"start":147,"end":153,"power_type":"skill","parameter":"PlusRatio"},{"start":179,"end":184,"power_type":"skill","parameter":"SArg3"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":142,"end":156,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":143,"end":157,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","主动使用时，每段造成的伤害提高至140% + 20% ATK。"],["/skills/2/variants/1/description_i18n/jp","アクティブ効果で対象の敵に140% + 20% ATKダメージを5回与える"],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":20,"end":26,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_power_spans_i18n/jp",[{"start":17,"end":23,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":16,"end":30,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/jp",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","主动使用时，每段造成的伤害提高至160% + 20% ATK。"],["/skills/2/variants/2/description_i18n/jp","アクティブ効果で対象の敵に160% + 20% ATKダメージを5回与える"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":20,"end":26,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":17,"end":23,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":16,"end":30,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/jp",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","主动使用时，每段造成的伤害提高至180% + 20% ATK。"],["/skills/2/variants/3/description_i18n/jp","アクティブ効果で対象の敵に180% + 20% ATKダメージを5回与える"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":20,"end":26,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":17,"end":23,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":16,"end":30,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/jp",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","战斗中，提升自身急速。"],["/skills/3/simple_description_i18n/jp","戦闘中、自身の速度UP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的急速提高12点。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身の速度+12"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的急速提高16点。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身の速度+16"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的急速提高20点。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身の速度+20"],["/skills/4/name_i18n/cn","苍月草的祝福"],["/skills/4/name_i18n/jp","蒼月草の祝福"],["/skills/4/simple_description_i18n/cn","战斗开始时，战场中会吹过苍月草花瓣附加祝福效果。"],["/skills/4/simple_description_i18n/jp","戦闘開始時、フィールドに蒼月草の花びらが舞い、「冒険の仲間」に祝福を付与"],["/skills/4/variants/0/description_i18n/cn","战斗开始时，战场中会吹过苍月草花瓣附加祝福效果，对“冒险伙伴”带来永久属性增益：坦克和辅助成员获得相当于辛美尔初始攻击力150%的最大生命值、法师成员和辛美尔获得相当于辛美尔初始攻击力8%的攻击力。若芙莉莲作为“冒险伙伴”登场，则辛美尔会为其带上花环，并且永久提升自身和芙莉莲30点穿透。"],["/skills/4/variants/0/description_i18n/jp","戦闘開始時、フィールドに蒼月草の花びらが舞い、その祝福により、「冒険の仲間」に永続的なステータスバフが付与される：タンクとサポートのメンバーのHP上限が「ヒンメルの初期攻撃力×150%」分UP、メイジメンバーとヒンメルの攻撃力が「ヒンメルの初期攻撃力×8%」分UP。「冒険の仲間」にフリーレンがいる場合、フリーレンに花冠を被せ、永続的に自身とフリーレンの防御貫通+30"],["/skills/4/variants/1/description_i18n/cn","坦克和辅助成员获得相当于辛美尔初始攻击力200%的最大生命值、法师成员和辛美尔获得相当于辛美尔初始攻击力10%的攻击力"],["/skills/4/variants/1/description_i18n/jp","タンクとサポートのメンバーのHP上限が「ヒンメルの初期攻撃力×200%」分UP、メイジメンバーとヒンメルの攻撃力が「ヒンメルの初期攻撃力×10%」分UP"],["/skills/4/variants/2/description_i18n/cn","持续作战10秒后，苍月草的祝福将会再次从场中吹过，为场中所有“冒险伙伴”恢复40%最大生命值并驱散所有减益状态，此时每有一名“冒险伙伴”存活，将会提升辛美尔12%的攻击力。"],["/skills/4/variants/2/description_i18n/jp","戦闘開始から10秒後、蒼月草の花びらが再び舞い、フィールド上の「冒険の仲間」全員のHPがHP上限の40%分回復、デバフ状態がすべて解除される。この時の生存中の「冒険の仲間」1体につき、ヒンメルの攻撃力+12%"],["/skills/4/variants/3/description_i18n/cn","坦克和辅助成员获得相当于辛美尔初始攻击力250%的最大生命值、法师成员和辛美尔获得相当于辛美尔初始攻击力12%的攻击力"],["/skills/4/variants/3/description_i18n/jp","タンクとサポートのメンバーのHP上限が「ヒンメルの初期攻撃力×250%」分UP、メイジメンバーとヒンメルの攻撃力が「ヒンメルの初期攻撃力×12%」分UP"],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","辛美尔和他的伙伴对首领敌人造成的生命损耗效果增加。"],["/skills/5/simple_description_i18n/jp","「冒険の仲間」がボスに与えるHP減少効果UP"],["/skills/5/variants/0/description_i18n/cn","辛美尔拥有讨伐魔王的不屈的精神。在首领模式中，辛美尔及其“冒险伙伴”对首领敌人造成的生命损耗效果提高12%。"],["/skills/5/variants/0/description_i18n/jp","ボス挑戦モードの場合、ヒンメルの魔王討伐の意志により、「冒険の仲間」がボスに与えるHP減少効果+12%"],["/exclusive_equipment/name_i18n/cn","辛美尔的剑"],["/exclusive_equipment/name_i18n/jp","ヒンメルの剣"]]}