:"PlusRatio"},{"start":55,"end":61,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"},{"start":66,"end":72,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":12,"end":26,"tooltip_key":"stat:ATK"},{"start":51,"end":65,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":11,"end":25,"tooltip_key":"stat:ATK"},{"start":62,"end":76,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","劈砍伤害提高至320% + 40% ATK。"],["/skills/2/variants/1/description_i18n/jp","剣を振り下ろす時のダメージが320% + 40% ATKにUP"],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":11,"end":17,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_power_spans_i18n/jp",[{"start":18,"end":24,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":7,"end":21,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/jp",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","劈砍伤害提高至340% + 40% ATK。"],["/skills/2/variants/2/description_i18n/jp","剣を振り下ろす時のダメージが340% + 40% ATKにUP"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":11,"end":17,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":18,"end":24,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":7,"end":21,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/jp",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","劈砍伤害提高至360% + 40% ATK。"],["/skills/2/variants/3/description_i18n/jp","剣を振り下ろす時のダメージが360% + 40% ATKにUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":11,"end":17,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":18,"end":24,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":7,"end":21,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/jp",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提高自身急速，每次进入“神临”状态后进一步提高。"],["/skills/3/simple_description_i18n/jp","自身の速度UP。「降臨」状態になるたびに、追加で速度UP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的急速提升9点，每次进入“神临”状态后额外提升3点。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身の速度+9。「降臨」状態になるたびに、追加で速度+3"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的急速提升12点，每次进入“神临”状态后额外提升4点。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身の速度+12。「降臨」状態になるたびに、追加で速度+4"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的急速提升15点，每次进入“神临”状态后额外提升5点。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身の速度+15。「降臨」状態になるたびに、追加で速度+5"],["/skills/4/name_i18n/cn","天启圣辉"],["/skills/4/name_i18n/jp","啓示の光"],["/skills/4/simple_description_i18n/cn","首次进入“神临”状态后，恢复“神圣御空”技能中损失的额外生命上限，并且在生命恢复至上限后进入更强大的“神临”状态，永久霸体并且终极技能会额外召唤圣光造成真实伤害。"],["/skills/4/simple_description_i18n/jp","初めて「降臨」状態になった後、スキル「神聖飛行」で減少した追加のHP上限をすべて回復。自身のHPが再びHP上限まで回復した後、さらに強化した「降臨」状態になり、以下の効果を獲得：永続的にスーパーアーマー状態になり、必殺技を発動するたびに、「聖光」を召喚して確定ダメージを与える"],["/skills/4/variants/0/description_i18n/cn","首次进入“神临”状态后，恢复“神圣御空”技能中损失的额外生命上限，并且当巴赫朗生命再次恢复至上限后进入更强大的“神临”状态，对周围2格敌人造成10% HP真实伤害并永久处于霸体状态，主动释放“神圣御空”后，会在技能范围内每个地图格召唤“圣光”，造成6% HP真实伤害，每次释放时“圣光”命中相同目标的后续伤害降低10%。"],["/skills/4/variants/0/description_i18n/jp","初めて「降臨」状態になった後、スキル「神聖飛行」で減少した追加のHP上限をすべて回復。自身のHPが再びHP上限まで回復した後、さらに強化した「降臨」状態になり、周囲2マス範囲内の敵に10% HPの確定ダメージを与える。強化した「降臨」状態になると、以下の効果を獲得：永続的なスーパーアーマー効果を獲得、アクティブで「神聖飛行」を発動するたびに、スキル範囲内のすべてのマスに「聖光」を召喚し、6% HPの確定ダメージを与える。1回の「神聖飛行」発動で同じ敵に複数の「聖光」がヒットした場合、2本目以降のダメージ-10%"],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":71,"end":77,"tooltip_key":"stat:HP"},{"start":86,"end":88,"tooltip_key":"keyword:uncontrol"},{"start":124,"end":129,"tooltip_key":"stat:HP"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/jp",[{"start":91,"end":97,"tooltip_key":"stat:HP"},{"start":137,"end":145,"tooltip_key":"keyword:uncontrol"},{"start":195,"end":200,"tooltip_key":"stat:HP"}]],["/skills/4/variants/1/description_i18n/cn","召唤“圣光”造成的伤害提高至8% HP。"],["/skills/4/variants/1/description_i18n/jp","「聖光」のダメージが8% HPにUP"],["/skills/4/variants/1/description_tooltip_spans_i18n/cn",[{"start":14,"end":19,"tooltip_key":"stat:HP"}]],["/skills/4/variants/1/description_tooltip_spans_i18n/jp",[{"start":10,"end":15,"tooltip_key":"stat:HP"}]],["/skills/4/variants/2/description_i18n/cn","召唤“圣光”造成的伤害提高至10% HP。"],["/skills/4/variants/2/description_i18n/jp","「聖光」のダメージが10% HPにUP"],["/skills/4/variants/2/description_tooltip_spans_i18n/cn",[{"start":14,"end":20,"tooltip_key":"stat:HP"}]],["/skills/4/variants/2/description_tooltip_spans_i18n/jp",[{"start":10,"end":16,"tooltip_key":"stat:HP"}]],["/skills/4/variants/3/description_i18n/cn","每次进入“神临”状态时，移除自身所有可驱散的负面状态并且永久提高10%攻击力，第二次进入“神临”状态时还会在自身周围2格范围内召唤“圣光”造成10% HP真实伤害。"],["/skills/4/variants/3/description_i18n/jp","「降臨」状態になるたびに、自身に付与されている解除可能なデバフをすべて解除し、永続的に自身の攻撃力+10%。2回目に「降臨」状態になった時、自身の周囲2マス範囲内に「聖光」を召喚し、10% HPの確定ダメージを与える"],["/skills/4/variants/3/description_tooltip_spans_i18n/cn",[{"start":71,"end":77,"tooltip_key":"stat:HP"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/jp",[{"start":91,"end":97,"tooltip_key":"stat:HP"}]],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","圣光附带的伤害会削减非首领敌人一定比例的生命上限，会使首领敌人额外失去生命。"],["/skills/5/simple_description_i18n/jp","「聖光」（聖剣に付与される「聖光」を含む）でボス以外の敵にダメージを与えた場合、対象のHP上限が与えたダメージの一定割合分DOWN。敵ボスにダメージを与えた場合、対象のHPが流失"],["/skills/5/variants/0/description_i18n/cn","“圣光”对非首领敌人造成伤害时会削减目标相当于伤害量70%的生命上限，累计削减部分不超过目标40%最大生命值以及巴赫朗800%攻击力；对首领敌人造成伤害则使其流失0.7% HP的生命值。"],["/skills/5/variants/0/description_i18n/jp","「聖光」（聖剣に付与される「聖光」を含む）でボス以外の敵にダメージを与えた場合、対象のHP上限が与えたダメージの70%分DOWN。減少量は対象のHP上限×40%とバハラムの攻撃力×800%のどちらも超えない。敵ボスにダメージを与えた場合、対象は0.7% HPのHPが流失"],["/skills/5/variants/0/description_tooltip_spans_i18n/cn",[{"start":81,"end":88,"tooltip_key":"stat:HP"}]],["/skills/5/variants/0/description_tooltip_spans_i18n/jp",[{"start":122,"end":129,"tooltip_key":"stat:HP"}]],["/exclusive_equipment/name_i18n/cn","圣辉"],["/exclusive_equipment/name_i18n/jp","輝く聖剣"]]}