/0/description_i18n/jp","自身の物理防御×340% + 3%と魔法防御×340% + 3%の合計値分のシールドを8秒間獲得。その後、敵1体に強烈な一撃を放ち、150% + 15% ATKのダメージと中断効果を与え、4秒間の武装解除状態を付与"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":26,"end":31,"power_type":"skill","parameter":"SArg1"},{"start":40,"end":45,"power_type":"skill","parameter":"SArg2"},{"start":71,"end":77,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":12,"end":17,"power_type":"skill","parameter":"SArg1"},{"start":27,"end":32,"power_type":"skill","parameter":"SArg2"},{"start":70,"end":76,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":67,"end":81,"tooltip_key":"stat:ATK"},{"start":86,"end":90,"tooltip_key":"keyword:interrupteff"},{"start":94,"end":96,"tooltip_key":"keyword:disarm"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":66,"end":80,"tooltip_key":"stat:ATK"},{"start":86,"end":90,"tooltip_key":"keyword:interrupteff"},{"start":98,"end":104,"tooltip_key":"keyword:disarm"}]],["/skills/1/variants/1/description_i18n/cn","护盾的抵御值提升至自身360% + 3%的护甲以及360% + 3%的魔抗之和。"],["/skills/1/variants/1/description_i18n/jp","シールド値が自身の物理防御×360% + 3%と魔法防御×360% + 3%の合計値分にUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":15,"end":20,"power_type":"skill","parameter":"SArg1"},{"start":29,"end":34,"power_type":"skill","parameter":"SArg2"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":18,"end":23,"power_type":"skill","parameter":"SArg1"},{"start":33,"end":38,"power_type":"skill","parameter":"SArg2"}]],["/skills/1/variants/2/description_i18n/cn","护盾的抵御值提升至自身380% + 3%的护甲以及380% + 3%的魔抗之和。"],["/skills/1/variants/2/description_i18n/jp","シールド値が自身の物理防御×380% + 3%と魔法防御×380% + 3%の合計値分にUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":15,"end":20,"power_type":"skill","parameter":"SArg1"},{"start":29,"end":34,"power_type":"skill","parameter":"SArg2"}]],[