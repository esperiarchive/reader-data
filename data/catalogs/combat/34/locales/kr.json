9,"power_type":"skill","parameter":"SArg1"},{"start":105,"end":109,"power_type":"skill","parameter":"SArg5"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":26,"end":40,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/kr",[{"start":49,"end":63,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","每次回旋击造成的伤害提升至150% + 10% ATK。"],["/skills/2/variants/1/description_i18n/kr","매번 회선격으로 입히는 대미지가 150% + 10% ATK로 증가한다."],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":17,"end":23,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/1/description_power_spans_i18n/kr",[{"start":22,"end":28,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/kr",[{"start":18,"end":32,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","每次回旋击造成的伤害提升至160% + 10% ATK。"],["/skills/2/variants/2/description_i18n/kr","매번 회선격으로 입히는 대미지가 160% + 10% ATK로 증가한다."],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":17,"end":23,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/2/description_power_spans_i18n/kr",[{"start":22,"end":28,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/kr",[{"start":18,"end":32,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","每次回旋击造成的伤害提升至170% + 10% ATK。"],["/skills/2/variants/3/description_i18n/kr","매번 회선격으로 입히는 대미지가 170% + 10% ATK로 증가한다."],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":17,"end":23,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/3/description_power_spans_i18n/kr",[{"start":22,"end":28,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/kr",[{"start":18,"end":32,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/kr","영웅 마스터리"],["/skills/3/simple_description_i18n/cn","提高自身暴击。"],["/skills/3/simple_description_i18n/kr","자신의 치명타가 증가한다."],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的暴击提升24点。"],["/skills/3/variants/0/description_i18n/kr","전투 중, 자신의 치명타가 24 증가한다."],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的暴击提升32点。"],["/skills/3/variants/1/description_i18n/kr","전투 중, 자신의 치명타가 32 증가한다."],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的暴击提升40点。"],["/skills/3/variants/2/description_i18n/kr","전투 중, 자신의 치명타가 40 증가한다."],["/skills/4/name_i18n/cn","秘光之盾"],["/skills/4/name_i18n/kr","시크릿 실드"],["/skills/4/simple_description_i18n/cn","战斗开始时，获得一个护盾。"],["/skills/4/simple_description_i18n/kr","전투 시작 시, 실드 하나를 획득한다."],["/skills/4/variants/0/description_i18n/cn","“先发制人”释放后，自身获得一个抵御450% ATK伤害的护盾。"],["/skills/4/variants/0/description_i18n/kr","선제공격 시전 후, 자신이 450% ATK의 대미지를 막을 수 있는 실드를 획득한다."],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":18,"end":26,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/kr",[{"start":15,"end":23,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_i18n/cn","护盾的抵御值提升至500% ATK。"],["/skills/4/variants/1/description_i18n/kr","실드 수치가 500% ATK로 증가한다."],["/skills/4/variants/1/description_tooltip_spans_i18n/cn",[{"start":9,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_tooltip_spans_i18n/kr",[{"start":7,"end":15,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/2/description_i18n/cn","“疾影旋击”持续期间，若标记的敌人被击败，该敌人附近2格范围内的敌人受到4秒恐惧效果。"],["/skills/4/variants/2/description_i18n/kr","질풍의 회전공격 지속 시간 동안 표식된 적 처치 시, 해당 적 주변 2칸 범위 내의 적은 4초간 공포 효과를 받는다."],["/skills/4/variants/3/description_i18n/cn","护盾的抵御值提升至600% ATK。"],["/skills/4/variants/3/description_i18n/kr","실드 수치가 600% ATK로 증가한다."],["/skills/4/variants/3/description_tooltip_spans_i18n/cn",[{"start":9,"end":17,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/kr",[{"start":7,"end":15,"tooltip_key":"stat:ATK"}]],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/kr","각성의 힘"],["/skills/5/simple_description_i18n/cn","每次回旋击还能降低目标受愈。"],["/skills/5/simple_description_i18n/kr","매회 회선격마다 목표의 활력이 감소한다."],["/skills/5/variants/0/description_i18n/cn","每次回旋击还能在3秒内降低目标60点受愈。"],["/skills/5/variants/0/description_i18n/kr","매회 회선격으로 3초 동안 목표의 활력을 60 감소시킨다."],["/skills/5/variants/1/description_i18n/cn","技能“先发制人”造成的伤害额外提升250% ATK，释放“疾影旋击”期间，获得50点攻击速度。对“先发制人”目标的普攻还会附带其已损生命值12%的伤害，额外伤害部分不超过240% ATK。若和伊莎贝拉一同上阵，自身获得“秘光之盾”时，还会为伊莎贝拉提供等量护盾。"],["/skills/5/variants/1/description_i18n/kr","선제공격으로 입히는 대미지가 추가로 250% ATK 증가한다. 질풍의 회전공격 시전 중 공격 속도를 50 획득한다. 선제공격 목표에게 일반 공격 시, 추가로 해당 목표가 잃은 HP의 12%만큼 대미지를 입힌다(추가 대미지는 240% ATK를 초과하지 않음). 이사벨라와 함께 출전할 경우, 자신이 시크릿 실드 획득 시 이사벨라에게도 같은 수치의 실드를 부여한다."],["/skills/5/variants/1/description_tooltip_spans_i18n/cn",[{"start":17,"end":25,"tooltip_key":"stat:ATK"},{"start":85,"end":93,"tooltip_key":"stat:ATK"}]],["/skills/5/variants/1/description_tooltip_spans_i18n/kr",[{"start":20,"end":28,"tooltip_key":"stat:ATK"},{"start":125,"end":133,"tooltip_key":"stat:ATK"}]],["/exclusive_equipment/name_i18n/cn","恶毒双刃"],["/exclusive_equipment/name_i18n/kr","맹독의 양날검"]]}