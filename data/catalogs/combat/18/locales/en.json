o an enemy and knocking them back {KnockBack} tiles. He also gains a shield that blocks 300% + 30% ATK damage for 8s."],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":46,"end":52,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/0/description_power_spans_i18n/en",[{"start":147,"end":153,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":5,"end":12,"tooltip_key":"stat:ATK"},{"start":42,"end":56,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/en",[{"start":39,"end":46,"tooltip_key":"stat:ATK"},{"start":143,"end":157,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","还会对敌人造成1秒的眩晕。"],["/skills/1/variants/1/description_i18n/en","Stuns the enemy for 1s."],["/skills/1/variants/2/description_i18n/cn","护盾抵御值上升至310% + 30% ATK。"],["/skills/1/variants/2/description_i18n/en","Increases shield value to 310% + 30% ATK."],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":12,"end":18,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/2/description_power_spans_i18n/en",[{"start":30,"end":36,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":8,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/en",[{"start":26,"end":40,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","护盾抵御值上升至320% + 30% ATK。"],["/skills/1/variants/3/description_i18n/en","Increases shield value to 320% + 30% ATK."],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":12,"end":18,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/3/description_power_spans_i18n/en",[{"start":30,"end":36,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":8,"end":22,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/en",[{"start":26,"end":40,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","圣光祝福"],["/skills/2/name_i18n/en","Divine Light Blessing"],["/skills/2/simple_description_i18n/cn","自身获得护盾时，治疗多名友军。"],["/skills/2/simple_description_i18n/en","Lucius heals an ally when gaining a shield."],["/skills/2/variants/0/description_i18n/cn","每当卢修斯获得护盾时，都会产生治愈之力为最虚弱的1名其他友军恢复80% + 10% ATK+本次获得护盾值20%的生命值。"],["/skills/2/variants/0/description_i18n/en","When gaining a shield, Lucius uses Healing Power to recover HP that equals 80% + 10% ATK + 20% of shield value for 1 weakest ally."],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":35,"end":41,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_power_spans_i18n/en",[{"start":78,"end":84,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":20,"end":24,"tooltip_key":"keyword:weakest"},{"start":32,"end":45,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/en",[{"start":75,"end":88,"tooltip_key":"stat:ATK"},{"start":117,"end":124,"tooltip_key":"keyword:weakest"}]],["/skills/2/variants/1/description_i18n/cn","自己受到的护盾效果提升8%。"],["/skills/2/variants/1/description_i18n/en","Increases shield effect gained by 8%."],["/skills/2/variants/2/description_i18n/cn","自己受到的护盾效果提升14%。"],["/skills/2/variants/2/description_i18n/en","Increases shield effect gained by 14%."],["/skills/2/variants/3/description_i18n/cn","自己受到的护盾效果提升20%。"],["/skills/2/variants/3/description_i18n/en","Increases shield effect gained by 20%."],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/en","Hero Focus"],["/skills/3/simple_description_i18n/cn","提高自身治愈。"],["/skills/3/simple_description_i18n/en","Increases Healing during battle."],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的治愈提升11点。"],["/skills/3/variants/0/description_i18n/en","Increases Healing by 11 during battle."],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的治愈提升15点。"],["/skills/3/variants/1/description_i18n/en","Increases Healing by 15 during battle."],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的治愈提升19点。"],["/skills/3/variants/2/description_i18n/en","Increases Healing by 19 during battle."],["/skills/4/name_i18n/cn","神圣洗礼"],["/skills/4/name_i18n/en","Sacred Beam"],["/skills/4/simple_description_i18n/cn","对面前一片区域内的敌人造成伤害，并降低其攻击力。"],["/skills/4/simple_description_i18n/en","Lucius deals damage to enemies in a frontal area and reduces their ATK."],["/skills/4/variants/0/description_i18n/cn","对面前3格宽、4格长的区域发射圣光，对范围内的所有敌人造成90% ATK伤害，并降低其8%攻击力，持续4秒。"],["/skills/4/variants/0/description_i18n/en","Lucius shoots a Divine Light covering the frontal area (3-tile wide and 4-tile long), dealing 90% ATK damage to all enemies within and reducing their ATK by 8% for 4s."],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":29,"end":36,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/en",[{"start":94,"end":101,"tooltip_key":"stat:ATK"}]],["/skills/4/variants/1/description_i18n/cn","本技能每命中一名敌人，还会使自身获得3% HP的护盾，持续4秒。"],["/skills/4/variants/1/description_i18n/en","Gains a 3% HP shield for 4s per every enemy hit."],["/skills/4/variants/1/description_tooltip_spans_i18n/cn",[{"start":18,"end":23,"tooltip_key":"stat:HP"}]],["/skills/4/variants/1/description_tooltip_spans_i18n/en",[{"start":8,"end":13,"tooltip_key":"stat:HP"}]],["/skills/4/variants/2/description_i18n/cn","降低攻击力效果提升至10%。"],["/skills/4/variants/2/description_i18n/en","Reduces enemies' ATK by 10%."],["/skills/4/variants/3/description_i18n/cn","降低攻击力效果提升至12%。"],["/skills/4/variants/3/description_i18n/en","Reduces enemies' ATK by 12%."],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/en","Enhance Force"],["/skills/5/simple_description_i18n/cn","技能“圣光祝福”治疗的友军数量增加。"],["/skills/5/simple_description_i18n/en","Lucius heals an additional ally with Divine Light Blessing."],["/skills/5/variants/0/description_i18n/cn","技能“圣光祝福”治疗的友军数量增加1名。"],["/skills/5/variants/0/description_i18n/en","Lucius heals 1 more ally with Divine Light Blessing."],["/exclusive_equipment/name_i18n/cn","白色巨塔"],["/exclusive_equipment/name_i18n/en","Ivory Towershield"]]}