":12,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/jp",[{"start":12,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","石像壁垒"],["/skills/1/name_i18n/jp","石像の壁"],["/skills/1/simple_description_i18n/cn","佐尔娅苏醒时受到伤害降低。主动释放时，对面前敌人造成伤害并击倒。"],["/skills/1/simple_description_i18n/jp","目覚めている間、被ダメージDOWN。アクティブ効果：前方扇状範囲内の敵にダメージを与え、ノックダウンさせる"],["/skills/1/variants/0/description_i18n/cn","被动地，佐尔娅苏醒时会激活石化皮肤，使自身受到所有伤害降低70%，此效果会在后续10秒内逐渐减弱消失。主动释放时，拟化巨翅虚影，对前方2格扇形范围内的敌方目标造成270% + 30% ATK伤害并将其击倒2秒。"],["/skills/1/variants/0/description_i18n/jp","パッシブ効果：目覚めるたびに、石の肌を有効化し、被ダメージ-70%。この軽減効果は徐々に弱まり、10秒後になくなる。アクティブ効果：巨大な翼の虚影を広げ、前方2マスの扇状範囲内の敵に270% + 30% ATKのダメージを与え、2秒間、ノックダウンさせる"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":85,"end":91,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":95,"end":101,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":81,"end":95,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":91,"end":105,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","主动释放时的伤害提高至280% + 30% ATK。"],["/skills/1/variants/1/description_i18n/jp","アクティブ効果のダメージが280% + 30% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":17,"end":23,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","主动释放时的伤害提高至290% + 30% ATK。"],["/skills/1/variants/2/description_i18n/jp","アクティブ効果のダメージが290% + 30% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":17,"end":23,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","主动释放时的伤害提高至300% + 30% ATK。"],["/skills/1/variants/3/description_i18n/jp","アクティブ効果のダメージが300% + 30% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":17,"end":23,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","噬体打击"],["/skills/2/name_i18n/jp","魔法衝撃"],["/skills/2/simple_description_i18n/cn","佐尔娅苏醒时获得生命汲取。主动释放时，对附近敌人造成多次伤害。"],["/skills/2/simple_description_i18n/jp","目覚めている間、ライフスティールUP。アクティブ効果：周囲の敵にダメージを複数回与える"],["/skills/2/variants/0/description_i18n/cn","被动地，佐尔娅苏醒期间获得嗜血，使自身提高20点生命汲取，每当一名敌方英雄在自身2格范围内被击败，自身立即恢复30%最大生命值。主动释放时，对周身2格范围内的所有敌人造成2次85% + 10% ATK伤害，随后对范围内目标进行震慑攻击，造成1次250% + 30% ATK的伤害并附带目标已损生命值15%的额外伤害，最高不超过150% ATK。"],["/skills/2/variants/0/description_i18n/jp","パッシブ効果：目覚めている間、ライフスティール+20。自身の周囲2マス以内で敵の英雄が撃破されるたびに、自身のHPをHP上限の30%分回復。アクティブ効果：周囲2マス以内の敵に85% + 10% ATKのダメージを2回与え、その後、魔法陣を発動し、範囲内の敵に250% + 30% ATKのダメージを与え、追加でそれぞれのHP減少量×15%のダメージを与える。この追加ダメージは150% ATKを超えない"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":90,"end":96,"power_type":"skill","parameter":"PlusRatio"},{"start":126,"end":132,"power_type":"skill","parameter":"SArg2"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":91,"end":97,"power_type":"skill","parameter":"PlusRatio"},{"start":134,"end":140,"power_type":"skill","parameter":"SArg2"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":87,"end":100,"tooltip_key":"stat:ATK"},{"start":122,"end":136,"tooltip_key":"stat:ATK"},{"start":163,"end":171,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":88,"end":101,"tooltip_key":"stat:ATK"},{"start":130,"end":144,"tooltip_key":"stat:ATK"},{"start":189,"end":197,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","主动释放时的2次伤害提高至90% + 10% ATK，震慑攻击的基础伤害提高至260% + 30% ATK。"],["/skills/2/variants/1/description_i18n/jp","アクティブ効果の最初の2回のダメージが90% + 10% ATKにUPし、その後の魔法陣攻撃の基礎ダメージが260% + 30% ATKにUP"],["/skills/2/variants/1/description_power_spans_i18n/cn",[{"start":16,"end":22,"power_type":"skill","parameter":"PlusRatio"},{"start":43,"end":49,"power_type":"skill","parameter":"SArg2"}]],["/skills/2/variants/1/description_power_spans_i18n/jp",[{"start":22,"end":28,"power_type":"skill","parameter":"PlusRatio"},{"start":58,"end":64,"power_type":"skill","parameter":"SArg2"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":13,"end":26,"tooltip_key":"stat:ATK"},{"start":39,"end":53,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/jp",[{"start":19,"end":32,"tooltip_key":"stat:ATK"},{"start":54,"end":68,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","主动释放时的2次伤害提高至95% + 10% ATK，震慑攻击的基础伤害提高至270% + 30% ATK。"],["/skills/2/variants/2/description_i18n/jp","アクティブ効果の最初の2回のダメージが95% + 10% ATKにUPし、その後の魔法陣攻撃の基礎ダメージが270% + 30% ATKにUP"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":16,"end":22,"power_type":"skill","parameter":"PlusRatio"},{"start":43,"end":49,"power_type":"skill","parameter":"SArg2"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":22,"end":28,"power_type":"skill","parameter":"PlusRatio"},{"start":58,"end":64,"power_type":"skill","parameter":"SArg2"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":13,"end":26,"tooltip_key":"stat:ATK"},{"start":39,"end":53,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/jp",[{"start":19,"end":32,"tooltip_key":"stat:ATK"},{"start":54,"end":68,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","主动释放时的2次伤害提高至100% + 10% ATK，震慑攻击的基础伤害提高至280% + 30% ATK。"],["/skills/2/variants/3/description_i18n/jp","アクティブ効果の最初の2回のダメージが100% + 10% ATKにUPし、その後の魔法陣攻撃の基礎ダメージが280% + 30% ATKにUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":17,"end":23,"power_type":"skill","parameter":"PlusRatio"},{"start":44,"end":50,"power_type":"skill","parameter":"SArg2"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":23,"end":29,"power_type":"skill","parameter":"PlusRatio"},{"start":59,"end":65,"power_type":"skill","parameter":"SArg2"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":13,"end":27,"tooltip_key":"stat:ATK"},{"start":40,"end":54,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/jp",[{"start":19,"end":33,"tooltip_key":"stat:ATK"},{"start":55,"end":69,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","造成伤害提升，附近敌人不少于2名时造成伤害额外提升。"],["/skills/3/simple_description_i18n/jp","自身の与ダメージUP。近くに敵が2体以上いる場合、追加で自身の与ダメージUP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身造成伤害提升9%。自身周围2格内的敌人数量不少于2人时，造成伤害额外提升3%。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、与ダメージ+9%。自身の周囲2マス以内に敵が2体以上いる場合、追加で自身の与ダメージ+3%"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身造成伤害提升12%。自身周围2格内的敌人数量不少于2人时，造成伤害额外提升4%。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、与ダメージ+12%。自身の周囲2マス以内に敵が2体以上いる場合、追加で自身の与ダメージ+4%"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身造成伤害提升15%。自身周围2格内的敌人数量不少于2人时，造成伤害额外提升5%。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、与ダメージ+15%。自身の周囲2マス以内に敵が2体以上いる場合、追加で自身の与ダメージ+5%"],["/skills/4/name_i18n/cn","震慑力场"],["/skills/4/name_i18n/jp","鎮守の力場"],["/skills/4/simple_description_i18n/cn","佐尔娅苏醒期间激活镇守力场，降低敌人的移速和急速，并为自身提高高额急速。"],["/skills/4/simple_description_i18n/jp","目覚めている間、鎮守の力場を展開。範囲内にいる敵の移動速度と速度DOWN、自身の速度が大幅にUP"],["/skills/4/variants/0/description_i18n/cn","佐尔娅苏醒期间，会激活周身2格半径的镇守力场，使其中的所有敌人降低80%的移动速度和60点急速，并使自身的急速提高20点。其他友方英雄每次释放终极技能时，都将使镇守力场的急速加成永久提高15点，最多叠加4次。"],["/skills/4/variants/0/description_i18n/jp","目覚めている間、自身に追従する半径2マスの鎮守の力場を展開。力場範囲内にいる敵の移動速度-80%、速度-60、自身の速度+20。他の味方英雄が必殺技を発動するたびに、鎮守の力場による速度上昇量が永続的に+15、最大4回まで重複可能"],["/skills/4/variants/1/description_i18n/cn","镇守力场提供的急速提高至30点。"],["/skills/4/variants/1/description_i18n/jp","鎮守の力場による速度上昇量が30にUP"],["/skills/4/variants/2/description_i18n/cn","自身生命值比例不低于50%时，佐尔娅始终处于霸体状态。"],["/skills/4/variants/2/description_i18n/jp","HPが50%以上の場合、スーパーアーマーを維持"],["/skills/4/variants/2/description_tooltip_spans_i18n/cn",[{"start":22,"end":24,"tooltip_key":"keyword:uncontrol"}]],["/skills/4/variants/2/description_tooltip_spans_i18n/jp",[{"start":12,"end":20,"tooltip_key":"keyword:uncontrol"}]],["/skills/4/variants/3/description_i18n/cn","镇守力场提供的急速提高至40点。"],["/skills/4/variants/3/description_i18n/jp","鎮守の力場による速度上昇量が40にUP"],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","佐尔娅受到最后一击时免于被击败，直接进入休眠状态。"],["/skills/5/simple_description_i18n/jp","トドメを食らった時、撃破を回避し、直ちに休眠状態に入る"],["/skills/5/variants/0/description_i18n/cn","当佐尔娅遭受最后一击时，将会耗尽精神力免于被击败，立即进入休眠状态。该效果每场战斗只能触发一次。"],["/skills/5/variants/0/description_i18n/jp","自身がトドメを食らった時、精神力をすべて使い、撃破を回避し、休眠状態に入る。この効果は1度の戦闘につき、1回まで発動可能"],["/skills/5/variants/0/description_tooltip_spans_i18n/cn",[{"start":6,"end":10,"tooltip_key":"keyword:fatal"}]],["/skills/5/variants/0/description_tooltip_spans_i18n/jp",[{"start":3,"end":6,"tooltip_key":"keyword:fatal"}]],["/exclusive_equipment/name_i18n/cn","灵灯石翼"],["/exclusive_equipment/name_i18n/jp","霊灯の石翼"]]}