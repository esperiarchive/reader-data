0/variants/4/description_tooltip_spans_i18n/cn",[{"start":5,"end":21,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/kr",[{"start":5,"end":21,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","猩红剔骨"],["/skills/1/name_i18n/kr","진홍빛 절단"],["/skills/1/simple_description_i18n/cn","用餐刀切割敌人，对一定范围内的敌人造成多次伤害。"],["/skills/1/simple_description_i18n/kr","식칼로 적군을 베어, 일정 범위 내 적군에게 여러 차례 대미지를 입힌다."],["/skills/1/variants/0/description_i18n/cn","法蒂玛用餐刀切割敌方最密集的区域，对7格范围内的每名敌人造成总共450% + 50% ATK伤害。本技能“狂热”后会额外进行切割造成220% + 25% ATK伤害。"],["/skills/1/variants/0/description_i18n/kr","보라시아가 식칼로 적군이 가장 밀집한 구역을 베어, 주변 7칸 범위 내 각 적군에게 총 450% + 50% ATK의 대미지를 입힌다. 해당 스킬이 광란 상태가 되면 추가로 베어 220% + 25% ATK의 대미지를 입힌다."],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":36,"end":42,"power_type":"skill","parameter":"PlusRatio"},{"start":70,"end":76,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/0/description_power_spans_i18n/kr",[{"start":53,"end":59,"power_type":"skill","parameter":"PlusRatio"},{"start":103,"end":109,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":32,"end":46,"tooltip_key":"stat:ATK"},{"start":66,"end":80,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/kr",[{"start":49,"end":63,"tooltip_key":"stat:ATK"},{"start":99,"end":113,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","伤害提高至460% + 50% ATK，额外切割伤害提高至230% + 25% ATK。"],["/skills/1/variants/1/description_i18n/kr","대미지가 460% + 50% ATK로 증가하고, 추가로 베는 대미지가 230% + 25% ATK로 증가한다."],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"},{"start":33,"end":39,"power_type":"skill","parameter":"SArg0"}]],["/skills/1/variants/1/description_power_spans_i18n/kr",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"},{"start":43,"end":49,"power_type":"skill","parameter":"SArg0"}]],["/s