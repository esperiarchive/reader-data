/description_tooltip_spans_i18n/jp",[{"start":20,"end":34,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","露西飞踢"],["/skills/1/name_i18n/jp","ルーシィキック"],["/skills/1/simple_description_i18n/cn","对全场累计伤害最高的敌人进行远距离的飞踢，造成一定伤害并使其眩晕。"],["/skills/1/simple_description_i18n/jp","合計ダメージが最も高い敵に遠距離からのキックを繰り出し、一定のダメージを与え、スタンを付与"],["/skills/1/variants/0/description_i18n/cn","对全场累计伤害最高的1名敌人进行远距离的飞踢，造成240% + 20% ATK的伤害与持续2.5秒的眩晕。飞踢后露西会回到释放技能前的位置，且技能期间处于霸体状态。"],["/skills/1/variants/0/description_i18n/jp","合計ダメージが最も高い敵1体に遠距離からのキックを繰り出し、240% + 20% ATKのダメージを与え、2.5秒間のスタンを付与。キック後、ルーシィはキック前の位置に戻る。キック発動中、ルーシィはスーパーアーマー状態になる"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":29,"end":35,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":34,"end":40,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":25,"end":39,"tooltip_key":"stat:ATK"},{"start":77,"end":79,"tooltip_key":"keyword:uncontrol"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":30,"end":44,"tooltip_key":"stat:ATK"},{"start":99,"end":107,"tooltip_key":"keyword:uncontrol"}]],["/skills/1/variants/1/description_i18n/cn","伤害提升至260% + 20% ATK。"],["/skills/1/variants/1/description_i18n/jp","ダメージが260% + 20% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","伤害提升至280% + 20% ATK。"],["/skills/1/variants/2/description_i18n/jp","ダメージが280% + 20% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","伤害提升至300% + 20% ATK。"],["/skills/1/variants/3/description_i18n/jp","ダメージが300% + 20% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":9,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":5,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","星灵衣-水瓶座形态"],["/skills/2/name_i18n/jp","星霊衣・アクエリアスフォーム"],["/skills/2/simple_description_i18n/cn","释放终极技能后变为“星灵衣-水瓶座形态”，可以使用魔法制造水龙卷造成范围伤害，击飞敌人并使目标眩晕。"],["/skills/2/simple_description_i18n/jp","必殺技発動後、ルーシィは「星霊衣・アクエリアスフォーム」になり、魔法で水の竜巻を起こせるようになる。水の竜巻は敵に範囲ダメージを与え、対象を打ち上げ、スタンを付与"],["/skills/2/variants/0/description_i18n/cn","自己在释放终极技能后变为“星灵衣-水瓶座形态”直至战斗结束。之后自己也能够使用水魔法制造水龙卷，对以敌人最密集处为中心的半径1格范围内的所有敌人造成300% + 30% ATK的伤害，并使受影响的敌人被击飞并眩晕持续2秒。“星灵衣-水瓶座形态”下自身攻击距离为10。"],["/skills/2/variants/0/description_i18n/jp","必殺技発動後、ルーシィは永続的に「星霊衣・アクエリアスフォーム」になり、魔法で水の竜巻を起こせるようになる。水の竜巻は敵が最も密集するエリアを中心に、半径1マス以内の敵に300% + 30% ATKのダメージを与え、打ち上げ、2秒間のスタンを付与。「星霊衣・アクエリアスフォーム」の間、ルーシィの攻撃距離は10"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":78,"end":84,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":89,"end":95,"power_type":"skill","parameter":"SArg0"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":74