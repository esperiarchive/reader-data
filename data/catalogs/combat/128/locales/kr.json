start":35,"end":49,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/3/description_tooltip_spans_i18n/kr",[{"start":13,"end":26,"tooltip_key":"stat:ATK"},{"start":48,"end":62,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_i18n/cn","细剑斩击伤害提升至100% + 10% ATK，最终魔力爆炸的伤害提升至600% + 40% ATK。"],["/skills/0/variants/4/description_i18n/kr","레이피어 참격 대미지가 100% + 10% ATK로 증가하고, 최종 마력 폭발 대미지가 600% + 40% ATK로 증가한다."],["/skills/0/variants/4/description_power_spans_i18n/cn",[{"start":13,"end":19,"power_type":"ultimate","parameter":"PlusRatio"},{"start":40,"end":46,"power_type":"ultimate","parameter":"SArg3"}]],["/skills/0/variants/4/description_power_spans_i18n/kr",[{"start":17,"end":23,"power_type":"ultimate","parameter":"PlusRatio"},{"start":53,"end":59,"power_type":"ultimate","parameter":"SArg3"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/cn",[{"start":9,"end":23,"tooltip_key":"stat:ATK"},{"start":36,"end":50,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/kr",[{"start":13,"end":27,"tooltip_key":"stat:ATK"},{"start":49,"end":63,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","优雅连击"],["/skills/1/name_i18n/kr","우아한 연격"],["/skills/1/simple_description_i18n/cn","战斗开始时，奥利安会对自己的佩剑进行附魔。主动使用时，对目标造成多次伤害。"],["/skills/1/simple_description_i18n/kr","전투 시작 시, 오리안이 자신의 검에 마법을 부여한다.\n액티브: 목표에게 수차례 대미지를 입힌다."],["/skills/1/variants/0/description_i18n/cn","战斗开始时，奥利安会对自己的佩剑附魔，持续15 + 2秒。“附魔”状态下，奥利安的能量获取速度提升25%，并且使用技能或普攻造成的伤害会对敌人造成一个可叠加的“灼伤”效果，持续3秒，灼伤每秒造成的伤害相当于本次原始伤害量的20% + 2%。主动使用时，奥利安向目标连续刺击4次，每次造成90% + 10% ATK伤害。"],["/skills/1/variants/0/description_i18n/kr","전투 시작 시, 오리안이 15 + 2초 동안 자신의 검에 마법을 부여한다. 마법 부여 상태의 오리안은 에너지 획득 속도가 25% 증가하며, 스킬 또는 일반 공격으로 대미지를 입히면 적군에게 중첩 가능한 발화 효과를 3초 동안 부여한다. 발화 효과의 초당 대미지는 이번 기본 대미지량의 20% + 2%이다.\n액티브: 오리안이 목표를 연속 4회 찔러, 회당 90% + 10% ATK의 대미지를 입힌다."],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":23,"end":27,"power_type":"skill","parameter":"SArg0"},{"start":114,"end":119,"power_type":"skill","parameter":"SArg2"},{"start":146,"end":152,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/kr",[{"start":16,"end":20,"power_type":"skill","parameter":"SArg0"},{"start":162,"end":167,"power_type":"skill","parameter":"SArg2"},{"start":201,"end":207,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":143,"end":156,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/kr",[{"start":198,"end":211,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","连续刺击伤害提升至100% + 10% ATK。"],["/skills/1/variants/1/description_i18n/kr","연속 찌르기의 대미지가 100% + 10% ATK로 증가한다."],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":13,"end":19,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/kr",[{"start":17,"end":23,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":9,"end":23,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/kr",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","连续刺击伤害提升至110% + 10% ATK。"],["/skills/1/variants/2/description_i18n/kr","연속 찌르기의 대미지가 110% + 10% ATK로 증가한다."],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":13,"end":19,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/kr",[{"start":17,"end":23,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":9,"end":23,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/kr",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","连续刺击伤害提升至120% + 10% ATK。"],["/skills/1/variants/3/description_i18n/kr","연속 찌르기의 대미지가 120% + 10% ATK로 증가한다."],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":13,"end":19,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/kr",[{"start":17,"end":23,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":9,"end":23,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/kr",[{"start":13,"end":27,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","恩威并施"],["/skills/2/name_i18n/kr","은혜와 위엄"],["/skills/2/simple_description_i18n/cn","奥利安在战斗中招纳“党羽”强化自身力量。主动使用时，施展剑气对前方扇形区域内敌人造成伤害并获得护盾。"],["/skills/2/simple_description_i18n/kr","오리안이 전투 중 추종자를 포섭해 자신의 힘을 강화한다.\n액티브: 검기를 휘둘러 전방 부채꼴 범위의 적군에게 대미지를 입히고, 실드를 획득한다."],["/skills/2/variants/0/description_i18n/cn","被动地，每当自身首次受到非永久属性提升效果时，会使“细剑附魔”的效果延长10秒，并将该友军视为“党羽”。主动使用时，奥利安向身前1格的扇形区域斩出魔力剑气，造成340% + 40% ATK伤害，自身获得相当于本次造成伤害量200%的护盾，持续6秒，并给所有“党羽”60%的该效果。"],["/skills/2/variants/0/description_i18n/kr","패시브: 자신이 처음으로 비영구 속성 버프를 받을 때마다, 레이피어 마법 부여의 효과가 10초 연장되며, 해당 아군을 추종자로 간주한다.\n액티브: 오리안이 전방 1칸 부채꼴 범위에 마력 검기를 휘둘러 340% + 40% ATK의 대미지를 입히고, 자신은 6초 동안 해당 공격으로 입힌 대미지량의 200%만큼 실드를 획득한다. 모든 추종자는 해당 실드량의 60%만큼 실드를 획득한다."],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":84,"end":90,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_power_spans_i18n/kr",[{"start":116,"end":122,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":80,"end":94,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/kr",[{"start":112,"end":126,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","魔力剑气造成伤害提升至400% ATK。"],["/skills/2/variants/1/description_i18n/kr","마력 검기로 입히는 대미지가 400% ATK로 증가한다."],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":11,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/kr",[{"start":16,"end":24,"tooltip_key"