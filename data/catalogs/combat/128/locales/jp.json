/3/description_tooltip_spans_i18n/jp",[{"start":12,"end":25,"tooltip_key":"stat:ATK"},{"start":40,"end":54,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_i18n/cn","细剑斩击伤害提升至100% + 10% ATK，最终魔力爆炸的伤害提升至600% + 40% ATK。"],["/skills/0/variants/4/description_i18n/jp","斬撃1回ごとのダメージが100% + 10% ATKにUPし、魔力爆発のダメージが600% + 40% ATKにUP"],["/skills/0/variants/4/description_power_spans_i18n/cn",[{"start":13,"end":19,"power_type":"ultimate","parameter":"PlusRatio"},{"start":40,"end":46,"power_type":"ultimate","parameter":"SArg3"}]],["/skills/0/variants/4/description_power_spans_i18n/jp",[{"start":16,"end":22,"power_type":"ultimate","parameter":"PlusRatio"},{"start":45,"end":51,"power_type":"ultimate","parameter":"SArg3"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/cn",[{"start":9,"end":23,"tooltip_key":"stat:ATK"},{"start":36,"end":50,"tooltip_key":"stat:ATK"}]],["/skills/0/variants/4/description_tooltip_spans_i18n/jp",[{"start":12,"end":26,"tooltip_key":"stat:ATK"},{"start":41,"end":55,"tooltip_key":"stat:ATK"}]],["/skills/1/name_i18n/cn","优雅连击"],["/skills/1/name_i18n/jp","優雅なる連撃"],["/skills/1/simple_description_i18n/cn","战斗开始时，奥利安会对自己的佩剑进行附魔。主动使用时，对目标造成多次伤害。"],["/skills/1/simple_description_i18n/jp","戦闘開始時、自身の剣に魔力をエンチャントする。アクティブ効果：対象にダメージを複数回与える"],["/skills/1/variants/0/description_i18n/cn","战斗开始时，奥利安会对自己的佩剑附魔，持续15 + 2秒。“附魔”状态下，奥利安的能量获取速度提升25%，并且使用技能或普攻造成的伤害会对敌人造成一个可叠加的“灼伤”效果，持续3秒，灼伤每秒造成的伤害相当于本次原始伤害量的20% + 2%。主动使用时，奥利安向目标连续刺击4次，每次造成90% + 10% ATK伤害。"],["/skills/1/variants/0/description_i18n/jp","戦闘開始時、自身の剣に15 + 2秒間、魔力をエンチャントする。「エンチャント」状態の間、自身のSP回復効率+25%、スキルまたは通常攻撃で敵にダメージを与えた時、その敵に3秒間の「熱傷」を付与（重複可能）。「熱傷」状態の敵は毎秒、付与元のスキルまたは通常攻撃の初期ダメージの20% + 2%分のダメージを受ける。アクティブ効果：対象に刺突攻撃を4回繰り出し、1回につき90% + 10% ATKのダメージを与える"],["/skills/1/variants/0/description_power_spans_i18n/cn",[{"start":23,"end":27,"power_type":"skill","parameter":"SArg0"},{"start":114,"end":119,"power_type":"skill","parameter":"SArg2"},{"start":146,"end":152,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_power_spans_i18n/jp",[{"start":13,"end":17,"power_type":"skill","parameter":"SArg0"},{"start":141,"end":146,"power_type":"skill","parameter":"SArg2"},{"start":188,"end":194,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/cn",[{"start":143,"end":156,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/0/description_tooltip_spans_i18n/jp",[{"start":185,"end":198,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_i18n/cn","连续刺击伤害提升至100% + 10% ATK。"],["/skills/1/variants/1/description_i18n/jp","刺突攻撃1回ごとのダメージが100% + 10% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":13,"end":19,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":18,"end":24,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":9,"end":23,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","连续刺击伤害提升至110% + 10% ATK。"],["/skills/1/variants/2/description_i18n/jp","刺突攻撃1回ごとのダメージが110% + 10% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":13,"end":19,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":18,"end":24,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":9,"end":23,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","连续刺击伤害提升至120% + 10% ATK。"],["/skills/1/variants/3/description_i18n/jp","刺突攻撃1回ごとのダメージが120% + 10% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":13,"end":19,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":18,"end":24,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":9,"end":23,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":14,"end":28,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","恩威并施"],["/skills/2/name_i18n/jp","飴と鞭"],["/skills/2/simple_description_i18n/cn","奥利安在战斗中招纳“党羽”强化自身力量。主动使用时，施展剑气对前方扇形区域内敌人造成伤害并获得护盾。"],["/skills/2/simple_description_i18n/jp","戦闘中に「配下」を増やし、「エンチャント」の持続時間を延長。アクティブ効果：剣圧を飛ばし、前方の扇状範囲内の敵にダメージを与え、自身はシールドを獲得"],["/skills/2/variants/0/description_i18n/cn","被动地，每当自身首次受到非永久属性提升效果时，会使“细剑附魔”的效果延长10秒，并将该友军视为“党羽”。主动使用时，奥利安向身前1格的扇形区域斩出魔力剑气，造成340% + 40% ATK伤害，自身获得相当于本次造成伤害量200%的护盾，持续6秒，并给所有“党羽”60%的该效果。"],["/skills/2/variants/0/description_i18n/jp","パッシブ効果：異なる味方による非永続的なステータスバフを獲得するたびに、「エンチャント」の持続時間+10秒、バフ付与者を「配下」と見なす。アクティブ効果：前方1マスの扇状範囲に魔力の剣圧を飛ばし、範囲内の敵に340% + 40% ATKのダメージを与え、与えたダメージ×200%分のシールド値を6秒間獲得。「配下」は全員、エイドリアンがこの効果で獲得したシールド値の60%分のシールド値を獲得"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":84,"end":90,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":108,"end":114,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":80,"end":94,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":104,"end":118,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_i18n/cn","魔力剑气造成伤害提升至400% ATK。"],["/skills/2/variants/1/description_i18n/jp","魔力の剣圧のダメージが400% ATKにUP"],["/skills/2/variants/1/description_tooltip_spans_i18n/cn",[{"start":11,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/1/description_tooltip_spans_i18n/jp",[{"start":11,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_i18n/cn","魔力剑气造成伤害提升至360% + 40% ATK。"],["/skills/2/variants/2/description_i18n/jp","魔力の剣圧のダメージが360% + 40% ATKにUP"],["/skills/2/variants/2/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_power_spans_i18n/jp",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/2/description_tooltip_spans_i18n/jp",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_i18n/cn","魔力剑气造成伤害提升至380% + 40% ATK。"],["/skills/2/variants/3/description_i18n/jp","魔力の剣圧のダメージが380% + 40% ATKにUP"],["/skills/2/variants/3/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_power_spans_i18n/jp",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/3/description_tooltip_spans_i18n/jp",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/4/description_i18n/cn","魔力剑气造成伤害提升至400% + 40% ATK。"],["/skills/2/variants/4/description_i18n/jp","魔力の剣圧のダメージが400% + 40% ATKにUP"],["/skills/2/variants/4/description_power_spans_i18n/cn",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/4/description_power_spans_i18n/jp",[{"start":15,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/2/variants/4/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/2/variants/4/description_tooltip_spans_i18n/jp",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","战斗中提升自身攻击力，“党羽”在场时提升更多攻击力。"],["/skills/3/simple_description_i18n/jp","戦闘中、自身の攻撃力UP。「配下」が存在する場合、追加で攻撃力UP"],["/skills/3/variants/0/description_i18n/cn","战斗中，奥利安提升9%攻击力，当有“党羽”在场时额外提升6%攻击力"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身の攻撃力+9%。「配下」が存在する場合、追加で攻撃力+6%"],["/skills/3/variants/1/description_i18n/cn","战斗中，奥利安提升12%攻击力，当有“党羽”在场时额外提升8%攻击力"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身の攻撃力+12%。「配下」が存在する場合、追加で攻撃力+8%"],["/skills/3/variants/2/description_i18n/cn","战斗中，奥利安提升15%攻击力，当有“党羽”在场时额外提升10%攻击力"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身の攻撃力+15%。「配下」が存在する場合、追加で攻撃力+10%"],["/skills/4/name_i18n/cn","趋炎附势"],["/skills/4/name_i18n/jp","権力の炎"],["/skills/4/simple_description_i18n/cn","“党羽”将为奥利安带来“势力”，每层势力使奥利安获得伤害加成和伤害减免。"],["/skills/4/simple_description_i18n/jp","「配下」が増えるたびに自身の「勢力」が増え、「勢力」1スタックにつき、自身の与ダメージと被ダメージ軽減を強化"],["/skills/4/variants/0/description_i18n/cn","奥利安每招纳一名“党羽”都会为自身积攒1层“势力”，最多3层。每层“势力”使奥利安造成的伤害增加14%，受到的伤害降低18%，并使“灼伤”效果的时间延长1秒。"],["/skills/4/variants/0/description_i18n/jp","「配下」が1体増えるたびに、自身の「勢力」が永続的に1スタック増加、最大3スタックまで。「勢力」1スタックにつき、自身の与ダメージ+14%、被ダメージ-18%、「熱傷」の持続時間+1秒"],["/skills/4/variants/1/description_i18n/cn","每层“势力”为奥利安提供的伤害加成增加至16%。"],["/skills/4/variants/1/description_i18n/jp","「勢力」1スタックごとの与ダメージ上昇量が16%にUP"],["/skills/4/variants/2/description_i18n/cn","3层“势力”时，奥利安解放所有的力量，“细剑附魔”将会立即激活并永久持续。本场战斗的剩余时间内，若敌人连续处于“灼伤”状态下3秒，则会被沉默并降低60点受愈，直至“灼伤”效果结束。"],["/skills/4/variants/2/description_i18n/jp","「勢力」が3スタックに達した時、エイドリアンはすべての力を解放し、直ちに剣に魔力を永続的にエンチャントする。戦闘終了までの間、敵の「熱傷」状態が3秒続いた場合、「熱傷」効果が終わるまで、その敵は沈黙状態になり、治癒-60"],["/skills/4/variants/2/description_tooltip_spans_i18n/cn",[{"start":68,"end":70,"tooltip_key":"keyword:silence"}]],["/skills/4/variants/2/description_tooltip_spans_i18n/jp",[{"start":97,"end":99,"tooltip_key":"keyword:silence"}]],["/skills/4/variants/3/description_i18n/cn","每层“势力”为奥利安提供的伤害加成增加至18%。"],["/skills/4/variants/3/description_i18n/jp","「勢力」1スタックごとの与ダメージ上昇量が18%にUP"],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","积累一定“势力”可使奥利安处于霸体状态，并且奥利安施加的“灼伤”效果附带真实伤害。"],["/skills/5/simple_description_i18n/jp","「勢力」を築いたエイドリアンはスーパーアーマー状態になり、「熱傷」に確定ダメージを追加"],["/skills/5/variants/0/description_i18n/cn","奥利安累计获得3层“势力”后，本场战斗剩余时间内处于霸体状态，并且“灼伤”额外造成50%的真实伤害."],["/skills/5/variants/0/description_i18n/jp","「勢力」が3スタックに達した時から戦闘終了までの間、エイドリアンはスーパーアーマー状態になり、「熱傷」による持続ダメージを与えるたびに、追加でその50%の確定ダメージを与える"],["/skills/5/variants/0/description_tooltip_spans_i18n/cn",[{"start":26,"end":28,"tooltip_key":"keyword:uncontrol"}]],["/skills/5/variants/0/description_tooltip_spans_i18n/jp",[{"start":33,"end":41,"tooltip_key":"keyword:uncontrol"}]],["/exclusive_equipment/name_i18n/cn","逆羽刺剑"],["/exclusive_equipment/name_i18n/jp","逆羽のレイピア"]]}