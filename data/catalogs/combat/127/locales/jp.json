arameter":"SArg2"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":14,"end":20,"power_type":"skill","parameter":"SArg2"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":11,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":10,"end":24,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","皇家飞羽"],["/skills/2/name_i18n/jp","王国の矢"],["/skills/2/simple_description_i18n/cn","召唤皇家射手并使其射出破甲箭，使敌人受到的远程伤害提高。"],["/skills/2/simple_description_i18n/jp","王家の弓兵を召喚。弓兵の破甲の矢により、敵が受ける遠距離ダメージUP"],["/skills/2/variants/0/description_i18n/cn","佩吉在战场后方召唤出一名“皇家射手”帮助战斗。“皇家射手”继承佩吉100%的攻击力，并且会射出3轮破甲箭对最靠前的2名敌人造成200% + 20% ATK伤害。被破甲箭命中的目标在接下来的5秒内受到的远程伤害提高22% + 3%，持续时间内己方召唤物对目标造成的远程伤害额外提高14% + 2%。"],["/skills/2/variants/0/description_i18n/jp","後方に「王家の弓兵」を1体召喚。「王家の弓兵」はペギーの攻撃力の100%を引継ぎ、破甲の矢を3回放ち、1回につき、最も前にいる敵2体に200% + 20% ATKのダメージを与える。破甲の矢がヒットした敵は5秒間、受ける遠距離ダメージ+22% + 3%、味方召喚ユニットからの遠距離ダメージの場合、追加で+14% + 2%"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":67,"end":73,"power_type":"skill","parameter":"SArg3"},{"start":109,"end":114,"power_type":"skill","parameter":"SArg5"},{"start":142,"end":147,"power_type":"skill","parameter":"SArg6"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":71,"end":77,"power_type":"skill","parameter":"SArg3"},{"start":121,"end":126,"power_type":"skill","parameter":"SArg5"},{"start":156,"end":161,"power_type":"skill","parameter":"SArg6"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":53,"end":56,"tooltip_key":"keyword:frontest"},{"start":63,"end":77,"tooltip_key":"stat:ATK"},{"start":100,"end":104,"tooltip_key":"keyword:remoteDmg"},{"start":131,"end":135,"tooltip_key":"keyword:remoteDmg"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":57,"end":63,"tooltip_key":"keyword:frontest"},{"start":67,"end":81,"tooltip_key":"stat:ATK"},{"start":110,"end":117,"tooltip_key":"keyword:remoteDmg"},{"start":138,"en