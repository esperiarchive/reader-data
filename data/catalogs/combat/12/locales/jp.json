iants/1/description_i18n/jp","1回ごとの攻撃のダメージが62% + 5% ATKにUP"],["/skills/1/variants/1/description_power_spans_i18n/cn",[{"start":10,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_power_spans_i18n/jp",[{"start":16,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/cn",[{"start":7,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/1/description_tooltip_spans_i18n/jp",[{"start":13,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_i18n/cn","每次伤害提高至65% + 5% ATK。"],["/skills/1/variants/2/description_i18n/jp","1回ごとの攻撃のダメージが65% + 5% ATKにUP"],["/skills/1/variants/2/description_power_spans_i18n/cn",[{"start":10,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_power_spans_i18n/jp",[{"start":16,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/cn",[{"start":7,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/2/description_tooltip_spans_i18n/jp",[{"start":13,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_i18n/cn","每次伤害提高至70% + 5% ATK。"],["/skills/1/variants/3/description_i18n/jp","1回ごとの攻撃のダメージが70% + 5% ATKにUP"],["/skills/1/variants/3/description_power_spans_i18n/cn",[{"start":10,"end":15,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_power_spans_i18n/jp",[{"start":16,"end":21,"power_type":"skill","parameter":"PlusRatio"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/cn",[{"start":7,"end":19,"tooltip_key":"stat:ATK"}]],["/skills/1/variants/3/description_tooltip_spans_i18n/jp",[{"start":13,"end":25,"tooltip_key":"stat:ATK"}]],["/skills/2/name_i18n/cn","腐伤追溢"],["/skills/2/name_i18n/jp","腐食拡大"],["/skills/2/simple_description_i18n/cn","普通攻击命中附带“箭毒”的目标，提升“箭毒”的持续伤害。"],["/skills/2/simple_description_i18n/jp","通常攻撃が「矢毒」状態の敵にヒットすると、「矢毒」の持続ダメージUP"],["/skills/2/variants/0/description_i18n/cn","普通攻击将会优先攻击最近的附带自身“箭毒”的目标。当普通攻击命中附带“箭毒”的目标时，将会使目标身上的“箭毒”原始伤害量永久提升25%，最多叠加20 + 2次。"],["/skills/2/variants/0/description_i18n/jp","通常攻撃は「矢毒」が与された最も近い敵を優先的に対象に選択。「矢毒」状態の敵に通常攻撃がヒットすると、永続的にその敵にかかる「矢毒」の初期ダメージ+25%、20 + 2回まで重複可能"],["/skills/2/variants/0/description_power_spans_i18n/cn",[{"start":74,"end":78,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/0/description_power_spans_i18n/jp",[{"start":80,"end":84,"power_type":"skill","parameter":"SArg1"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/cn",[{"start":55,"end":60,"tooltip_key":"keyword:original"}]],["/skills/2/variants/0/description_tooltip_spans_i18n/jp",[{"start":67,"end":73,"tooltip_key":"keyword:original"}]],["/skills/2/variants/1/description_i18n/cn","普通攻击与终极技能的攻击距离提升至7格。"],["/skills/2/variants/1/description_i18n/jp","通常攻撃と必殺技の射程距離が7マスにUP"],["/skills/2/variants/2/description_i18n/cn","“箭毒”伤害提升量增加至27%。"],["/skills/2/variants/2/description_i18n/jp","「矢毒」のダメージが27%にUP"],["/skills/2/variants/3/description_i18n/cn","“箭毒”伤害提升量增加至29%。"],["/skills/2/variants/3/description_i18n/jp","「矢毒」のダメージが29%にUP"],["/skills/3/name_i18n/cn","英雄专精"],["/skills/3/name_i18n/jp","天賦の才"],["/skills/3/simple_description_i18n/cn","提高自身攻击速度。"],["/skills/3/simple_description_i18n/jp","自身の攻撃速度UP"],["/skills/3/variants/0/description_i18n/cn","战斗中，自身的攻击速度提升21点。"],["/skills/3/variants/0/description_i18n/jp","戦闘中、自身の攻撃速度+21"],["/skills/3/variants/1/description_i18n/cn","战斗中，自身的攻击速度提升27点。"],["/skills/3/variants/1/description_i18n/jp","戦闘中、自身の攻撃速度+27"],["/skills/3/variants/2/description_i18n/cn","战斗中，自身的攻击速度提升33点。"],["/skills/3/variants/2/description_i18n/jp","戦闘中、自身の攻撃速度+33"],["/skills/4/name_i18n/cn","蚀心碎骨"],["/skills/4/name_i18n/jp","魂を蝕む矢"],["/skills/4/simple_description_i18n/cn","附带“箭毒”的目标的生命值过低时会立即被击败。"],["/skills/4/simple_description_i18n/jp","「矢毒」状態の敵のHPがかなり低くなると、即撃破される"],["/skills/4/variants/0/description_i18n/cn","附带“箭毒”的目标，若其生命值低于一定阈值，将会立即被击败。阈值等同于“箭毒”每秒原始伤害量的5.2倍。每当一名附带“箭毒”的敌方英雄被击败，阈值额外提高“箭毒”每秒原始伤害量的0.5倍，最多提高2次。"],["/skills/4/variants/0/description_i18n/jp","「矢毒」状態の敵のHPが閾値より低くなると、即撃破される。閾値は「矢毒」の毎秒初期ダメージの5.2倍となる。「矢毒」状態の敵が撃破されるたびに、閾値が「矢毒」の毎秒初期ダメージ×0.5分UP、2回まで重複可能"],["/skills/4/variants/0/description_tooltip_spans_i18n/cn",[{"start":41,"end":46,"tooltip_key":"keyword:original"},{"start":83,"end":88,"tooltip_key":"keyword:original"}]],["/skills/4/variants/0/description_tooltip_spans_i18n/jp",[{"start":39,"end":45,"tooltip_key":"keyword:original"},{"start":82,"end":88,"tooltip_key":"keyword:original"}]],["/skills/4/variants/1/description_i18n/cn","阈值等同于“箭毒”每秒原始伤害量的5.7倍。"],["/skills/4/variants/1/description_i18n/jp","閾値は「矢毒」の毎秒初期ダメージ×5.7になる"],["/skills/4/variants/1/description_tooltip_spans_i18n/cn",[{"start":11,"end":16,"tooltip_key":"keyword:original"}]],["/skills/4/variants/1/description_tooltip_spans_i18n/jp",[{"start":10,"end":16,"tooltip_key":"keyword:original"}]],["/skills/4/variants/2/description_i18n/cn","拥有600点初始能量。"],["/skills/4/variants/2/description_i18n/jp","初期SPが600になる"],["/skills/4/variants/3/description_i18n/cn","阈值等同于“箭毒”每秒原始伤害量的6.2倍。"],["/skills/4/variants/3/description_i18n/jp","閾値は「矢毒」の毎秒初期ダメージ×6.2になる"],["/skills/4/variants/3/description_tooltip_spans_i18n/cn",[{"start":11,"end":16,"tooltip_key":"keyword:original"}]],["/skills/4/variants/3/description_tooltip_spans_i18n/jp",[{"start":10,"end":16,"tooltip_key":"keyword:original"}]],["/skills/5/name_i18n/cn","觉醒之力"],["/skills/5/name_i18n/jp","覚醒の力"],["/skills/5/simple_description_i18n/cn","“穿心连射”命中附带“箭毒”的目标时，造成的伤害提高。"],["/skills/5/simple_description_i18n/jp","「矢毒」状態の敵への「心を貫く矢」の与ダメージUP"],["/skills/5/variants/0/description_i18n/cn","若目标附带“箭毒”，则“穿心连射”造成的伤害量提高，提高量相当于当前的“箭毒”每秒伤害量的1.5倍。"],["/skills/5/variants/0/description_i18n/jp","対象が「矢毒」状態の場合、「心を貫く矢」のダメージUP。上昇量は、その時の「矢毒」の毎秒ダメージの1.5倍"],["/exclusive_equipment/name_i18n/cn","蛇憩之骨"],["/exclusive_equipment/name_i18n/jp","蛇骨の矢"]]}