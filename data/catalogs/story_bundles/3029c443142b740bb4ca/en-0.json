mmie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep2/quest_story/12246440.json":{"asset_key":"ep2/quest_story_12246440","episode":"ep2","category":"quest_story","story_id":"12246440","schema_version":1,"lang":"en","texts":{"say:2:1224644001:0":{"text":"Ah, my binoculars don't have enough magnification. What a bummer...","source_cn":"啊，我带的望远镜倍数不太够，太可惜了……","status":"matched","hash_xxh64":"0x295B2D359725D330","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1224644002:1":{"text":"Did someone say binoculars? We have those!","source_cn":"望远镜？我们有！","status":"matched","hash_xxh64":"0xC24CCE36A4729B5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1224644003:1":{"text":"Dura above, you're a godsend! I'll include your name in the acknowledgments of my paper!","source_cn":"艾雅在上，太感谢您了！我会在论文的致谢里写上您的名字！","status":"matched_runtime_gender","hash_xxh64":"0xB8116620881E11F8","variant_status":"runtime_gender_keys_target_same","male":"Dura above, you're a godsend! I'll include your name in the acknowledgments of my paper!","female":"Dura above, you're a godsend! I'll include your name in the acknowledgments of my paper!","variant_male_record_index":"141419","variant_female_record_index":"141420","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:冬青学者阿尔瓦":{"text":"Scholar Alvin","source":"冬青学者阿尔瓦","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":