{"schema_version":1,"resources":{"locales/en/ep2/quest_story/12246380.json":{"asset_key":"ep2/quest_story_12246380","episode":"ep2","category":"quest_story","story_id":"12246380","schema_version":1,"lang":"en","texts":{"say:0:1224638001:0":{"text":"W—What kind of strange creature is this?!","source_cn":"这、这是什么奇怪的生物！","status":"matched","hash_xxh64":"0xC34108111B90AAB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1224638002:0":{"text":"Target found, Magister!","source_cn":"主人，发现目标了！","status":"matched_runtime_gender","hash_xxh64":"0x6834655C41D94534","variant_status":"runtime_gender_keys_target_same","male":"Target found, Magister!","female":"Target found, Magister!","variant_male_record_index":"141399","variant_female_record_index":"141400","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:冬青学者韦恩":{"text":"Scholar Wain","source":"冬青学者韦恩","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep2/quest_story/12246390.json":{"asset_key":"ep2/quest_story_12246390","episode":"ep2","category":"quest_story","story_id":"12246390","schema_version":1,"lang":"en","texts":{"say:2:1224639001:1":{"text":"Look, Dori! What a groundbreaking discovery!","source_cn":"这个生物——丝道瑞，这是突破性的发现！","status":"matched","hash_xxh64":"0x8D27FE08F90C9485","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1224639002:1":{"text":"A study on this creature will surely get funded.","source_cn":"它作为课题，