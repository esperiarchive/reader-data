{"schema_version":1,"resources":{"catalogs/runtime/scenes/26349d50fbe4ad96d04b.json":{"assets":{"ep2/quest_story_12246390":{"skip":{"source_cn":"你们保护了被怪物袭击的学者，没想到他们根本不害怕，还兴冲冲地对怪物尸体做起了研究。","text_i18n":{"cn":"你们保护了被怪物袭击的学者，没想到他们根本不害怕，还兴冲冲地对怪物尸体做起了研究。","en":"You protect the scholars from a monster attack. Instead of looking rattled, they eagerly begin examining the monster's body.","jp":"あなたたちはモンスターに襲われていた学者を助けるも、彼らは恐れるどころか、研究テーマとなりそうな未知の生物との接触に興奮している。","kr":"우리는 몬스터에게 습격당한 학자를 보호했다. 놀랍게도 그들은 몬스터를 두려워하기는커녕, 신이 난 듯 몬스터의 시체를 연구하기 시작했다."},"source":"Plot.SkipText","plot_ids":["12246390"],"localization_status":"exact_hash","record_indices":["23561"]}}}},"locales/cn/ep2/quest_story/12246380.json":{"asset_key":"ep2/quest_story_12246380","episode":"ep2","category":"quest_story","story_id":"12246380","schema_version":1,"lang":"cn","texts":{"say:0:1224638001:0":{"text":"这、这是什么奇怪的生物！","source_cn":"这、这是什么奇怪的生物！","status":"matched","hash_xxh64":"0xC34108111B90AAB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1224638002:0":{"text":"主人，发现目标了！","source_cn":"主人，发现目标了！","status":"matched_runtime_gender","hash_xxh64":"0x6834655C41D94534","variant_status":"runtime_gender_keys_target_same","male":"主人，发现目标了！","female":"主人，发现目标了！","variant_male_record_index":"141399","variant_female_record_index":"141400","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:冬青学者韦恩":{"text":"冬青学者韦恩","source":"冬青学者韦恩","status":"source"},"speaker:满满":{"text":"满满","source":"满满","status":"source"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/cn/ep2/quest_story/12246390.json":{"asset_key":"ep2/quest_story_12246390","episode":"ep2","category":"quest_story","story_id":"12246390","schema_version":1,"l