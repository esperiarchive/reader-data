。","status":"matched_runtime_gender","hash_xxh64":"0x9933058878305D31","variant_status":"runtime_gender_keys_target_same","male":"You deal with this.","female":"You deal with this.","variant_male_record_index":"189745","variant_female_record_index":"189746","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1534439007":{"text":"You deal with this.","source_cn":"你直接跟他说吧。","status":"matched_runtime_gender","hash_xxh64":"0x9933058878305D31","variant_status":"runtime_gender_keys_target_same","male":"You deal with this.","female":"You deal with this.","variant_male_record_index":"189745","variant_female_record_index":"189746","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1534439008:0":{"text":"... Wait, did you just challenge me to a dance-off?","source_cn":"……你说什么？你要在这里跳草裙舞，现在？！","status":"matched_runtime_gender","hash_xxh64":"0x9C870D4D429C8644","variant_status":"runtime_gender_keys_target_same","male":"... Wait, did you just challenge me to a dance-off?","female":"... Wait, did you just challenge me to a dance-off?","variant_male_record_index":"189748","variant_female_record_index":"189749","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1534439008":{"text":"... Wait, did you just challenge me to a dance-off?","source_cn":"……你说什么？你要在这里跳草裙舞，现在？！","status":"matched_runtime_gender","hash_xxh64":"0x9C870D4D429C8644","variant_status":"runtime_gender_keys_target_same","male":"... Wait, did you just challenge me to a dance-off?","female":"... Wait, did you just challenge me to a dance-off?","variant_male_record_index":"189748","variant_female_record_index":"189749","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1534439009:1":{"te