{"schema_version":1,"resources":{"easter_eggs/menus/15010337_1_1.en.json":{"schema_version":1,"asset_key":"easter_eggs/menu_15010337:1:1","lang":"en","texts":{"menu:10051320:1":{"text":"Knowing the Old Tongue is really useful!","source_cn":"练习古语言，好处多多！","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:岩":{"text":"Rocky","source":"岩","status":"exact_hash"}}},"locales/en/ep5/env_story/15344370.json":{"asset_key":"ep5/env_story_15344370","episode":"ep5","category":"env_story","story_id":"15344370","schema_version":1,"lang":"en","texts":{"say:1:1534437001:0":{"text":"When it's safe, you say—","source_cn":"周围安全的时候说——","status":"matched","hash_xxh64":"0x12E721ACC8980DA1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1534437002:0":{"text":"Ji-ya, ji-ya!","source_cn":"叽呀叽呀！","status":"matched","hash_xxh64":"0x2A02AA502FC336F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1534437003:0":{"text":"When there's danger, you say—","source_cn":"有危险的时候要说——","status":"matched","hash_xxh64":"0x95E6D385CECF061D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1534437004:0":{"text":"Ji-ya, ya-ya!","source_cn":"叽呀呀呀！","status":"matched","hash_xxh64":"0xF8D82ED405213E70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:岩":{"text":"Rocky","source":"岩","status":"matched_dialogue_flow"},"speaker:野":{"text":"Ferine","source":"野","status":"matched_dialogue_flow"},"speaker:小骨":{"text":"Stapes","source":"小骨","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":3}},"locales/en/ep5/env_story/15344380.json":{"asset_key":"ep5/env_story_15344380","episode":"ep5","category":"env_story","story_id":"15344380","schema_version":1,"lang":"en","texts":{"say:3:1534438001:1":{"text":"Who remembers how to say \"come here\"?","source_cn":"你们谁还记得，“快过来”的发声是什么样的？","status":"matched","hash_xxh64":"0x94E7FACF57D923B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1534438002:1":{"text":"It's \"wa-ah, wa-ah\"!","source_cn":"是“哇啊哇啊”！","status":"matched","hash_xxh64":"0x093AAED3D29C3C55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1534438003:1":{"text":"No! You're wrong! It's \"woo-wa, ah-woo\"!","source_cn":"不对不对，明明是“呜哇啊呜”。","status":"matched","hash_xxh64":"0xABACFDDD0FBE2A94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1534438003":{"text":"No! You're wrong! It's \"woo-wa, ah-woo\"!","source_cn":"不对不对，明明是“呜哇啊呜”。","status":"matched","hash_xxh64":"0xABACFDDD0FBE2A94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1534438004:1":{"text":"Practicing the Old Tongue! Our teacher says our ancestors spoke in a language that sounded more like animal calls.","source_cn":"我们在练习古语言！老师说过，其实最开始雅库伯尔用的语言...","status":"matched_runtime_gender","hash_xxh64":"0x2B90525CC5236FFE","variant_status":"runtime_gender_keys_target_same","male":"Practicing the Old Tongue! Our teacher says our ancestors spoke in a language that sounded more like animal calls.","female":"Practicing the Old Tongue! Our teacher says our ancestors spoke in a language that sounded more like animal calls.","variant_male_record_index":"189709","variant_female_record_index":"189710","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1534438005:1":{"text":"We use the common tongue now, but the Old Tongue is still great for hunting... and—","source_cn":"虽然现在已经换了通用语，但不少人都会学古语言。不止是狩...","status":"matched_runtime_gender","hash_xxh64":"0xA34AC617B55003E3","variant_status":"runtime_gender_keys_target_same","male":"We use the common tongue now, but the Old Tongue is still great for hunting... and—","female":"We use the common tongue now, but the Old Tongue is still great for hunting... and—","variant_male_record_index":"189711","variant_female_record_index":"189712","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1534438006:1":{"text":"And adults use it to talk about secrets that we can't understand!","source_cn":"还有很多大人谈论秘密的时候，用古语言说，不让我们知道！","status":"matched_runtime_gender","hash_xxh64":"0xA8093D0E85968D3F","variant_status":"runtime_gender_keys_target_same","male":"And adults use it to talk about secrets that we can't understand!","female":"And adults use it to talk about secrets that we can't understand!","variant_male_record_index":"189713","variant_female_record_index":"189714","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1534438007:0":{"text":"Which is exactly why we're teaching ourselves!","source_cn":"没错！这才是我们学习古语言最大的动力！所以我们才凑在一...","status":"matched_runtime_gender","hash_xxh64":"0x9214E6328C5186F6","variant_status":"runtime_gender_keys_target_same","male":"Which is exactly why we're teaching ourselves!","female":"Which is exactly why we're teaching ourselves!","variant_male_record_index":"189715","variant_female_record_index":"189716","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1534438008:0":{"text":"Want to learn a few phrases?","source_cn":"你是不是也很想学？我可以教你几句！","status":"matched_runtime_gender","hash_xxh64":"0xBCB7B874E6BBD3FF","variant_status":"runtime_gender_keys_target_same","male":"Want to learn a few phrases?","female":"Want to learn a few phrases?","variant_male_record_index":"189717","variant_female_record_index":"189718","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1534438008":{"text":"Want to learn a few phrases?","source_cn":"你是不是也很想学？我可以教你几句！","status":"matched_runtime_gender","hash_xxh64":"0xBCB7B874E6BBD3FF","variant_status":"runtime_gender_keys_target_same","male":"Want to learn a few phrases?","female":"Want to learn a few phrases?","variant_male_record_index":"189717","variant_female_record_index":"189718","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1534438009:0":{"text":"\"Wa-ao-ao\"!","source_cn":"“哇嗷嗷”！","status":"matched_runtime_gender","hash_xxh64":"0x456CCF465D9563FD","variant_status":"runtime_gender_keys_target_same","male":"\"Wa-ao-ao\"!","female":"\"Wa-ao-ao\"!","variant_male_record_index":"189719","variant_female_record_index":"189720","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1534438010:0":{"text":"Huh? I thought it was \"woo-wa-ao-ao\"?","source_cn":"咦，不是“呜哇嗷嗷”吗？","status":"matched","hash_xxh64":"0xEB9F73F8ED134062","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1534438011:0":{"text":"Oh... really? Well, \"woo-wa-ao-ao\" it is, then!","source_cn":"哦……啊？是吗？感觉有点怪……那就是“呜哇嗷嗷”吧！","status":"matched","hash_xxh64":"0x867E693E7C9DC9D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:0:1":{"text":"(Learn \"hello\".)","source_cn":"（学习“你好”的发音）","status":"matched_runtime_gender","hash_xxh64":"0xCE3802BCC775C09D","variant_status":"runtime_gender_keys_target_same","male":"(Learn \"hello\".)","female":"(Learn \"hello\".)","variant_male_record_index":"80121","variant_female_record_index":"80122","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1534438012:1":{"text":"\"Mm-ao mm-ao\"!","source_cn":"“嗯嗷嗯嗷”！","status":"matched_runtime_gender","hash_xxh64":"0xC02A783E29DD8B51","variant_status":"runtime_gender_keys_target_same","male":"\"Mm-ao mm-ao\"!","female":"\"Mm-ao mm-ao\"!","variant_male_record_index":"189723","variant_female_record_index":"189724","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1534438013:0":{"text":"Wait, is that right? That's not what you said yesterday!","source_cn":"真的是这个吗？昨天你不是这么教的！","status":"matched","hash_xxh64":"0xA15F54BD14AA8B59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:1:2":{"text":"(Learn \"thank you\")","source_cn":"（学习“谢谢”的发音）","status":"matched_runtime_gender","hash_xxh64":"0x73F2FA9BEF31182A","variant_status":"runtime_gender_keys_target_same","male":"(Learn \"thank you\")","female":"(Learn \"thank you\")","variant_male_record_index":"80123","variant_female_record_index":"80124","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1534438014:0":{"text":"\"Ma-wa ma-ao\"!","source_cn":"“嘛哇嘛嗷”！","status":"matched_runtime_gender","hash_xxh64":"0xEF101C63F95C7FC0","variant_status":"runtime_gender_keys_target_same","male":"\"Ma-wa ma-ao\"!","female":"\"Ma-wa ma-ao\"!","variant_male_record_index":"189727","variant_female_record_index":"189728","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1534438015:0":{"text":"I've never heard that phrase before...","source_cn":"这句古语言我还是第一次听说……","status":"matched","hash_xxh64":"0xED6A88418A7BE1B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:2:3":{"text":"(Learn \"let's be friends\".)","source_cn":"（学习“交朋友吧”的发音）","status":"matched_runtime_gender","hash_xxh64":"0x77DFCDF3EEE682B2","variant_status":"runtime_gender_keys_target_same","male":"(Learn \"let's be friends\".)","female":"(Learn \"let's be friends\".)","variant_male_record_index":"80125","variant_female_record_index":"80126","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1534438016:0":{"text":"Why don't you believe me?! Go <style=\"highlight\">ask those adults</style> over there if you don't!","source_cn":"你、你怎么不相信我！要是不放心，那边就有几个大人，你去...","status":"matched_runtime_gender","hash_xxh64":"0xA7B536F2981A6DD1","variant_status":"runtime_gender_keys_target_same","male":"Why don't you believe me?! Go <style=\"highlight\">ask those adults</style> over there if you don't!","female":"Why don't you believe me?! Go <style=\"highlight\">ask those adults</style> over there if you don't!","variant_male_record_index":"189731","variant_female_record_index":"189732","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:3:4":{"text":"This seems... a little made up.","source_cn":"怎么感觉不太靠谱……","status":"matched_runtime_gender","hash_xxh64":"0xB35B73E22FC6D005","variant_status":"runtime_gender_keys_target_same","male":"This seems... a little made up.","female":"This seems... a little made up.","variant_male_record_index":"80127","variant_female_record_index":"80128","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"What are you guys doing?","source_cn":"你们在干什么呢？","status":"matched_runtime_gender","hash_xxh64":"0xD179581F268E7486","variant_status":"runtime_gender_keys_target_same","male":"What are you guys doing?","female":"What are you guys doing?","variant_male_record_index":"80119","variant_female_record_index":"80120","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:岩":{"text":"Rocky","source":"岩","status":"matched_dialogue_flow"},"speaker:野":{"text":"Ferine","source":"野","status":"matched_dialogue_flow"},"speaker:小骨":{"text":"Stapes","source":"小骨","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":24,"localized_text_count":23,"speaker_count":3}},"locales/en/ep5/env_story/15344390.json":{"asset_key":"ep5/env_story_15344390","episode":"ep5","category":"env_story","story_id":"15344390","schema_version":1,"lang":"en