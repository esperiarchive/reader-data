:1":{"text":"I believe so.","source_cn":"我觉得是这样","status":"matched_runtime_gender","hash_xxh64":"0x7866708296F2F2CE","variant_status":"runtime_gender_keys_target_same","male":"I believe so.","female":"I believe so.","variant_male_record_index":"64912","variant_female_record_index":"64913","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123308005:1":{"text":"He rarely comes in contact with anyone outside the clan, so my gut says he's doing it for us.","source_cn":"不可否认，为氏族准备伤药的可能性更大，因为他很少接触氏...","status":"matched","hash_xxh64":"0xDCF75039CCE506FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:1:2":{"text":"I'm not sure.","source_cn":"我不确定","status":"matched_runtime_gender","hash_xxh64":"0x97CE64ECB7F2F0A8","variant_status":"runtime_gender_keys_target_same","male":"I'm not sure.","female":"I'm not sure.","variant_male_record_index":"95393","variant_female_record_index":"95394","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"So this happened...","source_cn":"（简短阐述情况）","status":"matched_runtime_gender","hash_xxh64":"0x0123A32C28CA0BB3","variant_status":"runtime_gender_keys_target_same","male":"So this happened...","female":"So this happened...","variant_male_record_index":"64910","variant_female_record_index":"64911","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:克鲁格":{"text":"Kruger","source":"克鲁格","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":1}}}}