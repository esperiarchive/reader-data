{"schema_version":1,"resources":{"locales/en/ep1/quest_story/11233010.json":{"asset_key":"ep1/quest_story_11233010","episode":"ep1","category":"quest_story","story_id":"11233010","schema_version":1,"lang":"en","texts":{"say:0:1123301001:0":{"text":"Magister, should we check on Hashir?","source_cn":"主人，我们是不是该看看哈什尔了？","status":"matched_runtime_gender","hash_xxh64":"0xACBC21B24E3FC1AD","variant_status":"runtime_gender_keys_target_same","male":"Magister, should we check on Hashir?","female":"Magister, should we check on Hashir?","variant_male_record_index":"127603","variant_female_record_index":"127604","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123301002:0":{"text":"Why are you so eager to see him, Chippy?","source_cn":"笨蛋满满，你怎么那么期待呀？","status":"matched","hash_xxh64":"0xADB45C679DDA5F2F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123301003:0":{"text":"Well... I've accepted his grumpy side, and he's not so bad after all!","source_cn":"嗯……只是接受了他蛮横的一面，觉得也没那么糟糕啦！","status":"matched","hash_xxh64":"0xB06B25EB23DEFCC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}},"locales/en/ep1/quest_story/11233020.json":{"asset_key":"ep1/quest_story_11233020","episode":"ep1","category":"quest_story","story_id":"11233020","schema_version":1,"lang":"en","texts":{"say:1:1123302001:1":{"text":"Are you alright? What happened?","source_cn":"您还好吗？出什么事了？","status":"matched","hash_xxh64":"0x5FAF1A447B5C21F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123302002:1":{"text":"How could I be alright? When I was young, my enemies stood before me. Now that I'm old, the enemy is my own body!","source_cn":"怎么会好？年轻的时候敌人都实实在在站在面前，上了年纪敌...","status":"matched","hash_xxh64":"0x341A2EA64ACFB088","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123302003:1":{"text":"Hashir is going to fall! Hurry, Chippy!","source_cn":"哈什尔要摔倒了！满满快！","status":"matched","hash_xxh64":"0xD32FD985A8639A7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123302004:1":{"text":"I've got you! Are you okay?","source_cn":"扶住了！您没事吧？","status":"matched","hash_xxh64":"0x9247FBB0E11D0EA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123302005:1":{"text":"Oh, it's nothing. I just lost my footing and... Ah...","source_cn":"别大惊小怪的，我只是一步没站稳而已，呼……呼。","status":"matched","hash_xxh64":"0xFC5925C4D3A8BDC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123302006:1":{"text":"You know... for a little furball, you've got some power in your legs.","source_cn":"没想到……你这小毛团劲儿还挺大的。","status":"matched","hash_xxh64":"0xAF108720745143B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123302007:1":{"text":"Ha! Chippy is an acorn knight! All knights have to be strong and fit!","source_cn":"嘿嘿，满满是骑士！骑士就要有大力气！","status":"matched","hash_xxh64":"0x6FB609B5A210806E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1123302007":{"text":"Ha! Chippy is an acorn knight! All knights have to be strong and fit!","source_cn":"嘿嘿，满满是骑士！骑士就要有大力气！","status":"matched","hash_xxh64":"0x6FB609B5A210806E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123302008:1":{"text":"Snakebone grass.","source_cn":"蛇骨草。","status":"matched","hash_xxh64":"0xCFF463F4B0607E4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123302009:1":{"text":"I'm no expert botanist, but isn't snakebone grass growing all around us?","source_cn":"虽然不太确定，您身边种植的不就是蛇骨草吗？","status":"matched","hash_xxh64":"0xD87377677CE62CA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1123302010:1":{"text":"The samples nearby aren't mature enough.","source_cn":"这些还未成熟，并且数量也远远不够。","status":"matched","hash_xxh64":"0x3A0264170DA42F94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1123302011:1":{"text":"Since you're here anyway, take this pouch and pick some mature snakebone grass for me.","source_cn":"既然你们来了，袋子拿去，给我取一些成熟的蛇骨草来。","status":"matched","hash_xxh64":"0xE05A9BB19BC94CB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1123302012:1":{"text":"Does Chippy hear gold coins in this pouch?","source_cn":"这袋子里的……是金币？","status":"matched","hash_xxh64":"0x70EA441960BFD2C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1123302012":{"text":"Does Chippy hear gold coins in this pouch?","source_cn":"这袋子里的……是金币？","status":"matched","hash_xxh64":"0x70EA441960BFD2C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1123302013:1":{"text":"You're a weird one. First time I've met someone who didn't like money...","source_cn":"头一次见到你这种怪人。","status":"matched_runtime_gender","hash_xxh64":"0x23FE78223A9FABF9","variant_status":"runtime_gender_keys_target_same","male":"You're a weird one. First time I've met someone who didn't like money...","female":"You're a weird one. First time I've met someone who didn't like money...","variant_male_record_index":"127619","variant_female_record_index":"127620","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1123302014:1":{"text":"Yeah, well, money is useless to an old hermit like me.","source_cn":"好吧，反正这些对于我这个野外求生的老人来说，已经没什么...","status":"matched","hash_xxh64":"0xE9E2D4EED71BB744","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1123302015:1":{"text":"Just remember, I need mature snakebone grass.","source_cn":"不过记住，我需要成熟的蛇骨草。","status":"matched","hash_xxh64":"0xDECDF101F8CE8849","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"Agree but refuse the money.","source_cn":"答应，并拒绝钱袋","status":"matched_runtime_gender","hash_xxh64":"0x8A05E04CD83E21C5","variant_status":"runtime_gender_keys_target_same","male":"Agree but refuse the money.","female":"Agree but refuse the money.","variant_male_record_index":"64892","variant_female_record_index":"64893","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"I'll accept it after the job is done.","source_cn":"告知采完蛇骨草才来领","status":"matched_runtime_gender","hash_xxh64":"0x716C3E9934FD8E9F","variant_status":"runtime_gender_keys_target_same","male":"I'll accept it after the job is done.","female":"I'll accept it after the job is done.","variant_male_record_index":"64894","variant_female_record_index":"64895","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"Are you looking for something?","source_cn":"你是在找什么吗？","status":"matched_runtime_gender","hash_xxh64":"0x2B0340C177A8F0A3","variant_status":"runtime_gender_keys_target_same","male":"Are you looking for something?","female":"Are you looking for something?","variant_male_record_index":"64888","variant_female_record_index":"64889","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"Missing something?","source_cn":"缺什么东西了吗？","status":"matched_runtime_gender","hash_xxh64":"0x01FF88AA2ED95A3D","variant_status":"runtime_gender_keys_target_same","male":"Missing something?","female":"Missing something?","variant_male_record_index":"64890","variant_female_record_index":"64891","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":22,"localized_text_count":21,"speaker_count":3}},"locales/en/ep1/quest_story/11233030.json":{"asset_key":"ep1/quest_story_11233030","episode":"ep1","category":"quest_story","story_id":"11233030","schema_version":1,"lang":"en","texts":{"say:0:1123303001:0":{"text":"Mature snakebone grass will be to the north. *Cough*... Try not to linger long...","source_cn":"蛇骨草在北方不远处。咳，早点回来。","status":"matched","hash_xxh64":"0xC5B232AE88CC69F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123303002:0":{"text":"There may be beasts in that area and... well, just be careful.","source_cn":"……那边会有凶狠的野兽出没。","status":"matched","hash_xxh64":"0x3152762EC644C072","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/ep1/quest_story/11233040.json":{"asset_key":"ep1/quest_story_11233040","episode":"ep1","category":"quest_story","story_id":"11233040","schema_version":1,"lang":"en","texts":{"say:0:1123304001:0":{"text":"We've gathered enough. Let's head back.","source_cn":"采集得差不多了，我们回去吧。","status":"matched_runtime_gender","hash_xxh64":"0x7AC01D8933D45052","variant_status":"runtime_gender_keys_target_same","male":"We've gathered enough. Let's head back.","female":"We've gathered enough. Let's head back.","variant_male_record_index":"127625","variant_female_record_index":"127626","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123304002:0":{"text":"Well done, Magister!","source_cn":"辛苦主人了！","status":"matched_runtime_gender","hash_xxh64":"0xD1A0C8D29DE8EFDD","variant_status":"runtime_gender_keys_target_same","male":"Well done, Magister!","female":"Well done, Magister!","variant_male_record_index":"127627","variant_female_record_index":"127628","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:主角":{"text":"Player","source":"主角","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep1/quest_story/11233050.json":{"asset_key":"ep1/quest_story_11233050","episode":"ep1","category":"quest_story","story_id":"11233050","schema_version":1,"lang":"en","texts":{"say:1:1123305001:1":{"text":"Hmm... let me see... mature snakebone grass. Just the right amount. This gold belongs to you. Take it.","source_cn":"嗯……我看看……成熟的蛇骨草，数量也刚刚好。\\n这钱袋...","status":"matched","hash_xxh64":"0x97CB1FD179AF565B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1123305001":{"text":"Hmm... let me see... mature snakebone grass. Just the right amount. This gold belongs to you. Take it.","source_cn":"嗯……我看看……成熟的蛇骨草，数量也刚刚好。\\n这钱袋是你们的了，拿去吧。","status":"matched","hash_xxh64":"0x97CB1FD179AF565B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123305002:1":{"text":"Be noble on your own time, but I don't take handouts. This was a deal.","source_cn":"怎么想是你的事，但在我这里我们是雇佣关系。","status":"matched_runtime_gender","hash_xxh64":"0x323189D2435B517B","variant_status":"runtime_gender_keys_target_same","male":"Be noble on your own time, but I don't take handouts. This was a deal.","female":"Be noble on your own time, but I don't take handouts. This was a deal.","variant_male_record_index":"127630","variant_female_record_index":"127631","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123305004:1":{"text":"After all, I can't pick herbs myself anymore.","source_cn":"毕竟现在的我已经不可能再去采摘什么药草了。","status":"matched","hash_xxh64":"0x335FCAAB7A7659C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123305005:1":{"text":"Your work is finished, but I still have things to do...","source_cn":"你们的工作结束了，我还有事要忙……","status":"matched","hash_xxh64":"0x1098C535AA574F69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1123305005":{"text":"Your work is finished, but I still have things to do...","source_cn":"你们的工作结束了，我还有事要忙……","status":"matched","hash_xxh64":"0x1098C535AA574F69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123305006:1":{"text":"They're mostly dry now. They just need to be stored away.","source_cn":"已经晒得差不多了，现在需要收起来。","status":"matched","hash_xxh64":"0x43D1D88958B4A1C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1123305006":{"text":"They're mostly dry now. They just need to be stored away.","source_cn":"已经晒得差不多了，现在需要收起来。","status":"matched","hash_xxh64":"0x43D1D88958B4A1C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123305009:1":{"text":"I said it's not necessary. Ah... my back... Alright, it's up to you.","source_cn":"都说了不用了。\\n呼……我的老腰，随便你们吧。","status":"matched","hash_xxh64":"0x5A96C51A4315C59B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"Leave it to me.","source_cn":"交给我吧","status":"matched_runtime_gender","hash_xxh64":"0x57D2320CA65D2A8E","variant_status":"runtime_gender_keys_target_same","male":"Leave it to me.","female":"Leave it to me.","variant_male_record_index":"64902","variant_female_record_index":"64903","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123305007:2":{"text":"Yes! Chippy will help! ","source_cn":"当然！包在满满的身上！","status":"matched","hash_xxh64":"0xE8868BD92525E687","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1123305008:1":{"text":"I'll keep an eye on Chippy. He sometimes gets too enthusiastic about these things.","source_cn":"呃……满满的力道总是拿捏不好，我会好好看着他的。","status":"matched","hash_xxh64":"0x4C8A771A36CE68F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"Leave it to Chippy and Hammie.","source_cn":"交给满满和漫漫吧","status":"matched_runtime_gender","hash_xxh64":"0xF42884D771099625","variant_status":"runtime_gender_keys_target_same","male":"Leave it to Chippy and Hammie.","female":"Leave it to Chippy and Hammie.","variant_male_record_index":"64904","variant_female_record_index":"64905","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"Drying herbs?","source_cn":"你是在晾晒药草吗？","status":"matched_runtime_gender","hash_xxh64":"0xDB48CE758FED1C12","variant_status":"runtime_gender_keys_target_same","male":"Drying herbs?","female":"Drying herbs?","variant_male_record_index":"64900","variant_female_record_index":"64901","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"I said I didn't want it.","source_cn":"我说过不会要你的钱","status":"matched_runtime_gender","hash_xxh64":"0x337442FF923870D0","variant_status":"runtime_gender_keys_target_same","male":"I said I didn't want it.","female":"I said I didn't want it.","variant_male_record_index":"64896","variant_female_record_index":"64897","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1123305003:1":{"text":"As you should, you deserve it.","source_cn":"当然，这是你应得的。","status":"matched_runtime_gender","hash_xxh64":"0xDB5F6DFEEE56AEAC","variant_status":"runtime_gender_keys_target_same","male":"As you should, you deserve it.","female":"As you should, you deserve it.","variant_male_record_index":"127632","variant_female_record_index":"127633","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:1:2":{"text":"Alright, I accept.","source_cn":"那我就不客气了","status":"matched_runtime_gender","hash_xxh64":"0x1023A33E8B183B01","variant_status":"runtime_gender_keys_target_same","male":"Alright, I accept.","female":"Alright, I accept.","variant_male_record_index":"64898","variant_female_record_index":"64899","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":18,"localized_text_count":17,"speaker_count":3}},"locales/en/ep1/quest_story/11233060.json":{"asset_key":"ep1/quest_story_11233060","episode":"ep1","category":"quest_story","story_id":"11233060","schema_version":1,"lang":"en","texts":{"say:1:1123306001:1":{"text":"You're done already? Wait until I finish preparing the medicine. Just needs an extra dash...","source_cn":"这么快就收好了？等我做完这些药。加上这味——","status":"matched","hash_xxh64":"0x478F5E884AD7D680","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123306002:1":{"text":"The portions are good... Yes, that should suffice.","source_cn":"比例是……这样就可以了。","status":"matched","hash_xxh64":"0xC503C77AA367FB1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123306003:1":{"text":"These medicinal herbs could prove useful to a mage. Consider them a reward for your work earlier.","source_cn":"这些药材，魔法师也会用得上的，就算是刚才的酬劳吧。","status":"matched_runtime_gender","hash_xxh64":"0x63D245D8F5EF5BF9","variant_status":"runtime_gender_keys_target_same","male":"These medicinal herbs could prove useful to a mage. Consider them a reward for your work earlier.","female":"These medicinal herbs could prove useful to a mage. Consider them a reward for your work earlier.","variant_male_record_index":"127642","variant_female_record_index":"127643","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1123306003":{"text":"These medicinal herbs could prove useful to a mage. Consider them a reward for your work earlier.","source_cn":"这些药材，魔法师也会用得上的，就算是刚才的酬劳吧。","status":"matched_runtime_gender","hash_xxh64":"0x63D245D8F5EF5BF9","variant_status":"runtime_gender_keys_target_same","male":"These medicinal herbs could prove useful to a mage. Consider them a reward for your work earlier.","female":"These medicinal herbs could prove useful to a mage. Consider them a reward for your work earlier.","variant_male_record_index":"127642","variant_female_record_index":"127643","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123306004:1":{"text":"I'll use most for healing salves.","source_cn":"大部分会做成伤药。","status":"matched","hash_xxh64":"0x02B19DD4A5C226C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123306006:1":{"text":"It's for the foolish youngsters who always forget to treat their wounds properly. The medicine will help fight infection and speed up recovery.","source_cn":"是给那些蠢蛋年轻熊人准备的，他们总是忘记及时处理自己的...","status":"matched","hash_xxh64":"0xE5B6836DB1A38D39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123306007:1":{"text":"So, are they for the young warriors of the Grimmaw Clan?","source_cn":"这些药是给黑嚎氏族的年轻战士准备的？","status":"matched","hash_xxh64":"0xC2B46CD08AA14AD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123306008:1":{"text":"Grimmaw Clan...","source_cn":"黑嚎……氏族……","status":"matched","hash_xxh64":"0x7E86466105764033","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123306009:1":{"text":"I'm a bit tired now. Don't feel much like talking anymore. You all can go.","source_cn":"我有些累了，不想再说什么，你们走吧。","status":"matched","hash_xxh64":"0xE9E81EBD745B363D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123306010:1":{"text":"It seems the young warriors of the Grimmaw Clan have been training quite a lot recently...","source_cn":"黑嚎氏族最近似乎在训练年轻的战士们呢……","status":"matched","hash_xxh64":"0x62F6AF435FC26ADE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123306011:1":{"text":"It's time for you to go! I need my rest!","source_cn":"走吧……！我需要休息！","status":"matched","hash_xxh64":"0x1234C8C0F02AD5E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"What are the remaining herbs for?","source_cn":"剩下的药草会做些什么呢？","status":"matched_runtime_gender","hash_xxh64":"0xCD89D19B1B630913","variant_status":"runtime_gender_keys_target_same","male":"What are the remaining herbs for?","female":"What are the remaining herbs for?","variant_male_record_index":"64906","variant_female_record_index":"64907","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1123306005:1":{"text":"Of course not. I don't need any medicine myself.","source_cn":"当然不是，我自己也用不上什么伤药了。","status":"matched","hash_xxh64":"0x918AF05BAFC5A118","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:1:2":{"text":"Is the medicine for you?","source_cn":"这些药是给自己准备的吗？","status":"matched_runtime_gender","hash_xxh64":"0x68BF102CB9DC018D","variant_status":"runtime_gender_keys_target_same","male":"Is the medicine for you?","female":"Is the medicine for you?","variant_male_record_index":"64908","variant_female_record_index":"64909","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":15,"localized_text_count":14,"speaker_count":2}},"locales/en/ep1/quest_story/11233070.json":{"asset_key":"ep1/quest_story_11233070","episode":"ep1","category":"quest_story","story_id":"11233070","schema_version":1,"lang":"en","texts":{"say:0:1123307001:0":{"text":"What's going on with Hashir? He got so emotional all of a sudden...","source_cn":"哈什尔到底是什么意思呀？我有点看不懂了","status":"matched","hash_xxh64":"0xC2BA90F36D5A8287","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123307002:0":{"text":"Chippy doesn't understand either...","source_cn":"满满也看不懂了……","status":"matched","hash_xxh64":"0x0C541D3B238B2BBE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123307003:0":{"text":"Let's talk to Kruger about it.","source_cn":"总之，先将情况告知克鲁格吧。","status":"matched_runtime_gender","hash_xxh64":"0x7EB26E23F8253D27","variant_status":"runtime_gender_keys_target_same","male":"Let's talk to Kruger about it.","female":"Let's talk to Kruger about it.","variant_male_record_index":"127654","variant_female_record_index":"127655","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:主角":{"text":"Player","source":"主角","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":3}},"locales/en/ep1/quest_story/11233080.json":{"asset_key":"ep1/quest_story_11233080","episode":"ep1","category":"quest_story","story_id":"11233080","schema_version":1,"lang":"en","texts":{"say:1:1123308001:1":{"text":"Judging from your expressions, has something happened to Hashir?","source_cn":"看你们的表情，哈什尔出了什么意外吗？","status":"matched","hash_xxh64":"0x191BE9029F529E72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1123308001":{"text":"Judging from your expressions, has something happened to Hashir?","source_cn":"看你们的表情，哈什尔出了什么意外吗？","status":"matched","hash_xxh64":"0x191BE9029F529E72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123308002:1":{"text":"So, there was a sudden change in his attitude...","source_cn":"……嗯，忽然态度有变化。","status":"matched","hash_xxh64":"0xA8C69B52A40ADB62","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123308003:1":{"text":"I see. The medicine he was preparing, was 