cument_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123304002:0":{"text":"마스터, 수고하셨어요!","source_cn":"辛苦主人了！","status":"matched_runtime_gender","hash_xxh64":"0xD1A0C8D29DE8EFDD","variant_status":"runtime_gender_keys_target_same","male":"마스터, 수고하셨어요!","female":"마스터, 수고하셨어요!","variant_male_record_index":"127627","variant_female_record_index":"127628","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:主角":{"text":"주인공","source":"主角","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/kr/ep1/quest_story/11233050.json":{"asset_key":"ep1/quest_story_11233050","episode":"ep1","category":"quest_story","story_id":"11233050","schema_version":1,"lang":"kr","texts":{"say:1:1123305001:1":{"text":"음... 어디 보자... 다 자란 뱀뼈풀이군. 양도 이 정도면 충분하겠어.\n이 자루는 너희 것이니 가져가거라.","source_cn":"嗯……我看看……成熟的蛇骨草，数量也刚刚好。\\n这钱袋...","status":"matched","hash_xxh64":"0x97CB1FD179AF565B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1123305001":{"text":"음... 어디 보자... 다 자란 뱀뼈풀이군. 양도 이 정도면 충분하겠어.\n이 자루는 너희 것이니 가져가거라.","source_cn":"嗯……我看看……成熟的蛇骨草，数量也刚刚好。\\n这钱袋是你们的了，拿去吧。","status":"matched","hash_xxh64":"0x97CB1FD179AF565B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123305002:1":{"text":"네가 어떻게 생각하는지는 자유지만 어쨌든 내가 너희를 고용한 셈 아니냐.","source_cn":"怎么想是你的事，但在我这里我们是雇佣关系。","status":"matched_runtime_gender","hash_xxh64":"0x323189D2435B517B","variant_status":"runtime_gender_keys_target_same","male":"네가 어떻게 생각하는지는 자유지만 어쨌든 내가 너희를 고용한 셈 아니냐.","female":"네가 어떻게 생각하는지는 자유지만 어쨌든 내가 너희를 고용한 셈 아니냐.","variant_male_record_index":"127630","variant_female_record_index":"127631","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123305004:1":{"text":"어쨌든 지금의 나는 약초 따위를 채집하러 갈 수 없는 몸이니까.","source_cn":"毕竟现在的我已经不可能再去采摘什么药草了。","status":"matched","hash_xxh64":"0x335FCAAB7A7659C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123305005:1":{"text":"볼일은 끝난 것 같군. 그럼 나는 할 일이 남았으니...","source_cn":"你们的工作结束了，我还有事要忙……","status":"matched","hash_xxh64":"0x1098C535AA574F69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1123305005":{"text":"볼일은 끝난 것 같군. 그럼 나는 할 일이 남았으니...","source_cn":"你们的工作结束了，我还有事要忙……","status":"matched","hash_xxh64":"0x1098C535AA574F69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123305006:1":{"text":"거의 다 말렸으니 이제 거둬들여야지.","source_cn":"已经晒得差不多了，现在需要收起来。","status":"matched","hash_xxh64":"0x43D1D88958B4A1C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1123305006":{"text":"거의 다 말렸으니 이제 거둬들여야지.","source_cn":"已经晒得差不多了，现在需要收起来。","status":"matched","hash_xxh64":"0x43D1D88958B4A1C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123305009:1":{"text":"필요 없다고 했잖아.\n윽... 허리가. 마음대로 하거라.","source_cn":"都说了不用了。\\n呼……我的老腰，随便你们吧。","status":"matched","hash_xxh64":"0x5A96C51A4315C59B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"내게 맡겨","source_cn":"交给我吧","status":"matched_runtime_gender","hash_xxh64":"0x57D2320CA65D2A8E","variant_status":"runtime_gender_keys_target_same","male":"내게 맡겨","female":"내게 맡겨","variant_male_record_index":"64902","variant_female_record_index":"64903","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123305007:2":{"text":"네! 치피에게 맡겨주세요!","source_cn":"当然！包在满满的身上！","status":"matched","hash_xxh64":"0xE8868BD92525E687","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1123305008:1":{"text":"윽... 치피의 힘으로는 잡기 힘든 것 같아요. 잘 보고 있어야 할 것 같네요.","source_cn":"呃……满满的力道总是拿捏不好，我会好好看着他的。","status":"matched","hash_xxh64":"0x4C8A771A36CE68F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"치피와 해미에게 맡겨둬","source_cn":"交给满满和漫漫吧","status":"matched_runtime_gender","hash_xxh64":"0xF42884D771099625","variant_status":"runtime_gender_keys_target_same","male":"치피와 해미에게 맡겨둬","female":"치피와 해미에게 맡겨둬","variant_male_record_index":"64904","variant_female_record_index":"64905","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"약초 말리는 거야?","source_cn":"你是在晾晒药草吗？","status":"matched_runtime_gender","hash_xxh64":"0xDB48CE758FED1C12","variant_status":"runtime_gender_keys_target_same","male":"약초 말리는 거야?","female":"약초 말리는 거야?","variant_male_record_index":"64900","variant_female_record_index":"64901","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"분명 돈은 필요 없다고 했을 텐데","source_cn":"我说过不会要你的钱","status":"matched_runtime_gender","hash_xxh64":"0x337442FF923870D0","variant_status":"runtime_gender_keys_target_same","male":"분명 돈은 필요 없다고 했을 텐데","female":"분명 돈은 필요 없다고 했을 텐데","variant_male_record_index":"64896","variant_female_record_index":"64897","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1123305003:1":{"text":"그래, 당연히 받아가야 할 것이지.","source_cn":"当然，这是你应得的。","status":"matched_runtime_gender","hash_xxh64":"0xDB5F6DFEEE56AEAC","variant_status":"runtime_gender_keys_target_same","male":"그래, 당연히 받아가야 할 것이지.","female":"그래, 당연히 받아가야 할 것이지.","variant_male_record_index":"127632","variant_female_record_index":"127633","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:1:2":{"text":"그럼 사양하지 않겠어","source_cn":"那我就不客气了","status":"matched_runtime_gender","hash_xxh64":"0x1023A33E8B183B01","variant_status":"runtime_gender_keys_target_same","male":"그럼 사양하지 않겠어","female":"그럼 사양하지 않겠어","variant_male_record_index":"64898","variant_female_record_index":"64899","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈什尔":{"text":"하쉬르","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":18,"localized_text_count":17,"speaker_count":3}},"locales/kr/ep1/quest_story/11233060.json":{"asset_key":"ep1/quest_story_11233060","episode":"ep1","category":"quest_story","story_id":"11233060","schema_version":1,"lang":"kr","texts":{"say:1:1123306001:1":{"text":"벌써 다 거둬들인 건가? 그럼 약을 다 만들 때까지 기다리거라. 이걸 넣으면...","source_cn":"这么快就收好了？等我做完这些药。加上这味——","status":"matched","hash_xxh64":"0x478F5E884AD7D680","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123306002:1":{"text":"비율은... 이러면 됐군.","source_cn":"比例是……这样就可以了。","status":"matched","hash_xxh64":"0xC503C77AA367FB1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123306003:1":{"text":"이건 마법사들도 쓸 수 있는 약인데, 방금 전 일의 보수라고 해두지.","source_cn":"这些药材，魔法师也会用得上的，就算是刚才的酬劳吧。","status":"matched_runtime_gender","hash_xxh64":"0x63D245D8F5EF5BF9","variant_status":"runtime_gender_keys_target_same","male":"이건 마법사들도 쓸 수 있는 약인데, 방금 전 일의 보수라고 해두지.","female":"이건 마법사들도 쓸 수 있는 약인데, 방금 전 일의 보수라고 해두지.","variant_male_record_index":"127642","variant_female_record_index":"127643","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1123306003":{"text":"이건 마법사들도 쓸 수 있는 약인데, 방금 전 일의 보수라고 해두지.","source_cn":"这些药材，魔法师也会用得上的，就算是刚才的酬劳吧。","status":"matched_runtime_gender","hash_xxh64":"0x63D245D8F5EF5BF9","variant_status":"runtime_gender_keys_target_same","male":"이건 마법사들도 쓸 수 있는 약인데, 방금 전 일의 보수라고 해두지.","female":"이건 마법사들도 쓸 수 있는 약인데, 방금 전 일의 보수라고 해두지.","variant_male_record_index":"127642","variant_female_record_index":"127643","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123306004:1":{"text":"대부분은 상처약을 만들지.","source_cn":"大部分会做成伤药。","status":"matched","hash_xxh64":"0x02B19DD4A5C226C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123306006:1":{"text":"제때 상처 치료하는 걸 항상 잊어버리는 아둔한 베어포크 녀석들을 위해 준비한 거다. 이건 상처가 악화되는 걸 막아주는 약이니까. ","source_cn":"是给那些蠢蛋年轻熊人准备的，他们总是忘记及时处理自己的...","status":"matched","hash_xxh64":"0xE5B6836DB1A38D39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123306007:1":{"text":"블랙하울 부족의 젊은 전사들을 위해 약을 준비한 거예요?","source_cn":"这些药是给黑嚎氏族的年轻战士准备的？","status":"matched","hash_xxh64":"0xC2B46CD08AA14AD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123306008:1":{"text":"블랙하울... 부족...","source_cn":"黑嚎……氏族……","status":"matched","hash_xxh64":"0x7E86466105764033","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123306009:1":{"text":"윽, 피곤하군. 더 말하고 싶지 않으니 가도록 해.","source_cn":"我有些累了，不想再说什么，你们走吧。","status":"matched","hash_xxh64":"0xE9E81EBD745B363D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123306010:1":{"text":"요즘 블랙하울 부족에서 젊은 전사들을 훈련시키는 것 같던데... 크흠...","source_cn":"黑嚎氏族最近似乎在训练年轻的战士们呢……","status":"matched","hash_xxh64":"0x62F6AF435FC26ADE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123306011:1":{"text":"썩 가버리라니까...! 난 쉬어야 해!","source_cn":"走吧……！我需要休息！","status":"matched","hash_xxh64":"0x1234C8C0F02AD5E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"남은 약초로는 뭘 할 거야?","source_cn":"剩下的药草会做些什么呢？","status":"matched_runtime_gender","hash_xxh64":"0xCD89D19B1B630913","variant_status":"runtime_gender_keys_target_same","male":"남은 약초로는 뭘 할 거야?","female":"남은 약초로는 뭘 할 거야?","variant_male_record_index":"64906","variant_female_record_index":"64907","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1123306005:1":{"text":"그럴 리가. 난 상처약 따위는 필요 없어.","source_cn":"当然不是，我自己也用不上什么伤药了。","status":"matched","hash_xxh64":"0x918AF05BAFC5A118","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:1:2":{"text":"직접 쓰려고 준비한 거야?","source_cn":"这些药是给自己准备的吗？","status":"matched_runtime_gender","hash_xxh64":"0x68BF102CB9DC018D","variant_status":"runtime_gender_keys_target_same","male":"직접 쓰려고 준비한 거야?","female":"직접 쓰려고 준비한 거야?","variant_male_record_index":"64908","variant_female_record_index":"6