{"schema_version":1,"resources":{"locales/en/ep1/quest_story/11209010.json":{"asset_key":"ep1/quest_story_11209010","episode":"ep1","category":"quest_story","story_id":"11209010","schema_version":1,"lang":"en","texts":{"say:1:1120901001:0":{"text":"Phew... Is it safe now?","source_cn":"呼……现在是不是安全了？","status":"matched","hash_xxh64":"0x852228060921401B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1120901002:0":{"text":"Those terrabird-riding bandits! Everyone from my caravan was separated because of them. Luckily, I found a hiding spot.","source_cn":"那些骑陆行鸟劫掠的混蛋……行进之风商队的同伴都被他们冲...","status":"matched","hash_xxh64":"0xEC8E82D5783B8B3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1120901003:0":{"text":"If you spot any scattered gunpowder around here, help yourselves. We can't sell those anyway...","source_cn":"你要是在周围看到散落的火药，就拿去用吧。都是被抢剩下的...","status":"matched","hash_xxh64":"0x4AC419086C80C0EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120901004:0":{"text":"Thank you. I need to find the missing caravan members quickly. I hope Johnny and the others are safe!","source_cn":"路过的朋友，谢谢你，我得赶快去找失散的商队成员了，希望...","status":"matched","hash_xxh64":"0x5A8D67E7FE7DDA31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:塞拉菲