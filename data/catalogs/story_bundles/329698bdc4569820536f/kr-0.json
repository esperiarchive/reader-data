":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"설마 그것도 바다로 나가서 구해와야 하는 건 아니지?","source_cn":"这东西该不会也要出海找吧？","status":"matched_runtime_gender","hash_xxh64":"0x05024EC353AE1EF4","variant_status":"runtime_gender_keys_target_same","male":"설마 그것도 바다로 나가서 구해와야 하는 건 아니지?","female":"설마 그것도 바다로 나가서 구해와야 하는 건 아니지?","variant_male_record_index":"66196","variant_female_record_index":"66197","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"},"speaker:劳工的妻子":{"text":"일꾼의 아내","source":"劳工的妻子","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":16,"localized_text_count":15,"speaker_count":2}},"locales/kr/ep2/quest_story/12208070.json":{"asset_key":"ep2/quest_story_12208070","episode":"ep2","category":"quest_story","story_id":"12208070","schema_version":1,"lang":"kr","texts":{"say:0:1220807001:0":{"text":"치피 기억으로는 모래사장 근처에 생선 노점이 있었던 것 같은데.","source_cn":"满满记得，靠近沙滩的地方就有个鱼摊。","status":"matched","hash_xxh64":"0x9FF1F063ACDD1BB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/kr/ep2/quest_story/12208080.json":{"asset_key":"ep2/quest_story_12208080","episode":"ep2","category":"quest_story","story_id":"12208080","schema_version":1,"lang":"kr","texts":{"say:3:1220808001:1":{"text":"사장님, 여기 혹시 스마일 조개가 있나요?","source_cn":"老板，你这里有笑口贝吗？","status":"matched","hash_xxh64":"0x65F7DD3F6D97EB7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_