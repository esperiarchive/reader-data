94","variant_status":"runtime_gender_keys_target_differs","male":"さっきのグレイヴボーンは、女神の信徒なんだ。","female":"さっきのグレイヴボーンは、女神の信徒なのよ。","variant_male_record_index":"69462","variant_female_record_index":"69463","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1322121015:1":{"text":"あり得ません！","source_cn":"怎么可能！","status":"matched","hash_xxh64":"0x9236DA67E25D91D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"あのグレイヴボーンに悪意はない。","source_cn":"那位亡灵并不邪恶","status":"matched_runtime_gender","hash_xxh64":"0x8A550D9F25F8D165","variant_status":"runtime_gender_keys_target_differs","male":"あのグレイヴボーンに悪意はない。","female":"あのグレイヴボーンに悪意はないわ。","variant_male_record_index":"69464","variant_female_record_index":"69465","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"通路は安全だ。","source_cn":"密道是安全的","status":"matched_runtime_gender","hash_xxh64":"0x7B28D90A8EC404B5","variant_status":"runtime_gender_keys_target_differs","male":"通路は安全だ。","female":"通路は安全よ。","variant_male_record_index":"69458","variant_female_record_index":"69459","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1322121008:1":{"text":"で、ですが……修道院の中にあんな危険因子を残しておくわけには……","source_cn":"但……但无论怎样，也不能在修道院里留这么大的隐患……","status":"matched","hash_xxh64":"0x6F7542CCF5B3A3D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"あの通路を封鎖できる程の人員がいるのか？","source_cn":"你们没有足够人力封闭密道","status":"matched_runtime_g