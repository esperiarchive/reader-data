story_11107032","episode":"ep1","category":"quest_story","story_id":"11107032","schema_version":1,"lang":"jp","texts":{"say:0:1110703201:0":{"text":"ウール族の英雄だ！","source_cn":"乌尔氏族的英雄们！","status":"matched","hash_xxh64":"0xB2D57B997FBE7CB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1110703202:0":{"text":"英雄！英雄！","source_cn":"勇士！勇士！","status":"matched","hash_xxh64":"0x80CBA4063E37E21B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110703203:0":{"text":"アルサ！会いたかったわ！","source_cn":"阿尔萨！我好想你！","status":"matched","hash_xxh64":"0xC9079AEC0AC43AD9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110703204:0":{"text":"ソーンはすごいなぁ！","source_cn":"索恩，太厉害了！","status":"matched","hash_xxh64":"0xEA5DEE1B90F8F346","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:小蛮血1":{"text":"ババリア1","source":"小蛮血1","status":"matched_dialogue_flow"},"speaker:小蛮血2":{"text":"小蛮血2","source":"小蛮血2","status":"source"},"speaker:小蛮血3":{"text":"小蛮血3","source":"小蛮血3","status":"source"},"speaker:小蛮血4":{"text":"小蛮血4","source":"小蛮血4","status":"source"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":4}},"locales/jp/ep1/quest_story/11107040.json":{"asset_key":"ep1/quest_story_11107040","episode":"ep1","category":"quest_story","story_id":"11107040","schema_version":1,"lang":"jp","texts":{"say:1:1110704001:1":{"text":"ただいまー！ソーンと長いこと留守にしてたから、みんなお腹空いちゃった？大丈夫？","source_cn":"回来啦回来啦！我跟索恩出去这么久，大家肚子饿不饿？真令...","status":"matched","hash_xxh64":"0x6D97FC3268636377","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110704002:1":{"text":"腹が減ったのはお前の方じゃないのか？","source_cn":"我看是你饿了吧。","status":"matched","hash_xxh64":"0x2AB07B499C2D07EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1110704003:1":{"text":"アルサ、ソーン！おかえり！","source_cn":"阿尔萨，索恩！你们回来了！","status":"matched","hash_xxh64":"0xCFA1DB677365D07D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110704004:1":{"text":"聞いたよ！試練を全部突破して、本戦で大健闘したウール族の勇士がいるって！","source_cn":"我们都听说啦！通过了所有试炼和考验的乌尔氏族勇士！","status":"matched","hash_xxh64":"0x2F492830ACA2B39B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1110704005:1":{"text":"それがソーンとアルサだなんてビックリだよ！てっきり名前が同じ別人だと思った！","source_cn":"居然真的是我们的索恩和阿尔萨！还以为是叫同样名字的别人呢！","status":"matched","hash_xxh64":"0x7E53AC9133E4CF8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1110704006:1":{"text":"だから別人じゃないって言ったろ！ところで二人と