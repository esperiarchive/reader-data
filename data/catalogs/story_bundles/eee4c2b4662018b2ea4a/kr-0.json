e"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":4}},"locales/kr/ep1/quest_story/11107040.json":{"asset_key":"ep1/quest_story_11107040","episode":"ep1","category":"quest_story","story_id":"11107040","schema_version":1,"lang":"kr","texts":{"say:1:1110704001:1":{"text":"우리가 왔어! 나랑 소렌이 자리를 비운 동안 다들 배를 곯지는 않았어? 많이 걱정했다고!","source_cn":"回来啦回来啦！我跟索恩出去这么久，大家肚子饿不饿？真令...","status":"matched","hash_xxh64":"0x6D97FC3268636377","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110704002:1":{"text":"네 배가 고픈 거겠지.","source_cn":"我看是你饿了吧。","status":"matched","hash_xxh64":"0x2AB07B499C2D07EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1110704003:1":{"text":"아르사, 소렌! 돌아왔구나!","source_cn":"阿尔萨，索恩！你们回来了！","status":"matched","hash_xxh64":"0xCFA1DB677365D07D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110704004:1":{"text":"소식 들었어! 모든 시련과 시험을 통과한 우르 부족의 용사라고 말이야!","source_cn":"我们都听说啦！通过了所有试炼和考验的乌尔氏族勇士！","status":"matched","hash_xxh64":"0x2F492830ACA2B39B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1110704005:1":{"text":"그게 정말 우리의 소렌과 아르사라니! 난 같은 이름을 가진 다른 사람인 줄 알았지 뭐야!","source_cn":"居然真的是我们的索恩和阿尔萨！还以为是叫同样名字的别人呢！","status":"matched","hash_xxh64":"0x7E53AC9133E4CF8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1110704006:1":{"text":"다른 사람인 줄 알았다니! 소렌이랑 아르사가 그렇게 많을 리가... 음? 이게 무슨 냄새지?","source_cn":"居然以为是别人！哪有那么多的索恩和阿尔萨啊……唔？这是...","status":"matched","hash_xxh64":"0x6271517FB7EA7231","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1110704007:1":{"text":"아르사, 우리가 축하 파티조차 준비하지 않았을 거라고 생각했어?","source_cn":"阿尔萨，不会以为我们连庆功宴都没给你们准备吧？","status":"matched","hash_xxh64":"0x042FBEB5B125A45C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1110704008:1":{"text":"모두가 좋아하는 음식들이야! 바베큐, 수프... 잠깐, 디저트도 금방 가져올게!","source_cn":"全都是你们喜欢的食物！有烤肉，有汤……稍等，点心马上就来！","status":"matched","hash_xxh64":"0xF259EF3625F662C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1110704009:0":{"text":"자자잠깐! 이것들은 다 어디서 난 거야? 내가 남기고 간 식량은 겨우 배를 채울 수 있을 정도였는데...","source_cn":"等等等等！这些东西是从哪里变出来的？记得我走的时候全部...","status":"matched","hash_xxh64":"0x5F043E97EBB6565D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1110704010:1":{"text":"우리가... 짐이 될 순 없으니까!","source_cn":"我们……不能给阿尔萨和索恩拖后腿啊！","status":"matched","hash_xxh64":"0x0F6473E083AACBE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1110704011:1":{"text":"맞아. 우리가 아직 어리긴 하지만, 오빠랑 언니는 우리 나이 때부터 벌써 우리를 돌봐주곤 했었잖아.","source_cn":"没错。我们现在年纪虽小，但你们在像我这么大的时候，已经...","status":"matched","hash_xxh64":"0x2D2FB5D10A1E22B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1110704012:1":{"text":"이제 우르 부족은 영웅이 나온 부족이라고 생각하니까 부족의 얼굴에 먹칠하면 안 되겠다는 생각이 절로 들어서...","source_cn":"我们乌尔氏族是出了英雄的氏族。只要想到这里，就觉得不能...","status":"matched","hash_xxh64":"0x353C4D9F32C0AD9E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1110704013:1":{"text":"우리도 할 수 있는 일이 있을 거야! 소렌, 사냥을 가르쳐 줘!","source_cn":"我们也有我们能做的事！索恩，教我打猎吧！","status":"matched","hash_xxh64":"0x97B0EDD2B48A1C32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1110704014:1":{"text":"넌 아직 어려서 사냥을 하기엔 위험해. 아르사에게 덫을 놓는 법부터 배우도록 해.","source_cn":"你还太小，打猎危险。让阿尔萨教你做陷阱吧。","status":"matched","hash_xxh64":"0xA985D7F15D14E2EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1110704015:1":{"text":"흑흑! 사냥하고 싶어, 사냥!","source_cn":"呜呜！就要打猎就要打猎！","status":"matched","hash_xxh64":"0xD976B31CD666562F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1110704016:1":{"text":"...알겠어. 대신 막대기 백 번 휘두를 힘만 기르고 와.","source_cn":"……行吧。不过，要先等到你能挥棍一百下再说吧。","status":"matched","hash_xxh64":"0xE7C88880CF6A2B95","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1110704017:1":{"text":"애들 타이를 줄도 알고? 소렌도 이제 다 컸네?","source_cn":"居然开始和颜悦色？索恩也长大了呀。","status":"matched","hash_xxh64":"0xCEEE81FFF31FDD06","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:26:1110704017":{"text":"애들 타이를 줄도 알고? 소렌도 이제 다 컸네?","source_cn":"居然开始和颜悦色？索恩也长大了呀。","status":"matched","hash_xxh64":"0xCEEE81FFF31FDD06","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1110704018:1":{"text":"...당신까지 그런 말을...","source_cn":"……为什么连你也说这种话？","status":"matched_runtime_gender","hash_xxh64":"0x289746801B401838","variant_status":"runtime_gender_keys_target_same","male":"...당신까지 그런 말을...","female":"...당신까지 그런 말을...","variant_male_record_index":"122411","variant_female_record_index":"122412","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1110704019:1":{"text":"다른 사람이 그랬으면 소렌은 뒤도 안 돌아보고 가버렸을걸? 그래도 <style=\"stress\"><player_name></style>(이)니까 안 그런 거지!","source_cn":"如果是别人这么说，索恩估计会转身就走了。不过，<sty...","status":"matched_runtime_gender","hash_xxh64":"0x1341039469236A2B","variant_status":"runtime_gender_key