document_title_cn":"","document_title_status":""},"say:2:1211003003:0":{"text":"いやいや、あれは攻撃したがってるんだよ！","source_cn":"你理解错了，它们是想攻击你！","status":"matched","hash_xxh64":"0xF24CA4C6C45C7D8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"ナーラ","source":"奈拉","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"シンドバッド","source":"辛巴达","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":3}},"locales/jp/ep2/quest_story/12110040.json":{"asset_key":"ep2/quest_story_12110040","episode":"ep2","category":"quest_story","story_id":"12110040","schema_version":1,"lang":"jp","texts":{"say:1:1211004001:1":{"text":"船がありますよ。シンドバッドさん、ここが試練を行う場所でしょうか？","source_cn":"这里有船，辛巴达，这里就是开始试炼的地方吗？","status":"matched","hash_xxh64":"0xBAB1ED0102488D93","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1211004002:1":{"text":"どうやら、決められた時間内に船で指定の場所に行かなきゃならねぇようだな。","source_cn":"看来应该是要在指定的时间坐船到达指定的地点。","status":"matched","hash_xxh64":"0x18AA5FAADEF93952","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211004003:1":{"text":"海上レースが試練ということですか？","source_cn":"原来是海上竞速？","status":"matched","hash_xxh64":"0x94C743E167F9E0DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211004004:1":{"text":"どうだろうな、あとから陸のレースもあるかもしれねぇぜ。","source_cn":"哈哈，说不定陆上竞速待会也有呢。","status":"matched","hash_xxh64":"0x6B6AB63767BD363A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211004005:1":{"text":"お姉ちゃん、船に乗ろう！出発進行！","source_cn":"姐姐，我们一起坐船吧！出——发——！","status":"matched","hash_xxh64":"0xB51F046038B77C5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"シンドバッド","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"ナーラ","source":"奈拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":3}},"locales/jp/ep2/quest_story/12110050.json":{"asset_key":"ep2/quest_story_12110050","episode":"ep2","category":"quest_story","story_id":"12110050","schema_version":1,"lang":"jp","texts":{"say:0:1211005001:0":{"text":"しっかり掴まってろよ、スピード上げてくぞ！","source_cn":"都抓稳了，我们要乘风破浪！","status":"matched","hash_xxh64":"0xCB54928D296522B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"シンドバッド","source":"辛巴达","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/jp/ep2/quest_story/12110060.json":{"asset_key":"ep2/quest_story_12110060","episode":"ep2","category":"quest_story","story_id":"12110060","schema_version":1,"lang":"jp","texts":{"s