{"schema_version":1,"resources":{"locales/en/ep2/quest_story/12109190.json":{"asset_key":"ep2/quest_story_12109190","episode":"ep2","category":"quest_story","story_id":"12109190","schema_version":1,"lang":"en","texts":{"say:0:1210919001:0":{"text":"Do you think we'll find more clues from Tritonus?","source_cn":"特勒米琉斯还会给我们留线索吗？","status":"matched","hash_xxh64":"0x5C92DD09FB373084","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1210919002:0":{"text":"It's hard to say. The god of the waves seems quite unpredictable.","source_cn":"不好说，这位风浪神很随性。","status":"matched","hash_xxh64":"0x2AA30015539C7574","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep2/quest_story/12110010.json":{"asset_key":"ep2/quest_story_12110010","episode":"ep2","category":"quest_story","story_id":"12110010","schema_version":1,"lang":"en","texts":{"say:0:1211001001:0":{"text":"There's a moldy notebook. Let's take a look.","source_cn":"朋友们，有个发霉的笔记本，捡起看看。","status":"matched","hash_xxh64":"0x43DF4C8AA501B171","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep2/quest_story/12110020.json":{"asset_key":"ep2/quest_story_12110020","episode":"ep2","category":"quest_story","story_id":"12110020","schema_version":1,"lang":"en","texts":{"say:0:1211002001:0":{"text":"If Roswald wanted to help people find the treasure, why didn't he write clearer clues...?","source_cn":"罗赛斯既然想帮别人找到宝藏，为什么不把提示写得更清楚一...","status":"matched","hash_xxh64":"0x415B95E043DADEC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1211002002:0":{"text":"His notes mentioned the ocean. Could it be that the next trial is related to swimming?","source_cn":"笔记提到了海洋，难道下一个试炼真的和游泳有关？","status":"matched","hash_xxh64":"0x015B49D0776C0320","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep2/quest_story/12110030.json":{"asset_key":"ep2/quest_story_12110030","episode":"ep2","category":"quest_story","story_id":"12110030","schema_version":1,"lang":"en","texts":{"say:0:1211003001:0":{"text":"There are gruglins here also. It's like they can survive anywhere.","source_cn":"这里也有咕布林，它们可真顽强呀，好像在哪里都能生存。","status":"matched","hash_xxh64":"0x4688E9B94D59D62D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1211003002:0":{"text":"They're so cute. I think they want to play with me.","source_cn":"可爱！可爱它们想和我玩！","status":"matched","hash_xxh64":"0x09838A71C7E55509","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1211003003:0":{"text":"No, you don't understand. They want to attack you!","source_cn":"你理解错了，它们是想攻击你！","status":"matched","hash_xxh64":"0xF24CA4C6C45C7D8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":3}},"locales/en/ep2/quest_story/12110040.json":{"asset_key":"ep2/quest_story_12110040","episode":"ep2","category":"quest_story","story_id":"12110040","schema_version":1,"lang":"en","texts":{"say:1:1211004001:1":{"text":"There is a boat here, Sinbad. Is this where the trial starts?","source_cn":"这里有船，辛巴达，这里就是开始试炼的地方吗？","status":"matched","hash_xxh64":"0xBAB1ED0102488D93","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1211004002:1":{"text":"It seems that we need to take a boat to the designated place at the designated time.","source_cn":"看来应该是要在指定的时间坐船到达指定的地点。","status":"matched","hash_xxh64":"0x18AA5FAADEF93952","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211004003:1":{"text":"So it's a race on the water.","source_cn":"原来是海上竞速？","status":"matched","hash_xxh64":"0x94C743E167F9E0DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211004004:1":{"text":"Maybe there's also a race on land.","source_cn":"哈哈，说不定陆上竞速待会也有呢。","status":"matched","hash_xxh64":"0x6B6AB63767BD363A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211004005:1":{"text":"Sonja, let's take a boat and set sail!","source_cn":"姐姐，我们一起坐船吧！出——发——！","status":"matched","hash_xxh64":"0xB51F046038B77C5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":3}},"locales/en/ep2/quest_story/12110050.json":{"asset_key":"ep2/quest_story_12110050","episode":"ep2","category":"quest_story","story_id":"12110050","schema_version":1,"lang":"en","texts":{"say:0:1211005001:0":{"text":"Hold on tight! We're riding these waves!","source_cn":"都抓稳了，我们要乘风破浪！","status":"matched","hash_xxh64":"0xCB54928D296522B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep2/quest_story/12110060.json":{"asset_key":"ep2/quest_story_12110060","episode":"ep2","category":"quest_story","story_id":"12110060","schema_version":1,"lang":"en","texts":{"say:0:1211006001:0":{"text":"A little faster and I'll make the boat fly!","source_cn":"再快一点，我能让船飞起来！","status":"matched","hash_xxh64":"0x4DD4119E03CDB678","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1211006002:0":{"text":"Yay! Sonja, I love this! Let's keep going!","source_cn":"好刺激！我喜欢！我还想玩——和姐姐一直玩下去！","status":"matched","hash_xxh64":"0x13F29207DE8E859A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep2/quest_story/12110070.json":{"asset_key":"ep2/quest_story_12110070","episode":"ep2","category":"quest_story","story_id":"12110070","schema_version":1,"lang":"en","texts":{"say:0:1211007001:0":{"text":"What will this trial be like? I'm really looking forward to it!","source_cn":"这次的试炼会是什么呢？好期待啊！","status":"matched","hash_xxh64":"0x25050D133FE54940","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep2/quest_story/12110071.json":{"asset_key":"ep2/quest_story_12110071","episode":"ep2","category":"quest_story","story_id":"12110071","schema_version":1,"lang":"en","texts":{"say:0:1211007101:0":{"text":"Wow, it turns out it's to test how fast we can go!","source_cn":"哇，原来是要测试我们是不是跑得快！","status":"matched","hash_xxh64":"0x0F529696749243B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1211007102:0":{"text":"I wonder if it's faster to fly.","source_cn":"如果飞过去是不是比跑更快呢？","status":"matched","hash_xxh64":"0x3A6D8BD35625F1A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep2/quest_story/12110080.json":{"asset_key":"ep2/quest_story_12110080","episode":"ep2","category":"quest_story","story_id":"12110080","schema_version":1,"lang":"en","texts":{"say:0:1211008001:0":{"text":"I'm exhausted... If I hadn't been chased around every day in Rustport, I wouldn't be able to keep up...","source_cn":"累死我了……要不是以前天天被追着打，还真跑不动……","status":"matched","hash_xxh64":"0xD12F7FCB6C8011A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/timeline/quest_story/12110090.json":{"asset_key":"timeline/quest_story_12110090","episode":"timeline","category":"quest_story","story_id":"12110090","schema_version":1,"lang":"en","texts":{"say:1:1211009001:1":{"text":"Look! We found it!","source_cn":"看！找到了！","status":"matched","hash_xxh64":"0x032184BDBAABA21F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1211009002:0":{"text":"So the so-called key is just a small stone.","source_cn":"原来所谓的钥匙是一个小石块啊。","status":"matched","hash_xxh64":"0xE0D7A316F25740B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211009003:1":{"text":"This is our first piece of loot! Let's call it the <style=\"highlight\">Running Key</style>.","source_cn":"总算到手了！<style=highlight>奔行之钥...","status":"matched","hash_xxh64":"0x7BC44333B6335A49","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211009004:1":{"text":"<style=\"stress\"><player_name></style>, doesn't the shape match the base of the tablet where the waterfall meets?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x8FC6AB3F5CEE28B2","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, doesn't the shape match the base of the tablet where the waterfall meets?","female":"<style=\"stress\"><player_name></style>, doesn't the shape match the base of the tablet where the waterfall meets?","variant_male_record_index":"129262","variant_female_record_index":"129263","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1211009004":{"text":"<style=\"stress\"><player_name></style>, doesn't the shape match the base of the tablet where the waterfall meets?","source_cn":"<style=stress><player_name></style>，你们看，形状是不是能对上瀑布汇流那个地方的石底座？","status":"matched_runtime_gender","hash_xxh64":"0x8FC6AB3F5CEE28B2","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, doesn't the shape match the base of the tablet where the waterfall meets?","female":"<style=\"stress\"><player_name></style>, doesn't the shape match the base of the tablet where the waterfall meets?","variant_male_record_index":"129262","variant_female_record_index":"129263","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211009005:1":{"text":"Yeah, it seems to fit one of the grooves at the base.","source_cn":"对吧，刚好可以填上那三个底座凹槽中的一个。","status":"matched_runtime_gender","hash_xxh64":"0xCFED5F61C3E621E9","variant_status":"runtime_gender_keys_target_same","male":"Yeah, it seems to fit one of the grooves at the base.","female":"Yeah, it seems to fit one of the grooves at the base.","variant_male_record_index":"129264","variant_female_record_index":"129265","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1211009006:1":{"text":"At least, it proves that the treasure in the folk song really exists.","source_cn":"至少，它能证明那首民谣里的宝藏真实存在！","status":"matched_runtime_gender","hash_xxh64":"0xBD2D4CD4527A6C81","variant_status":"runtime_gender_keys_target_same","male":"At least, it proves that the treasure in the folk song really exists.","female":"At least, it proves that the treasure in the folk song really exists.","variant_male_record_index":"129266","variant_female_record_index":"129267","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1211009007:1":{"text":"Some people didn't believe it and thought that my father was a fool obsessed with treasure hunting.","source_cn":"有些人并不相信，认为我那一心寻宝的船长老爹是个傻子。","status":"matched","hash_xxh64":"0x6111F021E917D5B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1211009008:1":{"text":"Now, you found it for him.","source_cn":"现在，你帮他找到了。","status":"matched","hash_xxh64":"0x793CEF795DF7B67D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1211009009:0":{"text":"It's too early to say that.","source_cn":"还早呢。","status":"matched","hash_xxh64":"0x79807000A595CA70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1211009010:0":{"text":"Relax. Don't think of it like a trial. Pretend it's a game, like the ones we all played as a child.","source_cn":"放轻松点，别想着试炼了，你当它是个游戏，就像小时候玩过...","status":"matched","hash_xxh64":"0x406B609F49EFD5DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1211009011:1":{"text":"Yes, Sonja. This is fun!","source_cn":"是啊，姐姐，而且这里很好玩！","status":"matched","hash_xxh64":"0x9DF805F73E8085FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1211009012:0":{"text":"But if you think too much, it won't be.","source_cn":"如果想得太多，就一点都不好玩了！","status":"matched","hash_xxh64":"0x7A1F20EC70126DC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1211009013:0":{"text":"Yes, Nara, you're right. Let's fully commit to this game.","source_cn":"……是啊，奈拉，你说得对。这是一场游戏，全情投入才足够好玩。","status":"matched","hash_xxh64":"0x614100AB5ECA22F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"It seems so...","source_cn":"好像是","status":"matched_runtime_gender","hash_xxh64":"0x58BF8506C2FAAC53","variant_status":"runtime_gender_keys_target_same","male":"It seems so...","female":"It seems so...","variant_male_record_index":"65314","variant_female_record_index":"65315","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"I'm not sure.","source_cn":"不记得了","status":"matched_runtime_gender","hash_xxh64":"0x3462EFF7896CB3F4","variant_status":"runtime_gender_keys_target_same","male":"I'm not sure.","female":"I'm not sure.","variant_male_record_index":"65316","variant_female_record_index":"65317","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":17,"localized_text_count":16,"speaker_count":4}},"locales/en/timeline/timeline_story/1201011028.json":{"asset_key":"timeline/timeline_story_1201011028","episode":"timeline","category":"timeline_story","story_id":"1201011028","schema_version":1,"lang":"en","texts":{},"speakers":{},"stats":{"flow_row_count":2,"localized_text_count":0,"speaker_count":0}}}}