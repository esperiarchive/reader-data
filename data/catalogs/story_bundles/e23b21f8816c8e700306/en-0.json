 know how to play Century Quest?","variant_male_record_index":"118217","variant_female_record_index":"118218","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1062502006:1":{"text":"Awesome! Play with me! Let's show them how it's done.","source_cn":"那太好了！你和我一起，给他们做个示范吧~","status":"matched_runtime_gender","hash_xxh64":"0xCB8E396CD22C1862","variant_status":"runtime_gender_keys_target_same","male":"Awesome! Play with me! Let's show them how it's done.","female":"Awesome! Play with me! Let's show them how it's done.","variant_male_record_index":"118219","variant_female_record_index":"118220","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"Of course!","source_cn":"当然会玩","status":"matched_runtime_gender","hash_xxh64":"0xC00D1E69E4CAB91C","variant_status":"runtime_gender_keys_target_same","male":"Of course!","female":"Of course!","variant_male_record_index":"63114","variant_female_record_index":"63115","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"Who wouldn't?","source_cn":"很少有人不会玩吧","status":"matched_runtime_gender","hash_xxh64":"0x992AD1F90171B1A8","variant_status":"runtime_gender_keys_target_same","male":"Who wouldn't?","female":"Who wouldn't?","variant_male_record_index":"63116","variant_female_record_index":"63117","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"Well, they're still pretty young.","source_cn":"他们年纪太小了","status":"matched_runtime_gender","hash_xxh64":"0xB8533CD3920CFFD7","variant_status":"runtime_gender_keys_target_same","male":"Well, they're still pretty young.","female":"Well, they're still pretty young.","variant_male_record_index":"63112","variant_female_record_index":"63113",