{"schema_version":1,"resources":{"locales/en/ep5/quest_story/15110080.json":{"asset_key":"ep5/quest_story_15110080","episode":"ep5","category":"quest_story","story_id":"15110080","schema_version":1,"lang":"en","texts":{"say:1:1511008001:0":{"text":"Matter is the foundation of all creation. The vessel in which spirit resides.","source_cn":"物质是构建世界的基石，也是灵的承载体。","status":"matched","hash_xxh64":"0x2181000A0DB59775","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1511008002:0":{"text":"I suspect this will be a trial made of countless tangible forms.","source_cn":"我想，这将是一个以无数具象之物塑造而成的试炼。","status":"matched","hash_xxh64":"0xB73DF5E7CDF646EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/ep5/quest_story/15201010.json":{"asset_key":"ep5/quest_story_15201010","episode":"ep5","category":"quest_story","story_id":"15201010","schema_version":1,"lang":"en","texts":{"narration:1:1520101001:1":{"text":"Merlin the First envelops you with her magic, teleporting you to the realm of the Wedge of Matter.","source_cn":"初代梅林的魔力包围了你们，将你们传送到物质之楔的领域","status":"matched","hash_xxh64":"0x27B6496753135A5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":0}},"locales/en/ep5/quest_story/15201020.json":{"asset_key":"ep5/quest_story_15201020","episode":"ep5","category":"quest_story","story_id":"15201020","schema_version":1,"lang":"en","texts":{"say:3:1520102001:2":{"text":"<shk>RUMBLE!</shk>","source_cn":"<shk>轰——！</shk>","status":"matched","hash_xxh64":"0xBCC6E423CE93A019","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1520102002:0":{"text":"Wasn't this place sealed by the gods? And yet, an earthquake happens. Looks like the gods didn't do such a great job, huh.","source_cn":"神明封印的地方也会有地震？看来神的工作做得也不怎么样。","status":"matched","hash_xxh64":"0x2A236867C500A4AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1520102003:0":{"text":"This shows that the Wedge of Matter commands the power to <style=\"highlight\">move the earth</style>.","source_cn":"这说明，物质之楔拥有<style=highlight>...","status":"matched","hash_xxh64":"0xA043DCF3DC329255","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1520102004:1":{"text":"Watch your steps.","source_cn":"前进时小心脚下。","status":"matched","hash_xxh64":"0xE8513F4C81A431D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:脚下的轰鸣声":{"text":"Strange Noise","source":"脚下的轰鸣声","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":3}},"locales/en/ep5/quest_story/15201030.json":{"asset_key":"ep5/quest_story_15201030","episode":"ep5","category":"quest_story","story_id":"15201030","schema_version":1,"lang":"en","texts":{"say:0:1520103001:0":{"text":"Watch out for those balls.","source_cn":"小心那颗滚球。","status":"matched","hash_xxh64":"0x5A5753D27373E023","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1520103002:0":{"text":"There's a clearing up ahead. Let's take cover there.","source_cn":"前面有片空地，应该可以躲避。","status":"matched_runtime_gender","hash_xxh64":"0x7D5FC588E34DF459","variant_status":"runtime_gender_keys_target_same","male":"There's a clearing up ahead. Let's take cover there.","female":"There's a clearing up ahead. Let's take cover there.","variant_male_record_index":"175773","variant_female_record_index":"175774","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:主角":{"text":"Player","source":"主角","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep5/quest_story/15201040.json":{"asset_key":"ep5/quest_story_15201040","episode":"ep5","category":"quest_story","story_id":"15201040","schema_version":1,"lang":"en","texts":{"say:3:1520104001:0":{"text":"Nice! The balls stick to a set path and won't stray off it. This area is safe.","source_cn":"果然。滚球只会沿着特定的路径滚动，不会冲到旁边的空地上...","status":"matched","hash_xxh64":"0xE98145C8849ACF84","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1520104002:0":{"text":"What's that?","source_cn":"那颗滚球是什么？","status":"matched","hash_xxh64":"0x3678F25637471B8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1520104003:1":{"text":"It's a mechanism triggered by the Wedge of Matter.","source_cn":"是物质之楔召唤的机关。","status":"matched","hash_xxh64":"0xA377866D4556B503","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1520104004:0":{"text":"As Morgan suggested, we can use the safe spots along the path to dodge the rolling balls as we make our way to the sealing wedge.","source_cn":"如摩根所言，我们可以利用路径旁的安全区躲避滚球，前往封...","status":"matched","hash_xxh64":"0x7C7A514783884383","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1520104005:0":{"text":"Be careful.","source_cn":"多加小心。","status":"matched","hash_xxh64":"0x7BBFB2AC6DF6B790","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":3}},"locales/en/ep5/quest_story/15201050.json":{"asset_key":"ep5/quest_story_15201050","episode":"ep5","category":"quest_story","story_id":"15201050","schema_version":1,"lang":"en","texts":{"say:0:1520105001:0":{"text":"See those <style=\"highlight\">rock outcrops</style> on the ground? Steer clear of them.","source_cn":"地上有<style=highlight>岩凸</sty...","status":"matched","hash_xxh64":"0x67F41847B16655AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep5/quest_story/15201060.json":{"asset_key":"ep5/quest_story_15201060","episode":"ep5","category":"quest_story","story_id":"15201060","schema_version":1,"lang":"en","texts":{"say:0:1520106001:0":{"text":"There's a tree blocking our way.","source_cn":"前面的路被树拦住了。","status":"matched","hash_xxh64":"0x1B31EC9073DD807F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1520106002:0":{"text":"Let's move aside. The balls can help us <style=\"highlight\">get rid of it</style>.","source_cn":"让开路，让滚球<style=highlight>撞开它...","status":"matched_runtime_gender","hash_xxh64":"0x28D4BA294A59F3C1","variant_status":"runtime_gender_keys_target_same","male":"Let's move aside. The balls can help us <style=\"highlight\">get rid of it</style>.","female":"Let's move aside. The balls can help us <style=\"highlight\">get rid of it</style>.","variant_male_record_index":"175782","variant_female_record_index":"175783","document_title":"","document_title_male":"","document_title_fe