{"schema_version":1,"resources":{"locales/en/mn2/quest_story/10123010.json":{"asset_key":"mn2/quest_story_10123010","episode":"mn2","category":"quest_story","story_id":"10123010","schema_version":1,"lang":"en","texts":{"say:0:1012301001:0":{"text":"I've never seen a beautiful creature like that.","source_cn":"刚才那美丽的生物是什么？我从未见过。","status":"matched","hash_xxh64":"0x7936DAB3EA61AAEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1012301002:0":{"text":"Uh... did you not see how its head split into three?","source_cn":"呃……你是不是没看见它裂成三瓣的脑袋？","status":"matched","hash_xxh64":"0x8A0E76446269E205","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1012301003:0":{"text":"No, I saw it. It's as beautiful as a blooming flower.","source_cn":"看见了，像盛开的花朵一样美丽。","status":"matched","hash_xxh64":"0xCBA6402EC661760D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1012301004:0":{"text":"Our opinions on what constitutes beauty are very different...","source_cn":"好吧……反正我们的审美从来都天差地别。","status":"matched","hash_xxh64":"0x1894EBECC875D3BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}},"locales/en/mn2/quest_story/10123011.json":{"asset_key":"mn2/quest_story_10123011","episode":"mn2","category":"quest_story","story_id":"10123011","schema_version":1,"lang":"en","texts":{"say:0:1012301101:0":{"text":"Look over there. It's those butterflies again.","source_cn":"看前方，又是那些蝴蝶。","status":"matched","hash_xxh64":"0x653911E419326FA2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:布莱恩":{"text":"Bryon","source":"布莱恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/mn2/quest_story/10123020.json":{"asset_key":"mn2/quest_story_10123020","episode":"mn2","category":"quest_story","story_id":"10123020","schema_version":1,"lang":"en","texts":{"say:0:1012302001:0":{"text":"What is this blasted thing? It's so scary!","source_cn":"这到底是什么东西？它长得太吓人了！","status":"matched","hash_xxh64":"0x285B76DEB9DD0D3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1012302002:0":{"text":"They appeared with the butterflies. Maybe there's a connection.","source_cn":"它们两次伴随着黑色蝴蝶出现，而雅顿老师让我们跟着蝴蝶，...","status":"matched","hash_xxh64":"0x072282E22F244CB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1012302003:0":{"text":"Should we just follow the blue ones? They're Misarte's messengers.","source_cn":"非得跟着蝴蝶吗？那起码跟着蓝色闪蝶吧……至少它们是弥萨...","status":"matched","hash_xxh64":"0x9A0FCDBDB42E872F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1012302004:0":{"text":"Stop complaining. This could be the only way to Ivoryshade.","source_cn":"别抱怨了，这或许是前往月影乡的唯一方法。","status":"matched","hash_xxh64":"0x0BF91B54F880F280","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"},"speaker:布莱恩":{"text":"Bryon","source":"布莱恩","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":3}},"locales/en/mn2/quest_story/10123030.json":{"asset_key":"mn2/quest_story_10123030","episode":"mn2","category":"quest_story","story_id":"10123030","schema_version":1,"lang":"en","texts":{"say:1:1012303001:1":{"text":"Is that horrible creature about to come back...?","source_cn":"那种可怕的生物是不是又要出现了……","status":"matched","hash_xxh64":"0xAA062B191C802976","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1012303001":{"text":"Is that horrible creature about to come back...?","source_cn":"那种可怕的生物是不是又要出现了……","status":"matched","hash_xxh64":"0xAA062B191C802976","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1012303002:1":{"text":"Really? I'm psyching myself up for nothing.","source_cn":"什么……那我白做心理准备了。","status":"matched","hash_xxh64":"0xC0320EE80AB41A23","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1012303003:1":{"text":"Pray to Misarte, may this be our last test.","source_cn":"你向弥萨忒祈祷吧，但愿这是我们最后的考验。","status":"matched","hash_xxh64":"0xB2DE15FA2B066353","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1012303004:1":{"text":"You think this is a test? A test of what? There won't be a test of courage, will there?","source_cn":"你认为这是考验？考验什么啊……该不是考验胆量？","status":"matched","hash_xxh64":"0x550725C130213335","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1012303005:1":{"text":"A test to see if we're allowed into Ivoryshade.","source_cn":"考验我们是否有进入月影乡的资格。","status":"matched","hash_xxh64":"0xD1A41371616E241B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1012303006:1":{"text":"Where can we go? There's no road ahead.","source_cn":"从哪进？前面根本没路。","status":"matched","hash_xxh64":"0x4C41005102CEE1A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1012303007:1":{"text":"There is indeed no path if you're just using your eyes.","source_cn":"只是用肉眼看的话，前方确实没有路了。","status":"matched","hash_xxh64":"0xF96A5A5B03C1DCC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1012303008:1":{"text":"Lorsan, Bryon, can you hear anything?","source_cn":"洛桑，布莱恩，你们能否听出什么？","status":"matched","hash_xxh64":"0xC414112FD18F5E53","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1012303009:2":{"text":"Not right now.","source_cn":"暂时不行。","status":"matched","hash_xxh64":"0x149C5ABA52F2023D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1012303010:1":{"text":"If this really is a test, they first tested my archery, and then they tested Eironn's swordsmanship.","source_cn":"如果这一切真的是考验，第一次，是考验我的箭术，第二次，...","status":"matched","hash_xxh64":"0xEA448076343DE2CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1012303011:1":{"text":"Perhaps this time, they want to test your perception as a Windwhisperer, Bryon.","source_cn":"这一次，或许是考验你作为风语者的感知力，布莱恩。","status":"matched","hash_xxh64":"0xD2577514C934ED0B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1012303012:2":{"text":"I'm not the only Windwhisperer here. Lorsan is more skilled at scrying than I am.","source_cn":"这里不止我一个风语者，洛桑比我更擅长探查。","status":"matched","hash_xxh64":"0xDFC672F33B27FDC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1012303013:1":{"text":"You weren't so humble yesterday...","source_cn":"这时候你反倒谦虚起来了……","status":"matched","hash_xxh64":"0x81A7FF2F570EF40E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1012303013":{"text":"You weren't so humble yesterday...","source_cn":"这时候你反倒谦虚起来了……","status":"matched","hash_xxh64":"0x81A7FF2F570EF40E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1012303014:0":{"text":"Since you said that, I guess I have to do my best.","source_cn":"有你这么说，我一定会努力的！","status":"matched_runtime_gender","hash_xxh64":"0x96FA183A24A90891","variant_status":"runtime_gender_keys_target_same","male":"Since you said that, I guess I have to do my best.","female":"Since you said that, I guess I have to do my best.","variant_male_record_index":"109872","variant_female_record_index":"109873","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1012303017:0":{"text":"<style=\"stress\"><player_name></style>, I'll need to prepare the ritual that you witnessed in Ryeham.","source_cn":"接下来我会使用聚灵仪式，<style=stress><...","status":"matched_runtime_gender","hash_xxh64":"0x623210FE004D8C58","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, I'll need to prepare the ritual that you witnessed in Ryeham.","female":"<style=\"stress\"><player_name></style>, I'll need to prepare the ritual that you witnessed in Ryeham.","variant_male_record_index":"109876","variant_female_record_index":"109877","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1012303018:1":{"text":"This time, I'm going to ask you to collect <style=\"highlight\">bay twigs</style> for the ritual. I need to stay here and prepare.","source_cn":"这次也要麻烦你们去收集仪式所需的<style=high...","status":"matched_runtime_gender","hash_xxh64":"0x51BDA181C205ED26","variant_status":"runtime_gender_keys_target_same","male":"This time, I'm going to ask you to collect <style=\"highlight\">bay twigs</style> for the ritual. I need to stay here and prepare.","female":"This time, I'm going to ask you to collect <style=\"highlight\">bay twigs</style> for the ritual. I need to stay here and prepare.","variant_male_record_index":"109878","variant_female_record_index":"109879","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1012303019:1":{"text":"Just like before!","source_cn":"——就和之前咱们曾经做过的一样！","status":"matched_runtime_gender","hash_xxh64":"0x25C1A112800ABA64","variant_status":"runtime_gender_keys_target_same","male":"Just like before!","female":"Just like before!","variant_male_record_index":"109880","variant_female_record_index":"109881","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"I believe in you, Lorsan.","source_cn":"洛桑，我相信你","status":"matched_runtime_gender","hash_xxh64":"0x0A08BE940065AFFA","variant_status":"runtime_gender_keys_target_same","male":"I believe in you, Lorsan.","female":"I believe in you, Lorsan.","variant_male_record_index":"61030","variant_female_record_index":"61031","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1012303015:2":{"text":"If the concern of failure troubles him, I will do it on his behalf.","source_cn":"你要是担心出现闪失，我不介意代劳。","status":"matched","hash_xxh64":"0xA5F4742E39B16450","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1012303016:1":{"text":"No thanks! I can handle it.","source_cn":"谢谢，不劳你费心了！","status":"matched","hash_xxh64":"0xC085B9DA4115DE93","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"You should try again, Bryon.","source_cn":"布莱恩在给你机会","status":"matched_runtime_gender","hash_xxh64":"0x74AE30AC0407F221","variant_status":"runtime_gender_keys_target_same","male":"You should try again, Bryon.","female":"You should try again, Bryon.","variant_male_record_index":"61032","variant_female_record_index":"61033","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"It's different this time.","source_cn":"这次似乎不一样","status":"matched_runtime_gender","hash_xxh64":"0x70FCF7B5C3099465","variant_status":"runtime_gender_keys_target_same","male":"It's different this time.","female":"It's different this time.","variant_male_record_index":"61028","variant_female_record_index":"61029","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"},"speaker:布莱恩":{"text":"Bryon","source":"布莱恩","status":"matched_dialogue_flow"},"speaker:埃隆":{"text":"Eironn","source":"埃隆","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":25,"localized_text_count":24,"speaker_count":4}},"locales/en/mn2/quest_story/10123040.json":{"asset_key":"mn2/quest_story_10123040","episode":"mn2","category":"quest_story","story_id":"10123040","schema_version":1,"lang":"en","texts":{"say:0:1012304001:0":{"text":"We've got enough bay twigs. Let's return to Lorsan.","source_cn":"树枝找齐了，我们回去找洛桑吧。","status":"matched","hash_xxh64":"0xAA7E6E04F4BFAA10","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:埃隆":{"text":"Eironn","source":"埃隆","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/mn2/quest_story/10123050.json":{"asset_key":"mn2/quest_story_10123050","episode":"mn2","category":"quest_story","story_id":"10123050","schema_version":1,"lang":"en","texts":{"say:1:1012305001:0":{"text":"Okay, now I will start the ritual.","source_cn":"那么，现在，我要开始仪式了。","status":"matched","hash_xxh64":"0xD80DC69A9BD6DF55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1012305002:0":{"text":"<quality_6>Lord of the Winds, so wild and free, I stand before you, as you can see. I hear your breath. I feel your grace. Let me fall into your boundless embrace.</quality_6>","source_cn":"<quality_6>风的主宰啊……我立于此地，聆听你...","status":"matched","hash_xxh64":"0xBB3C7677D1A7C22B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1012305003:0":{"text":"<quality_6>May the dust fly in the wind's gentle breeze and whisper my prayers to you with ease.</quality_6>","source_cn":"<quality_6>愿无所不在的微尘替我低语，让您知...","status":"matched","hash_xxh64":"0x1B094DC2B24FCF9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1012305004:0":{"text":"<quality_6>I am Lorsan, yearning for your aid in awe, in anticipation of your guiding call.</quality_6>","source_cn":"<quality_6>我名为洛桑，期待您的呼唤，请您为...","status":"matched","hash_xxh64":"0x5922F72DBC81ADAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1012305005:0":{"text":"...!","source_cn":"……！","status":"matched","hash_xxh64":"0xCA75ECAFA62B2D23","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1012305005":{"text":"...!","source_cn":"……！","status":"matched","hash_xxh64":"0xCA75ECAFA62B2D23","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1012305006:0":{"text":"... I don't hear anything.","source_cn":"……我什么都没有听到。","status":"matched","hash_xxh64":"0x8C0A43C232AB1F7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1012305007:0":{"text":"How could that be...? Did we make a mistake?","source_cn":"怎么会……难道我们的推断出错了？","status":"matched","hash_xxh64":"0x8A3337D031EBF10B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1012305008:0":{"text":"No, this just proves that we weren't wrong! This is indeed a test for a Windwhisperer.","source_cn":"不，这恰恰证明了我们的推断没有错！这确实是对风语者的考验。","status":"matched","hash_xxh64":"0xB917D8EBBFCCEA42","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1012305009:2":{"text":"There are no true airtight walls in this world. Even the most solid rock has crevices filled with air.","source_cn":"这个世界上没有真正密不透风的墙。再坚实的岩壁，也会与空...","status":"matched","hash_xxh64":"0xDC623FED281EB96D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1012305010:0":{"text":"But there's absolutely no sound here. None at all. This means this is not a rock at all!","source_cn":"但这里完全没有声音，一点也没有。也就是说，这不是一块真...","status":"matched","hash_xxh64":"0x1A8A1CC326CD58F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1012305011:0":{"text":"It's a barrier created by magic, with the entrance hidden behind!","source_cn":"——而是用魔法营造的屏障，入口就藏在岩石后！","status":"matched","hash_xxh64":"0x41646FDC6B83B90D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:15:1012305011":{"text":"It's a barrier created by magic, with the entrance hidden behind!","source_cn":"——而是用魔法营造的屏障，入口就藏在岩石后！","status":"matched","hash_xxh64":"0x41646FDC6B83B90D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1012305012:0":{"text":"I just had a thought.","source_cn":"我有一个猜测。","status":"matched","hash_xxh64":"0x74842F7F8E7D3AB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1012305013:0":{"text":"There are two kinds of butterflies in front of the rock wall. Maybe that's a clue on how to break through the barrier.","source_cn":"岩壁前混杂着两种蝴蝶，这也许是在提示我们……破除屏障的方法。","status":"matched","hash_xxh64":"0xD2ED549766831852","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1012305014:0":{"text":"One type of butterfly can be removed by swordplay, and the other type needs to be shot by Lyca.","source_cn":"一种蝴蝶，可以被剑术清除，另一种，则需要莱卡击破。","status":"matched","hash_xxh64":"0x9B47FB4934E44DB5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1012305015:0":{"text":"What would happen if we combined our efforts against one butterfly?","source_cn":"如果，我们对着蝴蝶合力一击，会发生什么呢？","status":"matched","hash_xxh64":"0xFE79C6AB2881B3B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1012305016:0":{"text":"We might as well try. Let's do it, Lyca.","source_cn":"不如直接试试。一起上吧，莱卡。","status":"matched","hash_xxh64":"0x5F740CCA8D662311","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:15:0:1":{"text":"How do we get in?","source_cn":"要怎么进去呢？","status":"matched_runtime_gender","hash_xxh64":"0x2454974BC6BE22C9","variant_status":"runtime_gender_keys_target_same","male":"How do we get in?","female":"How do we get in?","variant_male_record_index":"61036","variant_female_record_index":"61037","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"Anything?","source_cn":"如何？","status":"matched_runtime_gender","hash_xxh64":"0xC5CC8663123B70E2","variant_status":"runtime_gender_keys_target_same","male":"Anything?","female":"Anything?","variant_male_record_index":"61034","variant_female_record_index":"61035","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:埃隆":{"text":"Eironn","source":"埃隆","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":21,"localized_text_count":20,"speaker_count":3}},"locales/en/mn2/quest_story/10123060.json":{"asset_key":"mn2/quest_story_10123060","episode":"mn2","category":"quest_story","story_id":"10123060","schema_version":1,"lang":"en","texts":{"say:0:1012306001:0":{"text":"There it is! It's the entrance! Ivoryshade, here we come!","source_cn":"出现了，是入口！我们一定离月影乡越来越近了！","status":"matched","hash_xxh64":"0x633BC06043990C04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/timeline/dialoguetree_story/1012311.json":{"asset_key":"timeline/dialoguetree_story_1012311","episode":"timeline","category":"dialoguetree_story","story_id":"1012311","schema_version":1,"lang":"en","texts":{},"speakers":{},"stats":{"flow_row_count":2,"localized_text_count":0,"speaker_count":0}},"locales/en/timeline/dialoguetree_story/1012318.json":{"asset_key":"timeline/dialoguetree_story_1012318","episode":"timeline","category":"dialoguetree_story","story_id":"1012318","schema_version":1,"lang":"en","texts":{},"speakers":{},"stats":{"flow_row_count":2,"localized_text_count":0,"speaker_count":0}}}}