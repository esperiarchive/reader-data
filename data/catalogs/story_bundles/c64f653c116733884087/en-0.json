{"schema_version":1,"resources":{"faction_dailies/locales/en/14010535/1.json":{"schema_version":1,"asset_key":"optional/objective_14010535:1:1","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010535/2.json":{"schema_version":1,"asset_key":"optional/objective_14010535:1:2","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010535/3.json":{"schema_version":1,"asset_key":"optional/objective_14010535:1:3","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010535/4.json":{"schema_version":1,"asset_key":"optional/objective_14010535:1:4","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010535/5.json":{"schema_version":1,"asset_key":"optional/objective_14010535:1:5","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010535/6.json":{"schema_version":1,"asset_key":"optional/objective_14010535:1:6","lang":"en","texts":{},"speakers":{}},"locales/en/ep4/quest_story/14234360.json":{"asset_key":"ep4/quest_story_14234360","episode":"ep4","category":"quest_story","story_id":"14234360","schema_version":1,"lang":"en","texts":{"say:1:1423436001:1":{"text":"<style=\"stress\"><player_name></style>, you won't believe this! They even asked me to deal with a crying kid...","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xF6EB93B60AE44C6C","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, you won't believe this! They even asked me to deal with a crying kid...","female":"<style=\"stress\"><player_name></style>, you won't believe this! They even asked me to deal with a crying kid...","variant_male_record_index":"171910","variant_female_record_index":"171911","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423436002:1":{"text":"Just hearing the word \"kid\" gives me a headache. They say it's happening east of the city. Can you check it out?","source_cn":"小孩子……我只要一听到这三个字就会头痛。据说是在王城的...","status":"matched_runtime_gender","hash_xxh64":"0x1FA1ED03F4068283","variant_status":"runtime_gender_keys_target_differs","male":"Just hearing the word \"kid\" gives me a headache. They say it's happening east of the city. Can you check it out?","female":"Just hearing the word \"kid\" gives me a headache. The report came from the eastern part of the city. Would you mind investigating?","variant_male_record_index":"171912","variant_female_record_index":"171913","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:沙利叶":{"text":"Ravion","source":"沙利叶","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/ep4/quest_story/14234370.json":{"asset_key":"ep4/quest_story_14234370","episode":"ep4","category":"quest_story","story_id":"14234370","schema_version":1,"lang":"en","texts":{"say:0:1423437001:0":{"text":"Is it that little girl? She's crying her little heart out...","source_cn":"是那个小女孩吗？她哭得好大声，好伤心……","status":"matched","hash_xxh64":"0xE85183AFC22E853E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14234390.json":{"asset_key":"ep4/quest_story_14234390","episode":"ep4","category":"quest_story","story_id":"14234390","schema_version":1,"lang":"en","texts":{"say:2:1423439001:1":{"text":"Hey there, is there anything we can do to help?","source_cn":"小姑娘，我们有什么能帮到你的地方吗？","status":"matched","hash_xxh64":"0x2D06636FBDDD9334","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423439002:1":{"text":"Mittens is gone! I can't find him anywhere!","source_cn":"我的咪咪不见了……咪咪找不到了！","status":"matched","hash_xxh64":"0xFA6FB4FBA5B37D55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423439003:1":{"text":"I thought Mittens would stay with me after my parents left... and now even he's gone...","source_cn":"我以为咪咪会代替爸爸妈妈陪着我的，咪咪，连你也不要我了吗……","status":"matched","hash_xxh64":"0x85DEC0184F3255E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423439004:1":{"text":"Sounds like she lost her family, and her pet Mittens was the only one left by her side...","source_cn":"听上去这个小女孩失去了自己的家人，和一只叫“咪咪”的宠...","status":"matched","hash_xxh64":"0x19480A298D8223D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423439005:1":{"text":"Can you tell us what Mittens looks like?","source_cn":"小姑娘，你的咪咪长什么样子呀？","status":"matched","hash_xxh64":"0x8312852939DF56BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423439006:1":{"text":"He's black, with pointy ears...","source_cn":"黑色的、耳朵尖尖的……","status":"matched","hash_xxh64":"0xDCB5A33BE793D4E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423439007:1":{"text":"A little sith, then! Alright, let's help her search...","source_cn":"原来是小法妖呀！我们帮她找找吧……","status":"matched","hash_xxh64":"0xB148D3B8A76556C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:哭泣的平民女孩":{"text":"Crying Girl","source":"哭泣的平民女孩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}},"locales/en/ep4/quest_story/14234400.json":{"asset_key":"ep4/quest_story_14234400","episode":"ep4","category":"quest_story","story_id":"14234400","schema_version":1,"lang":"en","texts":{"say:1:1423440001:1":{"text":"*Sobbing* Mittens is back! Thank you for bringing him home!","source_cn":"呜呜……咪咪回来了！谢谢你们找到它！","status":"matched","hash_xxh64":"0xDDAD528D2DC8EDF2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423440002:1":{"text":"Stop right there! That Mittens you speak of is my missing pet! Where did you find him?!","source_cn":"站住！汝口中所谓“咪咪”，乃吾遗失之家宠！汝从何处得来！","status":"matched","hash_xxh64":"0xCB81AD1DFA8952BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423440003:1":{"text":"What's he talking about?","source_cn":"他说的话是什么意思……","status":"matched","hash_xxh64":"0x3569B133AE3B7AB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423440004:1":{"text":"He says Mittens is his lost pet. He wants to know where you found him...","source_cn":"他说咪咪是他丢失的宠物，问你从哪里得到的……","status":"matched","hash_xxh64":"0x68DCD9517FF42D02","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423440005:1":{"text":"I found him in the bushes... he was so thin. I took care of him...","source_cn":"呜……咪咪是我在草丛里捡到的，那个时候它很瘦，我把它照...","status":"matched","hash_xxh64":"0x01EB28A4DABF34C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423440006:1":{"text":"Lies! My pet lives in luxury! You clearly stole him! Guards, go get my Mi... my cat back!","source_cn":"满口胡言！吾之家宠养尊处优，定是你蓄意拐跑！侍卫，替吾...","status":"matched","hash_xxh64":"0x4629DC775DA3FF9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哭泣的平民女孩":{"text":"Crying Girl","source":"哭泣的平民女孩","status":"matched_dialogue_flow"},"speaker:骄傲的贵族男孩":{"text":"Arrogant Boy","source":"骄傲的贵族男孩","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":3}},"locales/en/ep4/quest_story/14234410.json":{"asset_key":"ep4/quest_story_14234410","episode":"ep4","category":"quest_story","story_id":"14234410","schema_version":1,"lang":"en","texts":{"say:3:1423441001:1":{"text":"Ugh! You useless guards! Alright, alright, I surrender, okay? Just don't hit me!","source_cn":"哇……你们这些侍卫太、太没用了！别打我，我认错还不行嘛！","status":"matched","hash_xxh64":"0x3F359D012EF3951E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423441002:1":{"text":"Not so high and mighty now, are you?","source_cn":"现在倒是不摆那副贵族的架子了呢。","status":"matched","hash_xxh64":"0x4F6E03954D9EF98E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1423441002":{"text":"Not so high and mighty now, are you?","source_cn":"现在倒是不摆那副贵族的架子了呢。","status":"matched","hash_xxh64":"0x4F6E03954D9EF98E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423441003:1":{"text":"I-I get it... I was wrong...","source_cn":"我、我知道啦……我错了……","status":"matched","hash_xxh64":"0x6D2D5E04345C9815","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423441004:1":{"text":"Truth is... I knew the little sith had been thrown out by the adults at home...","source_cn":"好吧，其实我知道，小法妖是被家里的大人扔掉的……","status":"matched","hash_xxh64":"0xC27ABC7B934505B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423441005:1":{"text":"You've taken such good care of him. I guess he belongs with you now...","source_cn":"既然你把它照顾得这么好，就让你做它的新主人吧……","status":"matched","hash_xxh64":"0xEED7ADA25BD1342B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1423441006:1":{"text":"Mittens, you live with me now...","source_cn":"咪咪，我是你的主人了……","status":"matched","hash_xxh64":"0x452C47E468802B67","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"No nobles and commoners anymore.","source_cn":"现在已经没有贵族和平民的分别了","status":"matched_runtime_gender","hash_xxh64":"0xFD3CE496675DA2E4","variant_status":"runtime_gender_keys_target_same","male":"No nobles and commoners anymore.","female":"No nobles and commoners anymore.","variant_male_record_index":"74424","variant_female_record_index":"74425","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:1:2":{"text":"Can't use force to get your way.","source_cn":"不再是贵族能肆意动用武力的时候了","status":"matched_runtime_gender","hash_xxh64":"0xC083193C61DD6516","variant_status":"runtime_gender_keys_target_same","male":"Can't use force to get your way.","female":"Can't use force to get your way.","variant_male_record_index":"74426","variant_female_record_index":"74427","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:骄傲的贵族男孩":{"text":"Arrogant Boy","source":"骄傲的贵族男孩","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:哭泣的平民女孩":{"text":"Crying Girl","source":"哭泣的平民女孩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":3}},"locales/en/ep4/quest_story/14234420.json":{"asset_key":"ep4/quest_story_14234420","episode":"ep4","category":"quest_story","story_id":"14234420","schema_version":1,"lang":"en","texts":{"say:0:1423442001:0":{"text":"Kids... their world's more complicated than it looks.","source_cn":"小孩子的世界可真复杂……","status":"matched","hash_xxh64":"0x1DD66E514150BFBF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1423442002:0":{"text":"Anyway, it's all sorted. Let's go tell Ravion.","source_cn":"总之，事情解决了，我们回去告诉沙利叶吧！","status":"matched","hash_xxh64":"0x0FD26C42E8075786","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/ep4/quest_story/14234430.json":{"asset_key":"ep4/quest_story_14234430","episode":"ep4","category":"quest_story","story_id":"14234430","schema_version":1,"lang":"en","texts":{"say:1:1423443001:1":{"text":"From the look on your faces, I'm guessing it's taken care of, huh?","source_cn":"从你们的脸上，我看到了“圆满解决”四个字，我猜的对吗？","status":"matched","hash_xxh64":"0x8A9EE8DB9E3B0A9A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1423443001":{"t