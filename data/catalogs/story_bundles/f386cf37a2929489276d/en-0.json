{"schema_version":1,"resources":{"locales/en/mn3/quest_story/10130010.json":{"asset_key":"mn3/quest_story_10130010","episode":"mn3","category":"quest_story","story_id":"10130010","schema_version":1,"lang":"en","texts":{"narration:0:1013001001:1":{"text":"The ship heading back to Holistone set sail.","source_cn":"","status":"matched","hash_xxh64":"0x547B3B3949C8C209","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:1:1013001002:1":{"text":"A few days later...","source_cn":"","status":"matched","hash_xxh64":"0xA93B9D9915072C14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1013001003:1":{"text":"Watching those refugees find shelter, it feels like things in the Dark Forest are finally settling down.","source_cn":"看着那些难民得到安置，事到如今，薄暮丛林的事态算是告一...","status":"matched","hash_xxh64":"0xCC371C616BCBD609","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1013001004:1":{"text":"*Laughter* We're just like the tales sung by the bards—loyal knights, once again wielding their swords and shields, protecting the people!","source_cn":"嗯嗯！就像吟游诗人唱的那样——忠义的骑士满满，再一次用...","status":"matched","hash_xxh64":"0xC377011743F0A41D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1013001005:2":{"text":"Come on, you big talker. You didn't even do much.","source_cn":"满满这个笨蛋，明明什么也没做嘛。","status":"matched","hash_xxh64":"0xA6B517A931B7737D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1013001006:2":{"text":"Our mighty magister did most of the work, right?","source_cn":"解除限制令、救助难民，主要都是梅林大人的功劳，是吧是吧！","status":"matched_runtime_gender","hash_xxh64":"0x8B3813141720F7E8","variant_status":"runtime_gender_keys_target_same","male":"Our mighty magister did most of the work, right?","female":"Our mighty magister did most of the work, right?","variant_male_record_index":"114268","variant_female_record_index":"114269","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1013001006":{"text":"Our mighty magister did most of the work, right?","source_cn":"解除限制令、救助难民，主要都是梅林大人的功劳，是吧是吧！","status":"matched_runtime_gender","hash_xxh64":"0x8B3813141720F7E8","variant_status":"runtime_gender_keys_target_same","male":"Our mighty magister did most of the work, right?","female":"Our mighty magister did most of the work, right?","variant_male_record_index":"114268","variant_female_record_index":"114269","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1013001007:2":{"text":"Seriously, you're too modest sometimes...","source_cn":"哈，你这幅充满魅力的嘴脸真可恶。","status":"matched_runtime_gender","hash_xxh64":"0x041929F7763E96B3","variant_status":"runtime_gender_keys_target_same","male":"Seriously, you're too modest sometimes...","female":"Seriously, you're too modest sometimes...","variant_male_record_index":"114270","variant_female_record_index":"114271","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1013001008:2":{"text":"Anyways, we're back in Holistone again. I wonder if anyone missed me?","source_cn":"再度归来，圣石镇的居民们，应该没有特别想念我吧？","status":"matched","hash_xxh64":"0xCB3D6895A82BB114","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"I just did what I could.","source_cn":"尽我所能罢了","status":"matched_runtime_gender","hash_xxh64":"0xEC433D64BA9C0BF0","variant_status":"runtime_gender_keys_target_same","male":"I just did what I could.","female":"I just did what I could.","variant_male_record_index":"62154","variant_female_record_index":"62155","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"Couldn't have done it without you all.","source_cn":"真正的英雄是大家","status":"matched_runtime_gender","hash_xxh64":"0xF48F6EA644BABA67","variant_status":"runtime_gender_keys_target_same","male":"Couldn't have done it without you all.","female":"Couldn't have done it without you all.","variant_male_record_index":"62156","variant_female_record_index":"62157","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":12,"localized_text_count":11,"speaker_count":4}},"locales/en/mn3/quest_story/10130020.json":{"asset_key":"mn3/quest_story_10130020","episode":"mn3","category":"quest_story","story_id":"10130020","schema_version":1,"lang":"en","texts":{"say:0:1013002001:0":{"text":"Huh? Why's everyone in town looking so frantic?","source_cn":"咦？镇民们怎么慌慌张张的？","status":"matched","hash_xxh64":"0x658FD599F7C32742","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1013002002:0":{"text":"Seems like the road's blocked!","source_cn":"主人，那里好像封路了！","status":"matched_runtime_gender","hash_xxh64":"0x0F3DD9FD5A7F539D","variant_status":"runtime_gender_keys_target_same","male":"Seems like the road's blocked!","female":"Seems like the road's blocked!","variant_male_record_index":"114274","variant_female_record_index":"114275","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013002003:0":{"text":"Something's not right. Let's check it out.","source_cn":"情况有些不对劲，我们去那边看看。","status":"matched","hash_xxh64":"0x8DC0353A5F0D36DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":3}},"locales/en/mn3/quest_story/10130030.json":{"asset_key":"mn3/quest_story_10130030","episode":"mn3","category":"quest_story","story_id":"10130030","schema_version":1,"lang":"en","texts":{"say:0:1013003001:0":{"text":"What's going on over there?","source_cn":"西边是什么动静？","status":"matched","hash_xxh64":"0x77C6AE1FBECAEE17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1013003002:0":{"text":"I'm a bit scared...","source_cn":"有点吓人啊。","status":"matched","hash_xxh64":"0xEE39FB1B1ECBBEFF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:消息灵通的青年":{"text":"Informed Man","source":"消息灵通的青年","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/mn3/quest_story/10130070.json":{"asset_key":"mn3/quest_story_10130070","episode":"mn3","category":"quest_story","story_id":"10130070","schema_version":1,"lang":"en","texts":{"say:1:1013007001:1":{"text":"Phew... Thanks for the help. My name is Temesia.","source_cn":"特弥希娅——这是我的名字。呼……多谢援手。","status":"matched","hash_xxh64":"0xC75F8DC740448220","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013007002:1":{"text":"You guys are really something, landing a heavy blow on the golems right away!","source_cn":"你们的实力真不简单，一出手便重创了魔偶！","status":"matched","hash_xxh64":"0x54BCF400092A0FB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1013007002":{"text":"You guys are really something, landing a heavy blow on the golems right away!","source_cn":"你们的实力真不简单，一出手便重创了魔偶！","status":"matched","hash_xxh64":"0x54BCF400092A0FB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1013007003:3":{"text":"Ease off on the cool one-liners, <style=\"stress\"><player_name></style>. It's not good for Hammie's heart!","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xAC52A7697BBE0177","variant_status":"runtime_gender_keys_target_same","male":"Ease off on the cool one-liners, <style=\"stress\"><player_name></style>. It's not good for Hammie's heart!","female":"Ease off on the cool one-liners, <style=\"stress\"><player_name></style>. It's not good for Hammie's heart!","variant_male_record_index":"114284","variant_female_record_index":"114285","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1013007004:2":{"text":"Valen, what are you on about? That wasn't even a fraction of <style=\"stress\"><player_name></style>'s power!","source_cn":"维伦你在瞎说什么？在<style=stress><pl...","status":"matched_runtime_gender","hash_xxh64":"0x58C2039126F962C6","variant_status":"runtime_gender_keys_target_same","male":"Valen, what are you on about? That wasn't even a fraction of <style=\"stress\"><player_name></style>'s power!","female":"Valen, what are you on about? That wasn't even a fraction of <style=\"stress\"><player_name></style>'s power!","variant_male_record_index":"114286","variant_female_record_index":"114287","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1013007005:1":{"text":"Anyways, Magister, something incredible flew by just now!","source_cn":"不过，主人，刚才还有个不得了的东西飞过来了！","status":"matched_runtime_gender","hash_xxh64":"0x1FF14E5E1AB5B8A1","variant_status":"runtime_gender_keys_target_same","male":"Anyways, Magister, something incredible flew by just now!","female":"Anyways, Magister, something incredible flew by just now!","variant_male_record_index":"114288","variant_female_record_index":"114289","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1013007006:1":{"text":"And then, the golem fell... Everyone, I'll check the situation.","source_cn":"然后，魔偶倒下了……诸位，我要去查看一下情况。","status":"matched","hash_xxh64":"0xA795C002983E4405","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1013007007:2":{"text":"What do you think happened, <style=\"stress\"><player_name></style>?","source_cn":"关于发生了什么，<style=stress><play...","status":"matched_runtime_gender","hash_xxh64":"0xB741BAEB7529C146","variant_status":"runtime_gender_keys_target_same","male":"What do you think happened, <style=\"stress\"><player_name></style>?","female":"What do you think happened, <style=\"stress\"><player_name></style>?","variant_male_record_index":"114291","variant_female_record_index":"114292","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"It's not a big deal.","source_cn":"区区小意思","status":"matched_runtime_gender","hash_xxh64":"0x9B01066DF54BE9A7","variant_status":"runtime_gender_keys_target_same","male":"It's not a big deal.","female":"It's not a big deal.","variant_male_record_index":"62158","variant_female_record_index":"62159","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"Sorry I couldn't finish it faster.","source_cn":"不好意思，没能一击消灭","status":"matched_runtime_gender","hash_xxh64":"0xA461FB060436DE49","variant_status":"runtime_gender_keys_target_same","male":"Sorry I couldn't finish it faster.","female":"Sorry I couldn't finish it faster.","variant_male_record_index":"62160","variant_female_record_index":"62161","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:特弥希娅":{"text":"Temesia","source":"特弥希娅","status":"matched_dialogue_flow"},"speaker:卢修斯":{"text":"Lucius","source":"卢修斯","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":4}},"locales/en/mn3/quest_story/10130080.json":{"asset_key":"mn3/quest_story_10130080","episode":"mn3","category":"quest_story","story_id":"10130080","schema_version":1,"lang":"en","texts":{"say:0:1013008001:0":{"text":"Let's go check it out together.","source_cn":"走吧，我们一起去确认一下。","status":"matched","hash_xxh64":"0xBAA4FB3F7F1CF47A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/mn3/quest_story/10130090.json":{"asset_key":"mn3/quest_story_10130090","episode":"mn3","category":"quest_story","story_id":"10130090","schema_version":1,"lang":"en","texts":{"say:2:1013009001:0":{"text":"There's something embedded in the golem's head... Looks like its energy source.","source_cn":"魔偶的头部镶嵌着某个特殊结构。看起来像是它行动的能源……","status":"matched","hash_xxh64":"0x66C1F9F003322D0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1013009002:0":{"text":"So, it stopped moving because its energy source got destroyed?","source_cn":"所以，魔偶停下来，是因为它的能源被破坏了？","status":"matched","hash_xxh64":"0x34309D20D2B2C444","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1013009002":{"text":"So, it stopped moving because its energy source got destroyed?","source_cn":"所以，魔偶停下来，是因为它胸口的能源被破坏了？","status":"matched","hash_xxh64":"0x34309D20D2B2C444","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1013009003:1":{"text":"Then this might be a way to stop golems from causing trouble in the future!","source_cn":"我也赞同两位的意见，或许这将成为我们制止魔偶为祸的途径之一。","status":"matched","hash_xxh64":"0x825739E55D3698E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1013009005:1":{"text":"Unfortunately, that's all the information we can gather for now.","source_cn":"很可惜，就现在而言，我们只能获取到这些信息了。","status":"matched","hash_xxh64":"0x025DBEA3D05BF5A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"In theory, yes.","source_cn":"理论上是这样","status":"matched_runtime_gender","hash_xxh64":"0x2A6C227C2A544376","variant_status":"runtime_gender_keys_target_same","male":"In theory, yes.","female":"In theory, yes.","variant_male_record_index":"62162","variant_female_record_index":"62163","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1013009004:0":{"text":"This level of power and a weapon that disappeared with no trace? That's beyond human strength...","source_cn":"这种程度的力量和毫无痕迹的武器，已经超越了凡人之力……","status":"matched","hash_xxh64":"0xDA46F446DF519126","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:1:2":{"text":"But that spear just disappeared...","source_cn":"消散的武器也很令人在意","status":"matched_runtime_gender","hash_xxh64":"0x357D634201F65EA2","variant_status":"runtime_gender_keys_target_same","male":"But that spear just disappeared...","female":"But that spear just disappeared...","variant_male_record_index":"62164","variant_female_record_index":"62165","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:特弥希娅":{"text":"Temesia","source":"特弥希娅","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":2}},"locales/en/mn3/quest_story/10130100.json":{"asset_key":"mn3/quest_story_10130100","episode":"mn3","category":"quest_story","story_id":"10130100","schema_version":1,"lang":"en","texts":{"say:1:1013010001:1":{"text":"Let me thank you all again for your huge help.","source_cn":"失礼了，请允许我再次感谢诸位的鼎力协助。","status":"matched","hash_xxh64":"0x7DCE254BE07B008C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013010002:2":{"text":"We just did our best. Couldn't have done it without you all—the <style=\"highlight\">Templar Knights</style>!","source_cn":"我们只是尽力而为，真正的英雄是你们——大驾光临的圣堂骑士们！","status":"matched","hash_xxh64":"0x79F5DEC7C9FB180C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1013010002":{"text":"We just did our best. Couldn't have done it without you all—the <style=\"highlight\">Templar Knights</style>!","source_cn":"我们只是尽力而为，真正的英雄是你们——大驾光临的圣堂骑士们！","status":"matched","hash_xxh64":"0x79F5DEC7C9FB180C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1013010003:2":{"text":"Aha, you caught me!","source_cn":"只是想说说看嘛。","status":"matched","hash_xxh64":"0x1FE6254063282267","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1013010005:1":{"text":"Dura above, I'm a Templar Knight in charge of leading a small squad through Holistone.","source_cn":"艾雅在上，我是隶属圣堂的圣骑士，目前带领一个小队途径圣石镇。","status":"matched","hash_xxh64":"0xA644C8D4048F995E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1013010006:1":{"text":"I'm the deputy captain, Lucius. We arrived at Holistone just in time to see the golems attack...","source_cn":"我是副队卢修斯，我们抵达圣石镇不久，恰好碰上魔偶来袭……","status":"matched","hash_xxh64":"0x0FF18FE2C6B6B6C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1013010007:1":{"text":"Please let me inform you, those creatures called golems...","source_cn":"请允许我告知各位，如今被称为“魔偶”的怪物——","status":"matched","hash_xxh64":"0x576470A5CBDC82F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1013010008:1":{"text":"They were created for a good cause by Dura; therefore, stopping them from hurting humanity is our responsibility.","source_cn":"与女神和圣堂有关，阻止它们为祸人间，也是我们的责任所在。","status":"matched","hash_xxh64":"0x5C741990EB4FB282","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1013010009:1":{"text":"\"The road to hell is paved with good intentions.\" We'd be in way less trouble if your goddess had the forethought to make less of these things.","source_cn":"“善意之路，通往深渊。”你们的女神，当初就不能少慈爱一点吗？","status":"matched","hash_xxh64":"0xE5AE17E7B36B549E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1013010010:2":{"text":"... Please do not speak such blasphemy in front of me.","source_cn":"……你不够虔信，这并不是我的损失。","status":"matched","hash_xxh64":"0x931EAC984EA78ECB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"Imitating my words from earlier...?","source_cn":"真是耳熟……","status":"matched_runtime_gender","hash_xxh64":"0x23C599EE6228B7B4","variant_status":"runtime_gender_keys_target_same","male":"Imitating my words from earlier...?","female":"Imitating my words from earlier...?","variant_male_record_index":"62166","variant_female_record_index":"62167","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1013010004:1":{"text":"Nevertheless, your help is greatly appreciated. I'd bow in thanks, though unfortunately my heavy armor won't allow me to.","source_cn":"重甲在身，不便行礼。如果我们的态度引起误会……我道歉。","status":"matched","hash_xxh64":"0x3E76170F484CEB35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"Please, it was our duty.","source_cn":"真是刺耳","status":"matched_runtime_gender","hash_xxh64":"0xB372182A5D1033BA","variant_status":"runtime_gender_keys_target_same","male":"Please, it was our duty.","female":"Please, it was our duty.","variant_male_record_index":"62168","variant_female_record_index":"62169","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:特弥希娅":{"text":"Temesia","source":"特弥希娅","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"},"speaker:卢修斯":{"text":"Lucius","source":"卢修斯","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14,"localized_text_count":13,"speaker_count":3}},"locales/en/mn3/quest_story/10130110.json":{"asset_key":"mn3/quest_story_10130110","episode":"mn3","category":"quest_story","story_id":"10130110","schema_version":1,"lang":"en","texts":{"say:0:1013011001:0":{"text":"Hey, isn't that the general?","source_cn":"哟，那熟悉的身影，不会是将军吧？","status":"matched","hash_xxh64":"0xC3CFFC92066E946B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1013011002:0":{"text":"Looks like I saved myself the trip to town to make my report to him.","source_cn":"看来，省了我去镇里找他汇报的功夫。","status":"matched","hash_xxh64":"0x5E36B28896DA3FB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/mn3/quest_story/10130120.json":{"asset_key":"mn3/quest_story_10130120","episode":"mn3","category":"quest_story","story_id":"10130120","schema_version":1,"lang":"en","texts":{"say:1:1013012001:0":{"text":"Golems attacked, and you guys from the Temple fought them off. Then, a glowing spear flew in and pierced the golem's head, then vanished...","source_cn":"魔偶来袭……你们和圣堂的人一起抵挡……飞来一根发光长矛...","status":"matched","hash_xxh64":"0xE04DAC355E67CAF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013012002:1":{"text":"That's a crazy story. Old friend, did Valen here exaggerate things a bit?","source_cn":"老朋友，你说说看，维伦这小子，没有添油加醋吧？","status":"matched_runtime_gender","hash_xxh64":"0x3C2EC8937796792A","variant_status":"runtime_gender_keys_target_same","male":"That's a crazy story. Old friend, did Valen here exaggerate things a bit?","female":"That's a crazy story. Old friend, did Valen here exaggerate things a bit?","variant_male_record_index":"114312","variant_female_record_index":"114313","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1013012002":{"text":"That's a crazy story. Old friend, did Valen here exaggerate things a bit?","source_cn":"老朋友，你说说看，维伦这小子，没有添油加醋吧？","status":"matched_runtime_gender","hash_xxh64":"0x3C2EC8937796792A","variant_status":"runtime_gender_keys_target_same","male":"That's a crazy story. Old friend, did Valen here exaggerate things a bit?","female":"That's a crazy story. Old friend, did Valen here exaggerate things a bit?","variant_male_record_index":"114312","variant_female_record_index":"114313","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1013012003:3":{"text":"General, you really do need to be less suspicious. Hmm, looks like you're getting to that time in life when worrying becomes a habit...","source_cn":"我都说了吧？将军真是操心。嗯，看来是到了操心的年纪……","status":"matched","hash_xxh64":"0xD2742AE2FB91F7A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1013012005:1":{"text":"Alright, let's cut the chitchat.\nWith the golems endangering the town, as the Magistrate, I can't ignore this.","source_cn":"那么，闲话少叙。\\n既然魔偶的异常活动危及了镇民安全，...","status":"matched","hash_xxh64":"0x4C173C80E28A9AD8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1013012006:2":{"text":"So, my friend, could I ask you again to investigate this?","source_cn":"所以，朋友……我能再次拜托你，调查一下这件事吗？","status":"matched_runtime_gender","hash_xxh64":"0xB53B6470827AA325","variant_status":"runtime_gender_keys_target_same","male":"So, my friend, could I ask you again to investigate this?","female":"So, my friend, could I ask you again to investigate this?","variant_male_record_index":"114318","variant_female_record_index":"114319","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1013012007:1":{"text":"Don't worry, I'll have Valen help you out. So—","source_cn":"放心，我会让维伦协助你的。那么——","status":"matched_runtime_gender","hash_xxh64":"0x620682E47D252B53","variant_status":"runtime_gender_keys_target_same","male":"Don't worry, I'll have Valen help you out. So—","female":"Don't worry, I'll have Valen help you out. So—","variant_male_record_index":"114320","variant_female_record_index":"114321","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1013012008:1":{"text":"General Hogan, can I say something?","source_cn":"霍根将军，我可以插句话吗？","status":"matched","hash_xxh64":"0x4A448BCF4309BA3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1013012009:1":{"text":"Protecting Holistone and confronting those golems... Knight Temesia and her squad took part. But the town's defenses are limited...","source_cn":"守卫圣石镇，对抗魔偶。圣骑士特弥希娅与她的小队也有参与...","status":"matched","hash_xxh64":"0x33BFD1ECA1770A07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1013012010:1":{"text":"If those golems strike again, they might have a hard time. For the safety of Dura's people, the Temple can't just stand by.","source_cn":"如果魔偶再次来袭，你们可能会难以抵挡。对女神子民的安危...","status":"matched","hash_xxh64":"0xAE993200FAD62065","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1013012011:1":{"text":"We can leave our entire knight squad to assist them, but there's a condition—Temesia and Lucius must join them in the investigation.","source_cn":"我们可以留下整个骑士小队帮助你们，唯一的条件是，特弥希...","status":"matched","hash_xxh64":"0xFC88D83A0B412FF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1013012012:2":{"text":"Hmm. Well, Magister <style=\"stress\"><player_name></style>, what do you think?","source_cn":"这种事，我总要问过负责人的意见。<style=stre...","status":"matched_runtime_gender","hash_xxh64":"0x32BD83171ABC2CCB","variant_status":"runtime_gender_keys_target_same","male":"Hmm. Well, Magister <style=\"stress\"><player_name></style>, what do you think?","female":"Hmm. Well, Magister <style=\"stress\"><player_name></style>, what do you think?","variant_male_record_index":"114326","variant_female_record_index":"114327","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1013012012":{"text":"Hmm. Well, Magister <style=\"stress\"><player_name></style>, what do you think?","source_cn":"这种事，我总要问过负责人的意见。<style=stress><player_name></style>，怎么说？","status":"matched_runtime_gender","hash_xxh64":"0x32BD83171ABC2CCB","variant_status":"runtime_gender_keys_target_same","male":"Hmm. Well, Magister <style=\"stress\"><player_name></style>, what do you think?","female":"Hmm. Well, Magister <style=\"stress\"><player_name></style>, what do you think?","variant_male_record_index":"114326","variant_female_record_index":"114327","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1013012013:4":{"text":"Wow, you really stay positive in any unexpected situation.","source_cn":"哇！总有人说我夸人会让人不舒服，但跟你比还差得远呢。","status":"matched_runtime_gender","hash_xxh64":"0xA4F1D4FAEC823E55","variant_status":"runtime_gender_keys_target_same","male":"Wow, you really stay positive in any unexpected situation.","female":"Wow, you really stay positive in any unexpected situation.","variant_male_record_index":"114328","variant_female_record_index":"114329","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1013012016:0":{"text":"Apologies for the intrusion, everyone. We're just following Dura's wishes.","source_cn":"那么诸位，打扰了。我们只是在遵行艾雅的意志。","status":"matched","hash_xxh64":"0x7FFC7DD7B184C276","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1013012017:0":{"text":"So, from now on, we're comrades fighting alongside each other.","source_cn":"所以，今后我们就是并肩作战的战友了。","status":"matched","hash_xxh64":"0x26961186980F30A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1013012018:0":{"text":"Assisting those in need is an honor for Templar Knights. There's no need for formalities between us!","source_cn":"扶危济困是圣堂骑士的荣誉所在，千万不要和我客气！","status":"matched","hash_xxh64":"0x8C52694744D0F4FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1013012019:2":{"text":"...Ugh, I'm not good at handling these types of people.","source_cn":"……完蛋，我最不擅长应付这种一根筋了。","status":"matched","hash_xxh64":"0x621EBDF7B6074F65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"I'd love their help!","source_cn":"热烈欢迎两位圣堂骑士加入调查！","status":"matched_runtime_gender","hash_xxh64":"0xFF7F945C5EA72F3F","variant_status":"runtime_gender_keys_target_same","male":"I'd love their help!","female":"I'd love their help!","variant_male_record_index":"62174","variant_female_record_index":"62175","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1013012014:2":{"text":"I apologize. Once again, old friend, you're shouldering the responsibility.","source_cn":"老朋友……又让你承担责任了。","status":"matched_runtime_gender","hash_xxh64":"0x9293C182A610AB89","variant_status":"runtime_gender_keys_target_same","male":"I apologize. Once again, old friend, you're shouldering the responsibility.","female":"I apologize. Once again, old friend, you're shouldering the responsibility.","variant_male_record_index":"114330","variant_female_record_index":"114331","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:1:2":{"text":"I'm fine with anything.","source_cn":"无所谓……","status":"matched_runtime_gender","hash_xxh64":"0xB91C018D744C2E6D","variant_status":"runtime_gender_keys_target_same","male":"I'm fine with anything.","female":"I'm fine with anything.","variant_male_record_index":"62176","variant_female_record_index":"62177","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1013012015:2":{"text":"There's a connection between the golems and Dura. If you're going to pursue this matter, I believe the Temple's help is crucial.","source_cn":"魔偶与女神颇有渊源，如果你们想要追查此事，圣堂的协助必...","status":"matched","hash_xxh64":"0xC23000C9628FD312","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:2:3":{"text":"Can I refuse?","source_cn":"我可以拒绝吗？","status":"matched_runtime_gender","hash_xxh64":"0xDAE08B4BA624BCB8","variant_status":"runtime_gender_keys_target_same","male":"Can I refuse?","female":"Can I refuse?","variant_male_record_index":"62178","variant_female_record_index":"62179","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"Everything he said was true.","source_cn":"他说的全是事实","status":"matched_runtime_gender","hash_xxh64":"0xB7829D0367314328","variant_status":"runtime_gender_keys_target_same","male":"Everything he said was true.","female":"Everything he said was true.","variant_male_record_index":"62170","variant_female_record_index":"62171","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1013012004:2":{"text":"Magister <style=\"stress\"><player_name></style>, that's not the main issue here...","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x5BE8A5B3760B5502","variant_status":"runtime_gender_keys_target_same","male":"Magister <style=\"stress\"><player_name></style>, that's not the main issue here...","female":"Magister <style=\"stress\"><player_name></style>, that's not the main issue here...","variant_male_record_index":"114315","variant_female_record_index":"114316","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"You two bicker so much...","source_cn":"省略了任性拌嘴的部分","status":"matched_runtime_gender","hash_xxh64":"0x56711CBFF57384E1","variant_status":"runtime_gender_keys_target_same","male":"You two bicker so much...","female":"You two bicker so much...","variant_male_record_index":"62172","variant_fema