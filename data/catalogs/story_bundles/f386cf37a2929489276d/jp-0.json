t_count":1,"speaker_count":1}},"locales/jp/mn3/quest_story/10130090.json":{"asset_key":"mn3/quest_story_10130090","episode":"mn3","category":"quest_story","story_id":"10130090","schema_version":1,"lang":"jp","texts":{"say:2:1013009001:0":{"text":"魔像の頭部に、なにやら特殊な機構がはめ込まれている。こやつのエネルギー源か……？","source_cn":"魔偶的头部镶嵌着某个特殊结构。看起来像是它行动的能源……","status":"matched","hash_xxh64":"0x66C1F9F003322D0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1013009002:0":{"text":"つまり、エネルギー源が破壊されたから、魔像の動きが止まったんだな？","source_cn":"所以，魔偶停下来，是因为它的能源被破坏了？","status":"matched","hash_xxh64":"0x34309D20D2B2C444","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1013009002":{"text":"つまり、エネルギー源が破壊されたから、魔像の動きが止まったんだな？","source_cn":"所以，魔偶停下来，是因为它胸口的能源被破坏了？","status":"matched","hash_xxh64":"0x34309D20D2B2C444","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1013009003:1":{"text":"私も同意見だ。もしかしたら、これで魔像の凶行を止められるかもしれない。","source_cn":"我也赞同两位的意见，或许这将成为我们制止魔偶为祸的途径之一。","status":"matched","hash_xxh64":"0x825739E55D3698E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1013009005:1":{"text":"残念だが、今のところ俺たちが把握している情報はこれだけだな。","source_cn":"很可惜，就现在而言，我们只能获取到这些信息了。","status":"matched","hash_xxh64":"0x025DBEA3D05BF5A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"理論上はそうなるな。","source_cn":"理论上是这样","status":"matched_runtime_gender","hash_xxh64":"0x2A6C227C2A544376","variant_status":"runtime_gender_keys_target_differs","male":"理論上はそうなるな。","female":"理論上はそうなるわね。","variant_male_record_index":"61692","variant_female_record_index":"61693","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1013009004:0":{"text":"あれほどの力に、まったく痕跡を残さない武器……常人の域を超えているな……","source_cn":"这种程度的力量和毫无痕迹的武器，已经超越了凡人之力……","status":"matched","hash_xxh64":"0xDA46F446DF519126","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:1:2":{"text":"消えてしまった武器も気になるな。","source_cn":"消散的武器也很令人在意","status":"matched_runtime_gender","hash_xxh64":"0x357D634201F65EA2","variant_status":"runtime_gender_keys_target_differs","male":"消えてしまった武器も気になるな。","female":"消えてしまった武器も気になるわね。","variant_male_record_index":"61694","variant_female_record_index":"61695","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:特弥希娅":{"text":"テミシア","source":"特弥希娅","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"ヴァレン","source":"维伦","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":2}},"locales/jp/mn3/quest_story/10130100.json":{"asset_key":"mn3/quest_story_10130100","episode":"mn3","category":"quest_story","story_id":"10130100","schema_version":1,"lang":"jp","texts":{"say:1:1013010001:1":{"text":"失礼した。改めてあなた方の助太刀に感謝する。","source_cn":"失礼了，请允许我再次感谢诸位的鼎力协助。","status":"matched","hash_xxh64":"0x7DCE254BE07B008C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013010002:2":{"text":"できることをやったまでさ。むしろ<style=\"highlight\">聖堂騎士</style>の皆さま方こそが真の英雄だよ！","source_cn":"我们只是尽力而为，真正的英雄是你们——大驾光临的圣堂骑士们！","status":"matched","hash_xxh64":"0x79F5DEC7C9FB180C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1013010002":{"text":"できることをやったまでさ。むしろ<style=\"highlight\">聖堂騎士</style>の皆さま方こそが真の英雄だよ！","source_cn":"我们只是尽力而为，真正的英雄是你们——大驾光临的圣堂骑士们！","status":"matched","hash_xxh64":"0x79F5DEC7C9FB180C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1013010003:2":{"text":"俺も言ってみたくなったんだよ。","source_cn":"只是想说说看嘛。","status":"matched","hash_xxh64":"0x1FE6254063282267","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1013010005:1":{"text":"私は聖堂に所属する聖騎士だ。こたびは小隊を率いて偶然聖石町を通りかかってな……","source_cn":"艾雅在上，我是隶属圣堂的圣骑士，目前带领一个小队途径圣石镇。","status":"matched","hash_xxh64":"0xA644C8D4048F995E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1013010006:1":{"text":"私は副隊長のルシウスと申します。我々が聖石町に到着して間もないうちに魔像が現れたのです。","source_cn":"我是副队卢修斯，我们抵达圣石镇不久，恰好碰上魔偶来袭……","status":"matched","hash_xxh64":"0x0FF18FE2C6B6B6C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1013010007:1":{"text":"今や「魔像」と呼ばれているあのモンスターは……","source_cn":"请允许我告知各位，如今被称为“魔偶”的怪物——","status":"matched","hash_xxh64":"0x576470A5CBDC82F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1013010008:1":{"text":"女神様や聖堂と関係があるのだ。だから彼らの凶行を阻止するのも我々の責務なのだよ。","source_cn":"与女神和圣堂有关，阻止它们为祸人间，也是我们的责任所在。","status":"matched","hash_xxh64":"0x5C741990EB4FB282","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1013010009:1":{"text":"「善意の道は、深淵へと続く」か、おたくの女神様は慈愛の加減ってものを知らないのか？","source_cn":"“善意之路，通往深渊。”你们的女神，当初就不能少慈爱一点吗？","status":"matched","hash_xxh64":"0xE5AE17E7B36B549E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1013010010:2":{"text":"……あなたの信心が浅くとも、私にはなんの支障もない。","source_cn":"……你不够虔信，这并不是我的损失。","status":"matched","hash_xxh64":"0x931EAC984EA78ECB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"どこかで聞いた台詞だな……","source_cn":"真是耳熟……","status":"matched_runtime_gender","hash_xxh64":"0x23C599EE6228B7B4","variant_status":"runtime_gender_keys_target_differs","male":"どこかで聞いた台詞だな……","female":"どこかで聞いた台詞ね……","variant_male_record_index":"61696","variant_female_record_index":"61697","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1013010004:1":{"text":"鎧を着ていると辞儀もしづらくてな。我々の態度が何か誤解を招いたのなら、誠に申し訳ない。","source_cn":"重甲在身，不便行礼。如果我们的态度引起误会……我道歉。","status":"matched","hash_xxh64":"0x3E76170F484CEB35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"皮肉が効いてるな。","source_cn":"真是刺耳","status":"matched_runtime_gender","hash_xxh64":"0xB372182A5D1033BA","variant_status":"runtime_gender_keys_target_differs","male":"皮肉が効いてるな。","female":"皮肉が効いてるわね。","variant_male_record_index":"61698","variant_female_record_index":"61699","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:特弥希娅":{"text":"テミシア","source":"特弥希娅","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"ヴァレン","source":"维伦","status":"matched_dialogue_flow"},"speaker:卢修斯":{"text":"ルシウス","source":"卢修斯","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14,"localized_text_count":13,"speaker_count":3}},"locales/jp/mn3/quest_story/10130110.json":{"asset_key":"mn3/quest_story_10130110","episode":"mn3","category":"quest_story","story_id":"10130110","schema_version":1,"lang":"jp","texts":{"say:0:1013011001:0":{"text":"お？あの見覚えのある姿、もしや将軍か？","source_cn":"哟，那熟悉的身影，不会是将军吧？","status":"matched","hash_xxh64":"0xC3CFFC92066E946B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1013011002:0":{"text":"町まで行って報告する手間が省けたようだな。","source_cn":"看来，省了我去镇里找他汇报的功夫。","status":"matched","hash_xxh64":