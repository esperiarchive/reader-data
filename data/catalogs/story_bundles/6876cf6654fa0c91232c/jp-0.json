hed_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/jp/ep2/quest_story/12206060.json":{"asset_key":"ep2/quest_story_12206060","episode":"ep2","category":"quest_story","story_id":"12206060","schema_version":1,"lang":"jp","texts":{"say:1:1220606001:1":{"text":"あなたたち、村の人じゃないわね。","source_cn":"你们不是村里的人。","status":"matched","hash_xxh64":"0xDCE782902D2DD46F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1220606001":{"text":"あなたたち、村の人じゃないわね。","source_cn":"你们不是村里的人。","status":"matched","hash_xxh64":"0xDCE782902D2DD46F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1220606002:1":{"text":"でも……さっきは魔法を使ってたよね？船長ってよりもメイジみたい。","source_cn":"但是……你刚才用的是魔法吧？比起船长，你更像是个魔法师。","status":"matched_runtime_gender","hash_xxh64":"0x7991F9C7CA85229E","variant_status":"runtime_gender_keys_target_same","male":"でも……さっきは魔法を使ってたよね？船長ってよりもメイジみたい。","female":"でも……さっきは魔法を使ってたよね？船長ってよりもメイジみたい。","variant_male_record_index":"134450","variant_female_record_index":"134451","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1220606006:1":{"text":"村に戻りましょう。お母さんが心配していますよ。","source_cn":"快点回村子吧，你的妈妈很担心你。","status":"matched","hash_xxh64":"0xE153125C79EB8E4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1220606007:1":{"text":"はぁーい……結構お出かけできたし、このバッグを持って……って、わぁっ！","source_cn":"好吧……我出来得也够久了，等我拿上我的小包……天呐！","status":"matched","hash_xxh64":"0xAB232DD9512041E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220606008:1":{"text":"なにがあったんだ？","source_cn":"发生什么了？","status":"matched","hash_xxh64":"0x98148B02B964260D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1220606009:1":{"text":"ギャングの奴らめ……！よくも……私の星座表を破いてったわね！","source_cn":"这些该死的水鬼！他们……他们刚才扯坏了我包里的星座图！","status":"matched","hash_xxh64":"0x399F4D338A258E75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1220606010:1":{"text":"私が何日もかけて、星空を見ながら描いたものなのに……うぅ……","source_cn":"那是我花了好多个晚上，对着星空一笔一笔画出来的……呜呜……","status":"matched","hash_xxh64":"0x404EEAF029A5B0B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1220606010":{"text":"私が何日もかけて、星空を見ながら描いたものなのに……うぅ……","source_cn":"那是我花了好多个晚上，对着星空一笔一笔画出来的……呜呜……","status":"matched","hash_xxh64":"0x404EEAF029A5B0B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1220606011:1":{"text":"ほ、本当に？","source_cn":"真、真的吗？","status":"matched_runtime_gender","hash_xxh64":"0x4E3B11BA58A51215","variant_status":"runtime_gender_keys_target_same","male":"ほ、本当に？","female":"ほ、本当に？","variant_male_record_index":"134461","variant_female_record_index":"134462","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1220606012:1":{"text":"マスターにお任せください。マスターはすごいんですよ！","source_cn":"让主人试试看吧，主人可厉害呢！","status":"matched_runtime_gender","hash_xxh64":"0xD7CD0C0A4030EEAA","variant_status":"runtime_gender_keys_target_same","male":"マスターにお任せください。マスターはすごいんですよ！","female":"マスターにお任せください。マスターはすごいんですよ！","variant_male_record_index":"134463","variant_female_record_index":"134464","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1220606013:1":{"text":"じゃあ……お願いするわ。","source_cn":"那……交给你了。","status":"matched_runtime_gender","hash_xxh64":"0x41872E1C162BBAE8","variant_status":"runtime_gender_keys_target_same","male":"じゃあ……お願いするわ。","female":"じゃあ……お願いするわ。","variant_male_record_index":"134465","variant_female_record_index":"134466","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"直してあげられるかも。","source_cn":"或许我可以帮你修复","status":"matched_runtime_gender","hash_xxh64":"0x766EEEC053450746","variant_status":"runtime_gender_keys_target_same","male":"直してあげられるかも。","female":"直してあげられるかも。","variant_male_record_index":"66310","variant_female_record_index":"66311","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"僕は最も偉大な船長だ。","source_cn":"我是最传奇最伟大的船长","status":"matched_runtime_gender","hash_xxh64":"0x051E8E52423F4911","variant_status":"runtime_gender_keys_target_differs","male":"僕は最も偉大な船長だ。","female":"私は最も偉大な船長よ。","variant_male_record_index":"66306","variant_female_record_index":"66307","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1220606003:1":{"text":"あぁ、その言葉が一番聞きたくないのよね。お母さんはいつも心配しすぎなのよ。","source_cn":"噢，我最不希望听到的就是这句话，她总是过度操心。","status":"matched_runtime_gender","hash_xxh64":"0x7507055192DD8100","variant_status":"runtime_gender_keys_target_same","male":"あぁ、その言葉が一番聞きたくないのよね。お母さんはいつも心配しすぎなのよ。","female":"あぁ、その言葉が一番聞きたくないのよね。お母さんはいつも心配しすぎなのよ。","variant_male_record_index":"134452","variant_female_record_index":"134453","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1220606004:1":{"text":"でも、お母さんが心配するのも分かります。さっきだって、危なかったでしょう？","source_cn":"但是你妈妈的担心是对的，不然刚才你会有危险。","status":"matched","hash_xxh64":"0x85DA617A024A3A8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1220606005:1":{"text":"お母さんはいつも正しいわよ。ただ、単に私はそういうのが好きじゃないの。","source_cn":"她总是对的，只是我单纯不喜欢这样。","status":"matched","hash_xxh64":"0x4AD90907B05895C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:1:2":{"text":"君を連れ戻すよう、お母さんに頼まれたんだ。","source_cn":"你妈妈请我们找你回家","status":"matched_runtime_gender","hash_xxh64":"0xA87173880DAD7087","variant_status":"runtime_gender_keys_target_differs","male":"君を連れ戻すよう、お母さんに頼まれたんだ。","female":"あなたを連れ戻すよう、お母さんに頼まれたの。","variant_male_record_index":"66308","variant_female_record_index":"66309","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:弗洛拉":{"text":"フローラ","source":"弗洛拉","status":"matched_dialogue_flow"},"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":19,"localized_text_count":18,"speaker_count":3}},"locales/jp/ep2/quest_story/12206070.json":{"asset_key":"ep2/quest_story_12206070","episode":"ep2","category":"quest_story","story_id":"12206070","schema_version":1,"lang":"jp","texts":{"say:1:1220607001:1":{"text":"直った！本当に……直してくれたのね！こ……これ、魔法でしょ！？","source_cn":"修复了！你真的……做到了！这……这一定是魔法吧！","status":"matched_runtime_gender","hash_xxh64":"0xF644705C1F89B2C5","variant_status":"runtime_gender_keys_target_same","male":"直った！本当に……直してくれたのね！こ……これ、魔法でしょ！？","female":"直った！本当に……直してくれたのね！こ……これ、魔法でしょ！？","variant_male_record_index":"134467","variant_female_record_index":"134468","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1220607002:1":{"text":"あなたたちは……エスペリアで最も偉大なメイジね！","source_cn":"你们……你们简直就是伊索米亚最伟大、最传奇、最英气、最...","status":"matched","hash_xxh64":"0x4868CE7434DAE76B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1220607002":{"text":"あなたたちは……エスペリアで最も偉大なメイジね！","source_cn":"你们……你们简直就是伊索米亚最伟大、最传奇、最英气、最可爱的魔法师！","status":"matched","hash_xxh64":"0x4868CE7434DAE76B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220607003:1":{"text":"ううん……私にとってこの星座表はとても大切なの……","source_cn":"不……你不清楚这对我来说有多重要……","status":"matched_runtime_gender","hash_xxh64":"0xE64F838771A30F75","variant_status":"runtime_gender_keys_target_same","male":"ううん……私にとってこの星座表はとても大切なの……","female":"ううん……私にとってこの星座表はとても大切なの……","variant_male_record_index":"134470","variant_female_record_index":"134471","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1220607005:1":{"text":"私のお父さんは……ベテランの操舵手なの。毎年帰ってくるって約束してくれて、ほとんど破ったことがないのよ。","source_cn":"我的爸爸……是个经验丰富的舵手，他答应过我每年都会回来...","status":"matched","hash_xxh64":"0x41A512B1D6DDC12D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1220607006:1":{"text":"子どもの頃、帰り道が分からなくなったらどうするのか、お父さんに聞いたことがあるの。","source_cn":"在我很小的时候问过他，如果他找不到回家的路怎么办。","status":"matched","hash_xxh64":"0xE1F96CDC91B3B63E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220607007:1":{"text":"そうしたらね、「空に浮かぶ星座を見ていれば迷うことはない」って教えてくれたの。","source_cn":"他告诉我，只要看懂天上的星座，就永远不会迷路。","status":"matched","hash_xxh64":"0x924A0959F46179E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1220607008:1":{"text":"でもある日を境に、お父さんが操縦してた船は帰ってこなかった……","source_cn":"但后来有一天，他掌舵的那艘船再也没回来……","status":"matched","hash_xxh64":"0x0DEC01CEC90AB8E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1220607008":{"text":"でもある日を境に、お父さんが操縦してた船は帰ってこなかった……","source_cn":"但后来有一天，他掌舵的那艘船再也没回来……","status":"matched","hash_xxh64":"0x0DEC01CEC90AB8E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1220607009:1":{"text":"ううん、いいの。私はもう……大丈夫だから。","source_cn":"不不，没什么，我已经……不难过了。","status":"matched_runtime_gender","hash_xxh64":"0x0D3E30F7E92152AB","variant_status":"runtime_gender_keys_target_same","male":"ううん、いいの。私はもう……大丈夫だから。","female":"ううん、いいの。私はもう……大丈夫だから。","variant_male_record_index":"134478","variant_female_record_index":"134479","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1220607011:1":{"text":"それで、お父さんを思い出すためにこの星座表を描いてたのですか？","source_cn":"所以，你画这张星座图式为了纪念你爸爸？","status":"matched","hash_xxh64":"0xC97DF586A95463F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1220607012:1":{"text":"えぇ、そうよ。私の未来のためでもあるわ。","source_cn":"嗯，是的，但也是为了我的未来。","status":"matched","hash_xxh64":"0x0C4C6BEF1D4D12A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1220607013:1":{"text":"お父さんが遭難してから、お母さんは人が変わったみたいに私が操舵手になることに反対して、遠出を許さなくなったの。","source_cn":"父亲遇难后，妈妈就像变了个人一样，不再愿意我成为一名舵...","status":"matched","hash_xxh64":"0xA0ADFD79ADB1DD14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1220607014:1":{"text":"それはあなたまで失いたくないからです……","source_cn":"其实，你妈妈只是害怕失去你……","status":"matched","hash_xxh64":"0x277178AAFB31100B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1220607015:1":{"text":"分かってるけど、私ももう大人だもん。子どもみたいにお母さんのそばで一生を過ごす気はないわ。","source_cn":"我明白，可我已经长大了，不能像个小孩子，缩在妈妈身边度...","status":"matched","hash_xxh64":"0x0004EF630FD45942","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1220607016:1":{"text":"私はね、操舵手が船を操るように、自分の未来を自分で決めたいの！","source_cn":"我想要掌控自己的未来，就像舵手掌控船的方向！","status":"matched","hash_xxh64":"0x3B3B43D70BBDF31A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1220607017:1":{"text":"行き先を決めたらすぐに出航して、収穫を船いっぱいに積んで帰るの……空に浮かぶ星座を見ていれば迷うことはないもの！","source_cn":"决定了去哪里后就出航，有了收获就满载而归——只要看懂天...","status":"matched","hash_xxh64":"0xDE7DB9E149636209","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1220607018:1":{"text":"自分の未来を決める操舵手……君ならきっとなれますよ！","source_cn":"决定自己未来的舵手——你一定能做到的！","status":"matched","hash_xxh64":"0x40BEDF128CE2ECD9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1220607019:1":{"text":"うん！ありがとう、私帰るね。","source_cn":"我会的！谢谢你们，我该回去了。","status":"matched","hash_xxh64":"0x75A45D2537FC3EBB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1220607020:1":{"text":"あの……また会えるかな？","source_cn":"那个……我们以后还会再见面吗？","status":"matched","hash_xxh64":"0x8E49029FDF1E9553","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:23:1220607020":{"text":"あの……また会えるかな？","source_cn":"那个……我们以后还会再见面吗？","status":"matched","hash_xxh64":"0x8E49029FDF1E9553","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1220607021:1":{"text":"よかった！私は航海術の勉強を続けるから、いつか私の船に乗れるかもよ！","source_cn":"那太好了！我会继续学习导航，也许未来有一天，你会乘上我...","status":"matched_runtime_gender","hash_xxh64":"0x2D289ACEE5512393","variant_status":"runtime_gender_keys_target_same","male":"よかった！私は航海術の勉強を続けるから、いつか私の船に乗れるかもよ！","female":"よかった！私は航海術の勉強を続けるから、いつか私の船に乗れるかもよ！","variant_male_record_index":"134492","variant_female_record_index":"134493","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1220607023:1":{"text":"じゃあ、またね！","source_cn":"那么，再见啦！","status":"matched","hash_xxh64":"0x0DA7DD766E689877","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:23:0:1":{"text":"あぁ。","source_cn":"会的","status":"matched_runtime_gender","hash_xxh64":"0xD32F44C01C28911A","variant_status":"runtime_gender_keys_target_differs","male":"あぁ。","female":"えぇ。","variant_male_record_index":"66320","variant_female_record_index":"66321","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1220607022:1":{"text":"神様にお祈りするね！","source_cn":"我会向神祈祷的！","status":"matched_runtime_gender","hash_xxh64":"0x17F8D048AED15FB3","variant_status":