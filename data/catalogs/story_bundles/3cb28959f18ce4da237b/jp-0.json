、フーキンの歓迎会でもしようじゃないか！","source_cn":"好在魔钢的事有些眉目了，我做主，今天给大伙放个假，一起...","status":"matched","hash_xxh64":"0xF9C338A00324274B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:祖娅":{"text":"ゾーヤ","source":"祖娅","status":"matched_dialogue_flow"},"speaker:铁须":{"text":"ハガルド","source":"铁须","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":2}},"locales/jp/timeline/timeline_story/1401050522.json":{"asset_key":"timeline/timeline_story_1401050522","episode":"timeline","category":"timeline_story","story_id":"1401050522","schema_version":1,"lang":"jp","texts":{},"speakers":{},"stats":{"flow_row_count":2,"localized_text_count":0,"speaker_count":0}}}}