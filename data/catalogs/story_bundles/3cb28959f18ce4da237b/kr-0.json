ocument_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1423164015:1":{"text":"그럼 제련소에서 막 뽑아낸 블루모아 강철의 합격률로 확인해 보자!","source_cn":"那就看看冶炼所新出的这批蓝魔钢锭合格率怎么样吧。","status":"matched","hash_xxh64":"0x7023C7E783D923A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"굼뜨다고?","source_cn":"太慢了？","status":"matched_runtime_gender","hash_xxh64":"0xA8AC1490A2F84F5A","variant_status":"runtime_gender_keys_target_same","male":"굼뜨다고?","female":"굼뜨다고?","variant_male_record_index":"73702","variant_female_record_index":"73703","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"한발 늦었어?","source_cn":"晚了一步？","status":"matched_runtime_gender","hash_xxh64":"0x5E2B7E06FDEC5D6B","variant_status":"runtime_gender_keys_target_same","male":"한발 늦었어?","female":"한발 늦었어?","variant_male_record_index":"73704","variant_female_record_index":"73705","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:呼金":{"text":"후긴","source":"呼金","status":"matched_dialogue_flow"},"speaker:祖娅":{"text":"조아","source":"祖娅","status":"matched_dialogue_flow"},"speaker:铁须":{"text":"아이언비어드","source":"铁须","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":20,"localized_text_count":19,"speaker_count":3}},"locales/kr/ep4/quest_story/14231650.json":{"asset_key":"ep4/quest_story_14231650","episode":"ep4","category":"quest_story","story_id":"14231650","schema_version":1,"lang":"kr","texts":{"say:2:1423165001:0":{"text":"불량품이 약간 있긴 한데, 조악품은 훨씬 줄었군요!","source_cn":"虽然还是有一些不合格的蓝魔钢锭，但次品率大大降低了！","status":"matched","hash_xxh64":"0x95E34FA0501D326E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423165002:1":{"text":"조금만 더 조정하면 조악품이 나오는 걸 훨씬 줄일 수 있을 겁니다.","source_cn":"要是再调整调整参数，次品率还能降到更低！","status":"matched","hash_xxh64":"0x325E9F00F77641E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423165003:1":{"text":"조아 스승님! 정말 대단하십니다!","source_cn":"祖娅老师，你太厉害了!","status":"matched","hash_xxh64":"0xB4B3FE03D54A515F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423165004:1":{"text":"제자 녀석아, 너도 잘 했어!","source_cn":"我的徒弟也不赖嘛！","status":"matched","hash_xxh64":"0xC9A0FAB7130C2DCC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423165005:1":{"text":"그런데 아이언비어드가 말이 없구만? 무슨 생각을 하고 있는 지 물어나 볼까.","source_cn":"铁须这家伙一直没说话，也没表态，我们去问问他是怎么想的。","status":"matched","hash_xxh64":"0x393F2816A3606D1F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:呼金":{"text":"후긴","source":"呼金","status":"matched_dialogue_flow"},"speaker:祖娅":{"text":"조아","source":"祖娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}},"locales/kr/ep4/quest_story/14231660.json":{"asset_key":"ep4/quest_story_14231660","episode":"ep4","category":"quest_story","story_id":"14231660","schema_version":1,"lang":"kr","texts":{"say:2:1423166001:0":{"text":"어때, 아이언비어드? 이제 마을에 남을 생각이 좀 들었어?","source_cn":"怎么样，铁须，现在你有信心继续待在村子了吗？","status":"matched","hash_xxh64":"0x7937DBA3E71DC11E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423166002:1":{"text":"이렇게까지 해내다니... 정말 대단해. 그동안 내가 너무 꽉 막히게 굴었지.","source_cn":"既然你都做到这个份上了……我实在佩服。是我固执己见了。","status":"matched","hash_xxh64":"0x38DFF41658FF89C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423166003:1":{"text":"마을이 난장판이 된 뒤로 너희가 무언가 하려고 노력하고 있을 때 난 계속 핑계만 대고 도망치기 바빴어. 마을 사람들도 다 봤을 거야.","source_cn":"这些日子里，面对村里的烂摊子，一直找借口推诿逃避的是我...","status":"matched","hash_xxh64":"0x5213880C3EC345CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423166004:1":{"text":"이런 결과물을 봤으니 내가 말하지 않아도 다들 자진해서 남겠지. 마을을 재건하는 데 힘을 보탤거라고 믿어.","source_cn":"看到这样的成果，不用我多说，村里的大伙也会主动留下，踏...","status":"matched","hash_xxh64":"0x9755E4FB0028F4D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423166005:1":{"text":"지난 일은 미안했다! 앞으로 조아가 하는 말은 얌전히 들을 테니까!","source_cn":"之前那些事，对不住啦！以后祖娅你让我出力，我绝对说一不二！","status":"matched","hash_xxh64":"0x529BED5AE58DDDC8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423166006:1":{"text":"아이언비어드가 갑자기 이렇게 고분고분하게 나오다니, 조금 이상한데?","source_cn":"铁须突然变得这么客气还真不有点不习惯！","status":"matched","hash_xxh64":"0x5A19B4FE6AD28944","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423166007:1":{"text":"좋아. 모아 강철 연구 때문에 다들 고생 많았지. 그래서 후긴이 돌아온 것도 축하하지 못했잖아!","source_cn":"好啦！为了魔钢的事，大家也忙了好多天了，连呼金回村都没...","status":"matched","hash_xxh64":"0xEE3B281919412D5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1423166008:1":{"text":"모아 강철도 슬슬 성과가 보이니까, 내가 책임질 테니 오늘은 다들 쉬면서 떠들썩하게 후긴의 환영 연회나 즐겨보자고!","source_cn":"好在魔钢的事有些眉目了，我做主，今天给大伙放个假，一起...","status":"matched","hash_xxh64":"0xF9C338A00324274B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:祖娅":{"text":"조아","source":"祖娅","status":"matched_dialogue_flow"},"speaker:铁须":{"text":"아이언비어드","source":"铁须","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":2}},"locales/kr/timeline/timeline_story/1401050522.json":{"asset_key":"timeline/timeline_story_1401050522","episode":"timeline","category":"timeline_story","story_id":"1401050522","schema_version":1,"lang":"kr","texts":{},"speakers":{},"stats":{"flow_row_count":2,"localized_text_count":0,"speaker_count":0}}}}