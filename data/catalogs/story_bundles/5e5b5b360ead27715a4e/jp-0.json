ory/13222120.json":{"asset_key":"ep3/quest_story_13222120","episode":"ep3","category":"quest_story","story_id":"13222120","schema_version":1,"lang":"jp","texts":{"say:0:1322212001:0":{"text":"ふぅ……やっと逃げられた……","source_cn":"呼，终于逃出来了……","status":"matched","hash_xxh64":"0x6BAE828F706FB975","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322212002:0":{"text":"急にモンスターが現れるなんて……怖かったぁ……","source_cn":"怪物出现得好突然！太可怕了……","status":"matched","hash_xxh64":"0x19F33D2AB013B423","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/jp/ep3/quest_story/13222130.json":{"asset_key":"ep3/quest_story_13222130","episode":"ep3","category":"quest_story","story_id":"13222130","schema_version":1,"lang":"jp","texts":{"say:1:1322213001:1":{"text":"もう建材を集めて来てくれたのですか！？","source_cn":"你们把建材都收集好了？这么快！","status":"matched","hash_xxh64":"0xF611B9A2025BC4CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322213002:1":{"text":"ありがとうございます！ああ、建材がバラバラになって……道中はきっと大変でしたよね。","source_cn":"谢谢你们，路上一定很不容易吧？瞧，建材都散乱了。","status":"matched","hash_xxh64":"0xE4A25BB0FA3E96A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322213003:1":{"text":"きっとモンスターから逃げる時に崩れてしまったんですね。整理してから渡しましょう。","source_cn":"应该是在躲避野兽的时候弄乱的，我们把建材整理好再交给修士吧。","status":"matched","hash_xxh64":"0x31405B3967BA7AF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322213004:1":{"text":"ありがとうございます。終わったら、向こうの職人さんに渡してください。","source_cn":"诸位整理好交给旁边的工匠即可，毕竟我也不会修复呀。","status":"matched","hash_xxh64":"0x51B446E61DB8FAAE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修士达尼尔":{"text":"修道士のダニル","source":"修士达尼尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}},"locales/jp/ep3/quest_story/13222140.json":{"asset_key":"ep3/quest_story_13222140","episode":"ep3","category":"quest_story","story_id":"13222140","schema_version":1,"lang":"jp","texts":{"say:0:1322214001:0":{"text":"建材の整理整頓も終わったし、ドワーフの職人さんに渡してきましょう！","source_cn":"这下建材都整整齐齐的了！快去交给矮人工匠吧！","status":"matched","hash_xxh64":"0x85F12A7D1ED3CCB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/jp/ep3/quest_story/13222150.json":{"asset_key":"ep3/quest_story_13222150","episode":"ep3","category":"quest_story","story_id":"13222150","schema_version":1,"la