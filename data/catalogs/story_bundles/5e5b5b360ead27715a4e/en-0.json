{"schema_version":1,"resources":{"faction_dailies/locales/en/13010512/1.json":{"schema_version":1,"asset_key":"optional/objective_13010512:1:1","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010512/2.json":{"schema_version":1,"asset_key":"optional/objective_13010512:1:2","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010512/3.json":{"schema_version":1,"asset_key":"optional/objective_13010512:1:3","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010512/4.json":{"schema_version":1,"asset_key":"optional/objective_13010512:1:4","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010512/5.json":{"schema_version":1,"asset_key":"optional/objective_13010512:1:5","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010512/6.json":{"schema_version":1,"asset_key":"optional/objective_13010512:1:6","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010512/7.json":{"schema_version":1,"asset_key":"optional/objective_13010512:1:7","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010512/8.json":{"schema_version":1,"asset_key":"optional/objective_13010512:1:8","lang":"en","texts":{},"speakers":{}},"faction_dailies/menus/13010512_1_3.en.json":{"schema_version":1,"asset_key":"faction_dailies/menu_13010512:1:3","lang":"en","texts":{"menu:6056230:1":{"text":"Ugh, this is too heavy...","source_cn":"唉，这怎么搬得过来……","status":"exact_duplicate_same"}},"speakers":{"speaker:修士达尼尔":{"text":"Acolyte Darnell","source":"修士达尼尔","status":"exact_hash"}}},"faction_dailies/menus/13010512_1_6.en.json":{"schema_version":1,"asset_key":"faction_dailies/menu_13010512:1:6","lang":"en","texts":{"menu:6056230:1":{"text":"Ugh, this is too heavy...","source_cn":"唉，这怎么搬得过来……","status":"exact_duplicate_same"}},"speakers":{"speaker:修士达尼尔":{"text":"Acolyte Darnell","source":"修士达尼尔","status":"exact_hash"}}},"faction_dailies/menus/13010512_1_8.en.json":{"schema_version":1,"asset_key":"faction_dailies/menu_13010512:1:8","lang":"en","texts":{"menu:6056240:1":{"text":"I deserve a drink after this job.","source_cn":"这趟活干完后一定要去喝一杯。","status":"exact_duplicate_same"}},"speakers":{"speaker:矮人格瑞":{"text":"Gery","source":"矮人格瑞","status":"exact_hash"}}},"locales/en/ep3/quest_story/13222070.json":{"asset_key":"ep3/quest_story_13222070","episode":"ep3","category":"quest_story","story_id":"13222070","schema_version":1,"lang":"en","texts":{"say:1:1322207001:1":{"text":"Magister <style=\"stress\"><player_name></style>, you came just in time.","source_cn":"<style=stress><player_name>...","status":"matched","hash_xxh64":"0x8C4A737C975DB772","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322207002:1":{"text":"I saw an acolyte hurrying toward St. Kinga's Temple. I'm afraid something has happened.","source_cn":"我刚才看到一个修士急匆匆地往<style=highli...","status":"matched","hash_xxh64":"0x65DB5D106A9C577A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322207003:1":{"text":"Can you please check what is happening over there?","source_cn":"你能帮我去看看是什么情况吗？","status":"matched","hash_xxh64":"0xDFD4805CE6CE864D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卡列琳娜":{"text":"Carolina","source":"卡列琳娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}},"locales/en/ep3/quest_story/13222080.json":{"asset_key":"ep3/quest_story_13222080","episode":"ep3","category":"quest_story","story_id":"13222080","schema_version":1,"lang":"en","texts":{"say:0:1322208001:0":{"text":"There are a few acolytes here now.","source_cn":"果然有修士在这里！","status":"matched","hash_xxh64":"0x9C08B986AD9F05AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322208002:0":{"text":"I see dwarven craftsmen also. Let's go see what they're up to.","source_cn":"矮人也在？快去问问他们发生了什么事吧！","status":"matched","hash_xxh64":"0x2642787F0789B090","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep3/quest_story/13222090.json":{"asset_key":"ep3/quest_story_13222090","episode":"ep3","category":"quest_story","story_id":"13222090","schema_version":1,"lang":"en","texts":{"say:1:1322209001:1":{"text":"St. Kinga's Temple has been falling apart for years, and the recent heavy snowfall has pushed it to the edge. The beams could give way at any moment—thankfully, we've found craftsmen to start repairs right away.","source_cn":"圣金嘉教堂年久失修，前些日子下了场大雪，现在房梁岌岌可...","status":"matched","hash_xxh64":"0xB24AF5EA601DFE79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322209002:1":{"text":"But we're desperately short on hands to find and move the building materials we need.","source_cn":"可是教堂的人手太少了，根本搬运不来那么多建材。","status":"matched","hash_xxh64":"0xCAF5BAF34EB8EA07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1322209002":{"text":"But we're desperately short on hands to find and move the building materials we need.","source_cn":"可是教堂的人手太少了，根本搬运不来那么多建材。","status":"matched","hash_xxh64":"0xCAF5BAF34EB8EA07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322209003:1":{"text":"Really? That's wonderful! Your help would mean the world to us.","source_cn":"真的吗？太好了！还请你们帮忙收集一些建材回来。","status":"matched","hash_xxh64":"0xBCCD71050E3CADED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"We can help.","source_cn":"我们可以帮你","status":"matched_runtime_gender","hash_xxh64":"0x8116235F40D84F11","variant_status":"runtime_gender_keys_target_same","male":"We can help.","female":"We can help.","variant_male_record_index":"70006","variant_female_record_index":"70007","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修士达尼尔":{"text":"Acolyte Darnell","source":"修士达尼尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":1}},"locales/en/ep3/quest_story/13222110.json":{"asset_key":"ep3/quest_story_13222110","episode":"ep3","category":"quest_story","story_id":"13222110","schema_version":1,"lang":"en","texts":{"say:0:1322211001:0":{"text":"Use the rock there!","source_cn":"那里有石头！快让它撞上石头！","status":"matched","hash_xxh64":"0x0B29E148A69F9E79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep3/quest_story/13222120.json":{"asset_key":"ep3/quest_story_13222120","episode":"ep3","category":"quest_story","story_id":"13222120","schema_version":1,"lang":"en","texts":{"say:0:1322212001:0":{"text":"*Sigh*... We made it...","source_cn":"呼，终于逃出来了……","status":"matched","hash_xxh64":"0x6BAE828F706FB975","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322212002:0":{"text":"That thing came out of nowhere! It was so scary...","source_cn":"怪物出现得好突然！太可怕了……","status":"matched","hash_xxh64":"0x19F33D2AB013B423","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep3/quest_story/13222130.json":{"asset_key":"ep3/quest_story_13222130","episode":"ep3","category":"quest_story","story_id":"13222130","schema_version":1,"lang":"en","texts":{"say:1:1322213001:1":{"text":"You've already collected all the building materials? That was fast!","source_cn":"你们把建材都收集好了？这么快！","status":"matched","hash_xxh64":"0xF611B9A2025BC4CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322213002:1":{"text":"Thank you. Ah, it must've been difficult on the road. Everything looks a mess.","source_cn":"谢谢你们，路上一定很不容易吧？瞧，建材都散乱了。","status":"matched","hash_xxh64":"0xE4A25BB0FA3E96A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322213003:1":{"text":"While we were dodging the wild beasts, the building materials must've gotten scattered. Let's tidy them up before we hand them over to the acolyte.","source_cn":"应该是在躲避野兽的时候弄乱的，我们把建材整理好再交给修士吧。","status":"matched","hash_xxh64":"0x31405B3967BA7AF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322213004:1":{"text":"If you can, please re-arrange the materials in an orderly fashion and pass them on to the craftsmen over there. After all, I'm just an acolyte who can't even hammer a nail straight. Ha! ","source_cn":"诸位整理好交给旁边的工匠即可，毕竟我也不会修复呀。","status":"matched","hash_xxh64":"0x51B446E61DB8FAAE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修士达尼尔":{"text":"Acolyte Darnell","source":"修士达尼尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}},"locales/en/ep3/quest_story/13222140.json":{"asset_key":"ep3/quest_story_13222140","episode":"ep3","category":"quest_story","story_id":"13222140","schema_version":1,"lang":"en","texts":{"say:0:1322214001:0":{"text":"Now that everything's been neatly arranged, let's hurry up and hand them over to the craftsmen.","source_cn":"这下建材都整整齐齐的了！快去交给矮人工匠吧！","status":"matched","hash_xxh64":"0x85F12A7D1ED3CCB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep3/quest_story/13222150.json":{"asset_key":"ep3/quest_story_13222150","episode":"ep3","category":"quest_story","story_id":"13222150","schema_version":1,"lang":"en","texts":{"say:1:1322215001:1":{"text":"About time you brought the materials! Aye, these'll do. We can finally get to work!","source_cn":"哦嚯，你们把建材带来了呀！终于有新材料了，开工！","status":"matched","hash_xxh64":"0x927C584CDB5AF7F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322215002:1":{"text":"I want to thank you lot for giving us a chance to get this place back in order.","source_cn":"这样修复的工作就能顺利完成了，多亏了你们呀！","status":"matched","hash_xxh64":"0x4066065201E95ADC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:矮人格瑞":{"text":"Gery","source":"矮人格瑞","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/timeline/quest_story/13222100.json":{"asset_key":"timeline/quest_story_13222100","episode":"timeline","category":"quest_story","story_id":"13222100","schema_version":1,"lang":"en","texts":{"say:1:1322210001:1":{"text":"Chippy thinks we have everything we need. Let's report back.","source_cn":"终于收集完啦，可以回去交差了！","status":"matched","hash_xxh64":"0xFA4BE4C4B216B32A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322210002:1":{"text":"Watch out, Chippy! ","source_cn":"满满小心！有野兽！","status":"matched","hash_xxh64":"0xAD643B4C033B0768","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:8:13051214:0":{"text":"Suddenly, a bear charges at you from nowhere.","source_cn":"一只熊突然出现，朝你们的方向冲撞而来。","status":"matched","hash_xxh64":"0x6B5116CAA20550C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":3,"speaker_count":3}}}}