ant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423432002:1":{"text":"ありがとう。あなたたちがいてくれると、本当に心強いわ……","source_cn":"谢谢你们，有你们在，我安心多了……","status":"matched","hash_xxh64":"0x5D061093FBCA640A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423432003:1":{"text":"セレ様！また獣が襲ってきました！","source_cn":"席蕾大人！又有野兽来袭击了！","status":"matched","hash_xxh64":"0xA231BB4BD4B38F4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423432004:1":{"text":"またなの！？今行くわ！","source_cn":"又来了！我现在就过去！","status":"matched","hash_xxh64":"0xDB1760744AC9F34D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423432005:1":{"text":"ロンロンたちも手伝いましょう！","source_cn":"我们也去帮忙！","status":"matched","hash_xxh64":"0xEED68FE2358ACF00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"},"speaker:席蕾":{"text":"セレ","source":"席蕾","status":"matched_dialogue_flow"},"speaker:惊慌的平民":{"text":"慌てる平民","source":"惊慌的平民","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":3}},"locales/jp/ep4/quest_story/14234330.json":{"asset_key":"ep4/quest_story_14234330","episode":"ep4","category":"quest_story","story_id":"14234330","schema_version":1,"lang":"jp","texts":{"say:1:1423433001:1":{"text":"ありがとう！また助けてもらっちゃったわね……私に修繕工事の管理なんて荷が重すぎるわ……","source_cn":"谢谢你们！又麻烦了你们一次……说实在的我不太擅长主持修缮……","status":"matched","hash_xxh64":"0x8D73450224C5ACFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423433002:1":{"text":"王都にいたドワーフたちが、こんなに恋しいと思ったのは初めてよ！","source_cn":"我从来没像现在一样想念过王城的矮人！","status":"matched","hash_xxh64":"0xA0C01A79C7733174","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423433003:1":{"text":"以前みたいに、ドワーフたちと協力して修繕工事ができたら……はぁ、無理なことを考えてもしょうがないわね。","source_cn":"如果萨洛克兰能继续与矮人合作修缮……唉，我也只是想想！","status":"matched","hash_xxh64":"0xB83DF622B567681B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423433004:1":{"text":"あなたたちも他にやることがあるんじゃない？こっちはもう大丈夫よ。ありがとう！","source_cn":"你们应该还有别的事要忙吧，就不打扰你们了！","status":"matched","hash_xxh64":"0x9590D650D06A6FF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:席蕾":{"text":"セレ","source":"席蕾","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}},"locales/jp/ep4/quest_story/14234340.json":{"asset_key":"ep4/quest_story_14234340","episode":"ep4","category":"quest_story","story_id":"14234