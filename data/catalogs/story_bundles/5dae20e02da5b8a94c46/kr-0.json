t_title_cn":"","document_title_status":""},"say:6:1423428005:1":{"text":"혹시 <style=\"highlight\">목재</style>랑 <style=\"highlight\">석재</style> 좀 구해다 줄 수 있어?","source_cn":"可以请你们去帮我找些<style=highlight>...","status":"matched","hash_xxh64":"0xA5E62C169D6F7566","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423428006:1":{"text":"목재는 평민 지역에 있어. 석재는 드워프들이 일하던 승강기 근처에서 찾을 수 있을 거야!","source_cn":"木料平民区就有，石材可能得到矮人们工作过的升降机附近找找了！","status":"matched","hash_xxh64":"0x06F94764CA5DBFEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:席蕾":{"text":"시레이","source":"席蕾","status":"matched_dialogue_flow"},"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":2}},"locales/kr/ep4/quest_story/14234290.json":{"asset_key":"ep4/quest_story_14234290","episode":"ep4","category":"quest_story","story_id":"14234290","schema_version":1,"lang":"kr","texts":{"say:0:1423429001:0":{"text":"이 목재는... 관리하는 사람이 없는 것 같아요.","source_cn":"这些木料……看上去没有人在管理。","status":"matched","hash_xxh64":"0x1AF353F22BFFF1BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/kr/ep4/quest_story/14234300.json":{"asset_key":"ep4/quest_story_14234300","episode":"ep4","category":"quest_story","story_id":"14234300","schema_version":1,"lang":"kr","texts":{"say:0:1423430001:0":{"text":"이 석재들은 오랫동안 쌓여 있던 거 같아요.","source_cn":"这些石料已经在这堆放很久了。","status":"matched","hash_xxh64":"0x624445172EA9FA8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1423430002:0":{"text":"시레이가 정말 일손이 부족한 것 같아요...","source_cn":"看来席蕾确实缺人手……","status":"matched","hash_xxh64":"0x2644B4AD5674B568","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/kr/ep4/quest_story/14234310.json":{"asset_key":"ep4/quest_story_14234310","episode":"ep4","category":"quest_story","story_id":"14234310","schema_version":1,"lang":"kr","texts":{"say:0:1423431001:0":{"text":"재료를 시레이에게 전해줘요!","source_cn":"把材料交给席蕾吧！","status":"matched","hash_xxh64":"0x1F92732ED7EF9AB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/kr/ep4/quest_story/14234320.json":{"asset_key":"ep4/quest_story_14234320","episode":"ep4","category":"quest_story","story_id":"14234320","schema_version":1,"lang":"kr","texts":{"say:1:1423432001:1":{"text":"시레이, 부족한 목재랑 석재 가져왔어요!","source_cn":"席蕾，我们把你缺的木料和石材带回来啦。","status":"matched","hash_xxh64":"0x43FFCAD7F39BB288","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423432002:1":{"text":"고마워, 너희가 있어서 정말 든든해...","source_cn":"谢谢你们，有你们在，我安心多了……","status":"matched","hash_xxh64":"0x5D061093FBCA640A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423432003:1":{"text":"시레이 님! 야수가 쳐들어왔어요!","source_cn":"席蕾大人！又有野兽来袭击了！","status":"matched","hash_xxh64":"0xA231BB4BD4B38F4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423432004:1":{"text":"또요? 지금 당장 갈게요!","source_cn":"又来了！我现在就过去！","status":"matched","hash_xxh64":"0xDB1760744AC9F34D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423432005:1":{"text":"저희도 도우러 가요!","source_cn":"我们也去帮忙！","status":"matched","hash_xxh64":"0xEED68FE2358ACF00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"},"speaker:席蕾":{"text":"시레이","source":"席蕾","status":"matched_dialogue_flow"},"speaker:惊慌的平民":{"text":"당황한 평민","source":"惊慌的平民","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":3}},"locales/kr/ep4/quest_story/14234330.json":{"asset_key":"ep4/quest_story_14234330","episode":"ep4","category":"quest_story","story_id":"14234330","schema_version":1,"lang":"kr","texts":{"say:1:1423433001:1":{"text":"고마워! 또 너희에게 신세를 졌네... 사실 이런 복구 작업을 이끌어본 적이 없어서...","source_cn":"谢谢你们！又麻烦了你们一次……说实在的我不太擅长主持修缮……","status":"matched","hash_xxh64":"0x8D73450224C5ACFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423433002:1":{"text":"왕성의 드워프들이 이렇게까지 그리웠던 적이 없었어!","source_cn":"我从来没像现在一样想念过王城的矮人！","status":"matched","hash_xxh64":"0xA0C01A79C7733174","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423433003:1":{"text":"셀로클랜드가 계속 드워프와 협력할 수 있으면 좋을 텐데... 아, 그냥 해본 생각이야!","source_cn":"如果萨洛克兰能继续与矮人合作修缮……唉，我也只是想想！","status":"matched","hash_xxh64":"0xB83DF622B567681B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423433004:1":{"text":"너희도 할 일이 있을 테니까 안 붙잡을게!","source_cn":"你们应该还有别的事要忙吧，就不打扰你们了！","status":"matched","hash_xxh64":"0x9590D650D06A6FF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:席蕾":{"text":"시레이","source":"席蕾","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}},"locales/kr/ep4/quest_story/14234340.json":{"asset_key":"ep4/quest_story_14234340","episode":"ep4","category":"quest_story","story_id":"14234340","schema_version"