{"schema_version":1,"resources":{"faction_dailies/locales/en/14010534/1.json":{"schema_version":1,"asset_key":"optional/objective_14010534:1:1","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010534/2.json":{"schema_version":1,"asset_key":"optional/objective_14010534:1:2","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010534/3.json":{"schema_version":1,"asset_key":"optional/objective_14010534:1:3","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010534/4.json":{"schema_version":1,"asset_key":"optional/objective_14010534:1:4","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010534/5.json":{"schema_version":1,"asset_key":"optional/objective_14010534:1:5","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010534/6.json":{"schema_version":1,"asset_key":"optional/objective_14010534:1:6","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010534/7.json":{"schema_version":1,"asset_key":"optional/objective_14010534:1:7","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010534/8.json":{"schema_version":1,"asset_key":"optional/objective_14010534:1:8","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/14010534/9.json":{"schema_version":1,"asset_key":"optional/objective_14010534:1:9","lang":"en","texts":{},"speakers":{}},"faction_dailies/menus/14010534_1_3.en.json":{"schema_version":1,"asset_key":"faction_dailies/menu_14010534:1:3","lang":"en","texts":{"menu:8019620:1":{"text":"I'm really not cut out for this kind of job...","source_cn":"我根本不擅长干这些啊……","status":"exact_duplicate_same"}},"speakers":{"speaker:席蕾":{"text":"Xera","source":"席蕾","status":"exact_hash"}}},"locales/en/ep4/quest_story/14234250.json":{"asset_key":"ep4/quest_story_14234250","episode":"ep4","category":"quest_story","story_id":"14234250","schema_version":1,"lang":"en","texts":{"say:1:1423425001:1":{"text":"<style=\"stress\"><player_name></style>, you've seen what it's like in the commoners' district, right?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x79D64455396A4F71","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, you've seen what it's like in the commoners' district, right?","female":"<style=\"stress\"><player_name></style>, you've seen what it's like in the commoners' district, right?","variant_male_record_index":"171873","variant_female_record_index":"171874","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1423425001":{"text":"<style=\"stress\"><player_name></style>, you've seen what it's like in the commoners' district, right?","source_cn":"<style=stress><player_name></style>，你应该见过平民区的居住环境吧？","status":"matched_runtime_gender","hash_xxh64":"0x79D64455396A4F71","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, you've seen what it's like in the commoners' district, right?","female":"<style=\"stress\"><player_name></style>, you've seen what it's like in the commoners' district, right?","variant_male_record_index":"171873","variant_female_record_index":"171874","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423425002:1":{"text":"If we want people to feel equal, we've got to start by improving how they live.","source_cn":"要让平民们感受到平等，首要的就是改善他们的生活环境。","status":"matched","hash_xxh64":"0xE586F0FB75645FEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423425003:1":{"text":"With a bit of persuasion, some former nobles agreed to donate supplies for the repairs...","source_cn":"在我的善意提醒下，一些曾经的贵族愿意提供多余的财物，以...","status":"matched","hash_xxh64":"0xABBCE586A9BB0CFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423425004:1":{"text":"Xera is handling the renovations, but it sounds like she's having a hard time. Can you check in and see how it's going?","source_cn":"席蕾如今正忙于平民区的修缮，似乎有些焦头烂额……请你替...","status":"matched","hash_xxh64":"0x98CB96556CC69AB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"Saw those run-down camps.","source_cn":"见过那些破旧的营地","status":"matched_runtime_gender","hash_xxh64":"0x9DE1B0FF04DDBB4E","variant_status":"runtime_gender_keys_target_same","male":"Saw those run-down camps.","female":"Saw those run-down camps.","variant_male_record_index":"74420","variant_female_record_index":"74421","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:1:2":{"text":"It's barely livable.","source_cn":"平民区的居住环境很艰苦","status":"matched_runtime_gender","hash_xxh64":"0x6BE3670727D73F97","variant_status":"runtime_gender_keys_target_same","male":"It's barely livable.","female":"It's barely livable.","variant_male_record_index":"74422","variant_female_record_index":"74423","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:沙利叶":{"text":"Ravion","source":"沙利叶","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":1}},"locales/en/ep4/quest_story/14234260.json":{"asset_key":"ep4/quest_story_14234260","episode":"ep4","category":"quest_story","story_id":"14234260","schema_version":1,"lang":"en","texts":{"say:0:1423426001:0":{"text":"There she is. She looks completely swamped...","source_cn":"席蕾在那里！看上去很忙的样子呢……","status":"matched","hash_xxh64":"0x36174D700E192215","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14234280.json":{"asset_key":"ep4/quest_story_14234280","episode":"ep4","category":"quest_story","story_id":"14234280","schema_version":1,"lang":"en","texts":{"say:2:1423428001:1":{"text":"<style=\"stress\"><player_name></style>, as you can see, I'm buried in work. Sorry I can't be more welcoming.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x618D98A6F42A814D","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, as you can see, I'm buried in work. Sorry I can't be more welcoming.","female":"<style=\"stress\"><player_name></style>, as you can see, I'm buried in work. Sorry I can't be more welcoming.","variant_male_record_index":"171884","variant_female_record_index":"171885","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423428002:1":{"text":"Ravion sent us. We're here to help!","source_cn":"其实是沙利叶请我们来帮你的啦！","status":"matched","hash_xxh64":"0xE5A85D8608B7754C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423428003:1":{"text":"Great. In that case, I'll gladly take the help...","source_cn":"那么时间紧急，我也不客气了……","status":"matched","hash_xxh64":"0xA3BA08C094EB5B14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423428004:1":{"text":"We're short on everything—people, supplies, even basic things like wood and stone...","source_cn":"现在我这里人手和材料都不足，连最基本的木料和石材都缺……","status":"matched","hash_xxh64":"0x7E0E96F0C76FAD60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423428005:1":{"text":"Could you help gather some <style=\"highlight\">wood</style> and <style=\"highlight\">stone</style>?","source_cn":"可以请你们去帮我找些<style=highlight>...","status":"matched","hash_xxh64":"0xA5E62C169D6F7566","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423428006:1":{"text":"You'll probably find wood around the commoners' district. For stone, check near the lift, where the dwarves used to work!","source_cn":"木料平民区就有，石材可能得到矮人们工作过的升降机附近找找了！","status":"matched","hash_xxh64":"0x06F94764CA5DBFEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:席蕾":{"text":"Xera","source":"席蕾","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":2}},"locales/en/ep4/quest_story/14234290.json":{"asset_key":"ep4/quest_story_14234290","episode":"ep4","category":"quest_story","story_id":"14234290","schema_version":1,"lang":"en","texts":{"say:0:1423429001:0":{"text":"Looks like no one's taking care of this pile of wood.","source_cn":"这些木料……看上去没有人在管理。","status":"matched","hash_xxh64":"0x1AF353F22BFFF1BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14234300.json":{"asset_key":"ep4/quest_story_14234300","episode":"ep4","category":"quest_story","story_id":"14234300","schema_version":1,"lang":"en","texts":{"say:0:1423430001:0":{"text":"And these stones have been sitting here forever.","source_cn":"这些石料已经在这堆放很久了。","status":"matched","hash_xxh64":"0x624445172EA9FA8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1423430002:0":{"text":"Yeah... Xera really does need all the help she can get.","source_cn":"看来席蕾确实缺人手……","status":"matched","hash_xxh64":"0x2644B4AD5674B568","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/ep4/quest_story/14234310.json":{"asset_key":"ep4/quest_story_14234310","episode":"ep4","category":"quest_story","story_id":"14234310","schema_version":1,"lang":"en","texts":{"say:0:1423431001:0":{"text":"Let's bring the materials back to her!","source_cn":"把材料交给席蕾吧！","status":"matched","hash_xxh64":"0x1F92732ED7EF9AB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14234320.json":{"asset_key":"ep4/quest_story_14234320","episode":"ep4","category":"quest_story","story_id":"14234320","schema_version":1,"lang":"en","texts":{"say:1:1423432001:1":{"text":"Xera, we brought back the wood and stone you needed.","source_cn":"席蕾，我们把你缺的木料和石材带回来啦。","status":"matched","hash_xxh64":"0x43FFCAD7F39BB288","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423432002:1":{"text":"Thank you. I feel so much better now that you're here...","source_cn":"谢谢你们，有你们在，我安心多了……","status":"matched","hash_xxh64":"0x5D061093FBCA640A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423432003:1":{"text":"Lady Xera! More beasts are attacking!","source_cn":"席蕾大人！又有野兽来袭击了！","status":"matched","hash_xxh64":"0xA231BB4BD4B38F4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423432004:1":{"text":"Again?! Alright, I'm on my way!","source_cn":"又来了！我现在就过去！","status":"matched","hash_xxh64":"0xDB1760744AC9F34D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423432005:1":{"text":"We'll come with you!","source_cn":"我们也去帮忙！","status":"matched","hash_xxh64":"0xEED68FE2358ACF00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:席蕾":{"text":"Xera","source":"席蕾","status":"matched_dialogue_flow"},"speaker:惊慌的平民":{"text":"Anxious Commoner","source":"惊慌的平民","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":3}},"locales/en/ep4/quest_story/14234330.json":{"asset_key":"ep4/quest_story_14234330","episode":"ep4","category":"quest_story","story_id":"14234330","schema_version":1,"lang":"en","texts":{"say:1:1423433001:1":{"text":"Thank you... sorry to drag you into this again. I'm really not cut out to lead a reconstruction project...","source_cn":"谢谢你们！又麻烦了你们一次……说实在的我不太擅长主持修缮……","status":"matched","hash_xxh64":"0x8D73450224C5ACFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423433002:1":{"text":"I've never missed the royal city's dwarves this much in my life!","source_cn":"我从来没像现在一样想念过王城的矮人！","status":"matched","hash_xxh64":"0xA0C01A79C7733174","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423433003:1":{"text":"If only Sal'thorin could keep working with them... but that's probably just wishful thinking!","source_cn":"如果萨洛克兰能继续与矮人合作修缮……唉，我也只是想想！","status":"matched","hash_xxh64":"0xB83DF622B567681B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423433004:1":{"text":"You've probably got more pressing things to do. I won't keep you!","source_cn":"你们应该还有别的事要忙吧，就不打扰你们了！","status":"matched","hash_xxh64":"0x9590D650D06A6FF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:席蕾":{"text":"Xera","source":"席蕾","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}},"locales/en/ep4/quest_story/14234340.json":{"asset_key":"ep4/quest_story_14234340","episode":"ep4","category":"quest_story","story_id":"14234340","schema_version":1,"lang":"en","texts":{"say:0:1423434001:0":{"text":"Looks like things are under control here... Let's tell Ravion what Xera said.","source_cn":"事情是暂时解决了……我们把席蕾的想法跟沙利叶说说吧？","status":"matched","hash_xxh64":"0x0BBD141B1B18969C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14234350.json":{"asset_key":"ep4/quest_story_14234350","episode":"ep4","category":"quest_story","story_id":"14234350","schema_version":1,"lang":"en","texts":{"say:1:1423435001:1":{"text":"So she hopes to continue the collaboration with the dwarves, huh?","source_cn":"希望能继续与矮人合作修缮事宜吗……","status":"matched","hash_xxh64":"0x07494E0B867EA40D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423435002:1":{"text":"Thank you for your honesty, my dear mage friend.","source_cn":"亲爱的魔法师朋友，感谢你的恳切。","status":"matched_runtime_gender","hash_xxh64":"0x2A2FF989E900E269","variant_status":"runtime_gender_keys_target_same","male":"Thank you for your honesty, my dear mage friend.","female":"Thank you for your honesty, my dear mage friend.","variant_male_record_index":"171907","variant_female_record_index":"171908","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423435003:1":{"text":"I'll give it some thought.","source_cn":"我会认真考虑这项建议的可行性的。","status":"matched","hash_xxh64":"0x8F2E1CCBA7971639","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:沙利叶":{"text":"Ravion","source":"沙利叶","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}}}