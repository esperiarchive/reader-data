ument_title_status":""},"say:2:1322519002:1":{"text":"でも医者は大丈夫だって言うし、もしかしたら呪いにでもかかったんじゃ……","source_cn":"但医生又说没事，也许这是魔法，奇怪的魔法……","status":"matched","hash_xxh64":"0xDC533BD7C471BCE1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:不安的镇民":{"text":"不安がる町民","source":"不安的镇民","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/jp/ep3/quest_story/13225200.json":{"asset_key":"ep3/quest_story_13225200","episode":"ep3","category":"quest_story","story_id":"13225200","schema_version":1,"lang":"jp","texts":{"say:1:1322520001:1":{"text":"天から舞い降りる夢を見るんだ。世界を俯瞰し、ゆっくりと降りていく。","source_cn":"我梦到自己从天而降，俯视众生，缓慢飘落。","status":"matched","hash_xxh64":"0xBD8B9AB1A5500766","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322520002:1":{"text":"ああ……純粋から不純へ、温もりが冷めていく……","source_cn":"噢……从纯净到污秽，从温暖到冰冷。","status":"matched","hash_xxh64":"0xE6812C13540BDDAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:唠叨的镇民":{"text":"お喋りな町民","source":"唠叨的镇民","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/jp/ep3/quest_story/13225210.json":{"asset_key":"ep3/quest_story_13225210","episode":"ep3","category":"quest_story","story_id":"13225210","schema_version":1,"lang":"jp","texts":{"say:1:1322521001:1":{"text":"ぼ、ぼ……僕はもともと寒さには強かったはずなんだ！","source_cn":"大家从雪、雪人变回来！我原本、原本觉得不、不咋冷！","status":"matched","hash_xxh64":"0xC9C5DCB062377464","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322521002:1":{"text":"み、み、み……みんなが寒いって言うから……僕まで寒くなってきた！","source_cn":"大、大、大、大家都觉得冷，我也觉得冷了！","status":"matched","hash_xxh64":"0xB9BBCE62A48C66A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:大嗓门镇民":{"text":"声が大きい町民","source":"大嗓门镇民","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/jp/ep3/quest_story/13225220.json":{"asset_key":"ep3/quest_story_13225220","episode":"ep3","category":"quest_story","story_id":"13225220","schema_version":1,"lang":"jp","texts":{"say:0:1322522001:0":{"text":"マスター、どちらかと言えば心理的な問題ですかね。","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x1ADBD7B348556910","variant_status":"runtime_gender_keys_target_same","male":"マスター、どちらかと言えば心理的な問題ですかね。","female":"マスター、どちらかと言えば心理的な問題ですかね。","variant_male_record_index":"151852","variant_female_record_index":"151853","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322522002:0":{"text":"そうだな。でも多少は体質の変化もあるんだろう。何か滋養強壮に効くものでも作れたら……","source_cn":"是的，但也需要增强体质来御寒。如果能给镇民做点滋补汤剂……","status":"matched_runtime_gender","hash_xxh64":"0x2A9E6B3323EE76C7","variant_status":"runtime_gender_keys_target_differs","male":"そうだな。でも多少は体質の変化もあるんだろう。何か滋養強壮に効くものでも作れたら……","female":"そうね。でも多少は体質の変化もあるのかも。何か滋養強壮に効くものでも作れたら……","variant_male_record_index":"151854","variant_female_record_index":"151855","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"},"speaker:主角":{"text":"主人公","source":"主角","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/jp/ep3/quest_story/13225230.json":{"asset_key":"ep3/quest_story_13225230","episode":"ep3","category":"quest_story","story_id":"13225230","schema_version":1,"lang":"jp","texts":{"say:1:1322523001:1":{"text":"葱人参やイエローリアなどは体を強くし、風邪を防ぐ効果がありますよ！味の保証はできませんが……","source_cn":"葱萝、灵曼根，都是滋补身体的呢！不知道味道会是什么样……","status":"matched","hash_xxh64":"0xE3084F184EA1C4EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322523002:1":{"text":"マスターの腕前を疑うか！おいしくなるに決まってるでしょ！","source_cn":"主人的手艺你放心！绝对不会错！","status":"matched_runtime_gender","hash_xxh64":"0xF16A78EC2B741AD0","variant_status":"runtime_gender_keys_target_same","male":"マスターの腕前を疑うか！おいしくなるに決まってるでしょ！","female":"マスターの腕前を疑うか！おいしくなるに決まってるでしょ！","variant_male_record_index":"151857","variant_female_record_index":"151858","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322523003:1":{"text":"もう待ちきれません！マスター、まずはロンロンから飲ませてくださいね！","source_cn":"等不及了！主人快动手吧，一会也要给满满喝一点啊！","status":"matched_runtime_gender","hash_xxh64":"0x0BC5BE2A05A4297A","variant_status":"runtime_gender_keys_target_same","male":"もう待ちきれません！マスター、まずはロンロンから飲ませてくださいね！","female":"もう待ちきれません！マスター、まずはロンロンから飲ませてくださいね！","variant_male_record_index":"151859","variant_female_record_index":"151860","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"document:4:160:0":{"text":"<style=\"highlight\">葱人参</style>と<style=\"highlight\">イエローリア</style>は自然の恵みであり、体を強くし、風邪を予防する効果がある。まず、葱人参の皮をむいてみじん切りにし、低温で煮込んで臭みを取る。\n\nその後、適当な大きさに切ったイエローリアを投入したら、強火にしてしばらく煮込む。上品なイエローリアの風味が葱人参の甘みを中和し、大地の活力を十分に引き出した栄養たっぷりの滋養強壮スープが完成。\n\n寒い冬に身も心も温まる一品。","source_cn":"<style=\"highlight\">葱萝</style>与<style=\"highlight\">灵曼根</style>是自然的恩赐，具有增强体质、抵御寒气的功效，先将葱萝去皮切碎后低温慢煮，去除异味。\n\n将灵曼根直接切入锅中高温炖煮，搭配上灵曼根的淡雅香气可以中和葱萝的甜度，充分释放大地的鲜香与灵气后，美味滋补汤即可出锅。\n\n冬日里来上一碗，暖手又暖身！","status":"matched","hash_xxh64":"0x2B6934B5BF419885","variant_status":"","male":"<style=\"highlight\">葱人参</style>と<style=\"highlight\">イエローリア</style>は自然の恵みであり、体を強くし、風邪を予防する効果がある。まず、葱人参の皮をむいてみじん切りにし、低温で煮込んで臭みを取る。\n\nその後、適当な大きさに切ったイエローリアを投入したら、強火にしてしばらく煮込む。上品なイエローリアの風味が葱人参の甘みを中和し、大地の活力を十分に引き出した栄養たっぷりの滋養強壮スープが完成。\n\n寒い冬に身も心も温まる一品。","female":"<style=\"highlight\">葱人参</style>と<style=\"highlight\">イエローリア</style>は自然の恵みであり、体を強くし、風邪を予防する効果がある。まず、葱人参の皮をむいてみじん切りにし、低温で煮込んで臭みを取る。\n\nその後、適当な大きさに切ったイエローリアを投入したら、強火にしてしばらく煮込む。上品なイエローリアの風味が葱人参の甘みを中和し、大地の活力を十分に引き出した栄養たっぷりの滋養強壮スープが完成。\n\n寒い冬に身も心も温まる一品。","variant_male_record_index":"","variant_female_record_index":"","document_title":"滋養強壮スープ","document_title_male":"滋養強壮スープ","document_title_female":"滋養強壮スープ","document_title_cn":"美味滋补汤","document_title_status":"matched"},"narration:8:1320820006:0":{"text":"一通り調合が完了した……","source_cn":"经过一番调制……","status":"matched","hash_xxh64":"0x040752681A084A7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:10:1320820006:0":{"text":"一通り調合が完了した……","source_cn":"经过一番调制……","status":"matched","hash_xxh64":"0x040752681A084A7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"ロンロン","source":"满满","status":"matche