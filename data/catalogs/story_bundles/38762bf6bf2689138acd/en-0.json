{"schema_version":1,"resources":{"easter_eggs/menus/16010369_1_1.en.json":{"schema_version":1,"asset_key":"easter_eggs/menu_16010369:1:1","lang":"en","texts":{"menu:510200255:1":{"text":"How dare you toy with me?!","source_cn":"竟敢戏弄本喵！","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:愤怒的猫咪":{"text":"Angry Cat","source":"愤怒的猫咪","status":"exact_hash"}}},"locales/en/ep6/env_story/16311440.json":{"asset_key":"ep6/env_story_16311440","episode":"ep6","category":"env_story","story_id":"16311440","schema_version":1,"lang":"en","texts":{"say:0:1631144001:0":{"text":"Meow... MEOW!","source_cn":"喵……喵！","status":"matched","hash_xxh64":"0x15D94D81975E771C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:愤怒的猫咪":{"text":"Angry Cat","source":"愤怒的猫咪","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep6/env_story/16311441.json":{"asset_key":"ep6/env_story_16311441","episode":"ep6","category":"env_story","story_id":"16311441","schema_version":1,"lang":"en","texts":{"say:0:1631144101:0":{"text":"Meow... MEOW!","source_cn":"喵……喵！","status":"matched","hash_xxh64":"0x15D94D81975E771C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:1631144101":{"text":"1631144101","source":"1631144101","status":"source"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep6/env_story/16311450.json":{"asset_key":"ep6/env_story_16311450","episode":"ep6","category":"env_story","story_id":"16311450","schema_version":1,"lang":"en","texts":{"say:1:1631145001:1":{"text":"Did you see a mouse run past just now?","source_cn":"你刚才有没有见到一只跑来的老鼠？","status":"matched","hash_xxh64":"0xCBDC5ABF9B3FC20C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1631145001":{"text":"Did you see a mouse run past just now?","source_cn":"你刚才有没有见到一只跑来的老鼠？","status":"matched","hash_xxh64":"0xCBDC5ABF9B3FC20C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1631145002:1":{"text":"Hmph! It dove into this hole! It mocked me while it ran, tail flicking like it owned the place!","source_cn":"哼！它肯定是钻进这个洞里了！我追它一路，它倒好，一路回...","status":"matched","hash_xxh64":"0x64DE80DFF4073736","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1631145003:1":{"text":"That shameless thief steals from humans and animals' winter stores! Today, it pays!","source_cn":"那个无耻的小偷！偷人类的东西也就算了，连其他动物过冬的...","status":"matched","hash_xxh64":"0x152D2D647D07238A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1631145004:1":{"text":"You look like you know magic. Can you go in there? It's too small for me.","source_cn":"我看你好像会点魔法……你能帮我进去看看吗？这个洞对我来...","status":"matched","hash_xxh64":"0xCE2C48D8E889E89A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1631145004":{"text":"You look like you know magic. Can you go in there? It's too small for me.","source_cn":"我看你好像会点魔法……你能帮我进去看看吗？这个洞对我来说太小了。","status":"matched","hash_xxh64":"0xCE2C48D8E889E89A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1631145005:1":{"text":"Great! Then I'll count on you!","source_cn":"太好了！那就拜托你了！","status":"matched","hash_xxh64":"0x5776DCC350AE4A43","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1631145007:1":{"text":"Hurry, go check it out!","source_cn":"它肯定就在下面！快，快去看看！","status":"matched","hash_xxh64":"0x3A0D7CFE8A91DEEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"Easy enough.","source_cn":"这并不难","status":"matched_runtime_gender","hash_xxh64":"0x5C2339C5110C57CB","variant_status":"runtime_gender_keys_target_same","male":"Easy enough.","female":"Easy enough.","variant_male_record_index":"85043","variant_female_record_index":"85044","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1631145006:1":{"text":"A reward? Mrow... think of it as serving justice! Maybe you'll earn a fine reputation among animals!","source_cn":"好处？喵呜……就当是为民除害，帮大家一个忙嘛！说不定…...","status":"matched","hash_xxh64":"0x9DA9B09EF9BFF7A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"What's in it for me?","source_cn":"我有什么好处？","status":"matched_runtime_gender","hash_xxh64":"0x84833E2F8673E402","variant_status":"runtime_gender_keys_target_same","male":"What's in it for me?","female":"What's in it for me?","variant_male_record_index":"85045","variant_female_record_index":"85046","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"I didn't see anything.","source_cn":"没注意到","status":"matched_runtime_gender","hash_xxh64":"0xED4FDB787D06B24B","variant_status":"runtime_gender_keys_target_same","male":"I didn't see anything.","female":"I didn't see anything.","variant_male_record_index":"85039","variant_female_record_index":"85040","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:1:2":{"text":"I only saw you.","source_cn":"我只看到了你","status":"matched_runtime_gender","hash_xxh64":"0x57F0331ACC6AF0FC","variant_status":"runtime_gender_keys_target_same","male":"I only saw you.","female":"I only saw you.","variant_male_record_index":"85041","variant_female_record_index":"85042","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:愤怒的猫咪":{"text":"Angry Cat","source":"愤怒的猫咪","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14,"localized_text_count":13,"speaker_count":1}},"locales/en/ep6/env_story/16311460.json":{"asset_key":"ep6/env_story_16311460","episode":"ep6","category":"env_story","story_id":"16311460","schema_version":1,"lang":"en","texts":{"narration:0:1631146001:1":{"text":"You transform into a hamster and crawl inside.","source_cn":"","status":"matched_runtime_gender","hash_xxh64":"0x5400A2A0BFF3BFEF","variant_status":"runtime_gender_keys_target_same","male":"You transform into a hamster and crawl inside.","female":"You transform into a hamster and crawl inside.","variant_male_record_index":"212280","variant_female_record_index":"212281","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:1:1631146002:1":{"text":"The tunnel now feels spacious.","source_cn":"","status":"matched_runtime_gender","hash_xxh64":"0x6ECB6003EBBE8BE8","variant_status":"runtime_gender_keys_target_same","male":"The tunnel now feels spacious.","female":"The tunnel now feels spacious.","variant_male_record_index":"212282","variant_female_record_index":"212283","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:2:1631146003:1":{"text":"You sniff carefully and identify fresh paw prints that lead onward...","source_cn":"","status":"matched_runtime_gender","hash_xxh64":"0xCD51CA84FABCAED1","variant_status":"runtime_gender_keys_target_same","male":"You sniff carefully and identify fresh paw prints that lead onward...","female":"You sniff carefully and identify fresh paw prints that lead onward...","variant_male_record_index":"212284","variant_female_record_index":"212285","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:3:1631146004:1":{"text":"The paw prints vanish at another exit. The culprit has escaped!","source_cn":"","status":"matched_runtime_gender","hash_xxh64":"0x0D792B05949D5260","variant_status":"runtime_gender_keys_target_same","male":"The paw prints vanish at another exit. The culprit has escaped!","female":"The paw prints vanish at another exit. The culprit has escaped!","variant_male_record_index":"212286","variant_female_record_index":"212287","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:黑屏":{"text":"Black Screen","source":"黑屏","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}},"locales/en/ep6/env_story/16311470.json":{"asset_key":"ep6/env_story_16311470","episode":"ep6","category":"env_story","story_id":"16311470","schema_version":1,"lang":"en","texts":{"say:1:1631147001:0":{"text":"So? Did you catch that whisker-face?","source_cn":"怎么样？找到那个小坏蛋的踪迹了吗？","status":"matched","hash_xxh64":"0xFFDA271FF9BDEFAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1631147001":{"text":"So? Did you catch that whisker-face?","source_cn":"怎么样？找到那个小坏蛋的踪迹了吗？","status":"matched","hash_xxh64":"0xFFDA271FF9BDEFAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1631147002:0":{"text":"What?! It planned an escape route?!","source_cn":"可恶！这家伙居然连逃跑路线都规划好了！真是个狡猾的惯犯！","status":"matched","hash_xxh64":"0x950DD5ED00E4DE8F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1631147003:0":{"text":"How dare it act like this on my turf! I swear I won't let it get away with this!","source_cn":"竟敢在我的地盘上这么嚣张！我发誓绝不会放过他！","status":"matched","hash_xxh64":"0x24DFFCAA0CFEEDF9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1631147004:0":{"text":"Hmph... Still, thanks. At least I don't have to guard this hole like a fool anymore.","source_cn":"哼……不过还是谢了。至少现在我知道不用再像个傻瓜一样死...","status":"matched","hash_xxh64":"0x2CC89C63FB13B34E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1631147005:0":{"text":"If I ever catch that thief, you'll get credit too!","source_cn":"如果哪天我逮住了他，这份功劳肯定算你一份！","status":"matched","hash_xxh64":"0x000072CA81929F12","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"Sorry to say this, but...","source_cn":"（告知情况）","status":"matched_runtime_gender","hash_xxh64":"0x97F29D368D6704B0","variant_status":"runtime_gender_keys_target_same","male":"Sorry to say this, but...","female":"Sorry to say this, but...","variant_male_record_index":"85047","variant_female_record_index":"85048","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:愤怒的猫咪":{"text":"Angry Cat","source":"愤怒的猫咪","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":1}}}}