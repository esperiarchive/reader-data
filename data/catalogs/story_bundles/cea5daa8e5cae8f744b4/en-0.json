iant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322241003:1":{"text":"You need to stop them, Magister <style=\"stress\"><player_name></style>. Please.","source_cn":"为了大家不被变成魔物，<style=stress><p...","status":"matched","hash_xxh64":"0x4DE05A6856CFB89E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卡列琳娜":{"text":"Carolina","source":"卡列琳娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}},"locales/en/ep3/quest_story/13222420.json":{"asset_key":"ep3/quest_story_13222420","episode":"ep3","category":"quest_story","story_id":"13222420","schema_version":1,"lang":"en","texts":{"say:0:1322242001:0":{"text":"There are traces of cult rituals here! It's an abomin.. aboma... It's terrible!","source_cn":"这里有邪教徒的仪式痕迹！他们居然真的在做这么残忍的事情……","status":"matched","hash_xxh64":"0xB7D63091C34F3C11","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322242002:0":{"text":"They must be here! We need to search the area, Magister!","source_cn":"他们一定还在这里！主人，我们快在附近搜索一下！","status":"matched","hash_xxh64":"0x9D45F8198842BDF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep3/quest_story/13222430.json":{"asset_key":"ep3/quest_story_13222430","episode":"ep3","category":"quest_story","story_id":"13222430","schema_version":1,"lang":"en","texts":{"say:0:1322243001:0":{"text":"The cultists are here, Magister! It's time to fight!","source_cn":"邪教徒在这里！主人，准备战斗吧！","status":"matched","hash_xxh64":"0x73957617117277E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep3/quest_story/13222440.json":{"asset_key":"ep3/quest_story_13222440","episode":"ep3","category":"quest_story","story_id":"13222440","schema_version":1,"lang":"en","texts":{"say:1:1322244001:1":{"text":"Yes! Finally, all the evil cultists have been defeated!","source_cn":"这些邪恶的邪教徒总算被消灭啦！","status":"matched","hash_xxh64":"0xC0DA9B5E13BCBE72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322244002:1":{"text":"Fortunately, we stopped them in the nick of time. Otherwise, it would've been a huge disaster.","source_cn":"还好及时阻止，没有让他们酿出大祸。","status":"matched","hash_xxh64":"0x7041D2638C30639A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322244003:1":{"text":"The magic circle is gone, but the undead are still coming toward us!","source_cn":"法阵消失了，可是这些活死人怎么朝着我们过来了？！","status":"matched","hash_xxh64":"0x4866F691E572E5F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1322244003":{"text":"The magic circle is gone, but the undead are still coming toward us!","source_cn":"法阵消失了，可是这些活死人怎么朝着我们过来了？！","status":"matched","hash_xxh64":"0x4866F691E572E5F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322244004:1":{"text":"The magister is right. Even if they haven't turned into Hypofiends, their souls are still suffering.","source_cn":"主人说得对，就算没有变成魔物，他们现在的灵魂也饱受煎熬。","status":"matched_runtime_gender","hash_xxh64":"0x5574104D171A5721","variant_status":"runtime_gender_keys_target_same","male":"The magister is right. Even if they haven't turned into Hypofiends, their souls are still suffering.","female":"The magister is right. Even if they haven't turned into Hypofiends, their souls are still suffering.","variant_male_record_index":"151161","variant_female_record_index":"151162","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"We have to put them out of their misery.","source_cn":"看来只有让他们彻底解脱了","status":"matched_runtime_gender","hash_xxh64":"0x2D71624077E860EB","variant_status":"runtime_gender_keys_target_same","male":"We have to put them out of their misery.","female":"We have to put them out of their misery.","variant_male_record_index":"70010","variant_female_record_index":"70011","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Ha