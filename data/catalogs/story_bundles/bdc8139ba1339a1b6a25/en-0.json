":"无聊的工匠","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14232130.json":{"asset_key":"ep4/quest_story_14232130","episode":"ep4","category":"quest_story","story_id":"14232130","schema_version":1,"lang":"en","texts":{"say:1:1423213001:0":{"text":"What's up? We're leaving soon. Get help from someone else!","source_cn":"干啥？我们马上就要走了，有什么事找村里其他人吧！","status":"matched_runtime_gender","hash_xxh64":"0x839D75756EE6AC6D","variant_status":"runtime_gender_keys_target_same","male":"What's up? We're leaving soon. Get help from someone else!","female":"What's up? We're leaving soon. Get help from someone else!","variant_male_record_index":"170669","variant_female_record_index":"170670","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1423213001":{"text":"What's up? We're leaving soon. Get help from someone else!","source_cn":"干啥？我们马上就要走了，有什么事找村里其他人吧！","status":"matched_runtime_gender","hash_xxh64":"0x839D75756EE6AC6D","variant_status":"runtime_gender_keys_target_same","male":"What's up? We're leaving soon. Get help from someone else!","female":"What's up? We're leaving soon. Get help from someone else!","variant_male_record_index":"170669","variant_female_record_index":"170670","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423213002:0":{"text":"Why? We're out of work, that's why!","source_cn":"为啥？没活干呗！","status":"matched","hash_xxh64":"0xFEC4312C8F93F5DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1423213002":{"text":"Why? We're out of work, that's why!","source_cn":"为啥？没活干呗！","status":"matched","hash_xxh64":"0xFEC4312C8F93F5DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423213003:0":{"text":"The village needs researchers for arcane steel, not line operators like us. The production line's been dead for ages!","source_cn":"村里缺的是研究魔钢的人，我们是生产线上的，这生产线都多...","status":"matched","hash_xxh64":"0x3F384D8DE6C527E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423213004:0":{"text":"We can't afford to just wait day after day!","source_cn":"让我们天天就这样等着，不是个事啊！","status":"matched","hash_xxh64":"0x835FBD58B75A1544","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1423213004":{"text":"We can't afford to just wait day after day!","source_cn":"让我们天天就这样等着，不是个事啊！","status":"matched","hash_xxh64":"0x835FBD58B75A1544","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423213005:0":{"text":"Since we've waited this long, I suppose waiting a bit longer won't hurt.","source_cn":"反正都等了这么久了……再等等也不是不行。","status":"matched","hash_xxh64":"0x760B4338166289B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1423213006:0":{"text":"But at least get us some fine brew and roast turkey to kill time!","source_cn":"你给我们搞点啤酒和烤火鸡消遣消遣呗。","status":"matched_runtime_gender","hash_xxh64":"0x743645056AA7D25E","variant_status":"runtime_gender_keys_target_same","male":"But at least get us some fine brew and roast turkey to kill time!","female":"But at least get us some fine brew and roast turkey to kill time!","variant_male_record_index":"170675","variant_female_record_index":"170676","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1423213007:0":{"text":"As long as we have something to nibble on, we won't get bored.","source_cn":"要是有的吃有的喝，我们自然不觉得无聊了。","status":"matched","hash_xxh64":"0x135BC682017C14DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"Be patient.","source_cn":"再等等吧","status":"matched_runtime_gender","hash_xxh64":"0x4852DD5BDC829367","variant_status":"runtime_gender_keys_target_same","male":"Be patient.","female":"Be patient.","variant_male_record_index":"74172","variant_female_record_index":"74173","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"We're close to a breakthrough.","source_cn":"魔钢研究很快就有进展了","status":"matched_runtime_gender","hash_xxh64":"0x86FBF65C9242960D","variant_status":"runtime_gender_keys_target_same","male":"We're close to a breakthrough.","female":"We're close to a breakthrough.","variant_male_record_index":"74174","variant_female_record_index":"74175","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"The village's understaffed now.","source_cn":"村里现在很缺人手","status":"matched_runtime_gender","hash_xxh64":"0xD2E09496905BAEEE","variant_status":"runtime_g