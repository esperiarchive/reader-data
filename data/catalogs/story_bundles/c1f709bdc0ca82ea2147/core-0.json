y":"ep8/env_story_18315030","episode":"ep8","category":"env_story","story_id":"18315030","schema_version":1,"lang":"cn","texts":{"say:3:1831503001:1":{"text":"莫蒂默殿下似乎已经选定新的继承人了，恐怕不日诺珐斯就会换一位领主。","source_cn":"莫蒂默殿下似乎已经选定新的继承人了，恐怕不日诺珐斯就会...","status":"matched","hash_xxh64":"0xEDEA4CC4278E2AE6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1831503002:1":{"text":"是吗？是谁来继承？","source_cn":"是吗？是谁来继承？","status":"matched","hash_xxh64":"0xDDD843C6804F5408","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1831503003:1":{"text":"听说是苔佩希小姐。就是那位穿着很可爱，但说话很不客气的小姐。","source_cn":"听说是苔佩希小姐。就是那位穿着很可爱，但说话很不客气的小姐。","status":"matched","hash_xxh64":"0x0C62BAAED04B3E1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1831503004:1":{"text":"怎么是她？她不是很少在诺珐斯露面吗？","source_cn":"怎么是她？她不是很少在诺珐斯露面吗？","status":"matched","hash_xxh64":"0x4CE7594D0DDCBEAA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1831503005:1":{"text":"据说苔佩希小姐的魔法天赋很出众，<style=\"highlight\">挥挥手就能将诺珐斯境内所有蝙蝠召唤到她身边</style>。说不定殿下就是因此选中了她。","source_cn":"据说苔佩希小姐的魔法天赋很出众，<style=high...","status":"matched","hash_xxh64":"0xEB71D83B90F88E07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1831503006:1":{"text":"那等她继承领主之位，魔法水平肯定会更上一层楼。历任领主的力量可都远远超过那些普通的吸血鬼。","source_cn":"那等她继承领主之位，魔法水平肯定会更上一层楼。历任领主...","status":"matched","hash_xxh64":"0x5EA5989D132A1640","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1831503007:1":{"text":"那她说不定能把班题斯的蝙蝠也召唤到诺珐斯来，哈哈。","source_cn":"那她说不定能把班题斯的蝙蝠也召唤到诺珐斯来，哈哈。","status":"matched","hash_xxh64":"0xB1738C888C1E6C1B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1831503008:1":{"text":"要是有机会，真想看看那个场景啊……班题斯那些亡灵的表情肯定会很精彩。","source_cn":"要是有机会，真想看看那个场景啊……班题斯那些亡灵的表情...","status":"matched","hash_xxh64":"0xF84CA15439F67045","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:贵族格登幻象":{"text":"贵族格登幻象","source":"贵族格登幻象","status":"source"},"speaker:贵族瑞嘉娜幻象":{"text":"贵族瑞嘉娜幻象","source":"贵族瑞嘉娜幻象","status":"source"},"speaker:贵族德雷文幻象":{"text":"贵族德雷文幻象","source":"贵族德雷文幻象","status":"source"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":3}},"locales/cn/ep8/env_story/18315040.json":{"asset_key":"ep8/env_story_18315040","episode":"ep8","category":"env_story","story_id":"18315040","schema_version":1,"lang":"cn","texts":{"say:0:1831504001:0":{"text":"<style=\"highlight\">召唤蝙蝠</style>？这应该就是这面镜子的答案吧。","source_cn":"<style=highlight>召唤蝙蝠</styl...","status":"matched_runtime_gender","hash_xxh64":"0x4ECACAAB08F3053D","variant_status":"runtime_gender_keys_target_same","male":"<style=\"highlight\">召唤