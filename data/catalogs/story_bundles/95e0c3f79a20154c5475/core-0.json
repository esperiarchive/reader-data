ext","plot_ids":["15236290"],"localization_status":"exact_hash","record_indices":["25638"]}}}},"catalogs/runtime/scenes/b98b6e35b579f8de7885.json":{"assets":{"ep5/quest_story_15236320":{"skip":{"source_cn":"你带着新钓的鱼回到呼临广场。阿邦德惊叹你又快又好的钓鱼技术，感谢你为食粮开发做出的贡献。","text_i18n":{"cn":"你带着新钓的鱼回到呼临广场。阿邦德惊叹你又快又好的钓鱼技术，感谢你为食粮开发做出的贡献。","en":"You bring the freshly caught fish back to the Halia square. Abundius marvels at your quick, skillful fishing and thanks you for contributing to the search for new food sources.","jp":"あなたは釣り上げた魚を携えてホーリン広場へ戻った。アバルドはあまりの早さと釣りの技術に感嘆し、食料開発への貢献に感謝の言葉を述べた。","kr":"새로운 물고기를 가지고 보칼리스 광장으로 돌아왔다. 아반드는 나의 빠르고 능숙한 낚시 실력에 감탄하며 식량 개발에 공헌해 주어 고맙다고 했다."},"source":"Plot.SkipText","plot_ids":["15236320"],"localization_status":"exact_hash","record_indices":["25639"]}}}},"locales/cn/ep5/quest_story/15236290.json":{"asset_key":"ep5/quest_story_15236290","episode":"ep5","category":"quest_story","story_id":"15236290","schema_version":1,"lang":"cn","texts":{"say:1:1523629001:0":{"text":"<style=\"stress\"><player_name></style>，你喜欢钓鱼吗？","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x8C76C35CA3DD405D","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>，你喜欢钓鱼吗？","female":"<style=\"stress\"><player_name></style>，你喜欢钓鱼吗？","variant_male_record_index":"190685","variant_female_record_index":"190686","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1523629001":{"text":"<style=\"stress\"><player_name></style>，你喜欢钓鱼吗？","source_cn":"<style=stress><player_name></style>，你喜欢钓鱼吗？","status":"matched_runtime_gender","hash_xxh64":"0x8C76C35CA3DD405D","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>，你喜欢钓鱼吗？","female":"<style=\"stress\"><player_name></style>，你喜欢钓鱼吗？","variant_male_record_index":"190685","variant_female_record_index":"190686","document_title":"","