{"schema_version":1,"resources":{"faction_dailies/locales/en/13010537/1.json":{"schema_version":1,"asset_key":"optional/objective_13010537:1:1","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010537/2.json":{"schema_version":1,"asset_key":"optional/objective_13010537:1:2","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010537/3.json":{"schema_version":1,"asset_key":"optional/objective_13010537:1:3","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010537/4.json":{"schema_version":1,"asset_key":"optional/objective_13010537:1:4","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010537/5.json":{"schema_version":1,"asset_key":"optional/objective_13010537:1:5","lang":"en","texts":{},"speakers":{}},"faction_dailies/locales/en/13010537/6.json":{"schema_version":1,"asset_key":"optional/objective_13010537:1:6","lang":"en","texts":{},"speakers":{}},"locales/en/ep3/quest_story/13225470.json":{"asset_key":"ep3/quest_story_13225470","episode":"ep3","category":"quest_story","story_id":"13225470","schema_version":1,"lang":"en","texts":{"say:1:1322547001:1":{"text":"Our people spotted some cultists lurking around Valesa Castle. No idea what they're up to this time.","source_cn":"我们的人在瓦勒沙城堡附近又发现了一些邪教徒，不知道他们...","status":"matched","hash_xxh64":"0xA5A30E7A2A232708","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322547002:1":{"text":"These people aren't scared of the guards, but they seem to fear anyone who knows magic.","source_cn":"这些人似乎并不害怕侍卫，反而更加畏惧懂得神秘魔法力量的人。","status":"matched","hash_xxh64":"0x60E8E644DED32A42","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322547003:1":{"text":"I hate to ask again, Magister, but we could really use your help with this one.","source_cn":"魔法师大人，这次又得麻烦您了。","status":"matched","hash_xxh64":"0x6740D0DD4C47B6CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:侍卫长罗德里戈":{"text":"Captain Rodrigo","source":"侍卫长罗德里戈","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}},"locales/en/ep3/quest_story/13225480.json":{"asset_key":"ep3/quest_story_13225480","episode":"ep3","category":"quest_story","story_id":"13225480","schema_version":1,"lang":"en","texts":{"say:0:1322548001:0":{"text":"Magister, look over there! Those must be the cultists!","source_cn":"主人，你看！那里是不是邪教徒？","status":"matched_runtime_gender","hash_xxh64":"0x23E41582EAF258D9","variant_status":"runtime_gender_keys_target_same","male":"Magister, look over there! Those must be the cultists!","female":"Magister, look over there! Those must be the cultists!","variant_male_record_index":"151943","variant_female_record_index":"151944","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep3/quest_story/13225490.json":{"asset_key":"ep3/quest_story_13225490","episode":"ep3","category":"quest_story","story_id":"13225490","schema_version":1,"lang":"en","texts":{"say:0:1322549001:0":{"text":"Damn it, they're gone!","source_cn":"可恶，让邪教徒溜走了！","status":"matched","hash_xxh64":"0x1B2ADE67106F8B98","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322549002:0":{"text":"No way we're letting them get away! Let's catch up!","source_cn":"追上去！才不会让他们跑掉呢！","status":"matched","hash_xxh64":"0xEBD85F5FE382B85A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep3/quest_story/13225500.json":{"asset_key":"ep3/quest_story_13225500","episode":"ep3","category":"quest_story","story_id":"13225500","schema_version":1,"lang":"en","texts":{"say:0:1322550001:0":{"text":"You think you can just walk off? Not on Sir Chippy's watch!","source_cn":"站住！你们别想再从骑士满满手里跑掉！","status":"matched","hash_xxh64":"0x1A451C12C3BD517B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep3/quest_story/13225510.json":{"asset_key":"ep3/quest_story_13225510","episode":"ep3","category":"quest_story","story_id":"13225510","schema_version":1,"lang":"en","texts":{"say:1:1322551001:1":{"text":"You... You sinners! How dare you try to stop us from communicating with the spirits? The Great Will shall punish you for this!","source_cn":"你……你们这些罪人，居然敢阻止我们和灵魂沟通“降灵”！...","status":"matched","hash_xxh64":"0x79FB9140D06FF46D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322551002:1":{"text":"Great Will, please, bring your wrath upon those who've harmed your loyal servants!","source_cn":"伟大意志啊！请求您降罪于这些伤害您忠诚信徒的人！","status":"matched","hash_xxh64":"0xFFE32BB3151DACEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322551003:1":{"text":"Looks like they're not interested in talking... Let's just escort them back.","source_cn":"看来和他们是无法正常沟通的……咱们还是把这些人押回去吧。","status":"matched","hash_xxh64":"0xC5EDF8993E010AF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:顽固的邪教徒":{"text":"Stubborn Cultist","source":"顽固的邪教徒","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}},"locales/en/ep3/quest_story/13225520.json":{"asset_key":"ep3/quest_story_13225520","episode":"ep3","category":"quest_story","story_id":"13225520","schema_version":1,"lang":"en","texts":{"say:1:1322552001:1":{"text":"I'll make sure they're locked up, and I'll have the temple come to purify and counsel them.","source_cn":"我会马上将这些邪教徒关押进监狱，并且请教会的人来做净化...","status":"matched","hash_xxh64":"0x5C9957EA3EF43F5B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322552002:1":{"text":"It'll take a while, but at least they won't be causing any more trouble.","source_cn":"虽然辅导的过程非常漫长……但至少这群人不会再乱跑造成混乱了。","status":"matched","hash_xxh64":"0x462B68BD005CCCE6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322552003:1":{"text":"Thank you for all your help. Without you, we'd have a real mess on our hands trying to keep things in order here.","source_cn":"感谢您的协助。如果没有您，我们真的很难在这么短的时间内...","status":"matched","hash_xxh64":"0xB57E58A1A60D0A13","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:侍卫长罗德里戈":{"text":"Captain Rodrigo","source":"侍卫长罗德里戈","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}}}