","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322138003:1":{"text":"女神様が私たちを守ってくださいます。","source_cn":"女神会保佑我们的。","status":"matched","hash_xxh64":"0x7EE38C391F6B2D00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322138004:1":{"text":"ええ、もちろんです。案内をお願いします、カレリーナさん。","source_cn":"我对此坚信不疑。卡列琳娜女士，请您带路吧。","status":"matched","hash_xxh64":"0xC608EC6B6C8C8285","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修士奥格列":{"text":"修道士のオグレ","source":"修士奥格列","status":"matched_dialogue_flow"},"speaker:修士马克西姆":{"text":"修道士のマクシム","source":"修士马克西姆","status":"matched_dialogue_flow"},"speaker:卡列琳娜":{"text":"カレリーナ","source":"卡列琳娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":3}},"locales/jp/ep3/quest_story/13221400.json":{"asset_key":"ep3/quest_story_13221400","episode":"ep3","category":"quest_story","story_id":"13221400","schema_version":1,"lang":"jp","texts":{"say:1:1322140001:1":{"text":"これが最後の戦いだ！平和と静寂へ続く、魂の戦いだ！","source_cn":"这是最后一场战斗！一场通往和平与宁静的灵魂之战！","status":"matched","hash_xxh64":"0xF51220CB3C4CA407","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322140002:0":{"text":"集まれ、我が戦士たちよ！","source_cn":"我的战士们，集合吧！","status":"matched","hash_xxh64":"0xEEB9FD9E06A49BC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","documen