{"schema_version":1,"resources":{"easter_eggs/menus/10020401_1_1.en.json":{"schema_version":1,"asset_key":"easter_eggs/menu_10020401:1:1","lang":"en","texts":{"menu:41766430:1":{"text":"Just a couple of gruglins. Nothing to be scared of!","source_cn":"不过是几只咕布林，没什么好怕的！","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:村民-可莉娅":{"text":"Coralia","source":"村民-可莉娅","status":"exact_hash"}}},"easter_eggs/menus/10020401_1_4.en.json":{"schema_version":1,"asset_key":"easter_eggs/menu_10020401:1:4","lang":"en","texts":{"menu:41766480:1":{"text":"Thank you for your help.","source_cn":"多谢你出手相助。","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:薄暮队员-德兰克":{"text":"Patroller Dylan","source":"薄暮队员-德兰克","status":"exact_hash"}}},"locales/en/mn2/gameplay_story/10604020.json":{"asset_key":"mn2/gameplay_story_10604020","episode":"mn2","category":"gameplay_story","story_id":"10604020","schema_version":1,"lang":"en","texts":{"say:1:1060402001:1":{"text":"Stay away from the camp ahead, sir. There's a lot of gruglins!","source_cn":"<male>哥哥</male><female>姐姐</...","status":"matched_runtime_gender","hash_xxh64":"0x85455AA1A57070FB","variant_status":"runtime_gender_keys_target_differs","male":"Stay away from the camp ahead, sir. There's a lot of gruglins!","female":"Stay away from the camp ahead, miss. There's a lot of gruglins!","variant_male_record_index":"109718","variant_female_record_index":"109719","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1060402002:1":{"text":"The Dusk Patrollers are out there, but it's just the two of them up against a horde of gruglins. I wonder how much time they'll need to clear those gruglins...","source_cn":"薄暮的哥哥姐姐已经过去了。不过他们只有两个人，咕布林倒...","status":"matched","hash_xxh64":"0x25F6176CDB7199EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1060402003:1":{"text":"You could wait right here if you're not on something urgent. When they are back, you'll be safe to enter the camp!","source_cn":"你要是不着急，就在这里等他们回来吧，到时候就安全了！","status":"matched","hash_xxh64":"0x5C05D4359225F9AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:村民可莉娅":{"text":"Coralia","source":"村民可莉娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}},"locales/en/mn2/gameplay_story/10604030.json":{"asset_key":"mn2/gameplay_story_10604030","episode":"mn2","category":"gameplay_story","story_id":"10604030","schema_version":1,"lang":"en","texts":{"say:0:1060403001:0":{"text":"This is bad... There're way too many gruglins!","source_cn":"不行……咕布林太多了！","status":"matched","hash_xxh64":"0xFAAEDC7094451E4A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1060403002:0":{"text":"The Patrol Squad is coming. Hang on just a little bit longer!","source_cn":"巡逻队快来了，再撑一下！","status":"matched","hash_xxh64":"0x0A62F8E867CAF731","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:薄暮队员艾丝特":{"text":"Patroller Esta","source":"薄暮队员艾丝特","status":"matched_dialogue_flow"},"speaker:薄暮队员德兰克":{"text":"Patroller Dylan","source":"薄暮队员德兰克","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/mn2/gameplay_story/10604040.json":{"asset_key":"mn2/gameplay_story_10604040","episode":"mn2","category":"gameplay_story","story_id":"10604040","schema_version":1,"lang":"en","texts":{"say:0:1060404001:0":{"text":"Are you alright, Esta?","source_cn":"艾丝特，还好吗？","status":"matched","hash_xxh64":"0x926571E66BABDA51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1060404002:0":{"text":"I'm fine... Just a little scratch.","source_cn":"一点小伤……没事的。","status":"matched","hash_xxh64":"0x2D807495F50FAA38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:薄暮队员德兰克":{"text":"Patroller Dylan","source":"薄暮队员德兰克","status":"matched_dialogue_flow"},"speaker:薄暮队员艾丝特":{"text":"Patroller Esta","source":"薄暮队员艾丝特","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/mn2/gameplay_story/10604050.json":{"asset_key":"mn2/gameplay_story_10604050","episode":"mn2","category":"gameplay_story","story_id":"10604050","schema_version":1,"lang":"en","texts":{"say:1:1060405001:1":{"text":"Sorry for such a mess.","source_cn":"让你看见这么狼狈的一面，真是抱歉。","status":"matched","hash_xxh64":"0xC13E67D226118201","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1060405002:1":{"text":"We should've known them better before we moved... Didn't know there were going to be so many of them.","source_cn":"是我们太轻敌了，没调查清楚就贸然行动……没想到这里居然...","status":"matched","hash_xxh64":"0x84C4E8B6F0F1C9FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1060405003:1":{"text":"Thank goodness you're here. We would've lost long ago if we had waited for the patrol to come.","source_cn":"幸好遇到了你。要是真的等到巡逻队过来，我们估计早就败下...","status":"matched","hash_xxh64":"0xA514531E9D6C3D0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1060405004:1":{"text":"Please take this little something as a thank-you gift.","source_cn":"这一点东西算是感谢，请你务必收下。","status":"matched","hash_xxh64":"0x421F026B7BD4D62B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:薄暮队员德兰克":{"text":"Patroller Dylan","source":"薄暮队员德兰克","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}}}