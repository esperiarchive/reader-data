":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"},"speaker:哈尔格":{"text":"하르그","source":"哈尔格","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":3}},"locales/kr/ep4/quest_story/14223090.json":{"asset_key":"ep4/quest_story_14223090","episode":"ep4","category":"quest_story","story_id":"14223090","schema_version":1,"lang":"kr","texts":{"say:3:1422309001:1":{"text":"프리다... 난 잘난 남편도, 아빠도 아니야...","source_cn":"弗瑞达……我不是一个称职的丈夫和父亲……","status":"matched","hash_xxh64":"0x546A5B44F763E8D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1422309002:1":{"text":"그치만 프리다는 당신을 원망하지 않았어요.","source_cn":"可是弗瑞达并没有埋怨你呀？","status":"matched","hash_xxh64":"0x1FFFB81B9B09F422","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1422309003:1":{"text":"지금까지 전 제 포부와 심정만 생각했어요. 지금처럼 집 문 앞까지 와서도 우스꽝스러운 자존심을 버리지 못해서 가족들과 만날 엄두를 못 내고 있잖아요!","source_cn":"一直以来我只考虑自己的抱负和心情，就像现在，哪怕在家门...","status":"matched","hash_xxh64":"0x89400EFC1542F168","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1422309004:1":{"text":"가족들에게 쓸데없는 걱정은 많이 끼쳤지만 가족들에게 필요한 건 외적인 부와 명예가 아니라 가족과 함께하는 것이라는 건 미처 생각하지 못했네요...","source_cn":"我让她们增加了那么多无谓的担心，却从没想过，她们需要的...","status":"matched","hash_xxh64":"0xACCF3F25EDC3D90E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1422309005:1":{"text":"결정했어요. 집으로 돌아가서 가족들을 만나야겠어요!","source_cn":"我决定了，我要回家见她们！","status":"matched","hash_xxh64":"0x106A35F7028ECA5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1422309006:1":{"text":"깨달으셨다니 정말 다행이에요! 가족들이 당신을 보면 분명 기뻐할 거예요.","source_cn":"你能想通真是太好啦！她们见到你一定会很高兴的。","status":"matched","hash_xxh64":"0xBF29A09A55258AF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1422309007:1":{"text":"마침 오늘 밤 프리다가 저희를 저녁 식사에 초대했어요. 아주 푸짐한 식사를 준비한대요.","source_cn":"刚好今天晚上弗瑞达邀请我们去吃晚饭，她说会准备一顿丰盛...","status":"matched","hash_xxh64":"0x2C82606F81BAC058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1422309008:1":{"text":"저녁 식사 때쯤 하르그가 갑자기 나타난다면 분명 깜짝 놀랄 거예요!","source_cn":"如果在晚餐时分哈尔格突然出现，她们一定会很惊喜！","status":"matched","hash_xxh64":"0xF57D9EF23DB741F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1422309009:0":{"text":"가족들을 만나기 전에 준비하고 싶은 게 있어요... 사실 프리다와 탈리에게 제가 직접 만든 류트를 선물하려고요.","source_cn