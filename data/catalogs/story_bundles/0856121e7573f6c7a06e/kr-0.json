ariant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:格温妮丝":{"text":"귀네스","source":"格温妮丝","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/kr/ep7/quest_story/17216110.json":{"asset_key":"ep7/quest_story_17216110","episode":"ep7","category":"quest_story","story_id":"17216110","schema_version":1,"lang":"kr","texts":{"say:1:1721611001:1":{"text":"귀네스! 당신이 먼저 부를 줄이야! 근위대 분대장이 된 이후로 얼굴 보기가 정말 힘들었잖아요!","source_cn":"格温妮丝！真没想到你会主动约我们！自从你当了守备军的队...","status":"matched","hash_xxh64":"0x75EB3A9E3B7E9B03","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1721611002:1":{"text":"지난번 꽃놀이에도 오지 않았고... 다들 당신을 사바나에서 만나기 제일 힘든 사람이라고 말하고 있어요.","source_cn":"上次的花卉鉴赏你也没来，大家都说你现在可是赛凡纳最难请...","status":"matched","hash_xxh64":"0x4E19A4C9B3C30F8D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1721611003:2":{"text":"미안해요, 캐서린. 저도 정말 보고 싶었어요. 하지만 근위대 일이 너무 바빠서...","source_cn":"抱歉，凯瑟琳，我也很想念大家。只是，军务确实繁重……","status":"matched","hash_xxh64":"0x0F00808AAC88895E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1721611004:1":{"text":"흠, 근위대 일이라니. 정말 이해가 안 가네요. 귀족 영애의 신분으로 굳이 남자들 틈에서...","source_cn":"哼，军务。亲爱的，我真是不明白，你放着好好的贵族小姐不...","status":"matched","hash_xxh64":"0x68F2250C753AE637","variant_status":"","male":"","female":"","variant_ma