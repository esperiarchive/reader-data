ocument_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211101005:0":{"text":"怖いのか？","source_cn":"你害怕了？","status":"matched","hash_xxh64":"0x31C39BB52794D29C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1211101006:0":{"text":"んなバカな。","source_cn":"我可没有。","status":"matched","hash_xxh64":"0x0EFF3C4A87FCE4E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1211101007:0":{"text":"手が震えてるぞ。","source_cn":"可你的手在发抖。","status":"matched","hash_xxh64":"0x90C270B1C24429FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1211101008:0":{"text":"こんな霧が怖いの？シンドバッドの臆病者！","source_cn":"这都怕？辛巴达是胆小鬼！","status":"matched","hash_xxh64":"0xDE0890EFD8AB86E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1211101009:0":{"text":"シンドバッド、舵を取れ。あたしが補佐をする。","source_cn":"辛巴达，你来掌舵，我给你当副手。","status":"matched","hash_xxh64":"0x4AB0EC12CC3F533A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1211101010:0":{"text":"あんたが？","source_cn":"你要当副手？","status":"matched","hash_xxh64":"0xF4DB32BA824C780E","variant_status":"","male":"","female":"","variant_male_re