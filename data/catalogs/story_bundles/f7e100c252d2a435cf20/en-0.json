{"schema_version":1,"resources":{"locales/en/ep2/quest_story/12110340.json":{"asset_key":"ep2/quest_story_12110340","episode":"ep2","category":"quest_story","story_id":"12110340","schema_version":1,"lang":"en","texts":{"say:1:1211034001:0":{"text":"Now we have all three keys. I wonder what kind of treasure we'll find. What are you all hoping for?","source_cn":"三把钥匙齐活啦，不知道能获得怎样的宝物，你们几个都想要...","status":"matched","hash_xxh64":"0xC2C9D479EF7CCCDC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1211034002:1":{"text":"What I want, no one can give me.","source_cn":"我想要的东西，神明不可能给我。","status":"matched","hash_xxh64":"0xED9D944E2D595774","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211034003:0":{"text":"I want to be with my sister forever, but I already have that.","source_cn":"我想和姐姐永远在一起，但我已经得到了！","status":"matched","hash_xxh64":"0xC99FA36AAF4D640E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211034004:0":{"text":"Nara...","source_cn":"奈拉……","status":"matched","hash_xxh64":"0xB6B306E1058EF939","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1211034005:0":{"text":"Chippy doesn't have anything he wants. Chippy just wants the magister to get his memories and powers back.","source_cn":"我没什么想要的，我只想主人找回属于自己的记忆和力量。","status":"matched_runtime_gender","hash_xxh64":"0x59CAF25663E0007D","variant_status":"runtime_gender_keys_target_differs","male":"Chippy doesn't have anything he wants. Chippy just wants the magister to get his memories and powers back.","female":"Chippy doesn't have anything he wants. Chippy just wants the magister to get her memories and powers back.","variant_male_record_index":"131014","variant_female_record_index":"131015","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1211034006:0":{"text":"Chippy is so sly...","source_cn":"满满真狡猾……","status":"matched","hash_xxh64":"0xBC5ABF9770801DDC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1211034007:0":{"text":"Huh? What did Chippy say?","source_cn":"诶，为什么？","status":"matched","hash_xxh64":"0x87DA691631941B84","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1211034008:1":{"text":"Because this makes my wish seem very selfish. I just want to be Merlin's most beloved familiar.","source_cn":"因为、因为这样会显得我的愿望很自私。因为我想成为梅林最...","status":"matched_runtime_gender","hash_xxh64":"0x503F46EC81EE2D4B","variant_status":"runtime_gender_keys_target_same","male":"Because this makes my wish seem very selfish. I just want to be Merlin's most beloved familiar.","female":"Because this makes my wish seem very selfish. I just want to be Merlin's most beloved familiar.","variant_male_record_index":"131018","variant_female_record_index":"131019","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1211034009:0":{"text":"Merlin, what do you want?","source_cn":"梅林，你想要什么呢？","status":"matched_runtime_gender","hash_xxh64":"0x401CDD85AB06A4D2","variant_status":"runtime_gender_keys_target_same","male":"Merlin, what do you want?","female":"Merlin, what do you want?","variant_male_record_index":"131020","variant_female_record_index":"131021","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:15:1211034010":{"text":"I understand that. I want a mountain of gold!","source_cn":"梅林，你想要什么呢？","status":"matched_runtime_gender","hash_xxh64":"0xEA263B0C8F93D9C3","variant_status":"runtime_gender_keys_target_same","male":"I understand that. I want a mountain of gold!","female":"I understand that. I want a mountain of gold!","variant_male_record_index":"131022","variant_female_record_index":"131023","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1211034010:0":{"text":"I understand that. I want a mountain of gold!","source_cn":"我懂，最好是堆积如山的黄金！","status":"matched_runtime_gender","hash_xxh64":"0xEA263B0C8F93D9C3","variant_status":"runtime_gender_keys_target_same","male":"I understand that. I want a mountain of gold!","female":"I understand that. I want a mountain of gold!","variant_male_record_index":"131022","variant_female_record_index":"131023","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1211034013:0":{"text":"We should go back to the island where we started and put the keys back on the stone tablet.","source_cn":"接下来，是不是该回到一开始的小岛，将石板放回石碑上？","status":"matched","hash_xxh64":"0xC5858AF30346DB33","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1211034014:0":{"text":"That's right. We need the boat. It's anchored next to the treasure chest that was a trap before. Let's go.","source_cn":"没错，要回去的话得坐船，船还停在陷阱宝箱那里。走吧！","status":"matched","hash_xxh64":"0x6632D62F8EADD0F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:15:0:1":{"text":"I want some treasure.","source_cn":"想要财宝","status":"matched_runtime_gender","hash_xxh64":"0xBB1F9DF7C722CF4D","variant_status":"runtime_gender_keys_target_same","male":"I want some treasure.","female":"I want some treasure.","variant_male_record_index":"65834","variant_female_record_index":"65835","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1211034011:0":{"text":"Power and strength? Those are nice, I guess, but a bit boring.","source_cn":"力量……和权力？那些是不错，但是没意思。","status":"matched_runtime_gender","hash_xxh64":"0x7C57FE947F9CCF33","variant_status":"runtime_gender_keys_target_same","male":"Power and strength? Those are nice, I guess, but a bit boring.","female":"Power and strength? Those are nice, I guess, but a bit boring.","variant_male_record_index":"131024","variant_female_record_index":"131025","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:15:1:2":{"text":"I want to be stronger.","source_cn":"想要变强的方法","status":"matched_runtime_gender","hash_xxh64":"0xF1EC187B4CE2EBC8","variant_status":"runtime_gender_keys_target_same","male":"I want to be stronger.","female":"I want to be stronger.","variant_male_record_index":"65836","variant_female_record_index":"65837","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1211034012:0":{"text":"Just hold on a little bit longer. We get the treasure, and then we'll head right back to Rustport.","source_cn":"坚持坚持嘛，先拿到宝藏，再想办法回锈锚港。","status":"matched_runtime_gender","hash_xxh64":"0x4D95C2B00B744E77","variant_status":"runtime_gender_keys_target_same","male":"Just hold on a little bit longer. We get the treasure, and then we'll head right back to Rustport.","female":"Just hold on a little bit longer. We get the treasure, and then we'll head right back to Rustport.","variant_male_record_index":"131026","variant_female_record_index":"131027","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:15:2:3":{"text":"I just want to rest.","source_cn":"累了，只想休息","status":"matched_runtime_gender","hash_xxh64":"0x9C229626E58B7581","variant_status":"runtime_gender_keys_target_same","male":"I just want to rest.","female":"I just want to rest.","variant_male_record_index":"65838","variant_female_record_index":"65839","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":19,"localized_text_count":18,"speaker_count":5}},"locales/en/ep2/quest_story/12111010.json":{"asset_key":"ep2/quest_story_12111010","episode":"ep2","category":"quest_story","story_id":"12111010","schema_version":1,"lang":"en","texts":{"say:3:1211101001:0":{"text":"Sinbad, what's wrong?","source_cn":"辛巴达，怎么不往前走了？","status":"matched","hash_xxh64":"0x6478A3036D1330C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211101002:0":{"text":"It's so foggy... How about we wait a bit before setting sail?","source_cn":"好浓的雾啊……要不，咱们还是晚点再出海吧？","status":"matched","hash_xxh64":"0x0BB13B96823DC12A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211101003:0":{"text":"This is nothing compared to the fog in Rustport.","source_cn":"与锈锚港附近的浓雾相比，这里的天气不算恶劣。","status":"matched","hash_xxh64":"0x7259B85DCD58A685","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211101004:0":{"text":"R-Right... But what I'm saying is, since we've come this far, it's better to play it safe.","source_cn":"我、我知道……但我的意思是，都到这一步了，小心驶得万年船嘛。","status":"matched","hash_xxh64":"0xFA0E6EBC2A399F80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211101005:0":{"text":"Are you scared?","source_cn":"你害怕了？","status":"matched","hash_xxh64":"0x31C39BB52794D29C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1211101006:0":{"text":"Of course not.","source_cn":"我可没有。","status":"matched","hash_xxh64":"0x0EFF3C4A87FCE4E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1211101007:0":{"text":"Then why are you shaking?","source_cn":"可你的手在发抖。","status":"matched","hash_xxh64":"0x90C270B1C24429FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1211101008:0":{"text":"Hah! Sinbad, you're as spineless as a jellyfish!","source_cn":"这都怕？辛巴达是胆小鬼！","status":"matched","hash_xxh64":"0xDE0890EFD8AB86E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1211101009:0":{"text":"Sinbad, how about you steer the boat, and I'll be your first mate?","source_cn":"辛巴达，你来掌舵，我给你当副手。","status":"matched","hash_xxh64":"0x4AB0EC12CC3F533A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1211101010:0":{"text":"You wanna be the first mate?","source_cn":"你要当副手？","status":"matched","hash_xxh64":"0xF4DB32BA824C780E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1211101011:0":{"text":"Uh-huh. I'll see to any trouble we run into on the high seas.","source_cn":"是啊，如果航行中遇到了敌人，我来应付。","status":"matched","hash_xxh64":"0x3C21C7FE7B2C98B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1211101012:0":{"text":"I mean... I never thought you would be willing to be my first mate.","source_cn":"我的意思是……你竟然愿意给我当副手。","status":"matched","hash_xxh64":"0x54F82658DB72F2DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1211101013:0":{"text":"Don't make a big deal out of it. I'm just in the mood to change things up a bit.","source_cn":"别想太多了。我只是心血来潮，想陪你玩玩扮演船长的游戏。","status":"matched","hash_xxh64":"0xD11A7230E75F20F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1211101014:0":{"text":"Besides, you've been acting like quite the captain on this journey.","source_cn":"这一路上，你不是很有船长的风范吗？","status":"matched","hash_xxh64":"0xF1CB8A8E6FEDC0C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1211101015:0":{"text":"Do you really think I could be a good captain...?","source_cn":"船长……我真的能当船长吗？","status":"matched","hash_xxh64":"0xD46AA2256A4F26AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1211101015":{"text":"Do you really think I could be a good captain...?","source_cn":"船长……我真的能当船长吗？","status":"matched","hash_xxh64":"0xD46AA2256A4F26AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1211101016:0":{"text":"Well, if you say so... Guess I'll give it a go then.","source_cn":"是吗，既然你都这么说了。","status":"matched_runtime_gender","hash_xxh64":"0x013BD273600461E6","variant_status":"runtime_gender_keys_target_same","male":"Well, if you say so... Guess I'll give it a go then.","female":"Well, if you say so... Guess I'll give it a go then.","variant_male_record_index":"131486","variant_female_record_index":"131487","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1211101019:0":{"text":"Argh, no more delays! Let's set sail!","source_cn":"好……我准备好了。","status":"matched","hash_xxh64":"0xBF20955038160874","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1211101020:0":{"text":"All hands on deck! From now on, you must all follow Captain Sinbad's orders! Ha!","source_cn":"水手们！从现在起，要听辛巴达船长的号令！","status":"matched","hash_xxh64":"0xE131DD9AC766D259","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1211101021:0":{"text":"Let's plow through the fog and sail straight to the treasure!","source_cn":"我们要冲破迷雾！抵达宝藏的所在！","status":"matched","hash_xxh64":"0xA0CE1CE3814F145A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:0:1":{"text":"Of course!","source_cn":"你能当好船长","status":"matched_runtime_gender","hash_xxh64":"0x4761354B77F2D020","variant_status":"runtime_gender_keys_target_same","male":"Of course!","female":"Of course!","variant_male_record_index":"65918","variant_female_record_index":"65919","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1211101017:0":{"text":"Aye, I know... I'm still miles away from being a true captain.","source_cn":"是啊……我知道，和一位真正的船长相比，我还差得远呢。","status":"matched_runtime_gender","hash_xxh64":"0x9B8806F863CE1FCC","variant_status":"runtime_gender_keys_target_same","male":"Aye, I know... I'm still miles away from being a true captain.","female":"Aye, I know... I'm still miles away from being a true captain.","variant_male_record_index":"131488","variant_female_record_index":"131489","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1211101018:0":{"text":"And if I keep dragging my feet...","source_cn":"所以，如果我迟迟不能迈出第一步的话——","status":"matched_runtime_gender","hash_xxh64":"0x1A63E32BF2F98784","variant_status":"runtime_gender_keys_target_same","male":"And if I keep dragging my feet...","female":"And if I keep dragging my feet...","variant_male_record_index":"131490","variant_female_record_index":"131491","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:1:2":{"text":"You have a long way to go.","source_cn":"你还需要成长","status":"matched_runtime_gender","hash_xxh64":"0x7498FBF8E66A2B2E","variant_status":"runtime_gender_keys_target_same","male":"You have a long way to go.","female":"You have a long way to go.","variant_male_record_index":"65920","variant_female_record_index":"65921","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"Nara","sour