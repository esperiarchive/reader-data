lang":"en","texts":{"say:1:1322501001:1":{"text":"We've been getting reports about a pack of wolves hanging around the monument in the Floral Ruins.","source_cn":"近期接到镇民的举报，遗迹花海的战士冢出现了狼群。","status":"matched_runtime_gender","hash_xxh64":"0x97BA2D2D9DE41645","variant_status":"runtime_gender_keys_target_same","male":"We've been getting reports about a pack of wolves hanging around the monument in the Floral Ruins.","female":"We've been getting reports about a pack of wolves hanging around the monument in the Floral Ruins.","variant_male_record_index":"151790","variant_female_record_index":"151791","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322501002:1":{"text":"They're not just threatening the safety of villagers. They've even been digging up the graves, scattering relics all over the place.","source_cn":"不但对镇民造成威胁，还将战士冢埋葬的遗物翻倒出来，散落...","status":"matched_runtime_gender","hash_xxh64":"0xE94FCA9DA97FFFCF","variant_status":"runtime_gender_keys_target_same","male":"They're not just threatening the safety of villagers. They've even been digging up the graves, scattering relics all over the place.","female":"They're not just threatening the safety of villagers. They've even been digging up the graves, scattering relics all over the place.","variant_male_record_index":"151792","variant_female_record_index":"151793","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322501003:1":{"text":"It's been a few days, but we haven't had the manpower to deal with it. Could you take care of it?","source_cn":"这件事搁置几天了，实在腾不出人手，能拜托您前去处理吗？","status":"matched_runtime_gender","hash_xxh64":"0xE183F4C1F41BFC08","variant_status":"runtime_gender_keys_target_same","male":"It's been a few days, but we haven't had the manpower to deal with it. Could you take care of it?","female":"It's been a few days, but we haven't had the manpower to deal with it. Could you take care of it?","variant_male_record_index":"151794","variant_female_record_index":"151795","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:侍卫长罗德里戈":{"text":"Captain Rodrigo","source":"侍卫长罗德里戈","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}},"locales/en/ep3/quest_story/13225020.json":{"asset_key":"ep3/quest_story_13225020","episode":"ep3","category":"quest_story","story_id":"13225020","schema_version":1,"lang":"en","texts":{"say:1:1322502001:0":{"text":"Magister, I see those wolves!","source_cn":"主人！我看到狼群了！","status":"matched_runtime_gender","hash_xxh64":"0xF392B169F20847DC","variant_status":"runtime_gender_keys_target_same","male":"Magister, I see those wolves!","female":"Magister, I see those wolves!","variant_male_record_index":"151796","variant_female_record_index":"151797","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep3/quest_story/13225030.json":{"asset_key":"ep3/quest_story_13225030","episode":"ep3","category":"quest_story","story_id":"13225030","schema_version":1,"lang":"en","texts":{"say:0:1322503001:0":{"text":"Why are they still here?","source_cn":"为什么这群狼还没有逃走？","status":"matched","hash_xxh64":"0x54DF6468BB3B75BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322503002:0":{"text":"There must be a wolf king nearby!","source_cn":"狼王！附近一定有狼王！","status":"matched","hash_xxh64":"0xBC835C159972CB16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep3/quest_story/13225040.json":{"asset_key":"ep3/quest_story_13225040","episode":"ep3","category":"quest_story","story_id":"13225040","schema_version":1,"lang":"en","texts":{"say:1:1322504001:0":{"text":"Magister! Look at that one with the swagger. Definitely the leader of the pack!","source_cn":"主人！那头狼趾高气昂的，一定是狼王！","status":"matched_runtime_gender","hash_xxh64":"0x0E57C1A2A8CD60A7","variant_status":"runtime_gender_keys_target_same","male":"Magister! Look at that one with the swagger. Definitely the leader of the pack!","female":"Magister! Look at that one with the swagger. Definitely the leader of the pack!","variant_male_record_index":"151800","variant_female_record_index":"151801","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep3/quest_story/13225050.json":{"asset_key":"ep3/quest_story_13225050","episode":"ep3","category":"quest_story","story_id":"13225050","schema_version":1,"lang":"en","texts":{"say:0:1322505001:0":{"text":"These damn beasts! They've torn up the graves and thrown the weapons and armor around.","source_cn":"这群讨厌的野兽，将逝者墓穴中的武器和盔甲翻倒一地。","status":"matched","hash_xxh64":"0x07083E1A80433F2A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322505002:0":{"text":"Alright. Let's split up and start collecting whatever we can!","source_cn":"没办法，我们分头捡一下吧！","status":"matched","hash_xxh64":"0x20DF53E470D126B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep3/quest_story/13225060.json":{"asset_key":"ep3/quest_story_13225060","episode":"ep3","category":"quest_story","story_id":"13225060","schema_version":1,"lang":"en","texts":{"say:0:1322506001:0":{"text":"Phew, these are heavy! But I think we've got everything, right?","source_cn":"嘿咻！好重……应该差不多全捡到了吧。","status":"matched","hash_xxh64":"0x70F75C968A80CBCF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322506002:0":{"text":"Magister, over here! You've got to see this!","source_cn":"主人！这边！你们快来呀！","status":"matched_runtime_gender","hash_xxh64":"0x85D352CE87951786","variant_status":"runtime_gender_keys_target_same","male":"Magister, over here! You've got to see this!","female":"Magister, over here! You've got to see this!","variant_male_record_index":"151805","variant_female_record_index":"151806","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep3/quest_story/13225070.json":{"asset_key":"ep3/quest_story_13225070","episode":"ep3","category":"quest_story","story_id":"13225070","schema_version":1,"lang":"en","texts":{"say:1:1322507001:1":{"text":"Magister, look! This is where the wolves wreaked havoc!","source_cn":"主人，看！满满找到了狼群翻掏的战士墓冢！","status":"matched","hash_xxh64":"0x1F1FE30681EF7D1A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322507002:1":{"text":"Let's return these weapons and armor to the graves. The fallen deserve their rest.","source_cn":"我们想办法把这些武器和盔甲按照原样放回去吧，这样逝者才...","status":"matched","hash_xxh64":"0x88F2E480C600FDB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep3/quest_story/13225080.json":{"asset_key":"ep3/quest_story_13225080","episode":"ep3","category":"quest_story","story_id":"13225080","schema_version":1,"lang":"en","texts":{"say:0:1322508001:0":{"text":"Done! We've put everything back in place!","source_cn":"好耶！我们按照原样放回去了！","status":"matched","hash_xxh64":"0xE149E22AEABFABC5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322508002:0":{"text":"Now, let's head back and report to Rodrigo. He's waiting for us.","source_cn":"回去告诉罗德里戈吧，他还在等我们。","status":"matched","hash_xxh64":"0x627F1FA969EDD205","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep3/quest_story/13225090.json":{"asset_key":"ep3/quest_story_13225090","episode":"ep3","category":"quest_story","story_id":"13225090","schema_version":1,"lang":"en","texts":{"say:1:1322509001:1":{"text":"Thanks for helping out.","source_cn":"十分感激你们的协助。","status":"matched_runtime_gender","hash_xxh64":"0x76FCBEFA9176C38C","variant_status":"runtime_gender_keys_target_same","male":"Thanks for helping out.","female":"Thanks for helping out.","variant_male_record_index":"151811","variant_female_record_index":"151812","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322509002:1":{"text":"Now that the wolf king's been defeated, the pack will likely keep their distance for a while.","source_cn":"狼王被击败，相信短时内狼群不会再出现了。","status":"matched_runtime_gender","hash_xxh64":"0xC41F265CDFC0F2DF","variant_status":"runtime_gender_keys_target_same","male":"Now that the wolf king's been defeated, the pack will likely keep their distance for a while.","female":"Now that the wolf king's been defeated, the pack will likely keep their distance for a while.","variant_male_record_index":"151813","variant_female_record_index":"151814","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322509003:1":{"text":"The heroes can rest in peace now.","source_cn":"我们也不用再担心这些野兽会去打扰逝去英雄的安宁了。","status":"matched_runtime_gender","hash_xxh64":"0x2D0873A58BCDFCAE","variant_status":"runtime_gender_keys_target_same","male":"The heroes can rest in peace now.","female":"The heroes can rest in peace now.","variant_male_record_index":"151815","variant_female_record_index":"151816","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:侍卫长罗德里戈":{"text":"Captain Rodrigo","source":"侍卫长罗德里戈","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}}}