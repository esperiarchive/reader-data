{"schema_version":1,"resources":{"faction_dailies/menus/14010513_1_3.en.json":{"schema_version":1,"asset_key":"faction_dailies/menu_14010513:1:3","lang":"en","texts":{"menu:508500093:1":{"text":"Are you here to ride the lift?","source_cn":"又来了个想坐升降机的人吗？","status":"exact_duplicate_same"}},"speakers":{"speaker:急躁的维修工":{"text":"Anxious Mechanic","source":"急躁的维修工","status":"exact_hash"}}},"faction_dailies/menus/14010513_1_6.en.json":{"schema_version":1,"asset_key":"faction_dailies/menu_14010513:1:6","lang":"en","texts":{"menu:508500093:2":{"text":"Is it really broken?","source_cn":"升降机真的坏了吗？","status":"exact_duplicate_same"}},"speakers":{"speaker:急躁的维修工":{"text":"Anxious Mechanic","source":"急躁的维修工","status":"exact_hash"}}},"locales/en/ep4/quest_story/14232220.json":{"asset_key":"ep4/quest_story_14232220","episode":"ep4","category":"quest_story","story_id":"14232220","schema_version":1,"lang":"en","texts":{"say:1:1423222001:0":{"text":"<style=\"stress\"><player_name></style>, I've received reports from some dwarves that the Onyx Lift is acting up.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xC1EE621AD6EEDE66","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, I've received reports from some dwarves that the Onyx Lift is acting up.","female":"<style=\"stress\"><player_name></style>, I've received reports from some dwarves that the Onyx Lift is acting up.","variant_male_record_index":"170702","variant_female_record_index":"170703","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423222002:0":{"text":"Could you take a look at the lift?","source_cn":"你能去看看那座升降机的情况吗？","status":"matched_runtime_gender","hash_xxh64":"0x2C6AD680D3B38C0E","variant_status":"runtime_gender_keys_target_same","male":"Could you take a look at the lift?","female":"Could you take a look at the lift?","variant_male_record_index":"170704","variant_female_record_index":"170705","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423222003:0":{"text":"We need to get it fixed quickly, so the production won't be disrupted.","source_cn":"希望问题能快点解决，不要耽误生产。","status":"matched","hash_xxh64":"0x8B40A97400E4A17A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:祖娅":{"text":"Zanie","source":"祖娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}},"locales/en/ep4/quest_story/14232230.json":{"asset_key":"ep4/quest_story_14232230","episode":"ep4","category":"quest_story","story_id":"14232230","schema_version":1,"lang":"en","texts":{"say:0:1423223001:0":{"text":"How come the lift seems perfectly fine to me...","source_cn":"怎么就我看不出升降机有什么问题……","status":"matched","hash_xxh64":"0x6FB105E4EC91C7C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:急躁的维修工":{"text":"Anxious Mechanic","source":"急躁的维修工","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14232240.json":{"asset_key":"ep4/quest_story_14232240","episode":"ep4","category":"quest_story","story_id":"14232240","schema_version":1,"lang":"en","texts":{"say:1:1423224001:0":{"text":"Sorry, the lift's out of order!","source_cn":"升降机坏啦，现在坐不了啦！","status":"matched","hash_xxh64":"0x16E2272DC1076F0B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423224002:0":{"text":"I can't see what's wrong with it, but they all say something's off!","source_cn":"虽然我不知道坏在哪了，但他们都说有问题！检查又检查不出来！","status":"matched","hash_xxh64":"0xB532F3D02AB76CF4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1423224002":{"text":"I can't see what's wrong with it, but they all say something's off!","source_cn":"虽然我不知道坏在哪了，但他们都说有问题！检查又检查不出来！","status":"matched","hash_xxh64":"0xB532F3D02AB76CF4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423224003:0":{"text":"Did Zanie send you here?","source_cn":"难道你就是祖娅找来的人……？","status":"matched_runtime_gender","hash_xxh64":"0x7D6590AA74A2A343","variant_status":"runtime_gender_keys_target_same","male":"Did Zanie send you here?","female":"Did Zanie send you here?","variant_male_record_index":"170710","variant_female_record_index":"170711","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423224004:0":{"text":"Why don't you get on the lift yourself? Maybe you'll figure out what's wrong.","source_cn":"你坐上升降机试验一下，看看它到底出什么问题啦？","status":"matched_runtime_gender","hash_xxh64":"0x276D1B4B7689B3A6","variant_status":"runtime_gender_keys_target_same","male":"Why don't you get on the lift yourself? Maybe you'll figure out what's wrong.","female":"Why don't you get on the lift yourself? Maybe you'll figure out what's wrong.","variant_male_record_index":"170712","variant_female_record_index":"170713","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"I'm not here to use the lift.","source_cn":"我不是来坐升降机的","status":"matched_runtime_gender","hash_xxh64":"0x6044037DFAE07AB8","variant_status":"runtime_gender_keys_target_same","male":"I'm not here to use the lift.","female":"I'm not here to use the lift.","variant_male_record_index":"74184","variant_female_record_index":"74185","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"I'm here to fix the lift.","source_cn":"我是来修升降机的","status":"matched_runtime_gender","hash_xxh64":"0x61C912AF1E702833","variant_status":"runtime_gender_keys_target_same","male":"I'm here to fix the lift.","female":"I'm here to fix the lift.","variant_male_record_index":"74186","variant_female_record_index":"74187","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:急躁的维修工":{"text":"Anxious Mechanic","source":"急躁的维修工","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":1}},"locales/en/ep4/quest_story/14232250.json":{"asset_key":"ep4/quest_story_14232250","episode":"ep4","category":"quest_story","story_id":"14232250","schema_version":1,"lang":"en","texts":{"say:0:1423225001:0":{"text":"It isn't responsive...","source_cn":"感觉有些卡顿……","status":"matched_runtime_gender","hash_xxh64":"0x84C4E58E558D979D","variant_status":"runtime_gender_keys_target_same","male":"It isn't responsive...","female":"It isn't responsive...","variant_male_record_index":"170714","variant_female_record_index":"170715","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:主角":{"text":"Player","source":"主角","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14232260.json":{"asset_key":"ep4/quest_story_14232260","episode":"ep4","category":"quest_story","story_id":"14232260","schema_version":1,"lang":"en","texts":{"say:1:1423226001:0":{"text":"So, how did it go? Notice anything weird?","source_cn":"怎么样，感觉出什么不对劲来没有？","status":"matched_runtime_gender","hash_xxh64":"0x0313A4CC56D193B3","variant_status":"runtime_gender_keys_target_same","male":"So, how did it go? Notice anything weird?","female":"So, how did it go? Notice anything weird?","variant_male_record_index":"170716","variant_female_record_index":"170717","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1423226001":{"text":"So, how did it go? Notice anything weird?","source_cn":"怎么样，感觉出什么不对劲来没有？","status":"matched_runtime_gender","hash_xxh64":"0x0313A4CC56D193B3","variant_status":"runtime_gender_keys_target_same","male":"So, how did it go? Notice anything weird?","female":"So, how did it go? Notice anything weird?","variant_male_record_index":"170716","variant_female_record_index":"170717","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423226002:0":{"text":"I see. Maybe the bearings need some lubrication.","source_cn":"坏了，那看来是轴承缺油了。","status":"matched","hash_xxh64":"0x2A66101B0A087414","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423226003:0":{"text":"Mind catching some fish for me?","source_cn":"你能帮我钓两条鱼过来吗？","status":"matched_runtime_gender","hash_xxh64":"0x584DE5ABDFACFA9D","variant_status":"runtime_gender_keys_target_same","male":"Mind catching some fish for me?","female":"Mind catching some fish for me?","variant_male_record_index":"170719","variant_female_record_index":"170720","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1423226003":{"text":"Mind catching some fish for me?","source_cn":"你能帮我钓两条鱼过来吗？","status":"matched_runtime_gender","hash_xxh64":"0x584DE5ABDFACFA9D","variant_status":"runtime_gender_keys_target_same","male":"Mind catching some fish for me?","female":"Mind catching some fish for me?","variant_male_record_index":"170719","variant_female_record_index":"170720","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423226004:0":{"text":"I need the mucus on fish skin as a lubricant!","source_cn":"哎呀，不是！我是想要鱼表面滑滑的黏液！那可是上好的轴承...","status":"matched","hash_xxh64":"0x8D683176D2AC2A01","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423226005:0":{"text":"One Prism Trout and one Rainwraith would be great! Bring me the slipperiest ones you can find.","source_cn":"帮我钓一条染虹鳟和一条雨幽灵吧，最好是那种滑溜溜的，抓...","status":"matched_runtime_gender","hash_xxh64":"0x5A0AA05429575B13","variant_status":"runtime_gender_keys_target_same","male":"One Prism Trout and one Rainwraith would be great! Bring me the slipperiest ones you can find.","female":"One Prism Trout and one Rainwraith would be great! Bring me the slipperiest ones you can find.","variant_male_record_index":"170722","variant_female_record_index":"170723","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"Are you hungry?","source_cn":"你肚子饿了吗？","status":"matched_runtime_gender","hash_xxh64":"0xD063CDD2483A54B4","variant_status":"runtime_gender_keys_target_same","male":"Are you hungry?","female":"Are you hungry?","variant_male_record_index":"74190","variant_female_record_index":"74191","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:1:2":{"text":"You use fish to fix the lift?","source_cn":"鱼……会维修升降机？","status":"matched_runtime_gender","hash_xxh64":"0xE99512E50483CBD9","variant_status":"runtime_gender_keys_target_same","male":"You use fish to fix the lift?","female":"You use fish to fix the lift?","variant_male_record_index":"74192","variant_female_record_index":"74193","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"The controller is unresponsive.","source_cn":"地底的升降机控制器有些卡顿","status":"matched_runtime_gender","hash_xxh64":"0xBABC7EBBCB8387A9","variant_status":"runtime_gender_keys_target_same","male":"The controller is unresponsive.","female":"The controller is unresponsive.","variant_male_record_index":"74188","variant_female_record_index":"74189","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:急躁的维修工":{"text":"Anxious Mechanic","source":"急躁的维修工","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":1}},"locales/en/ep4/quest_story/14232270.json":{"asset_key":"ep4/quest_story_14232270","episode":"ep4","category":"quest_story","story_id":"14232270","schema_version":1,"lang":"en","texts":{"say:1:1423227001:0":{"text":"My fish...","source_cn":"我要的鱼……","status":"matched","hash_xxh64":"0x9267F3BC2C1B282C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1423227001":{"text":"My fish...","source_cn":"我要的鱼……","status":"matched","hash_xxh64":"0x9267F3BC2C1B282C","variant_status":"","male":"","female":"","variant_male_r