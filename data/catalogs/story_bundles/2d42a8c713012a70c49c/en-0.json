{"schema_version":1,"resources":{"easter_eggs/menus/14010324_1_1.en.json":{"schema_version":1,"asset_key":"easter_eggs/menu_14010324:1:1","lang":"en","texts":{"menu:7006220:2":{"text":"As long as it doesn't rain...","source_cn":"只要不下雨就好……","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:监工诺力":{"text":"Overseer Nol","source":"监工诺力","status":"exact_hash"}}},"easter_eggs/menus/14010324_1_3.en.json":{"schema_version":1,"asset_key":"easter_eggs/menu_14010324:1:3","lang":"en","texts":{"menu:7006220:3":{"text":"Ugh, this rain... I have the worst luck.","source_cn":"淋湿的是木材，倒霉的是我！","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:监工诺力":{"text":"Overseer Nol","source":"监工诺力","status":"exact_hash"}}},"locales/en/ep4/env_story/14301225.json":{"asset_key":"ep4/env_story_14301225","episode":"ep4","category":"env_story","story_id":"14301225","schema_version":1,"lang":"en","texts":{"say:1:1430122501:0":{"text":"I am on patrol, just like before, and praying to Helthor that it won't rain.","source_cn":"如之前一样在此巡查，同时向赫托祈祷不要下雨。","status":"matched","hash_xxh64":"0x06224F080974D8E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1430122501":{"text":"I am on patrol, just like before, and praying to Helthor that it won't rain.","source_cn":"如之前一样在此巡查，同时向赫托祈祷不要下雨。","status":"matched","hash_xxh64":"0x06224F080974D8E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1430122502:0":{"text":"Yeah, I heard a few things. People come to me from time to time and tell me what's going on.","source_cn":"我知道一些，这段时间不时有人跑来跟我透露过一些相关消息。","status":"matched","hash_xxh64":"0xA1D5A1C5D9E43115","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1430122503:0":{"text":"There's no point thinking about it. I just need to make sure these logs don't get wet.","source_cn":"但……对我而言想再多也没用，我能做的只有保证这些木头不...","status":"matched","hash_xxh64":"0xE19F8B039311DEBD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"About the village and underground...","source_cn":"你不知道村子和地下发生的事情吗？","status":"matched_runtime_gender","hash_xxh64":"0xD99AC18AED026E42","variant_status":"runtime_gender_keys_target_same","male":"About the village and underground...","female":"About the village and underground...","variant_male_record_index":"72276","variant_female_record_index":"72277","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:监工诺力":{"text":"Overseer Nol","source":"监工诺力","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":1}},"locales/en/ep4/env_story/14324010.json":{"asset_key":"ep4/env_story_14324010","episode":"ep4","category":"env_story","story_id":"14324010","schema_version":1,"lang":"en","texts":{"say:0:1432401001:0":{"text":"My precious lumber! It's getting soaked!","source_cn":"我的宝贝木材！要被雨淋坏了！","status":"matched","hash_xxh64":"0x67AFD7DA4C959AF6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:监工诺力":{"text":"Overseer Nol","source":"监工诺力","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/env_story/14324020.json":{"asset_key":"ep4/env_story_14324020","episode":"ep4","category":"env_story","story_id":"14324020","schema_version":1,"lang":"en","texts":{"say:1:1432402001:0":{"text":"I told them I needed funding to build a rain shelter! But nooo... Now it's pouring and everything's ruined.","source_cn":"我早就说该给我拨款修个雨棚，要不然一下雨这些木材都得完蛋！","status":"matched","hash_xxh64":"0xA953E7314BE404CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1432402002:0":{"text":"Great. Just great...","source_cn":"这下好了，完蛋的不光有木材，还有我！","status":"matched","hash_xxh64":"0xBE1317DBAC0E1F70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1432402003:0":{"text":"If only someone could help. Maybe cast a little spell or something... Ugh, I'm dreaming again, aren't I?","source_cn":"要是有人能帮帮我，施个魔法什么的……唉，我又在做梦了……","status":"matched","hash_xxh64":"0x87DB575F150B0DA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:监工诺力":{"text":"Overseer Nol","source":"监工诺力","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}},"locales/en/ep4/env_story/14324030.json":{"asset_key":"ep4/env_story_14324030","episode":"ep4","category":"env_story","story_id":"14324030","schema_version":1,"lang":"en","texts":{"say:1:1432403001:0":{"text":"What kind of magic is this?! The wood's dry now, and r