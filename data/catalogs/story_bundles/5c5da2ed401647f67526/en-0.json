{"schema_version":1,"resources":{"locales/en/ep1/quest_story/11235010.json":{"asset_key":"ep1/quest_story_11235010","episode":"ep1","category":"quest_story","story_id":"11235010","schema_version":1,"lang":"en","texts":{"say:0:1123501001:0":{"text":"Magister, is Hashir's new place safe? How's that stubborn old man doing these days?","source_cn":"主人，哈什尔的新住所安全吗？这个固执的老头子最近如何了？","status":"matched_runtime_gender","hash_xxh64":"0xC00B3792D305ACBB","variant_status":"runtime_gender_keys_target_same","male":"Magister, is Hashir's new place safe? How's that stubborn old man doing these days?","female":"Magister, is Hashir's new place safe? How's that stubborn old man doing these days?","variant_male_record_index":"126180","variant_female_record_index":"126181","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123501002:0":{"text":"It's almost time. Let's go ask Kruger.","source_cn":"时间也差不多了，我们去向克鲁格问问看吧。","status":"matched_runtime_gender","hash_xxh64":"0x7EEFF8430639E4DE","variant_status":"runtime_gender_keys_target_same","male":"It's almost time. Let's go ask Kruger.","female":"It's almost time. Let's go ask Kruger.","variant_male_record_index":"126182","variant_female_record_index":"126183","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:主角":{"text":"Player","source":"主角","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep1/quest_story/11235020.json":{"asset_key":"ep1/quest_story_11235020","episode":"ep1","category":"quest_story","story_id":"11235020","schema_version":1,"lang":"en","texts":{"say:1:1123502001:1":{"text":"Magister Merlin, I've got some good news here!","source_cn":"梅林大人，我这里有个好消息！","status":"matched_runtime_gender","hash_xxh64":"0x4FEE3EC4D4970FCC","variant_status":"runtime_gender_keys_target_same","male":"Magister Merlin, I've got some good news here!","female":"Magister Merlin, I've got some good news here!","variant_male_record_index":"126184","variant_female_record_index":"126185","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123502002:1":{"text":"I found Hashir's new place. I want to go talk to him.","source_cn":"我找到了哈什尔的新住处，并且已经决定要去和他谈谈。","status":"matched","hash_xxh64":"0x04426A8EB5766DFE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123502003:1":{"text":"Would you all go with me?","source_cn":"你们能陪同我一起过去看看吗？","status":"matched","hash_xxh64":"0xB7B1827749CBF311","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123502004:1":{"text":"You all have been taking care of him for a while. Perhaps things won't be so tense with you around.","source_cn":"一直以来都是你们在照顾他，也许你们在场的话，能缓和我和...","status":"matched","hash_xxh64":"0xBC7CBB539F162788","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1123502004":{"text":"You all have been taking care of him for a while. Perhaps things won't be so tense with you around.","source_cn":"一直以来都是你们在照顾他，也许你们在场的话，能缓和我和他之间的矛盾。","status":"matched","hash_xxh64":"0xBC7CBB539F162788","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123502005:1":{"text":"Thank you. You've been a great help.","source_cn":"谢谢，你帮我太多了。","status":"matched_runtime_gender","hash_xxh64":"0xF929E9E6464D2879","variant_status":"runtime_gender_keys_target_same","male":"Thank you. You've been a great help.","female":"Thank you. You've been a great help.","variant_male_record_index":"126189","variant_female_record_index":"126190","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123502007:1":{"text":"I'll remember your contribution to the Grimmaw Clan, my honored friends!","source_cn":"我会记得，尊贵朋友们为黑嚎氏族带来的贡献！","status":"matched","hash_xxh64":"0x607673DB4275A5B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"Of course.","source_cn":"（欣然答应）","status":"matched_runtime_gender","hash_xxh64":"0x5B0A1235C472D241","variant_status":"runtime_gender_keys_target_same","male":"Of course.","female":"Of course.","variant_male_record_index":"64464","variant_female_record_index":"64465","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123502006:1":{"text":"I know this goes against his wishes, but I can't just give up like this.","source_cn":"我知道这违背他的意愿，但我不能就这样放弃了。","status":"matched","hash_xxh64":"0x9D3B6B2C3F1A2AC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:1:2":{"text":"I guess...","source_cn":"（为难地点点头）","status":"matched_runtime_gender","hash_xxh64":"0xD81229D7D1E76C0C","variant_status":"runtime_gender_keys_target_same","male":"I guess...","female":"I guess...","variant_male_record_index":"64466","variant_female_record_index":"64467","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:克鲁格":{"text":"Kruger","source":"克鲁格","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":1}},"locales/en/ep1/quest_story/11235030.json":{"asset_key":"ep1/quest_story_11235030","episode":"ep1","category":"quest_story","story_id":"11235030","schema_version":1,"lang":"en","texts":{"say:0:1123503001:0":{"text":"<style=\"stress\"><player_name></style>... and Kruger...","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x58C952EE86F0F98B","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>... and Kruger...","female":"<style=\"stress\"><player_name></style>... and Kruger...","variant_male_record_index":"126193","variant_female_record_index":"126194","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep1/quest_story/11235040.json":{"asset_key":"ep1/quest_story_11235040","episode":"ep1","category":"quest_story","story_id":"11235040","schema_version":1,"lang":"en","texts":{"say:1:1123504001:1":{"text":"I thought I already made it pretty clear last time. It's important that we follow our traditions.","source_cn":"我以为上次的对话能让你明白，遵循传统是必要的。","status":"matched","hash_xxh64":"0x4457D575C4BB125E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123504002:1":{"text":"What are you doing here?! Are you here to watch me suffer as I follow traditions?! To humiliate me?!","source_cn":"你现在来做什么？来看我遵循传统的结果并羞辱我吗？","status":"matched","hash_xxh64":"0x03828D564DA923A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123504003:1":{"text":"None of us came with ill will. I just hope that you will return to where you belong. That is all.","source_cn":"没人是带着恶意来的。\\n我只是希望你能回到属于自己的地...","status":"matched","hash_xxh64":"0xF5F393CA8D68A60C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123504004:1":{"text":"I already am where I belong. These old bones will turn to dust and return to the desert.","source_cn":"我已经回到自己所属之地，并将化为沙漠中的白骨。","status":"matched","hash_xxh64":"0x1738DB7D5AC03632","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123504005:1":{"text":"Besides... I like it here. There was once an ironjaw that lived and died here. We share the same fate.","source_cn":"我很中意这里。这里曾有只钢颚兽并埋骨于此，多么相称的终途。","status":"matched","hash_xxh64":"0xA70B943A627FE770","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1123504005":{"text":"Besides... I like it here. There was once an ironjaw that lived and died here. We share the same fate.","source_cn":"我很中意这里。这里曾有只钢颚兽并埋骨于此，多么相称的终途。","status":"matched","hash_xxh64":"0xA70B943A627FE770","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123504006:1":{"text":"That's not for you to decide, <style=\"stress\"><player_name></style>!","source_cn":"你不能对此定义，<style=stress><play...","status":"matched_runtime_gender","hash_xxh64":"0xBBB62FF3135D319C","variant_status":"runtime_gender_keys_target_same","male":"That's not for you to decide, <style=\"stress\"><player_name></style>!","female":"That's not for you to decide, <style=\"stress\"><player_name></style>!","variant_male_record_index":"126200","variant_female_record_index":"126201","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123504007:1":{"text":"But Magister <style=\"stress\"><player_name></style>'s right. We'll only end up like Orson if we value power above all else...","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xEABE59333B53BE87","variant_status":"runtime_gender_keys_target_same","male":"But Magister <style=\"stress\"><player_name></style>'s right. We'll only end up like Orson if we value power above all else...","female":"But Magister <style=\"stress\"><player_name></style>'s right. We'll only end up like Orson if we value power above all else...","variant_male_record_index":"126202","variant_female_record_index":"126203","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123504009:1":{"text":"We need your wisdom, Hashir.","source_cn":"黑嚎氏族需要你的智慧，哈什尔。","status":"matched","hash_xxh64":"0x1F86AD26182609A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123504010:1":{"text":"Please come back with us. Many young warriors in our clan need your knowledge and insight... someone to help guide the next generation.","source_cn":"跟我们回去吧，氏族内有太多需要教化的年轻人，我们需要更...","status":"matched","hash_xxh64":"0x658578F3B1BA8C9F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123504011:1":{"text":"I understand, but having too many elders can be a burden to a clan.","source_cn":"你们所说的的确有些道理，但过多的老者是种拖累。","status":"matched","hash_xxh64":"0x8C5EB67CF2919C8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123504012:1":{"text":"Traditions should not be followed if they bind those who can help. You could do much more for the clan than you realize.","source_cn":"老旧的传统不能束缚住有能力的人，你原本可以为氏族做更多的事。","status":"matched","hash_xxh64":"0x7D1D781E8F4FDB96","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1123504013:1":{"text":"What you say does make sense, but it's too late now. I've already announced my exile. I must stand by my words.","source_cn":"即便你说的有道理，一切都太迟了，我已经宣言过自我放逐，...","status":"matched","hash_xxh64":"0xE268182D9EBE89A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1123504014:1":{"text":"Please leave.","source_cn":"你们离开吧。","status":"matched","hash_xxh64":"0x1D732DAC52812875","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1123504015:1":{"text":"Although he hasn't decided to return, his thoughts waver. Our conversation today gives me hope.","source_cn":"虽然他没有回到氏族，但他似乎有所动摇。今天的谈话让我看...","status":"matched","hash_xxh64":"0x8730AEE081DA150F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"You're still useful.","source_cn":"你并非无用之人","status":"matched_runtime_gender","hash_xxh64":"0x8C42E0AB41F6E5B1","variant_status":"runtime_gender_keys_target_same","male":"You're still useful.","female":"You're still useful.","variant_male_record_index":"64468","variant_female_record_index":"64469","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1123504008:1":{"text":"So? That has nothing to do with me.","source_cn":"所以呢？这与我无关。","status":"matched","hash_xxh64":"0xF4855793654474DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"Kruger is sincere.","source_cn":"克鲁格很有诚意","status":"matched_runtime_gender","hash_xxh64":"0x88CD0262622D314D","variant_status":"runtime_gender_keys_target_same","male":"Kruger is sincere.","female":"Kruger is sincere.","variant_male_record_index":"64470","variant_female_record_index":"64471","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:克鲁格":{"text":"Kruger","source":"克鲁格","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":19,"localized_text_count":18,"speaker_count":2}},"locales/en/ep1/quest_story/11235050.json":{"asset_key":"ep1/quest_story_11235050","episode":"ep1","category":"quest_story","story_id":"11235050","schema_version":1,"lang":"en","texts":{"say:0:1123505001:0":{"text":"Ah! You blasted metalhead...!","source_cn":"啊！该死的钢——","status":"matched","hash_xxh64":"0x93B0B0E7153B128A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123505002:0":{"text":"That's Hashir's voice... Let's go check on him!","source_cn":"那是哈什尔的声音……我们快过去看看！","status":"matched","hash_xxh64":"0xBC3E10F5D70B8835","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:克鲁格":{"text":"Kruger","source":"克鲁格","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep1/quest_story/11235070.json":{"asset_key":"ep1/quest_story_11235070","episode":"ep1","category":"quest_story","story_id":"11235070","schema_version":1,"lang":"en","texts":{"say:3:1123507001:1":{"text":"What are you all doing here?","source_cn":"你们怎么会来这里？","status":"matched","hash_xxh64":"0x5226A9E1E63A63F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123507002:1":{"text":"Uh... I'm just... passing through.","source_cn":"哼，我只是……嗯，路过！","status":"matched","hash_xxh64":"0x0C885B94B78D3752","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123507003:1":{"text":"Actually, we're here to help you, Elder.","source_cn":"其实，我们是来帮助老师的。","status":"matched","hash_xxh64":"0xBD9495B346E4DF41","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123507004:1":{"text":"Don't call me \"elder\". I'm not part of the clan anymore.","source_cn":"什么老师，你在胡言乱语什么。","status":"matched","hash_xxh64":"0x801428C060A7EA13","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123507005:1":{"text":"When we were talking back at the camp, we realized that both of us were once your students.","source_cn":"我们在营地里聊天的时候，发现对方都受到过老师的教导。","status":"matched","hash_xxh64":"0x3CC0E16362D95712","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123507006:1":{"text":"We decided to come check on you after learning about your situation. Turns out we came at the perfect time.","source_cn":"得知老师的情况后，决定过来看看，没想到来得刚刚好。","status":"matched","hash_xxh64":"0x26B84D84C9A0EAEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123507007:1":{"text":"Still... we only managed to calm that ironjaw down thanks to your instructions.","source_cn":"不过……面对那只钢颚兽，也多亏了老……你的智慧，我们才...","status":"matched","hash_xxh64":"0x99852B93F091B7A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123507008:1":{"text":"We sincerely hope that you'll consider returning to the clan, Elder. Your knowledge should be passed on to the next batch of young warriors.","source_cn":"我们两个由衷的希望你能考虑回到氏族，老师。你的知识应该...","status":"matched","hash_xxh64":"0x54CC1696982E7FCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123507009:1":{"text":"Hold on! Listen... Something's coming...","source_cn":"等一下，竖起你们的耳朵，有什么在过来了。","status":"matched","hash_xxh64":"0xB07A86A269902032","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123507010:1":{"text":"That sound...","source_cn":"这个声音是……！","status":"matched","hash_xxh64":"0x3F09B769EB2F9D7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:黑嚎熊人乌泰":{"text":"Utai","source":"黑嚎熊人乌泰","status":"matched_dialogue_flow"},"speaker:驯兽师萨克":{"text":"Tamer Zac","source":"驯兽师萨克","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":3}},"locales/en/ep1/quest_story/11235080.json":{"asset_key":"ep1/quest_story_11235080","episode":"ep1","category":"quest_story","story_id":"11235080","schema_version":1,"lang":"en","texts":{"say:0:1123508001:0":{"text":"The commotion must've caught the attention of others!","source_cn":"不好！刚才的骚动引来了几个野兽！","status":"matched","hash_xxh64":"0x6AC955B24143A2CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123508002:0":{"text":"Don't panic! You must be focused when facing formidable foes!","source_cn":"不要慌！面对强敌更要集中精力！","status":"matched","hash_xxh64":"0x73C45DE588E2695E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123508003:0":{"text":"Leave this one to <style=\"stress\"><player_name></style> and me!","source_cn":"这个家伙，就交给我和<style=stress><pl...","status":"matched_runtime_gender","hash_xxh64":"0x048B16D79270425E","variant_status":"runtime_gender_keys_target_same","male":"Leave this one to <style=\"stress\"><player_name></style> and me!","female":"Leave this one to <style=\"stress\"><player_name></style> and me!","variant_male_record_index":"126227","variant_female_record_index":"126228","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:驯兽师萨克":{"text":"Tamer Zac","source":"驯兽师萨克","status":"matched_dialogue_flow"},"speaker:黑嚎熊人乌泰":{"text":"Utai","source":"黑嚎熊人乌泰","status":"matched_dialogue_flow"},"speaker:克鲁格":{"text":"Kruger","source":"克鲁格","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":3}},"locales/en/ep1/quest_story/11235090.json":{"asset_key":"ep1/quest_story_11235090","episode":"ep1","category":"quest_story","story_id":"11235090","schema_version":1,"lang":"en","texts":{"say:1:1123509001:1":{"text":"Chief, <style=\"stress\"><player_name></style>, thank you for helping us...","source_cn":"族长，<style=stress><player_na...","status":"matched_runtime_gender","hash_xxh64":"0x4FAB002D1B261055","variant_status":"runtime_gender_keys_target_same","male":"Chief, <style=\"stress\"><player_name></style>, thank you for helping us...","female":"Chief, <style=\"stress\"><player_name></style>, thank you for helping us...","variant_male_record_index":"126229","variant_female_record_index":"126230","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123509002:1":{"text":"A while ago, a strong ironjaw seized this land from other beasts.","source_cn":"这片领地曾是一只强大的钢颚兽，从其他野兽那里夺取而来的。","status":"matched","hash_xxh64":"0x4530B1485C269F68","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123509003:1":{"text":"So, when the ironjaw got injured, the other beasts came to take their territory back.","source_cn":"当这只钢颚兽受伤，争夺地盘的其他野兽便想趁机夺回这里。","status":"matched","hash_xxh64":"0xB858F467EA1C0C27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123509004:1":{"text":"Why don't they wait until it gets old and weak?","source_cn":"啊？那为什么不趁它年老力衰的时候过来。","status":"matched","hash_xxh64":"0x8EC3FCA9B2F56423","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123509005:1":{"text":"Don't underestimate an aging ironjaw. They might not be as physically fit as before, but they have a lot of experience. Their counterattacks can be very dangerous.","source_cn":"不要小瞧年老力衰的钢颚兽，虽然体格大不如从前，但是作战...","status":"matched","hash_xxh64":"0xA0603FC1401ADA5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123509006:1":{"text":"Experience...","source_cn":"经验嘛……","status":"matched","hash_xxh64":"0xA312497480BB0E65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123509007:1":{"text":"See... Opportunities to learn and grow are everywhere. Hashir, we really need your knowledge and experience.","source_cn":"学习和成长的机会无处不在，哈什尔，我们真的需要你的知识...","status":"matched","hash_xxh64":"0xCCC57D12561ACC6C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123509008:1":{"text":"But... I...","source_cn":"可是……我……","status":"matched","hash_xxh64":"0xA0F083F8E5A5D978","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123509009:1":{"text":"The traditions were established to ensure the prosperity of the Grimmaw Clan, remember? Please return to us.","source_cn":"传统是服务黑嚎氏族繁荣的，不是吗？回到氏族吧。","status":"matched","hash_xxh64":"0xD91E3AA0B304A966","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1123509010:1":{"text":"I'll think about it.","source_cn":"我会再考虑的。","status":"matched","hash_xxh64":"0x1714901DD27899B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1123509011:1":{"text":"Hopefully, our efforts aren't in vain...","source_cn":"希望，我们的努力没有白费……","status":"matched","hash_xxh64":"0x2C62986A346FB000","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1123509012:1":{"text":"I believe in Elder Hashir. He'll surely come around.","source_cn":"我相信老师，他一定会想通的！","status":"matched","hash_xxh64":"0xD026D38989D186C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1123509013:1":{"text":"Magister <style=\"stress\"><player_name></style>, my honored friend, we're heading back to camp. Please visit when you have the time.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x84AF65577ED6776F","variant_status":"runtime_gender_keys_target_same","male":"Magister <style=\"stress\"><player_name></style>, my honored friend, we're heading back to camp. Please visit when you have the time.","female":"Magister <style=\"stress\"><player_name></style>, my honored friend, we're heading back to camp. Please visit when you have the time.","variant_male_record_index":"126242","variant_female_record_index":"126243","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:19:1123509014:1":{"text":"A while later, Kruger invites you to visit the Grimmaw Clan...","source_cn":"","status":"matched","hash_xxh64":"0x5A222A7E4A45CC0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:驯兽师萨克":{"text":"Tamer Zac","source":"驯兽师萨克","status":"matched_dialogue_flow"},"speaker:黑嚎熊人乌泰":{"text":"Utai","source":"黑嚎熊人乌泰","status":"matched_dialogue_flow"},"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:克鲁格":{"text":"Kruger","source":"克鲁格","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":15,"localized_text_count":14,"speaker_count":5}},"locales/en/ep1/quest_story/11235100.json":{"asset_key":"ep1/quest_story_11235100","episode":"ep1","category":"quest_story","story_id":"11235100","schema_version":1,"lang":"en","texts":{"say:0:1123510001:0":{"text":"Can't you even manage such a simple task?! What a bunch of asinine ursine!","source_cn":"连这么简单的事情都做不好！真是一群笨熊！","status":"matched","hash_xxh64":"0x599E82B9D3880CA0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123510002:0":{"text":"Magister, look! It's Hashir!","source_cn":"主人，你看！是哈什尔！","status":"matched_runtime_gender","hash_xxh64":"0xCB0741F1D9E98965","variant_status":"runtime_gender_keys_target_same","male":"Magister, look! It's Hashir!","female":"Magister, look! It's Hashir!","variant_male_record_index":"126246","variant_female_record_index":"126247","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep1/quest_story/11235110.json":{"asset_key":"ep1/quest_story_11235110","episode":"ep1","category":"quest_story","story_id":"11235110","schema_version":1,"lang":"en","texts":{"say:1:1123511001:1":{"text":"Hashir, you're looking full of energy! Healthy as a snow stomper!","source_cn":"哈什尔先生，您看起来精神了不少！","status":"matched","hash_xxh64":"0x8EF2A12E66DA1623","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123511002:1":{"text":"Oh, really? It's probably because these blubbering bears have me running around yelling at them all day!","source_cn":"哈，是吗。\\n也许是被那帮笨蛋熊人气的吧！","status":"matched","hash_xxh64":"0xCDF23B2D0B340C04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1123511002":{"text":"Oh, really? It's probably because these blubbering bears have me running around yelling at them all day!","source_cn":"哈，是吗。\\n也许是被那帮笨蛋熊人气的吧！","status":"matched","hash_xxh64":"0xCDF23B2D0B340C04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123511003:1":{"text":"As you can see, I've decided to pass on everything I know to the clan. I've still got some worth until I've finished teaching these idiots.","source_cn":"如你所见，我已经决定要把自己所会的东西在氏族内传承下去...","status":"matched_runtime_gender","hash_xxh64":"0xCD39C54CEA0720DE","variant_status":"runtime_gender_keys_target_same","male":"As you can see, I've decided to pass on everything I know to the clan. I've still got some worth until I've finished teaching these idiots.","female":"As you can see, I've decided to pass on everything I know to the clan. I've still got some worth until I've finished teaching these idiots.","variant_male_record_index":"126250","variant_female_record_index":"126251","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123511004:1":{"text":"Your training is excellent! Your words are concise and practical. It's easy for us to figure out what were doing wrong.","source_cn":"真是精彩的教导！你讲的话简练实用，很快就能知道该怎么化...","status":"matched","hash_xxh64":"0xA23A279E27D42180","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123511005:1":{"text":"It's a pity that I came too late. My newly established clan really needs a sage like you.","source_cn":"真是可惜……我来的太晚了，我新创立的氏族十分缺你这种智...","status":"matched","hash_xxh64":"0x61EB0ABE2C15BC31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123511006:1":{"text":"I'm no sage. All I have is experience.","source_cn":"什么智慧，无非都是些经验罢了。","status":"matched","hash_xxh64":"0xBF636423E2577F38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123511007:1":{"text":"Hashir will always be one of us. That's what I've been saying all this time.","source_cn":"我一直在说，哈什尔是黑嚎氏族的成员，他永远都是。","status":"matched","hash_xxh64":"0x483A779B00A84A1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123511008:1":{"text":"Hey... Why are you looking at the magister?","source_cn":"唔？干嘛忽然看向主人？","status":"matched_runtime_gender","hash_xxh64":"0x1AE7CB6659AC8D3D","variant_status":"runtime_gender_keys_target_same","male":"Hey... Why are you looking at the magister?","female":"Hey... Why are you looking at the magister?","variant_male_record_index":"126256","variant_female_record_index":"126257","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1123511009:1":{"text":"Ha! It's nothing. I wanted to say that even outlanders can be part of our clan too...","source_cn":"呵呵，没什么，我想说即使是异族之人，也能是我们黑嚎的成员……","status":"matched","hash_xxh64":"0xDBA1E781D8CCD20A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"How's everything recently?","source_cn":"（询问近况）","status":"matched_runtime_gender","hash_xxh64":"0xACF62045066A3405","variant_status":"runtime_gender_keys_target_same","male":"How's everything recently?","female":"How's everything recently?","variant_male_record_index":"64472","variant_female_record_index":"64473","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:库金":{"text":"Kojin","source":"库金","status":"matched_dialogue_flow"},"speaker:克鲁格":{"text":"Kruger","source":"克鲁格","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":12,"localized_text_count":11,"speaker_count":5}},"locales/en/timeline/timeline_story/1052311.json":{"asset_key":"timeline/timeline_story_1052311","episode":"timeline","category":"timeline_story","story_id":"1052311","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:1:1123506001:":{"text":"Hey! Ironjaw! Look here!","source_cn":"呼！钢颚兽，看这里！","status":"matched","hash_xxh64":"0xA0A7F96465ABBC77","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1123506003:":{"text":"It's alright... We won't hurt you...","source_cn":"嘘吁……我们不会伤害你的……","status":"matched","hash_xxh64":"0xC1CC850793E703C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1123506004:":{"text":"Calm down...","source_cn":"平静下来，呼——","status":"matched","hash_xxh64":"0xC481306521A511DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1123506005:":{"text":"You guys...","source_cn":"你们……","status":"matched","hash_xxh64":"0xE059F4D1F7D610D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:黑嚎熊人乌泰":{"text":"Utai","source":"黑嚎熊人乌泰","status":"matched_dialogue_flow"},"speaker:驯兽师萨克":{"text":"Tamer Zac","source":"驯兽师萨克","status":"matched_dialogue_flow"},"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":4,"speaker_count":3}}}}