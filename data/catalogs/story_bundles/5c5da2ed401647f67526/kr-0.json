nt":2,"speaker_count":2}},"locales/kr/ep1/quest_story/11235110.json":{"asset_key":"ep1/quest_story_11235110","episode":"ep1","category":"quest_story","story_id":"11235110","schema_version":1,"lang":"kr","texts":{"say:1:1123511001:1":{"text":"하쉬르 씨, 기운이 넘치시는 것 같네요!","source_cn":"哈什尔先生，您看起来精神了不少！","status":"matched","hash_xxh64":"0x8EF2A12E66DA1623","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123511002:1":{"text":"하, 그런가?\n그 바보 같은 베어포크 녀석들 때문이겠지!","source_cn":"哈，是吗。\\n也许是被那帮笨蛋熊人气的吧！","status":"matched","hash_xxh64":"0xCDF23B2D0B340C04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1123511002":{"text":"하, 그런가?\n그 바보 같은 베어포크 녀석들 때문이겠지!","source_cn":"哈，是吗。\\n也许是被那帮笨蛋熊人气的吧！","status":"matched","hash_xxh64":"0xCDF23B2D0B340C04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123511003:1":{"text":"보다시피 내가 알고 있는 것을 부족에 전하기로 했다. 다 전하기 전까지는 내가 부족에 할 수 있는 공헌이 있는 셈이니까.","source_cn":"如你所见，我已经决定要把自己所会的东西在氏族内传承下去...","status":"matched_runtime_gender","hash_xxh64":"0xCD39C54CEA0720DE","variant_status":"runtime_gender_keys_target_same","male":"보다시피 내가 알고 있는 것을 부족에 전하기로 했다. 다 전하기 전까지는 내가 부족에 할 수 있는 공헌이 있는 셈이니까.","female":"보다시피 내가 알고 있는 것을 부족에 전하기로 했다. 다 전하기 전까지는 내가 부족에 할 수 있는 공헌이 있는 셈이니까.","variant_male_record_index":"127789","variant_female_record_index":"127790","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123511004:1":{"text":"정말 대단하신 가르침입니다! 간단하고 실용적이어서 문제를 어떻게 해결해야 할지 단숨에 알겠더군요.","source_cn":"真是精彩的教导！你讲的话简练实用，很快就能知道该怎么化...","status":"matched","hash_xxh64":"0xA23A279E27D42180","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123511005:1":{"text":"제가 너무 늦게 와서 안타까울 뿐입니다... 제가 새로 만든 부족에도 당신 같은 현자가 필요한데...","source_cn":"真是可惜……我来的太晚了，我新创立的氏族十分缺你这种智...","status":"matched","hash_xxh64":"0x61EB0ABE2C15BC31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123511006:1":{"text":"지혜는 무슨, 다 경험일 뿐이지.","source_cn":"什么智慧，无非都是些经验罢了。","status":"matched","hash_xxh64":"0xBF636423E2577F38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123511007:1":{"text":"저는 항상 하쉬르는 영원히 블랙하울의 일원이라고 말하고 있습니다.","source_cn":"我一直在说，哈什尔是黑嚎氏族的成员，他永远都是。","status":"matched","hash_xxh64":"0x483A779B00A84A1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123511008:1":{"text":"어라, 왜 그렇게 마스터를 쳐다보는 거죠?","source_cn":"唔？干嘛忽然看向主人？","status":"matched_runtime_gender","hash_xxh64":"0x1AE7CB6659AC8D3D","variant_status":"runtime_gender_keys_target_same","male":"어라, 왜 그렇게 마스터를 쳐다보는 거죠?","female":"어라, 왜 그렇게 마스터를 쳐다보는 거죠?","variant_male_record_index":"127795","variant_female_record_index":"127796","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1123511009:1":{"text":"하하, 아닙니다. 이민족이라고 해도 우리 블랙하울의 일원이 될 수 있다는 말을 하고 싶었을 뿐...","source_cn":"呵呵，没什么，我想说即使是异族之人，也能是我们黑嚎的成员……","status":"matched","hash_xxh64":"0xDBA1E781D8CCD20A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"(근황을 묻는다)","source_cn":"（询问近况）","status":"matched_runtime_gender","hash_xxh64":"0xACF62045066A3405","variant_status":"runtime_gender_keys_target_same","male":"(근황을 묻는다)","female":"(근황을 묻는다)","variant_male_record_index":"64940","variant_female_record_index":"64941","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"},"speaker:哈什尔":{"text":"하쉬르","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:库金":{"text":"쿠긴","source":"库金","status":"matched_dialogue_flow"},"speaker:克鲁格":{"text":"크루거","source":"克鲁格","status":"matched_dialogue_flow"},"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":12,"localized_text_count":11,"speaker_count":5}},"locales/kr/timeline/timeline_story/1052311.json":{"asset_key":"timeline/timeline_story_1052311","episode":"timeline","category":"timeline_story","story_id":"1052311","schema_version":1,"lang":"kr","texts":{"cinematic_dialogue:1:1123506001:":{"text":"이봐, 강철 악어! 여길 보라고!","source_cn":"呼！钢颚兽，看这里！","status":"matched","hash_xxh64":"0xA0A7F96465ABBC77","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1123506003:":{"text":"쉬이... 해치지 않아..","source_cn":"嘘吁……我们不会伤害你的……","status":"matched","ha