{"schema_version":1,"resources":{"locales/en/ep5/quest_story/15110100.json":{"asset_key":"ep5/quest_story_15110100","episode":"ep5","category":"quest_story","story_id":"15110100","schema_version":1,"lang":"en","texts":{"say:1:1511010001:0":{"text":"Spirit... Is this going to test our willpower?","source_cn":"精神之楔会考验意志吗？","status":"matched","hash_xxh64":"0x9F97F0271648991D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1511010002:0":{"text":"I don't think the sealing wedges were created to test anyone. But you can see them as a kind of trial.","source_cn":"我想，封印之楔的设置绝不是为了考验谁。但你的确可以将它...","status":"matched","hash_xxh64":"0xECD41CFC260C3AC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1511010003:0":{"text":"Only those who can stand before magic similar to the gods without faltering will succeed.","source_cn":"通过考验之人，一定拥有面对神力也不会动摇的决意。","status":"matched","hash_xxh64":"0xC190676C411D817F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}},"locales/en/ep5/quest_story/15201210.json":{"asset_key":"ep5/quest_story_15201210","episode":"ep5","category":"quest_story","story_id":"15201210","schema_version":1,"lang":"en","texts":{"narration:1:1520121001:1":{"text":"Merlin the Firs