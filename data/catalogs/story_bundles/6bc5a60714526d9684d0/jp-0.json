ant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1423340025:1":{"text":"暇なときにでも読んでみて！よかったら、お友だちも一緒に！","source_cn":"你无聊的时候可以多读读看！也可以和你的朋友们一起读！","status":"matched","hash_xxh64":"0x7A66797AF88AD0C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1423340026:1":{"text":"これが……本？ありがとう、お姉ちゃん……","source_cn":"这是……书吗？谢谢你，大姐姐……","status":"matched","hash_xxh64":"0x4A74562479082AF7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:0:1":{"text":"ジェミーにも声をかけておこう。","source_cn":"跟詹米打个招呼吧","status":"matched_runtime_gender","hash_xxh64":"0x290EAFF56DD73EE5","variant_status":"runtime_gender_keys_target_differs","male":"ジェミーにも声をかけておこう。","female":"ジェミーにも声をかけておきましょう。","variant_male_record_index":"73914","variant_female_record_index":"73915","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:1:2":{"text":"ジェミーにもお別れを言っておこう。","source_cn":"跟詹米告个别吧","status":"matched_runtime_gender","hash_xxh64":"0xBEAC553C0413FD2A","variant_status":"runtime_gender_keys_target_differs","male":"ジェミーにもお別れを言っておこう。","female":"ジェミーにもお別れを言っておきましょう。","variant_male_record_index":"73916","variant_female_record_index":"73917","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:平民胡丽诺":{"text":"平民のフリノ","source":"平民胡丽诺","status":"matched_dialogue_flow"},"speaker:詹米":{"text":"ジェミー","source":"詹米","sta