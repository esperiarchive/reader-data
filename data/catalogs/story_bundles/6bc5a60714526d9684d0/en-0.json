{"schema_version":1,"resources":{"locales/en/ep4/quest_story/14233270.json":{"asset_key":"ep4/quest_story_14233270","episode":"ep4","category":"quest_story","story_id":"14233270","schema_version":1,"lang":"en","texts":{"say:0:1423327001:0":{"text":"It's about time to meet Orlana. Let's head to the Lunaris Altar and see if she's there.","source_cn":"到了跟欧罗娜约定的时间了，我们去银月祭庭找她吧？","status":"matched","hash_xxh64":"0xC10BAD0E5F2E5014","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14233280.json":{"asset_key":"ep4/quest_story_14233280","episode":"ep4","category":"quest_story","story_id":"14233280","schema_version":1,"lang":"en","texts":{"say:0:1423328001:0":{"text":"There she is! Looks like she came well prepared.","source_cn":"那是欧罗娜！她好像准备得很充分呢。","status":"matched","hash_xxh64":"0x4D72512850B22CA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14233290.json":{"asset_key":"ep4/quest_story_14233290","episode":"ep4","category":"quest_story","story_id":"14233290","schema_version":1,"lang":"en","texts":{"say:3:1423329001:1":{"text":"You're here! I did a bit of reading ahead of time, brought some cooking gear... and a bunch of other things we might need.","source_cn":"你们来啦！我提前做了一些功课，查阅了书籍，带了炊具……...","status":"matched","hash_xxh64":"0xDB3B430653ECC86B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423329002:1":{"text":"I checked the map. There's a lift at Moon Lift Shaft that leads straight to the commoners' district. I thought we could head out that way today.","source_cn":"我看了地图，月落升降井处的升降机可以通往泽被平民区，所...","status":"matched","hash_xxh64":"0x51F6CBEF120EFD7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423329003:1":{"text":"Sounds like Orlana's ready to be the guide this time.","source_cn":"感觉欧罗娜都可以为我们带路了呢。","status":"matched","hash_xxh64":"0x37F122EDF1ED6E00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423329004:1":{"text":"We know that route too! Let's get moving!","source_cn":"那条路线我们也很熟悉！我们出发吧！","status":"matched","hash_xxh64":"0xA9A303203FEC8337","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":3}},"locales/en/ep4/quest_story/14233300.json":{"asset_key":"ep4/quest_story_14233300","episode":"ep4","category":"quest_story","story_id":"14233300","schema_version":1,"lang":"en","texts":{"say:0:1423330001:0":{"text":"This must be the place... muddy, rundown, barely any shelter at all.","source_cn":"这里就是平民生活的地方……泥泞，破败，连遮风挡雨都做不到。","status":"matched","hash_xxh64":"0x302FB39F33464E18","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1423330002:0":{"text":"It's even worse than I imagined...","source_cn":"比我想象的更让人心酸……","status":"matched","hash_xxh64":"0x557C150E03FF0E0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/ep4/quest_story/14233310.json":{"asset_key":"ep4/quest_story_14233310","episode":"ep4","category":"quest_story","story_id":"14233310","schema_version":1,"lang":"en","texts":{"say:0:1423331001:0":{"text":"Jamie? Sheena? Where are the kids?!","source_cn":"詹米！希娜！……孩子们都去哪了？！","status":"matched","hash_xxh64":"0x1408276193D39E4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:平民胡丽诺":{"text":"Helina","source":"平民胡丽诺","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14233320.json":{"asset_key":"ep4/quest_story_14233320","episode":"ep4","category":"quest_story","story_id":"14233320","schema_version":1,"lang":"en","texts":{"say:2:1423332001:1":{"text":"Excuse me! I heard you calling for the children. What happened?","source_cn":"您好！我听到您在叫孩子们的名字，这里的孩子怎么了？","status":"matched","hash_xxh64":"0xE2D3799EAC5A6E99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423332002:1":{"text":"My son Jamie ran off with a few of the village kids. I think they might've wandered into the forest.","source_cn":"我的孩子詹米和村里的几个小孩都跑得不见人影，我害怕他们...","status":"matched","hash_xxh64":"0xAAE37C8A4DA82A18","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423332003:1":{"text":"Ugh, these brats! What if something dangerous shows up and no one's there to help?","source_cn":"真是不让人省心！没有大人在身边，遇到危险可怎么办……","status":"matched","hash_xxh64":"0x93B8EEAB0A77AE54","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423332004:1":{"text":"Don't worry, we'll help search for them!","source_cn":"您别着急，我们也来帮忙找孩子们！","status":"matched","hash_xxh64":"0x48BEB4EADFD4D48C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"},"speaker:平民胡丽诺":{"text":"Helina","source":"平民胡丽诺","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}},"locales/en/ep4/quest_story/14233340.json":{"asset_key":"ep4/quest_story_14233340","episode":"ep4","category":"quest_story","story_id":"14233340","schema_version":1,"lang":"en","texts":{"say:0:1423334001:0":{"text":"I hear someone crying... Could that be one of the missing kids?","source_cn":"我听到了哭泣的声音……那个是走丢了的孩子吗？","status":"matched","hash_xxh64":"0xDA5618C17CBB9B2B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14233350.json":{"asset_key":"ep4/quest_story_14233350","episode":"ep4","category":"quest_story","story_id":"14233350","schema_version":1,"lang":"en","texts":{"say:3:1423335001:1":{"text":"Hey there, why are you all alone and crying? Where are your friends? The grown-ups are worried. You should head back soon.","source_cn":"小朋友，你怎么一个人在这里哭呀？你的朋友呢？大人很担心...","status":"matched","hash_xxh64":"0x5F91EA36C9B5F5A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423335002:1":{"text":"*Sobbing* We were playing tag and I was the ghost, but they all ran off so fast! I lost sight of them and couldn't catch up!","source_cn":"……呜……我们在玩扮鬼抓人的游戏，可是他们跑得好快，一...","status":"matched","hash_xxh64":"0xF60CE9526EF26D59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423335003:1":{"text":"I found Jules for a second, but then he ran off again... I didn't want to quit, but being alone out here is scary...","source_cn":"好不容易找到了朱尔，可是朱尔又跑掉了……追不上他们，我...","status":"matched","hash_xxh64":"0x688B2873A8B87C65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423335004:1":{"text":"If we help you find your friends, would you be good and go home?","source_cn":"如果我们帮你找到朋友的话，你是不是就愿意回家了？","status":"matched","hash_xxh64":"0xEBBD2661418DBC84","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423335005:1":{"text":"Actually, I want to go home now. I really do. But I can't leave them behind. And I'm too scared to walk back alone...","source_cn":"其实我现在就想回家了，只是我不能丢下他们，我也不敢一个...","status":"matched","hash_xxh64":"0x05BE3C6AA4B79A4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1423335005":{"text":"Actually, I want to go home now. I really do. But I can't leave them behind. And I'm too scared to walk back alone...","source_cn":"其实我现在就想回家了，只是我不能丢下他们，我也不敢一个人回去……","status":"matched","hash_xxh64":"0x05BE3C6AA4B79A4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1423335006:1":{"text":"Thank you! I'm really scared being out here alone. Please hurry and bring them back, please!","source_cn":"谢谢你们，我好害怕一个人，你们快点找到他们，把他们带回来吧！","status":"matched","hash_xxh64":"0xF609F8AE370301EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"We'll join your game.","source_cn":"我们也来玩游戏","status":"matched_runtime_gender","hash_xxh64":"0x156A5A2D51E4F3D3","variant_status":"runtime_gender_keys_target_same","male":"We'll join your game.","female":"We'll join your game.","variant_male_record_index":"74366","variant_female_record_index":"74367","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"We'll help you find them!","source_cn":"我们帮你找到他们","status":"matched_runtime_gender","hash_xxh64":"0x5E17CA4F31D8A81B","variant_status":"runtime_gender_keys_target_same","male":"We'll help you find them!","female":"We'll help you find them!","variant_male_record_index":"74368","variant_female_record_index":"74369","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"},"speaker:詹米":{"text":"Jamie","source":"詹米","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":3}},"locales/en/ep4/quest_story/14233360.json":{"asset_key":"ep4/quest_story_14233360","episode":"ep4","category":"quest_story","story_id":"14233360","schema_version":1,"lang":"en","texts":{"say:1:1423336001:1":{"text":"Jamie, you can't just call in grown-ups to help! That's cheating!","source_cn":"詹米，你也太耍赖了，怎么能找大人当外援呢！","status":"matched","hash_xxh64":"0x370BE8B8DAADA25D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423336002:1":{"text":"But I couldn't find you! I just wanted to go home...","source_cn":"因为我一直找不到你们嘛……我想回家了……","status":"matched","hash_xxh64":"0xA4802A96ACEF1F19","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423336003:1":{"text":"Go home? You haven't even won yet. Jules is still hiding.","source_cn":"回家？可是你还没有赢呢，你还差朱尔没有找到。","status":"matched","hash_xxh64":"0x4519442C665EA1CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423336004:1":{"text":"We've searched this whole area... Could he have run even farther south?","source_cn":"我们已经把这里都找遍了呀……难道朱尔躲在了南边更远的地方？","status":"matched","hash_xxh64":"0x44C99BC50900A1F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423336005:1":{"text":"Mom said it's dangerous over there. We have to find him fast!","source_cn":"妈妈说过，那里是很危险的，我们赶紧找到他吧！","status":"matched","hash_xxh64":"0x62ED34A2066992F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:希娜":{"text":"Sheena","source":"希娜","status":"matched_dialogue_flow"},"speaker:詹米":{"text":"Jamie","source":"詹米","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":3}},"locales/en/ep4/quest_story/14233370.json":{"asset_key":"ep4/quest_story_14233370","episode":"ep4","category":"quest_story","story_id":"14233370","schema_version":1,"lang":"en","texts":{"say:0:1423337001:0":{"text":"You already found Jules? And you've got backup?!","source_cn":"朱尔已经被找到了？居然还有外援！","status":"matched","hash_xxh64":"0x5249DF55D43D10E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1423337002:0":{"text":"That's not backup. That's a capshroom! Let's go help!","source_cn":"那不是外援，是幻灵孢菇！快去帮忙！","status":"matched","hash_xxh64":"0x1DFF9E7B82CF3C79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:希娜":{"text":"Sheena","source":"希娜","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep4/quest_story/14233380.json":{"asset_key":"ep4/quest_story_14233380","episode":"ep4","category":"quest_story","story_id":"14233380","schema_version":1,"lang":"en","texts":{"say:1:1423338001:1":{"text":"Okay, now everyone's been found. Game over! Time to go home!","source_cn":"好啦，这下所有的人都被找到了，捉迷藏游戏顺利完成！大家...","status":"matched","hash_xxh64":"0x565C71421934B329","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423338002:1":{"text":"Go home? No way! We're not done playing!","source_cn":"回家？不！我们还没玩够呢！","status":"matched","hash_xxh64":"0x023AF12C80DAFC90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423338003:1":{"text":"Jamie brought grown-ups into the game. That's cheating! Jamie's a scaredy-cat!","source_cn":"詹米找大人来当外援，詹米犯规！詹米是胆小鬼！","status":"matched","hash_xxh64":"0xB6E2397FA6706CD1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423338004:1":{"text":"I never said I'd go home if you found me—that was Jamie's promise, not mine! We're staying out here! We're gonna keep playing, and we're not stopping!","source_cn":"我可没有答应被找到之后要回家，一定是詹米答应的！我们还...","status":"matched","hash_xxh64":"0x8F2C3B0F170BD7B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423338005:1":{"text":"You nearly got attacked by that capshroom just now. You really want to keep hanging around out here?","source_cn":"你刚刚都差点被幻灵孢菇攻击了，还要待在这里吗？","status":"matched","hash_xxh64":"0x317738B6C9C052AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1423338006:1":{"text":"That was just bad luck! Next time I'll hide somewhere safer...","source_cn":"那只是个意外！大不了我下次藏在不那么偏僻的地方嘛……","status":"matched","hash_xxh64":"0xD0F89818F8D78CD0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1423338007:1":{"text":"Look, it's fine to enjoy the game and have fun, but at your age, you can't be goofing off all the time...","source_cn":"你们这么大的年纪，虽然可以尽情享受游戏的乐趣，但也不能...","status":"matched","hash_xxh64":"0xFABE9BD1E0CF2AEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1423338008:1":{"text":"You've got to rest sometimes, too. Maybe read a book. Learn something new...","source_cn":"也该抽时间安静下来，读一些书，学点东西……","status":"matched","hash_xxh64":"0xBE698E2127D601B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1423338009:1":{"text":"What's she even talking about?!","source_cn":"她说的是什么意思啊？我听不懂！","status":"matched","hash_xxh64":"0xC25FDA5292070ABA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1423338010:1":{"text":"Doesn't matter. We'll just end up as servants anyway. No point learning stuff that doesn't help with that...","source_cn":"反正我们长大后最好的出路不过是去当贵族的仆从，学你说的...","status":"matched","hash_xxh64":"0xC9B5C0B76D3087A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1423338011:1":{"text":"Servants? But the royal city isn't like that anymore...","source_cn":"仆从？可是现在王城已经……","status":"matched","hash_xxh64":"0x82DDA96A4F03BA0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1423338012:1":{"text":"Whatever. Jamie has a home to go back to. We don't. So leave us alone!","source_cn":"总之，詹米是有家的孩子，詹米回家就好，我们更愿意待在这...","status":"matched","hash_xxh64":"0x76AB89BE55B7DA27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"},"speaker:莱妮":{"text":"Leni","source":"莱妮","status":"matched_dialogue_flow"},"speaker:希娜":{"text":"Sheena","source":"希娜","status":"matched_dialogue_flow"},"speaker:朱尔":{"text":"Jules","source":"朱尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":5}},"locales/en/ep4/quest_story/14233390.json":{"asset_key":"ep4/quest_story_14233390","episode":"ep4","category":"quest_story","story_id":"14233390","schema_version":1,"lang":"en","texts":{"say:0:1423339001:0":{"text":"And they're gone again!","source_cn":"这些孩子们又都跑掉了！","status":"matched","hash_xxh64":"0x0F5FC71B87C9B49A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1423339002:0":{"text":"Let's just get whoever we can... Jamie, come on.","source_cn":"能带回去一个算一个……詹米，我们走吧。","status":"matched","hash_xxh64":"0x43FAD85698A32CD4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep4/quest_story/14233400.json":{"asset_key":"ep4/quest_story_14233400","episode":"ep4","category":"quest_story","story_id":"14233400","schema_version":1,"lang":"en","texts":{"say:1:1423340001:1":{"text":"Are you hurt, Jamie?","source_cn":"詹米，你没出什么事吧！","status":"matched","hash_xxh64":"0x09634E854622F92F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423340002:1":{"text":"I'm fine, Mom. I was just playing hide and seek with Sheena and the others.","source_cn":"妈妈，我没事！我只是跟希娜他们去玩捉迷藏了。","status":"matched","hash_xxh64":"0xC1EAAAF5596F4DCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423340003:1":{"text":"Thank you for bringing my boy back... Did the others return too?","source_cn":"多谢你们这些好心人带詹米回来……希娜他们呢，没有回来吗？","status":"matched","hash_xxh64":"0x6B3CC976B89DE1A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423340004:1":{"text":"Sorry. They said they wanted to keep playing. They didn't come with us...","source_cn":"抱歉，他们还想继续玩游戏，没有回来……","status":"matched","hash_xxh64":"0xCFE6F1A4A86D6B1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423340005:1":{"text":"Ugh, those kids, always causing trouble.","source_cn":"唉，真是让人不省心的孩子啊。","status":"matched","hash_xxh64":"0x738C8F7010B0381A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423340006:1":{"text":"Could you tell us more about them?","source_cn":"那几个孩子的情况……可以跟我们说说吗？","status":"matched","hash_xxh64":"0x34AFFFCA326237FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1423340007:1":{"text":"... They're orphans. Lost their parents young and left to fend for themselves. We neighbors do what we can to look after them.","source_cn":"……他们都是无父无母的孤儿，从小在山野里摸爬滚生存，我...","status":"matched","hash_xxh64":"0x0C7495B4E1E99081","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1423340008:1":{"text":"Sheena's the leader. Her mom left for the royal city to be a servant and never came back...","source_cn":"那个领头的女孩叫希娜。希娜的母亲在生下希娜后去王城当了...","status":"matched","hash_xxh64":"0x5790AEFACC2B6CC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1423340009:1":{"text":"Sheena's bold and quick on her feet. These kids see her as their leader—she's the only one they listen to.","source_cn":"希娜胆子大，又身手矫健，如今是这些孩子的头儿，可以说，...","status":"matched","hash_xxh64":"0xA64B7EB4A0C8BEF6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1423340010:1":{"text":"But she's stubborn. Always pushing back against the grown-ups. They just play around all day... I worry, but there's not much I can do.","source_cn":"但希娜，该说是执拗还是叛逆呢？总是跟大人们对着干。这些...","status":"matched","hash_xxh64":"0x5BC8AE41F7215290","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1423340011:1":{"text":"They talked about being servants for nobles... but that's not how things work anymore. There are no more nobles or commoners now...","source_cn":"那些孩子还提到长大后去做贵族的仆从……可是现在已经没有...","status":"matched","hash_xxh64":"0x43EA2B2E17CD21BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1423340012:1":{"text":"They could come to the royal city. Learn a trade. Build a life.","source_cn":"如果他们想的话，他们可以自由前往王城，靠一技之长谋生。","status":"matched","hash_xxh64":"0x7F877561507E6721","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1423340013:1":{"text":"No one's told them that. No one's shown them how...","source_cn":"我想根本没有人告诉他们这些变化吧……","status":"matched","hash_xxh64":"0xB7934C6FAF09B620","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1423340014:1":{"text":"Even us adults aren't sure where to go or what to do anymore... Let alone kids like them.","source_cn":"对于这些变化，我们大人都不知道该做些什么，该往哪走……...","status":"matched","hash_xxh64":"0x28C4AA22982FE47F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1423340015:1":{"text":"What about school? Aren't there any teachers here?","source_cn":"这些孩子……平民区没有学校和老师愿意接收他们，让他们学习吗？","status":"matched","hash_xxh64":"0x43EC3111FF89ACCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1423340016:1":{"text":"School? Teachers? Those are for the wealthy—nobles, priestesses, and such. We commoners have never had access to anything like that.","source_cn":"学校、老师……这些都是祭司贵族之类的富裕人家才能负担得...","status":"matched","hash_xxh64":"0x7EC87C0041767A4B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1423340017:1":{"text":"And even if we did... who would come all the way out here to teach?","source_cn":"而且，不会有老师愿意来这里的……","status":"matched","hash_xxh64":"0x22E694962049AEEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1423340018:1":{"text":"I see...","source_cn":"原来是这样……","status":"matched","hash_xxh64":"0x75901F66C2633FA4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:21:1423340019:0":{"text":"After hearing the truth about those kids, the mood turns heavy...","source_cn":"知道了这些孩子的真实情况后，气氛一时有些凝重……","status":"matched","hash_xxh64":"0xCEAF2C027FD684A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1423340020:1":{"text":"... I'm sorry. We can't do much to help right now... It's late. Let's take Orlana home.","source_cn":"……抱歉，我们目前还帮不上什么忙……时间不早了，我们送...","status":"matched","hash_xxh64":"0x98B85A68E3F69865","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:24:1423340020":{"text":"... I'm sorry. We can't do much to help right now... It's late. Let's take Orlana home.","source_cn":"……抱歉，我们目前还帮不上什么忙……时间不早了，我们送欧罗娜回去吧？","status":"matched","hash_xxh64":"0x98B85A68E3F69865","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1423340021:3":{"text":"See you, Jamie. I hope we meet again!","source_cn":"詹米，再见啦，希望我们还能再见到你！","status":"matched","hash_xxh64":"0x1577EF3E38703E8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1423340022:1":{"text":"Bye... Thank you for helping me get home!","source_cn":"再见……谢谢你们带詹米回家！","status":"matched","hash_xxh64":"0x89F2432739DDB808","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1423340023:1":{"text":"... Oh! I want you to have this!","source_cn":"……对了！这个送给你！","status":"matched","hash_xxh64":"0x012511EB9B05EBD5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1423340024:1":{"text":"It's a book! It's full of fun stories!","source_cn":"这个是一本书哦！上面写了很多有趣的事情呢！","status":"matched","hash_xxh64":"0xA30D585E1FC7A53C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1423340025:1":{"text":"Read it when you're bored. Or share it with your friends!","source_cn":"你无聊的时候可以多读读看！也可以和你的朋友们一起读！","status":"matched","hash_xxh64":"0x7A66797AF88AD0C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1423340026:1":{"text":"A... book? Thank you, Miss...","source_cn":"这是……书吗？谢谢你，大姐姐……","status":"matched","hash_xxh64":"0x4A74562479082AF7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:0:1":{"text":"Let's say hi to Jamie.","source_cn":"跟詹米打个招呼吧","status":"matched_runtime_gender","hash_xxh64":"0x290EAFF56DD73EE5","variant_status":"runtime_gender_keys_target_same","male":"Let's say hi to Jamie.","female":"Let's say hi to Jamie.","variant_male_record_index":"74370","variant_female_record_index":"74371","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:1:2":{"text":"Let's say goodbye to Jamie.","source_cn":"跟詹米告个别吧","status":"matched_runtime_gender","hash_xxh64":"0xBEAC553C0413FD2A","variant_status":"runtime_gender_keys_target_same","male":"Let's say goodbye to Jamie.","female":"Let's say goodbye to Jamie.","variant_male_record_index":"74372","variant_female_record_index":"74373","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:平民胡丽诺":{"text":"Helina","source":"平民胡丽诺","status":"matched_dialogue_flow"},"speaker:詹米":{"text":"Jamie","source":"詹米","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":30,"localized_text_count":29,"speaker_count":5}},"locales/en/ep4/quest_story/14233410.json":{"asset_key":"ep4/quest_story_14233410","episode":"ep4","category":"quest_story","story_id":"14233410","schema_version":1,"lang":"en","texts":{"say:0:1423341001:0":{"text":"It's been a long day. Orlana must be tired. Let's head back to the royal city.","source_cn":"发生了不少事，欧罗娜也累了吧？我们先回王城吧。","status":"matched","hash_xxh64":"0xA784E5C940843A86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14233420.json":{"asset_key":"ep4/quest_story_14233420","episode":"ep4","category":"quest_story","story_id":"14233420","schema_version":1,"lang":"en","texts":{"say:2:1423342001:1":{"text":"Orlana, you look a little down...","source_cn":"欧罗娜，你看起来心情有点低落……","status":"matched","hash_xxh64":"0x196458F61E00E44B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1423342001":{"text":"Orlana, you look a little down...","source_cn":"欧罗娜，你看起来心情有点低落……","status":"matched","hash_xxh64":"0x196458F61E00E44B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423342002:1":{"text":"Probably because I see myself in those kids...","source_cn":"可能因为我觉得那些孩子和我很像吧……","status":"matched","hash_xxh64":"0x1D2420B9DEBF5830","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423342003:1":{"text":"Back then, I only had one goal: become a priestess. And when I felt lost, I'd bury myself in books. It helped me forget everything else...","source_cn":"以前的我只有努力成为祭司这一个念头，迷茫的时候都会逼自...","status":"matched","hash_xxh64":"0x8361A6CC2866B70B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423342004:1":{"text":"Now that I've let go of that path... I don't know what I'm good for anymore.","source_cn":"现在要抛弃作为祭司学到的一切重新开始……却发现自己什么...","status":"matched","hash_xxh64":"0x9E08BEF98D2BDB83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423342005:1":{"text":"... I feel lost, uncertain, unsure how to move forward... I wonder if those kids feel the same.","source_cn":"……迷茫，无处可去，不知道未来该做什么，觉得自己没有准...","status":"matched","hash_xxh64":"0x24AEF2489BA69009","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423342006:1":{"text":"But at least I met you guys. You helped me visit the commoners' district and gave me the courage to take that first step. Those kids weren't that lucky...","source_cn":"但我起码遇到了你们，你们帮助我实现了去平民区看看的愿望...","status":"matched","hash_xxh64":"0x7B54F2DFAA0618B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1423342006":{"text":"But at least I met you guys. You helped me visit the commoners' district and gave me the courage to take that first step. Those kids weren't that lucky...","source_cn":"但我起码遇到了你们，你们帮助我实现了去平民区看看的愿望，还鼓励我迈出第一步，可那些孩子却没有这样的运气……","status":"matched","hash_xxh64":"0x7B54F2DFAA0618B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1423342007:1":{"text":"But I haven't even figured out my own future yet... Is it really okay for me to try?","source_cn":"可是我连自己的未来都没有想明白……我是不是太不自量力了？","status":"matched","hash_xxh64":"0xB410A5207A8CB42C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1423342008:1":{"text":"You're doing great, Orlana! But if you're still feeling down, how about we go somewhere else next time to relax a bit?","source_cn":"欧罗娜你已经很努力了！如果你还是不开心的话，不如我们下...","status":"matched","hash_xxh64":"0xD3DCD5E180850AE8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1423342009:1":{"text":"But you can't run forever...","source_cn":"这样逃避下去总不是办法……","status":"matched","hash_xxh64":"0xCBC6CA51F36F746F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1423342010:1":{"text":"Thank you. I want to take some time to think about everything...","source_cn":"谢谢你们！我想一个人好好思考一下，关于未来的事……","status":"matched","hash_xxh64":"0xB33A5462ED5AE34C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"Maybe you can be that person for them.","source_cn":"你可以想办法帮帮他们","status":"matched_runtime_gender","hash_xxh64":"0xF6C7E75633502AA5","variant_status":"runtime_gender_keys_target_same","male":"Maybe you can be that person for them.","female":"Maybe you can be that person for them.","variant_male_record_index":"74376","variant_female_record_index":"74377","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"Start small. Do what you can.","source_cn":"可以做些能帮到他们的小事","status":"matched_runtime_gender","hash_xxh64":"0xC7D9702CC66182F3","variant_status":"runtime_gender_keys_target_same","male":"Start small. Do what you can.","female":"Start small. Do what you can.","variant_male_record_index":"74378","variant_female_record_index":"74379","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"Why did you give Jamie that book?","source_cn":"欧罗娜为什么把书送给了詹米？","status":"matched_runtime_gender","hash_xxh64":"0x7CBFBABB907DF02F","variant_status":"runtime_gender_keys_target_same","male":"Why did you give Jamie that book?","female":"Why did you give Jamie that book?","variant_male_record_index":"74374","variant_female_record_index":"74375","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":16,"localized_text_count":15,"speaker_count":2}},"locales/en/timeline/timeline_story/1401052327.json":{"asset_key":"timeline/timeline_story_1401052327","episode":"timeline","category":"timeline_story","story_id":"1401052327","schema_version":1,"lang":"en","texts":{},"speakers":{},"stats":{"flow_row_count":2,"localized_text_count":0,"speaker_count":0}}}}