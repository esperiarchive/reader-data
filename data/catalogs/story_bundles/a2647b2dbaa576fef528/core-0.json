{"schema_version":1,"resources":{"catalogs/portraits/bindings/377c7ddb5456b8eac84c.json":{"line_overrides":[{"asset_key":"ep7/env_story_17372039","graph_node":"line:0:say:1737203901:0","model":"avatar_01_male","models":["avatar_01_male","avatar_01_female"],"requested_pose":"think","portrait_pose":"source_world_idle","source_clips":{"avatar_01_male":"pbsc_avatar_01_male@w_idle","avatar_01_female":"pbsc_avatar_01_female@w_idle"},"source_action":"nodes[0]._action","evidence":"portrait_review/player_normal_recheck_20261023.json","reason":"Current gender-specific Slim clip assignments are empty; use the captured world idle instead of inferring an animation from the expression label."}],"subtitle_bindings":[]},"catalogs/portraits/bindings/46a190d1338aece27884.json":{"line_overrides":[{"asset_key":"ep7/env_story_17372038","graph_node":"line:0:say:1737203801:0","model":"avatar_01_male","models":["avatar_01_male","avatar_01_female"],"requested_pose":"think","portrait_pose":"source_world_idle","source_clips":{"avatar_01_male":"pbsc_avatar_01_male@w_idle","avatar_01_female":"pbsc_avatar_01_female@w_idle"},"source_action":"nodes[0]._action","evidence":"portrait_review/player_normal_recheck_20261023.json","reason":"Current gender-specific Slim clip assignments are empty; use the captured world idle instead of inferring an animation from the expression label."}],"subtitle_bindings":[]},"easter_eggs/graphs/17010390/document_601.json":{"schema_version":1,"asset_key":"easter_eggs/document_17010390_601","roots":["document:601"],"nodes":{"document:601":{"id":"document:601","type":"document","entry_kind":"document","text_key":"document:601","source_node_id":"17010390:1:3","next":"end"},"end":{"id":"end","type":"end"}},"text_entries":{"document:601":{"key":"document:601","kind":"document","textdes_id":"601","source_cn":"众所周知，作为一种常见的、被列为魔法师必修的魔法，变形术有着众多妙用。\n其基础为改变某种对象的形状和外观，随着对变形术的深入掌握，还能掌握跨物种变形等多项分支魔法。\n今日笔者主要聚焦于其中的动物变形分支：即使用变形术变身为动物，以获得更强的机动性、与动物沟通的能力等等。\n而对于此分支变形术，当前学术界都认为其存在一个隐患：当使用者精神状态不稳定时，可能无法及时恢复人形。\n但在笔者看来，这项所谓的“隐患”，何尝不能在满足某些特殊需求时发挥妙用？\n试想，诸位还在学院中求学，面对众多课业论文考核时，是否羡慕过窗外的鸟，想要一走了之？\n诸位走入社会，面对生活与工作压力时，又是否羡慕过家中的猫，想要和它一样睡到昏天黑地？\n我们受人类身份桎梏、被困在世俗标准多久了？有时，我们甚至在想，进化对于我们这些个体真是好事吗？\n比起人类，我们或许更想实现退行，变回猴子！笔者认为，是时候该有一种魔法，帮助我们真正实现愿望了！\n因此笔者计划改良动物变形术，永远将自己变为猴子。当魔法研究成功的那一天，笔者一定要掀翻上司的办公桌……\n——当然，是用猴子的手掌！","document_title_cn":"变成猴的魔法"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1},"source":"Exact map-object document dispatch"},"easter_eggs/locales/cn/17010390/document_601.json":{"schema_version":1,"asset_key":"easter_eggs/document_17010390_601","lang":"cn","texts":{"document:601":{"text":"众所周知，作为一种常见的、被列为魔法师必修的魔法，变形术有着众多妙用。\n其基础为改变某种对象的形状和外观，随着对变形术的深入掌握，还能掌握跨物种变形等多项分支魔法。\n今日笔者主要聚焦于其中的动物变形分支：即使用变形术变身为动物，以获得更强的机动性、与动物沟通的能力等等。\n而对于此分支变形术，当前学术界都认为其存在一个隐患：当使用者精神状态不稳定时，可能无法及时恢复人形。\n但在笔者看来，这项所谓的“隐患”，何尝不能在满足某些特殊需求时发挥妙用？\n试想，诸位还在学院中求学，面对众多课业论文考核时，是否羡慕过窗外的鸟，想要一走了之？\n诸位走入社会，面对生活与工作压力时，又是否羡慕过家中的猫，想要和它一样睡到昏天黑地？\n我们受人类身份桎梏、被困在世俗标准多久了？有时，我们甚至在想，进化对于我们这些个体真是好事吗？\n比起人类，我们或许更想实现退行，变回猴子！笔者认为，是时候该有一种魔法，帮助我们真正实现愿望了！\n因此笔者计划改良动物变形术，永远将自己变为猴子。当魔法研究成功的那一天，笔者一定要掀翻上司的办公桌……\n——当然，是用猴子的手掌！","source_cn":"众所周知，作为一种常见的、被列为魔法师必修的魔法，变形术有着众多妙用。\n其基础为改变某种对象的形状和外观，随着对变形术的深入掌握，还能掌握跨物种变形等多项分支魔法。\n今日笔者主要聚焦于其中的动物变形分支：即使用变形术变身为动物，以获得更强的机动性、与动物沟通的能力等等。\n而对于此分支变形术，当前学术界都认为其存在一个隐患：当使用者精神状态不稳定时，可能无法及时恢复人形。\n但在笔者看来，这项所谓的“隐患”，何尝不能在满足某些特殊需求时发挥妙用？\n试想，诸位还在学院中求学，面对众多课业论文考核时，是否羡慕过窗外的鸟，想要一走了之？\n诸位走入社会，面对生活与工作压力时，又是否羡慕过家中的猫，想要和它一样睡到昏天黑地？\n我们受人类身份桎梏、被困在世俗标准多久了？有时，我们甚至在想，进化对于我们这些个体真是好事吗？\n比起人类，我们或许更想实现退行，变回猴子！笔者认为，是时候该有一种魔法，帮助我们真正实现愿望了！\n因此笔者计划改良动物变形术，永远将自己变为猴子。当魔法研究成功的那一天，笔者一定要掀翻上司的办公桌……\n——当然，是用猴子的手掌！","status":"matched","document_title":"变成猴的魔法","document_title_cn":"变成猴的魔法","document_title_status":"matched"}},"speakers":{}},"locales/cn/ep7/env_story/17372038.json":{"asset_key":"ep7/env_story_17372038","episode":"ep7","category":"env_story","story_id":"17372038","schema_version":1,"lang":"cn","texts":{"say:0:1737203801:0":{"text":"“变成猴子的魔法”？听上去有些可疑……趁他离开，或许可以走近看看他究竟在研究些什么。","source_cn":"“变成猴子的魔法”？听上去有些可疑……趁他离开，或许可...","status":"matched_runtime_gender","hash_xxh64":"0xF46F5F4031E476F1","variant_status":"runtime_gender_keys_target_same","male":"“变成猴子的魔法”？听上去有些可疑……趁他离开，或许可以走近看看他究竟在研究些什么。","female":"“变成猴子的魔法”？听上去有些可疑……趁他离开，或许可以走近看看他究竟在研究些什么。","variant_male_record_index":"237158","variant_female_record_index":"237159","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:主角":{"text":"主角","source":"主角","status":"source"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/cn/ep7/env_story/17372039.json":{"asset_key":"ep7/env_story_17372039","episode":"ep7","category":"env_story","story_id":"17372039","schema_version":1,"lang":"cn","texts":{"say:0:1737203901:0":{"text":"……瞧瞧，魔法事务司又疯了一个魔法师。或许他们该添加一个提供心理辅导的岗位？","source_cn":"……瞧瞧，魔法事务司又疯了一个魔法师。或许他们该添加一...","status":"matched_runtime_gender","hash_xxh64":"0xCAB0A7AB8D089C0E","variant_status":"runtime_gender_keys_target_same","male":"……瞧瞧，魔法事务司又疯了一个魔法师。或许他们该添加一个提供心理辅导的岗位？","female":"……瞧瞧，魔法事务司又疯了一个魔法师。或许他们该添加一个提供心理辅导的岗位？","variant_male_record_index":"237160","variant_female_record_index":"237161","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:主角":{"text":"主角","source":"主角","status":"source"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"stories/ep7/env_story/17372038.graph.json":{"schema_version":1,"asset_key":"ep7/env_story_17372038","asset_path":"ep7/env_story/NodeCanvas__DialogueTree__ep7__env_story_17372038.decoded.json","episode":"ep7","category":"env_story","story_id":"17372038","roots":["line:0:say:1737203801:0"],"nodes":{"line:0:say:1737203801:0":{"id":"line:0:say:1737203801:0","type":"line","source_node_id":"0","source_node_type":"__DT.ActionNode","entry_kind":"say","dialogue_frame_type":"Slim","dialogue_frame_type_source":"","animation_set":"think","text_key"