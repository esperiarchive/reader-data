document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1310234003:0":{"text":"이 마법도 나름 열심히 연습한 건데... 금기에 대해 확인하는 걸 깜빡했네요...","source_cn":"其实我特地认真练习过这个法术，唯独忘了查看它的施法禁忌……","status":"matched","hash_xxh64":"0x3649DA49A87D36DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"이제 함부로 마법을 쓰면 안 돼","source_cn":"别再随意施法了","status":"matched_runtime_gender","hash_xxh64":"0x8E3B184B9B8EF6E0","variant_status":"runtime_gender_keys_target_same","male":"이제 함부로 마법을 쓰면 안 돼","female":"이제 함부로 마법을 쓰면 안 돼","variant_male_record_index":"68280","variant_female_record_index":"68281","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1310234004:0":{"text":"라이세움 입학시험에 네 번이나 떨어졌지만... 전 여전히 마법을 정말 좋아해요!","source_cn":"我……我考了四次都没考上莱希拉姆，可我真的很喜欢魔法啊！","status":"matched","hash_xxh64":"0x0BFB66B55090FD85","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:2:3":{"text":"마법을 체계적으로 배우는 게 좋겠어","source_cn":"你需要系统地学习魔法","status":"matched_runtime_gender","hash_xxh64":"0x31FAD114D6D1E0D2","variant_status":"runtime_gender_keys_target_same","male":"마법을 체계적으로 배우는 게 좋겠어","female":"마법을 체계적으로 배우는 게 좋겠어","variant_male_record_index":"68282","variant_female_record_index":"68283","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:魔法师维茨瓦夫":{"text":"마법사 비츠와프","source":"魔法师维茨瓦夫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"}},"stats":{"f