{"schema_version":1,"resources":{"locales/en/ep5/quest_story/15262010.json":{"asset_key":"ep5/quest_story_15262010","episode":"ep5","category":"quest_story","story_id":"15262010","schema_version":1,"lang":"en","texts":{"say:0:1526201001:0":{"text":"Help! Somebody, help us!","source_cn":"救命啊！来人啊！救命啊——！","status":"matched","hash_xxh64":"0x66BF3C62D38369E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1526201002:0":{"text":"Someone's in trouble!","source_cn":"有人在求救，过去看看。","status":"matched_runtime_gender","hash_xxh64":"0x3D3513C47253A44C","variant_status":"runtime_gender_keys_target_same","male":"Someone's in trouble!","female":"Someone's in trouble!","variant_male_record_index":"193764","variant_female_record_index":"193765","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:呼临居民":{"text":"Halian Citizen","source":"呼临居民","status":"matched_dialogue_flow"},"speaker:主角":{"text":"Player","source":"主角","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep5/quest_story/15262020.json":{"asset_key":"ep5/quest_story_15262020","episode":"ep5","category":"quest_story","story_id":"15262020","schema_version":1,"lang":"en","texts":{"say:0:1526202001:0":{"text":"Clear those things out first!","source_cn":"先击退它们！","status":"matched_runtime_gender","hash_xxh64":"0x0975159BC104860F","variant_status":"runtime_gender_keys_target_same","male":"Clear those things out first!","female":"Clear those things out first!","variant_male_record_index":"193766","variant_female_record_index":"193767","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:那非":{"text":"Nazrik","source":"那非","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep5/quest_story/15262030.json":{"asset_key":"ep5/quest_story_15262030","episode":"ep5","category":"quest_story","story_id":"15262030","schema_version":1,"lang":"en","texts":{"say:0:1526203001:0":{"text":"Destroy the locusts and protect them!","source_cn":"击败针蝗，保护这些人！","status":"matched_runtime_gender","hash_xxh64":"0xF706F0A05DE29F06","variant_status":"runtime_gender_keys_target_same","male":"Destroy the locusts and protect them!","female":"Destroy the locusts and protect them!","variant_male_record_index":"193768","variant_female_record_index":"193769","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:主角":{"text":"Player","source":"主角","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep5/quest_story/15262040.json":{"asset_key":"ep5/quest_story_15262040","episode":"ep5","category":"quest_story","story_id":"15262040","schema_version":1,"lang":"en","texts":{"say:3:1526204001:1":{"text":"We warned Halians to stay away from these fields. What are you doing here?","source_cn":"雅库伯尔已经警告过呼临，不准再靠近麦田。你们来做什么？","status":"matched","hash_xxh64":"0x14BC30A7D80D8612","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1526204002:1":{"text":"W-we just... took a wrong turn, that's all...","source_cn":"我、我们……不小心走错路了，就……","status":"matched","hash_xxh64":"0xB16CB6391170368B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1526204003:1":{"text":"Tell the truth!","source_cn":"说真话。","status":"matched","hash_xxh64":"0x63A1841F47E447FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1526204004:1":{"text":"We didn't steal anything! We weren't going to! Please, don't hurt us!","source_cn":"我们什么都没拿！不是，我们也没想拿什么！放过我们吧！","status":"matched","hash_xxh64":"0x822764868E22F4F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1526204005:1":{"text":"You <style=\"highlight\">came for the wheat</style>.","source_cn":"你们想<style=highlight>窃取小麦</s...","status":"matched","hash_xxh64":"0x48355959082921D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1526204006:1":{"text":"No... w-we didn't!","source_cn":"我……我们没有！","status":"matched","hash_xxh64":"0x4431C37415C18A64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1526204007:1":{"text":"Then what's in your bag?","source_cn":"那你包里的是什么？","status":"matched","hash_xxh64":"0x8FA9413002B5F542","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1526204008:1":{"text":"I'm sorry... W-we're starving. We couldn't take it anymore...","source_cn":"对不起……我、我们太饿了，实在受不了，只能……","status":"matched","hash_xxh64":"0xD4DD9FBF7D946325","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1526204009:1":{"text":"Starving? Mirehold sends wheat to Halia on schedule. How are you still going hungry?","source_cn":"饿？水泽营地一直按期将小麦送到呼临城，为什么你们还会挨饿？","status":"matched","hash_xxh64":"0xF6E950D5D5344639","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1526204010:1":{"text":"It's never enough. And what little share we get keeps getting smaller each time.","source_cn":"……你们送来的小麦太少了，分到我们手里的更是一次比一次少。","status":"matched","hash_xxh64":"0x6EE1674A6E02FED6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1526204011:1":{"text":"We're grateful to have anything at all, but with families as big as ours... it's never enough. Some of us still go hungry.","source_cn":"虽然说是有的吃就不错，但像我们这种家里孩子多的，难免还...","status":"matched","hash_xxh64":"0x9A8E632EF533BD8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1526204012:1":{"text":"Mirehold's harvest has been poor. The locusts sent by the fallen god are to blame.","source_cn":"水泽营地的麦田收成不好。这不是雅库伯尔的责任，而是因为...","status":"matched","hash_xxh64":"0x79B72C2F46E34D16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1526204013:1":{"text":"You saw them yourselves. This was the third swarm just today.","source_cn":"你们刚刚也看到了针蝗，它们已经是今天袭击水泽营地的第三波。","status":"matched","hash_xxh64":"0x25830F5879CC9D6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1526204014:1":{"text":"We know. But we didn't have any other choice.","source_cn":"……但是我们没有其他办法。","status":"matched","hash_xxh64":"0xF2C45BAB1187B985","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1526204015:1":{"text":"I... I can't let my child starve anymore. He's so small... he won't last.","source_cn":"我……我不能看着我的孩子再挨饿了，他那么瘦小……","status":"matched","hash_xxh64":"0x8BD2BCD6D5EBE102","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1526204016:1":{"text":"If someone has to be punished, take me! Just let her bring the wheat back to her kid.","source_cn":"你要抓就抓我吧！只求你让伊莲把小麦带回去，让她的孩子饱...","status":"matched","hash_xxh64":"0x7EAEA609452A09C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1526204017:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1526204018:1":{"text":"Grab your things and go out the side path.","source_cn":"拿上你们的包裹，走小路离开这里。","status":"matched","hash_xxh64":"0x05B92DA85552A9AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:21:1526204018":{"text":"Grab your things and go out the side path.","source_cn":"拿上你们的包裹，走小路离开这里。","status":"matched","hash_xxh64":"0x05B92DA85552A9AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1526204019:1":{"text":"You're... letting us go?","source_cn":"你……你要放我们走？！","status":"matched","hash_xxh64":"0x300D8CF1AD909274","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1526204020:1":{"text":"One condition: this stays between us. Don't tell anyone, Halian or Wildborn.","source_cn":"有一个要求：不准和任何人提起这件事。无论是呼临人，还是...","status":"matched","hash_xxh64":"0x3FFA222C38365304","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1526204021:1":{"text":"Break your word, and I'll find you with this spear—and you won't like the outcome.","source_cn":"如果你们食言，我会用这支矛追踪你们，让你们受到应受的惩罚。","status":"matched","hash_xxh64":"0x20CF9D04CB9BB424","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1526204022:1":{"text":"N-no! We won't tell a soul, I swear!","source_cn":"不不不！我们不会说的，我保证！","status":"matched","hash_xxh64":"0x0937620978749261","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1526204023:1":{"text":"Thank you... Thank you so much!","source_cn":"谢谢……谢谢你！","status":"matched","hash_xxh64":"0x742946175E21F8F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:21:0:1":{"text":"... What?","source_cn":"……嗯？！","status":"matched_runtime_gender","hash_xxh64":"0x2EF6DD60FF45EE28","variant_status":"runtime_gender_keys_target_same","male":"... What?","female":"... What?","variant_male_record_index":"80529","variant_female_record_index":"80530","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:那非":{"text":"Nazrik","source":"那非","status":"matched_dialogue_flow"},"speaker:呼临居民伊莲":{"text":"Elene","source":"呼临居民伊莲","status":"matched_dialogue_flow"},"speaker:呼临居民瓦罗":{"text":"Vailo","source":"呼临居民瓦罗","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":26,"localized_text_count":25,"speaker_count":3}},"locales/en/ep5/quest_story/15262050.json":{"asset_key":"ep5/quest_story_15262050","episode":"ep5","category":"quest_story","story_id":"15262050","schema_version":1,"lang":"en","texts":{"say:0:1526205001:0":{"text":"You actually let them go...? That's not like you, Nazrik.","source_cn":"你竟然放过了他们……这不像你的性格啊，那非。","status":"matched_runtime_gender","hash_xxh64":"0x4B08837298604CC0","variant_status":"runtime_gender_keys_target_same","male":"You actually let them go...? That's not like you, Nazrik.","female":"You actually let them go...? That's not like you, Nazrik.","variant_male_record_index":"193794","variant_female_record_index":"193795","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1526205002:0":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:主角":{"text":"Player","source":"主角","status":"matched_dialogue_flow"},"speaker:那非":{"text":"Nazrik","source":"那非","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep5/quest_story/15262060.json":{"asset_key":"ep5/quest_story_15262060","episode":"ep5","category":"quest_story","story_id":"15262060","schema_version":1,"lang":"en","texts":{"say:1:1526206001:0":{"text":"... Stop looking at me like that.","source_cn":"……别用那种奇怪的眼神盯着我。","status":"matched_runtime_gender","hash_xxh64":"0x037AFAA2AB848C57","variant_status":"runtime_gender_keys_target_same","male":"... Stop looking at me like that.","female":"... Stop looking at me like that.","variant_male_record_index":"193796","variant_female_record_index":"193797","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1526206001":{"text":"... Stop looking at me like that.","source_cn":"……别用那种奇怪的眼神盯着我。","status":"matched_runtime_gender","hash_xxh64":"0x037AFAA2AB848C57","variant_status":"runtime_gender_keys_target_same","male":"... Stop looking at me like that.","female":"... Stop looking at me like that.","variant_male_record_index":"193796","variant_female_record_index":"193797","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1526206002:0":{"text":"You've misunderstood me. I've always been like this.","source_cn":"恐怕你对我有误解，我一直都是这种性格，没变过。","status":"matched_runtime_gender","hash_xxh64":"0x2AC2207C2C8233D8","variant_status":"runtime_gender_keys_target_same","male":"You've misunderstood me. I've always been like this.","female":"You've misunderstood me. I've always been like this.","variant_male_record_index":"193798","variant_female_record_index":"193799","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1526206002":{"text":"You've misunderstood me. I've always been like this.","source_cn":"恐怕你对我有误解，我一直都是这种性格，没变过。","status":"matched_runtime_gender","hash_xxh64":"0x2AC2207C2C8233D8","variant_status":"runtime_gender_keys_target_same","male":"You've misunderstood me. I've always been like this.","female":"You've misunderstood me. I've always been like this.","variant_male_record_index":"193798","variant_female_record_index":"193799","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1526206003:0":{"text":"We are no longer at war. Any grudges left are theirs to sort out, not mine.","source_cn":"雅库伯尔和呼临城已经停战，若仍有仇怨，也是两方自己的事。","status":"matched_runtime_gender","hash_xxh64":"0x69CA272F2C879396","variant_status":"runtime_gender_keys_target_same","male":"We are no longer at war. Any grudges left are theirs to sort out, not mine.","female":"We are no longer at war. Any grudges left are theirs to sort out, not mine.","variant_male_record_index":"193800","variant_female_record_index":"193801","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1526206004:0":{"text":"And right now, we share the same enemy—the fallen God of Harvest.","source_cn":"但现在，我们共同的敌人是丰饶神，一位堕神。","status":"matched_runtime_gender","hash_xxh64":"0x53550BC0027B5CE6","variant_status":"runtime_gender_keys_target_same","male":"And right now, we share the same enemy—the fallen God of Harvest.","female":"And right now, we share the same enemy—the fallen God of Harvest.","variant_male_record_index":"193802","variant_female_record_index":"193803","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1526206005:0":{"text":"I followed you into Tuttleton and saw his cruelty with my own eyes.","source_cn":"跟踪你去图塔镇时，我亲眼见识到了他的残忍与邪恶。","status":"matched_runtime_gender","hash_xxh64":"0x7103DC4CF977C8EE","variant_status":"runtime_gender_keys_target_same","male":"I followed you into Tuttleton and saw his cruelty with my own eyes.","female":"I followed you into Tuttleton and saw his cruelty with my own eyes.","variant_male_record_index":"193804","variant_female_record_index":"193805","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1526206006:0":{"text":"... Though you understand it even better than I do.","source_cn":"……那种感受，恐怕你比我更清楚。","status":"matched_runtime_gender","hash_xxh64":"0x4976EE41A30AA168","variant_status":"runtime_gender_keys_target_same","male":"... Though you understand it even better than I do.","female":"... Though you understand it even better than I do.","variant_male_record_index":"193806","variant_female_record_index":"193807","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1526206006":{"text":"... Though you understand it even better than I do.","source_cn":"……那种感受，恐怕你比我更清楚。","status":"matched_runtime_gender","hash_xxh64":"0x4976EE41A30AA168","variant_status":"runtime_gender_keys_target_same","male":"... Though you understand it even better than I do.","female":"... Though you understand it even better than I do.","variant_male_record_index":"193806","variant_female_record_index":"193807","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1526206007:0":{"text":"Not pity.","source_cn":"不是同情。","status":"matched_runtime_gender","hash_xxh64":"0xC7F15AAEBC8C556B","variant_status":"runtime_gender_keys_target_same","male":"Not pity.","female":"Not pity.","variant_male_record_index":"193808","variant_female_record_index":"193809","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1526206008:0":{"text":"Let's just say... I see myself in them.","source_cn":"或许只是一点……感同身受。","status":"matched_runtime_gender","hash_xxh64":"0x8BB60954DD15D5EC","variant_status":"runtime_gender_keys_target_same","male":"Let's just say... I see myself in them.","female":"Let's just say... I see myself in them.","variant_male_record_index":"193810","variant_female_record_index":"193811","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1526206010:0":{"text":"Locusts ravaging Halia, beasts attacking the Wildborn... The fallen god behaves no differently than the Hunting Goddess did.","source_cn":"针蝗袭击呼临，野兽攻击雅库伯尔。丰饶神如今的行径，和狩...","status":"matched_runtime_gender","hash_xxh64":"0xBC729D5787DED77C","variant_status":"runtime_gender_keys_target_same","male":"Locusts ravaging Halia, beasts attacking the Wildborn... The fallen god behaves no differently than the Hunting Goddess did.","female":"Locusts ravaging Halia, beasts attacking the Wildborn... The fallen god behaves no differently than the Hunting Goddess did.","variant_male_record_index":"193814","variant_female_record_index":"193815","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1526206011:0":{"text":"Gods wielding their power to hurt mortals—this shouldn't be happening. Not again.","source_cn":"神凭借神威伤害凡人……这种事不该再发生。","status":"matched_runtime_gender","hash_xxh64":"0x265CAF9A83E7A076","variant_status":"runtime_gender_keys_target_same","male":"Gods wielding their power to hurt mortals—this shouldn't be happening. Not again.","female":"Gods wielding their power to hurt mortals—this shouldn't be happening. Not again.","variant_male_record_index":"193816","variant_female_record_index":"193817","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1526206012:0":{"text":"That's why I won't punish Halians for doing whatever they must to survive, at least not while the fallen god is still out there.","source_cn":"所以在丰饶神陨落之前，我不会苛责挣扎求活的呼临人。","status":"matched_runtime_gender","hash_xxh64":"0x9C8AC298B5DCF080","variant_status":"runtime_gender_keys_target_same","male":"That's why I won't punish Halians for doing whatever they must to survive, at least not while the fallen god is still out there.","female":"That's why I won't punish Halians for doing whatever they must to survive, at least not while the fallen god is still out there.","variant_male_record_index":"193818","variant_female_record_index":"193819","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1526206013:0":{"text":"Wanting to live isn't a crime.","source_cn":"想活下去，不是他们的罪。","status":"matched_runtime_gender","hash_xxh64":"0x9734B481FD67D57D","variant_status":"runtime_gender_keys_target_same","male":"Wanting to live isn't a crime.","female":"Wanting to live isn't a crime.","variant_male_record_index":"193820","variant_female_record_index":"193821","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"So you pity Halians now?","source_cn":"所以你很同情呼临人？","status":"matched_runtime_gender","hash_xxh64":"0x758EFADF53AA16BF","variant_status":"runtime_gender_keys_target_same","male":"So you pity Halians now?","female":"So you pity Halians now?","variant_male_record_index":"80539","variant_female_record_index":"80540","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1526206009:0":{"text":"Call it whatever you want.","source_cn":"随你怎么说吧。","status":"matched_runtime_gender","hash_xxh64":"0xAC8D8082E15B55F1","variant_status":"runtime_gender_keys_target_same","male":"Call it whatever you want.","female":"Call it whatever you want.","variant_male_record_index":"193812","variant_female_record_index":"193813","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"I didn't think you had that soft side.","source_cn":"看不出来你这么温柔","status":"matched_runtime_gender","hash_xxh64":"0x162C412668473192","variant_status":"runtime_gender_keys_target_same","male":"I didn't think you had that soft side.","female":"I didn't think you had that soft side.","variant_male_record_index":"80541","variant_female_record_index":"80542","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"Then why spare those Halians?","source_cn":"但你放跑了那些呼临人","status":"matched_runtime_gender","hash_xxh64":"0x2ADC12A5D1FB840C","variant_status":"runtime_gender_keys_target_same","male":"Then why spare those Halians?","female":"Then why spare those Halians?","variant_male_record_index":"80535","variant_female_record_index":"80536","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:1:2":{"text":"You never cared about them before.","source_cn":"你之前明明不在乎呼临人的死活","status":"matched_runtime_gender","hash_xxh64":"0x38620167C30809DA","variant_status":"runtime_gender_keys_target_same","male":"You never cared about them before.","female":"You never cared about them before.","variant_male_record_index":"80537","variant_female_record_index":"80538","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"You're not acting like yourself.","source_cn":"你好像和以前不一样了","status":"matched_runtime_gender","hash_xxh64":"0xDADF724C0A496E3D","variant_status":"runtime_gender_keys_target_same","male":"You're not acting like yourself.","female":"You're not acting like yourself.","variant_male_record_index":"80531","variant_female_record_index":"80532","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:1:2":{"text":"You've changed!","source_cn":"你怎么突然转性了！","status":"matched_runtime_gender","hash_xxh64":"0x21A5210F71D3D4C0","variant_status":"runtime_gender_keys_target_same","male":"You've changed!","female":"You've changed!","variant_male_record_index":"80533","variant_female_record_index":"80534","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:那非":{"text":"Nazrik","source":"那非","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":23,"localized_text_count":22,"speaker_count":1}}}}