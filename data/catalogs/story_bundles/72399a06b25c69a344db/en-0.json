{"schema_version":1,"resources":{"locales/en/mn3/quest_story/10137010.json":{"asset_key":"mn3/quest_story_10137010","episode":"mn3","category":"quest_story","story_id":"10137010","schema_version":1,"lang":"en","texts":{"say:0:1013701001:0":{"text":"I see the Sun Temple! Looks like we're on the right track!","source_cn":"从地下通道出来后，确实能看到日神殿的轮廓了，看来没走错路！","status":"matched","hash_xxh64":"0x9EB32F5DB3FF36BB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1013701002:0":{"text":"Aha, what would you do without a trusty guide like me!","source_cn":"也不看看你们的向导是谁。","status":"matched","hash_xxh64":"0xABAE599354A0A605","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013701003:0":{"text":"You weren't even the one who discovered the secret passage!","source_cn":"可我记得找到井底通道的并不是阿塔兰忒，而是主人！","status":"matched_runtime_gender","hash_xxh64":"0xE7F458A81F772804","variant_status":"runtime_gender_keys_target_same","male":"You weren't even the one who discovered the secret passage!","female":"You weren't even the one who discovered the secret passage!","variant_male_record_index":"115321","variant_female_record_index":"115322","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢修斯":{"text":"Lucius","source":"卢修斯","status":"matched_dialogue_flow"},"speaker:阿塔兰忒":{"text":"Atalanta","source":"阿塔兰忒","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":3}},"locales/en/mn3/quest_story/10137020.json":{"asset_key":"mn3/quest_story_10137020","episode":"mn3","category":"quest_story","story_id":"10137020","schema_version":1,"lang":"en","texts":{"say:1:1013702001:1":{"text":"Hold on. I hear something up ahead...","source_cn":"等等，停一下。听，前面有声音……","status":"matched","hash_xxh64":"0xC1DE6B6AED8BD69C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1013702002:1":{"text":"Well done. Being alert is a strong trait. We meet again, my worthy opponent.","source_cn":"呵，不错，保持警觉是强者的修养。又见到你们了，我的对手。","status":"matched","hash_xxh64":"0xE98448BAEDD591E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1013702003:1":{"text":"You keep showing up in front of me. Do you miss sparring with me? How thrilling!","source_cn":"你不断出现在我面前，是在怀念与我切磋的感觉吗？真是热血...","status":"matched_runtime_gender","hash_xxh64":"0xBB757BEB0FBB0892","variant_status":"runtime_gender_keys_target_same","male":"You keep showing up in front of me. Do you miss sparring with me? How thrilling!","female":"You keep showing up in front of me. Do you miss sparring with me? How thrilling!","variant_male_record_index":"115325","variant_female_record_index":"115326","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1013702004:1":{"text":"Come to my camp. Let's have another competition of strength!","source_cn":"我几乎能感受到你的魔咒勒紧我咽喉的感觉，去我的营地再战...","status":"matched_runtime_gender","hash_xxh64":"0x4BA5965793595DB9","variant_status":"runtime_gender_keys_target_same","male":"Come to my camp. Let's have another competition of strength!","female":"Come to my camp. Let's have another competition of strength!","variant_male_record_index":"115327","variant_female_record_index":"115328","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1013702005:1":{"text":"This guy is so weird... It's you who keeps popping up in front of us!","source_cn":"这家伙好不讲道理……明明是你不断出现在我们面前好不好！","status":"matched","hash_xxh64":"0xF661536E504B3636","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1013702006:1":{"text":"I have a feeling that what you're seeking might be found with me.","source_cn":"我有一种预感，你们所追寻的东西能在我那里获得启示。","status":"matched","hash_xxh64":"0xF50C675A9C24D7DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢修斯":{"text":"Lucius","source":"卢修斯","status":"matched_dialogue_flow"},"speaker:沙奎尔":{"text":"Shakir","source":"沙奎尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":3}},"locales/en/mn3/quest_story/10137030.json":{"asset_key":"mn3/quest_story_10137030","episode":"mn3","category":"quest_story","story_id":"10137030","schema_version":1,"lang":"en","texts":{"say:0:1013703001:0":{"text":"Let the battle begin!","source_cn":"开战吧，我的对手！","status":"matched_runtime_gender","hash_xxh64":"0x75C284C7CD3AEB4E","variant_status":"runtime_gender_keys_target_same","male":"Let the battle begin!","female":"Let the battle begin!","variant_male_record_index":"115331","variant_female_record_index":"115332","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1013703002:0":{"text":"Hold on, we just got here!","source_cn":"停停停，我们才刚过来而已！","status":"matched","hash_xxh64":"0x9CE1D94CF6DEC08A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:沙奎尔":{"text":"Shakir","source":"沙奎尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/mn3/quest_story/10137040.json":{"asset_key":"mn3/quest_story_10137040","episode":"mn3","category":"quest_story","story_id":"10137040","schema_version":1,"lang":"en","texts":{"say:1:1013704001:1":{"text":"Shakir! I've got orders from higher up.","source_cn":"沙奎尔！我带来了上面的命令。","status":"matched","hash_xxh64":"0x1455ACFB784DA39D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013704002:1":{"text":"You're to start guarding the camp's gates and prevent outsiders from getting near the Sun Temple—","source_cn":"这段时间，你要严守营地门户，防止闲杂人等接近日神殿——","status":"matched","hash_xxh64":"0xAF21FE331A2D307F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1013704003:2":{"text":"Outsiders? Are you talking about us?","source_cn":"闲杂人等？指的是我们吗？","status":"matched","hash_xxh64":"0xC1033C0BF1B447BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1013704004:1":{"text":"Huh?! Outsiders! Shakir, who are they?","source_cn":"嗯？！闲杂人等竟然就在这里！沙奎尔，他们是谁？","status":"matched","hash_xxh64":"0xC130F8E81BCA896B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1013704005:1":{"text":"They're my respected adversaries, possessing power beyond typical golems.","source_cn":"是我可敬的对手，拥有着超出普通魔偶的力量。","status":"matched","hash_xxh64":"0xDE956F27EC7ED5C9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1013704006:2":{"text":"Huh? Are you defying the Adamant Syndicate's orders? Seize them!","source_cn":"你这是要违抗黑金商会的命令吗？给我把他们抓起来！","status":"matched","hash_xxh64":"0x36B0194488942098","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:高傲的黑金掮客":{"text":"Proud Broker","source":"高傲的黑金掮客","status":"matched_dialogue_flow"},"speaker:卢修斯":{"text":"Lucius","source":"卢修斯","status":"matched_dialogue_flow"},"speaker:不耐烦的黑金掮客":{"text":"Impatient Broker","source":"不耐烦的黑金掮客","status":"matched_dialogue_flow"},"speaker:沙奎尔":{"text":"Shakir","source":"沙奎尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":4}},"locales/en/mn3/quest_story/10137060.json":{"asset_key":"mn3/quest_story_10137060","episode":"mn3","category":"quest_story","story_id":"10137060","schema_version":1,"lang":"en","texts":{"say:1:1013706001:1":{"text":"Ah, my friend. You're too good at stealing the limelight.","source_cn":"作为战友，你这样的强者令人不快，太会抢风头了。","status":"matched_runtime_gender","hash_xxh64":"0x7C64E6F3333B9250","variant_status":"runtime_gender_keys_target_same","male":"Ah, my friend. You're too good at stealing the limelight.","female":"Ah, my friend. You're too good at stealing the limelight.","variant_male_record_index":"115343","variant_female_record_index":"115344","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013706002:1":{"text":"One day, we'll settle the score. Don't expect me to go easy on you!","source_cn":"终有一天，我们会一决胜负。你可别指望我手下留情！","status":"matched_runtime_gender","hash_xxh64":"0x434A6D3AA424ECEB","variant_status":"runtime_gender_keys_target_same","male":"One day, we'll settle the score. Don't expect me to go easy on you!","female":"One day, we'll settle the score. Don't expect me to go easy on you!","variant_male_record_index":"115345","variant_female_record_index":"115346","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1013706002":{"text":"One day, we'll settle the score. Don't expect me to go easy on you!","source_cn":"终有一天，我们会一决胜负。你可别指望我手下留情！","status":"matched_runtime_gender","hash_xxh64":"0x434A6D3AA424ECEB","variant_status":"runtime_gender_keys_target_same","male":"One day, we'll settle the score. Don't expect me to go easy on you!","female":"One day, we'll settle the score. Don't expect me to go easy on you!","variant_male_record_index":"115345","variant_female_record_index":"115346","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1013706003:2":{"text":"Not now, Magister! We don't have time for this, we need to head to the Sun Temple as soon as possible.","source_cn":"不行啊，主人！我们要赶去日神殿，没时间在这里耽搁太久。","status":"matched_runtime_gender","hash_xxh64":"0x3B5D6DC5CF8EC1ED","variant_status":"runtime_gender_keys_target_same","male":"Not now, Magister! We don't have time for this, we need to head to the Sun Temple as soon as possible.","female":"Not now, Magister! We don't have time for this, we need to head to the Sun Temple as soon as possible.","variant_male_record_index":"115347","variant_female_record_index":"115348","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1013706005:0":{"text":"Hmph, what a letdown. But... the Sun Temple?","source_cn":"哼，真是扫兴。不过……日神殿吗？","status":"matched","hash_xxh64":"0xCF27EA427D3EF2D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1013706006:0":{"text":"During this journey, you might encounter the \"big guy\" before me.","source_cn":"那这一路上，说不定你们会比我先碰上“大家伙”呢。","status":"matched","hash_xxh64":"0xCAD4B1323CA864AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1013706007:2":{"text":"\"Big guy\"... What's that?","source_cn":"“大家伙”……那是什么东西？","status":"matched","hash_xxh64":"0x586AAB124582C52A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1013706008:2":{"text":"In the jungle, the strong are big and the weak are small. The \"big guy\" is apparently much stronger than regular golems.","source_cn":"大为强，小为弱，这是弱肉强食的天理。所谓大家伙，自然会...","status":"matched","hash_xxh64":"0x1506D1AD1F5C7507","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1013706008":{"text":"In the jungle, the strong are big and the weak are small. The \"big guy\" is apparently much stronger than regular golems.","source_cn":"大为强，小为弱，这是弱肉强食的天理。所谓大家伙，自然会比普通的魔偶强大许多。","status":"matched","hash_xxh64":"0x1506D1AD1F5C7507","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1013706009:1":{"text":"All I can say is, it's even more colossal than you can imagine. Just imagining facing that thing ignites my fighting spirit!","source_cn":"只能说比你们想象地还要巨大，面对那个东西，我的战意甚至...","status":"matched","hash_xxh64":"0x95F9D066AF7F7036","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1013706010:2":{"text":"Shakir, thank you for the information. We'll be cautious.","source_cn":"沙奎尔， 多谢你的告知。我们会小心谨慎的。","status":"matched","hash_xxh64":"0xFD620A3E44A63EE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1013706011:1":{"text":"No need for thanks. There's a camp ahead where I encountered the big guy once...","source_cn":"无需言谢。前方有一处营地，我曾在那里见过大家伙……","status":"matched","hash_xxh64":"0x98CCD2C471A452DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1013706012:1":{"text":"Stay safe until we meet again!","source_cn":"你们要保护好自己的性命，直到我们下次再见！","status":"matched","hash_xxh64":"0x1B7FC778A98930AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:17:1013706012":{"text":"Stay safe until we meet again!","source_cn":"你们要保护好自己的性命，直到我们下次再见！","status":"matched","hash_xxh64":"0x1B7FC778A98930AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1013706013:1":{"text":"Hmph! Don't underestimate me.","source_cn":"哼！不要太小看我。","status":"matched_runtime_gender","hash_xxh64":"0x3D6A2A9D47842EF9","variant_status":"runtime_gender_keys_target_same","male":"Hmph! Don't underestimate me.","female":"Hmph! Don't underestimate me.","variant_male_record_index":"115359","variant_female_record_index":"115360","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:0:1":{"text":"You too.","source_cn":"你也是","status":"matched_runtime_gender","hash_xxh64":"0x8DE49ABC3A128442","variant_status":"runtime_gender_keys_target_same","male":"You too.","female":"You too.","variant_male_record_index":"62384","variant_female_record_index":"62385","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"A ginormous golem?","source_cn":"大型魔偶？","status":"matched_runtime_gender","hash_xxh64":"0x2BDFE6C94CEE020C","variant_status":"runtime_gender_keys_target_same","male":"A ginormous golem?","female":"A ginormous golem?","variant_male_record_index":"62380","variant_female_record_index":"62381","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"Surely, they're big enough already...","source_cn":"超巨型魔偶？","status":"matched_runtime_gender","hash_xxh64":"0xF52BD8C0809379D6","variant_status":"runtime_gender_keys_target_same","male":"Surely, they're big enough already...","female":"Surely, they're big enough already...","variant_male_record_index":"62382","variant_female_record_index":"62383","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"We can settle it now if you want.","source_cn":"你要战便战","status":"matched_runtime_gender","hash_xxh64":"0xE0CD85784F1173C8","variant_status":"runtime_gender_keys_target_same","male":"We can settle it now if you want.","female":"We can settle it now if you want.","variant_male_record_index":"62376","variant_female_record_index":"62377","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1013706004:2":{"text":"Anyways, we gotta head to the Sun Temple now! Let's hurry!","source_cn":"对啊！我们要赶去日神殿，没时间在这里耽搁太久。","status":"matched_runtime_gender","hash_xxh64":"0x5305CDBF40BF3F22","variant_status":"runtime_gender_keys_target_same","male":"Anyways, we gotta head to the Sun Temple now! Let's hurry!","female":"Anyways, we gotta head to the Sun Temple now! Let's hurry!","variant_male_record_index":"115349","variant_female_record_index":"115350","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"I look forward to it.","source_cn":"现在不太方便","status":"matched_runtime_gender","hash_xxh64":"0xA7EF1733A2DEA740","variant_status":"runtime_gender_keys_target_same","male":"I look forward to it.","female":"I look forward to it.","variant_male_record_index":"62378","variant_female_record_index":"62379","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:沙奎尔":{"text":"Shakir","source":"沙奎尔","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:卢修斯":{"text":"Lucius","source":"卢修斯","status":"matched_dialogue_flow"},"speaker:特弥希娅":{"text":"Temesia","source":"特弥希娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":22,"localized_text_count":21,"speaker_count":4}},"locales/en/mn3/quest_story/10137070.json":{"asset_key":"mn3/quest_story_10137070","episode":"mn3","category":"quest_story","story_id":"10137070","schema_version":1,"lang":"en","texts":{"say:0:1013707001:0":{"text":"We're getting closer to the temple, but my heart is getting restless.","source_cn":"距离日神殿越来越近，但我的心里却是越来越不平静。","status":"matched","hash_xxh64":"0x2BB5F0CF8E6359B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1013707002:0":{"text":"Dura, please continue guiding me in this tough time.","source_cn":"艾雅在上，请给你的信徒指引迷津……","status":"matched","hash_xxh64":"0x08E1442AAB445B69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013707003:0":{"text":"Temesia, are you okay?","source_cn":"特弥希娅，你还好吗？","status":"matched","hash_xxh64":"0x753F966A4C4BF041","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1013707004:0":{"text":"I'm alright.","source_cn":"非常好，我已做好了准备。","status":"matched","hash_xxh64":"0x9353B9C440B52674","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_fe