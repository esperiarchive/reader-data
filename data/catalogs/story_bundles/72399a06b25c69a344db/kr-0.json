F966A4C4BF041","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1013707004:0":{"text":"아주 좋아. 난 준비됐어.","source_cn":"非常好，我已做好了准备。","status":"matched","hash_xxh64":"0x9353B9C440B52674","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1013707005:0":{"text":"...어떻게 해서든지 방법을 찾을 거야.","source_cn":"……无论如何，我总会想办法的。","status":"matched","hash_xxh64":"0xED92924E26D64435","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:特弥希娅":{"text":"테미히아","source":"特弥希娅","status":"matched_dialogue_flow"},"speaker:卢修斯":{"text":"루시우스","source":"卢修斯","status":"matched_dialogue_flow"},"speaker:阿塔兰忒":{"text":"아탈란테","source":"阿塔兰忒","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":3}},"locales/kr/mn3/quest_story/10137080.json":{"asset_key":"mn3/quest_story_10137080","episode":"mn3","category":"quest_story","story_id":"10137080","schema_version":1,"lang":"kr","texts":{"say:0:1013708001:0":{"text":"샤키르가 말한 영지가 이 블랙골드 영지겠죠?","source_cn":"沙奎尔说的，应该就是这片黑金营地吧？","status":"matched","hash_xxh64":"0xAAE2BB0FF3BF2E4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1013708002:0":{"text":"음... 안에 정말로 커다랗고 무서운 골렘이 있을까요?","source_cn":"唔……里面会有可怕的大魔偶吗？","status":"matched","hash_xxh64":"0x98121DAEBDF598F1","variant