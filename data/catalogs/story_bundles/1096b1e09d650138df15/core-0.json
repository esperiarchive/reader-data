{"schema_version":1,"resources":{"easter_eggs/graphs/14010323/document_213.json":{"schema_version":1,"asset_key":"easter_eggs/document_14010323_213","roots":["document:213"],"nodes":{"document:213":{"id":"document:213","type":"document","entry_kind":"document","text_key":"document:213","source_node_id":"14010323:1:2","next":"end"},"end":{"id":"end","type":"end"}},"text_entries":{"document:213":{"key":"document:213","kind":"document","textdes_id":"213","source_cn":"智者赫托！他以古树为柄，又以铁石山为锤头！\n铁与木交融，赫托将铁锤高举，打破坚石。\n闪电于锤击中连绵！\n智者赫托！矮人向他学习，矮人追随模仿！\n于是……愚昧被撕碎，长夜被智慧之光照亮！","document_title_cn":"锤声不息，智慧永恒"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1},"source":"Exact map-object document dispatch"},"easter_eggs/graphs/14010323/document_214.json":{"schema_version":1,"asset_key":"easter_eggs/document_14010323_214","roots":["document:214"],"nodes":{"document:214":{"id":"document:214","type":"document","entry_kind":"document","text_key":"document:214","source_node_id":"14010323:1:3","next":"end"},"end":{"id":"end","type":"end"}},"text_entries":{"document:214":{"key":"document:214","kind":"document","textdes_id":"214","source_cn":"感谢赫托！他以火山为炉，将泥土炼成钻石！\n风与火交缠，赫托之火愈发炙热，融化万物。\n万物于烈焰中重铸！\n 感谢赫托！矮人筑起的炉，亦是供奉他的坛。\n从此……世间炉火不熄，赫托之名亦将永存。","document_title_cn":"炉火不熄，信仰永存"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1},"source":"Exact map-object document dispatch"},"easter_eggs/graphs/14010323/document_215.json":{"schema_version":1,"asset_key":"easter_eggs/document_14010323_215","roots":["document:215"],"nodes":{"document:215":{"id":"document:215","type":"document","entry_kind":"document","text_key":"document:215","source_node_id":"14010323:1:4","next":"end"},"end":{"id":"end","type":"end"}},"text_entries":{"document:215":{"key":"document:215","kind":"document","textdes_id":"215","source_cn":"赞美赫托！他潜入无边深渊，将矿石带回！\n金与石分离，赫托祛除杂石，提取纯洁。\n宝剑锋利铠甲坚硬！\n赞美赫托！矮人牢记赫托，矮人铸成你的雕像。\n矮人……将以矿石作骨，大地为体，永铸你名。","document_title_cn":"矿石为骨，铸像铭记"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1},"source":"Exact map-object document dispatch"},"easter_eggs/locales/cn/14010323/document_213.json":{"schema_version":1,"asset_key":"easter_eggs/document_14010323_213","lang":"cn","texts":{"document:213":{"text":"智者赫托！他以古树为柄，又以铁石山为锤头！\n铁与木交融，赫托将铁锤高举，打破坚石。\n闪电于锤击中连绵！\n智者赫托！矮人向他学习，矮人追随模仿！\n于是……愚昧被撕碎，长夜被智慧之光照亮！","source_cn":"智者赫托！他以古树为柄，又以铁石山为锤头！\n铁与木交融，赫托将铁锤高举，打破坚石。\n闪电于锤击中连绵！\n智者赫托！矮人向他学习，矮人追随模仿！\n于是……愚昧被撕碎，长夜被智慧之光照亮！","status":"matched","document_title":"锤声不息，智慧永恒","document_title_cn":"锤声不息，智慧永恒","document_title_status":"matched"}},"speakers":{}},"easter_eggs/locales/cn/14010323/document_214.json":{"schema_version":1,"asset_key":"easter_eggs/document_14010323_214","lang":"cn","texts":{"document:214":{"text":"感谢赫托！他以火山为炉，将泥土炼成钻石！\n风与火交缠，赫托之火愈发炙热，融化万物。\n万物于烈焰中重铸！\n 感谢赫托！矮人筑起的炉，亦是供奉他的坛。\n从此……世间炉火不熄，赫托之名亦将永存。","source_cn":"感谢赫托！他以火山为炉，将泥土炼成钻石！\n风与火交缠，赫托之火愈发炙热，融化万物。\n万物于烈焰中重铸！\n 感谢赫托！矮人筑起的炉，亦是供奉他的坛。\n从此……世间炉火不熄，赫托之名亦将永存。","status":"matched","document_title":"炉火不熄，信仰永存","document_title_cn":"炉火不熄，信仰永存","document_title_status":"matched"}},"speakers":{}},"easter_eggs/locales/cn/14010323/document_215.json":{"schema_version":1,"asset_key":"easter_eggs/document_14010323_215","lang":"cn","texts":{"document:215":{"text":"赞美赫托！他潜入无边深渊，将矿石带回！\n金与石分离，赫托祛除杂石，提取纯洁。\n宝剑锋利铠甲坚硬！\n赞美赫托！矮人牢记赫托，矮人铸成你的雕像。\n矮人……将以矿石作骨，大地为体，永铸你名。","source_cn":"赞美赫托！他潜入无边深渊，将矿石带回！\n金与石分离，赫托祛除杂石，提取纯洁。\n宝剑锋利铠甲坚硬！\n赞美赫托！矮人牢记赫托，矮人铸成你的雕像。\n矮人……将以矿石作骨，大地为体，永铸你名。","status":"matched","document_title":"矿石为骨，铸像铭记","document_title_cn":"矿石为骨，铸像铭记","document_title_status":"matched"}},"speakers":{}},"easter_eggs/menus/14010323_1_6.cn.json":{"schema_version":1,"asset_key":"easter_eggs/menu_14010323:1:6","lang":"cn","texts":{"menu:7008330:2":{"text":"旧的颂诗唱腻了，该唱点新调子了。","source_cn":"旧的颂诗唱腻了，该唱点新调子了。<key:keyGender_dialog2>","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:工匠凯蕾莎":{"text":"工匠凯蕾莎","source":"工匠凯蕾莎","status":"exact_hash"}}},"easter_eggs/menus/14010323_1_6.graph.json":