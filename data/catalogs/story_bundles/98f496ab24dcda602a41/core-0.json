{"schema_version":1,"resources":{"catalogs/portraits/bindings/2b07706433e22627cdd8.json":{"line_overrides":[{"asset_key":"ep4/env_story_14345020","graph_node":"line:1:say:1434502001:1","model":"pbsc_char_monster_darkelfmage","requested_pose":"think","portrait_pose":"normal","source_clip":"pbsc_char_monster_darkelfmage_elite@normal","evidence":"portrait_review/easter_egg_portraits_20261104/recovery.json"}],"subtitle_bindings":[]},"easter_eggs/graphs/14010345/document_210.json":{"schema_version":1,"asset_key":"easter_eggs/document_14010345_210","roots":["document:210"],"nodes":{"document:210":{"id":"document:210","type":"document","entry_kind":"document","text_key":"document:210","source_node_id":"14010345:1:1","next":"end"},"end":{"id":"end","type":"end"}},"text_entries":{"document:210":{"key":"document:210","kind":"document","textdes_id":"210","source_cn":"尊敬而仁慈的女王陛下，\n您的谦卑的侍奉者，在此低头忏悔我所犯下的诸多……呃，罪孽。我忏悔，今日清晨，我在祈祷时，忍不住打了个哈欠。我真的不是不虔诚！只是昨天夜里偷吃了些点心，嘴里太甜，梦也太甜，睡得太沉……\n我忏悔，我不小心把您的神圣花园中的一朵花踩歪了！为了弥补过失，我用泥土扶正了它，还对它悄悄念了一句祝福语。我希望它不会告诉园丁……\n我忏悔，晚餐时丽娜祭司问是谁把供桌上的圣果拿走了……我当时没说话，但……其实那颗果子是被我捡起来擦了擦吃掉的！因为它已经掉到地上了，总不能浪费吧？（而且真的很好吃……）\n……","document_title_cn":"女王陛下，我忏悔……"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1},"source":"Exact map-object document dispatch"},"easter_eggs/locales/cn/14010345/document_210.json":{"schema_version":1,"asset_key":"easter_eggs/document_14010345_210","lang":"cn","texts":{"document:210":{"text":"尊敬而仁慈的女王陛下，\n您的谦卑的侍奉者，在此低头忏悔我所犯下的诸多……呃，罪孽。我忏悔，今日清晨，我在祈祷时，忍不住打了个哈欠。我真的不是不虔诚！只是昨天夜里偷吃了些点心，嘴里太甜，梦也太甜，睡得太沉……\n我忏悔，我不小心把您的神圣花园中的一朵花踩歪了！为了弥补过失，我用泥土扶正了它，还对它悄悄念了一句祝福语。我希望它不会告诉园丁……\n我忏悔，晚餐时丽娜祭司问是谁把供桌上的圣果拿走了……我当时没说话，但……其实那颗果子是被我捡起来擦了擦吃掉的！因为它已经掉到地上了，总不能浪费吧？（而且真的很好吃……）\n……","source_cn":"尊敬而仁慈的女王陛下，\n您的谦卑的侍奉者，在此低头忏悔我所犯下的诸多……呃，罪孽。我忏悔，今日清晨，我在祈祷时，忍不住打了个哈欠。我真的不是不虔诚！只是昨天夜里偷吃了些点心，嘴里太甜，梦也太甜，睡得太沉……\n我忏悔，我不小心把您的神圣花园中的一朵花踩歪了！为了弥补过失，我用泥土扶正了它，还对它悄悄念了一句祝福语。我希望它不会告诉园丁……\n我忏悔，晚餐时丽娜祭司问是谁把供桌上的圣果拿走了……我当时没说话，但……其实那颗果子是被我捡起来擦了擦吃掉的！因为它已经掉到地上了，总不能浪费吧？（而且真的很好吃……）\n……","status":"matched","document_title":"女王陛下，我忏悔……","document_title_cn":"女王陛下，我忏悔……","document_title_status":"matched"}},"speakers":{}},"easter_eggs/menus/14010345_1_2.cn.json":{"schema_version":1,"asset_key":"easter_eggs/menu_14010345:1:2","lang":"cn","texts":{"menu:8016850:1":{"text":"我的忏悔纸条哪去了……","source_cn":"我的忏悔纸条哪去了……","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:迷糊的祭司":{"text":"迷糊的祭司","source":"迷糊的祭司","status":"exact_hash"}}},"easter_eggs/menus/14010345_1_2.graph.json":{"schema_version":1,"asset_key":"easter_eggs/menu_14010345:1:2","roots":["menu:8016850:1"],"nodes":{"menu:8016850:1":{"id":"menu:8016850:1","type":"line","entry_kind":"say","source_node_id":"8016850:1","text_key":"menu:8016850:1","speaker_key":"speaker:迷糊的祭司","speaker_actor_id":"1182","dialogue_frame_type":"Normal","dialogue_frame_type_source":"MenuWorldState via DynamicDialogueAllNode.InitChoiceView","animation_set":"normal","next":"end","speaker_actor_model":"pbsc_char_monster_darkelfmage"},"end":{"id":"end","type":"end"}},"text_entries":{"menu:8016850:1":{"key":"menu:8016850:1","kind":"say","source_cn":"我的忏悔纸条哪去了……"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1},"source":"Verified NPC menu greeting before the selected task Plot"},"locales/cn/ep4/env_story/14345020.json":{"asset_key":"ep4/env_story_14345020","episode":"ep4","category":"env_story","story_id":"14345020","schema_version":1,"lang":"cn","texts":{"say:1:1434502001:1":{"text":"丢在哪里了……纸条可是要拿给丽娜祭司看的……","source_cn":"丢在哪里了……纸条可是要拿给丽娜祭司看的……","status":"matched_runtime_gender","hash_xxh64":"0x764B27F3833D2635","variant_status":"runtime_gender_keys_target_same","male":"丢在哪里了……纸条可是要拿给丽娜祭司看的……","female":"丢在哪里了……纸条可是要拿给丽娜祭司看的……","variant_male_record_index":"169269","variant_female_record_index":"169270","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1434502001":{"text":"丢在哪里了……纸条可是要拿给丽娜祭司看的……","source_cn":"丢在哪里了……纸条可是要拿给丽娜祭司看的