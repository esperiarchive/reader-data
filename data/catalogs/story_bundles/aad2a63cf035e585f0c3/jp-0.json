ent_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1311401006:1":{"text":"そうだね！帰ってお母さんのキノコスープを飲もうっと！","source_cn":"嗯，我要回去喝一大碗妈妈炖的蘑菇汤！","status":"matched","hash_xxh64":"0x694A18B892AB1C31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:亚历克斯":{"text":"アレックス","source":"亚历克斯","status":"matched_dialogue_flow"},"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":3}},"locales/jp/ep3/quest_story/13114020.json":{"asset_key":"ep3/quest_story_13114020","episode":"ep3","category":"quest_story","story_id":"13114020","schema_version":1,"lang":"jp","texts":{"say:1:1311402001:0":{"text":"なあ……俺たち、探検に行くんだよな？","source_cn":"那个……我记得我们说好要去探险？","status":"matched","hash_xxh64":"0x51817945A8CFC88F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1311402002:0":{"text":"う、うん、でもまだ食料や道具の準備が……","source_cn":"的确……不过我们还没有准备探险时的食物和工具……","status":"matched","hash_xxh64":"0xE588710349838AA5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1311402003:1":{"text":"それは祭典が終わってから……って、もう終わったの？","source_cn":"等祭典结束以后再……咦，祭典结束了吗？","status":"matched","hash_xxh64":"0x0D717146BBD4C3D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1311402004:1":{"text":"まだ始まったばかりじゃ……？","source_cn":"……不应该是刚开始没多久吗？","status":"matched","hash_xxh64":"0x7AA857E4CBFB8A02","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1311402005:0":{"text":"皆さんが無事で良かったです！","source_cn":"你们也没事了，太好了！","status":"matched","hash_xxh64":"0x6F3E429C348FAF7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1311402006:1":{"text":"え？何を言ってるんだ？一緒に雪合戦しただけだろう？","source_cn":"啊？你在说什么？呃，我记得咱们不是一起打过雪仗来着？","status":"matched","hash_xxh64":"0x5F8946719CB5113D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1311402007:0":{"text":"ですです！どうやら元に戻ったようですね！","source_cn":"不错，看来你们是真的恢复了！","status":"matched","hash_xxh64":"0xB84AEAFA62DE69E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:帕特里克":{"text":"パルトリク","source":"帕特里克","status":"matched_dialogue_flow"},"speaker:克什托夫":{"text":"クリストフ","source":"克什托夫","status":"matched_dialogue_flow"},"speaker:帕芙拉":{"text":"パフラー","source":"帕芙拉","status":"matched_dialogue_flow"},"speaker:薇丝莎娃":{"text":"ヴィスシャワ","source":"薇丝莎娃","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"ロンロン","source":"满满","status"