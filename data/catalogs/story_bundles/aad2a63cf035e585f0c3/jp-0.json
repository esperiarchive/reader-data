,"male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱赫":{"text":"ラーハ","source":"莱赫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}},"locales/jp/ep3/quest_story/13114040.json":{"asset_key":"ep3/quest_story_13114040","episode":"ep3","category":"quest_story","story_id":"13114040","schema_version":1,"lang":"jp","texts":{"say:0:1311404001:0":{"text":"皆さんまだ困惑していますが、ループからは解放されたようですね！","source_cn":"虽然大家都很迷茫，但好像都从循环中解放了！","status":"matched","hash_xxh64":"0xBF92168CAA6783B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1311404002:0":{"text":"よかった！次は氷像の所に行ってみましょう！","source_cn":"太好了，我们再去去冰雕那里看看情况！","status":"matched","hash_xxh64":"0xCD640FF702ADFE53","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/jp/ep3/quest_story/13114050.json":{"asset_key":"ep3/quest_story_13114050","episode":"ep3","category":"quest_story","story_id":"13114050","schema_version":1,"lang":"jp","texts":{"say:1:1311405001:0":{"text":"ヴェリカさん、ここにいたんですね！仲間の皆さんは……どうでしたか？","source_cn":"瓦丽卡，你也来这里了！你的那些战友们，他们……怎么样了？","status":"matched","hash_xxh64":"0xF08706C440F4E3EB","variant_status":"","male":"","