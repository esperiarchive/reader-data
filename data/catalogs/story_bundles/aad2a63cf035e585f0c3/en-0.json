{"schema_version":1,"resources":{"locales/en/ep3/quest_story/13114010.json":{"asset_key":"ep3/quest_story_13114010","episode":"ep3","category":"quest_story","story_id":"13114010","schema_version":1,"lang":"en","texts":{"say:1:1311401001:1":{"text":"Oh, you're back! Did you do everything at the festival?","source_cn":"呀，你们回来了！你们已经玩过所有的项目了吗？","status":"matched","hash_xxh64":"0x2E611A4322BCD0FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1311401002:1":{"text":"Well, sort of...","source_cn":"……呃，算是吧！","status":"matched","hash_xxh64":"0x9B0F8C7AB8A37FE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1311401003:1":{"text":"That was fast! It was fun making a snowman with you all. The snowball fight was fun, too! I came back and made more snowmen! I think I made...","source_cn":"真快啊！我和你们堆完雪人就去打雪仗，然后又回来堆雪人！...","status":"matched","hash_xxh64":"0xAF6BF04E4E47F7A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1311401004:1":{"text":"Wait... How many did I make...? Why can't I remember?","source_cn":"诶？我后来堆了几个雪人呢？怎么忘了……","status":"matched","hash_xxh64":"0x34297586D518541F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1311401005:1":{"text":"You must be tired! Why don't you go home first?","source_cn":"小朋友，你一定玩得很累了，还是先回家吧。","status":"matched","hash_xxh64":"0xF1E7DBC3ED9F5F9A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1311401006:1":{"text":"Oh yeah, I gotta get back. My mother said she'd made mushroom soup!","source_cn":"嗯，我要回去喝一大碗妈妈炖的蘑菇汤！","status":"matched","hash_xxh64":"0x694A18B892AB1C31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:亚历克斯":{"text":"Alex","source":"亚历克斯","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":3}},"locales/en/ep3/quest_story/13114020.json":{"asset_key":"ep3/quest_story_13114020","episode":"ep3","category":"quest_story","story_id":"13114020","schema_version":1,"lang":"en","texts":{"say:1:1311402001:0":{"text":"I remember we were planning to go on an adventure...","source_cn":"那个……我记得我们说好要去探险？","status":"matched","hash_xxh64":"0x51817945A8CFC88F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1311402002:0":{"text":"Yes, but we haven't prepared the food or equipment yet.","source_cn":"的确……不过我们还没有准备探险时的食物和工具……","status":"matched","hash_xxh64":"0xE588710349838AA5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1311402003:1":{"text":"Let's wait until after the festival. Oh... is the festival finished now?","source_cn":"等祭典结束以后再……咦，祭典结束了吗？","status":"matched","hash_xxh64":"0x0D717146BBD4C3D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1311402004:1":{"text":"Didn't the festival just start?","source_cn":"……不应该是刚开始没多久吗？","status":"matched","hash_xxh64":"0x7AA857E4CBFB8A02","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1311402005:0":{"text":"Great! You all are alright!","source_cn":"你们也没事了，太好了！","status":"matched","hash_xxh64":"0x6F3E429C348FAF7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1311402006:1":{"text":"Hmm...? What are you talking about? Wait, I remember you. We had a snowball fight together.","source_cn":"啊？你在说什么？呃，我记得咱们不是一起打过雪仗来着？","status":"matched","hash_xxh64":"0x5F8946719CB5113D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1311402007:0":{"text":"It looks like they've all recovered!","source_cn":"不错，看来你们是真的恢复了！","status":"matched","hash_xxh64":"0xB84AEAFA62DE69E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:帕特里克":{"text":"Padrick","source":"帕特里克","status":"matched_dialogue_flow"},"speaker:克什托夫":{"text":"Kristof","source":"克什托夫","status":"matched_dialogue_flow"},"speaker:帕芙拉":{"text":"Pavela","source":"帕芙拉","status":"matched_dialogue_flow"},"speaker:薇丝莎娃":{"text":"Livia","source":"薇丝莎娃","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":6}},"locales/en/ep3/quest_story/13114030.json":{"asset_key":"ep3/quest_story_13114030","episode":"ep3","category":"quest_story","story_id":"13114030","schema_version":1,"lang":"en","texts":{"say:1:1311403001:0":{"text":"Did I make a heart on the ice...?","source_cn":"我到底有没有在冰上滑出一个漂亮的、浪漫的心型啊……","status":"matched","hash_xxh64":"0xB36FECDD7786497C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1311403002:0":{"text":"It's so strange. I feel like I've been standing here for ages. My feet are numb. Maybe I'm just nervous...","source_cn":"好奇怪，总觉得我在这里站了好久。呼，脚都站麻了。我是太...","status":"matched","hash_xxh64":"0xEAB156FF3E48CBD6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1311403003:0":{"text":"Don't be nervous. Forget the heart. Just go propose!","source_cn":"不要紧张，别滑什么心型了，直接去求婚吧！","status":"matched","hash_xxh64":"0x0C2990E5044F78DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1311403004:0":{"text":"Shh, keep your voice down! Don't let her hear you. My Kaya is the most beautiful woman in all of Esperia...","source_cn":"嘘，小声点！别让卡娅听见……我的卡娅，全伊索米亚最美的...","status":"matched","hash_xxh64":"0xAD0D82DDB16A7A45","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1311403005:0":{"text":"Wait... Did I say this to you before?","source_cn":"呃，我总觉得我好像跟你说过这句话……","status":"matched","hash_xxh64":"0xF437664A62FAEAA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱赫":{"text":"Leif","source":"莱赫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}},"locales/en/ep3/quest_story/13114040.json":{"asset_key":"ep3/quest_story_13114040","episode":"ep3","category":"quest_story","story_id":"13114040","schema_version":1,"lang":"en","texts":{"say:0:1311404001:0":{"text":"Although everyone seems a bit confused, the time loop has ended!","source_cn":"虽然大家都很迷茫，但好像都从循环中解放了！","status":"matched","hash_xxh64":"0xBF92168CAA6783B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1311404002:0":{"text":"Yes, let's go check the ice sculpture again!","source_cn":"太好了，我们再去去冰雕那里看看情况！","status":"matched","hash_xxh64":"0xCD640FF702ADFE53","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep3/quest_story/13114050.json":{"asset_key":"ep3/quest_story_13114050","episode":"ep3","category":"quest_story","story_id":"13114050","schema_version":1,"lang":"en","texts":{"say:1:1311405001:0":{"text":"Valka, you're here! How are your companions doing?","source_cn":"瓦丽卡，你也来这里了！你的那些战友们，他们……怎么样了？","status":"matched","hash_xxh64":"0xF08706C440F4E3EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1311405002:0":{"text":"Thank you for your concern. A handful of them detect the changes in history while the majority of them are in a state of confusion.","source_cn":"谢谢你的关心，有少数人似乎也感觉到了历史的改变，但大部...","status":"matched","hash_xxh64":"0x6C8A62C4F412F61B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1311405003:0":{"text":"Perhaps this is their destiny. Yet, I believe they will all take heart in having vanquished such a formidable foe.","source_cn":"或许这就是他们的宿命吧。但我想他们都会很高兴……曾经战...","status":"matched","hash_xxh64":"0x21B666F415EA1201","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1311405003":{"text":"Perhaps this is their destiny. Yet, I believe they will all take heart in having vanquished such a formidable foe.","source_cn":"或许这就是他们的宿命吧。但我想他们都会很高兴……曾经战胜过那么强大的敌人。","status":"matched","hash_xxh64":"0x21B666F415EA1201","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1311405004:0":{"text":"It may seem a bit absurd, but I wished to behold my past self.","source_cn":"说出来也许很可笑，我只是想来看看过去的自己。","status":"matched","hash_xxh64":"0xCF5DB313A4013A41","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1311405006:0":{"text":"I've never set foot here throughout these many years. I've never looked the statue in the eye, nor could I face the respect bestowed by others...","source_cn":"这么多年以来，我从没来过这里。我知道自己不敢正视雕像的...","status":"matched","hash_xxh64":"0xB0739C0A6B75CF75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1311405007:0":{"text":"They called me a hero. What a heavy title to bear... I deemed myself unequal to what history has made me, and thus, I have spent two millenia like this...","source_cn":"英雄……多么沉重的称呼啊。过去的我自认无法扛起这个称谓...","status":"matched","hash_xxh64":"0xC4940FC387920934","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1311405008:0":{"text":"However, because of you, all has changed.","source_cn":"不过，多亏你们，这一切都不一样了。","status":"matched","hash_xxh64":"0xA41CDC28734A75BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1311405008":{"text":"However, because of you, all has changed.","source_cn":"不过，多亏你们，这一切都不一样了。","status":"matched","hash_xxh64":"0xA41CDC28734A75BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1311405009:0":{"text":"My choice... Thank you.","source_cn":"我自己吗……哈，谢谢你。","status":"matched","hash_xxh64":"0x71BDB671CC2F2D2F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1311405011:0":{"text":"I have at last proven worthy of the title and the honor the people have shown me. Henceforth, I vow to uphold their trust until the end of days.","source_cn":"我想，我终于可以承担起这个名字和这份敬意了。但愿未来，...","status":"matched","hash_xxh64":"0xE62D8724D655D941","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"This was your own choice.","source_cn":"这是你自己的选择","status":"matched_runtime_gender","hash_xxh64":"0x429DDD932EBDADAC","variant_status":"runtime_gender_keys_target_same","male":"This was your own choice.","female":"This was your own choice.","variant_male_record_index":"67836","variant_female_record_index":"67837","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1311405010:0":{"text":"It was my honor as well.","source_cn":"我也是。","status":"matched","hash_xxh64":"0x95943130E1C84AB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"I'm honored to fight by your side.","source_cn":"我很荣幸和你一起战斗","status":"matched_runtime_gender","hash_xxh64":"0x1207F11E72BEA503","variant_status":"runtime_gender_keys_target_same","male":"I'm honored to fight by your side.","female":"I'm honored to fight by your side.","variant_male_record_index":"67838","variant_female_record_index":"67839","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"What brings you here?","source_cn":"你来这里是……","status":"matched_runtime_gender","hash_xxh64":"0x3BE26FA9ABBB0ACD","variant_status":"runtime_gender_keys_target_same","male":"What brings you here?","female":"What brings you here?","variant_male_record_index":"67832","variant_female_record_index":"67833","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1311405005:0":{"text":"Not precisely reminiscing. I wanted to come here and see for myself.","source_cn":"谈不上回忆，只是……想来看看。","status":"matched","hash_xxh64":"0xAB9AC8C38BC581E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:1:2":{"text":"Are you reminiscing about the past?","source_cn":"你是来回忆过去吗？","status":"matched_runtime_gender","hash_xxh64":"0x7C538F5AE22CEC81","variant_status":"runtime_gender_keys_target_same","male":"Are you reminiscing about the past?","female":"Are you reminiscing about the past?","variant_male_record_index":"67834","variant_female_record_index":"67835","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:瓦丽卡":{"text":"Valka","source":"瓦丽卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":18,"localized_text_count":17,"speaker_count":2}}}}