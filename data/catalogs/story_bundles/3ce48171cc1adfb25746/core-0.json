"},"choice_prompt:8:1831514008":{"key":"choice_prompt:8:1831514008","kind":"choice_prompt","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1831514008","action_index":"","choice_index":"","choice_id":"","source_cn":"……够了，真的够了。这绝对是世界上最可怕的东西！你陷入了深深的纠结。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:9:1831514009:1":{"key":"say:9:1831514009:1","kind":"say","source_node_id":"9","source_node_type":"__DT.ActionNode","statementID":"1831514009","action_index":"1","choice_index":"","choice_id":"","source_cn":"你在脑海中回忆了一下这瓶药剂“生前”的模样，然后默默地...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:10:1831514010:1":{"key":"say:10:1831514010:1","kind":"say","source_node_id":"10","source_node_type":"__DT.ActionNode","statementID":"1831514010","action_index":"1","choice_index":"","choice_id":"","source_cn":"如果找回记忆的代价是喝下它，让千奇百怪的虫子在你的肚子...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"choice:8:0:1":{"key":"choice:8:0:1","kind":"choice","source_node_id":"8","source_node_type":"__DT.MultiChooseNode","statementID":"1831514001","action_index":"","choice_index":"0","choice_id":"1","source_cn":"坚决不喝！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:12:1831514011:1":{"key":"say:12:1831514011:1","kind":"say","source_node_id":"12","source_node_type":"__DT.ActionNode","statementID":"1831514011","action_index":"1","choice_index":"","choice_id":"","source_cn":"好吧，真正的勇士从不畏惧喝药，即使它是虫子制成的！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:13:1831514012:1":{"key":"say:13:1831514012:1","kind":"say","source_node_id":"13","source_node_type":"__DT.ActionNode","statementID":"1831514012","action_index":"1","choice_index":"","choice_id":"","source_cn":"你捏住鼻子，紧闭双眼，一口气将药剂灌入了口中……","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:14:1831514013:1":{"key":"say:14:1831514013:1","kind":"say","source_node_id":"14","source_node_type":"__DT.ActionNode","statementID":"1831514013","action_index":"1","choice_index":"","choice_id":"","source_cn":"你嘴里充斥着诡异古怪的味道，像是某种不可名状的深海生物...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:15:1831514014:1":{"key":"say:15:1831514014:1","kind":"say","source_node_id":"15","source_node_type":"__DT.ActionNode","statementID":"1831514014","action_index":"1","choice_index":"","choice_id":"","source_cn":"面对这样的酷刑，你居然没有晕倒。你简直要为自己的坚强而落泪。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:16:1831514015:1":{"key":"say:16:1831514015:1","kind":"say","source_node_id":"16","source_node_type":"__DT.ActionNode",