{"schema_version":1,"resources":{"easter_eggs/menus/16010361_1_2.en.json":{"schema_version":1,"asset_key":"easter_eggs/menu_16010361:1:2","lang":"en","texts":{"menu:11022770:1":{"text":"...","source_cn":"……","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:沉默的雕像":{"text":"Silent Statue","source":"沉默的雕像","status":"exact_hash"}}},"easter_eggs/menus/16010361_1_3.en.json":{"schema_version":1,"asset_key":"easter_eggs/menu_16010361:1:3","lang":"en","texts":{"menu:11022800:1":{"text":"Your tone is lovely, Christine.","source_cn":"声音很棒，克莉丝汀。","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:幽灵男子":{"text":"Ghostly Man","source":"幽灵男子","status":"exact_hash"}}},"locales/en/ep6/env_story/16311050.json":{"asset_key":"ep6/env_story_16311050","episode":"ep6","category":"env_story","story_id":"16311050","schema_version":1,"lang":"en","texts":{"say:0:1631105001:0":{"text":"Music... is eternal.","source_cn":"音乐……永不终结","status":"matched_runtime_gender","hash_xxh64":"0x0EFAE322033DBBD2","variant_status":"runtime_gender_keys_target_same","male":"Music... is eternal.","female":"Music... is eternal.","variant_male_record_index":"212024","variant_female_record_index":"212025","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1631105002:0":{"text":"Who said that? Was the statue talking...?","source_cn":"谁？难道是雕像在说话……","status":"matched_runtime_gender","hash_xxh64":"0x7588E4471297D0AE","variant_status":"runtime_gender_keys_target_same","male":"Who said that? Was the statue talking...?","female":"Who said that? Was the statue talking...?","variant_male_record_index":"212026","variant_female_record_index":"212027","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:沉默的雕像":{"text":"Silent Statue","source":"沉默的雕像","status":"matched_dialogue_flow"},"speaker:主角":{"text":"Player","source":"主角",