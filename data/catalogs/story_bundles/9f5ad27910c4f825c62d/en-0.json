"female":"\"Are you... here... for class...?\"","variant_male_record_index":"212032","variant_female_record_index":"212033","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1631107003":{"text":"\"Are you... here... for class...?\"","source_cn":"“你……也是……来上课的吗？”","status":"matched_runtime_gender","hash_xxh64":"0x3E2C23BD9CA856EB","variant_status":"runtime_gender_keys_target_same","male":"\"Are you... here... for class...?\"","female":"\"Are you... here... for class...?\"","variant_male_record_index":"212032","variant_female_record_index":"212033","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:6:1631107005:0":{"text":"The moment you nod, a powerful force pulls you in. The world blurs and twists around you.","source_cn":"在你点头的瞬间，一股强大的牵引力攫住了你, 周围的景物...","status":"matched_runtime_gender","hash_xxh64":"0xD799AFC2BC21785E","variant_status":"runtime_gender_keys_target_same","male":"The moment you nod, a powerful force pulls you in. The world blurs and twists around you.","female":"The moment you nod, a powerful force pulls you in. The world blurs and twists around you.","variant_male_record_index":"212036","variant_female_record_index":"212037","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:7:1631107006:0":{"text":"When your senses return, you find yourself somewhere completely unfamiliar.","source_cn":"当你的意识再次清晰，发现自己已身处一个完全陌生的地方。","status":"matched_runtime_gender","hash_xxh64":"0x26330AE14A71D75A","variant_status":"runtime_gender_keys_target_same","male":"When your senses return, you find yourself somewhere completely unfamiliar.","female":"When your senses return, you find yourself somewhere completely unfamiliar.","variant_male_record_index":"212038","variant_female_record_index":"212039","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"Yes, I am.","source_cn":"我是来上课的","status":"matched_runtime_gender","hash_xxh64":"0x6F0DDDA194EAE465","variant_status":"runtime_gender_keys_target_same","male":"Yes, I am.","female":"Yes, I am.","variant_male_record_index":"84967","variant_female_record_index":"84968","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1631107004:0":{"text":"\"Singing... the art of song.\"","source_cn":"“歌唱……艺术”","status":"matched_runtime_gender","hash_xxh64":"0xD99882E116934347","variant_status":"runtime_gender_keys_target_same","male":"\"Singing... the art of song.\"","female":"\"Singing... the art of song.\"","variant_male_record_index":"212034","variant_female_record_index":"212035","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:1:2":{"text":"What class?","source_cn":"什么课程？","status":"matched_runtime_gender","hash_xxh64":"0x4A0E47A4F6B6CA91","variant_status":"runtime_gender_keys_target_same","male":"What class?","female":"What class?","variant_male_record_index":"84969","variant_female_record_index":"84970","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"},"speaker:沉默的雕像":{"text":"Silent Statue","source":"沉默的雕像","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":3}},"locales/en/ep6/env_story/16311100.json":{"asset_key":"ep6/env_story_16311100","episode":"ep6","category":"env_story","story_id":"16311100","schema_version":1,"lang":"en","texts":{"say:2:1631110001:1":{"text":"But now we'll let it \"hang\". Don't trap the sound in your throat, or you'll tire yourself out.","source_cn":"不过我们现在要把它“挂”起来，别把声音堵在喉咙里，那样...","status":"matched","hash_xxh64":"0x5F21D5BFED4555E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1631110002:0":{"text":"I... I don't understand.","source_cn":"我……我不明白。","status":"matched","hash_xxh64":"0x64FDBDEE13D08264","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1631110003:1":{"text":"Heh. Try imagining the feeling of a yawn.","source_cn":"呵呵，你可以尝试一下打哈欠的感觉？","status":"matched","hash_xxh64":"0x8AD1CA2F9EE2EE76","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1631110004:1":{"text":"Haaa—","source_cn":"哈啊……","status":"matched","hash_xxh64":"0xC6BB19A61862BE1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1631110005:1":{"text":"Yes. Feel how your mouth opens, how the soft palate lifts? Hold that feeling, and try again.","source_cn":"对，感受一下那个口腔内部打开、软腭抬起来的感觉了吗？用...","status":"matched","hash_xxh64":"0xB6C0A5C1710D73B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1631110006:1":{"text":"La, la...","source_cn":"啦啦……","sta