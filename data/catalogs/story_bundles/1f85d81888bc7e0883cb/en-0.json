0x34DA3AB40C8D4172","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322227002:1":{"text":"I'd like to ask you to check on him.","source_cn":"我想拜托你去帮忙照看一下他的情况。","status":"matched","hash_xxh64":"0x89B819470C66A287","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322227003:1":{"text":"If he's truly sentient, carefully ask him if he remembers anything from before he passed away.","source_cn":"如果真的是这样的话，还请帮我问问看他是否还记得生前的事情。","status":"matched","hash_xxh64":"0x4F2049019342C497","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卡列琳娜":{"text":"Carolina","source":"卡列琳娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}},"locales/en/ep3/quest_story/13222280.json":{"asset_key":"ep3/quest_story_13222280","episode":"ep3","category":"quest_story","story_id":"13222280","schema_version":1,"lang":"en","texts":{"say:0:1322228001:0":{"text":"Look! That undead is sitting by the campfire! He should be the one we're looking for.","source_cn":"看！那个活死人坐在篝火边，应该就是他了！","status":"matched","hash_xxh64":"0x88AE3B28D8768CE6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322228002:0":{"text":"Let's go talk to him!","source_cn":"我们快上前探探他的情况！","status":"matched","hash_xxh64":"0xDB2A5464513959AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep3/quest_story/13222290.json":{"asset_key":"ep3/quest_story_13222290","episode":"ep3","category":"quest_story","story_id":"13222290","schema_version":1,"lang":"en","texts":{"say:1:1322229001:1":{"text":"I'm preparing dinner...","source_cn":"我在，准备晚餐……","status":"matched","hash_xxh64":"0xCE36620BEC46253B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322229002:1":{"text":"Trying to keep my mind clear...","source_cn":"保持……生活……清醒……","status":"matched","hash_xxh64":"0xC916313256995302","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322229003:1":{"text":"It's remarkable how he's maintaining his clarity by continuing the routines he had before death.","source_cn":"他似乎在通过保持生前的生活习惯来维持意志清醒的状态，真...","status":"matched","hash_xxh64":"0x6F7377FB6C9BE342","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322229004:1":{"text":"It's time for dinner... I need a fire... Oh, and some rice...","source_cn":"晚餐……生火……饭……","status":"matched","hash_xxh