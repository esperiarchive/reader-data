nowradish</style>. Simmer over medium heat until everything is cooked through.","female":"Start with some <style=\"highlight\">snowgem berries</style>, then toss in some thinly sliced <style=\"highlight\">snowradish</style>. Simmer over medium heat until everything is cooked through.","variant_male_record_index":"","variant_female_record_index":"","document_title":"Dinner Recipe","document_title_male":"Dinner Recipe","document_title_female":"Dinner Recipe","document_title_cn":"晚餐的配方","document_title_status":"matched"},"narration:7:1320820006:0":{"text":"After some time of mixing and blending...","source_cn":"经过一番调制……","status":"matched","hash_xxh64":"0x040752681A084A7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:9:1320820006:0":{"text":"After some time of mixing and blending...","source_cn":"经过一番调制……","status":"matched","hash_xxh64":"0x040752681A084A7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":4,"speaker_count":2}},"locales/en/ep3/quest_story/13222310.json":{"asset_key":"ep3/quest_story_13222310","episode":"ep3","category":"quest_story","story_id":"13222310","schema_version":1,"lang":"en","texts":{"say:0:1322231001:0":{"text":"Mmmhmm... smells delicious!","source_cn":"哇——闻起来好好吃！","status":"matched","hash_xxh64":"0xD6BB1D3489496283","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document