{"schema_version":1,"resources":{"faction_dailies/menus/14010537_1_2.en.json":{"schema_version":1,"asset_key":"faction_dailies/menu_14010537:1:2","lang":"en","texts":{"menu:8019790:1":{"text":"What else can I do to help the commoners?","source_cn":"我还能为平民做些什么呢？","status":"exact_duplicate_same"}},"speakers":{"speaker:莱索兰":{"text":"Celestine","source":"莱索兰","status":"exact_hash"}}},"faction_dailies/menus/14010537_1_4.en.json":{"schema_version":1,"asset_key":"faction_dailies/menu_14010537:1:4","lang":"en","texts":{"menu:8019790:2":{"text":"That was... fast.","source_cn":"这么快的吗……？","status":"exact_duplicate_same"}},"speakers":{"speaker:莱索兰":{"text":"Celestine","source":"莱索兰","status":"exact_hash"}}},"faction_dailies/menus/14010537_1_6.en.json":{"schema_version":1,"asset_key":"faction_dailies/menu_14010537:1:6","lang":"en","texts":{"menu:8019320:1":{"text":"Let's hope this inspires others to show their kindness.","source_cn":"希望大家能借此机会表达自己的善心。","status":"exact_duplicate_same"}},"speakers":{"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"exact_hash"}}},"faction_dailies/menus/14010537_1_8.en.json":{"schema_version":1,"asset_key":"faction_dailies/menu_14010537:1:8","lang":"en","texts":{"menu:8019320:3":{"text":"This is going better than I expected.","source_cn":"义捐进行得比想象中顺利。","status":"exact_duplicate_same"}},"speakers":{"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"exact_hash"}}},"locales/en/ep4/quest_story/14234560.json":{"asset_key":"ep4/quest_story_14234560","episode":"ep4","category":"quest_story","story_id":"14234560","schema_version":1,"lang":"en","texts":{"say:1:1423456001:1":{"text":"<style=\"stress\"><player_name></style>, Indris wants to host a fundraiser at the Queen's Statue. Time for the greedy nobles to give something back.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xCD912FD667B54971","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, Indris wants to host a fundraiser at the Queen's Statue. Time for the greedy nobles to give something back.","female":"<style=\"stress\"><player_name></style>, Indris wants to host a fundraiser at the Queen's Statue. Time for the greedy nobles to give something back.","variant_male_record_index":"171976","variant_female_record_index":"171977","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423456002:1":{"text":"He says one noble, Celestine, isn't cooperating. Could you talk to her and help move things along?","source_cn":"据他说，一个叫莱索兰的贵族不太配合……你能帮我劝劝这位...","status":"matched_runtime_gender","hash_xxh64":"0xD92EBEB5C94308A2","variant_status":"runtime_gender_keys_target_same","male":"He says one noble, Celestine, isn't cooperating. Could you talk to her and help move things along?","female":"He says one noble, Celestine, isn't cooperating. Could you talk to her and help move things along?","variant_male_record_index":"171978","variant_female_record_index":"171979","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:沙利叶":{"text":"Ravion","source":"沙利叶","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/ep4/quest_story/14234570.json":{"asset_key":"ep4/quest_story_14234570","episode":"ep4","category":"quest_story","story_id":"14234570","schema_version":1,"lang":"en","texts":{"say:2:1423457001:1":{"text":"Well, well. If it isn't the esteemed magister. What brings you here?","source_cn":"这位不是尊贵的魔法师大人吗？有什么事惊动您了？","status":"matched_runtime_gender","hash_xxh64":"0xBE95F2400546FD2A","variant_status":"runtime_gender_keys_target_same","male":"Well, well. If it isn't the esteemed magister. What brings you here?","female":"Well, well. If it isn't the esteemed magister. What brings you here?","variant_male_record_index":"171980","variant_female_record_index":"171981","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1423457001":{"text":"Well, well. If it isn't the esteemed magister. What brings you here?","source_cn":"这位不是尊贵的魔法师大人吗？有什么事惊动您了？","status":"matched_runtime_gender","hash_xxh64":"0xBE95F2400546FD2A","variant_status":"runtime_gender_keys_target_same","male":"Well, well. If it isn't the esteemed magister. What brings you here?","female":"Well, well. If it isn't the esteemed magister. What brings you here?","variant_male_record_index":"171980","variant_female_record_index":"171981","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423457002:1":{"text":"Ah, Indris mentioned it... Sorry, but as you can see, I'm busy fishing for the poor. I can't leave.","source_cn":"是因度厄说的那件事吧……实在抱歉，您也看到了，我正在为...","status":"matched_runtime_gender","hash_xxh64":"0xCD516D0B0B901308","variant_status":"runtime_gender_keys_target_same","male":"Ah, Indris mentioned it... Sorry, but as you can see, I'm busy fishing for the poor. I can't leave.","female":"Ah, Indris mentioned it... Sorry, but as you can see, I'm busy fishing for the poor. I can't leave.","variant_male_record_index":"171982","variant_female_record_index":"171983","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423457003:1":{"text":"If I don't catch a <style=\"highlight\">Rainwraith</style> today, the people I'm feeding will go hungry.","source_cn":"如果今天钓不上来一条<style=highlight>...","status":"matched","hash_xxh64":"0x4C6EFDBF8145445D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423457004:1":{"text":"Easy! We'll help you catch the fish. Gotta make sure you don't miss the fundraiser, right?","source_cn":"这简单，我们来帮你钓吧！尽快钓到鱼，才能让你不错过义捐...","status":"matched","hash_xxh64":"0xF3EE222518A5DB27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"Please show some generosity.","source_cn":"邀请你发扬善心","status":"matched_runtime_gender","hash_xxh64":"0x296D6314EA3FB10C","variant_status":"runtime_gender_keys_target_same","male":"Please show some generosity.","female":"Please show some generosity.","variant_male_record_index":"74430","variant_female_record_index":"74431","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"The fundraiser needs you.","source_cn":"邀请你参加义捐","status":"matched_runtime_gender","hash_xxh64":"0x845A619BF4F7C359","variant_status":"runtime_gender_keys_target_same","male":"The fundraiser needs you.","female":"The fundraiser needs you.","variant_male_record_index":"74432","variant_female_record_index":"74433","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱索兰":{"text":"Celestine","source":"莱索兰","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}},"locales/en/ep4/quest_story/14234580.json":{"asset_key":"ep4/quest_story_14234580","episode":"ep4","category":"quest_story","story_id":"14234580","schema_version":1,"lang":"en","texts":{"say:0:1423458001:0":{"text":"She's clearly stalling on purpose!","source_cn":"莱索兰就是在故意找借口拖延时间！","status":"matched","hash_xxh64":"0x0B8181B20DCF6467","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1423458002:0":{"text":"Let's catch that <style=\"highlight\">Rainwraith</style> and see what excuse she comes up with next!","source_cn":"等我们钓到<style=highlight>雨幽灵</...","status":"matched","hash_xxh64":"0x22627337C55D3EAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/ep4/quest_story/14234590.json":{"asset_key":"ep4/quest_story_14234590","episode":"ep4","category":"quest_story","story_id":"14234590","schema_version":1,"lang":"en","texts":{"say:0:1423459001:0":{"text":"Got one! Let's see what she says now!","source_cn":"钓到鱼啦！这下看她还有什么话说！","status":"matched","hash_xxh64":"0x1A13BFEF19C02953","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14234600.json":{"asset_key":"ep4/quest_story_14234600","episode":"ep4","category":"quest_story","story_id":"14234600","schema_version":1,"lang":"en","texts":{"say:2:1423460001:1":{"text":"You folks sure don't mess around when it comes to fishing...","source_cn":"几位钓鱼的速度真快啊……","status":"matched","hash_xxh64":"0x586845358CFD328B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423460002:1":{"text":"So you're free now, right? How about we head over there together?","source_cn":"这下你应该有空去参加募捐了吧？现在就出发怎么样！","status":"matched","hash_xxh64":"0x60A5685D1F9F9410","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423460003:1":{"text":"... Yes. Of course.","source_cn":"……那是当然了。","status":"matched","hash_xxh64":"0xB40D2EE636007CED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱索兰":{"text":"Celestine","source":"莱索兰","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}},"locales/en/ep4/quest_story/14234610.json":{"asset_key":"ep4/quest_story_14234610","episode":"ep4","category":"quest_story","story_id":"14234610","schema_version":1,"lang":"en","texts":{"say:0:1423461001:0":{"text":"You actually got Celestine to come. I'm impressed.","source_cn":"能把莱索兰请来，不愧是你。","status":"matched_runtime_gender","hash_xxh64":"0xCB941693F7CEA1F2","variant_status":"runtime_gender_keys_target_same","male":"You actually got Celestine to come. I'm impressed.","female":"You actually got Celestine to come. I'm impressed.","variant_male_record_index":"171992","variant_female_record_index":"171993","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep4/quest_story/14234620.json":{"asset_key":"ep4/quest_story_14234620","episode":"ep4","category":"quest_story","story_id":"14234620","schema_version":1,"lang":"en","texts":{"say:2:1423462001:1":{"text":"Indris, how's the fundraiser going?","source_cn":"因度厄，义捐进行的还顺利吗？","status":"matched","hash_xxh64":"0x340555A111A83AF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423462002:1":{"text":"It's going swimmingly thanks to you! Once Celestine arrived, even the stubborn nobles started showing up. We've raised a good amount already.","source_cn":"多亏你们，莱索兰来了之后，一些态度顽固的贵族也听到风声...","status":"matched","hash_xxh64":"0xCDBAAE30C7071235","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423462003:1":{"text":"A few nobles are still sitting on the fence, though... Could you bring them over? I'd like a word with them.","source_cn":"不过还是有几位贵族在远处观望……可以麻烦你把他们请上来...","status":"matched_runtime_gender","hash_xxh64":"0xE648A80F0D38F4FA","variant_status":"runtime_gender_keys_target_same","male":"A few nobles are still sitting on the fence, though... Could you bring them over? I'd like a word with them.","female":"A few nobles are still sitting on the fence, though... Could you bring them over? I'd like a word with them.","variant_male_record_index":"171996","variant_female_record_index":"171997","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}},"locales/en/ep4/quest_story/14234630.json":{"asset_key":"ep4/quest_story_14234630","episode":"ep4","category":"quest_story","story_id":"14234630","schema_version":1,"lang":"en","texts":{"say:0:1423463001:0":{"text":"Looks like a few more lords and ladies have joined us.","source_cn":"又有几位先生和女士来到了义捐现场。","status":"matched","hash_xxh64":"0x14033E964D8D2FD5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1423463002:0":{"text":"Your kindness is setting a strong example.","source_cn":"你们的善行一定会感动更多人。","status":"matched","hash_xxh64":"0xAC2567E7A6EB029F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/ep4/quest_story/14234640.json":{"asset_key":"ep4/quest_story_14234640","episode":"ep4","category":"quest_story","story_id":"14234640","schema_version":1,"lang":"en","texts":{"say:1:1423464001:1":{"text":"Everyone, Lady Celestine has made a generous contribution to the cause!","source_cn":"各位，莱索兰女士为本次募捐贡献了一份珍贵的善心！","status":"matched","hash_xxh64":"0x223DFC86B1C1370B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423464002:1":{"text":"... Well, you all know I've always cared deeply about the commoners. Thank you, Captain Indris, for this chance to help...","source_cn":"……大家都知道的，我一直十分关注平民的生活，感谢因度厄...","status":"matched","hash_xxh64":"0x58953BAAAA91AD81","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423464003:1":{"text":"And what about you, ladies and gentlemen? Care to join in?","source_cn":"这几位先生和女士，也对义捐感兴趣吗？","status":"matched","hash_xxh64":"0xFFDDF9E4ED47249B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423464004:1":{"text":"If Celestine is doing it... sure, why not?","source_cn":"连莱索兰都……那我也捐点吧。","status":"matched","hash_xxh64":"0x7D36A3C171161097","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423464005:1":{"text":"Fine, fine, you dragged me all the way here. I might as well donate!","source_cn":"既然你们都把我弄过来了……我捐还不行嘛！","status":"matched","hash_xxh64":"0xE240F3A7FE4788F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423464006:1":{"text":"Indris really knows how to work a crowd... I wonder where he picked that up from.","source_cn":"因度厄还真是手段老练啊！这做事的风格，跟谁学的呢……","status":"matched","hash_xxh64":"0x0EB9C297E4498F27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1423464007:1":{"text":"Probably all the hard jobs Ravion's been assigning lately. Compared to those, organizing a fundraiser is a breeze.","source_cn":"是因为工作的磨砺吧，最近沙利叶分给了我不少困难的工作，...","status":"matched","hash_xxh64":"0xD6EEFB7057E10A60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1423464008:1":{"text":"<style=\"stress\"><player_name></style>, none of this would've worked out so well without you.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xA2A84C09915DFCD1","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, none of this would've worked out so well without you.","female":"<style=\"stress\"><player_name></style>, none of this would've worked out so well without you.","variant_male_record_index":"172009","variant_female_record_index":"172010","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1423464009:1":{"text":"I know Ravion sent you. Allow me to thank you, on behalf of both of us.","source_cn":"我知道你们是受沙利叶所托，我代他向你们致以我们两人的谢意。","status":"matched","hash_xxh64":"0x894612AB65F38DC7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"matched_dialogue_flow"},"speaker:莱索兰":{"text":"Celestine","source":"莱索兰","status":"matched_dialogue_flow"},"speaker:旁观的贵族":{"text":"Onlooking Noble","source":"旁观的贵族","status":"matched_dialogue_flow"},"speaker:张望的贵族":{"text":"Peeking Noble","source":"张望的贵族","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"locali