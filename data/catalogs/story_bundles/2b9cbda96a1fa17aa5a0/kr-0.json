tle_female":"","document_title_cn":"","document_title_status":""},"say:3:1322222003:1":{"text":"<style=\"stress\"><player_name></style> 님, <style=\"highlight\">탄식의 호수</style>에 가서 증거로 삼을 수 있는 전사들의 물건을 찾아주실 수 있을까요? 조금이라도 있으면 오해를 풀 수 있을 거예요.","source_cn":"<style=stress><player_name>...","status":"matched","hash_xxh64":"0xAC2A6D868A2961C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卡列琳娜":{"text":"캐롤라이나","source":"卡列琳娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}},"locales/kr/ep3/quest_story/13222230.json":{"asset_key":"ep3/quest_story_13222230","episode":"ep3","category":"quest_story","story_id":"13222230","schema_version":1,"lang":"kr","texts":{"say:0:1322223001:0":{"text":"살아있는 시체가 몰려와요!","source_cn":"活死人围上来了！","status":"matched","hash_xxh64":"0x45AFAED70D5F98B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1322223002:0":{"text":"일단 처치해요!","source_cn":"先打败他们吧！","status":"matched","hash_xxh64":"0xF003F3B2501CFFAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/kr/ep3/quest_story/13222240.json":{"asset_key":"ep3/quest_story_13222240","episode":"ep3","category":"quest_story","story_id":"13222240","schema_version":1,"lang":"kr","texts":{"say:0:1322224001:0":{"text":"잔인하지만, 이렇게 그들의 고통도 끝날 거예요... 그들의 몸에서 증거를 찾아봐요.","source_cn":"虽然很残忍，但也结束了他们的痛苦……可以从他们身上寻找...","status":"matched","hash_xxh64":"0xD432B4A2309C0EE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/kr/ep3/quest_story/13222250.json":{"asset_key":"ep3/quest_story_13222250","episode":"ep3","category":"quest_story","story_id":"13222250","schema_version":1,"lang":"kr","texts":{"say:1:1322225001:1":{"text":"펜던트, 이름표... 이걸로 그들의 존재를 충분히 증명할 수 있을 거예요.","source_cn":"吊坠、名牌……好在还有这么多东西可以证明他们的存在。","status":"matched","hash_xxh64":"0x7EF74F14A7309F31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322225002:1":{"text":"이름이 보이지 않더라도 그들의 가족이라면 알아볼 수 있을지도 몰라요.","source_cn":"虽然已经看不清名字了，但说不定还有能认出它们的家人。","status":"matched","hash_xxh64":"0x2F8A66CF02E5359E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322225003:1":{"text":"심지어 무공을 증명하는 훈장을 가지고 있는 이들도 있어요!","source_cn":"甚至还有人随身带着勋章，证明着他们曾经的赫赫战功！","status":"matched","hash_xxh64":"0x0B662C1931F2ADB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322225004:1":{"text":"전사한 후에도 가슴에 붙어 있던 걸 보면 분명히 매우 소중히 여겼을 거예요.","source_cn":"这枚勋章在战死后都还贴在他的心口，一定是极为看重的。","status":"matched","hash_xxh64":"0xF12D8120FB69C44C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322225005:1":{"text":"어서 이 증거를 캐롤라이나에게 가져다 줘요!","source_cn":"我们快把这些证据带回给卡列琳娜吧！","status":"matched","hash_xxh64":"0x02D8123355FF095E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}},"locales/kr/ep3/quest_story/13222260.json":{"asset_key":"ep3/quest_story_13222260","episode":"ep3","category":"quest_story","story_id":"13222260","schema_version":1,"lang":"kr","texts":{"say:1:1322226001:1":{"text":"이렇게나 많은 증거를 찾아오시다니, 정말 대단해요.","source_cn":"你们能找来这么多证据真是太好了。","status":"matched","hash_xxh64":"0xFB591DE5C7932DE6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322226002:1":{"text":"이 물건들로 전사들의 신분을 증명할 수 있어요. 어쩌면 아직 남아있는 가문의 후손들이 알아볼 수도 있겠지요.","source_cn":"这些东西能够证明战士们的身份，说不定有依旧存续的姓氏能...","status":"matched","hash_xxh64":"0xB71A94A4041EA154","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322226003:1":{"text":"사람들의 인식을 완전히 뒤바꿀 수는 없을 지 몰라도 매우 강력한 증거가 될 거예요.","source_cn":"虽然不足以彻底颠覆人们的认知，但已经是很有力的证据了。","status":"matched","hash_xxh64":"0xC10D4C246347FDFC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322226004:1":{"text":"듀라 님이시여, 그레이브본과 인간이 평화롭게 공존할 날이 또 가까워졌네요.","source_cn":"艾雅在上，我们距离亡灵与人们和平共处的日子更近了一步。","status":"matched","hash_xxh64":"0xB2F1A1A63603591B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322226005:1":{"text":"감사합니다. 듀라 님의 가호가 함께하시기를.","source_cn":"感谢，愿艾雅保佑你们。","status":"matched","hash_xxh64":"0x8E3651FC726F58D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卡列琳娜":{"text":"캐롤라이나","source":"卡列琳娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":1}}}}