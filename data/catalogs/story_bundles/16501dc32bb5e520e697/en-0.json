ale":"","document_title_cn":"","document_title_status":""},"say:2:1322234002:1":{"text":"Perhaps they were disturbed, or something was troubling them. Either way, it's not a good sign.","source_cn":"也许他们被惊扰到了，也许正被什么困扰着。","status":"matched","hash_xxh64":"0xF94CF4C2CBA718B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322234003:1":{"text":"I'm really worried they might be in conflict with the undead. Could you please go see what's going on?","source_cn":"我害怕他们因此与活死人发生冲突，可以拜托你前去看看吗？","status":"matched","hash_xxh64":"0xDF4D642600136AC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卡列琳娜":{"text":"Carolina","source":"卡列琳娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}},"locales/en/ep3/quest_story/13222350.json":{"asset_key":"ep3/quest_story_13222350","episode":"ep3","category":"quest_story","story_id":"13222350","schema_version":1,"lang":"en","texts":{"say:0:1322235001:0":{"text":"Look! I see a couple of gruglins over there! They should be the ones Carolina was talking about.","source_cn":"快看，是几只雪地咕布林！他们的叫声很凄厉，卡列琳娜说的...","status":"matched","hash_xxh64":"0x9A22F2AF210964BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep3/quest_story/13222360.json":{"asset_key":"ep3/q