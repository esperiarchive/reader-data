itle_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:3:1533402002:1":{"key":"say:3:1533402002:1","kind":"say","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"1533402002","action_index":"1","choice_index":"","choice_id":"","source_cn":"没错，就是这座美妙的、精巧的、宏伟的、堪称奇迹的桥！","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:4:1533402004:1":{"key":"say:4:1533402004:1","kind":"say","source_node_id":"4","source_node_type":"__DT.ActionNode","statementID":"1533402004","action_index":"1","choice_index":"","choice_id":"","source_cn":"哎，看来你对这座桥的认知还是太过浅薄。","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:5:1533402005:1":{"key":"say:5:1533402005:1","kind":"say","source_node_id":"5","source_node_type":"__DT.ActionNode","statementID":"1533402005","action_index":"1","choice_index":"","choice_id":"","source_cn":"你看，我能否占用一点你的时间？我想自己给你讲一讲这座桥...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","document_icon":"","document_image_icon":"","document_base_image":"","document_pic":"","document_gender":""},"say:6:1533402006:1":{"key":"say:6:1533402006:1","kind":"say","source_node_id":"6","source_node_type":"__DT.ActionNode","statementID":"1533402006","action_index":"1","choice_index":"","choice_id":"","source_cn":"在天地形成后，在呼临和雅库伯尔人诞生前，塔欧妥斯深壑就...","textdes_id":"","document_page_count":"","document_title_cn":"","document_order":"","document_object_id":"","document_item_id":"","docu