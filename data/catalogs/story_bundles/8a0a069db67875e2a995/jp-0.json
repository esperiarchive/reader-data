ument_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1027505006:1":{"text":"よ、よかった！よかったわ！ミリー！聞いた？病気が治るのよ！","source_cn":"太、太好了，太好了太好了！米利！！听到了吗！你的病有救了！","status":"matched","hash_xxh64":"0xAE20C4F0FB95D7A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1027505007:1":{"text":"ミサタ様の恩恵に感謝します！ありがとうございます！この世のすべてに感謝します！ああ！私の願いが叶ったのね！","source_cn":"感谢弥萨忒的恩赐，感谢您，感谢一切，天啊，我的愿望实现了——","status":"matched","hash_xxh64":"0x0BAC7731D789C02A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1027505008:1":{"text":"ちょっと待て！","source_cn":"——等一下。","status":"matched","hash_xxh64":"0x815599D3D58F1F88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1027505008":{"text":"ちょっと待て！","source_cn":"——等一下。","status":"matched","hash_xxh64":"0x815599D3D58F1F88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1027505009:1":{"text":"お喜びのところに水を差すようで悪いんだが、このお宝はアタシがいただくぜ！","source_cn":"抱歉啊，在别人喜极而泣的时候泼冷水——但是，这份宝藏，...","status":"matched","hash_xxh64":"0xBEB8D3F5351941E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1027