{"schema_version":1,"resources":{"locales/en/mn2/quest_story/10275020.json":{"asset_key":"mn2/quest_story_10275020","episode":"mn2","category":"quest_story","story_id":"10275020","schema_version":1,"lang":"en","texts":{"say:2:1027502001:1":{"text":"Quit messing around and get out of the way. This is the final location of the Deer Spirit's treasure, not some commoner's fair.","source_cn":"别闹了，赶紧把路让开，这里是鹿灵宝藏的最终所在地，不是...","status":"matched","hash_xxh64":"0x54D5D62391599542","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1027502002:1":{"text":"I've worked hard to get here—I had to deal with that goofy rabbit, and I even almost lost my gemstone...","source_cn":"我可是辛辛苦苦一路闯关，不得不跟笨蛋兔子斗嘴，还差点失...","status":"matched","hash_xxh64":"0xBCAD4EE9A6CA62DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1027502003:1":{"text":"All you and your buddy did was follow me, and now you want a piece of the pie? That's not how the world works.","source_cn":"你带着你的伙伴跟上来就想分一杯羹，世界上可没这种好事哦？","status":"matched","hash_xxh64":"0x3B38765E5917F395","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1027502004:1":{"text":"I didn't follow you! I found it according to the legend!","source_cn":"我没有跟着你！我是按照传说找到的——","status":"matched","hash_xxh64":"0xBE171A80F02CBD7B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1027502005:1":{"text":"Who's she calling a goofy rabbit?!","source_cn":"谁、谁、谁是笨蛋兔子啊！！","status":"matched","hash_xxh64":"0x4463F69BE2ECA4B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1027502005":{"text":"Who's she calling a goofy rabbit?!","source_cn":"谁、谁、谁是笨蛋兔子啊！！","status":"matched","hash_xxh64":"0x4463F69BE2ECA4B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1027502006:1":{"text":"I stayed one step ahead to get the treasure, and these two suddenly appeared out of thin air, trying to steal it.","source_cn":"你说呢？本来还以为先到一步就能先拿走宝藏，没想到这两位...","status":"matched_runtime_gender","hash_xxh64":"0x01DED34C7042898B","variant_status":"runtime_gender_keys_target_same","male":"I stayed one step ahead to get the treasure, and these two suddenly appeared out of thin air, trying to steal it.","female":"I stayed one step ahead to get the treasure, and these two suddenly appeared out of thin air, trying to steal it.","variant_male_record_index":"109602","variant_female_record_index":"109603","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1027502007:1":{"text":"Wait, are they the other treasure hunters that Big Ears hinted at earlier?!","source_cn":"……等等，不会兔耳朵你之前提到的什么竞争者，就是这两个...","status":"matched","hash_xxh64":"0x907DAC9D243B6087","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1027502008:1":{"text":"No way! You're the thief trying to steal the Deer Spirit's treasure!","source_cn":"才不是！明明是你！是你想盗取鹿灵宝藏！","status":"matched","hash_xxh64":"0x92C9DA654FF64E61","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1027502009:1":{"text":"Yolanda... don't do this... don't fight with her for me.","source_cn":"约兰达……别，别这样……别为了我，和她吵架……","status":"matched","hash_xxh64":"0x84F8CFF004310D84","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1027502010:1":{"text":"*Cough*! *Cough, cough, cough*!","source_cn":"——咳！咳咳咳！","status":"matched","hash_xxh64":"0x7E5B942274E555F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1027502011:1":{"text":"Billie! Don't get up... just rest, please. I promise you, we won't fight.","source_cn":"米利！你……你别起来，在旁边好好休息。我答应你，不吵架...","status":"matched","hash_xxh64":"0x144CA2C1A963C4D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1027502012:1":{"text":"That's more like it.","source_cn":"嗯，这才对。","status":"matched","hash_xxh64":"0x826CD485744A95AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1027502013:1":{"text":"I'm a treasure hunter who plays by the rules. I use my senses, intelligence, and agility to get what I want without stealing.","source_cn":"我是遵纪守法，凭借嗅觉、头脑和行动力寻找宝物的猎人，才...","status":"matched","hash_xxh64":"0x7CD9E875FFB61866","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1027502014:1":{"text":"You Wilders have said that the treasure is first come, first serve.","source_cn":"你们绿裔的人可是说过，这里的宝物本来就是先到先得——","status":"matched","hash_xxh64":"0x7A4FEF20D351BAF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1027502015:1":{"text":"Stop twisting our words!\nLyca clearly stated that it would be Misarte's will as to whoever is worthy of the treasure.","source_cn":"不要曲解别人的意思！\\n莱卡说的明明是，无论谁能获取，...","status":"matched","hash_xxh64":"0x88BE7E7F3242EBB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1027502016:1":{"text":"Close enough. But anyway, it doesn't matter.","source_cn":"无所谓啦，差不多。","status":"matched","hash_xxh64":"0xB13F607F7BE447D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1027502017:0":{"text":"Come and have a look at the puzzle—there's nothing, it's just a blank slate.","source_cn":"你们倒是来看看这里的谜题——一片空白，什么都没有哦。","status":"matched","hash_xxh64":"0x4391B265DC2B69CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1027502018:0":{"text":"That's strange... the other carvings all had hints of some kind.","source_cn":"这可真是怪了……其他雄鹿木雕都有提示，这里不该什么都没有啊。","status":"matched","hash_xxh64":"0x15F0534596B07E32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1027502019:0":{"text":"There are no signs of erosion... Think, Lorsan, have we missed something?","source_cn":"周围也没有风化的痕迹……洛桑，你再好好想想，我们是不是...","status":"matched","hash_xxh64":"0x4C9836F68A0013A5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:29:1027502019":{"text":"There are no signs of erosion... Think, Lorsan, have we missed something?","source_cn":"周围也没有风化的痕迹……洛桑，你再好好想想，我们是不是遗漏了什么。","status":"matched","hash_xxh64":"0x4C9836F68A0013A5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1027502020:0":{"text":"How do you think? I bet they were following someone and taking shortcuts.","source_cn":"还能怎么来，当然是跟着别人抄近路喽？","status":"matched","hash_xxh64":"0x4A1617A73674F8B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1027502021:0":{"text":"Hey, I already told you! We weren't following you, we actually found this place by following the legend of the Deer Spirit!","source_cn":"我、我都说了！我们是根据鹿灵宝藏的传说，确认了最后地点...","status":"matched","hash_xxh64":"0x3FCE80F4401B48AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:34:1027502021":{"text":"Hey, I already told you! We weren't following you, we actually found this place by following the legend of the Deer Spirit!","source_cn":"我、我都说了！我们是根据鹿灵宝藏的传说，确认了最后地点的存在……","status":"matched","hash_xxh64":"0x3FCE80F4401B48AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1027502022:0":{"text":"Where sparks of light dance on the ethereal shores of Lunnos Lake, seek the Deer Spirit's carving, solve the mystery of the Antlers, and kindle your faith in exchange for your heart's wish...","source_cn":"流荧栖息之周，飘渺月湖之岸，寻觅鹿灵之雕，破解鹿角之谜...","status":"matched","hash_xxh64":"0xD034C82D4A479A5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1027502023:1":{"text":"The first two lines indicate the location of the stag carving, the middle two lines refer to the method of finding the treasure, and the last two lines read, <style=\"highlight\">\"Kindle your faith, in exchange for your heart's wish.\"</style>","source_cn":"前两句是在指示雄鹿木雕的位置，中间两句是指寻找宝藏的方...","status":"matched","hash_xxh64":"0xA19FE9B7308183AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1027502024:1":{"text":"So it's with devout hearts that Billie and I have carved our path here!","source_cn":"所以，我和米利就是凭借着虔诚之心，一路磨砺才努力走到这里的！","status":"matched","hash_xxh64":"0x1E7B9785B4FD3189","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:38:1027502024":{"text":"So it's with devout hearts that Billie and I have carved our path here!","source_cn":"所以，我和米利就是凭借着虔诚之心，一路磨砺才努力走到这里的！","status":"matched","hash_xxh64":"0x1E7B9785B4FD3189","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1027502025:1":{"text":"It's gotta be! We usually pray for blessings by making wishes in front of the Deerspirit Altar.","source_cn":"……有道理！我们平时祈求赐福，都是在鹿灵祭坛前虔诚许下...","status":"matched","hash_xxh64":"0x9FFD0E6C368684E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1027502026:1":{"text":"Hmph, see? There's no way a faithless treasure hunter could've solved that, right?","source_cn":"哼哼，完全不知道虔诚和信仰为何物的宝藏猎人，根本不可能...","status":"matched","hash_xxh64":"0x3944E12EEF62C991","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1027502027:1":{"text":"Alright, let's give it a try!","source_cn":"好了，我们快点试一下吧！","status":"matched","hash_xxh64":"0x07CBE7E9DA1874CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:38:0:1":{"text":"Faith... heart's wish...","source_cn":"虔诚之心……换取……","status":"matched_runtime_gender","hash_xxh64":"0xEE043B5D63979807","variant_status":"runtime_gender_keys_target_same","male":"Faith... heart's wish...","female":"Faith... heart's wish...","variant_male_record_index":"61308","variant_female_record_index":"61309","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:38:1:2":{"text":"Could it be a prayer?","source_cn":"会不会是祈祷？","status":"matched_runtime_gender","hash_xxh64":"0x262D997FC78F1250","variant_status":"runtime_gender_keys_target_same","male":"Could it be a prayer?","female":"Could it be a prayer?","variant_male_record_index":"61310","variant_female_record_index":"61311","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:34:0:1":{"text":"What did that poem say again?","source_cn":"那首诗是怎么说的来着？","status":"matched_runtime_gender","hash_xxh64":"0xE048FC678C2E78D4","variant_status":"runtime_gender_keys_target_same","male":"What did that poem say again?","female":"What did that poem say again?","variant_male_record_index":"61306","variant_female_record_index":"61307","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:29:0:1":{"text":"Yolanda, how'd you get here?","source_cn":"约兰达，你是怎样找到这的？","status":"matched_runtime_gender","hash_xxh64":"0xAD5D667BFF3EE139","variant_status":"runtime_gender_keys_target_same","male":"Yolanda, how'd you get here?","female":"Yolanda, how'd you get here?","variant_male_record_index":"61304","variant_female_record_index":"61305","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"What a coincidence.","source_cn":"真是巧遇啊","status":"matched_runtime_gender","hash_xxh64":"0xCBF2905A8EC77B2F","variant_status":"runtime_gender_keys_target_same","male":"What a coincidence.","female":"What a coincidence.","variant_male_record_index":"61300","variant_female_record_index":"61301","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"What are you arguing about?","source_cn":"你们在吵什么？","status":"matched_runtime_gender","hash_xxh64":"0xF002EBBAC433E898","variant_status":"runtime_gender_keys_target_same","male":"What are you arguing about?","female":"What are you arguing about?","variant_male_record_index":"61302","variant_female_record_index":"61303","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:阿塔兰忒":{"text":"Atalanta","source":"阿塔兰忒","status":"matched_dialogue_flow"},"speaker:月湖村民约兰达":{"text":"Villager Yolanda","source":"月湖村民约兰达","status":"matched_dialogue_flow"},"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"},"speaker:月湖村民米利":{"text":"Villager Billie","source":"月湖村民米利","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":38,"localized_text_count":37,"speaker_count":5}},"locales/en/mn2/quest_story/10275050.json":{"asset_key":"mn2/quest_story_10275050","episode":"mn2","category":"quest_story","story_id":"10275050","schema_version":1,"lang":"en","texts":{"say:2:1027505001:1":{"text":"They really exist... the legendary <style=\"highlight\">Tears of Misarte</style>.","source_cn":"居然真的存在……传说中的<style=highligh...","status":"matched","hash_xxh64":"0x7DED09C0DFBE8771","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1027505002:1":{"text":"It's said while roaming in the Dark Forest, the Deer Spirit was so moved by its beauty that its tears fell and transformed into magical flora.","source_cn":"据说，鹿灵在薄暮丛林中漫游时，被此处的生机所感动，流淌...","status":"matched","hash_xxh64":"0x562129E8EB762B35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1027505003:1":{"text":"Many refer to this precious gift as the Resurrection Grass, for it can cure all ailments and even ward off death...","source_cn":"它又被称为弥生露草，因为它能够起死回生，包治百病……","status":"matched","hash_xxh64":"0x53F69F1734E2C028","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1027505003":{"text":"Many refer to this precious gift as the Resurrection Grass, for it can cure all ailments and even ward off death...","source_cn":"它又被称为弥生露草，因为它能够起死回生，包治百病……","status":"matched","hash_xxh64":"0x53F69F1734E2C028","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1027505004:1":{"text":"To be clear, the grass cannot reverse death, but rather restore a gravely ill person to full health, given that they still draw breath.","source_cn":"严格来说，不能逆转生死，但是濒死者只要还有一口气，凭借...","status":"matched","hash_xxh64":"0x9B5342510590B818","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1027505006:1":{"text":"This is... amazing! Billie, do you hear that? You're going to live!","source_cn":"太、太好了，太好了太好了！米利！！听到了吗！你的病有救了！","status":"matched","hash_xxh64":"0xAE20C4F0FB95D7A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1027505007:1":{"text":"Endless thanks to Misarte, to the forest, to everyone and everything... my wish has come true!","source_cn":"感谢弥萨忒的恩赐，感谢您，感谢一切，天啊，我的愿望实现了——","status":"matched","hash_xxh64":"0x0BAC7731D789C02A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1027505008:1":{"text":"Hold on a second.","source_cn":"——等一下。","status":"matched","hash_xxh64":"0x815599D3D58F1F88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1027505008":{"text":"Hold on a second.","source_cn":"——等一下。","status":"matched","hash_xxh64":"0x815599D3D58F1F88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1027505009:1":{"text":"Sorry to rain on your parade... but I'm taking the treasure.","source_cn":"抱歉啊，在别人喜极而泣的时候泼冷水——但是，这份宝藏，...","status":"matched","hash_xxh64":"0xBEB8D3F5351941E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1027505011:1":{"text":"No! This is Billie's only hope!","source_cn":"不、不行，这是米利活下去的希望，绝对不能给你！","status":"matched","hash_xxh64":"0x9DBD528072AC824C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1027505012:1":{"text":"I'm sorry it's come to this, little girl, and though you might not believe me... I understand your plight more than anyone...","source_cn":"……抱歉，这么说你多半也不会相信，但是，小姑娘，你的心...","status":"matched","hash_xxh64":"0x7FBCC591917317E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1027505013:1":{"text":"And for that reason, I must have it.","source_cn":"所以，正因如此，我绝对不会放手。","status":"matched","hash_xxh64":"0xB1471ED084E5CB52","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1027505014:1":{"text":"Why the shocked faces? Isn't it normal for there to be quarrels at the end of a treasure hunt when there isn't enough to go around?","source_cn":"别露出那种表情嘛，各位，在寻宝之后分赃不均——好吧，分...","status":"matched","hash_xxh64":"0xA0F92156C3EB93DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:18:1027505014":{"text":"Why the shocked faces? Isn't it normal for there to be quarrels at the end of a treasure hunt when there isn't enough to go around?","source_cn":"别露出那种表情嘛，各位，在寻宝之后分赃不均——好吧，分配不均而起内讧的情况不是很正常吗？","status":"matched","hash_xxh64":"0xA0F92156C3EB93DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1027505015:1":{"text":"That's... no one's business but my own.","source_cn":"……这和我们要争夺的东西无关吧。","status":"matched_runtime_gender","hash_xxh64":"0x6DDDA3DFBC3D4C2E","variant_status":"runtime_gender_keys_target_same","male":"That's... no one's business but my own.","female":"That's... no one's business but my own.","variant_male_record_index":"109640","variant_female_record_index":"109641","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1027505015":{"text":"That's... no one's business but my own.","source_cn":"……这和我们要争夺的东西无关吧。","status":"matched_runtime_gender","hash_xxh64":"0x6DDDA3DFBC3D4C2E","variant_status":"runtime_gender_keys_target_same","male":"That's... no one's business but my own.","female":"That's... no one's business but my own.","variant_male_record_index":"109640","variant_female_record_index":"109641","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1027505016:1":{"text":"It's... not possible.\nEven though it appears to be grass, these are the Tears of Misarte—essentially a dewdrop infused with divine power, which cannot be split apart.","source_cn":"当、当然不可能……\\n虽然是草的样子，但这是弥萨忒的泪...","status":"matched","hash_xxh64":"0x0C82E5D882CE5158","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1027505017:1":{"text":"Additionally, if they leave Misarte's protection, they'll evaporate instantly. This means that the Resurrection Grass can't be taken out of the forest.","source_cn":"一旦试图分开就会化为雾气，回归丛林。如果离开弥萨忒的守...","status":"matched","hash_xxh64":"0x3913CA8AA4E83B2A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:25:1027505017":{"text":"Additionally, if they leave Misarte's protection, they'll evaporate instantly. This means that the Resurrection Grass can't be taken out of the forest.","source_cn":"一旦试图分开就会化为雾气，回归丛林。如果离开弥萨忒的守护范围，也会瞬间蒸发……","status":"matched","hash_xxh64":"0x3913CA8AA4E83B2A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1027505018:1":{"text":"That's right, the blessings of Misarte have long been infused with the plants of the Dark Forest. Treasures like this will gradually lose their effectiveness with distance, even at the forest's edge.","source_cn":"是的，弥萨忒的祝福早已浸润在薄暮丛林的植物当中，像这种...","status":"matched","hash_xxh64":"0x81935652D5BE23EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1027505019:1":{"text":"When I took two pots of common herbs away from the Dark Forest as a child, they withered instantly, losing their evergreen hues.","source_cn":"我当年离开丛林的时候，带了两盆普通的花。结果在路上就枯...","status":"matched","hash_xxh64":"0x16C31565F77C30FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:30:1027505019":{"text":"When I took two pots of common herbs away from the Dark Forest as a child, they withered instantly, losing their evergreen hues.","source_cn":"我当年离开丛林的时候，带了两盆普通的花。结果在路上就枯萎了，不像在薄暮丛林一样常青……","status":"matched","hash_xxh64":"0x16C31565F77C30FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1027505020:1":{"text":"It... can't leave this forest...?","source_cn":"……不能带走……","status":"matched","hash_xxh64":"0x1440ED3AF7EC3116","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1027505021:1":{"text":"Alas, I suppose I'll be charitable here and give up my claim.\nIt seems occasionally, learning some devout details would prevent making a fool of oneself.","source_cn":"唉，枉做恶人。\\n看起来这些虔诚的知识偶尔学上一点儿，...","status":"matched","hash_xxh64":"0x14D373E00AC73A7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1027505022:1":{"text":"Never mind. Wilder girl, you take it. I hope your friend recovers soon.","source_cn":"算了，绿裔的妹子，你拿走吧，希望你的朋友早日恢复健康。","status":"matched","hash_xxh64":"0xF35B0DFC79A34F90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1027505023:0":{"text":"It's time I leave...","source_cn":"我先走了……","status":"matched","hash_xxh64":"0x78F8D4F4D0C116F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:37:1027505023":{"text":"It's time I leave...","source_cn":"我先走了……","status":"matched","hash_xxh64":"0x78F8D4F4D0C116F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1027505024:1":{"text":"It's fine, it's all yours.","source_cn":"都归你了。","status":"matched_runtime_gender","hash_xxh64":"0x69546B10B3DB075F","variant_status":"runtime_gender_keys_target_same","male":"It's fine, it's all yours.","female":"It's fine, it's all yours.","variant_male_record_index":"109650","variant_female_record_index":"109651","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:39:1027505024":{"text":"It's fine, it's all yours.","source_cn":"都归你了。","status":"matched_runtime_gender","hash_xxh64":"0x69546B10B3DB075F","variant_status":"runtime_gender_keys_target_same","male":"It's fine, it's all yours.","female":"It's fine, it's all yours.","variant_male_record_index":"109650","variant_female_record_index":"109651","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1027505025:1":{"text":"Ha... You saw through me yet again.","source_cn":"……哈。又被你看穿了。","status":"matched_runtime_gender","hash_xxh64":"0x00557EEFE1D0FC84","variant_status":"runtime_gender_keys_target_same","male":"Ha... You saw through me yet again.","female":"Ha... You saw through me yet again.","variant_male_record_index":"109652","variant_female_record_index":"109653","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1027505026:1":{"text":"I can't have what I want, and the rest of the treasures are meaningless to me.","source_cn":"没错，我想要的东西无法得手，剩下的这些也不值得讨价还价。","status":"matched_runtime_gender","hash_xxh64":"0x21C26A7EBAA82449","variant_status":"runtime_gender_keys_target_same","male":"I can't have what I want, and the rest of the treasures are meaningless to me.","female":"I can't have what I want, and the rest of the treasures are meaningless to me.","variant_male_record_index":"109654","variant_female_record_index":"109655","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1027505027:1":{"text":"So I, most generously, leave it to you—call it a reward for your wisdom and acumen.","source_cn":"所以就大方送给你了——就当是为了感谢你的敏锐和智慧吧。","status":"matched_runtime_gender","hash_xxh64":"0xF4224A15483FB61A","variant_status":"runtime_gender_keys_target_same","male":"So I, most generously, leave it to you—call it a reward for your wisdom and acumen.","female":"So I, most generously, leave it to you—call it a reward for your wisdom and acumen.","variant_male_record_index":"109656","variant_female_record_index":"109657","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1027505028:1":{"text":"Ah, yes, and something for you two...\nHere, catch!","source_cn":"啊，对了对了，有东西要给你们……\\n嘿！接好了！","status":"matched","hash_xxh64":"0x5B429003EE2D76E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1027505029:1":{"text":"Is this... a gemstone?","source_cn":"这个是………宝石？","status":"matched","hash_xxh64":"0x4C3C19084AEA166C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:45:1027505029":{"text":"Is this... a gemstone?","source_cn":"这个是………宝石？","status":"matched","hash_xxh64":"0x4C3C19084AEA166C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1027505030:1":{"text":"You've got a good eye.","source_cn":"眼光不错。","status":"matched","hash_xxh64":"0x49B27D8139C1AD12","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1027505031:1":{"text":"Think of it as a token of good luck from me to you.","source_cn":"就当是恭贺恢复健康的贺礼吧，贵重点不好吗？","status":"matched","hash_xxh64":"0x83C5025F773CF301","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1027505032:1":{"text":"Well, I'll leave you to it, then. Farewell!","source_cn":"那么，我先走了，告辞！","status":"matched","hash_xxh64":"0xC615AFBCE223283D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:45:0:1":{"text":"The gem used in the offering!","source_cn":"是那块作为祭品的宝石","status":"matched_runtime_gender","hash_xxh64":"0x48439AC418BEEC54","variant_status":"runtime_gender_keys_target_same","male":"The gem used in the offering!","female":"The gem used in the offering!","variant_male_record_index":"61336","variant_female_record_index":"61337","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:45:1:2":{"text":"Doesn't it mean a lot to you?","source_cn":"你不是很珍惜这个吗？","status":"matched_runtime_gender","hash_xxh64":"0xE760C3D16CA17B75","variant_status":"runtime_gender_keys_target_same","male":"Doesn't it mean a lot to you?","female":"Doesn't it mean a lot to you?","variant_male_record_index":"61338","variant_female_record_index":"61339","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:39:0:1":{"text":"There's nothing else you want?","source_cn":"这里没有你想要的了？","status":"matched_runtime_gender","hash_xxh64":"0x80B499BBD25DCB00","variant_status":"runtime_gender_keys_target_same","male":"There's nothing else you want?","female":"There's nothing else you want?","variant_male_record_index":"61334","variant_female_record_index":"61335","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:37:0:1":{"text":"Not interested in other riches?","source_cn":"剩下的宝贝，你不要了？","status":"matched_runtime_gender","hash_xxh64":"0xC6464730FC8ADFA7","variant_status":"runtime_gender_keys_target_same","male":"Not interested in other riches?","female":"Not interested in other riches?","variant_male_record_index":"61330","variant_female_record_index":"61331","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:37:1:2":{"text":"We did agree to split things equally.","source_cn":"竟然对其他财富无动于衷","status":"matched_runtime_gender","hash_xxh64":"0xE098B0AE1B0244C6","variant_status":"runtime_gender_keys_target_same","male":"We did agree to split things equally.","female":"We did agree to split things equally.","variant_male_record_index":"61332","variant_female_record_index":"61333","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:30:0:1":{"text":"Atalanta, you heard her.","source_cn":"阿塔兰忒，你听到了","status":"matched_runtime_gender","hash_xxh64":"0x6371670A32D5AF7A","variant_status":"runtime_gender_keys_target_same","male":"Atalanta, you heard her.","female":"Atalanta, you heard her.","variant_male_record_index":"61326","variant_female_record_index":"61327","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:30:1:2":{"text":"Are you gonna keep fighting?","source_cn":"还要继续争夺吗？","status":"matched_runtime_gender","hash_xxh64":"0x3B4208A22B678F47","variant_status":"runtime_gender_keys_target_same","male":"Are you gonna keep fighting?","female":"Are you gonna keep fighting?","variant_male_record_index":"61328","variant_female_record_index":"61329","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:0:1":{"text":"It can only be used in the forest?","source_cn":"只能在丛林内使用？","status":"matched_runtime_gender","hash_xxh64":"0x97E14414DA4D2141","variant_status":"runtime_gender_keys_target_same","male":"It can only be used in the forest?","female":"It can only be used in the forest?","variant_male_record_index":"61324","variant_female_record_index":"61325","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:0:1":{"text":"Lyca, can't it be split equally?","source_cn":"莱卡，它可以平分吗？","status":"matched_runtime_gender","hash_xxh64":"0xCC84CC0F1B7A456E","variant_status":"runtime_gender_keys_target_same","male":"Lyca, can't it be split equally?","female":"Lyca, can't it be split equally?","variant_male_record_index":"61322","variant_female_record_index":"61323","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:0:1":{"text":"You need to save someone, too?","source_cn":"你也有想要救的人吗？","status":"matched_runtime_gender","ha