{"schema_version":1,"resources":{"easter_eggs/graphs/16010414/document_465.json":{"schema_version":1,"asset_key":"easter_eggs/document_16010414_465","roots":["document:465"],"nodes":{"document:465":{"id":"document:465","type":"document","entry_kind":"document","text_key":"document:465","source_node_id":"16010414:1:3","next":"end"},"end":{"id":"end","type":"end"}},"text_entries":{"document:465":{"key":"document:465","kind":"document","textdes_id":"465","source_cn":"对课本施展改良的传送门魔法，一扇微缩传送门便会在书页的插图上浮现。可借此在插图中的世界自由穿行，并且能清晰听到课堂里教授的讲解。\n若被教授发现离座，可伺机传送回座位。为应对检查，传送门会自动弥合，书页平整如初，不留丝毫皱褶，无人能察觉破绽。","document_title_cn":"插图传送门魔法"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1},"source":"Exact map-object document dispatch"},"easter_eggs/graphs/16010414/document_473.json":{"schema_version":1,"asset_key":"easter_eggs/document_16010414_473","roots":["document:473"],"nodes":{"document:473":{"id":"document:473","type":"document","entry_kind":"document","text_key":"document:473","source_node_id":"16010414:1:4","next":"end"},"end":{"id":"end","type":"end"}},"text_entries":{"document:473":{"key":"document:473","kind":"document","textdes_id":"473","source_cn":"配方：月光苔+隐形草汁液+一滴猫头鹰的哈欠眼泪\n效果：饮用后一小时内，便会像背景板一样被所有人无意识忽略（包括点名时的老师）。但注意，如果打喷嚏药效会立刻失效！\n趣事备忘：曾被锁在空教室，因为下课铃响起时药剂还没消失，自己不小心睡了过去。","document_title_cn":"存在感稀释魔药"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1},"source":"Exact map-object document dispatch"},"easter_eggs/locales/cn/16010414/document_465.json":{"schema_version":1,"asset_key":"easter_eggs/document_16010414_465","lang":"cn","texts":{"document:465":{"text":"对课本施展改良的传送门魔法，一扇微缩传送门便会在书页的插图上浮现。可借此在插图中的世界自由穿行，并且能清晰听到课堂里教授的讲解。\n若被教授发现离座，可伺机传送回座位。为应对检查，传送门会自动弥合，书页平整如初，不留丝毫皱褶，无人能察觉破绽。","source_cn":"对课本施展改良的传送门魔法，一扇微缩传送门便会在书页的插图上浮现。可借此在插图中的世界自由穿行，并且能清晰听到课堂里教授的讲解。\n若被教授发现离座，可伺机传送回座位。为应对检查，传送门会自动弥合，书页平整如初，不留丝毫皱褶，无人能察觉破绽。","status":"matched","document_title":"插图传送门魔法","document_title_cn":"插图传送门魔法","document_title_status":"matched"}},"speakers":{}},"easte