{"schema_version":1,"resources":{"locales/en/ep1/quest_story/11234010.json":{"asset_key":"ep1/quest_story_11234010","episode":"ep1","category":"quest_story","story_id":"11234010","schema_version":1,"lang":"en","texts":{"say:0:1123401001:0":{"text":"I wonder how Hashir's doing...","source_cn":"不知道，现在哈什尔在做什么？","status":"matched","hash_xxh64":"0x93B750C0930A0BE0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123401002:0":{"text":"Yes! Magister, let's go visit!","source_cn":"是的！主人！我们快去看看吧。","status":"matched_runtime_gender","hash_xxh64":"0xEC10A0ECB82D0F18","variant_status":"runtime_gender_keys_target_same","male":"Yes! Magister, let's go visit!","female":"Yes! Magister, let's go visit!","variant_male_record_index":"126125","variant_female_record_index":"126126","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep1/quest_story/11234030.json":{"asset_key":"ep1/quest_story_11234030","episode":"ep1","category":"quest_story","story_id":"11234030","schema_version":1,"lang":"en","texts":{"say:0:1123403001:0":{"text":"Hashir is in trouble!","source_cn":"不，那是……有人在攻击哈什尔！","status":"matched","hash_xxh64":"0x783DA0A646D31D55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123403002:0":{"text":"We've got to help him, Magister!","source_cn":"主人，我们快去帮助他！","status":"matched_runtime_gender","hash_xxh64":"0x2F7412EA2AAFF41B","variant_status":"runtime_gender_keys_target_same","male":"We've got to help him, Magister!","female":"We've got to help him, Magister!","variant_male_record_index":"126133","variant_female_record_index":"126134","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep1/quest_story/11234050.json":{"asset_key":"ep1/quest_story_11234050","episode":"ep1","category":"quest_story","story_id":"11234050","schema_version":1,"lang":"en","texts":{"say:0:1123405001:0":{"text":"Hmph! I''ve got my eye on you, Hashir!","source_cn":"哼，我会一直盯着你的！老……哈什尔！","status":"matched","hash_xxh64":"0xDB1E96BD84BB9CA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123405002:0":{"text":"Oh, save your breath.","source_cn":"算了，别追了。","status":"matched","hash_xxh64":"0xD20758828E23AFEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:黑嚎熊人乌泰":{"text":"Utai","source":"黑嚎熊人乌泰","status":"matched_dialogue_flow"},"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep1/quest_story/11234060.json":{"asset_key":"ep1/quest_story_11234060","episode":"ep1","category":"quest_story","story_id":"11234060","schema_version":1,"lang":"en","texts":{"say:2:1123406001:1":{"text":"Hashir... why are you packing?","source_cn":"哈什尔先生，你收拾这些是要做什么？","status":"matched","hash_xxh64":"0x0EF4F30C3206FBD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123406002:1":{"text":"It's time for me to leave while the weather is favorable.","source_cn":"趁着天气不错，离开这里。","status":"matched","hash_xxh64":"0x1BCF36A5C6DA42E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1123406002":{"text":"It's time for me to leave while the weather is favorable.","source_cn":"趁着天气不错，离开这里。","status":"matched","hash_xxh64":"0x1BCF36A5C6DA42E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123406003:1":{"text":"They did nothing wrong. It's me that's the problem.","source_cn":"他们没什么错，有问题的是我。","status":"matched","hash_xxh64":"0xFF3A3E6E2FBE848C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123406005:1":{"text":"Is tradition truly so unbreakable?","source_cn":"传统真的是不可违背的吗？","status":"matched","hash_xxh64":"0x7D222CA3EAF1D1E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123406006:1":{"text":"You are not from the Ashen Wastes and, therefore, do not know how cruel life can be here.","source_cn":"你们并非荒角沙漠之人，不会懂得这里有多残酷……","status":"matched","hash_xxh64":"0x6DD5F92DB58BA71D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123406007:1":{"text":"Tradition is precisely what keeps the Grimmaw Clan strong.","source_cn":"正是因为遵循传统，黑嚎才会一直伟大。","status":"matched","hash_xxh64":"0xC50344711C08D257","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123406008:1":{"text":"It's an ironclad law for the elderly to exile themselves. I was too weak before... I must be more resolute.","source_cn":"年老者自我放逐，这是铁律。我之前还是太过软弱了……现在...","status":"matched","hash_xxh64":"0x0B5DAAF040E93510","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123406009:1":{"text":"Stand aside, please. I need to finish packing.","source_cn":"你们站开一些，我要整理行李了。","status":"matched","hash_xxh64":"0x465D945A4E07CD32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1123406009":{"text":"Stand aside, please. I need to finish packing.","source_cn":"你们站开一些，我要整理行李了。","status":"matched","hash_xxh64":"0x465D945A4E07CD32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1123406010:1":{"text":"So be it. The sooner it's done, the sooner I can go.","source_cn":"那就这样吧，早点收拾完，早点离开。","status":"matched","hash_xxh64":"0x98575D8310AE9575","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:0:1":{"text":"We'll help you.","source_cn":"我们帮你","status":"matched_runtime_gender","hash_xxh64":"0xE134DC020BBE4E5E","variant_status":"runtime_gender_keys_target_same","male":"We'll help you.","female":"We'll help you.","variant_male_record_index":"64450","variant_female_record_index":"64451","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"Because of those two just now?","source_cn":"因为刚才那两个人吗？","status":"matched_runtime_gender","hash_xxh64":"0xF14AEB5D9CF44AB7","variant_status":"runtime_gender_keys_target_same","male":"Because of those two just now?","female":"Because of those two just now?","variant_male_record_index":"64446","variant_female_record_index":"64447","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1123406004:1":{"text":"The real danger is going against tradition and tarnishing my name any further.","source_cn":"对我来说真正的危险是违背传统，名誉扫地。","status":"matched","hash_xxh64":"0x5B74D5AA703E59D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:1:2":{"text":"It's dangerous for you to leave.","source_cn":"你离开这里很危险","status":"matched_runtime_gender","hash_xxh64":"0x20CADB24578D5292","variant_status":"runtime_gender_keys_target_same","male":"It's dangerous for you to leave.","female":"It's dangerous for you to leave.","variant_male_record_index":"64448","variant_female_record_index":"64449","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":16,"localized_text_count":15,"speaker_count":3}},"locales/en/ep1/quest_story/11234070.json":{"asset_key":"ep1/quest_story_11234070","episode":"ep1","category":"quest_story","story_id":"11234070","schema_version":1,"lang":"en","texts":{"say:2:1123407001:1":{"text":"It's time to see what awaits me on the long road ahead.","source_cn":"是时候离开了，能跟我上路的东西有多少呢？","status":"matched","hash_xxh64":"0xD4A57D0DA6174131","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123407002:1":{"text":"Chippy still doesn't understand... Do you really have to go?","source_cn":"满满还是不理解……为什么一定要这么坚决呢？","status":"matched","hash_xxh64":"0x0AB34622B71DAEA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123407003:1":{"text":"When the clans first moved into the desert, resources were scarce, and survival was hard-fought. Scarcity led to countless battles among the Maulers.","source_cn":"在沙漠的拓荒时代，因为资源贫瘠，生存是各个氏族必须面对...","status":"matched","hash_xxh64":"0x7D29A6226CADA9CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123407004:1":{"text":"The victorious clans survived, and the defeated faded into the sands. All notions of benevolence and morality meant nothing. Only the strongest thrived.","source_cn":"赢的氏族活下来，输的氏族被淘汰，一切仁义道德都是多余的...","status":"matched","hash_xxh64":"0x6B6A38ED269A0747","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123407005:1":{"text":"Kruger never lived through these times, and so he cannot fathom these concepts.","source_cn":"克鲁格并未经历过那个年代，所以他根本不懂那意味着什么。","status":"matched","hash_xxh64":"0x9D11613B8C24A9AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1123407005":{"text":"Kruger never lived through these times, and so he cannot fathom these concepts.","source_cn":"克鲁格并未经历过那个年代，所以他根本不懂那意味着什么。","status":"matched","hash_xxh64":"0x9D11613B8C24A9AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123407006:1":{"text":"When I was young, I contemplated these things often as you do now, but in time, you will come to see that those who have devoted their lives to battle cannot withstand the ravages of time.","source_cn":"我孩童的时候也像你一样想过这些，但渐渐地你会发现，一生...","status":"matched_runtime_gender","hash_xxh64":"0x5D1F5107523C0E87","variant_status":"runtime_gender_keys_target_same","male":"When I was young, I contemplated these things often as you do now, but in time, you will come to see that those who have devoted their lives to battle cannot withstand the ravages of time.","female":"When I was young, I contemplated these things often as you do now, but in time, you will come to see that those who have devoted their lives to battle cannot withstand the ravages of time.","variant_male_record_index":"126156","variant_female_record_index":"126157","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123407007:1":{"text":"My kin all feel ashamed as they age. When they can no longer bear arms, self-exile becomes an inevitable fate.","source_cn":"我的亲人，都在自然老去中感到耻辱。当他们无法再拿起武器...","status":"matched","hash_xxh64":"0x68484FF1447043DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123407008:1":{"text":"And now it's my turn.","source_cn":"现在轮到我了。","status":"matched","hash_xxh64":"0x65D0F28A713061A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1123407008":{"text":"And now it's my turn.","source_cn":"现在轮到我了。","status":"matched","hash_xxh64":"0x65D0F28A713061A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123407009:1":{"text":"In my experience, peace is always fleeting. Conflict can erupt at any moment, and the Grimmaw Clan must never be caught off guard.","source_cn":"对于我的生命来说，和平永远是短暂的，争斗随时都可能爆发...","status":"matched","hash_xxh64":"0x37A0D6D1FDB523A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1123407011:1":{"text":"If you wish to respect and understand me, then follow me no longer.","source_cn":"如果你们听懂了，就不要再跟过来。","status":"matched","hash_xxh64":"0xB977C5E9E1D7DB84","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1123407012:1":{"text":"You are good and kind people but please... leave me be. Let this feeble old man depart in peace.","source_cn":"我知道你们都是好孩子，但……再别跟过来，让我这个无力的...","status":"matched","hash_xxh64":"0x654976F964D566CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1123407013:1":{"text":"No...","source_cn":"不……","status":"matched","hash_xxh64":"0xE859DC76A12C3EB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1123407014:1":{"text":"Farewell, and... thank you.","source_cn":"再见，谢谢你们。","status":"matched","hash_xxh64":"0xDEB11C3E34E07F0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"The Warsong Festival abolished war.","source_cn":"战歌节已经取缔了战争","status":"matched_runtime_gender","hash_xxh64":"0xC34AA77DF6613684","variant_status":"runtime_gender_keys_target_same","male":"The Warsong Festival abolished war.","female":"The Warsong Festival abolished war.","variant_male_record_index":"64456","variant_female_record_index":"64457","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1123407010:1":{"text":"Honor... No, what we need are more young brave warriors, not ones who fill their heads with ideas of honor.","source_cn":"荣誉，不……我们需要的是更多年轻勇敢的战士，而不是挂满...","status":"matched","hash_xxh64":"0x6550235D0D30D3CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"More to honor than fighting.","source_cn":"战斗不是取得荣誉的唯一途径","status":"matched_runtime_gender","hash_xxh64":"0xB9FD388402525EAB","variant_status":"runtime_gender_keys_target_same","male":"More to honor than fighting.","female":"More to honor than fighting.","variant_male_record_index":"64458","variant_female_record_index":"64459","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"To fight is one's fate...","source_cn":"听起来，战斗才是宿命","status":"matched_runtime_gender","hash_xxh64":"0xDDF24EF9DAE87C3E","variant_status":"runtime_gender_keys_target_same","male":"To fight is one's fate...","female":"To fight is one's fate...","variant_male_record_index":"64452","variant_female_record_index":"64453","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"It's different now.","source_cn":"现在已经改变了","status":"matched_runtime_gender","hash_xxh64":"0x578D57565ECE78BC","variant_status":"runtime_gender_keys_target_same","male":"It's different now.","female":"It's different now.","variant_male_record_index":"64454","variant_female_record_index":"64455","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":21,"localized_text_count":20,"speaker_count":2}},"locales/en/ep1/quest_story/11234080.json":{"asset_key":"ep1/quest_story_11234080","episode":"ep1","category":"quest_story","story_id":"11234080","schema_version":1,"lang":"en","texts":{"say:0:1123408001:0":{"text":"Chippy never thought Hashir would really just... leave.","source_cn":"没想到……哈什尔竟然如此坚决地离开了。","status":"matched","hash_xxh64":"0xECAC961E12A10163","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1123408002:0":{"text":"We need to speak to Kruger quickly.","source_cn":"唉，我们得快点通知克鲁格这件事了……","status":"matched_runtime_gender","hash_xxh64":"0xF08B85B7611F29D0","variant_status":"runtime_gender_keys_target_same","male":"We need to speak to Kruger quickly.","female":"We need to speak to Kruger quickly.","variant_male_record_index":"126168","variant_female_record_index":"126169","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:主角":{"text":"Player","source":"主角","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep1/quest_story/11234090.json":{"asset_key":"ep1/quest_story_11234090","episode":"ep1","category":"quest_story","story_id":"11234090","schema_version":1,"lang":"en","texts":{"say:1:1123409001:1":{"text":"Friends, you don't look well.","source_cn":"朋友们，你们看起来脸色不太好。","status":"matched","hash_xxh64":"0xAECFFDAE913ECD35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123409002:1":{"text":"Some Maulers came and harassed Hashir. He left...","source_cn":"有些熊人过来骚扰哈什尔，然后他就离开这里了……","status":"matched","hash_xxh64":"0xA1DFA81818C7DAAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123409003:1":{"text":"So that's it, then. He's gone.","source_cn":"原来如此，他已经离开这片领地了。","status":"matched","hash_xxh64":"0x8EE4198A7C5FFA12","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1123409003":{"text":"So that's it, then. He's gone.","source_cn":"原来如此，他已经离开这片领地了。","status":"matched","hash_xxh64":"0x8EE4198A7C5FFA12","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123409004:1":{"text":"While the reforms of the clan are underway, things aren't as smooth as I'd like them to be.","source_cn":"唉，虽然目前部落的改革虽然有所起色，但离我想看到的程度...","status":"matched","hash_xxh64":"0x1D24A9A571991A3B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123409006:1":{"text":"Now Hashir's departure will add more fuel to their fire.","source_cn":"现如今，哈什尔的消失会更加助长这些反对声音的气焰。","status":"matched","hash_xxh64":"0x577301292C281D9E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123409007:1":{"text":"In any case, thank you for watching over Hashir all this time.","source_cn":"无论如何，都感谢你们这段时间对哈什尔的关照。","status":"matched","hash_xxh64":"0x85408B14AF107894","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123409008:1":{"text":"Knowing how he is, there is little we can do but accept his decision in silence. For now...","source_cn":"凭我对他的了解，我们只能默默接受这个决定。","status":"matched","hash_xxh64":"0x2D3148EE62CDB67E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123409009:1":{"text":"Give me some time to think about Hashir. I'll reach out if I come to any new conclusions.","source_cn":"不过希望你们再给我一些时间，我会再争取一个转机，到时候...","status":"matched","hash_xxh64":"0x6EC1ECAD54C8CCB6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"How are the reforms going?","source_cn":"你的改革如何了？","status":"matched_runtime_gender","hash_xxh64":"0x85451EE4036A2570","variant_status":"runtime_gender_keys_target_same","male":"How are the reforms going?","female":"How are the reforms going?","variant_male_record_index":"64460","variant_female_record_index":"64461","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1123409005:1":{"text":"You're right. They are the ones who are opposed to changing tradition.","source_cn":"你想得没错，他们应当是反对改变传统的人。","status":"matched_runtime_gender","hash_xxh64":"0x10EE5C4BA7453313","variant_status":"runtime_gender_keys_target_same","male":"You're right. They are the ones who are opposed to changing tradition.","female":"You're right. They are the ones who are opposed to changing tradition.","variant_male_record_index":"126174","variant_female_record_index":"126175","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"Did the opposition drive Hashir away?","source_cn":"赶走哈什尔的是反对派吗？","status":"matched_runtime_gender","hash_xxh64":"0x58DC81ADC4B84FF0","variant_status":"runtime_gender_keys_target_same","male":"Did the opposition drive Hashir away?","female":"Did the opposition drive Hashir away?","variant_male_record_index":"64462","variant_female_record_index":"64463","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:克鲁格":{"text":"Kruger","source":"克鲁格","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":2}}}}