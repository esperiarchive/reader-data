ory/13222520.json":{"asset_key":"ep3/quest_story_13222520","episode":"ep3","category":"quest_story","story_id":"13222520","schema_version":1,"lang":"jp","texts":{"say:0:1322252001:0":{"text":"無事に倒せましたね。スノーシダー町へ戻りましょう！","source_cn":"魔物被打败了，我们这就回雪松镇吧！","status":"matched","hash_xxh64":"0x3039DE74A622AE5B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/jp/ep3/quest_story/13222530.json":{"asset_key":"ep3/quest_story_13222530","episode":"ep3","category":"quest_story","story_id":"13222530","schema_version":1,"lang":"jp","texts":{"say:1:1322253001:1":{"text":"もう黒沼の森へ行ってはいけませんよ！","source_cn":"以后可不要再闯入危险的黑沼森林了噢！","status":"matched","hash_xxh64":"0x98D14C9FE1C0BE4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322253002:0":{"text":"ああ、やっぱり安全な東の森へ行くことにするよ。本当にありがとう！","source_cn":"好的，我以后还是去安全的东边树林吧，谢谢你们。","status":"matched","hash_xxh64":"0xA515A81B2E06F2A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"},"speaker:到家的猎人":{"text":"家についた狩人","source":"到家的猎人","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}}}}