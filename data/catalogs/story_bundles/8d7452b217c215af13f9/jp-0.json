":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/jp/ep3/quest_story/13222490.json":{"asset_key":"ep3/quest_story_13222490","episode":"ep3","category":"quest_story","story_id":"13222490","schema_version":1,"lang":"jp","texts":{"say:0:1322249001:0":{"text":"狩人さんが魔物に囲まれています！急いで助けましょう！","source_cn":"那个猎人被魔物包围了，我们快去救他！","status":"matched","hash_xxh64":"0x183C4FE4AB4F3136","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/jp/ep3/quest_story/13222500.json":{"asset_key":"ep3/quest_story_13222500","episode":"ep3","category":"quest_story","story_id":"13222500","schema_version":1,"lang":"jp","texts":{"say:1:1322250001:1":{"text":"狩人さん、この森はとても危険なんです。もうここで狩りをするのはやめてください！","source_cn":"猎人先生，黑沼森林十分危险，请不要再闯进这里打猎了！","status":"matched","hash_xxh64":"0x203EC3FD715381D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322250002:1":{"text":"こ、こんなに魔物がうじゃうじゃいるなんて思わなかったんだ！ここで捕れる獲物の方が高く売れるから……","source_cn":"我……我只是觉得这边的猎物可能会比较值钱……没想到这么...","status":"matched","hash_xxh64":"0x6E62A37F8019632C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322250003:1":{"text":"この森は魔物に占領されてしまったので、もう狩りは無理ですよ。外まで送りますから。","source_cn":"这里被魔物占据，不适合打猎，我们送你出去吧。","status":"matched","hash_xxh64":"0x40107FE67FF05CF9","variant_status":"","male":"","female":"","variant_male_recor