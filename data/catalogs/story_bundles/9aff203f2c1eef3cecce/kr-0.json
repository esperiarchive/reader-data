ment_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:沙利叶":{"text":"사리에","source":"沙利叶","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":3}},"locales/kr/ep4/quest_story/14233780.json":{"asset_key":"ep4/quest_story_14233780","episode":"ep4","category":"quest_story","story_id":"14233780","schema_version":1,"lang":"kr","texts":{"say:0:1423378001:0":{"text":"보세요, 오로나가 저기 있어요!","source_cn":"看，欧罗娜在那！","status":"matched","hash_xxh64":"0xE666BD4DADEE3629","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/kr/ep4/quest_story/14233790.json":{"asset_key":"ep4/quest_story_14233790","episode":"ep4","category":"quest_story","story_id":"14233790","schema_version":1,"lang":"kr","texts":{"say:3:1423379001:1":{"text":"오로나, 편지가 왔어요! 사리에가 꼭 직접 전해 달라고 한 편지예요!","source_cn":"欧罗娜，我们来给你送信啦。是沙利叶让我们亲手交给你的信函哦！","status":"matched","hash_xxh64":"0x4B54A7913AD51B25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423379002:1":{"text":"사리에 님께서 저에게 편지를요? 어떤 내용의 편지일지 짐작이 가긴 하네요.","source_cn":"是沙利叶大人托你们交给我的吗……我想，我大概知道信函的...","status":"matched","hash_xxh64":"0x91895D808A554DCB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document