{"schema_version":1,"resources":{"easter_eggs/menus/10020403_1_2.en.json":{"schema_version":1,"asset_key":"easter_eggs/menu_10020403:1:2","lang":"en","texts":{"menu:41766370:1":{"text":"These glimmerblooms are going crazy...","source_cn":"这些荧荧花太狂躁了……","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:薄暮队员-兰妮":{"text":"Patroller Lanny","source":"薄暮队员-兰妮","status":"exact_hash"}}},"easter_eggs/menus/10020403_1_7.en.json":{"schema_version":1,"asset_key":"easter_eggs/menu_10020403:1:7","lang":"en","texts":{"menu:41766370:1":{"text":"These glimmerblooms are going crazy...","source_cn":"这些荧荧花太狂躁了……","status":"matched_runtime_gender_keys_same"}},"speakers":{"speaker:薄暮队员-兰妮":{"text":"Patroller Lanny","source":"薄暮队员-兰妮","status":"exact_hash"}}},"locales/en/mn2/gameplay_story/10607010.json":{"asset_key":"mn2/gameplay_story_10607010","episode":"mn2","category":"gameplay_story","story_id":"10607010","schema_version":1,"lang":"en","texts":{"say:0:1060701001:0":{"text":"We have to call for help!","source_cn":"我们得想办法求援！","status":"matched","hash_xxh64":"0x4323346EAAFC4729","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1060701002:0":{"text":"But how can we get out of here?","source_cn":"可是我们怎么离开这儿？","status":"matched","hash_xxh64":"0x6311765C94AB04AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1060701003:0":{"text":"Everyone got hurt...","source_cn":"大家都受伤了……","status":"matched","hash_xxh64":"0x4A9128DBABDB4598","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:薄暮队员兰妮":{"text":"Patroller Lanny","source":"薄暮队员兰妮","status":"matched_dialogue_flow"},"speaker:薄暮队员莱格拉":{"text":"Patroller Legra","source":"薄暮队员莱格拉","status":"matched_dialogue_flow"},"speaker:薄暮队员纳茨尔":{"text":"Patroller Nazeer","source":"薄暮队员纳茨尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":3}},"locales/en/mn2/gameplay_story/10607020.json":{"asset_key":"mn2/gameplay_story_10607020","episode":"mn2","category":"gameplay_story","story_id":"10607020","schema_version":1,"lang":"en","texts":{"say:1:1060702001:1":{"text":"Hi, Magister! Do you know where the nearest Dusk Camp is? Could you get us some help from there?","source_cn":"魔法师大人，你知道最近的薄暮营地在哪吗？可以帮我们向那...","status":"matched_runtime_gender","hash_xxh64":"0x9622721F0588309D","variant_status":"runtime_gender_keys_target_same","male":"Hi, Magister! Do you know where the nearest Dusk Camp is? Could you get us some help from there?","female":"Hi, Magister! Do you know where the nearest Dusk Camp is? Could you get us some help from there?","variant_male_record_index":"109752","variant_female_record_index":"109753","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1060702001":{"text":"Hi, Magister! Do you know where the nearest Dusk Camp is? Could you get us some help from there?","source_cn":"魔法师大人，你知道最近的薄暮营地在哪吗？可以帮我们向那边求援吗？","status":"matched_runtime_gender","hash_xxh64":"0x9622721F0588309D","variant_status":"runtime_gender_keys_target_same","male":"Hi, Magister! Do you know where the nearest Dusk Camp is? Could you get us some help from there?","female":"Hi, Magister! Do you know where the nearest Dusk Camp is? Could you get us some help from there?","variant_male_record_index":"109752","variant_female_record_index":"109753","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1060702002:1":{"text":"We're here to clear out the rampant glimmerblooms. Little did we expect them to become even more ferocious than before.","source_cn":"这片区域出现了很多失控的荧荧花，我们是过来清除它们的。...","status":"matched","hash_xxh64":"0x33C4F9E1FB0C176D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1060702004:1":{"text":"Our team is severely injured. We can neither leave this place nor call for help.","source_cn":"我们小队三人都负伤严重，连离开这里都成问题，更没办法去求援。","status":"matched","hash_xxh64":"0x6C3A74F6A3C5A9D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1060702005:1":{"text":"But if we get no help, these glimmerblooms might put the villagers in danger. We cannot let that happen.","source_cn":"可若是不去求援，只怕这些荧荧花会危害附近的村民。我们薄...","status":"matched","hash_xxh64":"0xA3AFF7BD82BC6E2B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1060702006:1":{"text":"Get us some help from the camp, please.","source_cn":"拜托你，帮我们去薄暮营地求援吧。","status":"matched","hash_xxh64":"0x2CDB23777EEA6228","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1060702006":{"text":"Get us some help from the camp, please.","source_cn":"拜托你，帮我们去薄暮营地求援吧。","status":"matched","hash_xxh64":"0x2CDB23777EEA6228","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1060702007:1":{"text":"...R-Really?","source_cn":"……真、真的吗？！","status":"matched","hash_xxh64":"0x45094E177D294FE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1060702009:1":{"text":"I'll trust you if you say so! Too bad I can't assist you...","source_cn":"……既然你这么肯定，我也愿意相信你！只可惜我不能从旁协助……","status":"matched","hash_xxh64":"0x7C236CF5C8D79814","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1060702010:1":{"text":"Just get back if you're having a hard time with them. We can still call for backup. Safety first!","source_cn":"如果你面对荧荧花很吃力，就赶快回来，我们再去求援也来得...","status":"matched","hash_xxh64":"0x3785C70EE786194B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1060702011:1":{"text":"We'll wait here for your good news.","source_cn":"我们等着你的好消息。","status":"matched","hash_xxh64":"0x702D190292B469A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"No need for help, I got this.","source_cn":"用不着求援，我来解决","status":"matched_runtime_gender","hash_xxh64":"0x2D3636BD03ED6D1F","variant_status":"runtime_gender_keys_target_same","male":"No need for help, I got this.","female":"No need for help, I got this.","variant_male_record_index":"61350","variant_female_record_index":"61351","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1060702008:1":{"text":"You mean you can handle them... all?","source_cn":"你的意思是……你可以解决它们？！","status":"matched","hash_xxh64":"0xE720235F3EDC6890","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"Your backup is right here.","source_cn":"你的援兵已经到了","status":"matched_runtime_gender","hash_xxh64":"0x4D060C24F1E02E42","variant_status":"runtime_gender_keys_target_same","male":"Your backup is right here.","female":"Your backup is right here.","variant_male_record_index":"61352","variant_female_record_index":"61353","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"What happened?","source_cn":"发生了什么事？","status":"matched_runtime_gender","hash_xxh64":"0xF528BD7B41CBB0D5","variant_status":"runtime_gender_keys_target_same","male":"What happened?","female":"What happened?","variant_male_record_index":"61346","variant_female_record_index":"61347","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1060702003:1":{"text":"Yeah... We're coming to clear this whole amount of rampant glimmerblooms. But their fury is far beyond our imagination...","source_cn":"是的……我们是过来清理失控的荧荧花的，可它们的狂暴远远...","status":"matched","hash_xxh64":"0x3F1D3E040AABF5E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:1:2":{"text":"Are you all hurt?","source_cn":"你们都受伤了？","status":"matched_runtime_gender","hash_xxh64":"0x6C5A8D77AE92BB91","variant_status":"runtime_gender_keys_target_same","male":"Are you all hurt?","female":"Are you all hurt?","variant_male_record_index":"61348","variant_female_record_index":"61349","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:薄暮队员兰妮":{"text":"Patroller Lanny","source":"薄暮队员兰妮","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":18,"localized_text_count":17,"speaker_count":1}},"locales/en/mn2/gameplay_story/10607030.json":{"asset_key":"mn2/gameplay_story_10607030","episode":"mn2","category":"gameplay_story","story_id":"10607030","schema_version":1,"lang":"en","texts":{"say:1:1060703001:1":{"text":"There is no voice of the glimmerblooms... Y-You did it!","source_cn":"荧荧花的声音消失了……你、你成功了！","status":"matched","hash_xxh64":"0xAB2002EAD4222008","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1060703001":{"text":"There is no voice of the glimmerblooms... Y-You did it!","source_cn":"荧荧花的声音消失了……你、你成功了！","status":"matched","hash_xxh64":"0xAB2002EAD4222008","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1060703002:1":{"text":"No, I just didn't think you could make it so fast.","source_cn":"不，我只是没想到，你居然这么快就解决了它们。","status":"matched","hash_xxh64":"0xD049B764239BACB5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1060703003:1":{"text":"We need to keep improving our sword skills...","source_cn":"看来，我们三个的剑技还需要不断精进……","status":"matched","hash_xxh64":"0x264DCEBC9A30E29C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1060703004:1":{"text":"Thanks to you, we can finally leave this place. The two of them have to hurry back to treat their injuries.","source_cn":"还没有向你道谢呢。多亏了你，我们终于能离开这里了，他们...","status":"matched","hash_xxh64":"0x266E27493EBD07D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1060703005:1":{"text":"Thank you so much for your help!","source_cn":"那么，我就先带他们回去了。多谢你的帮助。","status":"matched","hash_xxh64":"0x2B54C86D16433CAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"Looks like you still doubt me.","source_cn":"看来你没有完全相信我啊","status":"matched_runtime_gender","hash_xxh64":"0x95F26FC428427EA2","variant_status":"runtime_gender_keys_target_same","male":"Looks like you still doubt me.","female":"Looks like you still doubt me.","variant_male_record_index":"61354","variant_female_record_index":"61355","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:薄暮队员兰妮":{"text":"Patroller Lanny","source":"薄暮队员兰妮","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":1}}}}