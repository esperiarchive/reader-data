ocument_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"너의 지원군이 도착했어","source_cn":"你的援兵已经到了","status":"matched_runtime_gender","hash_xxh64":"0x4D060C24F1E02E42","variant_status":"runtime_gender_keys_target_same","male":"너의 지원군이 도착했어","female":"너의 지원군이 도착했어","variant_male_record_index":"61352","variant_female_record_index":"61353","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"무슨 일 있어?","source_cn":"发生了什么事？","status":"matched_runtime_gender","hash_xxh64":"0xF528BD7B41CBB0D5","variant_status":"runtime_gender_keys_target_same","male":"무슨 일 있어?","female":"무슨 일 있어?","variant_male_record_index":"61346","variant_female_record_index":"61347","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1060702003:1":{"text":"맞아요... 저희는 통제 불능인 빛나는 꽃을 제거하러 온 거예요. 그런데 꽃의 난폭함이 저희가 상상했던 것보다 훨씬 더 심각해요.","source_cn":"是的……我们是过来清理失控的荧荧花的，可它们的狂暴远远...","status":"matched","hash_xxh64":"0x3F1D3E040AABF5E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:1:2":{"text":"다들 다친 거야?","source_cn":"你们都受伤了？","status":"matched_runtime_gender","hash_xxh64":"0x6C5A8D77AE92BB91","variant_status":"runtime_gender_keys_target_same","male":"다들 다친 거야?","female":"다들 다친 거야?","variant_male_record_index":"61348","variant_female_record_index":"61349","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:薄暮队员兰妮":{"text":"땅거미 대원 란니","source":"薄暮队员兰妮","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":18,"localized_text_count":17,"speaker_count":1}},"locales/kr/mn2/gamepla