x":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1831113002:1":{"text":"손턴... 그 사람이 벌을 받았어! 내가 복수를 했어...","source_cn":"桑顿……他受到惩罚了！我替你报仇了……","status":"matched","hash_xxh64":"0xE85E3C78EC6A3042","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1831113003:1":{"text":"이제야... 편히 눈을 감을 수 있겠구나... 흑흑...","source_cn":"你总算……总算可以瞑目了……呜呜呜……","status":"matched","hash_xxh64":"0xC28863E1EBEBDCC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1831113004:0":{"text":"달... 달...","source_cn":"黛……黛……","status":"matched","hash_xxh64":"0x582324446FF18B70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1831113005:1":{"text":"로워... 로워?! 당신이에요?","source_cn":"罗沃……罗沃？！是你吗……","status":"matched","hash_xxh64":"0x313A872A7825C90B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1831113006:1":{"text":"달피...","source_cn":"黛菲……","status":"matched","hash_xxh64":"0xAE9ACD3A87E1BD27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1831113007:1":{"text":"여기! 여기 있