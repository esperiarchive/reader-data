ount":2}},"locales/en/ep2/quest_story/12110280.json":{"asset_key":"ep2/quest_story_12110280","episode":"ep2","category":"quest_story","story_id":"12110280","schema_version":1,"lang":"en","texts":{"say:0:1211028001:0":{"text":"It's getting harder now. Don't get careless.","source_cn":"难度有所提升，不能大意。","status":"matched","hash_xxh64":"0x2E1E2CF0A1B37ACB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1211028002:0":{"text":"Don't worry, Sonja. I've got you covered!","source_cn":"放心吧，索尼娅姐姐，我来掩护你！","status":"matched","hash_xxh64":"0x1D20A2113CA61ABD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}},"locales/en/ep2/quest_story/12110290.json":{"asset_key":"ep2/quest_story_12110290","episode":"ep2","category":"quest_story","story_id":"12110290","schema_version":1,"lang":"en","texts":{"say:0:1211029001:0":{"text":"It seems I'm quite skilled at this! No problems over here.","source_cn":"看来我的身手还不错嘛！根本难不倒我！","status":"matched","hash_xxh64":"0xBFAEA44FF2B5C869","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1211029002:0":{"text":"Where's the key though? We need to look around.","source_cn":"但是，钥匙在哪呢？四处找找吧。","status":"matched","hash_xxh64":"0xB1C6BBB1A3684E9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":1}},"locales/en/ep2/quest_story/12110300.json":{"asset_key":"ep2/quest_story_12110300","episode":"ep2","category":"quest_story","story_id":"12110300","schema_version":1,"lang":"en","texts":{"say:0:1211030001:0":{"text":"Are these broken walls the fallen temple of the god of the waves?","source_cn":"这些残破的石墙，是风浪与漂泊之神坠落的神殿吗？","status":"matched","hash_xxh64":"0x8A391613263BD2C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep2/quest_story/12110310.json":{"asset_key":"ep2/quest_story_12110310","episode":"ep2","category":"quest_story","story_id":"12110310","schema_version":1,"lang":"en","texts":{"say:0:1211031001:0":{"text":"A golem! It wants to attack us!","source_cn":"还有魔偶！它想攻击我们！","status":"matched","hash_xxh64":"0x44EEBA04D553B0A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep2/quest_story/12110320.json":{"asset_key":"ep2/quest_story_12110320","episode":"ep2","category":"quest_story","story_id":"12110320","schema_version":1,"lang":"en","texts":{"say:0:1211032001:0":{"text":"Something fell out of the golem. Could it be the key?","source_cn":"那只魔偶被打碎后，有东西掉出来了。难道是钥匙？","status":"matched","hash_xxh64":"0x6E51A651B675BB11","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/ep2/quest_story/12110330.json":{"asset_key":"ep2/quest_story_12110330","episode":"ep2","category":"quest_story","story_id":"12110330","schema_version":1,"lang":"en","texts":{"say:1:1211033001:1":{"text":"According to the notes we found, the golems were intentionally left here by the god of the waves.","source_cn":"按照笔记上的说法，魔偶好像是风浪与漂泊之神故意留在这里的。","status":"matched","hash_xxh64":"0x2F84F33A36FCAEC8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1211033002:1":{"text":"Most of the golems here were not strong or very aggressive. Tritonus might've picked up a few defective ones.","source_cn":"这里的魔偶大多攻击性不强，可能是那位神明捡来的残次品吧。","status":"matched","hash_xxh64":"0xAAF430540D76398A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1211033003:1":{"text":"The god of the waves doesn't seem to like killing. This is a new discovery. After all, during the Immortal War, all the gods were fighting for their lives.","source_cn":"风浪神似乎不喜杀戮，这是个新发现。毕竟在诸神之战时期，...","status":"matched","hash_xxh64":"0xF0D1101E98B1E51E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211033004:1":{"text":"More than that, we just defeated that lump of rock. Where's the key?","source_cn":"比起那些，我们明明已经击败了那个石头疙瘩，为什么还没有...","status":"matched","hash_xxh64":"0x162D31145BFE7565","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211033005:1":{"text":"Although it's called a key, it's just a small stone, and maybe it's buried around here somewhere. Let's look for it.","source_cn":"虽然叫钥匙，但只是一个小石块，可能埋在废墟里了，我们找找吧！","status":"matched","hash_xxh64":"0xD19CEC8F230E5624","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}},"locales/en/ep2/quest_story/12110331.json":{"asset_key":"ep2/quest_story_12110331","episode":"ep2","category":"quest_story","story_id":"12110331","schema_version":1,"lang":"en","texts":{"say:0:1211033101:0":{"text":"This must be the <style=\"highlight\"> Hidden Key</style>!","source_cn":"这就是<style=highlight>潜藏之钥</s...","status":"matched","hash_xxh64":"0x532B639C8978BECF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/en/timeline/quest_story/12110260.json":{"asset_key":"timeline/quest_story_12110260","episode":"timeline","category":"quest_story","story_id":"12110260","schema_version":1,"lang":"en","texts":{"say:1:1211026001:1":{"text":"Magister, there's a golem! There's a golem on this island!","source_cn":"主人……有魔偶！魔偶出现在无人岛了！","status":"matched_runtime_gender","hash_xxh64":"0x2E66380EF84CC55A","variant_status":"runtime_gender_keys_target_same","male":"Magister, there's a golem! There's a golem on this island!","female":"Magister, there's a golem! There's a golem on this island!","variant_male_record_index":"130980","variant_female_record_index":"130981","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1211026002:1":{"text":"That's a big toy!","source_cn":"是大玩具！","status":"matched","hash_xxh64":"0x062B8793537E50B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211026003:1":{"text":"It's a very dangerous machine. We'd best to keep our distance.","source_cn":"这是很危险的战争机器，最好保持距离。","status":"matched","hash_xxh64":"0x91CF26EC6215533D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211026004:1":{"text":"Speaking of which, there are more golems here than in the Remnant Peaks.","source_cn":"不过话说回来，这里的魔偶简直比遗迹群山还要多。","status":"matched","hash_xxh64":"0xEA438AE931EF9C7B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211026005:1":{"text":"Does the god of the waves want us to defeat these golems?","source_cn":"风浪与漂泊之神是希望我们打败这些魔偶吗？","status":"matched","hash_xxh64":"0xB339CF4BC613003C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1211026006:1":{"text":"Think carefully about the key. It's called the Hidden Key.","source_cn":"你们仔细想想那把钥匙的名字，是潜藏之钥。","status":"matched","hash_xxh64":"0x134E943F7C56181C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1211026007:1":{"text":"Legend has it that the god of the waves is very good at hiding. He's elusive, and it's hard to find him.","source_cn":"传说中，风浪与漂泊之神很善于躲藏，祂的行踪捉摸不定。","status":"matched","hash_xxh64":"0xDD06C9B1CF8F2AE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1211026008:1":{"text":"In that case, this trial may want us to avoid the guards and not fight them.","source_cn":"这样的话，根据那位神明的性格来看，这次试炼是让我们躲开...","status":"matched","hash_xxh64":"0x8DED1AA467CC22A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1211026009:1":{"text":"Yes, I agree.","source_cn":"我认同你的看法。","status":"matched","hash_xxh64":"0x4AD9DA9CAA087458","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1211026010:1":{"text":"I just took a closer look. These guys all have blind spots. If we're careful, we won't be discovered.","source_cn":"刚才我仔细观察了一下，这些家伙都有视野盲区，我们谨慎些...","status":"matched","hash_xxh64":"0xD2F87D0A6F547E80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":5}}}}