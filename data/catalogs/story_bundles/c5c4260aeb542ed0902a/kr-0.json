male":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/kr/ep2/quest_story/12110330.json":{"asset_key":"ep2/quest_story_12110330","episode":"ep2","category":"quest_story","story_id":"12110330","schema_version":1,"lang":"kr","texts":{"say:1:1211033001:1":{"text":"노트에 적힌 대로라면 골렘은 파도와 표류의 신이 일부러 남겨둔 거야.","source_cn":"按照笔记上的说法，魔偶好像是风浪与漂泊之神故意留在这里的。","status":"matched","hash_xxh64":"0x2F84F33A36FCAEC8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1211033002:1":{"text":"공격적이지 않은 걸 보니, 신이 불량품을 주워온 것 같네요.","source_cn":"这里的魔偶大多攻击性不强，可能是那位神明捡来的残次品吧。","status":"matched","hash_xxh64":"0xAAF430540D76398A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1211033003:1":{"text":"살육을 좋아하지 않는 신이라니, 새로운 발견이네요. 신들의 전쟁 시기에 신들은 끝도 없이 계속 싸웠는데 말이죠.","source_cn":"风浪神似乎不喜杀戮，这是个新发现。毕竟在诸神之战时期，...","status":"matched","hash_xxh64":"0xF0D1101E98B1E51E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211033004:1":{"text":"그건 그렇고. 저 돌덩어리를 물리쳤는데, 왜 아직 열쇠를 얻지 못한 거지?","source_cn":"比起那些，我们明明已经击败了那个石头疙瘩，为什么还没有...","status":"matched","hash_xxh64":"0x162D31145BFE7565","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211033005:1":{"text":"열쇠라고 부르지만 사실 작은 돌멩이잖아요. 폐허에 묻혀 있을 거예요, 얼른 찾아보죠!","source_cn":"虽然叫钥匙，但只是一个小石块，可能埋在废墟里了，我们找找吧！","status":"matched","hash_xxh64":"0xD19CEC8F230E5624","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"신밧드","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}},"locales/kr/ep2/quest_story/12110331.json":{"asset_key":"ep2/quest_story_12110331","episode":"ep2","category":"quest_story","story_id":"12110331","schema_version":1,"lang":"kr","texts":{"say:0:1211033101:0":{"text":"이게 바로 <style=\"highlight\">잠적의 열쇠</style>인가!","source_cn":"这就是<style=highlight>潜藏之钥</s...","status":"matched","hash_xxh64":"0x532B639C8978BECF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"신밧드","source":"辛巴达","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/kr/timeline/quest_story/12110260.json":{"asset_key":"timeline/quest_story_12110260","episode":"timeline","category":"quest_story","story_id":"12110260","schema_version":1,"lang":"kr","texts":{"say:1:1211026001:1":{"text":"마스터... 골렘이에요! 무인도에 골렘이 나타났어요!","source_cn":"主人……有魔偶！魔偶出现在无人岛了！","status":"matched_runtime_gender","hash_xxh64":"0x2E66380EF84CC55A","variant_status":"runtime_gender_keys_target_same","male":"마스터... 골렘이에요! 무인도에 골렘이 나타났어요!",