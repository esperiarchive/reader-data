{"schema_version":1,"resources":{"locales/en/ep2/quest_story/12227100.json":{"asset_key":"ep2/quest_story_12227100","episode":"ep2","category":"quest_story","story_id":"12227100","schema_version":1,"lang":"en","texts":{"say:0:1222710001:0":{"text":"Magister... it's the golden peacock! You caught the golden peacock!","source_cn":"主人……是黄金孔雀！你钓到了黄金孔雀！","status":"matched_runtime_gender","hash_xxh64":"0x629B6F71A0F4D380","variant_status":"runtime_gender_keys_target_same","male":"Magister... it's the golden peacock! You caught the golden peacock!","female":"Magister... it's the golden peacock! You caught the golden peacock!","variant_male_record_index":"140007","variant_female_record_index":"140008","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1222710002:0":{"text":"Of course, Merlin did it! He reeled in the king of fish with ease!","source_cn":"不愧是梅林！这么轻松就钓到了传说中的鱼王！","status":"matched_runtime_gender","hash_xxh64":"0x5680F724B7F6E31D","variant_status":"runtime_gender_keys_target_differs","male":"Of course, Merlin did it! He reeled in the king of fish with ease!","female":"Of course, Merlin did it! She reeled in the king of fish with ease!","variant_male_record_index":"140009","variant_female_record_index":"140010","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1222710003:0":{"text":"Oh right, we should bring it to that scholar, Jaxon, and let him have a look.","source_cn":"对了，我们把它带去给那位名叫约克逊的学者看看吧。","status":"matched","hash_xxh64":"0x4ACE5C413D2AB81B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}},"locales/en/ep2/quest_story/12227110.json":{"asset_key":"ep2/quest_story_12227110","episode":"ep2","category":"quest_story","story_id":"12227110","schema_version":1,"lang":"en","texts":{"say:1:1222711001:1":{"text":"Jaxon, look what we caught!","source_cn":"约克逊，你看我们钓到了什么！","status":"matched","hash_xxh64":"0x0C2D194C2EB91A08","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:2::0":{"text":"Golden Peacock","source_cn":"黄金孔雀","status":"matched","hash_xxh64":"0x508EF0BB02A5AC0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1222711002:1":{"text":"Dura be praised... That golden figure and the long, flowing tail... It's truly the golden peacock!","source_cn":"艾雅女神显灵……这通体金黄的鱼身，这摇曳的长尾……真的...","status":"matched","hash_xxh64":"0xE1E78A705BE67C2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1222711003:1":{"text":"How in the world did you reel it in?!","source_cn":"你们是怎么钓上它的？！","status":"matched","hash_xxh64":"0xF94B3ED915ADF2F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1222711003":{"text":"How in the world did you reel it in?!","source_cn":"你们是怎么钓上它的？！","status":"matched","hash_xxh64":"0xF94B3ED915ADF2F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1222711004:1":{"text":"That aligns with what I know... but was there anything particularly different that happened?","source_cn":"听起来和我知道的线索差不多……就没有什么特别的地方吗？","status":"matched","hash_xxh64":"0xC04C83F0B8655822","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222711005:0":{"text":"Hmm, does it count that we didn't use gold coins as bait?","source_cn":"唔，我们没有使用金币作为鱼饵算不算？","status":"matched","hash_xxh64":"0xF8E8826463B1CF56","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1222711006:0":{"text":"What?! You just used ordinary bait?!","source_cn":"——什么？！你们只用了普通的鱼饵？！","status":"matched","hash_xxh64":"0xEF3463F797573BC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1222711007:1":{"text":"This doesn't align with what I know of the golden peacock. They say it only takes gold coins as bait...","source_cn":"这和我了解的黄金孔雀的习性不太一样，渔夫们都说它只吃金币……","status":"matched","hash_xxh64":"0xDFF10E429C05EBA2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1222711008:1":{"text":"No, I must study this thoroughly! Otherwise, it would betray the scholarly spirit of the Evergreen Conservatory!","source_cn":"不行，我得好好研究一下！否则就太对不起冬青学会的学者精神了！","status":"matched","hash_xxh64":"0x5A8C7ABBD3478F3F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1222711009:1":{"text":"I hope I'm not being presumptuous, but may I borrow the fish for further examination?","source_cn":"虽然有些冒昧，但我能不能借这条鱼一看？","status":"matched","hash_xxh64":"0xEFD821FD5EBF078C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1222711009":{"text":"I hope I'm not being presumptuous, but may I borrow the fish for further examination?","source_cn":"虽然有些冒昧，但我能不能借这条鱼一看？","status":"matched","hash_xxh64":"0xEFD821FD5EBF078C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1222711011:1":{"text":"Hmm... I'll need a method of experimentation...","source_cn":"让我想想，我得找个法子试验一下……","status":"matched","hash_xxh64":"0x893584B74F416925","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:16:1222711012:1":{"text":"After conducting various experiments, Jaxon returns the golden peacock.","source_cn":"","status":"matched_runtime_gender","hash_xxh64":"0xF4490B75294EDB4B","variant_status":"runtime_gender_keys_target_same","male":"After conducting various experiments, Jaxon returns the golden peacock.","female":"After conducting various experiments, Jaxon returns the golden peacock.","variant_male_record_index":"140023","variant_female_record_index":"140024","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1222711013:1":{"text":"So, how did it go? Any results from the experiments?","source_cn":"怎么样？试验有什么结果吗？","status":"matched","hash_xxh64":"0xDF6EFFF2226A8333","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1222711014:1":{"text":"... There wasn't enough time, and the sample size was too small to obtain a precise conclusion.","source_cn":"……时间太短，样本量也不够，得不到确切的结论。","status":"matched","hash_xxh64":"0xF3209C52C81D5516","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1222711015:1":{"text":"As expected, I'll have to catch a golden peacock myself for long-term observation and study.","source_cn":"果然还是得自己钓一条黄金孔雀，进行长期观察和研究才行。","status":"matched","hash_xxh64":"0x53A1E4EE0E33F2B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1222711016:1":{"text":"Nonetheless, I owe you thanks for revealing the possibility of catching one! Please take this gift!","source_cn":"不过也要多谢你们，让我看到了钓到它的希望！这份礼物就请...","status":"matched","hash_xxh64":"0xBD890A9CE21743F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"Of course.","source_cn":"当然可以","status":"matched_runtime_gender","hash_xxh64":"0xC92DB85FDB6D2502","variant_status":"runtime_gender_keys_target_same","male":"Of course.","female":"Of course.","variant_male_record_index":"67482","variant_female_record_index":"67483","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1222711010:1":{"text":"Come now, the Evergreen Conservatory are not thieves!","source_cn":"嘿，我们冬青学会可不会做出那种强盗行为！","status":"matched","hash_xxh64":"0xDBBB7E1AFB0D8CAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:1:2":{"text":"You'll return it, won't you?","source_cn":"你会还给我的吧？","status":"matched_runtime_gender","hash_xxh64":"0x85F4306F20D1FA9A","variant_status":"runtime_gender_keys_target_same","male":"You'll return it, won't you?","female":"You'll return it, won't you?","variant_male_record_index":"67484","variant_female_record_index":"67485","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"So this is what happened...","source_cn":"（告诉他具体的经过）","status":"matched_runtime_gender","hash_xxh64":"0x91798296AA68AC4A","variant_status":"runtime_gender_keys_target_same","male":"So this is what happened...","female":"So this is what happened...","variant_male_record_index":"67478","variant_female_record_index":"67479","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:1:2":{"text":"We didn't use gold...","source_cn":"（强调自己没用金币作为鱼饵）","status":"matched_runtime_gender","hash_xxh64":"0x0714499F67CECDF5","variant_status":"runtime_gender_keys_target_same","male":"We didn't use gold...","female":"We didn't use gold...","variant_male_record_index":"67480","variant_female_record_index":"67481","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:约克逊":{"text":"Jaxon","source":"约克逊","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":24,"localized_text_count":23,"speaker_count":4}}}}