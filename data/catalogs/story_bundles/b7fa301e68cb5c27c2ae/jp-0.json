ment_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1221105004":{"text":"ロンロンもそう思う……\nそうだ！ボクたちでこの子の願いを叶えてあげましょうよ！","source_cn":"满满也这样觉得……\\n要不，我们来帮他实现愿望吧！","status":"matched","hash_xxh64":"0x956067DE60DCC52C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1221105005:1":{"text":"はい！子どもの夢を守るのも騎士の務めですから！","source_cn":"没错！骑士也应该守护孩子们的童真美梦！","status":"matched","hash_xxh64":"0x3DA3F01453AB9E79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1221105006:1":{"text":"<style=\"highlight\">ニジイロダイ</style>を釣るのは難しくないけど、私たちが釣ったことをあの子に知られないようにしないと。","source_cn":"钓一条<style=highlight>幻彩鲷</st...","status":"matched","hash_xxh64":"0x12D4CAD71F948816","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1221105007:1":{"text":"うーん……ニジイロダイを漂流ボトルに入れて、家の前に置いておくのはどう？それなら、海が願いを叶えてくれたって思うんじゃないかな？","source_cn":"嗯……也许可以把幻彩鲷装在漂流瓶里，放到他家门口。这样...","status":"matched","hash_xxh64":"0x9B773C3699DB6411","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1221105008:1":{"text":"いい考えだわ！ロンロンもたまにはいいこと思いつくじゃない！","source_cn":"这个办法不错！满满，你变聪明了~","status":"matched","hash_xxh64":"0xFD78E833D37C0FF4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"いいアイデアだ。","source_cn":"是个好主意","status":"matched_runtime_gender","hash_xxh64":"0xC2288D658FE2E65F","variant_status":"runtime_gender_keys_target_differs","male":"いいアイデアだ。","female":"いいアイデアね。","variant_male_record_index":"66446","variant_female_record_index":"66447","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"ニジイロダイをこの子に届けたいのか？","source_cn":"你想送一条幻彩鲷给他？","status":"matched_runtime_gender","hash_xxh64":"0xBE6D7B2A8B5777F2","variant_status":"runtime_gender_keys_target_differs","male":"ニジイロダイをこの子に届けたいのか？","female":"ニジイロダイをこの子に届けたいの？","variant_male_record_index":"66448","variant_female_record_index":"66449","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":12,"localized_text_count":11,"speaker_count":2}},"locales/jp/ep2/quest_story/12211060.json":{"asset_key":"ep2/quest_story_12211060","episode":"ep2","category":"quest_story","story_id":"12211060","schema_version":1,"lang":"jp","texts":{"say:0:1221106001:0":{"text":"ニジイロダイはこの辺に生息しているはずです。早速この近くで釣ってみましょう！","source_cn":"幻彩鲷就生活在这片海域里，我们在附近试试看能不能钓上来吧。","status":"matched","hash_xxh64":"0x96A38A7EC0869228","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":2,"localized_text_count":1,"speaker_count":1}},"locales/jp/ep2/quest_story/12211070.json":{"asset_ke