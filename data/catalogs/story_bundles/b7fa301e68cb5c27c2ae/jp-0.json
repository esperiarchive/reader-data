"},"say:13:1221103009:1":{"text":"でも何を使って引き寄せれば……","source_cn":"可我们手头也没有打捞工具呀……","status":"matched","hash_xxh64":"0xBCE3265B608634F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1221103010:1":{"text":"近くに、<style=\"highlight\">網</style>、切れ端、ある！くっつける！","source_cn":"附近，有<style=highlight>渔网</st...","status":"matched","hash_xxh64":"0xDC65B9E6CDA283D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1221103011:1":{"text":"なるほど！それでは早速大きな網を作りましょう！","source_cn":"还可以这样！？那我们还等什么，赶紧拼张大网出来吧！","status":"matched","hash_xxh64":"0xBEF455154A1D67BB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:蓝叶荧荧花":{"text":"青い葉の蛍光花","source":"蓝叶荧荧花","status":"matched_dialogue_flow"},"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"},"speaker:绿叶荧荧花":{"text":"緑葉の蛍光花","source":"绿叶荧荧花","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":12,"localized_text_count":11,"speaker_count":4}},"locales/jp/ep2/quest_story/12211040.json":{"asset_key":"ep2/quest_story_12211040","episode":"ep2","category":"quest_story","story_id":"12211040","schema_version":1,"lang":"jp","texts":{"say:0:1221104001:0":{"text":"これぐらいの大きさなら十分ですね。早速漂流ボトルに向かって投げてみましょう！","source_cn":"这张网应该够大了，试试看能不能把漂流瓶捞上来吧。","status":"matched","hash_xxh64":"0x38F06D71A450AD46","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_reco