xploration":"0","ExplorationPoint":"0","ObjectFuncTag":"[]","HSInsID":"0"},"menu_states":[],"menu_actions":[],"npc_states":[],"visibility_rules":[],"joins":[],"document_objects":[{"object":{"kind":"MapObj","shard":"3","record_order":"10910","table_key":"311512","record_key":"311512","choice_index":"","ID":"311512","Loc":"2410334","ZoneID":"11","Rotation":"1","InitStates":"[1 | 5]","FinalStates":"[2 | 7 | 5]","Type":"26","ClientType":"Stele","AreaAxialID":"1","BlockAxialID":"1","PrefabID":"479","DialogueMenuID":"0","Blackboard":"{TextGalleryID=311512}","Deviation":"{posdeviation={x=0 | y=4933 | z=0} | rotdeviation=0 | scale=100}","CollisionRadius":"0","InteractionRadius":"0","BattleGroupID":"0","RunnerTreasureIDs":"[]","EntranceMapID":"0","EntraceObj":"0","TipName":"命令函","UnRecycleField":"","TargetObj":"0","ArriveObj":"0","Reward":"[]","LocPriority":"0","BpObjType":"73","TreasureSize":"","LaserGroup":"0","LaserID":"0","BpGroup":"0","MovableRange":"0","MapRangeID":"0","MonsterBindObjectIDs":"[]","SearchAreaRadius":"0","IsExplUse":"false","BehaviourTreeID":"0","PathFindingName":"","BioConfig":"[]","InteractConditionGroupID":"[]","IdolPlatePlacement":"[]","ZoneMonsterDisplayID":"[]","MapPathID":"0","ObjTypeParam":"[]","ExtraRulesID":"0","InteractName":"[]","RetroCanOverwhelmed":"false","SeasonType":"","RetroExploration":"0","ExplorationPoint":"0","ObjectFuncTag":"[]","HSInsID":"0"},"source_rows":[{"kind":"TextDes","shard":"","record_order":"744","table_key":"311512","record_key":"311512","choice_index":"","ID":"311512","Order":"1","ObjectID":"311512","ItemID":"0","Tipname":"","Title":"命令函","Icon":"UI/Icon/Item/spui_icon_item_letter.png","ImageIcon":"","BaseImage":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item10.prefab","Pic":"","Content":"黑金商会绝密命令函\n\n致监工团队\n\n如前所述，我们已经锁定了墓穴入口的所在之地。然而，那片区域的地面上布满了可恶的蜘蛛巢穴，它们会疯狂地攻击任何接近的生灵。\n\n为了确保我们的行动不被那些可憎的生物干扰，现在向你们发布命令：\n\n1.避开那些蜘蛛巢穴，深入地底，挖掘出通向长眠地的地下隧道。\n\n2.在挖掘的过程中，任何敢于违抗命令或消极怠工的劳工随你们任意处置，直至任务完成。\n\n3.每日向商会高层汇报挖掘进度，若遇到任何异常情况的迹象，必须立刻上报并等待进一步的指示。\n\n另，若在开掘时发现异色烟雾，是正常现象。不必惊慌。","Gender":"false"}]}],"completion_written":false,"source_completion_simulated":false,"sibling_order_claimed":false,"live_observed":false,"server_admission_simulated":false,"title_provenance":"editorial","reading_policy":"independent_configured_world_visit; optional topics in configuration order; no mandatory sibling traversal","qualification":"Ambient requests are shown once per configured visit. Original menu options, typed task offers, state writers and client visibility remain separate in this contract. This reading projection does not manufacture a callback or live completion.","complete_controller":{"line":{"kind":"ExplLine","shard":"1101","record_order":"176","table_key":"11010311","record_key":"11010311","choice_index":"","LineID":"11010311","LineName":"EP1Zone11人文","ZoneGroupID":"10007","LineType":"3","LastTaskID":"1","ShowCondition":"true","RecvConditionText":"","LineDes":"","ShowAction":"true","Rewards":"[]","ResetObjects":"[]","ResetDynGroups":"[]","ResetItems":"[]","ExtraParam":"","BlockShow":"false","EffectCondition":"true","DGender":"false","Gender":"false"},"tasks":[{"kind":"ExplTask","shard":"1101","record_order":"419","table_key":"11010311","record_key":"11010311:1","choice_index":"","LineID":"11010311","TaskID":"1","NextTaskIDs":"[]","ClientRecvEvents":"[ExplTaskFinish:11010101:2]","RecvCondition":"ed.ConditionX.IsExplTaskFinished(11010101,2)","ClientRecvActionByMove":"true","RecvAction":"ed.ActionX.AddStates(313082,\"Show\",\"Interactive\") and ed.ActionX.AddStates(313083,\"Show\",\"Interactive\")","LastStepID":"9","ActionRewards":"[]","HasTimelinePlot":"false"}],"steps":[{"kind":"ExplStep","shard":"1101","record_order":"2059","table_key":"11010311","record_key":"11010311:1:1","choice_index":"","LineID":"11010311","TaskID":"1","StepID":"1","PreStepList":"[]","ClientFinishEvents":"[]","Story":"","FinishCondition":"true","IsClientExpl":"false","ClientFinishCondition":"true","ClientConditionType":""