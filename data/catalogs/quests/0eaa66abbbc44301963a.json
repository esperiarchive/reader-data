],"objective_title":{"cn":"驱赶老鼠","en":"Get Rid of Rats","jp":"ネズミを追い払う","kr":"쥐 쫓아내기"},"objective_description":{"cn":"准备好了，就找水鬼帮奈克开始驱赶老鼠吧。","en":"Once you are ready, find Niko and drive away the rats together.","jp":"準備が整ったら、ナイクと一緒にネズミを退治しよう。","kr":"준비는 모두 끝났다. 물귀신파 나이크를 찾아가 쥐를 쫓아내자."}},{"step_id":"5","pre_step_ids":["4"],"objective_title":{"cn":"去钓苔鲤的水边","en":"Go to Fishing Spot","jp":"モスカープを釣りに行く","kr":"낚시 포인트로 가기"},"objective_description":{"cn":"水鬼帮奈克发现鱼被老鼠啃坏了，拜托你去钓些苔鲤。","en":"Niko finds that the fish have been ruined and asks you to catch some grass carp for him.","jp":"ネズミにかじられた魚を発見したナイクは、あなたにモスカープを釣ってきてほしいと頼んだ。","kr":"창고의 생선을 쥐가 파먹은 것을 발견한 물귀신파 나이크가 이끼 잉어를 낚아다 달라고 부탁했다."}},{"step_id":"6","pre_step_ids":["5"],"objective_title":{"cn":"钓鱼","en":"Fishing","jp":"釣り","kr":"낚시"},"objective_description":{"cn":"你到了钓苔鲤的鱼群位置附近，开始钓鱼吧。","en":"You arrive at the spot to catch grass carp. Start fishing!","jp":"モスカープの釣りポイントに到着した。釣りを開始しよう。","kr":"이끼 잉어를 낚을 수 있는 물고기 무리를 찾았다. 낚시를 시작하자."}},{"step_id":"7","pre_step_ids":["6"],"objective_title":{"cn":"回去找阿尔交差","en":"Return to Al","jp":"アルに報告する","kr":"아르에게 알려주기"},"objective_description":{"cn":"钓到了苔鲤，回去找阿尔交差吧。","en":"Bring the grass carp back to Al.","jp":"モスカープを釣り終わったら、アルのところに戻って報告しよう。","kr":"이끼 잉어를 낚았다. 아르에게 돌아가 알려주자."}}]}],"source_visibility_condition":"true","archive_scope":"Individual optional activity; its appearance in the live world is not simulated.","source_plot_joins":[{"plot":"12236190","asset":"ep2/quest_story_12236190","identity":"12010524:1:2","field":"ClientFinishActionByMove"},{"plot":"12236200","asset":"ep2/quest_story_12236200","identity":"12010524:1:2","field":"ClientFinishActionByMove"},{"plot":"12236220","asset":"ep2/quest_story_12236220","identity":"12010524:1:4","field":"FinishAction"},{"plot":"12236230","asset":"ep2/quest_story_12236230","identity":"12010524:1:5","field":"ClientFinishActionByMove"},{"plot":"12236240","asset":"ep2/quest_story_12236240","identity":"12010524:1:5","field":"ClientFinishActionByMove