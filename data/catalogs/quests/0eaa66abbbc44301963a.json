{"quest":{"line_id":"12010524","line_type":"5","order":273,"title":{"cn":"破坏分子","en":"Troublemakers","jp":"反乱分子","kr":"내부 분열"},"description":{"cn":"","en":"","jp":"","kr":""},"reputation_camp_id":"201","reputation_camp_title":{"cn":"水鬼帮","en":"Water Wights","jp":"海のギャング","kr":"물귀신파"},"route":"#/season-2/daily/12010524","assets":[{"asset_key":"optional/objective_12010524:1:1"},{"asset_key":"ep2/quest_story_12236180"},{"asset_key":"optional/objective_12010524:1:2"},{"asset_key":"ep2/quest_story_12236190"},{"asset_key":"ep2/quest_story_12236200"},{"asset_key":"optional/objective_12010524:1:3"},{"asset_key":"faction_dailies/menu_12010524:1:3"},{"asset_key":"ep2/quest_story_12236210"},{"asset_key":"optional/objective_12010524:1:4"},{"asset_key":"ep2/quest_story_12236220"},{"asset_key":"optional/objective_12010524:1:5"},{"asset_key":"ep2/quest_story_12236230"},{"asset_key":"ep2/quest_story_12236240"},{"asset_key":"optional/objective_12010524:1:6"},{"asset_key":"ep2/quest_story_12236250"},{"asset_key":"optional/objective_12010524:1:7"},{"asset_key":"ep2/quest_story_12236260"}],"tasks":[{"task_id":"1","steps":[{"step_id":"1","pre_step_ids":[],"objective_title":{"cn":"问问阿尔近况","en":"Check on Al","jp":"アルに近況を尋ねる","kr":"아르의 근황 묻기"},"objective_description":{"cn":"阿尔等人扬言要在锈锚港重新开始，去看看他们是否需要帮助。","en":"Al and his crew say they want a fresh start in Rustport. Go see if they need assistance.","jp":"アルたちは、街でまた一から始めるのだと豪語していた。何か手伝うことはないか様子を見に行こう。","kr":"아르 일행이 러스트 항에서 새출발을 다짐했다. 혹시 도움이 필요하지 않은지 확인해 보자."}},{"step_id":"2","pre_step_ids":["1"],"objective_title":{"cn":"前往仓库","en":"Reach the Warehouse","jp":"倉庫へ向かう","kr":"창고로 이동하기"},"objective_description":{"cn":"水鬼阿尔说仓库闹老鼠了，他们请你过去看看。","en":"Al says the warehouse is infested with rats and asks you to help take a look.","jp":"倉庫にネズミがはびこっているとのことで、アルはあなたに確認に行ってほしいと頼んだ。","kr":"물귀신파 아르가 창고에 쥐가 나타났으니 도와달라고 한다."}},{"step_id":"3","pre_step_ids":["2"],"objective_title":{"cn":"询问水鬼帮奈克情况","en":"Ask Niko","jp":"ナイクに状況を聞く","kr":"나이크에게 물어보기"},"objective_description":{"cn":"水鬼帮奈克正在仓库准备驱赶老鼠，问问他怎么做。","en":"Niko is preparing to drive away the rats. Ask him about his plan.","jp":"ナイクは、倉庫でネズミ退治の準備を進めている。状況を聞いてみよう。","kr":"물귀신파 나이크가 창고에서 쥐를 쫓아내려고 하고 있다. 어떻게 할지 물어보자."}},{"step_id":"4","pre_step_ids":["3"],"objective_title":{"cn":"驱赶老鼠","en":"Get Rid of Rats","jp":"ネズミを追い払う","kr":"쥐 쫓아내기"},"objective_description":{"cn":"准备好了，就找水鬼帮奈克开始驱赶老鼠吧。","en":"Once you are ready, find Niko and drive away the rats together.","jp":"準備が整ったら、ナイクと一緒にネズミを退治しよう。","kr":"준비는 모두 끝났다. 물귀신파 나이크를 찾아가 쥐를 쫓아내자."}},{"step_id":"5","pre_step_ids":["4"],"objective_title":{"cn":"去钓苔鲤的水边","en":"Go to Fishing Spot","jp":"モスカープを釣りに行く","kr":"낚시 포인트로 가기"},"objective_description":{"cn":"水鬼帮奈克发现鱼被老鼠啃坏了，拜托你去钓些苔鲤。","en":"Niko finds that the fish have been ruined and asks you to catch some grass carp for him.","jp":"ネズミにかじられた魚を発見したナイクは、あなたにモスカープを釣ってきてほしいと頼んだ。","kr":"창고의 생선을 쥐가 파먹은 것을 발견한 물귀신파 나이크가 이끼 잉어를 낚아다 달라고 부탁했다."}},{"step_id":"6","pre_step_ids":["5"],"objective_title":{"cn":"钓鱼","en":"Fishing","jp":"釣り","kr":"낚시"},"objective_description":{"cn":"你到了钓苔鲤的鱼群位置附近，开始钓鱼吧。","en":"You arrive at the spot to catch grass carp. Start fishing!","jp":"モスカープの釣りポイントに到着した。釣りを開始しよう。","kr":"이끼 잉어를 낚을 수 있는 물고기 무리를 찾았다. 낚시를 시작하자."}},{"step_id":"7","pre_step_ids":["6"],"objective_title":{"cn":"回去找阿尔交差","en":"Return to Al","jp":"アルに報告する","kr":"아르에게 알려주기"},"objective_description":{"cn":"钓到了苔鲤，回去找阿尔交差吧。","en":"Bring the grass carp back to Al.","jp":"モスカープを釣り終わったら、アルのところに戻って報告しよう。","kr":"이끼 잉어를 낚았다. 아르에게 돌아가 알려주자."}}]}],"archive_scope":"Configured faction daily paths. Live assignment, NPC visibility and minigame/battle success are not simulated.","source_plot_joins":[{"plot":"12236180","asset":"ep2/quest_story_12236180","resource":"nodecanvas/dialoguetree/ep2/quest_story_12236180.asset","raw_sha256":"c2eccf0321494192896003b9a739bffceb10eeec245b143a480235e5c19a56bc","lpak":"binary_NodeCanvas_DialogueTree_17859706585472604641.lpak","offset":9825008,"size":1496,"identity":"12010524:1:1","fie