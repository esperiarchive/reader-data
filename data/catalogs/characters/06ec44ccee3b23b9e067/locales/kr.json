rds/12/locales/cn","locales/cn/mn2/herohub_story/10412070.json"],["/interaction_records/12/locales/kr","locales/kr/mn2/herohub_story/10412070.json"],["/interaction_records/12/title_i18n/cn","莱卡 & 洛桑"],["/interaction_records/12/title_i18n/kr","라이카 & 로잔"],["/interaction_records/12/locations/0/name_i18n/cn","薄暮丛林"],["/interaction_records/12/locations/0/name_i18n/kr","땅거미 숲"],["/interaction_records/13/preview_i18n/cn","嘿，达米安，我离开丛林都三年了，你肯定做出来不少好东西吧？"],["/interaction_records/13/preview_i18n/kr","안녕, 다미안. 내가 숲을 떠난 3년 동안 좋은 거 많이 만들었겠지?"],["/interaction_records/13/locales/cn","locales/cn/mn2/herohub_story/10412090.json"],["/interaction_records/13/locales/kr","locales/kr/mn2/herohub_story/10412090.json"],["/interaction_records/13/title_i18n/cn","洛桑 & 达米安 & 达赫妮"],["/interaction_records/13/title_i18n/kr","로잔 & 다미안 & 다프니"],["/interaction_records/13/locations/0/name_i18n/cn","薄暮丛林"],["/interaction_records/13/locations/0/name_i18n/kr","땅거미 숲"],["/interaction_records/14/preview_i18n/cn","莱卡，你今天准备的食物有点多吧？"],["/interaction_records/14/preview_i18n/kr","라이카, 오늘 준비한 음식이 좀 너무 많은 것 같은데?"],["/interaction_records/14/locales/cn","locales/cn/mn2/herohub_story/10412100.json"],["/interaction_records/14/locales/kr","locales/kr/mn2/herohub_story/10412100.json"],["/interaction_records/14/title_i18n/cn","洛桑 & 莱卡"],["/interaction_records/14/title_i18n/kr","로잔 & 라이카"],["/interaction_records/15/preview_i18n/cn","满满一直很好奇一件事。"],["/interaction_records/15/preview_i18n/kr","치피 궁금한 게 있어요."],["/interaction_records/15/locales/cn","locales/cn/mn2/herohub_story/10412140.json"],["/interaction_records/15/locales/kr","locales/kr/mn2/herohub_story/10412140.json"],["/interaction_records/15/title_i18n/cn","满满 & 洛桑"],["/interaction_records/15/title_i18n/kr","치피 & 로잔"],["/interaction_records/15/locations/0/name_i18n/cn","薄暮丛林"],["/interaction_records/15/locations/0/name_i18n/kr","땅거미 숲"],["/interaction_records/15/locations/1/name_i18n/cn","瓦度索山脉"],["/interaction_records/15/locations/1/name_i18n/kr","바투소 산맥"],["/interac