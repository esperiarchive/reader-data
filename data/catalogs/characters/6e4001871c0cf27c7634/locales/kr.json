/9/locations/0/name_i18n/cn","遗迹群山"],["/interaction_records/9/locations/0/name_i18n/kr","유적의 산"],["/interaction_records/10/preview_i18n/cn","我啊，一直都想有些弟弟妹妹……"],["/interaction_records/10/preview_i18n/kr","나도 항상 동생들이 있으면 좋겠다고 생각했어..."],["/interaction_records/10/locales/cn","locales/cn/mn3/herohub_story/10414110.json"],["/interaction_records/10/locales/kr","locales/kr/mn3/herohub_story/10414110.json"],["/interaction_records/10/title_i18n/cn","菲 & 梅瑞特"],["/interaction_records/10/title_i18n/kr","페이 & 메린"],["/interaction_records/10/locations/0/name_i18n/cn","遗迹群山"],["/interaction_records/10/locations/0/name_i18n/kr","유적의 산"],["/interaction_records/11/preview_i18n/cn","特弥希娅，你在喝燕麦粥吗？"],["/interaction_records/11/preview_i18n/kr","테미히아, 오트밀 죽을 먹고 있는 거예요?"],["/interaction_records/11/locales/cn","locales/cn/mn3/herohub_story/10414120.json"],["/interaction_records/11/locales/kr","locales/kr/mn3/herohub_story/10414120.json"],["/interaction_records/11/title_i18n/cn","菲 & 特弥希娅"],["/interaction_records/11/title_i18n/kr","페이 & 테미히아"],["/interaction_records/12/preview_i18n/cn","寻宝需要的是智慧、灵巧和运气，三者缺一不可……"],["/interaction_records/12/preview_i18n/kr","보물찾기를 할 땐 지혜와 민첩함 그리고 운이 따라 줘야 해. 하나도 빠져서는 안 되지."],["/interaction_records/12/locales/cn","locales/cn/mn3/herohub_story/10414160.json"],["/interaction_records/12/locales/kr","locales/kr/mn3/herohub_story/10414160.json"],["/interaction_records/12/title_i18n/cn","阿塔兰忒 & 菲"],["/interaction_records/12/title_i18n/kr","아탈란테 & 페이"]]}