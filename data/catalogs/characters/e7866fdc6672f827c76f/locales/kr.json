ds/7/locales/cn","locales/cn/mn3/herohub_story/10414020.json"],["/interaction_records/7/locales/kr","locales/kr/mn3/herohub_story/10414020.json"],["/interaction_records/7/title_i18n/cn","满满 & 特弥希娅"],["/interaction_records/7/title_i18n/kr","치피 & 테미히아"],["/interaction_records/7/locations/0/name_i18n/cn","遗迹群山"],["/interaction_records/7/locations/0/name_i18n/kr","유적의 산"],["/interaction_records/8/preview_i18n/cn","特弥希娅，你在喝燕麦粥吗？"],["/interaction_records/8/preview_i18n/kr","테미히아, 오트밀 죽을 먹고 있는 거예요?"],["/interaction_records/8/locales/cn","locales/cn/mn3/herohub_story/10414120.json"],["/interaction_records/8/locales/kr","locales/kr/mn3/herohub_story/10414120.json"],["/interaction_records/8/title_i18n/cn","菲 & 特弥希娅"],["/interaction_records/8/title_i18n/kr","페이 & 테미히아"]]}