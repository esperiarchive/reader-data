interaction_records/7/title_i18n/cn","奈拉"],["/interaction_records/7/title_i18n/kr","나라"],["/interaction_records/8/preview_i18n/cn","哈，这也太热闹了吧！"],["/interaction_records/8/preview_i18n/kr","하, 너무 떠들썩한 거 아니야!"],["/interaction_records/8/locales/cn","locales/cn/mn/herohub_story/10415621.json"],["/interaction_records/8/locales/kr","locales/kr/mn/herohub_story/10415621.json"],["/interaction_records/8/title_i18n/cn","奈拉"],["/interaction_records/8/title_i18n/kr","나라"],["/interaction_records/9/preview_i18n/cn","走，去外头找点乐子！"],["/interaction_records/9/preview_i18n/kr","자, 즐거움을 찾으러 나가볼까!"],["/interaction_records/9/locales/cn","locales/cn/mn/herohub_story/10415622.json"],["/interaction_records/9/locales/kr","locales/kr/mn/herohub_story/10415622.json"],["/interaction_records/9/title_i18n/cn","奈拉"],["/interaction_records/9/title_i18n/kr","나라"]]}