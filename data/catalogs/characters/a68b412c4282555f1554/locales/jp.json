mn/herohub_story/10415663.json"],["/interaction_records/8/locales/jp","locales/jp/mn/herohub_story/10415663.json"],["/interaction_records/8/title_i18n/cn","都铎 & 科林"],["/interaction_records/8/title_i18n/jp","タドール & コリン"],["/interaction_records/9/preview_i18n/cn","要是问我和达米安的相遇……"],["/interaction_records/9/preview_i18n/jp","俺とダミアンの出会いか……"],["/interaction_records/9/locales/cn","locales/cn/mn2/herohub_story/10412020.json"],["/interaction_records/9/locales/jp","locales/jp/mn2/herohub_story/10412020.json"],["/interaction_records/9/title_i18n/cn","科林 & 达米安"],["/interaction_records/9/title_i18n/jp","コリン & ダミアン"],["/interaction_records/9/locations/0/name_i18n/cn","薄暮丛林"],["/interaction_records/9/locations/0/name_i18n/jp","ユグドラシル"],["/interaction_records/10/preview_i18n/cn","科林大叔，你的手臂是怎么变成现在这样的？满满从来没见过这么严重的伤！"],["/interaction_records/10/preview_i18n/jp","コリンさんの腕はなぜそうなってしまったのですか？ロンロン、こんなにひどい傷を見たのは初めてです！"],["/interaction_records/10/locales/cn","locales/cn/mn2/herohub_story/10412080.json"],["/interaction_records/10/locales/jp","locales/jp/mn2/herohub_story/10412080.json"],["/interaction_records/10/title_i18n/cn","满满 & 科林"],["/interaction_records/10/title_i18n/jp","ロンロン & コリン"]]}