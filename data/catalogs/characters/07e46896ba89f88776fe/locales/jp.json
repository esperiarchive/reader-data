ords/14/preview_i18n/jp","ワシの作った提灯を見せてやろう！"],["/interaction_records/14/locales/cn","locales/cn/mn/herohub_story/10415530.json"],["/interaction_records/14/locales/jp","locales/jp/mn/herohub_story/10415530.json"],["/interaction_records/14/title_i18n/cn","呼金"],["/interaction_records/14/title_i18n/jp","フーキン"],["/interaction_records/15/preview_i18n/cn","呼金！你来得正好！上次你提到的新作品，拿来给我看看！"],["/interaction_records/15/preview_i18n/jp","フーキン！ちょうどいいとこに！この前言ってた新作を見せてみな。"],["/interaction_records/15/locales/cn","locales/cn/mn/herohub_story/10415660.json"],["/interaction_records/15/locales/jp","locales/jp/mn/herohub_story/10415660.json"],["/interaction_records/15/title_i18n/cn","祖娅 & 呼金"],["/interaction_records/15/title_i18n/jp","ゾーヤ & フーキン"]]}