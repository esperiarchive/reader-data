 센시가 해물죽을 만들어줬다."},"summary_status":{"cn":"hash_not_found","en":"matched_luae","jp":"matched_luae","kr":"matched_luae"},"asset_key":"mn/gameplay_story_10640060","asset_path":"mn/gameplay_story/NodeCanvas__DialogueTree__mn__gameplay_story_10640060.decoded.json","graph":"stories/mn/gameplay_story/10640060.graph.json","locales":{"cn":"locales/cn/mn/gameplay_story/10640060.json","en":"locales/en/mn/gameplay_story/10640060.json","jp":"locales/jp/mn/gameplay_story/10640060.json","kr":"locales/kr/mn/gameplay_story/10640060.json"},"machine_locales":{},"stats":{"source_node_count":12,"graph_node_count":9,"effect_event_count":0,"text_entry_count":9,"speaker_entry_count":4,"cast_state_line_count":6,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0},"dialogue_statement_ids":["1064006001","1064006002","1064006003","1064006003","1064006001","1064006004","1064006005","1064006006"],"cinematic_statement_ids":[],"previous_plot_asset_key":"mn/gameplay_story_10640050","next_plot_asset_key":"mn/gameplay_story_10640070","previous_story_asset_key":"mn/gameplay_story_10640050","next_story_asset_key":"mn/gameplay_story_10640070"},"mn/gameplay_story_10640070":{"episode":"mn","category":"gameplay_story","story_id":"10640070","sequence_index":6,"plot_row_index":"7305","order_index":"7305","numeric_id":"10640070","physical_section":"mn","plot_id":"10640070","dialogue_kind":"Normal","summary":"获得了第三个食材后，你们决定去温泉旅馆休整。温泉水不仅缓解了所有人的疲惫，洛桑和格尔达还提供了鹿肉饺蘸酸奶油和冰晶莓奶冻。","summary_source_cn":"获得了第三个食材后，你们决定去温泉旅馆休整。温泉水不仅缓解了所有人的疲惫，洛桑和格尔达还提供了鹿肉饺蘸酸奶油和冰晶莓奶冻。","summary_i18n":{"cn":"获得了第三个食材后，你们决定去温泉旅馆休整。温泉水不仅缓解了所有人的疲惫，洛桑和格尔达还提供了鹿肉饺蘸酸奶油和冰晶莓奶冻。","en":"Once you have the third ingredient, you stop at a hot-spring inn to rest. The steaming water melts away everyone's fatigue. Lorsan and Gerda serve everyone venison dumplings with sour cream and crystalberry panna cotta.","jp":"食材が無事に手に入ったので、温泉旅館でひと息つくことにした。湯に浸かって疲れを癒やしたあと、クインとガルダが鹿肉餃子とパンナ・コッタを振る舞ってくれた。","kr":"세 번째 식재료를 얻은 뒤, 온천 여관에서 쉬기로 했다. 온천에서 피로를 씻고 있는 도중, 로잔과 게르다가 사슴만두&사워크림과 얼음 결정 베리 푸딩을 내왔다."},"summary_status":{"cn":"hash_not_found","en":"matched_luae","jp":"matched_luae","kr":"matched_luae"},"asset_key":"mn/gameplay_story_10640070","asset_path":"mn/gameplay_story/NodeCanvas__DialogueTree__mn__gameplay_story_10640070.decoded.json","graph":"stories/mn/gameplay_story/10640070.graph.json","locales":{"cn":"locales/cn/mn/gameplay_story/10640070.json","en":"locales/en/mn/gameplay_story/10640070.json","jp":"locales/jp/mn/gameplay_story/10640070.json","kr":"locales/kr/mn/gameplay_story/10640070.json"},"machine_locales":{},"stats":{"source_node_count":96,"graph_node_count":69,"effect_event_count":0,"text_entry_count":77,"speaker_entry_count":8,"cast_state_line_count":60,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0},"dialogue_statement_ids":["1064007001","1064007002","1064007002","1064007001","1064007003","1064007004","1064007004","1064007002","1064007005","1064007006","1064007007","1064007008","1064007009","1064007010","1064007011","1064007012","1064007013","1064007013","1064007003","1064007014","1064007015","1064007016","1064007016","1064007004","1064007004","1064007017","1064007018","1064007018","1064007005","1064007019","1064007020","1064007021","1064007022","1064007023","1064007024","1064007025","1064007026","1064007027","1064007028","1064007028","1064007006","1064007029","1064007030","1064007031","1064007032","1064007033","1064007034","1064007035","1064007036","1064007037","1064007038","1064007039","1064007040","1064007040","1064007007","1064007041","1064007042","1064007043","1064007044","1064007045","1064007046","1064007047","1064007048","1064007048","1064007008","1064007049","1064007050","1064007051","1064007052","1064007053","1064007054","1064007055","1064007056","1064007057","1064007058","1064007059","1064007060"],"cinematic_statement_ids":[],"previous_plot_asset_key":"mn/gameplay_story_10640060","next_plot_asset_key":"mn/gameplay_story_10640080","previous_story_asset_key":"mn/gameplay_story_10640060","next_story_asset_key":"mn/gameplay_story_10640080"},"mn/gameplay_story_10640080":{"episode":"mn","category":"gameplay_story","story_id":"10640080","sequence_index":7,"plot_row_index":"7306","order_index":"7306","numeric_id":"10640080","physical_section":"mn","plot_id":"10640080","dialogue_kind":"Normal","summary":"只剩最后的元素精华了，你们决定前往锻炉峡湾收集。在这里，你们见到了祖娅，她和森西真是两种截然不同的矮人。","summary_source_cn":"只剩最后的元素精华了，你们决定前往锻炉峡湾收集。在这里，你们见到了祖娅，她和森西真是两种截然不同的矮人。","summary_i18n":{"cn":"只剩最后的元素精华了，你们决定前往锻炉峡湾收集。在这里，你们见到了祖娅，她和森西真是两种截然不同的矮人。","en":"Only one ingredient missing: the elemental essence. To find it, you head to Ironhold Bay. There, you meet Zanie, a dwarf utterly unlike Senshi.","jp":"残すは元素エキスだけだ。フォージ峡湾へ向かうと、そこでゾーヤを見かけた。同じドワーフでも、ゾーヤとセンシはだいぶ違うようだ。","kr":"마지막으로, 원소 에센스를 찾기 위해 포지 피오르로 향했다. 포지 피오르에서 조아를 마주쳤고, 같은 드워프라고 믿기지 않을 만큼, 조아와 센시는 모든 것이 정반대였다."},"summary_status":{"cn":"hash_not_found","en":"matched_luae","jp":"matched_luae","kr":"matched_luae"},"asset_key":"mn/gameplay_story_10640080","asset_path":"mn/gameplay_story/NodeCanvas__DialogueTree__mn__gameplay_story_10640080.decoded.json","graph":"stories/mn/gameplay_story/10640080.graph.json","locales":{"cn":"locales/cn/mn/gameplay_story/10640080.json","en":"locales/en/mn/gameplay_story/10640080.json","jp":"locales/jp/mn/gameplay_story/10640080.json","kr":"locales/kr/mn/gameplay_story/10640080.json"},"machine_locales":{},"stats":{"source_node_count":79,"graph_node_count":57,"effect_event_count":2,"text_entry_count":57,"speaker_entry_count":14,"cast_state_line_count":49,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":2,"subtitle_count":0,"cinematic_dialogue_count":0},"dialogue_statement_ids":["1064008001","1064008002","1064008003","1064008004","1064008004","1064008001","1064008005","1064008006","1064008007","1064008008","1064008009","1064008010","1064008011","1064008012","1064008012","106400