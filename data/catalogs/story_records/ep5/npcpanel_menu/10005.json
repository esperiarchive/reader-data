事に勝ち取った。","kr":"센로는 바리가 가장 많은 사냥감을 잡았지만 고의로 동료를 해쳤다고 꾸짖었고, 사냥대 선발에 승리해 사냥대에 합류할 자격을 얻은 것은 동료를 도왔던 수스라고 선언했다."},"context_summary_status":{"cn":"aligned_plot_summary","en":"aligned_plot_summary","jp":"aligned_plot_summary","kr":"aligned_plot_summary"},"context_summary_record_index":25290,"context_summary_record_indices":[25290],"context_summary_match_status":"aligned_exact_unique","context_summary_source_asset_key":"ep5/npcpanel_menu_10001780","context_summary_direction":"next_plot_summary","context_summary_distance":1,"episode_title_source_cn":"血月将至","episode_title_i18n":{"cn":"血月将至","en":"Thorns of Devotion","jp":"紅き月の刻","kr":"붉은 달의 예언"},"episode_title_status":{"cn":"exact_unique","en":"exact_unique","jp":"exact_unique","kr":"exact_unique"},"episode_title_evidence":{"source":"Config/Season.luae","table_key":"105","season_type":"105","entry_condition":"ed.ConditionX.IsUserInEp(\"Ep05\")","opening_quest":"15010101","episode":"ep5","status":"explicit_episode_and_opening_quest"},"asset_key":"ep5/npcpanel_menu_10005700","asset_path":"ep5/npcpanel_menu/NodeCanvas__DialogueTree__ep5__npcpanel_menu_10005700.decoded.json","graph":"stories/ep5/npcpanel_menu/10005700.graph.json","locales":{"cn":"locales/cn/ep5/npcpanel_menu/10005700.json","en":"locales/en/ep5/npcpanel_menu/10005700.json","jp":"locales/jp/ep5/npcpanel_menu/10005700.json","kr":"locales/kr/ep5/npcpanel_menu/10005700.json"},"machine_locales":{},"stats":{"source_node_count":12,"graph_node_count":7,"effect_event_count":0,"text_entry_count":0,"speaker_entry_count":0,"cast_state_line_count":0,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0},"dialogue_statement_ids":[],"cinematic_statement_ids":[],"previous_plot_asset_key":"ep5/npcpanel_menu_10007240","next_plot_asset_key":"ep5/npcpanel_menu_10001780","previous_story_asset_key":"ep5/npcpanel_menu_10007240","next_story_asset_key":"ep5/npcpanel_menu_10001780"},"ep5/npcpanel_menu_10005940":{"episode":"ep5","category":"npcpanel_menu","story_id":"10005940","sequence_index":79,"plot_row_index":"6353","order_index":"6353","numeric_id":"10005940","physical_section":"ep5","plot_id":"10005940","dialogue_kind":"Menu","metadata_source":"story_metadata_generated_context","metadata_sources":["story_metadata_context"],"summary":"","context_summary_source_cn":"这一切都是都罗的计划，为的是让果切身体会到建造树屋的原因：为了躲避野兽的侵袭、在与野兽的争斗中抢来主动地位。果成功获得了爬高的勇气，但现在又面临着新的问题：他不敢从屋顶上爬下来了！","context_summary_i18n":{"cn":"这一切都是都罗的计划，为的是让果切身体会到建造树屋的原因：为了躲避野兽的侵袭、在与野兽的争斗中抢来主动地位。果成功获得了爬高的勇气，但现在又面临着新的问题：他不敢从屋顶上爬下来了！","en":"Turns out, that was Toro's plan all along—to help Frui see why the treehouses exist: to keep beasts away and give them the advantage if they have to fight. Frui finally finds the courage to climb high, but now he's too scared to come back down!","jp":"これはすべてドゥロの計画で、ツリーハウスを建てる理由を身をもって理解させるために仕組まれたものだった。つまり野獣の襲撃を避け、争いの主導権を握るためである。ゴルはついに勇気を手にし、高所恐怖症を克服したかに見えたが……なんと屋根から降りるのが怖いというのだ！","kr":"사실 이건 모두 듀로의 계획이었다. 과르에게 직접 나무집을 세우라고 한 것은 짐승의 습격을 피하고 그 싸움에서 주도권을 쥐게 하기 위해서였다. 하지만 과르는 높은 곳에 오를 용기를 얻었지만 새로운 문제가 생겼다. 바로 지붕에서 내려올 용기가 없었던 것이다!"},"context_summary_status":{"cn":"aligned_plot_summary","en":"aligned_plot_summary","jp":"aligned_plot_summary","kr":"aligned_plot_summary"},"context_summary_record_index":25363,"context_summary_record_indices":[25363],"context_summary_match_status":"aligned_exact_unique","context_summary_source_asset_key":"ep5/npcpanel_menu_10012310","context_summary_direction":"next_plot_summary","context_summary_distance":20,"episode_title_source_cn":"血月将至","episode_title_i18n":{"cn":"血月将至","en":"Thorns of Devotion","jp":"紅き月の刻","kr":"붉은 달의 예언"},"episode_title_status":{"cn":"exact_unique","en":"exact_unique","jp":"exact_unique","kr":"exact_unique"},"episode_title_evidence":{"source":"Config/Season.luae","table_key":"105","season_type":"105","entry_condition":"ed.ConditionX.IsUserInEp(\"Ep05\")","opening_quest":"15010101","episode":"ep5","status":"explicit_episode_and_opening_quest"},"asset_ke