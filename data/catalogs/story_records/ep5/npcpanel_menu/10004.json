に不満を持つモルガンは、このまま死者を蘇らせる魔法を研究するつもりらしい。","kr":"보칼리스와 아쿠보르의 장례가 순조롭게 진행되었다. 제사 의식에서 모르간은 죽은 자들의 영혼을 불러내 산 자들과 작별 인사를 할 수 있게 도왔다. 모르간은 죽음의 신에게 강한 불만을 감추지 않고 계속해서 죽은 자를 살리는 마법을 연구할 것이라고 했다."},"context_summary_status":{"cn":"aligned_plot_summary","en":"aligned_plot_summary","jp":"aligned_plot_summary","kr":"aligned_plot_summary"},"context_summary_record_index":25416,"context_summary_record_indices":[25416],"context_summary_match_status":"aligned_exact_unique","context_summary_source_asset_key":"ep5/npcpanel_menu_10031230","context_summary_direction":"previous_plot_summary","context_summary_distance":94,"episode_title_source_cn":"血月将至","episode_title_i18n":{"cn":"血月将至","en":"Thorns of Devotion","jp":"紅き月の刻","kr":"붉은 달의 예언"},"episode_title_status":{"cn":"exact_unique","en":"exact_unique","jp":"exact_unique","kr":"exact_unique"},"episode_title_evidence":{"source":"Config/Season.luae","table_key":"105","season_type":"105","entry_condition":"ed.ConditionX.IsUserInEp(\"Ep05\")","opening_quest":"15010101","episode":"ep5","status":"explicit_episode_and_opening_quest"},"asset_key":"ep5/npcpanel_menu_10004140","asset_path":"ep5/npcpanel_menu/NodeCanvas__DialogueTree__ep5__npcpanel_menu_10004140.decoded.json","graph":"stories/ep5/npcpanel_menu/10004140.graph.json","locales":{"cn":"locales/cn/ep5/npcpanel_menu/10004140.json","en":"locales/en/ep5/npcpanel_menu/10004140.json","jp":"locales/jp/ep5/npcpanel_menu/10004140.json","kr":"locales/kr/ep5/npcpanel_menu/10004140.json"},"machine_locales":{},"stats":{"source_node_count":12,"graph_node_count":7,"effect_event_count":0,"text_entry_count":0,"speaker_entry_count":0,"cast_state_line_count":0,"path_dependent_cast_state_count":0,"cinematic_count":0,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":0},"dialogue_statement_ids":[],"cinematic_statement_ids":[],"previous_plot_asset_key":"ep5/npcpanel_menu_10048680","next_plot_asset_key":"ep5/npcpanel_menu_10049340","previous_story_asset_key":"ep5/npcpanel_menu_10048680","next_stor