{"stories":{"timeline/dialoguetree_story_1010041":{"episode":"timeline","category":"dialoguetree_story","story_id":"1010041","sequence_index":19,"plot_row_index":"","order_index":"","numeric_id":"1010041","physical_section":"timeline","sequence_source":"exploration_task_graph","plot_id":"1010041","dialogue_kind":"","summary":"","summary_source_cn":"从沉睡中醒来，扑灭意料之外的大火，你重拾调查金穗村气候异变的任务。","summary_i18n":{"cn":"从沉睡中醒来，扑灭意料之外的大火，你重拾调查金穗村气候异变的任务。","en":"After waking and putting out an unexpected fire, you continue investigating the weird occurrences in Ryeham.","jp":"眠りから目覚め、予期せぬ火事を消し止めたあなたは、金麦村の異常気象に関する調査を再開した。","kr":"깊은 잠에서 깨어나 예기치 못한 화재를 진압했다. 나는 금빛이삭 마을의 기후 변화 조사 퀘스트를 다시 받았다."},"summary_record_index":"exploration:10010100","summary_match_status":"exact_unique","quest_title_source_cn":"新的启程","quest_title_i18n":{"cn":"新的启程","en":"New Journey","jp":"新たな旅","kr":"여정"},"quest_title_status":"exact_unique","quest_title_record_index":"41541","quest_summary_i18n":{"cn":"从沉睡中醒来，扑灭意料之外的大火，你重拾调查金穗村气候异变的任务。","en":"After waking and putting out an unexpected fire, you continue investigating the weird occurrences in Ryeham.","jp":"眠りから目覚め、予期せぬ火事を消し止めたあなたは、金麦村の異常気象に関する調査を再開した。","kr":"깊은 잠에서 깨어나 예기치 못한 화재를 진압했다. 나는 금빛이삭 마을의 기후 변화 조사 퀘스트를 다시 받았다."},"quest_summary_status":"exact_unique","quest_summary_record_index":"41542","objective_title_source_cn":"参观艾雅女神雕像","objective_title_i18n":{"cn":"参观艾雅女神雕像","en":"Visit Dura's Statue","jp":"女神像を見学する","kr":"듀라의 여신상 둘러보기"},"objective_title_status":"exact_unique","objective_title_record_index":"43125","objective_key":"10010100:4:1","objective_task_id":"4","objective_step_id":"1","objective_summary_source_cn":"霍根就纵火犯的问题与我们进行了商讨，我们决定继续追查真相。但在此之前，也许应当先去艾雅女神雕像前看一看。","objective_summary_i18n":{"cn":"霍根就纵火犯的问题与我们进行了商讨，我们决定继续追查真相。但在此之前，也许应当先去艾雅女神雕像前看一看。","en":"Hogan discussed the arsonist issue with us, and we decided to continue investigating the truth. Before that, perhaps we should take a look at the statue of Dura.","jp":"放火犯の件についてホーガンと話したあと、引き続き真相を追うことに決めた。だがその前に、まずは女神デューラの像を見に行ってみよう。","kr":"호건과 방화범에 관해 이야기를 나눈 우리는 계속해서 진상을 파헤치기로 했다. 하지만 그전에, 듀라의 여신상을 둘러봐야 할 것 같다."},"objective_summary_status":"exact_unique","objective_summary_record_index":"43124","objective_prerequisite_stories":[],"exploration_line_id":"10010100","exploration_collection_key":"base_campaign","exploration_chapter_key":"ryeham_tales","exploration_story_kind":"main_story","exploration_evidence_source":"ExplStep.ClientFinishActionByMove.C_RunPlot","exploration_placement_note":"","episode_title_i18n":{"cn":"初始篇章","en":"Base Campaign","jp":"基本ストーリー","kr":"기본 캠페인"},"arc_title_i18n":{"cn":"金穗之章","en":"Ryeham Tales","jp":"金麦の章","kr":"금빛이삭의 장"},"cinematics":[{"node_id":"line:1:timeline::","timeline_name":"timeline_00_01_1010041.prefab","timeline_resource_name":"timeline_00_01_1010041","summary_text_key":"","summary_source_cn":"","summary_i18n":{},"summary_status":{},"summary_record_index":"","metadata_source":"","subtitle_count":4,"cinematic_dialogue_count":0}],"asset_key":"timeline/dialoguetree_story_1010041","asset_path":"timeline/dialoguetree_story/NodeCanvas__DialogueTree__timeline__dialoguetree_story_1010041.decoded.json","graph":"stories/timeline/dialoguetree_story/1010041.graph.json","locales":{"cn":"locales/cn/timeline/dialoguetree_story/1010041.json","en":"locales/en/timeline/dialoguetree_story/1010041.json","jp":"locales/jp/timeline/dialoguetree_story/1010041.json","kr":"locales/kr/timeline/dialoguetree_story/1010041.json"},"machine_locales":{},"stats":{"source_node_count":3,"graph_node_count":6,"effect_event_count":0,"text_entry_count":4,"speaker_entry_count":1,"cast_state_line_count":0,"path_dependent_cast_state_count":0,"cinematic_count":1,"picture_count":0,"subtitle_count":4,"cinematic_dialogue_count":0},"dialogue_statement_ids":["1010025201","1010025202","1010025203","1010025204"],"cinematic_statement_ids":["1010025201","1010025202","1010025203","1010025204"],"previous_plot_asset_key":"","next_plot_asset_key":"","previous_story_asset_key":"mn/