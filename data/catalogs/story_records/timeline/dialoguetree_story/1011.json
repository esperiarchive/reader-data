e_source_cn":"月湖之畔","quest_title_i18n":{"cn":"月湖之畔","en":"Lunnos Lakeside","jp":"ルナレイクのほとり","kr":"달빛 호숫가"},"quest_title_status":"exact_hash","quest_title_record_index":"42014","quest_summary_i18n":{"cn":"达赫妮婆婆拜托你，清除丛林中的腐化根茎。","en":"Granny Dahnie asks you to clear the forest of corrupted roots.","jp":"あなたはダウナエから、森にある腐敗した木の根を除去するよう頼まれた。","kr":"다프니 할머니가 숲의 부패한 뿌리를 제거해 달라고 부탁했다."},"quest_summary_status":"exact_hash","quest_summary_record_index":"42016","objective_title_source_cn":"观看祈祷仪式","objective_title_i18n":{"cn":"观看祈祷仪式","en":"Watch the Ritual","jp":"祈りの儀式を見学","kr":"기도 의식 보기"},"objective_title_status":"exact_hash","objective_title_record_index":"258906","objective_key":"10020113:4:4","objective_task_id":"4","objective_step_id":"4","objective_summary_source_cn":"凑近一些，观摩月湖村的居民如何向弥萨忒献上祈祷，以获取祂的赐福。希望科林的新义肢可以借此生效。","objective_summary_i18n":{"cn":"凑近一些，观摩月湖村的居民如何向弥萨忒献上祈祷，以获取祂的赐福。希望科林的新义肢可以借此生效。","en":"Let's get closer and watch how the folks of Lunadorf pray to Misarte. Perhaps we can receive some blessings. Hopefully, Korin's new limbs will work after this.","jp":"ルナレイク村の人たちが、ミサタの祝福を受けるために祈る姿をもっと近くで見てみよう。これでコリンの新しい義手も無事に完成できそうだ。","kr":"가까이 가서 달빛호수 마을 주민이 어떻게 미샤르테에게 기도를 올리고 축복을 받는지 살펴보았다. 콜린의 새로운 의수가 효과를 발휘하기를."},"objective_summary_status":"exact_hash","objective_summary_record_index":"44317","objective_prerequisite_stories":[],"objective_interludes_before":[{"objective_key":"10020113:4:3","objective_task_id":"4","objective_step_id":"3","objective_title_source_cn":"前往村内祭坛","objective_title_i18n":{"cn":"前往村内祭坛","en":"Go to the Altar","jp":"村の祭壇へ向かう","kr":"마을 내 제단으로 이동"},"objective_title_status":"exact_hash","objective_title_record_index":"44316","objective_summary_source_cn":"达米安匆忙赶来，表示仪式材料已经准备完毕，现在可以去村内的鹿灵祭坛，看绿裔成员如何献上祈祷。","objective_summary_i18n":{"cn":"达米安匆忙赶来，表示仪式材料已经准备完毕，现在可以去村内的鹿灵祭坛，看绿裔成员如何献上祈祷。","en":"Damian came in a hurry, saying that all materials for the ritual were ready. We should head to the Deerspirit Altar in the village and see how the Wilders perform their prayer.","jp":"急いでやって来たダミアンから、儀式の準備が整ったと告げられた。村にある鹿霊の祭壇へ行き、ヴェルディア人がどうやって祈りを捧げるのか見てみよう。","kr":"다미안이 황급히 찾아와 의식에 쓸 재료가 준비되었다고 했다. 이제 마을 내 사슴 영혼의 제단으로 가서 와일더스 멤버가 어떻게 기도를 올리는지 살펴보자."},"objective_summary_status":"exact_hash","objective_summary_record_index":"44315","objective_prerequisite_stories":[]}],"exploration_line_id":"10020113","exploration_collection_key":"base_campaign","exploration_chapter_key":"lucents_lament","exploration_story_kind":"main_story","exploration_evidence_source":"ExplStep.FinishAction.C_RunPlot","exploration_placement_note":"","episode_title_i18n":{"cn":"初始篇章","en":"Base Campaign","jp":"基本ストーリー","kr":"기본 캠페인"},"arc_title_i18n":{"cn":"流荧之叹","en":"Lucent's Lament","jp":"流光の嘆き","kr":"황혼의 외침"},"cinematics":[{"node_id":"line:1:timeline::","timeline_name":"timeline_00_02_1011345.prefab","timeline_resource_name":"timeline_00_02_1011345","summary_text_key":"","summary_source_cn":"","summary_i18n":{},"summary_status":{},"summary_record_index":"","metadata_source":"","subtitle_count":0,"cinematic_dialogue_count":4}],"asset_key":"timeline/dialoguetree_story_1011345","asset_path":"timeline/dialoguetree_story/NodeCanvas__DialogueTree__timeline__dialoguetree_story_1011345.decoded.json","graph":"stories/timeline/dialoguetree_story/1011345.graph.json","locales":{"cn":"locales/cn/timeline/dialoguetree_story/1011345.json","en":"locales/en/timeline/dialoguetree_story/1011345.json","jp":"locales/jp/timeline/dialoguetree_story/1011345.json","kr":"locales/kr/timeline/dialoguetree_story/1011345.json"},"machine_locales":{},"stats":{"source_node_count":3,"graph_node_count":6,"effect_event_count":0,"text_entry_count":4,"speaker_entry_count":4,"cast_state_line_count":0,"path_dependent_cast_state_count":0,"cinematic_count":1,"picture_count":0,"subtitle_count":0,"cinematic_dialogue_count":4},"dialogue_statement_ids":["1011320001","1011320002","1011320003","1011320004"],"cinematic_statement_ids":["1011320001","1011320002","1011320003","1011320004"],"previous_plot_asset_key":"","next_plot_asset_key":"","previous_story_asset_key":"mn2/quest_story_10113190","next_story_asset_key":"mn2/quest_story_10113210","physical_summary":"","logical_collection":"base_campaign","logical_chapter":"lucents_lament","logical_story_kind":"main_story","internal_objective_owner":"","exploration_line_order":3,"exploration_reference_evidence_source":"ExplStep.FinishAction.C_RunPlot","exploration_reference_order_status":"explicit_task_trigger","exploration_reference_anchor_plot_id":"","exploration_reference_trigger_conditions":{},"exploration_reference_source_line_id":"","exploration_reference_launch_semantics":""},"timeline/dialoguetree_story_1011428":{"episode":"timeline","category":"dialoguetree_story","story_id":"1011428","sequence_index":78,"plot_row_index":"","order_index":"","numeric_id":"1011428","physical_section":"timeline","sequence_source":"exploration_task_graph","plot_id":"1011428","dialogue_kind":"","summary":"","summary_source_cn":"清除根茎的过程中，你们发现三贤者之一——伊米尔，似乎在故意阻挠你们。","summary_i18n":{"cn":"清除根茎的过程中，你们发现三贤者之一——伊米尔，似乎在故意阻挠你们。","en":"While removing the roots, you find that one of the Three Sages of the Dark Forest, Eomir, seems to be deliberately obstructing you.","jp":"木の根を除去する途中で、あなたたちは三賢者の一人、イミルがわざとあなたたちを邪魔しているように思えた。","kr":"세 현자 중 하나인 이미르가 부패한 뿌리를 제거하는 우리를 의도적으로 방해하는 것 같다."},"summary_record_index":"exploration:10020114","summary_match_status":"exact_hash","quest_title_source_cn":"荆棘的贤者","quest_title_i18n":{"cn":"荆棘的贤者","en":"Thorned Sage","jp":"茨の賢者","kr":"가시나무의 현자"},"quest_title_status":"exact_hash","quest_title_record_index":"42017","quest_summary_i18n":{"cn":"清除根茎的过程中，你们发现三贤者之一——伊米尔，似乎在故意阻挠你们。","en":"While removing the roots, you find that one of the Three Sages of the Dark Forest, Eomir, seems to be deliberately obstructing you.","jp":"木の根を除去する途中で、あなたたちは三賢者の一人、イミルがわざとあなたたちを邪魔しているように思えた。","kr":"세 현자 중 하나인 이미르가 부패한 뿌리를 제거하는 우리를 의도적으로 방해하는 것 같다."},"quest_summary_status":"exact_hash","quest_summary_record_index":"42019","objective_title_source_cn":"净化腐化","objective_title_i18n":{"cn":"净化腐化","en":"Purification","jp":"腐敗を浄化する","kr":"부패 정화"},"objective_title_status":"exact_hash","objective_title_record_index":"44397","objective_key":"10020114:3:1","objective_task_id":"3","objective_step_id":"1","objective_summary_source_cn":"经过一路分析，我们推断出腐化在地下的分布都直至流荧树，薄暮丛林的圣树有危险了！先净化这里的腐化吧。","objective_summary_i18n":{"cn":"经过一路分析，我们推断出腐化在地下的分布都直至流荧树，薄暮丛林的圣树有危险了！先净化这里的腐化吧。","en":"After some investigating, we deduced that the corruption has spread underground all the way to the Lucent Tree. The sacred tree of the Dark Forest is in danger! Let's purify this area first.","jp":"調べた結果、腐敗した木の根は地下から流光の樹を目指して伸びているようだ。ユグドラシルの聖樹が危ない！まずはここの腐敗を浄化しよう。","kr":"분석을 통해 우리는 지하에서 시작된 부패가 황혼의 나무까지 이어진다고 추측했다. 땅거미 숲의 신성한 나무가 위험해졌다! 우선 이곳의 부패를 정화하도록 하자."},"objective_summary_status":"exact_hash","objective_summary_record_index":"44344","objective_prerequisite_stories":[],"exploration_line_id":"10020114","exploration_collection_key":"base_campaign","exploration_chapter_key":"lucents_lament","exploration_story_kind":"main_story","exploration_evidence_source":"ExplStep.FinishAction.C_RunPlot","exploration_placement_note":"","episode_title_i18n":{"cn":"初始篇章","en":"Base Campaign","jp":"基本ストーリー","kr":"기본 캠페인"},"arc_title_i18n":{"cn":"流荧之叹","en":"Lucent's Lament","jp":"流光の嘆き","kr":"황혼의 외침"},"cinematics":[{"node_id":"line:1:timeline::","timeline_name":"timeline_00_02_1011428.prefab","timeline_resource_name":"timeline_00_02_1011428","summary_text_key":"","summary_source_cn":"","summary_i18n":{},"summary_status":{},"summary_record_index":"","metadata_source":"","subtitle_count":0,"cinematic_dialogue_count":0}],"asset_key":"timeline/dialoguetree_story_1011428","asset_path":"timeline/dialoguetree_story/NodeCanvas__DialogueTree__timeline__dialoguetree_story_1011428.decoded.json","graph":"stories/timeline/dialoguetree_story/1011428.graph.json","locales":{"cn":"locales/cn/timeline/dialoguetree_story/1011428.json","en":"locales/en/timeline/dialoguetree_story/101142