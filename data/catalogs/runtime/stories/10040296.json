title_status":""},"say:2:1121207003:0":{"text":"废话！伊露西卡女士怎么可能轻易死掉！","source_cn":"废话！伊露西卡女士怎么可能轻易死掉！","status":"matched","hash_xxh64":"0xE593CA38071182A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:愤怒的黑金残党":{"text":"愤怒的黑金残党","source":"愤怒的黑金残党","status":"source"},"speaker:维伦":{"text":"维伦","source":"维伦","status":"source"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}},"en":{"asset_key":"mn3/quest_story_11212070","episode":"mn3","category":"quest_story","story_id":"11212070","schema_version":1,"lang":"en","texts":{"say:0:1121207001:0":{"text":"Where are you keeping Illucia?! Release her at once!","source_cn":"伊露西卡女士被你们关在哪里？快放了她！","status":"matched","hash_xxh64":"0x69EFCE66E2F57B34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1121207002:0":{"text":"Hold your accusatory tongue; we didn't capture her. Are you even sure she's still alive?","source_cn":"别冤枉人，我们可没抓她。话说……她真的还活着吗？","status":"matched","hash_xxh64":"0x9D356E8A6F9865F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1121207003:0":{"text":"Of course! How could one as mighty as Lady Illucia die so easily?","source_cn":"废话！伊露西卡女士怎么可能轻易死掉！","status":"matched","hash_xxh64":"0xE593CA38071182A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:愤怒的黑金残党":{"text":"Syndicate Member","source":"愤怒的黑金残党","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}},"jp":{"asset_key":"mn3/quest_story_11212070","episode":"mn3","category":"quest_story","story_id":"11212070","schema_version":1,"lang":"jp","texts":{"say:0:1121207001:0":{"text":"イルシカ様をどこにやった！彼女を解放しろ！","source_cn":"伊露西卡女士被你们关在哪里？快放了她！","status":"matched","hash_xxh64":"0x69EFCE66E2F57B34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1121207002:0":{"text":"おいおい、とんだ言いがかりだな。ってか……彼女はまだ生きてるのか？","source_cn":"别冤枉人，我们可没抓她。话说……她真的还活着吗？","status":"matched","hash_xxh64":"0x9D356E8A6F9865F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1121207003:0":{"text":"なんだと！？イルシカ様がそう易々と死ぬはずないだろ！","source_cn":"废话！伊露西卡女士怎么可能轻易死掉！","status":"matched","hash_xxh64":"0xE593CA38071182A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:愤怒的黑金残党":{"text":"怒れる商会メンバー","source":"愤怒的黑金残党","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"ヴァレン","source":"维伦","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}},"kr":{"asset_key":"mn3/quest_story_11212070","episode":"mn3","category":"quest_story","story_id":"11212070","schema_version":1,"lang":"kr","texts":{"say:0:1121207001:0":{"text":"너희가 이루시카 님을 잡아갔지? 어서 그녀를 풀