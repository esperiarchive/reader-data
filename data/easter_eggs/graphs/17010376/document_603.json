{"schema_version":1,"asset_key":"easter_eggs/document_17010376_603","roots":["document:603"],"nodes":{"document:603":{"id":"document:603","type":"document","entry_kind":"document","text_key":"document:603","source_node_id":"17010376:1:5","next":"end"},"end":{"id":"end","type":"end"}},"text_entries":{"document:603":{"key":"document:603","kind":"document","textdes_id":"603","source_cn":"喂！大魔法师！本狐的食盆之所以空着，是为了接纳崇拜者们供奉的珍馐，而不是……这些能把狐牙酸掉的浆果！\n要捂着牙重新刷一遍食盆这件事严重影响了本狐下午茶的心情！\n鉴于你的品味有待提高，下次这种食物就不要送来了。\n如果你非要送的话，不如去锈桶酒馆打包几份蜜煎烤肉送来！","document_title_cn":"这也太酸了！"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1},"source":"Exact map-object document dispatch"}