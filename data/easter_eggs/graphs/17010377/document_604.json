{"schema_version":1,"asset_key":"easter_eggs/document_17010377_604","roots":["document:604"],"nodes":{"document:604":{"id":"document:604","type":"document","entry_kind":"document","text_key":"document:604","source_node_id":"17010377:1:5","next":"end"},"end":{"id":"end","type":"end"}},"text_entries":{"document:604":{"key":"document:604","kind":"document","textdes_id":"604","source_cn":"某位好心的大魔法师，既然你已经知道本狐的身份了，就别把本狐当宠物投喂了！\n看在这些浆果清洗得还算干净的份上，这次本狐就勉强收下。\n下次，比起这些随处可见的浆果，本狐更希望能在食盆里看见上城区餐厅的特供鹅肝，或者王宫御膳房刚出锅的红酒炖肉……\n我想，以大魔法师的智慧，应该能明白本狐的意思吧？","document_title_cn":"送的很好，下次别送了！"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1},"source":"Exact map-object document dispatch"}