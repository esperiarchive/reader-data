{"schema_version":1,"asset_key":"easter_eggs/document_13010316_96","roots":["document:96"],"nodes":{"document:96":{"id":"document:96","type":"document","entry_kind":"document","text_key":"document:96","source_node_id":"13010316:1:1","next":"end"},"end":{"id":"end","type":"end"}},"text_entries":{"document:96":{"key":"document:96","kind":"document","textdes_id":"96","source_cn":"我完全不觉得自己死了。\n当我回到镇子找朋友玩时，镇上的人却拿石头丢我。直到那时候，我才知道自己变成了活死人。\n这就是活死人吗？\n我不会感觉到冷，想玩多久雪就可以玩多久的雪！\n而且不管玩多久，我也不会感觉累和饿！\n如果无聊，还可以去吓人！太酷啦！","document_title_cn":"活死人超酷！"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1},"source":"Exact map-object document dispatch"}