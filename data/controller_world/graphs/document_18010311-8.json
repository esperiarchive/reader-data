{"schema_version":1,"asset_key":"easter_eggs/document_18010311_656","roots":["document:656"],"nodes":{"document:656":{"id":"document:656","type":"document","entry_kind":"document","text_key":"document:656","source_node_id":"18010311:1:8","next":"end"},"end":{"id":"end","type":"end"}},"text_entries":{"document:656":{"key":"document:656","kind":"document","textdes_id":"656","source_cn":"我最喜欢<style=\"highlight\">白色的花</style>。\n小时候家门口就有那么一丛，母亲说白色最不争不抢，开在那里安安静静的。\n后来我走了很多地方，见过很多花，还是觉得白色的最好看。\n要是有好心人路过，请<style=\"highlight\">帮我摘一朵放在这里</style>吧。感谢你。","document_title_cn":"精致的墓碑"}},"speaker_entries":{},"stats":{"node_count":2,"text_entry_count":1}}