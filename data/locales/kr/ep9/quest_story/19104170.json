8AC019C20A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1910417011:1":{"text":"그래, 조금만 기다려. 먹을 걸 구해 올게.","source_cn":"嗯，别着急，我就去觅食。","status":"matched","hash_xxh64":"0x63B2ED6352F46E8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1910417012:1":{"text":"너희는 여기 있어.","source_cn":"你们留在这里。","status":"matched","hash_xxh64":"0x70848B56965FEF71","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1910417013:1":{"text":"잠깐! 사... 사냥하러 가는 거야? 천해족을 잡아먹는 건 아니지? 우리 가족을 해치지 말아 줘!","source_cn":"等等！你……你要去捕猎？你的食物不会是浅海裔吧？不要伤...","status":"matched","hash_xxh64":"0x9638A5B871A2E406","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1910417014:1":{"text":"...아닙니다.","source_cn":"……不是。","status":"matched","hash_xxh64":"0xCDEA4BE9B2BA0B5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1910417015:1":{"text":"그럼 나랑 같이 가. 내가... 감시해야겠어!","source_cn":"卡律先生，我和你一起去，我……我要监督你！","status":"matched","hash_xxh64":"0x14B9971963F3C87E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1910417016:1":{"text":"안 돼. 난 천해족과 단둘이 있으면 안 된다.","source_cn":"不行。我不能与浅海裔单独相处。","status":"matched","hash_xxh64":"0xC81D9F734DC5F523","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:19:1910417016":{"text":"안 돼. 난 천해족과 단둘이 있으면 안 된다.","source_cn":"不行。我不能与浅海裔单独相处。","status":"matched","hash_xxh64":"0xC81D9F734DC5F523","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1910417017:1":{"text":"그건... 위험하니까.","source_cn":"因为……很危险。","status":"matched","hash_xxh64":"0xED696056C574077E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1910417020:1":{"text":"하지만...","source_cn":"可是——","status":"matched","hash_xxh64":"0xD3F4540696EF509C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1910417021:1":{"text":"내가 갈게.","source_cn":"咱跟他去。","status":"matched","hash_xxh64":"0x4B78C13C6927C2AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1910417022:1":{"text":"图澜……","source_cn":"图澜……","status":"target_text_empty","hash_xxh64":"0xE8ED2FF156C4BC0E","variant_statu