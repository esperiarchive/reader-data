{"asset_key":"ep9/quest_story_19101340","episode":"ep9","category":"quest_story","story_id":"19101340","schema_version":1,"lang":"kr","texts":{"say:1:1910134001:1":{"text":"图澜，你刚才那一下好厉害呀，你的木头鱼很结实！","source_cn":"图澜，你刚才那一下好厉害呀，你的木头鱼很结实！","status":"hash_not_found","hash_xxh64":"0x97427EB9A92A9703","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1910134002:1":{"text":"喂，都说了这不是木头鱼，是水行器！","source_cn":"喂，都说了这不是木头鱼，是水行器！","status":"hash_not_found","hash_xxh64":"0x944A3A916B03A1CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1910134003:1":{"text":"好好，我知道啦……哎呀，你的头撞伤了！疼吗？","source_cn":"好好，我知道啦……哎呀，你的头撞伤了！疼吗？","status":"hash_not_found","hash_xxh64":"0xAEEBE404793B5E45","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1910134004:1":{"text":"啧，这点小伤算什么，别管咱。","source_cn":"啧，这点小伤算什么，别管咱。","status":"hash_not_found","hash_xxh64":"0x8A858755973E2809","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1910134005:1":{"text":"这家伙是谁？","source_cn":"这家伙是谁？","status":"hash_not_found","hash_xxh64":"0x145E9ED6FB97E410","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:191013