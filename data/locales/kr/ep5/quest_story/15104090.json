e_female":"","document_title_cn":"","document_title_status":""},"say:30:1510409023:0":{"text":"아... 피곤해. 오늘 말을 너무 많이 했어.","source_cn":"啊……我累了。今天说的话太多了。","status":"matched","hash_xxh64":"0xEE67E7413000A846","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1510409024:0":{"text":"보아라! 페르세우스, 저 태도를 좀 보란 말이다!","source_cn":"——瞧！珀尔修斯，瞧瞧他们的态度！","status":"matched","hash_xxh64":"0xAB5C267365F0DCC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1510409025:0":{"text":"비보 선생님, 일단 보칼리스로 돌아가시지요. 제가 해결하겠습니다.","source_cn":"比博，你先回呼临城，我来解决。","status":"matched","hash_xxh64":"0x596E4D186579C525","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1510409026:0":{"text":"페르세우스, 나의 제자여... 보칼리스의 미래는 아반드와 네게 달려있다. 내 너만 믿으마.","source_cn":"珀尔修斯，我的学生……呼临城的未来全在阿邦德和你肩上。...","status":"matched","hash_xxh64":"0xF0BC580BEF9F2811","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:36:1510409027:0":{"text":"학자는 궁시렁 거리며 자리를 떠났다","source_cn":"学者絮絮叨叨地离开了","status":"matched","hash_xxh64":"0x8318F6E9A3552410","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1510409028:0":{"text":"그렇다면