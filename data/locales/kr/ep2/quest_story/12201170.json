{"asset_key":"ep2/quest_story_12201170","episode":"ep2","category":"quest_story","story_id":"12201170","schema_version":1,"lang":"kr","texts":{"say:3:1220117001:0":{"text":"리... 아아아아...","source_cn":"哩……呀呀呀呀……","status":"matched","hash_xxh64":"0xC15795A3A0F912EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220117002:1":{"text":"이런! 우리를 공격하지는 않지데, 말이 전혀 안 통해요...","source_cn":"不行，虽然不攻击我们了，但完全没法交流啊……","status":"matched","hash_xxh64":"0x99EC1897FF72CA64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1220117002":{"text":"이런! 우리를 공격하지는 않지데, 말이 전혀 안 통해요...","source_cn":"不行，虽然不攻击我们了，但完全没法交流啊……","status":"matched","hash_xxh64":"0x99EC1897FF72CA64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1220117003:0":{"text":"조나단, 세실리아를 기억해요?","source_cn":"乔纳森，你还记得塞西莉亚小姐吗？","status":"matched","hash_xxh64":"0xB0A73A26D2C9C71A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220117004:0":{"text":"... 세... 아...!","source_cn":"……萨……啊……","status":"matched","hash_xxh64":"0xDA044ED2F26E3376","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1220117005:0