{"asset_key":"ep2/quest_story_12112230","episode":"ep2","category":"quest_story","story_id":"12112230","schema_version":1,"lang":"kr","texts":{"say:2:1211223001:0":{"text":"엄마... 어디 계세요?","source_cn":"妈妈……你在哪里？","status":"matched","hash_xxh64":"0x899DED8747C436C9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211223002:1":{"text":"저기요? 실례지만 여긴...","source_cn":"你好——你好？请问这里……","status":"matched","hash_xxh64":"0xBD1868608B90B760","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211223003:1":{"text":"...치피, 그만 물어봐.","source_cn":"……满满，别问了。","status":"matched","hash_xxh64":"0x5B6D6BA61C35FC3B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211223004:1":{"text":"이건 <style=\"highlight\">영혼</style>이야... 아이의 영혼... 이미 목숨을 잃은 아이야.","source_cn":"这是<style=highlight>灵魂</styl...","status":"matched","hash_xxh64":"0x09125AF4A853852A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1211223005:1":{"text":"여, 영혼이라니...","source_cn":"灵、灵魂……","status":"matched","hash_xxh64":"0x049EDCFF7038C045","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1211223006:1":{"text