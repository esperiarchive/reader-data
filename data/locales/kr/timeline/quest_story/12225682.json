{"asset_key":"timeline/quest_story_12225682","episode":"timeline","category":"quest_story","story_id":"12225682","schema_version":1,"lang":"kr","texts":{"cinematic_dialogue:2:1222567001:":{"text":"이봐, <style=\"stress\"><player_name></style>! 거기 그렇게 서 있지 말라고!","source_cn":"喂，<style=\"stress\"><player_name></style>，别光在那里站着！","status":"matched_runtime_gender","hash_xxh64":"0x0BE20F14E70E44B1","variant_status":"runtime_gender_keys_target_same","male":"이봐, <style=\"stress\"><player_name></style>! 거기 그렇게 서 있지 말라고!","female":"이봐, <style=\"stress\"><player_name></style>! 거기 그렇게 서 있지 말라고!","variant_male_record_index":"138662","variant_female_record_index":"138663","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1222567002:":{"text":"선생님, 선생님! 여기예요!","source_cn":"老师，老师！在这里！","status":"matched_runtime_gender","hash_xxh64":"0x1EB7EC5F623E1C66","variant_status":"runtime_gender_keys_target_same","male":"선생님, 선생님! 여기예요!","female":"선생님, 선생님! 여기예요!","variant_male_record_index":"138664","variant_female_record_index":"138665","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1222567003:":{"text":"하하하하!","source_cn":"哈哈哈哈<key:keyGender_dialog1>","status":"matched_runtime_gender","hash_xxh64":"0xF69A85E3C2C737EE","variant_status":"runtime_gender_keys_target_same","male":"하하하하!","female":"하하하하!","variant_male_record_index":"138666","variant_female_record_index":"138667","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1222567004:":{"text":"당신을 기다리고 있었어요.","source_cn":"我们等着您赴约","status":"matched_runtime_gender","hash_xxh64":"0x1E1E6F60BA417828","variant_status":"runtime_gender_keys_target_same","male":"당신을 기다리고 있었어요.","female":"당신을 기다리고 있었어요.","variant_male_record_index":"138668","variant_female_record_ind