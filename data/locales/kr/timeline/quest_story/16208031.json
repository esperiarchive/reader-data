ource_cn":"这、这是……<key:dialog5>","status":"matched","hash_xxh64":"0xD3322B904AFF5D0D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1620803108:0":{"text":"귀신이다!!!","source_cn":"鬼啊——！！！","status":"matched","hash_xxh64":"0x0EAFD4452EF8DF95","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:18:1620803109:0":{"text":"겁에 질린 앤시엘은 참고서를 집어 들고 곧장 도서관 밖으로 뛰쳐나갔다...","source_cn":"安塞尔惊恐万分，抄起参考书，头也不回地逃出了图书馆……","status":"matched","hash_xxh64":"0xFE6A30F99506BDEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:20:16020511:0":{"text":"참고서를 찾은 앤시엘이 떠나려던 순간, 휴게실 안에서 갑자기 이상한 소리가 들려왔다...","source_cn":"就在安塞尔终于找到参考书，准备离开时，休息室里突然传来...","status":"matched","hash_xxh64":"0x4727F0371C757D25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:安塞尔":{"text":"앤시엘","source":"安塞尔","status":"matched_dialogue_flow"},"speaker:怪异的回响":{"text":"기이한 메아리","source":"怪异的回响","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"블랙 스크린 자막","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":19,"localized_text_count":14,"speaker_count":3}}