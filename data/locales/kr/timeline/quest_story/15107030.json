{"asset_key":"timeline/quest_story_15107030","episode":"timeline","category":"quest_story","story_id":"15107030","schema_version":1,"lang":"kr","texts":{"cinematic_dialogue:2:1510702001:":{"text":"군대? 어디로 가는 걸까요?","source_cn":"军队？他们要去哪？","status":"matched","hash_xxh64":"0x528954AF70A4EB2A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1510702002:":{"text":"부관 로르, 출정을 명한다...","source_cn":"副将隆尔领命出兵——","status":"matched","hash_xxh64":"0xBFD19CB3E50D2C5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1510702003:":{"text":"루나애니를 토벌하고, 분노의 골짜기를 점령하자!","source_cn":"讨伐兽人，占领树怒山谷！","status":"matched","hash_xxh64":"0x61207543342CFF7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1510702004:":{"text":"모조리 죽여라!","source_cn":"杀光他们！","status":"matched","hash_xxh64":"0xB70AF4605A7D7545","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1510702005:":{"text":"꼭 승리하고 돌아오셔야 해요!","source_cn":"一定要凯旋啊！","status":"matched","hash_xxh64":"0x75B7F1E6B3BA952A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinema