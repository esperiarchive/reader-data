ument_title_status":""},"say:5:1511444002:0":{"text":"설마 너도 루한테 홀려서 동료들을 공격하는 거야?","source_cn":"难道你也听信了露的话，要对同伴下手吗？！","status":"matched","hash_xxh64":"0xEB592672F37B1279","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1511444003:0":{"text":"아메스가 먼저 공격했다고!","source_cn":"是阿米先袭击的我！","status":"matched","hash_xxh64":"0xA0F082A30C05C03E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1511444004:0":{"text":"너를...?","source_cn":"袭击你……？","status":"matched","hash_xxh64":"0x6DC14939654FF671","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1511444005:1":{"text":"아니, 아니야! 내가 그런 일을 할 리가 없잖아?!","source_cn":"不，我没有！我怎么会做这种事？","status":"matched","hash_xxh64":"0xEBDECFCC9F9BF502","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1511444006:1":{"text":"두툰, 나 못 믿어? 적어도 너는 날 믿어야지!","source_cn":"难道你不相信我吗，顿？我才是你最值得相信的人。","status":"matched","hash_xxh64":"0xDA120C3612843EA9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1511444007:1":{"text":"살려줘... 살려줘!","source_cn":"救救我……救我！","status":"matched","hash_xxh64":"0xD6B5A94CE47243E9","variant_status":"","male":"","femal