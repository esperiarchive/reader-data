":""},"choice:29:2:3":{"text":"마법 기계라니 정말 멋진데? 나도 하나 만들까?","source_cn":"魔法机械真酷，我也想搞一个","status":"matched_runtime_gender","hash_xxh64":"0xD37D30C11253B504","variant_status":"runtime_gender_keys_target_same","male":"마법 기계라니 정말 멋진데? 나도 하나 만들까?","female":"마법 기계라니 정말 멋진데? 나도 하나 만들까?","variant_male_record_index":"68754","variant_female_record_index":"68755","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"근데 왜 움직이질 않는 거야?","source_cn":"那他为什么不动了？","status":"matched_runtime_gender","hash_xxh64":"0x46A6F849EB8CDE48","variant_status":"runtime_gender_keys_target_same","male":"근데 왜 움직이질 않는 거야?","female":"근데 왜 움직이질 않는 거야?","variant_male_record_index":"68746","variant_female_record_index":"68747","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"그래서 어디에 문제가 생긴 거야?","source_cn":"所以是哪里出问题了？","status":"matched_runtime_gender","hash_xxh64":"0xD8E0503DDF16EFEF","variant_status":"runtime_gender_keys_target_same","male":"그래서 어디에 문제가 생긴 거야?","female":"그래서 어디에 문제가 생긴 거야?","variant_male_record_index":"68748","variant_female_record_index":"68749","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:黑屏字幕":{"text":"블랙 스크린 자막","source":"黑屏字幕","status":"matched_dialogue_flow"},"speaker:呼金":{"text":"후긴","source":"呼金","status":"matched_dialogue_flow"},"speaker:卡列琳娜":{"text":"캐롤라이나","source":"卡列琳娜","status":"matched_dialogue_flow"},"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"},"speaker:柳博米尔":{"text":"루보미르","source":"柳博米尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":41,"localized_text_count":36,"speaker_count":6}}