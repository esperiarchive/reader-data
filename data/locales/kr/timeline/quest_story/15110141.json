{"asset_key":"timeline/quest_story_15110141","episode":"timeline","category":"quest_story","story_id":"15110141","schema_version":1,"lang":"kr","texts":{"cinematic_dialogue:2:1511014001:":{"text":"페르세우스, 어서 일어나란 말이야...","source_cn":"快点醒来吧，珀尔修斯……","status":"matched","hash_xxh64":"0xD086ABE8B2F619F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511014002:":{"text":"오르파가! 어서 멈춰요!","source_cn":"奥法迦！快停下！","status":"matched","hash_xxh64":"0xD6431F8337CA8B5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511014201:":{"text":"그 누구도 날 막지 못해!","source_cn":"谁也别想阻拦我！","status":"matched","hash_xxh64":"0xB3461E02B22C2CE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1511014101:0":{"text":"이제 그만하세요, 오르파가.","source_cn":"停手吧，奥法迦。","status":"matched","hash_xxh64":"0xAAF7C54DC1CA2CC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1511014102:0":{"text":"또 너로군... <style=\"highlight\">듀라</style>!","source_cn":"又是你……<style=highlight>艾雅</s...","status":"matched","hash_xxh64":"0x091EE5FF5E0C2EC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_st