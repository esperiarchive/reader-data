atched_runtime_gender","hash_xxh64":"0x173A355EB200268B","variant_status":"runtime_gender_keys_target_same","male":"나도 레오프론 사람이야","female":"나도 레오프론 사람이야","variant_male_record_index":"92483","variant_female_record_index":"92484","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1810325007:0":{"text":"그레이브본이... 날 구했다고...?","source_cn":"亡灵……救了我……？","status":"matched_runtime_gender","hash_xxh64":"0xA4307CB2468C9D4A","variant_status":"runtime_gender_keys_target_same","male":"그레이브본이... 날 구했다고...?","female":"그레이브본이... 날 구했다고...?","variant_male_record_index":"242213","variant_female_record_index":"242214","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"지금은 그레이브본이야","source_cn":"现在我是亡灵","status":"matched_runtime_gender","hash_xxh64":"0x2AB840D3E352FDA0","variant_status":"runtime_gender_keys_target_same","male":"지금은 그레이브본이야","female":"지금은 그레이브본이야","variant_male_record_index":"92485","variant_female_record_index":"92486","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:2:3":{"text":"나도 내가 뭔지 잘 모르겠어","source_cn":"我不好说自己是什么","status":"matched_runtime_gender","hash_xxh64":"0x7ECE35BC1A00412D","variant_status":"runtime_gender_keys_target_same","male":"나도 내가 뭔지 잘 모르겠어","female":"나도 내가 뭔지 잘 모르겠어","variant_male_record_index":"92487","variant_female_record_index":"92488","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"지나가던 착한 사람","source_cn":"路过的好心人","status":"matched_runtime_gender","hash_xxh64":"0xF3DCD2C0D61823D4","variant_status":"runtime_gender_keys_target_same","male":"지나가던 착한 사람","female":"지나가던 착한 사람","variant_male_record_index":"92477","variant_female_record_index":"92478","document_title":"","document_title_male":"","