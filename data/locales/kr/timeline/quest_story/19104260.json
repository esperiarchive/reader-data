{"asset_key":"timeline/quest_story_19104260","episode":"timeline","category":"quest_story","story_id":"19104260","schema_version":1,"lang":"kr","texts":{"narration:0:1910426001:0":{"text":"夜色降临，你躺在冷硬的吊床上勉强入睡……","source_cn":"夜色降临，你躺在冷硬的吊床上勉强入睡……","status":"hash_not_found","hash_xxh64":"0x314719978E71E62D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1910426002:1":{"text":"梦中你再次回到了塔拉萨，阿嬷、妈妈、姐姐，家人们微笑着...","source_cn":"梦中你再次回到了塔拉萨，阿嬷、妈妈、姐姐，家人们微笑着...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1910426003:1":{"text":"但很快你什么都看不清了。到处都是明亮而狂乱的泡沫。","source_cn":"但很快你什么都看不清了。到处都是明亮而狂乱的泡沫。","status":"hash_not_found","hash_xxh64":"0xFB3DAC00F01D777A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1910426004:1":{"text":"能做的只有跑，跑，拼命地跑！可你要跑去哪里？","source_cn":"能做的只有跑，跑，拼命地跑！可你要跑去哪里？","status":"hash_not_found","hash_xxh64":"0x40BC1D94B6EED550","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1910426005:1":{"text":"在你奔走的路的尽头，你突然听到了某个<style=hi...","source_cn":"在你奔走的路的尽头，你突然听到了某个<style=hi...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1910426006:1":{"text":"像是鼓声，又像敲击声，夹杂着似有若无的低语。越来越响、...","source_cn":"像是鼓声，又像敲击声，夹杂着似有若无的低语。越来越响、...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:6:1910426007:0":{"text":"——<style=highlight2>直到你目之所及...","source_cn":"——<style=highlight2>直到你目之所及...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:1910426002":{"text":"1910426002","source":"1910426002","status":"source"},"speaker:1910426003":{"text":"1910426003","source":"1910426003","status":"source"},"speaker:1910426004":{"text":"1910426004","source":"1910426004","status":"source"},"speaker:1910426005":{"text":"1910426005","source":"1910426005","status":"source"},"speaker:1910426006":{"text":"1910426006","source":"1910426006","status":"source"}},"stats":{"flow_row_count":9,"localized_text_count":7,"speaker_count":5}}