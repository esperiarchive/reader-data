{"asset_key":"timeline/timeline_story_1701010531","episode":"timeline","category":"timeline_story","story_id":"1701010531","schema_version":1,"lang":"kr","texts":{"cinematic_dialogue:1:1710543001:":{"text":"세상에, 예약을 못 하면 어떡하지?","source_cn":"糟了，约不上可怎么办啊？","status":"matched","hash_xxh64":"0x7752B5EF1709CA06","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1710543002:":{"text":"크흠, 저한테 다 방법이 있습니다.","source_cn":"咳咳……我有办法","status":"matched","hash_xxh64":"0x78B65D28D4245A89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1710543003:":{"text":"골드나 지위만 있으면 해결할 수 있거든요.","source_cn":"金币或者地位就能搞定","status":"matched","hash_xxh64":"0x7286CF595BA1C1E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1710542001:":{"text":"죄송합니다, 부인. 다다음 달까지 예약이 꽉 차 있어서요.","source_cn":"抱歉，夫人。下下个月也已经预约完了","status":"matched","hash_xxh64":"0x84782BDAB55E3B75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1710542002:":{"text":"그럼... 그 다음 달은요?","source_cn":"……那再之后呢？","status":"matched","hash_xxh64":"0xEAE5AA4DDB206961","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1710542003:":{"text":"정말 죄송합니다. 그 다음 달도 이미 예약이 마감되었습니다...","source_cn":"非常抱歉，还是没有呢","status":"matched","hash_xxh64":"0xF89CD53BDA0E531F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1710544001:":{"text":"손님, 초대장이 없으시군요.","source_cn":"先生，您没有邀请函","status":"matched","hash_xxh64":"0x784FB8D524EE25B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1710544002:":{"text":"죄송하지만 입장하실 수 없습니다.","source_cn":"所以不能进入","status":"matched","hash_xxh64":"0x196FA803D9674644","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:排队的仆人":{"text":"줄 선 하인","source":"排队的仆人","status":"matched_dialogue_flow"},"speaker:懂行的黄牛":{"text":"눈치 빠른 브로커","source":"懂行的黄牛","status":"matched_dialogue_flow"},"speaker:接待的店员":{"text":"종업원","source":"接待的店员","status":"matched_dialogue_flow"},"speaker:期待的食客":{"text":"기대하는 손님","source":"期待的食客","status":"matched_dialogue_flow"},"speaker:维持秩序的店员":{"text":"질서를 유지하는 직원","source":"维持秩序的店员","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":8,"speaker_count":5}}