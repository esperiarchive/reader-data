ant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:65:1064201049:0":{"text":"나 좀 혼자 있게 해줘. 부탁이야...","source_cn":"让我自己待着吧，算我求你……","status":"matched","hash_xxh64":"0x9907D574BDD46A5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:66:1064201050:1":{"text":"유리안은 입술을 달싹이며 혀끝에 엉겨 붙는 말들을 곱씹다가, 결국 속으로 삼켜 버렸다.","source_cn":"尤里娅的双唇开了又合，她在口中咀嚼着那些粘牙的话，最终...","status":"matched","hash_xxh64":"0xE3F7FAD8486D833D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:67:1064201051:1":{"text":"......\n에휴... 그래.","source_cn":"……\\n唉……知道了。","status":"matched","hash_xxh64":"0xD525DB1354BFD252","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:68:1064201052:1":{"text":"엄마는 아침밥 해 놓고 다시 올게.","source_cn":"妈做好早饭再来。","status":"matched","hash_xxh64":"0x61B0784C4DDEB129","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:69:1064201053:0":{"text":"이윽고 굳게 닫힌 문 너머로 긴 정적이 흘렀다. 한참이 지나서야, 마침내 멀어지는 발소리가 들려왔다.","source_cn":"埃因听到关门声，隔了很久，门外才传来渐行渐远的脚步声。","status":"matched","hash_xxh64":"0x7D304AEABCE4F319","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:71:1064201054:0":{"text":"마이카...","source_cn":"迈克尔……为什么？","status":"matched","hash_xxh64":"0x283EB09CCD87CAD8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:72:1064201055:0":{"text":"도대체 왜... 왜 내가 살아남은 거야...","source_cn":"为什么……活下来的是我……","status":"matched","hash_xxh64":"0xF5EB17E9AEA2170A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:73:1064201056:0":{"text":"이런 꼴로...","source_cn":"——以这幅德行。","status":"matched","hash_xxh64":"0xEA2C8807BA0F7476","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:焦急的声音":{"text":"다급한 목소리","source":"焦急的声音","status":"matched_dialogue_flow"},"speaker:埃因":{"text":"아인","source":"埃因","status":"matched_dialogue_flow"},"speaker:迈克尔":{"text":"마이카","source":"迈克尔","status":"matched_dialogue_flow"},"speaker:魔物":{"text":"마물","source":"魔物","status":"matched_dialogue_flow"},"speaker:女人的呼唤":{"text":"여인의 목소리","source":"女人的呼唤","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"나레이션","source":"旁白","status":"matched_dialogue_flow"},"speaker:尤里娅":{"text":"유리안","source":"尤里娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":57,"localized_text_count":56,"speaker_count":7}}