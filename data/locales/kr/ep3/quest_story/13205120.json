狼捕杀绵羊的痕迹，或许那只羊只...","status":"matched","hash_xxh64":"0x047B4B564EB0E28E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1320512012:1":{"text":"사샤를 따라가 보면 알겠죠!","source_cn":"我们跟着萨莎过去看看就知道了！","status":"matched","hash_xxh64":"0x19FAC7EE3C770688","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:0:1":{"text":"잃어버린 양을 찾은 걸까?","source_cn":"难道它找到了失踪的那只羊？","status":"matched_runtime_gender","hash_xxh64":"0x170AB1D33C88E8D2","variant_status":"runtime_gender_keys_target_same","male":"잃어버린 양을 찾은 걸까?","female":"잃어버린 양을 찾은 걸까?","variant_male_record_index":"69176","variant_female_record_index":"69177","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:1:2":{"text":"설마 보물을 찾았나?","source_cn":"难道它找到了宝物？","status":"matched_runtime_gender","hash_xxh64":"0x5CD23D433775E2B7","variant_status":"runtime_gender_keys_target_same","male":"설마 보물을 찾았나?","female":"설마 보물을 찾았나?","variant_male_record_index":"69178","variant_female_record_index":"69179","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"치피","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"블랙 스크린 자막","source":"黑屏字幕","status":"matched_dialogue_flow"},"speaker:萨莎":{"text":"사샤","source":"萨莎","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":22,"localized_text_count":18,"speaker_count":4}}