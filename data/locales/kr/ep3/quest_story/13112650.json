":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"넌 악마야","source_cn":"冰之恶魔！","status":"matched_runtime_gender","hash_xxh64":"0xD70609DCEE380282","variant_status":"runtime_gender_keys_target_same","male":"넌 악마야","female":"넌 악마야","variant_male_record_index":"68520","variant_female_record_index":"68521","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:瓦丽卡":{"text":"발리카","source":"瓦丽卡","status":"matched_dialogue_flow"},"speaker:亚莲娜公主":{"text":"알레나 공주","source":"亚莲娜公主","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"해미","source":"漫漫","status":"matched_dialogue_flow"},"speaker:冰之恶魔":{"text":"얼음의 악마","source":"冰之恶魔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":39,"localized_text_count":38,"speaker_count":4}}