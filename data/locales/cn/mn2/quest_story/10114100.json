{"asset_key":"mn2/quest_story_10114100","episode":"mn2","category":"quest_story","story_id":"10114100","schema_version":1,"lang":"cn","texts":{"say:2:1011410001:1":{"text":"德里斯加，我们求见伊米尔贤者。","source_cn":"德里斯加，我们求见伊米尔贤者。","status":"matched","hash_xxh64":"0xDD3B2D7083622364","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1011410002:1":{"text":"帕瑞莎……？你怎么回来了？","source_cn":"帕瑞莎……？你怎么回来了？","status":"matched","hash_xxh64":"0xF9651BD28C9CA463","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1011410003:1":{"text":"不对，你已经不再是队长，无权进入荆棘营地！","source_cn":"不对，你已经不再是队长，无权进入荆棘营地！","status":"matched","hash_xxh64":"0x93297254C226D44B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1011410004:1":{"text":"请让开，别阻拦我们。","source_cn":"请让开，别阻拦我们。","status":"matched","hash_xxh64":"0xF35F3D7781212868","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1011410005:1":{"text":"……他们都说你勾结外人，我还不相信。如今亲眼所见，果然是真的。","source_cn":"……他们都说你勾结外人，我还不相信。如今亲眼所见，果然...","status":"matched","hash_xxh64":"0xA2E1360603FA4005","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1011410006:0":{"text":"你带着