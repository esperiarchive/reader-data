{"asset_key":"mn2/quest_story_10284270","episode":"mn2","category":"quest_story","story_id":"10284270","schema_version":1,"lang":"cn","texts":{"say:1:1028427001:0":{"text":"好呀，原来这才是你的真面目，你根本不是植物学家！","source_cn":"好呀，原来这才是你的真面目，你根本不是植物学家！","status":"matched","hash_xxh64":"0x23C01C5DAC81977A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1028427002:0":{"text":"——坏人！","source_cn":"——坏人！","status":"matched","hash_xxh64":"0x135E55DF75DB5A1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028427003:0":{"text":"先生，你现在可以说实话了吧！","source_cn":"先生，你现在可以说实话了吧！","status":"matched","hash_xxh64":"0xF4EDBB726B08ADD5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028427004:0":{"text":"我、我是黑金商会的……别动手，给，这是能让那个植物学家醒转的解药！","source_cn":"我、我是黑金商会的……别动手，给，这是能让那个植物学家...","status":"matched","hash_xxh64":"0xF023DB791FAEA892","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1028427005:0":{"text":"我带走了他的孩子，胁迫他和我合作……","source_cn":"我带走了他的孩子，胁迫他和我合作……","status":"matched","hash_xxh64":"0x942396AD8643E716","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1028427005