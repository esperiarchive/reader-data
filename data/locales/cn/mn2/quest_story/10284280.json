{"asset_key":"mn2/quest_story_10284280","episode":"mn2","category":"quest_story","story_id":"10284280","schema_version":1,"lang":"cn","texts":{"say:1:1028428001:1":{"text":"我……呃……你们，你们是谁？","source_cn":"我……呃……你们，你们是谁？","status":"matched","hash_xxh64":"0xE1D401FE8F7F71E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1028428002:1":{"text":"不要害怕，我们是好人！我们把那个黑金的坏人打败了，你看！","source_cn":"不要害怕，我们是好人！我们把那个黑金的坏人打败了，你看！","status":"matched","hash_xxh64":"0x825C7127E70294F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1028428003:1":{"text":"弥萨忒在上……幸好……","source_cn":"弥萨忒在上……幸好……","status":"matched","hash_xxh64":"0x480CCC7457053469","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028428004:1":{"text":"求你们救救我的孩子！他把我的孩子绑走了！","source_cn":"求你们救救我的孩子！他把我的孩子绑走了！","status":"matched","hash_xxh64":"0x004E43A78F468499","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028428005:1":{"text":"放心，刚才他都交代了，我会让巡游队平安送你的孩子回家。","source_cn":"放心，刚才他都交代了，我会让巡游队平安送你的孩子回家。","status":"matched","hash_xxh64":"0xCBEE07E1378B2E3A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prom