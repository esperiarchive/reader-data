{"asset_key":"mn2/quest_story_10283300","episode":"mn2","category":"quest_story","story_id":"10283300","schema_version":1,"lang":"cn","texts":{"say:2:1028330001:1":{"text":"阿——嚏！什么味道……太刺鼻了吧！","source_cn":"阿——嚏！什么味道……太刺鼻了吧！","status":"matched","hash_xxh64":"0x606B14483ABB989B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1028330002:1":{"text":"呃……你们怎么这么看着我？","source_cn":"呃……你们怎么这么看着我？","status":"matched","hash_xxh64":"0x26ACDEB04ADC02E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028330003:1":{"text":"伽利！太好了！你终于醒了！","source_cn":"伽利！太好了！你终于醒了！","status":"matched","hash_xxh64":"0xB2A9CF605916A91C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028330004:1":{"text":"我……刚才不是喝了灵药吗？怎么……有点头晕，像是睡到半夜被突然叫醒一样……","source_cn":"我……刚才不是喝了灵药吗？怎么……有点头晕，像是睡到半...","status":"matched","hash_xxh64":"0xC0E42856B35D68B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1028330004":{"text":"我……刚才不是喝了灵药吗？怎么……有点头晕，像是睡到半夜被突然叫醒一样……","source_cn":"我……刚才不是喝了灵药吗？怎么……有点头晕，像是睡到半夜被突然叫醒一样……","status":"matched","hash_xxh64":"0xC0E42856B35D68B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","docu