{"asset_key":"mn2/quest_story_10127061","episode":"mn2","category":"quest_story","story_id":"10127061","schema_version":1,"lang":"cn","texts":{"say:0:1012706101:0":{"text":"洛桑，你像煦风一般，总能吹散阴霾。","source_cn":"洛桑，你像煦风一般，总能吹散阴霾。","status":"matched","hash_xxh64":"0x5F69AEFA4B842ADB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1012706102:0":{"text":"莱卡，你如同星辰，照亮了我内心的黑暗。","source_cn":"莱卡，你如同星辰，照亮了我内心的黑暗。","status":"matched","hash_xxh64":"0xACEB8D8CCDF8C850","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1012706103:0":{"text":"雅顿老师，没有你的教诲，便没有今日的我。","source_cn":"雅顿老师，没有你的教诲，便没有今日的我。","status":"matched","hash_xxh64":"0xA80989E1B0F56263","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1012706104:0":{"text":"达赫妮婆婆，在我心中，你永远是强大的战士。","source_cn":"达赫妮婆婆，在我心中，你永远是强大的战士。","status":"matched","hash_xxh64":"0x052DF1460C730741","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1012706105:0":{"text":"还有布莱恩、帕瑞莎、芙拉贝尔……没有伙伴，我无法走到今天。","source_cn":"还有布莱恩、帕瑞莎、芙拉贝尔……没有伙伴，我无法走到今天。","status":"matched","hash_xxh64":"0xDC6B6FD39BCF8E60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}}