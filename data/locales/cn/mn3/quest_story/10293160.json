{"asset_key":"mn3/quest_story_10293160","episode":"mn3","category":"quest_story","story_id":"10293160","schema_version":1,"lang":"cn","texts":{"say:1:1029316001:2":{"text":"特弥希娅！好久不见，我好想你呀！","source_cn":"特弥希娅！好久不见，我好想你呀！","status":"matched","hash_xxh64":"0xEABACDC0253192A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1029316002:0":{"text":"你好，菲。好久不见，愿女神保佑你。","source_cn":"你好，菲。好久不见，愿女神保佑你。","status":"matched","hash_xxh64":"0xCCADFD7BF9671163","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1029316003:0":{"text":"我也在呢，你不和我打招呼吗？","source_cn":"我也在呢，你不和我打招呼吗？","status":"matched","hash_xxh64":"0xE2501F4021A7F779","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1029316004:0":{"text":"你、你这可是本案的重点嫌疑人！作为侦探，我对嫌疑人态度当然要非常严肃才行！","source_cn":"你、你这可是本案的重点嫌疑人！作为侦探，我对嫌疑人态度...","status":"matched","hash_xxh64":"0xD95D020E43621971","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1029316005:0":{"text":"啊，你说什么嫌疑人？我最近可没有偷什么东西。","source_cn":"啊，你说什么嫌疑人？我最近可没有偷什么东西。","status":"matched","hash_xxh64":"0x1A4516ABE6167004","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6: