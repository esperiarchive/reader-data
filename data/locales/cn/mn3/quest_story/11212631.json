{"asset_key":"mn3/quest_story_11212631","episode":"mn3","category":"quest_story","story_id":"11212631","schema_version":1,"lang":"cn","texts":{"say:1:1121263101:0":{"text":"没想到这块石雕竟然是开门的钥匙。","source_cn":"没想到这块石雕竟然是开门的钥匙。","status":"matched","hash_xxh64":"0x80108CCD37872D9F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1121263102:0":{"text":"黑金商会为了不让别人进入这里，偷走了这块石雕，他们不希望自己的罪行被发现。","source_cn":"黑金商会为了不让别人进入这里，偷走了这块石雕，他们不希...","status":"matched","hash_xxh64":"0x0E6A9F864FBF53B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1121263103:0":{"text":"但是……阿尔法十一，我不确定你能不能找到自己的族人。","source_cn":"但是……阿尔法十一，我不确定你能不能找到自己的族人。","status":"matched","hash_xxh64":"0x995EF0B26FB4F5CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1121263104:0":{"text":"因为他们好像……离开瓦度索山脉了。","source_cn":"因为他们好像……离开瓦度索山脉了。","status":"matched","hash_xxh64":"0x1A789C1BE4C27908","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1121263105:0":{"text":"嗯……我知道。","source_cn":"嗯……我知道。","status":"matched","hash_xxh64":"0xFAF2D19F8C7EC7F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1121263106:0":{"text":"可是，已经走到了这里，我还想再往前一步。","source_cn":"可是，已经走到了这里，我还想再往前一步。","status":"matched","hash_xxh64":"0x7CF44EDAC228C4CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1121263107:0":{"text":"就算是一个悲伤的答案在等待我，我也不想逃避。","source_cn":"就算是一个悲伤的答案在等待我，我也不想逃避。","status":"matched","hash_xxh64":"0xC8AC59BFC13F6650","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1121263108:0":{"text":"有我们陪着你呢，没什么迈不过去的坎。我们一起面对吧。","source_cn":"有我们陪着你呢，没什么迈不过去的坎。我们一起面对吧。","status":"matched","hash_xxh64":"0x1C4A79828101E0A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱卡":{"text":"莱卡","source":"莱卡","status":"source"},"speaker:阿尔法十一":{"text":"阿尔法十一","source":"阿尔法十一","status":"source"},"speaker:蕾米雅":{"text":"蕾米雅","source":"蕾米雅","status":"source"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":3}}