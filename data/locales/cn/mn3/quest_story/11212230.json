_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1121223011:1":{"text":"好吧，我允许你们带阿尔法十一离开圣石镇。","source_cn":"好吧，我允许你们带阿尔法十一离开圣石镇。","status":"matched","hash_xxh64":"0x62FDAAA4C319F42A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1121223012:1":{"text":"将军，真的可以吗？","source_cn":"将军，真的可以吗？","status":"matched","hash_xxh64":"0x7760BC6900E83D09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1121223013:1":{"text":"莱卡小姐，假如她真的属于绿裔联盟，你们有权接管此事。","source_cn":"莱卡小姐，假如她真的属于绿裔联盟，你们有权接管此事。","status":"matched","hash_xxh64":"0xC727B202FC582811","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1121223014:1":{"text":"黑金女士可能用了黑魔法操纵她，在弄清真相前，她不该被惩罚。","source_cn":"黑金女士可能用了黑魔法操纵她，在弄清真相前，她不该被惩罚。","status":"matched","hash_xxh64":"0xD26930F7826B92A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1121223015:0":{"text":"太感谢您了！","source_cn":"太感谢您了！","status":"matched","hash_xxh64":"0xCF5A6F58FB17BB0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1121223016:1":{"text":"至于这个石雕。我看，暂时交给阿尔法十一吧。","source_cn":"至于这个石雕。我看，暂时交给阿尔法十一吧。","status":"matched","hash_xxh64":"0x030082E82A802FF5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1121223017:0":{"text":"阿尔法十一，它有可能是你的，希望你能好好保管。","source_cn":"阿尔法十一，它有可能是你的，希望你能好好保管。","status":"matched","hash_xxh64":"0x60867774BD4E5CBB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1121223018:0":{"text":"你为什么相信敌人？","source_cn":"你为什么相信敌人？","status":"matched","hash_xxh64":"0x57DE8B67700D0A79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1121223019:0":{"text":"我并不相信敌人，但我愿意相信来自丛林的朋友。","source_cn":"我并不相信敌人，但我愿意相信来自丛林的朋友。","status":"matched","hash_xxh64":"0x71B078B09B8CEDC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1121223020:0":{"text":"你的话，我不太懂。不过……我愿意保管它。","source_cn":"你的话，我不太懂。不过……我愿意保管它。","status":"matched","hash_xxh64":"0x7707097A37DF1C8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1121223021:0":{"text":"好吧！那我去给雅顿贤者写封信，将这边的情况告诉他，雅顿贤者也认识阿露拉。","source_cn":"好吧！那我去给雅顿贤者写封信，将这边的情况告诉他，雅顿...","status":"matched","hash_xxh64":"0x4EE8C01887567418","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1121223022:0":{"text":"我还没有答应要和你们走。","source_cn":"我还没有答应要和你们走。","status":"matched","hash_xxh64":"0xA0729B6453C81484","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1121223023:0":{"text":"那你打算永远顶着那个没有感情的名字吗？阿尔法十一。","source_cn":"那你打算永远顶着那个没有感情的名字吗？阿尔法十一。","status":"matched","hash_xxh64":"0x846AFB7602E5BE0B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1121223024:0":{"text":"这是妈妈为我取的，我——","source_cn":"这是妈妈为我取的，我——","status":"matched","hash_xxh64":"0x006CFCA1113D2E5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1121223025:0":{"text":"真正的母亲不会取那种代号般的名字！","source_cn":"真正的母亲不会取那种代号般的名字！","status":"matched","hash_xxh64":"0x6EC11B791250428C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1121223026:0":{"text":"你不是想知道阿露拉是谁的名字吗？那我告诉你好了。","source_cn":"你不是想知道阿露拉是谁的名字吗？那我告诉你好了。","status":"matched","hash_xxh64":"0x731FE29254474749","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1121223027:0":{"text":"我们认为