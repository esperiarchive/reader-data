{"asset_key":"mn3/quest_story_11212230","episode":"mn3","category":"quest_story","story_id":"11212230","schema_version":1,"lang":"cn","texts":{"say:1:1121223001:0":{"text":"说吧……我非常需要答案。","source_cn":"说吧……我非常需要答案。","status":"matched","hash_xxh64":"0xDF1EB27C63C49705","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1121223002:0":{"text":"别着急。在那之前，有个东西，需要你确认。","source_cn":"别着急。在那之前，有个东西，需要你确认。","status":"matched","hash_xxh64":"0xC76D3ADB1A3FA7BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1121223003:1":{"text":"你认得这是什么吗？","source_cn":"你认得这是什么吗？","status":"matched","hash_xxh64":"0x0B250D04FC195B08","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:3::2":{"text":"小鸟雕像","source_cn":"小鸟雕像","status":"matched","hash_xxh64":"0xDB6A6A6FA6C2784A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1121223004:0":{"text":"这是……\n为什么……我不理解……","source_cn":"这是……\\n为什么……我不理解……","status":"matched","hash_xxh64":"0xE3584E5191096523","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1121223005:0":{"text":"这是不是你的东西？","source_cn":"这是不是你的东西？","status":"matched","hash_xxh