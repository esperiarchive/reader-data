matched","hash_xxh64":"0xC2E1C35CCC7ACB00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1121225006:0":{"text":"啊？你又不坐船了？","source_cn":"啊？你又不坐船了？","status":"matched","hash_xxh64":"0xC4F4AFEB6DDE0E00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1121225007:0":{"text":"要下大雨了。这时候出航，有危险。","source_cn":"要下大雨了。这时候出航，有危险。","status":"matched","hash_xxh64":"0xD6C7393D22FDB3BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1121225008:0":{"text":"胡说八道……这大晴天的。","source_cn":"胡说八道……这大晴天的。","status":"matched","hash_xxh64":"0x3E15DD2FBE29397F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1121225009:0":{"text":"我没有胡说，乌云很快就要来了。","source_cn":"我没有胡说，乌云很快就要来了。","status":"matched","hash_xxh64":"0x42335B95DA0C2DDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1121225010:0":{"text":"行行行……你爱坐不坐，不坐就快下船，别耽误我挣钱。","source_cn":"行行行……你爱坐不坐，不坐就快下船，别耽误我挣钱。","status":"matched","hash_xxh64":"0x4F87590AE0F37764","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","docu