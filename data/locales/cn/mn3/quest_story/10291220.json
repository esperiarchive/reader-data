{"asset_key":"mn3/quest_story_10291220","episode":"mn3","category":"quest_story","story_id":"10291220","schema_version":1,"lang":"cn","texts":{"say:1:1029122001:1":{"text":"尔等何人？报上名来。","source_cn":"尔等何人？报上名来。","status":"matched","hash_xxh64":"0xCC6397A17F3D6AC7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1029122002:2":{"text":"朵拉，到了你发挥能力的时候了。","source_cn":"朵拉，到了你发挥能力的时候了。","status":"matched","hash_xxh64":"0x659B9F7A1A8EB77D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1029122003:1":{"text":"我、我还不是追影者的成员呢，怎么会知道他们的接头暗号……","source_cn":"我、我还不是追影者的成员呢，怎么会知道他们的接头暗号……","status":"matched","hash_xxh64":"0xFCE1EEF97A749EC7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1029122004:1":{"text":"这样啊。那就麻烦了呢……要不还是把你爸爸妈妈也叫过来帮个忙？","source_cn":"这样啊。那就麻烦了呢……要不还是把你爸爸妈妈也叫过来帮个忙？","status":"matched","hash_xxh64":"0xC7A69A65204DAC14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1029122005:1":{"text":"哼，你欺负小孩！我——","source_cn":"哼，你欺负小孩！我——","status":"matched","hash_xxh64":"0x9D261DA133AF57F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1029122006:1":{"text":"沉睡在业火中的深渊之子啊，吾是您最虔诚的眷属。","source_cn":"沉睡在业火中的深渊之子啊，吾是您最虔诚的眷属。","status":"matched","hash_xxh64":"0xBBEA4919A6ACA503","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1029122007:1":{"text":"请呼唤吾主之名。","source_cn":"请呼唤吾主之名。","status":"matched","hash_xxh64":"0xA844B0258FCCEAA8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1029122008:1":{"text":"赛利欧斯大人，吾等眷属，唯虔诚祈祷之心，愿您宽恕。","source_cn":"赛利欧斯大人，吾等眷属，唯虔诚祈祷之心，愿您宽恕。","status":"matched","hash_xxh64":"0x212B6F9F3C41FD0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1029122009:1":{"text":"吾主知晓，后门可入。","source_cn":"吾主知晓，后门可入。","status":"matched","hash_xxh64":"0x8B1D2B75328D25A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:马克塔":{"text":"马克塔","source":"马克塔","status":"source"},"speaker:维伦":{"text":"维伦","source":"维伦","status":"source"},"speaker:朵拉":{"text":"朵拉","source":"朵拉","status":"source"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":3}}