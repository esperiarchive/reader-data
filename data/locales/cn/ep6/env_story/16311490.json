{"asset_key":"ep6/env_story_16311490","episode":"ep6","category":"env_story","story_id":"16311490","schema_version":1,"lang":"cn","texts":{"say:2:1631149001:1":{"text":"劳伦斯，那个人是不是在看我们啊？","source_cn":"劳伦斯，那个人是不是在看我们啊？","status":"matched","hash_xxh64":"0xB52ECC04791FEB86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1631149002:1":{"text":"别管他，说不定只是个迷路的人。","source_cn":"别管他，说不定只是个迷路的人。","status":"matched","hash_xxh64":"0xDF9A6C5A34DEA286","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1631149003:0":{"text":"但要是他再待一会儿，我们可能就得换个地方了。","source_cn":"但要是他再待一会儿，我们可能就得换个地方了。","status":"matched","hash_xxh64":"0x7BDE57CADED55F9A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1631149004:1":{"text":"……所以，你刚才说下周的舞会……","source_cn":"……所以，你刚才说下周的舞会……","status":"matched","hash_xxh64":"0xE0406F4393BFFBC7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1631149005:0":{"text":"啊？哦，对……舞会……我会准备好礼服的。","source_cn":"啊？哦，对……舞会……我会准备好礼服的。","status":"matched","hash_xxh64":"0x6E39D8CDC5CF3388","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1631149006:1":{"text":"咳……要是只有我们两个就好了，对吧？","source_cn":"咳……要是只有我们两个就好了，对吧？","status":"matched","hash_xxh64":"0xBBA80B5C777E9E0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1631149007:1":{"text":"嘘！你小点声……别让人误会了。","source_cn":"嘘！你小点声……别让人误会了。","status":"matched","hash_xxh64":"0x97E9F8FF076EB5B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1631149008:1":{"text":"不会的，我说的是舞会。又不是说现在。","source_cn":"不会的，我说的是舞会。又不是说现在。","status":"matched","hash_xxh64":"0xE67B7414F940929B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1631149009:1":{"text":"那个，劳伦……这里好像有风，我有点冷了。我们……去图书馆那边走走好吗？","source_cn":"那个，劳伦……这里好像有风，我有点冷了。我们……去图书...","status":"matched","hash_xxh64":"0xB41497191039669B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1631149010:1":{"text":"好啊！图书馆好，又安静又……没人打扰。","source_cn":"好啊！图书馆好，又安静又……没人打扰。","status":"matched","hash_xxh64":"0xC9C3F961C510BA61","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:女学生":{"text":"女学生","source":"女学生","status":"source"},"speaker:男学生":{"text":"男学生","source":"男学生","status":"source"}},"stats":{"flow_row_count":11,"localized_text_co