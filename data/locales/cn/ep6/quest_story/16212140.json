！","status":"matched","hash_xxh64":"0xB8087069ADD6B792","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1621214012:1":{"text":"是的，真是感慨生命的神奇……","source_cn":"是的，真是感慨生命的神奇……","status":"matched","hash_xxh64":"0xE1A9F9F2C59165CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈梅尔":{"text":"哈梅尔","source":"哈梅尔","status":"source"},"speaker:旁白":{"text":"旁白","source":"旁白","status":"source"},"speaker:科丝蒂":{"text":"科丝蒂","source":"科丝蒂","status":"source"},"speaker:黑屏":{"text":"黑屏","source":"黑屏","status":"source"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":4}}