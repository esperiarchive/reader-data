tle_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1620113006:1":{"text":"感觉有些奇怪……会和我们的调查有关吗？","source_cn":"感觉有些奇怪……会和我们的调查有关吗？","status":"matched","hash_xxh64":"0xCA242AB007DDF388","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1620113006":{"text":"感觉有些奇怪……会和我们的调查有关吗？","source_cn":"感觉有些奇怪……会和我们的调查有关吗？","status":"matched","hash_xxh64":"0xCA242AB007DDF388","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1620113007:1":{"text":"教授说她只能在墓碑附近活动，肯定不是她吃的。","source_cn":"教授说她只能在墓碑附近活动，肯定不是她吃的。","status":"matched","hash_xxh64":"0xEB6B6E4C09B8A61E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1620113008:1":{"text":"所以，还有一个幽灵在外游荡！说不定它就是那个犯人！","source_cn":"所以，还有一个幽灵在外游荡！说不定它就是那个犯人！","status":"matched","hash_xxh64":"0x3A254B1E4B11805D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1620113009:1":{"text":"怎、怎么又来一个幽灵……这个调查，一定要涉及到我最害怕的灵异元素吗……","source_cn":"怎、怎么又来一个幽灵……这个调查，一定要涉及到我最害怕...","status":"matched","hash_xxh64":"0x74AC5993B45004DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"t