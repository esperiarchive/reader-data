{"asset_key":"ep1/env_story_11202300","episode":"ep1","category":"env_story","story_id":"11202300","schema_version":1,"lang":"cn","texts":{"say:1:1120230001:1":{"text":"我没想到……你竟然真的做到了……","source_cn":"我没想到……你竟然真的做到了……","status":"matched","hash_xxh64":"0x133BC74643D69D90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1120230002:1":{"text":"别误会，我只是想做个了断。这个护途之链……你收着吧。","source_cn":"别误会，我只是想做个了断。这个护途之链……你收着吧。","status":"matched","hash_xxh64":"0x0B37FA46E708E200","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1120230003:1":{"text":"……你之后打算做什么？","source_cn":"……你之后打算做什么？","status":"matched","hash_xxh64":"0x923E85981833AF43","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120230004:1":{"text":"之后？当然是离开你们黑嚎的地盘，回到乌尔氏族。","source_cn":"之后？当然是离开你们黑嚎的地盘，回到乌尔氏族。","status":"matched","hash_xxh64":"0x88B08C1CA34785D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120230005:1":{"text":"我不会收下这个陪葬品的。","source_cn":"我不会收下这个陪葬品的。","status":"matched","hash_xxh64":"0x294717D34DF351D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120230006:1":{"text":"……为什么？","source_cn":"……为什么？","status":"matched","hash_xxh64":"0x1F024CEEC0B3A1CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120230007:1":{"text":"这是你和父亲的了断，和我无关。后天举办葬礼——","source_cn":"这是你和父亲的了断，和我无关。后天举办葬礼——","status":"matched","hash_xxh64":"0xE7A093EFC524B97F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120230008:1":{"text":"如果想说再见的话，就在葬礼当天带着它一起出席吧。","source_cn":"如果想说再见的话，就在葬礼当天带着它一起出席吧。","status":"matched","hash_xxh64":"0xCFDDF637EA01D3E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120230009:1":{"text":"……你还真是狡猾啊。","source_cn":"……你还真是狡猾啊。","status":"matched","hash_xxh64":"0x19BA1612610F7A2A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1120230010:1":{"text":"葬礼当天，再说吧。","source_cn":"葬礼当天，再说吧。","status":"matched","hash_xxh64":"0x7A089FAD6868825B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:库金":{"text":"库金","source":"库金","status":"source"},"speaker:索恩":{"text":"索恩","source":"索恩","status":"source"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":2}}