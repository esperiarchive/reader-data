{"asset_key":"ep1/env_story_11309100","episode":"ep1","category":"env_story","story_id":"11309100","schema_version":1,"lang":"cn","texts":{"say:2:1130910001:1":{"text":"不，区别可大了，它们现在不会主动攻击我们了！","source_cn":"不，区别可大了，它们现在不会主动攻击我们了！","status":"matched","hash_xxh64":"0xB6E7C4629F323FAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1130910002:1":{"text":"这样一来，商路就畅通了，我们可以继续出发去深红高原了。","source_cn":"这样一来，商路就畅通了，我们可以继续出发去深红高原了。","status":"matched","hash_xxh64":"0x4B5748BC58B906C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1130910003:1":{"text":"但我听说，深红高原有奇怪的黑色魔物……","source_cn":"但我听说，深红高原有奇怪的黑色魔物……","status":"matched","hash_xxh64":"0x3492544BBA7EE3FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1130910004:1":{"text":"好好想想，深红高原的宝藏是假的，那魔物传言也可能是假的！什么都信，怎么做生意？","source_cn":"好好想想，深红高原的宝藏是假的，那魔物传言也可能是假的...","status":"matched","hash_xxh64":"0x7AC5BF220CB5294D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:行商德博拉":{"text":"行商德博拉","source":"行商德博拉","status":"source"},"speaker:行商乔瑟夫":{"text":"行商乔瑟夫","source":"行商乔瑟夫","status":"source"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}