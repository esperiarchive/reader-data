{"asset_key":"ep1/env_story_11302600","episode":"ep1","category":"env_story","story_id":"11302600","schema_version":1,"lang":"cn","texts":{"say:1:1130260001:1":{"text":"是的，每一个十年，当战歌节将要来临前夕，这些英灵总会苏醒。","source_cn":"是的，每一个十年，当战歌节将要来临前夕，这些英灵总会苏醒。","status":"matched","hash_xxh64":"0x11B4A5793EDFBC6C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1130260002:1":{"text":"他们呼喊这前世的话语，渴望着战斗，也激励着荒漠的后代。","source_cn":"他们呼喊这前世的话语，渴望着战斗，也激励着荒漠的后代。","status":"matched","hash_xxh64":"0x225CBC3B9A7887A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1130260003:1":{"text":"战斗！只有精彩的战斗，方不算辜负此生。","source_cn":"战斗！只有精彩的战斗，方不算辜负此生。","status":"matched","hash_xxh64":"0x1CAC94D075ECC512","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:蛮血欧克":{"text":"蛮血欧克","source":"蛮血欧克","status":"source"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}