{"asset_key":"ep1/quest_story_11113080","episode":"ep1","category":"quest_story","story_id":"11113080","schema_version":1,"lang":"cn","texts":{"say:2:1111308001:1":{"text":"诡草大哥，你说重点嘛！仔细说说你是怎么打败流沙之爪的！","source_cn":"诡草大哥，你说重点嘛！仔细说说你是怎么打败流沙之爪的！","status":"matched","hash_xxh64":"0xF5AB0DEAF2F40415","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1111308002:1":{"text":"你们也知道，我可是驯养陆行鸟的专家！我一面给他们养鸟，一面悄悄地培育我的陆行鸟军团。","source_cn":"你们也知道，我可是驯养陆行鸟的专家！我一面给他们养鸟，...","status":"matched","hash_xxh64":"0xAD06EC1D60EAF9A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111308003:1":{"text":"哇！陆行鸟军团！","source_cn":"哇！陆行鸟军团！","status":"matched","hash_xxh64":"0xE6BAA7ABB887A70F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111308004:0":{"text":"没错，我的爱鸟<style=\"highlight\">炽翼冲锋者</style>正是军团统帅！","source_cn":"没错，我的爱鸟<style=highlight>炽翼冲...","status":"matched","hash_xxh64":"0xF5B68EE4B3ECA3FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111308005:0":{"text":"然后呢然后呢！","source_cn":"然后呢然后呢！","status":"matched","hash_xxh64":"0xDFF00D2F7B8BED81","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","docum