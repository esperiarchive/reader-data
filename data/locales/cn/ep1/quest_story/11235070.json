{"asset_key":"ep1/quest_story_11235070","episode":"ep1","category":"quest_story","story_id":"11235070","schema_version":1,"lang":"cn","texts":{"say:3:1123507001:1":{"text":"你们怎么会来这里？","source_cn":"你们怎么会来这里？","status":"matched","hash_xxh64":"0x5226A9E1E63A63F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123507002:1":{"text":"哼，我只是……嗯，路过！","source_cn":"哼，我只是……嗯，路过！","status":"matched","hash_xxh64":"0x0C885B94B78D3752","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123507003:1":{"text":"其实，我们是来帮助老师的。","source_cn":"其实，我们是来帮助老师的。","status":"matched","hash_xxh64":"0xBD9495B346E4DF41","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123507004:1":{"text":"什么老师，你在胡言乱语什么。","source_cn":"什么老师，你在胡言乱语什么。","status":"matched","hash_xxh64":"0x801428C060A7EA13","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123507005:1":{"text":"我们在营地里聊天的时候，发现对方都受到过老师的教导。","source_cn":"我们在营地里聊天的时候，发现对方都受到过老师的教导。","status":"matched","hash_xxh64":"0x3CC0E16362D95712","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123507006:1":{"text":"得知老师的情况后，决定过来看看，没想到来得刚刚好。","source