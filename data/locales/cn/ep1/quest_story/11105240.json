{"asset_key":"ep1/quest_story_11105240","episode":"ep1","category":"quest_story","story_id":"11105240","schema_version":1,"lang":"cn","texts":{"say:1:1110524001:1":{"text":"快些检查吧……拜托了。","source_cn":"快些检查吧……拜托了。","status":"matched","hash_xxh64":"0x118461DF697A5842","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110524002:1":{"text":"唔……从阿尔萨的症状和匕首上残余毒药的色泽判断——","source_cn":"唔……从阿尔萨的症状和匕首上残余毒药的色泽判断——","status":"matched","hash_xxh64":"0x69846B180376688F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110524003:1":{"text":"错不了，确实是我想的那种毒药。","source_cn":"错不了，确实是我想的那种毒药。","status":"matched","hash_xxh64":"0xD6C4B76D8A5067BB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1110524004:1":{"text":"喂！你在将功补过，别卖关子了！你能配出解药吗？","source_cn":"喂！你在将功补过，别卖关子了！你能配出解药吗？","status":"matched","hash_xxh64":"0xE92EE7E2B88025EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1110524005:1":{"text":"能，也不能。","source_cn":"能，也不能。","status":"matched","hash_xxh64":"0x3A7282105A540092","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1110524005":{"text":"能，也不能。","sourc