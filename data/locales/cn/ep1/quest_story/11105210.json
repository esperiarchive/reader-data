{"asset_key":"ep1/quest_story_11105210","episode":"ep1","category":"quest_story","story_id":"11105210","schema_version":1,"lang":"cn","texts":{"say:1:1110521001:0":{"text":"你、你们想干什么？","source_cn":"你、你们想干什么？","status":"matched","hash_xxh64":"0xC4C08E3F17331FE1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110521002:0":{"text":"你、抓得我好痛！","source_cn":"你、抓得我好痛！","status":"matched","hash_xxh64":"0xEC3209F801D15EC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1110521003:1":{"text":"阿尔萨……可恶！","source_cn":"阿尔萨……可恶！","status":"matched","hash_xxh64":"0x57CEE0CDE94ACDE4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110521004:1":{"text":"这把匕首可能有问题，阿尔萨的身体好烫……","source_cn":"这把匕首可能有问题，阿尔萨的身体好烫……","status":"matched","hash_xxh64":"0xF3800047D06F548D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1110521005:1":{"text":"匕首上淬了毒？","source_cn":"匕首上淬了毒？","status":"matched","hash_xxh64":"0xFA001AE1BCC734F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1110521006:1":{"text":"索恩，你冷静点！现在最要紧的是救阿尔萨！","source_cn":"索恩，你冷静点！现在最要紧的是救阿尔萨！","status":"matched","h