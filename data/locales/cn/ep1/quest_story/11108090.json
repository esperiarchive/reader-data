{"asset_key":"ep1/quest_story_11108090","episode":"ep1","category":"quest_story","story_id":"11108090","schema_version":1,"lang":"cn","texts":{"say:0:1110809001:0":{"text":"索恩，你一路上都板着脸，在想什么呢？","source_cn":"索恩，你一路上都板着脸，在想什么呢？","status":"matched","hash_xxh64":"0xED0D53F91BFA3932","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1110809002:0":{"text":"乌尔氏族的振兴，根本不需要远方虚无缥缈的宝藏。","source_cn":"乌尔氏族的振兴，根本不需要远方虚无缥缈的宝藏。","status":"matched","hash_xxh64":"0x5C00D22C6ACF8EF9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110809003:0":{"text":"他们不该来。","source_cn":"他们不该来。","status":"matched","hash_xxh64":"0xD50E9014CFF5864F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110809004:0":{"text":"……阿尔萨在的话，会说我太冷漠。","source_cn":"……阿尔萨在的话，会说我太冷漠。","status":"matched","hash_xxh64":"0x8A7B2F42DFA43E3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1110809005:0":{"text":"嗯……说不定！但阿尔萨更可能说，这就是你关心别人的方式！","source_cn":"嗯……说不定！但阿尔萨更可能说，这就是你关心别人的方式！","status":"matched","hash_xxh64":"0x8E548CFAB85FE942","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"te