{"asset_key":"ep8/quest_story_18201210","episode":"ep8","category":"quest_story","story_id":"18201210","schema_version":1,"lang":"cn","texts":{"say:2:1820121001:1":{"text":"客人，要不要来点药水？今天刚到的货，可新鲜了！","source_cn":"客人，要不要来点药水？今天刚到的货，可新鲜了！","status":"matched","hash_xxh64":"0xCF97D5F6CEEFA1B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1820121002:1":{"text":"给我来十瓶！","source_cn":"给我来十瓶！","status":"matched","hash_xxh64":"0xBB18F12B144A60F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1820121003:1":{"text":"好嘞，这就给您包起来！","source_cn":"好嘞，这就给您包起来！","status":"matched","hash_xxh64":"0x88581B98FD8F8850","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1820121004:0":{"text":"姨妈，这里卖的是什么药水啊，生意这么好？","source_cn":"姨妈，这里卖的是什么药水啊，生意这么好？","status":"matched","hash_xxh64":"0x2EC17C37CC318F8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1820121005:1":{"text":"是一种能保持皮肤肤色的药水。","source_cn":"是一种能保持皮肤肤色的药水。","status":"matched","hash_xxh64":"0x4E16C926387E72EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1820121006:1":{"text":"变成亡灵后，我们虽然不会再次死亡，但躯体仍然会随着时间受到磨损。"