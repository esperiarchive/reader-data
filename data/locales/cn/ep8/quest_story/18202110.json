":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1820211009:1":{"text":"改编？续写？！","source_cn":"改编？续写？！","status":"matched","hash_xxh64":"0x406219265C42EEB1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1820211010:1":{"text":"没错。听说是塞涅结合了自身死后的经历，又亲自请来剧作家修改的。","source_cn":"没错。听说是塞涅结合了自身死后的经历，又亲自请来剧作家...","status":"matched","hash_xxh64":"0x5C9CFB17008BB1AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1820211011:1":{"text":"毕竟你们也明白，变成亡灵以后难免会突然迸发出一些前所未有的感悟，心境有所改变也是很正常的事。","source_cn":"毕竟你们也明白，变成亡灵以后难免会突然迸发出一些前所未...","status":"matched","hash_xxh64":"0x0E0030134BD1F391","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1820211012:0":{"text":"海歌剧院可没有明确对外公布这次演出进行了续写，只说是有所改编。","source_cn":"海歌剧院可没有明确对外公布这次演出进行了续写，只说是有...","status":"matched","hash_xxh64":"0xB520DCB0DBCFC1DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1820211013:1":{"text":"《消逝之声》原版已经很经典了，实在没什么必要续写。","source_cn":"《消逝之声》原版已经很经典了，实在没什么必要续写。","status":"matched","hash_xxh64":"0x4E52BD5BFEA28907","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","docu