t_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1810764112:0":{"text":"巴登……","source_cn":"巴登……","status":"matched","hash_xxh64":"0x8F18279B6D894431","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1810764113:0":{"text":"我们一直与班题斯为敌，总觉得亡灵全是毫无人性的怪物。可是……为了救我，穆婆婆甘愿牺牲自己……","source_cn":"我们一直与班题斯为敌，总觉得亡灵全是毫无人性的怪物。可...","status":"matched","hash_xxh64":"0x8CA52F6FD9647C8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1810764114:1":{"text":"虽然她的确受到了巴亚茄老师记忆的影响……但在我以“里纳”这个名字生活的时候，她对我的照管和爱护不是假的。","source_cn":"虽然她的确受到了巴亚茄老师记忆的影响……但在我以“里纳...","status":"matched","hash_xxh64":"0x3BFF534D97E019FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1810764115:1":{"text":"她是亡灵，也知道我是生者……而我现在，正在为她的离开而痛苦。","source_cn":"她是亡灵，也知道我是生者……而我现在，正在为她的离开而痛苦。","status":"matched","hash_xxh64":"0xC41E7A1CEEDAA67C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1810764116:1":{"text":"我……","source_cn":"我……<key:dialog858>","status":"matched","hash_xxh64":"0xA388BF99B2CD5A83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1810764117:1":{"text":"………………","source_cn":"………………","status":"matched","hash_xxh64":"0x197F0BE8A09E0D34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1810764118:1":{"text":"你还记得我们教官常说的话吧？“有人倒下后——”","source_cn":"你还记得我们教官常说的话吧？“有人倒下后——”","status":"matched","hash_xxh64":"0xBE097DFB081A1229","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1810764119:1":{"text":"“——我们便是他的未竟之路。”","source_cn":"“——我们便是他的未竟之路。”","status":"matched","hash_xxh64":"0x738768732D4174E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1810764120:1":{"text":"所以，你好好活着，就不负她的牺牲。","source_cn":"所以，你好好活着，就不负她的牺牲。","status":"matched","hash_xxh64":"0xB16603ED2EC6E86B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1810764121:1":{"text":"……嗯。","source_cn":"……嗯。<key:dialog808>","status":"matched","hash_xxh64":"0xA83B645BB6A5DBAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1810764122:1":{"text":"对了，为什么你和爱丝都跑到诺珐斯来了？灰影郡战况如何？现在是谁留守？","source_cn":"对了，为什么你和爱丝都跑到诺珐斯来了？灰影郡战况如何？...","status":"matched","hash_xxh64":"0xECFAFF227F6BF556","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1810764123:0":{"text":"对不起。瑟恩离开后，我实在没法安心待在灰影郡干等着。","source_cn":"对不起。瑟恩离开后，我实在没法安心待在灰影郡干等着。<...","status":"matched","hash_xxh64":"0x42AB1C2B2DC0C18E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1810764124:0":{"text":"所以……我就擅自离岗了。但你不用担心，我把能想到的事情都做了！","source_cn":"所以……我就擅自离岗了。但你不用担心，我把能想到的事情...","status":"matched","hash_xxh64":"0x97E237D4EA37395B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1810764125:0":{"text":"爱丝特瑞达向巴登简单叙述了一遍她的安排。","source_cn":"爱丝特瑞达向巴登简单叙述了一遍她的安排。<key:di...","status":"matched","hash_xxh64":"0xC988A36AC084E5B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1810764126:1":{"text":"干得好，爱丝……你比以前稳重了很多。不愧是我们瑞恩家族的家主。","source_cn":"干得好，爱丝……你比以前稳重了很多。不愧是我们瑞恩家族...","status":"matched","hash_xxh64":"0xB864BAAF3FF7CC9E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1810764127:1":{"text":"巴登，我擅离职守，不配再为家主，理应受罚。","source_cn":"巴登，我擅离职守，不配再为家主，理应受罚。","status":"matched","hash_xxh64":"0x8E1956B82D517C18","variant_status":"","male":"","female":"","variant_male_record_index":"","