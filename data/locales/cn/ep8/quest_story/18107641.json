{"asset_key":"ep8/quest_story_18107641","episode":"ep8","category":"quest_story","story_id":"18107641","schema_version":1,"lang":"cn","texts":{"say:3:1810764101:1":{"text":"我……我的记忆……我想起来了……","source_cn":"我……我的记忆……我想起来了……<key:dialog1>","status":"matched","hash_xxh64":"0x5900424F14BBB7DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1810764102:0":{"text":"呜呜呜……巴登！","source_cn":"呜呜呜……巴登！","status":"matched","hash_xxh64":"0x2F10982E36DB6F70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1810764103:0":{"text":"……想起来就好。","source_cn":"……想起来就好。","status":"matched","hash_xxh64":"0x4A366B7C91645427","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1810764104:0":{"text":"好啦，爱丝……你现在可是家主，不能再哭鼻子了。","source_cn":"好啦，爱丝……你现在可是家主，不能再哭鼻子了。","status":"matched","hash_xxh64":"0xC722CB5E5E53E1E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1810764105:0":{"text":"还有瑟恩，你不应该更高兴吗？笑一笑吧。","source_cn":"还有瑟恩，你不应该更高兴吗？笑一笑吧。","status":"matched","hash_xxh64":"0x9E99B3573A7E021D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1810764106:0":{"text":"……你不必这样强颜欢笑。","sourc