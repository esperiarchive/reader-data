t_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1711131026:1":{"text":"而神明，原本也与创造祂们的存在紧紧相连。","source_cn":"而神明，原本也与创造祂们的存在紧紧相连。","status":"matched","hash_xxh64":"0x6F0F3D50D5A07E41","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1711131027:1":{"text":"创造神明的……存在……","source_cn":"创造神明的……存在……","status":"matched","hash_xxh64":"0x3419F5B134D4C5E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1711131028:1":{"text":"凡人，皆有父母。神明，亦有孕育祂的温床。生灵万物，本就无法脱离生命树的绝对循环。","source_cn":"凡人，皆有父母。神明，亦有孕育祂的温床。生灵万物，本就...","status":"matched","hash_xxh64":"0xFD36F523796F06F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1711131029:1":{"text":"生命树是什么？","source_cn":"生命树是什么？","status":"matched","hash_xxh64":"0xB1D49683935255F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1711131030:1":{"text":"之后我会慢慢告诉你。总而言之，这磐石，便是曾经连接着我与那个存在的脐带。","source_cn":"之后我会慢慢告诉你。总而言之，这磐石，便是曾经连接着我...","status":"matched","hash_xxh64":"0x94841924922E698A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1711131031:1":{"text":"当我决心走上自己选择的道路时，我不顾一切代价，亲手斩断了它。","source_cn":"当我决心走上自己选择的道路时，我不顾一切代价，亲手斩断了它。","status":"matched","hash_xxh64":"0x58FCA39BEBEE48A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1711131032:1":{"text":"以此剑为引，立下永恒的试炼吧。与你关联的血肉，且灵魂与我这股意志共鸣之人，方能从磐石中唤醒此剑。","source_cn":"以此剑为引，立下永恒的试炼吧。与你关联的血肉，且灵魂与...","status":"matched","hash_xxh64":"0xFE9072822F26F4C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1711131033:1":{"text":"拔剑者，即拥有继承耀光帝国的资格。","source_cn":"拔剑者，即拥有继承耀光帝国的资格。","status":"matched","hash_xxh64":"0x8E45D4C23148B46A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:罗兰":{"text":"罗兰","source":"罗兰","status":"source"},"speaker:艾雅":{"text":"艾雅","source":"艾雅","status":"source"},"speaker:黑屏文本":{"text":"黑屏文本","source":"黑屏文本","status":"source"}},"stats":{"flow_row_count":35,"localized_text_count":34,"speaker_count":3}}