位。今夜的宴会，已经没有继续的必要了。","source_cn":"诸位。今夜的宴会，已经没有继续的必要了。","status":"matched","hash_xxh64":"0xA5FCCE4B0834E9B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1710770028:1":{"text":"请先行回去休息，养足精神。然后……让我们一起静候奥利安殿下……","source_cn":"请先行回去休息，养足精神。然后……让我们一起静候奥利安...","status":"matched","hash_xxh64":"0xE047EBCB6B3AE3F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1710770029:1":{"text":"……凯旋而归。","source_cn":"……凯旋而归。","status":"matched","hash_xxh64":"0xD9E058EF15D7E1F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:迪尔格雷":{"text":"迪尔格雷","source":"迪尔格雷","status":"source"},"speaker:男爵葛朗台":{"text":"男爵葛朗台","source":"男爵葛朗台","status":"source"},"speaker:女公爵梦妮":{"text":"女公爵梦妮","source":"女公爵梦妮","status":"source"},"speaker:伯爵坦尼斯":{"text":"伯爵坦尼斯","source":"伯爵坦尼斯","status":"source"},"speaker:大臣康斯曼":{"text":"大臣康斯曼","source":"大臣康斯曼","status":"source"},"speaker:亲王孔蒂":{"text":"亲王孔蒂","source":"亲王孔蒂","status":"source"}},"stats":{"flow_row_count":30,"localized_text_count":29,"speaker_count":6}}