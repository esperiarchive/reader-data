{"asset_key":"ep7/quest_story_17203200","episode":"ep7","category":"quest_story","story_id":"17203200","schema_version":1,"lang":"cn","texts":{"say:2:1720320001:1":{"text":"我的挚友。这杯酒，为你，也为所有为耀光献身的人们。","source_cn":"我的挚友。这杯酒，为你，也为所有为耀光献身的人们。","status":"matched","hash_xxh64":"0x9EC2EE2C3F63F436","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1720320002:1":{"text":"帝国已经走上了正轨，我的使命……也已经完成。","source_cn":"帝国已经走上了正轨，我的使命……也已经完成。","status":"matched","hash_xxh64":"0x752007CF6B38E215","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1720320003:1":{"text":"艾雅女神的呼唤，我已听见。我将追随她的指引，前往那凡人无法企及的领域。","source_cn":"艾雅女神的呼唤，我已听见。我将追随她的指引，前往那凡人...","status":"matched","hash_xxh64":"0x6CE7ED05BB216AC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1720320004:1":{"text":"大帝……你要离开我们了吗……","source_cn":"大帝……你要离开我们了吗……","status":"matched","hash_xxh64":"0x55523BD141ABB53A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1720320005:1":{"text":"临别之前，尚有最后一事——","source_cn":"临别之前，尚有最后一事——","status":"matched","hash_xxh64":"0xC475C1E6046E930E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}