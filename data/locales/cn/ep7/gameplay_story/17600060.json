{"asset_key":"ep7/gameplay_story_17600060","episode":"ep7","category":"gameplay_story","story_id":"17600060","schema_version":1,"lang":"cn","texts":{"narration:1:1760006001:0":{"text":"随着号角再次响起，亚古兽和布鲁特斯碰撞在了一起","source_cn":"随着号角再次响起，亚古兽和布鲁特斯碰撞在了一起","status":"matched","hash_xxh64":"0x7CA28F989543EECC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:2:1760006002:0":{"text":"布鲁特斯挥舞着沉重的巨刃，凌厉而精准地劈砍","source_cn":"布鲁特斯挥舞着沉重的巨刃，凌厉而精准地劈砍","status":"matched","hash_xxh64":"0xE4BC069E8646FFA5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:3:1760006003:0":{"text":"而亚古兽则在太一的指挥下，灵活地闪避、喷吐小型火焰","source_cn":"而亚古兽则在太一的指挥下，灵活地闪避、喷吐小型火焰","status":"matched","hash_xxh64":"0x4D789D30FF229B69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:4:1760006004:0":{"text":"几个回合下来，尽管艰难，但亚古兽始终坚持着","source_cn":"几个回合下来，尽管艰难，但亚古兽始终坚持着","status":"matched","hash_xxh64":"0x65D4E046370E82DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1760006005:0":{"text":"太一、亚古兽……加油啊！","source_cn":"太一、亚古兽……加油啊！","status":"matched","hash_xxh64":"0x481007D1FB232E3B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","docum