atus":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1910307012:1":{"text":"哟，我说怎么塔拉萨还有人不知道这些，仔细一看，这不是陆...","source_cn":"哟，我说怎么塔拉萨还有人不知道这些，仔细一看，这不是陆...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1910307013:1":{"text":"你俩怎么还在这？摩淖亚不是送你们回去了吗？","source_cn":"你俩怎么还在这？摩淖亚不是送你们回去了吗？","status":"hash_not_found","hash_xxh64":"0xCDF46CBAD2074502","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1910307014:1":{"text":"……摩淖亚。","source_cn":"……摩淖亚。","status":"hash_not_found","hash_xxh64":"0xFBE628F0B294E1A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1910307015:1":{"text":"老友们，比起为难两个孩子，眼下最要紧难道不是修复母瑚吗？","source_cn":"老友们，比起为难两个孩子，眼下最要紧难道不是修复母瑚吗？","status":"hash_not_found","hash_xxh64":"0xB1CD37CD9A068B62","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1910307016:1":{"text":"子瑚无法像母瑚这样保存能量。再拖下去，它会彻底逸散。","source_cn":"子瑚无法像母瑚这样保存能量。再拖下去，它会彻底逸散。","status":"hash_not_found","hash_xxh64":"0x774A2E5F029375F2","variant_status":"","male":"","female":"","variant_male_record_ind