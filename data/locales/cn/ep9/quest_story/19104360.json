{"asset_key":"ep9/quest_story_19104360","episode":"ep9","category":"quest_story","story_id":"19104360","schema_version":1,"lang":"cn","texts":{"say:1:1910436001:1":{"text":"大个子，你脸色怎么那么难看？","source_cn":"大个子，你脸色怎么那么难看？","status":"hash_not_found","hash_xxh64":"0x6DEFFBB45D52C756","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1910436002:1":{"text":"喂，你该不会也信那个触手男说的话了吧？！","source_cn":"喂，你该不会也信那个触手男说的话了吧？！","status":"hash_not_found","hash_xxh64":"0xB5FF23803362C3DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1910436003:1":{"text":"艾菲拉不可能发疯，她很正常！咱俩不是最清楚这点的吗？！","source_cn":"艾菲拉不可能发疯，她很正常！咱俩不是最清楚这点的吗？！","status":"hash_not_found","hash_xxh64":"0x1FD1837922B3AA57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1910436004:1":{"text":"……大个子，你倒是说句话啊！","source_cn":"……大个子，你倒是说句话啊！","status":"hash_not_found","hash_xxh64":"0x5C6E634C7EA9B461","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1910436004":{"text":"……大个子，你倒是说句话啊！","source_cn":"……大个子，你倒是说句话啊！","status":"hash_not_found","hash_xxh64":"0x5C6E634C7EA9B461","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_sta