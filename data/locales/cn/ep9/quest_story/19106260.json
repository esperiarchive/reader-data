"female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1910626010:1":{"text":"不知名的先生，我是出身塔拉萨的浅海裔，这两位来自陆地，...","source_cn":"不知名的先生，我是出身塔拉萨的浅海裔，这两位来自陆地，...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1910626011:1":{"text":"你们的外表并不相像，但内里未必不同。他们来自陆地，却属...","source_cn":"你们的外表并不相像，但内里未必不同。他们来自陆地，却属...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1910626012:1":{"text":"嗯……是吗？好像有道理，但又好像没道理。我不想做深岩家...","source_cn":"嗯……是吗？好像有道理，但又好像没道理。我不想做深岩家...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1910626013:1":{"text":"不想。","source_cn":"不想。","status":"matched_gender<key:male>","hash_xxh64":"0x571BE0B44E5FBB8E","variant_status":"adjacent_same_source_target_same","male":"不想。","female":"不想。","variant_male_record_index":"173739","variant_female_record_index":"173740","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1910626014:1":{"text":"噢……真可惜！","source_cn":"噢……真可惜！","status":"hash_not_found","hash_xxh64":"0x542FD10745C64B6C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:1:2":{"text":"深岩家的新生儿？我们？","source_cn":"深岩家的新生儿？我们？","status":"hash_not_found","hash_xxh64":"0xFDEA15180D95E9D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1910626015:1":{"text":"咱一路过来没见到一个能正常说话的人，你怎么没事！","source_cn":"咱一路过来没见到一个能正常说话的人，你怎么没事！","status":"hash_not_found","hash_xxh64":"0x84B55F2684B18459","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1910626016:1":{"text":"因为这里<style=highlight>只装得下一件...","source_cn":"因为这里<style=highlight>只装得下一件...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1910626017:1":{"text":"心愿潮池只有愿望存在，一代人的愿望，数代人的愿望。每天...","source_cn":"心愿潮池只有愿望存在，一代人的愿望，数代人的愿望。每天...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1910626018:1":{"text":"心愿是人存在过的证明，我保护它们，也许它们也保护我。只...","source_cn":"心愿是人存在过的证明，我保护它们，也许它们也保护我。只...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1910626019:1":{"text":"所以你能保持理智？","source_cn":"所以你能保持理智？","status":"hash_not_found","hash_xxh64":"0xC99130744B3B4537","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1910626020:1":{"text":"鼓声正在持续，我听得到。我只是选择不去听。","source_cn":"鼓声正在持续，我听得到。我只是选择不去听。","status":"hash_not_found","hash_xxh64":"0x7EEF89CC04288BD4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:2:3":{"text":"你还保持着理智？！","source_cn":"你还保持着理智？！","status":"hash_not_found","hash_xxh64":"0x2AA4A31076A6DE5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1910626021:1":{"text":"我不知道什么是亡灵，但见过一个浅海裔。","source_cn":"我不知道什么是亡灵，但见过一个浅海裔。","status":"hash_not_found","hash_xxh64":"0x77D432C16F335642","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1910626022:1":{"text":"他来过这里，许多次。他径直游来，想留刻心愿，于是我放他通行。","source_cn":"他来过这里，许多次。他径直游来，想留刻心愿，于是我放他通行。","status":"hash_not_found","hash_xxh64":"0x16E7757DDCDF47F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1910626023:1":{"text":"你不认识他，干嘛帮他？！","source_cn":"你不认识他，干嘛帮他？！","status":"hash_not_found","hash_xxh64":"0x42578D673139D3D9","variant_status":"","male":"","f