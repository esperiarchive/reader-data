{"asset_key":"ep9/quest_story_19106260","episode":"ep9","category":"quest_story","story_id":"19106260","schema_version":1,"lang":"cn","texts":{"say:1:1910626001:1":{"text":"我是这里的守池人，湛。","source_cn":"我是这里的守池人，湛。","status":"hash_not_found","hash_xxh64":"0x4FA7E639FBA88551","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1910626002:1":{"text":"可以随便称呼我，这个名字太久没用，我自己都快忘了。","source_cn":"可以随便称呼我，这个名字太久没用，我自己都快忘了。","status":"hash_not_found","hash_xxh64":"0x8C63C2EB769917B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1910626003:1":{"text":"你们是今年最后一批，去镌刻心愿吧，愿望不论早晚。","source_cn":"你们是今年最后一批，去镌刻心愿吧，愿望不论早晚。","status":"hash_not_found","hash_xxh64":"0x33BF1519907C2896","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1910626004:1":{"text":"你……你还在，不可思议。","source_cn":"你……你还在，不可思议。","status":"hash_not_found","hash_xxh64":"0xA638DB4F982C8008","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1910626004":{"text":"你……你还在，不可思议。","source_cn":"你……你还在，不可思议。","status":"hash_not_found","hash_xxh64":"0xA638DB4F982C8008","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"