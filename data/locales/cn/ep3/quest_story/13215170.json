{"asset_key":"ep3/quest_story_13215170","episode":"ep3","category":"quest_story","story_id":"13215170","schema_version":1,"lang":"cn","texts":{"say:3:1321517001:0":{"text":"你说的是这个位置吗，伽利？","source_cn":"你说的是这个位置吗，伽利？","status":"matched","hash_xxh64":"0xFB088CFF0A0A498E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321517002:0":{"text":"没错，就是那里！咱们还是一如既往地有默契！","source_cn":"没错，就是那里！咱们还是一如既往地有默契！","status":"matched","hash_xxh64":"0xC87E4896A3EAE873","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321517003:1":{"text":"好吧，你们快去找那些可疑的家伙吧。我在这里等你们。","source_cn":"好吧，你们快去找那些可疑的家伙吧。我在这里等你们。","status":"matched","hash_xxh64":"0xCEE46A0B1308291F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321517004:0":{"text":"放心吧，我们很快就回来！","source_cn":"放心吧，我们很快就回来！","status":"matched","hash_xxh64":"0x07BDD6F156ABA1BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1321517005:0":{"text":"我也会带人提前守好这里，不用担心。","source_cn":"我也会带人提前守好这里，不用担心。","status":"matched","hash_xxh64":"0x62D4E0C150752E78","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1321517006:0":{"text":"哦，对了！