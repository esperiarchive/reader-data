{"asset_key":"ep3/quest_story_13214040","episode":"ep3","category":"quest_story","story_id":"13214040","schema_version":1,"lang":"cn","texts":{"say:2:1321404001:1":{"text":"小朋友，你是卡洛夫家的人吗？","source_cn":"小朋友，你是卡洛夫家的人吗？","status":"matched","hash_xxh64":"0x5A9D6FA5DADB8787","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1321404002:1":{"text":"你们会怎么知道？\n……你们也不像是雪松镇的人啊。","source_cn":"你们会怎么知道？\\n……你们也不像是雪松镇的人啊。","status":"matched_runtime_gender","hash_xxh64":"0xB4D9F41D9DC5FD88","variant_status":"runtime_gender_keys_target_same","male":"你们会怎么知道？\n……你们也不像是雪松镇的人啊。","female":"你们会怎么知道？\n……你们也不像是雪松镇的人啊。","variant_male_record_index":"150229","variant_female_record_index":"150230","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321404003:1":{"text":"你听说过卡明斯基家族吗？","source_cn":"你听说过卡明斯基家族吗？","status":"matched","hash_xxh64":"0x9BC2C588444CC27F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321404004:1":{"text":"唔，我听我哥哥提起过，好像是关系很远的亲戚……","source_cn":"唔，我听我哥哥提起过，好像是关系很远的亲戚……","status":"matched","hash_xxh64":"0xCA9B68FA252A6DC5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1321404005:1":{"text":"难道你们是那个家族的人？","source_cn":"难道你们是那个家族的人？","status":"matched","hash_xxh64":"0x27BB438E61AA0DAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document