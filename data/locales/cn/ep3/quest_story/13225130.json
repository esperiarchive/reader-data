{"asset_key":"ep3/quest_story_13225130","episode":"ep3","category":"quest_story","story_id":"13225130","schema_version":1,"lang":"cn","texts":{"say:1:1322513001:1":{"text":"我招！我全都招！只要别杀我，我什么都愿意交代！","source_cn":"我招！我全都招！只要别杀我，我什么都愿意交代！","status":"matched","hash_xxh64":"0xD06AED8B7C120FD9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322513002:1":{"text":"哼，别想耍花样！你们偷到的东西肯定不止这么一点，老实说，其他的东西被你们藏到哪里了？","source_cn":"哼，别想耍花样！你们偷到的东西肯定不止这么一点，老实说...","status":"matched","hash_xxh64":"0xFAFA34FBAF3A8D94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322513003:1":{"text":"我说，我说……我们都……都藏在树下了……就是南边的那棵树……","source_cn":"我说，我说……我们都……都藏在树下了……就是南边的那棵树……","status":"matched","hash_xxh64":"0x5BA5D1DF5BB1684C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:吓破胆的盗匪":{"text":"吓破胆的盗匪","source":"吓破胆的盗匪","status":"source"},"speaker:漫漫":{"text":"漫漫","source":"漫漫","status":"source"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}