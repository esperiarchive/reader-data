{"asset_key":"ep3/quest_story_13101070","episode":"ep3","category":"quest_story","story_id":"13101070","schema_version":1,"lang":"cn","texts":{"say:0:1310107001:0":{"text":"别看雪松镇不大，可冬日祭典一直在这儿举办。","source_cn":"别看雪松镇不大，可冬日祭典一直在这儿举办。","status":"matched","hash_xxh64":"0x1FF96AB4F42EEFE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1310107002:0":{"text":"说是为了纪念第一次神魔大战时候的战争英雄……","source_cn":"说是为了纪念第一次神魔大战时候的战争英雄……","status":"matched","hash_xxh64":"0xA846E49873FA14C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1310107003:0":{"text":"战争英雄，是谁？","source_cn":"战争英雄，是谁？","status":"matched","hash_xxh64":"0x90246176F1E6A8C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1310107004:0":{"text":"这我不清楚，反正纪念的是位女将军。哎，你到镇子里就知道了！","source_cn":"这我不清楚，反正纪念的是位女将军。哎，你到镇子里就知道了！","status":"matched","hash_xxh64":"0xFA8EAA89806F0B5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:商人斯瓦夫":{"text":"商人斯瓦夫","source":"商人斯瓦夫","status":"source"},"speaker:满满":{"text":"满满","source":"满满","status":"source"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}