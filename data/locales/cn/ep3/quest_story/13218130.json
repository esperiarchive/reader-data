{"asset_key":"ep3/quest_story_13218130","episode":"ep3","category":"quest_story","story_id":"13218130","schema_version":1,"lang":"cn","texts":{"say:1:1321813001:1":{"text":"你是奥尔嘉吗？","source_cn":"你是奥尔嘉吗？","status":"matched","hash_xxh64":"0x9FCE5102514381A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1321813002:1":{"text":"是的，你们……你们是谁？","source_cn":"是的，你们……你们是谁？","status":"matched","hash_xxh64":"0x170BF2E7DA80C237","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1321813003:1":{"text":"啊，那个……那是我妈妈的遗骨！为什么会在你们手里，我爸爸呢？","source_cn":"啊，那个……那是我妈妈的遗骨！为什么会在你们手里，我爸爸呢？","status":"matched","hash_xxh64":"0x51B48F524C2E7F39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321813004:1":{"text":"我们在路上遇到了你父亲……他……","source_cn":"我们在路上遇到了你父亲……他……","status":"matched","hash_xxh64":"0x22F2C82B9144CA16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1321813004":{"text":"我们在路上遇到了你父亲……他……","source_cn":"我们在路上遇到了你父亲……他……","status":"matched","hash_xxh64":"0x22F2C82B9144CA16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321813005:1":{"text":"活死人袭击了他……对不起