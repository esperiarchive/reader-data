{"asset_key":"ep3/quest_story_13111290","episode":"ep3","category":"quest_story","story_id":"13111290","schema_version":1,"lang":"cn","texts":{"say:3:1311129001:1":{"text":"你！你们！为何擅闯永寂庄园！子爵先生极少接见外客！","source_cn":"你！你们！为何擅闯永寂庄园！子爵先生极少接见外客！","status":"matched","hash_xxh64":"0x3AC34A14B9F9C3BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1311129002:1":{"text":"我们没有擅闯，是经过烛台管家允许的。是他让我们在这里等柳博米尔。","source_cn":"我们没有擅闯，是经过烛台管家允许的。是他让我们在这里等...","status":"matched","hash_xxh64":"0xFAC45BE231255EF6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1311129003:1":{"text":"你，竟然直呼子爵先生的姓名！真是无理之人！必须受到惩罚！","source_cn":"你，竟然直呼子爵先生的姓名！真是无理之人！必须受到惩罚！","status":"matched","hash_xxh64":"0x9EBCAA87B1DA10CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1311129004:1":{"text":"诶？！你怎么脾气这么暴躁……你怎么打人！","source_cn":"诶？！你怎么脾气这么暴躁……你怎么打人！","status":"matched","hash_xxh64":"0x5C7CDB70126A8D1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:烛台守卫":{"text":"烛台守卫","source":"烛台守卫","status":"source"},"speaker:漫漫":{"text":"漫漫","source":"漫漫","status":"source"},"speaker:满满":{"text":"满满","source":"满满","status":"source"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":3}}