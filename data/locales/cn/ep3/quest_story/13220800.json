4FF13372F83047","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1322080013:1":{"text":"戴蒙心疼我，自己躺在病床上也要跟我学这种编织手法，想多帮帮我……","source_cn":"戴蒙心疼我，自己躺在病床上也要跟我学这种编织手法，想多...","status":"matched","hash_xxh64":"0x8B305F5288FB2AE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1322080014:0":{"text":"多体贴、多懂事的孩子呀！","source_cn":"多体贴、多懂事的孩子呀！","status":"matched","hash_xxh64":"0x2D337C7D0B3D3651","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1322080015:0":{"text":"原来你们亡灵和人一样，孩子会心疼母亲，母亲也会担心孩子的安危……这么想来，好像你们亡灵也没那么可怕了。","source_cn":"原来你们亡灵和人一样，孩子会心疼母亲，母亲也会担心孩子...","status":"matched","hash_xxh64":"0x8BFBB15BC97EA3E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1322080016:1":{"text":"戴蒙他除了编花环还做了什么、说了什么吗？他有没有说他要去哪里？","source_cn":"戴蒙他除了编花环还做了什么、说了什么吗？他有没有说他要...","status":"matched","hash_xxh64":"0x1C24C944B7FB1E2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1322080017:0":{"text":"让我想想啊……","source_cn":"让我想想啊……","status":"matched","hash_xxh64":"0xA74190A9F469D6A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1322080018:0":{"text":"呜呜呜……我想要一个花环，能戴在头上的那种。","source_cn":"呜呜呜……我想要一个花环，能戴在头上的那种。","status":"matched","hash_xxh64":"0xF5BDC23A1834620B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1322080019:0":{"text":"乖孩子，妈妈手笨，等你爸爸回来，让他给你编一个好不好？","source_cn":"乖孩子，妈妈手笨，等你爸爸回来，让他给你编一个好不好？","status":"matched","hash_xxh64":"0xDD22E32D81CF1191","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1322080020:1":{"text":"我现在就想要嘛……呜呜……","source_cn":"我现在就想要嘛……呜呜……","status":"matched","hash_xxh64":"0x1450BE40A98BA1A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1322080021:0":{"text":"唉，这可难住我了。就再等一天，你爸爸明天就回来了，咱们明天再编花环行不行？","source_cn":"唉，这可难住我了。就再等一天，你爸爸明天就回来了，咱们...","status":"matched","hash_xxh64":"0x1C6E6EEC3E87B24B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1322080022:1":{"text":"别人都有，我也想要一个……呜呜……妈妈，就给我做一个嘛……","source_cn":"别人都有，我也想要一个……呜呜……妈妈，就给我做一个嘛……","status":"matched","hash_xxh64":"0x3D94C7DF54465EBD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1322080023:1":{"text":"这个，给你……","source_cn":"这个，给你……","status":"matched","hash_xxh64":"0x9BB0B66664925B4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:28::2":{"text":"花环","source_cn":"花环","status":"matched","hash_xxh64":"0x4914AF0F181E0860","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1322080024:1":{"text":"咦……真的、真的给我吗？","source_cn":"咦……真的、真的给我吗？","status":"matched","hash_xxh64":"0xAFD8AAB4EDD5C3DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1322080025:1":{"text":"嗯，我要去找朋友了。这个送给你，不要哭了。我妈妈说小孩子哭了会生病，生病了就不能和朋友一起玩了。","source_cn":"嗯，我要去找朋友了。这个送给你，不要哭了。我妈妈说小孩...","status":"matched","hash_xxh64":"0xB834F742AA89DEEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1322080026:1":{"text":"我、我不哭了，谢谢小哥哥！","source_cn":"我、我不哭了，谢谢小哥哥！","status":"matched","hash_xxh64":"0x6A31FCBBD1EEFEC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1322080027:0":{"text":"他给我们做好花环就往那边路上去了。好像是要去找朋友呢。喏，他走的是那边的路，应该是往哀叹之湖那边去了，你们快点追上去看看吧。","source_cn":"他给我们做好花环就往那边路上去了。好像是要去找朋友呢。...","status":"matched","hash_xxh64":"0