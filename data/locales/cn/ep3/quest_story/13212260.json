{"asset_key":"ep3/quest_story_13212260","episode":"ep3","category":"quest_story","story_id":"13212260","schema_version":1,"lang":"cn","texts":{"say:1:1321226001:1":{"text":"天哪！幸好最后一刻见到了阿托卡大师。","source_cn":"天哪！幸好最后一刻见到了阿托卡大师。","status":"matched","hash_xxh64":"0x8CCA844E80C87D1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1321226002:1":{"text":"如果错过……我肯定追悔终身！","source_cn":"如果错过……我肯定追悔终身！","status":"matched","hash_xxh64":"0xD0468A61C91EF246","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1321226003:1":{"text":"你要感谢小雪人哦！","source_cn":"你要感谢小雪人哦！","status":"matched","hash_xxh64":"0x4BC98B96BA83E0B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321226004:1":{"text":"还好小雪人推了我一把，不然我肯定还在纠结细节。","source_cn":"还好小雪人推了我一把，不然我肯定还在纠结细节。","status":"matched","hash_xxh64":"0xFCFCE10451D6DF74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321226005:1":{"text":"觉得一定要改到自己满意，才敢出手。","source_cn":"觉得一定要改到自己满意，才敢出手。","status":"matched","hash_xxh64":"0xF785E71D91B533A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321226006:1":{"text":"结果一拖再拖……","source_cn":"结果一拖再拖……","status":"matched","hash_xxh64":"0xF1E21E008EC49269","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1321226007:1":{"text":"多亏了咱吧！你该治……治治这个毛病了！","source_cn":"多亏了咱吧！你该治……治治这个毛病了！","status":"matched","hash_xxh64":"0x195FFF83FB219D6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1321226008:1":{"text":"这有个学名，叫拖延症。","source_cn":"这有个学名，叫拖延症。","status":"matched","hash_xxh64":"0x8B4A5D328B909C3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1321226009:1":{"text":"小雪人这种行动派呢，专治拖延症。","source_cn":"小雪人这种行动派呢，专治拖延症。","status":"matched","hash_xxh64":"0x0BF46F98463570DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1321226010:1":{"text":"干啥都急吼吼的。","source_cn":"干啥都急吼吼的。","status":"matched","hash_xxh64":"0x187B69D56760B638","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1321226011:1":{"text":"因……为咱生命短……暂呀！要争分夺……秒！","source_cn":"因……为咱生命短……暂呀！要争分夺……秒！","status":"matched","hash_xxh64":"0x0BB97D311A44500D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1321226012:1":{"text":"你怎么说话断断续续的！","source_cn":"你怎么说话断断续续的！","status":"matched","hash_xxh64":"0xF0B31BFB1AF667A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1321226013:1":{"text":"你不是念叨着想看花吗？这里景色不错吧！","source_cn":"你不是念叨着想看花吗？这里景色不错吧！","status":"matched","hash_xxh64":"0x9301194793327B57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1321226014:1":{"text":"野……花！好看！","source_cn":"野……花！好看！","status":"matched","hash_xxh64":"0xB15710700807FE46","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:画家派特":{"text":"画家派特","source":"画家派特","status":"source"},"speaker:漫漫":{"text":"漫漫","source":"漫漫","status":"source"},"speaker:雪人":{"text":"雪人","source":"雪人","status":"source"},"speaker:满满":{"text":"满满","source":"满满","status":"source"}},"stats":{"flow_row_count":15,"localized_text_count":14,"speaker_count":4}}