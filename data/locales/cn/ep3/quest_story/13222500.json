{"asset_key":"ep3/quest_story_13222500","episode":"ep3","category":"quest_story","story_id":"13222500","schema_version":1,"lang":"cn","texts":{"say:1:1322250001:1":{"text":"猎人先生，黑沼森林十分危险，请不要再闯进这里打猎了！","source_cn":"猎人先生，黑沼森林十分危险，请不要再闯进这里打猎了！","status":"matched","hash_xxh64":"0x203EC3FD715381D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322250002:1":{"text":"我……我只是觉得这边的猎物可能会比较值钱……没想到这么多魔物！","source_cn":"我……我只是觉得这边的猎物可能会比较值钱……没想到这么...","status":"matched","hash_xxh64":"0x6E62A37F8019632C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322250003:1":{"text":"这里被魔物占据，不适合打猎，我们送你出去吧。","source_cn":"这里被魔物占据，不适合打猎，我们送你出去吧。","status":"matched","hash_xxh64":"0x40107FE67FF05CF9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322250004:1":{"text":"谢…谢谢……我不会再来这里了。","source_cn":"谢…谢谢……我不会再来这里了。","status":"matched","hash_xxh64":"0x939AE605A16CFEB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"漫漫","source":"漫漫","status":"source"},"speaker:闯入森林的猎人":{"text":"闯入森林的猎人","source":"闯入森林的猎人","status":"source"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}