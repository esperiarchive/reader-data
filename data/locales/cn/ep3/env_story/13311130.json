{"asset_key":"ep3/env_story_13311130","episode":"ep3","category":"env_story","story_id":"13311130","schema_version":1,"lang":"cn","texts":{"say:3:1331113001:1":{"text":"雪人机！我这次想要那种可以自动堆雪人的机器！","source_cn":"雪人机！我这次想要那种可以自动堆雪人的机器！","status":"matched","hash_xxh64":"0xFFDE96C86587BC64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1331113002:1":{"text":"你是觉得堆雪人很难吗？","source_cn":"你是觉得堆雪人很难吗？","status":"matched","hash_xxh64":"0xD3C9E3F3F8120D56","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1331113003:1":{"text":"堆那种普通的雪人当然很容易，那如果是堆那种有外貌细节的雪人呢？怎么样，是不是很有想法！","source_cn":"堆那种普通的雪人当然很容易，那如果是堆那种有外貌细节的...","status":"matched","hash_xxh64":"0xB8028C714C37A4C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1331113004:1":{"text":"……我现在唯一的想法，就是怎么把你丢出去！","source_cn":"……我现在唯一的想法，就是怎么把你丢出去！","status":"matched","hash_xxh64":"0x126189B1ABD2A163","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:商人特莱姆":{"text":"商人特莱姆","source":"商人特莱姆","status":"source"},"speaker:矮人工匠麦驰":{"text":"矮人工匠麦驰","source":"矮人工匠麦驰","status":"source"},"speaker:矮人工匠司都恩":{"text":"矮人工匠司都恩","source":"矮人工匠司都恩","status":"source"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":3}}