{"asset_key":"timeline/dialoguetree_story_10102070","episode":"timeline","category":"dialoguetree_story","story_id":"10102070","schema_version":1,"lang":"cn","texts":{"say:3:1010207001:0":{"text":"到这里就没问题了！各位，你们都还好吗？","source_cn":"到这里就没问题了！各位，你们都还好吗？","status":"matched","hash_xxh64":"0x83A7C4E81EA4AD69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1010207002:0":{"text":"还、还好……就是晕得慌……还有……","source_cn":"还、还好……就是晕得慌……还有……","status":"matched","hash_xxh64":"0xC08194F406EB84A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1010207003:0":{"text":"——呕……！！！","source_cn":"——呕……！！！","status":"matched","hash_xxh64":"0x724086224357DF72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1010207004:0":{"text":"呀——！你别吐在我的裙子上！！！","source_cn":"呀——！你别吐在我的裙子上！！！","status":"matched","hash_xxh64":"0x83EA71EB8431066D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1010207005:0":{"text":"太好了……只是呕吐而已。","source_cn":"太好了……只是呕吐而已。","status":"matched","hash_xxh64":"0x44CC2584715FBA20","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1010207006:0":{"text":"“只是呕吐而已”？","s