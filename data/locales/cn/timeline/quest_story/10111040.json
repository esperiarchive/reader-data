{"asset_key":"timeline/quest_story_10111040","episode":"timeline","category":"quest_story","story_id":"10111040","schema_version":1,"lang":"cn","texts":{"cinematic_dialogue:2:1011101001:":{"text":"科林，我们怎么办？","source_cn":"科林，我们怎么办？","status":"matched","hash_xxh64":"0xFCDA577A62ECB688","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1011101002:":{"text":"绿裔的人为什么要赶我们？","source_cn":"绿裔的人为什么要赶我们？","status":"matched","hash_xxh64":"0x53BB3AFF9E06469A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1011102001:":{"text":"科林先生，船！有船来了！","source_cn":"科林先生，船！有船来了！","status":"matched","hash_xxh64":"0xE9D510E95154D679","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1011102002:":{"text":"又有逃难者来了？","source_cn":"又有逃难者来了？","status":"matched","hash_xxh64":"0x13B729AFC2C0D7BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1011103001:":{"text":"回去吧，这里无法长待","source_cn":"回去吧，这里无法长待","status":"matched","hash_xxh64":"0x410A168A89354123","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1011104001:0":{"text":"