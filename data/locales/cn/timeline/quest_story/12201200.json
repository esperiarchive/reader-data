{"asset_key":"timeline/quest_story_12201200","episode":"timeline","category":"quest_story","story_id":"12201200","schema_version":1,"lang":"cn","texts":{"say:4:1220120001:0":{"text":"你们拿到钥匙了？乔纳森呢？他怎么没和你们一起回来？","source_cn":"你们拿到钥匙了？乔纳森呢？他怎么没和你们一起回来？","status":"matched","hash_xxh64":"0xB87813350E2CCECD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1220120002:0":{"text":"塞西莉亚？！你、你这个样子是——","source_cn":"塞西莉亚？！你、你这个样子是——","status":"matched","hash_xxh64":"0x56F02724F8CEEEE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1220120002":{"text":"塞西莉亚？！你、你这个样子是——","source_cn":"塞西莉亚？！你、你这个样子是——","status":"matched","hash_xxh64":"0x56F02724F8CEEEE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1220120003:0":{"text":"……啊，是这样啊，原来我早已经……","source_cn":"……啊，是这样啊，原来我早已经……","status":"matched","hash_xxh64":"0xFE66CC2D57627BAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1220120004:1":{"text":"塞西莉亚小姐……","source_cn":"塞西莉亚小姐……","status":"matched","hash_xxh64":"0xFBFA56C7FBECA25A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1220120005:0":{"tex