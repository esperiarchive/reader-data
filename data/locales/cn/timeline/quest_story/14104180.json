e_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1410418014:1":{"text":"因度厄，你对平民还是如此宽宥……就依你所言吧，遵守律法。","source_cn":"因度厄，你对平民还是如此宽宥……就依你所言吧，遵守律法。","status":"matched","hash_xxh64":"0xE4AB151BDCDAF802","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1410418015:1":{"text":"我相信，即使在接受惩罚后……你还是能履行好自己的责任，对吗？","source_cn":"我相信，即使在接受惩罚后……你还是能履行好自己的责任，对吗？","status":"matched","hash_xxh64":"0x2C48C1B735AF5BAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1410418016:0":{"text":"奎茵冕下，我永远不会因为惩罚而心怀怨恨，更不会玷污自己的职责。","source_cn":"奎茵冕下，我永远不会因为惩罚而心怀怨恨，更不会玷污自己...","status":"matched","hash_xxh64":"0x2CA0986AD07C3064","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1410418017:0":{"text":"你明白便好。这次的惩戒只是为了让你吸取教训，更加忠诚。","source_cn":"你明白便好。这次的惩戒只是为了让你吸取教训，更加忠诚。","status":"matched","hash_xxh64":"0x8D8F9F9CF09C32FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1410418018:0":{"text":"因度厄，你是位有才能的年轻人。女王总会予以特殊的宽容。","source_cn":"因度厄，你是位有才能的年轻人。女王总会予以特殊的宽容。","status":"matched","hash_xxh64":"0x26DF5BC7EA89D010","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","doc