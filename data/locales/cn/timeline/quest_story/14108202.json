{"asset_key":"timeline/quest_story_14108202","episode":"timeline","category":"quest_story","story_id":"14108202","schema_version":1,"lang":"cn","texts":{"cinematic_dialogue:2:1410820101:":{"text":"追！","source_cn":"追！","status":"matched","hash_xxh64":"0x69C08ADD1DB1ED7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1410820102:":{"text":"没事，别管他们了","source_cn":"没事，别管他们了","status":"matched","hash_xxh64":"0x593FC77275D383D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1410820201:0":{"text":"奎茵，不能放走他们。","source_cn":"奎茵，不能放走他们。","status":"matched","hash_xxh64":"0x3B2E7DC247A85418","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410820202:1":{"text":"我理解您的担忧，都铎大人。","source_cn":"我理解您的担忧，都铎大人。","status":"matched","hash_xxh64":"0xBA321B6199AC11A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1410820203:1":{"text":"因度厄已经拒绝了灵露。没有恩典的滋养，他很快就会孽化。","source_cn":"因度厄已经拒绝了灵露。没有恩典的滋养，他很快就会孽化。","status":"matched","hash_xxh64":"0x726C086527DACE17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1410820204:1":{"text":"到那时候，他的同伴要么亲手了结他，要么看着他变成怪物。","source_cn":"到那时候，他的同伴要么亲手了结他，要么看着他变成怪物。","status":"matched","hash_xxh64":"0x6D535CF8BB847637","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1410820205:1":{"text":"这比杀了他更好，不是吗？","source_cn":"这比杀了他更好，不是吗？","status":"matched","hash_xxh64":"0x411B0814BFE71ACC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1410820206:1":{"text":"万一……","source_cn":"万一……","status":"matched","hash_xxh64":"0x12B36E28CB55D895","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1410820207:1":{"text":"万一他回心转意，喝下恩典灵露……那就更好了。","source_cn":"万一他回心转意，喝下恩典灵露……那就更好了。","status":"matched","hash_xxh64":"0x1B53F536C352977C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1410820208:1":{"text":"他就会明白女王陛下的良苦用心。","source_cn":"他就会明白女王大人的良苦用心。","status":"matched","hash_xxh64":"0x259E12AEA3C1C543","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1410820209:1":{"text":"但是……","source_cn":"但是……","status":"matched","hash_xxh64":"0xCF42FF06FD148D39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1410820210:1":{"text":"这是陛下的意思。","source_cn":"这是陛下的意思。","status":"matched","hash_xxh64":"0xA8FAB954BCFEB207","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1410820211:0":{"text":"我明白了。众士兵听令，停止追击——","source_cn":"我明白了。众士兵听令，停止追击——","status":"matched","hash_xxh64":"0x66F3092E83D606C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:15:1410820212:0":{"text":"与此同时，你、祖娅和因度厄也成功传送到赫托神殿……","source_cn":"与此同时，你、祖娅和因度厄也成功传送到赫托神殿……","status":"matched_runtime_gender","hash_xxh64":"0x65CCCACC177FDE85","variant_status":"runtime_gender_keys_target_same","male":"与此同时，你、祖娅和因度厄也成功传送到赫托神殿……","female":"与此同时，你、祖娅和因度厄也成功传送到赫托神殿……","variant_male_record_index":"158780","variant_female_record_index":"158781","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:17:140108119:0":{"text":"你们紧急传送离开了宫殿，都铎试图继续追击时，被奎茵拦了下来。","source_cn":"你们紧急传送离开了宫殿，都铎试图继续追击时，被奎茵拦了下来。","status":"matched_runtime_gender","hash_xxh64":"0x0BBE84EA3AADA3CE","variant_status":"runtime_gender_keys_target_same","male":"你们紧急传送离开了宫殿，都铎试图继续追击时，被奎茵拦了下来。","female":"你们紧急传送离开了宫殿，都铎试图继续追击时，被奎茵拦了下来。","variant_male_record_index":"166571","variant_female_record_index":"166572","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:都铎":{"text":"都铎","source":"都铎","status":"source"},"speaker:奎茵":{"text":"奎茵","source":"奎茵","status":"source"},"speaker:黑屏字幕":{"text":"黑屏字幕","source":"黑屏字幕","status":"sourc