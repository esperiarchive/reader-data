{"asset_key":"timeline/quest_story_12111150","episode":"timeline","category":"quest_story","story_id":"12111150","schema_version":1,"lang":"cn","texts":{"cinematic_dialogue:2:1211114001:":{"text":"霍德希金！难道他比我们先找到宝藏了？","source_cn":"霍德希金！难道他比我们先找到宝藏了？","status":"matched","hash_xxh64":"0x0584325D2361C1ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1211114002:":{"text":"不可能……他怎么会来到这里？","source_cn":"不可能……他怎么会来到这里？","status":"matched","hash_xxh64":"0x634EB0A57AA61D54","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1211114003:":{"text":"哼……感到惊喜吗？","source_cn":"哼……感到惊喜吗？","status":"matched","hash_xxh64":"0x4709126B8AA0405B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211115001:0":{"text":"就算跑到天涯海角，弱小的虫子终究无法逃出我的手心！","source_cn":"就算跑到天涯海角，弱小的虫子终究无法逃出我的手心！","status":"matched","hash_xxh64":"0x6B954E5AC78DADA8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211115002:0":{"text":"你竟然跟踪我们！","source_cn":"你竟然跟踪我们！","status":"matched","hash_xxh64":"0xC993AC0FE279F083","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:12111