title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1111019012:1":{"text":"我、不是、任何人的搭档！别拿我和他混为一谈！","source_cn":"我、不是、任何人的搭档！别拿我和他混为一谈！","status":"matched","hash_xxh64":"0x34A2AB13F4CBE244","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1111019013:1":{"text":"蛮血小子，别不知好歹，你信任的同伴正在把你送上绝路呢。","source_cn":"蛮血小子，别不知好歹，你信任的同伴正在把你送上绝路呢。","status":"matched","hash_xxh64":"0x96B236D928038967","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1111019014:1":{"text":"他知道我们的厉害，所以才带着你来挑战我们，你就不怕陪他一起送命？","source_cn":"他知道我们的厉害，所以才带着你来挑战我们，你就不怕陪他...","status":"matched","hash_xxh64":"0xA320DE712B3589A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1111019015:0":{"text":"瓦尔克的过去，我管不着。","source_cn":"瓦尔克的过去，我管不着。","status":"matched","hash_xxh64":"0x245EC046662687F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1111019016:1":{"text":"我只知道，你，让我很不爽！","source_cn":"我只知道，你，让我很不爽！","status":"matched","hash_xxh64":"0x89F3CE9032292FE2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"瓦尔