{"asset_key":"timeline/quest_story_15107100","episode":"timeline","category":"quest_story","story_id":"15107100","schema_version":1,"lang":"cn","texts":{"cinematic_dialogue:2:1510709001:":{"text":"哥哥！","source_cn":"哥哥！","status":"matched","hash_xxh64":"0xF92AECAA62274ED2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1510709002:":{"text":"哥哥，你怎么还没走呀！","source_cn":"哥哥，你怎么还没走呀！","status":"matched","hash_xxh64":"0xB599CF8657A16831","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1510709003:":{"text":"我、我……","source_cn":"我、我……<key:dialog2>","status":"matched","hash_xxh64":"0xA9AE1C156FA83E0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510710001:0":{"text":"哥哥，统帅大人从城北走了，你不跟上他的队伍吗？","source_cn":"哥哥，统帅大人从城北走了，你不跟上他的队伍吗？","status":"matched","hash_xxh64":"0x0D969356CDCB727C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510710002:0":{"text":"……唉，你不懂，哥哥也有害怕的事……","source_cn":"……唉，你不懂，哥哥也有害怕的事……","status":"matched","hash_xxh64":"0xF69E321FF76D6E3B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510710003:0":{"text