h_xxh64":"0xF129647843FBC728","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1620123019:0":{"text":"就、就只是忍着吗？","source_cn":"就、就只是忍着吗？","status":"matched","hash_xxh64":"0x2F288C1D83607A47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1620123020:1":{"text":"还能怎么办？这个小家伙生前就天天吵得我睡不着觉，我活了那么多年都没找到解决方法。现在变成幽灵了，难道就能解决了？","source_cn":"还能怎么办？这个小家伙生前就天天吵得我睡不着觉，我活了...","status":"matched","hash_xxh64":"0x0816318577E901B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1620123021:1":{"text":"它从小就精力充沛，一到晚上就在房间里到处蹦蹦跳跳，还喜欢在我身上乱踩，怎么说都不听。我是拿它没办法了。","source_cn":"它从小就精力充沛，一到晚上就在房间里到处蹦蹦跳跳，还喜...","status":"matched","hash_xxh64":"0x54D42E3211C7A97B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1620123022:0":{"text":"唔……连魔法药剂也没有用吗？","source_cn":"唔……连魔法药剂也没有用吗？","status":"matched","hash_xxh64":"0xA7A207D6D08E5D5B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1620123023:1":{"text":"没有。你们能想过的方法我都试过。","source_cn":"没有。你们能想过的方法我都试过。","status":"matched","hash_xxh64":"0x6B76D16FC7488DC9","variant_status":"","male":"","female":"","variant_male_record_index":"","v