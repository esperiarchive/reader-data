{"asset_key":"timeline/quest_story_15232040","episode":"timeline","category":"quest_story","story_id":"15232040","schema_version":1,"lang":"cn","texts":{"cinematic_dialogue:3:1523203001:":{"text":"停战合约令呼临受制于兽人","source_cn":"停战合约令呼临受制于兽人","status":"matched","hash_xxh64":"0x3918308A2F661331","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1523203002:":{"text":"呼临怎可向野兽卑躬屈膝！","source_cn":"呼临怎可向野兽卑躬屈膝！","status":"matched","hash_xxh64":"0x02CCFA0743E71925","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1523203003:":{"text":"必须撕毁合约！","source_cn":"必须撕毁合约！","status":"matched","hash_xxh64":"0x0C89A67903D233B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1523203004:":{"text":"撕毁合约！撕毁合约！","source_cn":"撕毁合约！撕毁合约！","status":"matched","hash_xxh64":"0x2FD6AE42C71210F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1523203004:timeline_repeat_1":{"text":"撕毁合约！撕毁合约！","source_cn":"撕毁合约！撕毁合约！","status":"matched","hash_xxh64":"0x2FD6AE42C71210F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1523203005:":{"text":"奥勒留！","source_cn":"奥勒留！","status":"matched","hash_xxh64":"0xDD503AED5E4039AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1523204001:0":{"text":"奥勒留！你知道你在干什么吗！","source_cn":"奥勒留！你知道你在干什么吗！","status":"matched","hash_xxh64":"0xF12B91922A344942","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1523204002:1":{"text":"赫伦尼殿下许给你高官厚禄，是为了让你辅佐阿邦德殿下，为他出谋划策，而不是在这里反抗他的决断！","source_cn":"赫伦尼殿下许给你高官厚禄，是为了让你辅佐阿邦德殿下，为...","status":"matched","hash_xxh64":"0x9443E00F842CF72E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1523204003:1":{"text":"比博，你的脑袋里是什么时候灌满了泥浆？","source_cn":"比博，你的脑袋里是什么时候灌满了泥浆？","status":"matched","hash_xxh64":"0x121CEBC6E536ECD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1523204004:1":{"text":"领主殿下一意孤行，与兽人签下耻辱的合约，损害呼临的利益。我是在纠正他。","source_cn":"领主殿下一意孤行，与兽人签下耻辱的合约，损害呼临的利益...","status":"matched","hash_xxh64":"0xD7DE9836C8A5D23D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1523204005:1":{"text":"既然我一个人说他不听，那我就带上民众，让他听听整个呼临城的声音，让他明白那耻辱合约对呼临的危害。","source_cn":"既然我一个人说他不听，那我就带上民众，让他听听整个呼临...","status":"mat