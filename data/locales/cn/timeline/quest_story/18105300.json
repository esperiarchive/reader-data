{"asset_key":"timeline/quest_story_18105300","episode":"timeline","category":"quest_story","story_id":"18105300","schema_version":1,"lang":"cn","texts":{"cinematic_dialogue:2:1810529001:":{"text":"满月了！","source_cn":"满月了！","status":"matched_runtime_gender","hash_xxh64":"0x19603FBF8351D9CB","variant_status":"runtime_gender_keys_target_same","male":"满月了！","female":"满月了！","variant_male_record_index":"243563","variant_female_record_index":"243564","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529002:":{"text":"继续向前！","source_cn":"继续向前！","status":"matched","hash_xxh64":"0xF56535BB5DDA2CF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529003:":{"text":"不，来不及了！","source_cn":"不，来不及了！","status":"matched","hash_xxh64":"0x31CE9D57CF2DB9FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529005:":{"text":"瑟恩——！","source_cn":"瑟恩——！","status":"matched","hash_xxh64":"0x586998BAE6FBC283","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529004:":{"text":"你们先走，这里交给我！","source_cn":"你们先走，这里交给我！","status":"matched","hash_xxh64":"0x22DA5D5E44EECC09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529006:":{"text":"小心！","source_cn":"小心！<key:dialog88>","status":"matched","hash_xxh64":"0xEF2EBD9AE98AED27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529007:":{"text":"嗬啊啊啊……！","source_cn":"嗬啊啊啊……！","status":"matched","hash_xxh64":"0x9CE16E827A3EBFCD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1810530001:0":{"text":"瑟恩，你没事吧？","source_cn":"瑟恩，你没事吧？","status":"matched","hash_xxh64":"0x140905E08853DA5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1810530002:0":{"text":"没有受伤，不用担心。","source_cn":"没有受伤，不用担心。","status":"matched","hash_xxh64":"0xB0FFEB4E84A2917A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1810530003:0":{"text":"倒是巴登……你太鲁莽了，不拿武器就发起攻击，你想过后面要怎样应对吗？","source_cn":"倒是巴登……你太鲁莽了，不拿武器就发起攻击，你想过后面...","status":"matched","hash_xxh64":"0x76DFD44699969660","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1810530004:0":{"text":"你才是轻敌的那个人吧？明明看起来身经百战，为什么才一招就被制服了？","source_cn":"你才是轻敌的那个人吧？明明看起来身经百战，为什么才一招...","status":"matched","hash_xxh64":"0x91F05F3AD131E6B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1810530005:1":{"text":"……或许是我这几年一直忙于其他事务，疏于锻炼。","source_cn":"……或许是我这几年一直忙于其他事务，疏于锻炼。","status":"matched","hash_xxh64":"0x5E662BFC6E4121D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1810530006:1":{"text":"我也得承认，有些局面，独臂确实应对不来。","source_cn":"我也得承认，有些局面，独臂确实应对不来。","status":"matched","hash_xxh64":"0x45648D91914B0C25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1810530007:1":{"text":"哎……我不是想责怪你。","source_cn":"哎……我不是想责怪你。","status":"matched","hash_xxh64":"0x5AF1327B46598B71","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1810530008:1":{"text":"我只是想说——\n哎呀，我也不知道该怎么解释了。","source_cn":"我只是想说——\\n哎呀，我也不知道该怎么解释了。","status":"matched","hash_xxh64":"0x6415D852DA661DD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1810530009:1":{"text":"不必解释，我明白你的意思。","source_cn":"不必解释，我明白你的意思。","status":"matched","hash_xxh64":"0xA321B4E228369ED6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1810530010:0":{"text":"你能为保护他人挺身而出，足以证明，你还是我认识的那个巴登。","source_cn":"你能为保护他人挺身而出，足以证明，你还是我认识的那个巴登。","status":"matched","hash_xxh64":"0x9D4CCFDD4FE7FFAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1810530011:0":{"text":"我不喜欢听到这些话，但……也许你说的有那么一点可能是真的。","source_cn":"我不喜欢听到这些话，但……也许你说的有那么一点可能是真的。","status":"matched","hash_xxh64":"0xFCF83BB7A566546D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1810530012:0":{"text":"真的？你愿意相信我和瑟恩说的话了？","source_cn":"真的？你愿意相信我和瑟恩说的话了？","status":"matched","hash_xxh64":"0x8476F56D189DFFB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1810530013:1":{"text":"只是有一点相信，毕竟下意识的反应没办法骗人。","source_cn":"只是有一点相信，毕竟下意识的反应没办法骗人。","status":"matched","hash_xxh64":"0xF693032A6590070E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1810530014:1":{"text":"以我和你、和<style=\"stress\"><player_name></style>的交情还说得过去，但瑟恩嘛……","source_cn":"以我和你、和<style=stress><player...","status":"matched_runtime_gender","hash_xxh64":"0xA43486DE9FA7D184","variant_status":"runtime_gender_keys_target_same","male":"以我和你、和<style=\"stress\"><player_name></style>的交情还说得过去，但瑟恩嘛……","female":"以我和你、和<style=\"stress\"><player_name></style>的交情还说得过去，但瑟恩嘛……","variant_male_record_index":"243581","variant_female_rec