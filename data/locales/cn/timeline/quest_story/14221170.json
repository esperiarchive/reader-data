{"asset_key":"timeline/quest_story_14221170","episode":"timeline","category":"quest_story","story_id":"14221170","schema_version":1,"lang":"cn","texts":{"cinematic_dialogue:2:1422116001:":{"text":"那是……艾莎？！","source_cn":"那是……艾莎？！","status":"matched","hash_xxh64":"0x7BBDC150C4A8087D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1422116002:":{"text":"让开！洛尔迪！她已经孽化了！","source_cn":"让开！洛尔迪！她已经孽化了！","status":"matched","hash_xxh64":"0xD684F8A4A8A09E30","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1422116003:":{"text":"我不允许任何人再伤害她！","source_cn":"我不允许任何人再伤害她！","status":"matched","hash_xxh64":"0x236ED17800A850DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1422117001:1":{"text":"其实我知道，一切都已经无济于事了，我也马上就要……","source_cn":"其实我知道，一切都已经无济于事了，我也马上就要……","status":"matched","hash_xxh64":"0x4EC212159D1C97ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1422117002:1":{"text":"请你们帮我和她解脱吧……","source_cn":"请你们帮我和她解脱吧……","status":"matched","hash_xxh64":"0x68EA082A62560F8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1422117003:1":{"text":"我的意识已经开始模糊不清了，我现在只能记得……","source_cn":"我的意识已经开始模糊不清了，我现在只能记得……","status":"matched","hash_xxh64":"0xF871FC47D768476A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1422117004:0":{"text":"只能记得那时艾莎对我说过的话……","source_cn":"只能记得那时艾莎对我说过的话……","status":"matched","hash_xxh64":"0xBC0BAE7B35932292","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1422117005:1":{"text":"洛尔迪，我答应你，我愿意成为你的爱人！","source_cn":"洛尔迪，我答应你，我愿意成为你的爱人！","status":"matched","hash_xxh64":"0x6A201C17C184C41B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1422117006:0":{"text":"艾莎……！你真的愿意？！你不介意那些阻挡着我们的东西了吗？","source_cn":"艾莎……！你真的愿意？！你不介意那些阻挡着我们的东西了吗？","status":"matched","hash_xxh64":"0xFC07CDFB1C3E5ACF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1422117007:1":{"text":"……介意，但是我知道，我们都要诚实地面对自己！","source_cn":"……介意，但是我知道，我们都要诚实地面对自己！","status":"matched","hash_xxh64":"0x1D6FBB4BD3D7B746","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1422117008:1":{"text":"以戒指为证，我们永不遗忘，永不逃避，永不背叛……","source_cn":"以戒指为证，我们永不遗忘，永不逃避，永不背叛……","status":"matched","hash_xxh64":"0x01C2B519B80872B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1422117009:0":{"text":"永不遗忘，永不逃避，永不背叛……","source_cn":"永不遗忘，永不逃避，永不背叛……","status":"matched","hash_xxh64":"0x48D8F348973EE672","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1422117010:1":{"text":"求你们了，趁我还能记得这些，结束我和她的痛苦吧！","source_cn":"求你们了，趁我还能记得这些，结束我和她的痛苦吧！","status":"matched","hash_xxh64":"0xE58FB9D3539EAECC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1422117011:1":{"text":"如果能重来，我希望我们从未相遇，这样我就不会给她带来那么多不幸……","source_cn":"如果能重来，我希望我们从未相遇，这样我就不会给她带来那...","status":"matched","hash_xxh64":"0x6AB92DBEABF43415","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:22:1422116001:":{"text":"那是……艾莎？！","source_cn":"那是……艾莎？！","status":"matched","hash_xxh64":"0x7BBDC150C4A8087D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:22:1422116002:":{"text":"让开！洛尔迪！她已经孽化了！","source_cn":"让开！洛尔迪！她已经孽化了！","status":"matched","hash_xxh64":"0xD684F8A4A8A09E30","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_