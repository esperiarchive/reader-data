{"asset_key":"timeline/quest_story_15109120","episode":"timeline","category":"quest_story","story_id":"15109120","schema_version":1,"lang":"cn","texts":{"cinematic_dialogue:3:1510911001:":{"text":"撤军！这是我的命令！","source_cn":"撤军！这是我的命令！","status":"matched","hash_xxh64":"0x26089FDD432643EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510911002:":{"text":"绝对不行！","source_cn":"绝对不行！","status":"matched","hash_xxh64":"0xBB07BBDAA42906FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510913001:":{"text":"那里不是你该在的地方，珀尔修斯！","source_cn":"那里不是你该在的地方，珀尔修斯！","status":"matched","hash_xxh64":"0xA9C618C262668C88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510913002:":{"text":"回到我身边！","source_cn":"回到我身边！","status":"matched","hash_xxh64":"0x2B63862048C5DE78","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510913003:":{"text":"珀尔修斯……","source_cn":"珀尔修斯……<key:dialog2>","status":"matched","hash_xxh64":"0x12F006BC5B32996E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510913004: