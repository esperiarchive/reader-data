{"asset_key":"timeline/quest_story_12113140","episode":"timeline","category":"quest_story","story_id":"12113140","schema_version":1,"lang":"cn","texts":{"say:4:1211314001:0":{"text":"等等！都别动，压低音量。","source_cn":"等等！都别动，压低音量。","status":"matched","hash_xxh64":"0x4ACFCF56938A27D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211314002:0":{"text":"怎、怎么了？","source_cn":"怎、怎么了？","status":"matched","hash_xxh64":"0x51AED6CA3314762F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211314003:0":{"text":"嘘，前面的营地里有声音。","source_cn":"嘘，前面的营地里有声音。","status":"matched_runtime_gender","hash_xxh64":"0x2995681645FA6CCC","variant_status":"runtime_gender_keys_target_same","male":"嘘，前面的营地里有声音。","female":"嘘，前面的营地里有声音。","variant_male_record_index":"128902","variant_female_record_index":"128903","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1211315001:0":{"text":"情况紧急，你还在这里慢条斯理地搞什么研究？！","source_cn":"情况紧急，你还在这里慢条斯理地搞什么研究？！","status":"matched","hash_xxh64":"0x466458B1A3993C96","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1211315002:0":{"text":"亲爱的波妮，为什么不呢？","source_cn":"亲爱的波妮，为什么不呢？","status":"matched","hash_xxh64":"0x4E93CD6C1D9425EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_st