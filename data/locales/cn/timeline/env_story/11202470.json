{"asset_key":"timeline/env_story_11202470","episode":"timeline","category":"env_story","story_id":"11202470","schema_version":1,"lang":"cn","texts":{"cinematic_dialogue:2:1120246001:":{"text":"……是我输了。","source_cn":"……是我输了。","status":"matched","hash_xxh64":"0xDA3479F6127078C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120246002:":{"text":"库金，你比我想象中的还要强大","source_cn":"库金，你比我想象中的还要强大","status":"matched","hash_xxh64":"0x1FCC253EE9C3405D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120246003:":{"text":"好几次，你的攻击都让我感到心惊","source_cn":"好几次，你的攻击都让我感到心惊","status":"matched","hash_xxh64":"0x6B8073A71E4049BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120246004:":{"text":"但我还是输了，我接受这个结果","source_cn":"但我还是输了，我接受这个结果","status":"matched","hash_xxh64":"0x4589712C20F7D224","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120247001:1":{"text":"克鲁格，我的叔叔，我相信你是那个能带领黑嚎氏族走上巅峰的人。","source_cn":"克鲁格，我的叔叔，我相信你是那个能带领黑嚎氏族走上巅峰的人。","status":"matched","hash_xxh64":"0xB3E4AA835B8F41BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_st