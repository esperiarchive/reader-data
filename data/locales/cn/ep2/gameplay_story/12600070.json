xF918B12F18F358BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1260007012:0":{"text":"我也不记得！","source_cn":"我也不记得！","status":"matched","hash_xxh64":"0x0972CA25911D34E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1260007013:1":{"text":"……你们都清醒清醒，我有话要问。","source_cn":"……你们都清醒清醒，我有话要问。","status":"matched","hash_xxh64":"0x310B2CBA0A777DB6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1260007014:1":{"text":"达里洛，你们在变成怪物之前，有没有见过一个亡灵女性。","source_cn":"达里洛，你们在变成怪物之前，有没有见过一个亡灵女性。","status":"matched","hash_xxh64":"0xF99A385D30B2C2AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1260007015:1":{"text":"什、什么，她是亡灵？！","source_cn":"什、什么，她是亡灵？！","status":"matched","hash_xxh64":"0x495CDC946B4DBAFC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1260007016:0":{"text":"是亡灵吗？我不确定……当时暴熊和山猫大哥在商量怎么找水鬼帮麻烦，我远远看到了，想和他们打个招呼。","source_cn":"是亡灵吗？我不确定……当时暴熊和山猫大哥在商量怎么找水...","status":"matched","hash_xxh64":"0xDBC6346D5F3EBDA5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1260007017:0":{"text":"在他们身后不远处，我瞧见一个非常漂亮的妹子——黑衣黑裙，夜空一样的长发！","source_cn":"在他们身后不远处，我瞧见一个非常漂亮的妹子——黑衣黑裙...","status":"matched","hash_xxh64":"0x1B49FBCA686E6997","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1260007018:1":{"text":"………哦？是本地主人的部下吧？昨天似乎看到过你们。","source_cn":"………哦？是本地主人的部下吧？昨天似乎看到过你们。","status":"matched","hash_xxh64":"0x7930658162BD75FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1260007019:1":{"text":"虽然是些粗野的家伙，但是这份活力和热血倒是颇有趣味……","source_cn":"虽然是些粗野的家伙，但是这份活力和热血倒是颇有趣味……","status":"matched","hash_xxh64":"0x698DFFF6E999D15B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1260007020:0":{"text":"那么，为我演出吧。","source_cn":"那么，为我演出吧。","status":"matched","hash_xxh64":"0xE64A06BF928BBA92","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1260007021:0":{"text":"她非常突兀地出现在我们面前，说了些莫名其妙的话，但，我那时脑子突然都不转了，只知道看着她。","source_cn":"她非常突兀地出现在我们面前，说了些莫名其妙的话，但，我...","status":"matched","hash_xxh64":"0x5CDD9F6D02D29185","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1260007022:1":{"text":"当时两位大哥也僵住了，直勾勾地盯着她，都忘记了要干什么！","source_cn":"当时两位大哥也僵住了，直勾勾地盯着她，都忘记了要干什么！","status":"matched","hash_xxh64":"0xDE59B6E1194565A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1260007023:0":{"text":"是、是啊，明明回想起来，她的肤色和眼睛都很异常……可那会儿我完全没感觉到不对劲。","source_cn":"是、是啊，明明回想起来，她的肤色和眼睛都很异常……可那...","status":"matched","hash_xxh64":"0xC58AA3DEFF9EA85D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1260007024:0":{"text":"只是觉得非常漂亮，而且很有威严，甚至忍不住想对她行礼……","source_cn":"只是觉得非常漂亮，而且很有威严，甚至忍不住想对她行礼……","status":"matched","hash_xxh64":"0x26F63DE077A20EFC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1260007025:0":{"text":"我也差一点就……但紧接着，我就失去意识了。","source_cn":"我也差一点就……但紧接着，我就失去意识了。","status":"matched","hash_xxh64":"0xAA6C303678C92230","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1260007026:0":{"text":"……听起来是她，那个叫瑟西娅的亡灵。","source_cn":"……听起来是她，那个叫瑟西娅的亡灵。","status":"matched","hash_xxh64":"0x3A3C9C6639964869","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:49:1260007027:1":{"text":"随即，出乎所有人意料，索尼娅对着眼前的受害者们致歉——既对血薇帮，也对水鬼帮。","source_cn"