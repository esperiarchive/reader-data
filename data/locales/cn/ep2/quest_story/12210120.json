{"asset_key":"ep2/quest_story_12210120","episode":"ep2","category":"quest_story","story_id":"12210120","schema_version":1,"lang":"cn","texts":{"say:1:1221012001:1":{"text":"呃啊……这、这是哪？我还活着吗……","source_cn":"呃啊……这、这是哪？我还活着吗……","status":"matched","hash_xxh64":"0xE903AA5E3C32122E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1221012002:1":{"text":"醒了！醒了！","source_cn":"醒了！醒了！","status":"matched","hash_xxh64":"0x006314EF73608A6D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1221012003:1":{"text":"会……会说话的植物！我一定在做梦……难道我已经……","source_cn":"会……会说话的植物！我一定在做梦……难道我已经……","status":"matched","hash_xxh64":"0x10BCD33529FA3E67","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1221012004:1":{"text":"别紧张！你已经没事了，连身上的伤都好了！","source_cn":"别紧张！你已经没事了，连身上的伤都好了！","status":"matched","hash_xxh64":"0x8495D6732B7C72AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1221012005:1":{"text":"是这些荧荧花救了你，所以你不用害怕它们！","source_cn":"是这些荧荧花救了你，所以你不用害怕它们！","status":"matched","hash_xxh64":"0x10A7A058B9420DAA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1221012006:1":{"text":"它们救了我…