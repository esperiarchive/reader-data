{"asset_key":"ep2/quest_story_12105290","episode":"ep2","category":"quest_story","story_id":"12105290","schema_version":1,"lang":"cn","texts":{"say:3:1210529001:1":{"text":"咳、咳咳咳！","source_cn":"咳、咳咳咳！","status":"matched","hash_xxh64":"0x2551F5F917AAF195","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1210529002:1":{"text":"你输了。","source_cn":"你输了。","status":"matched","hash_xxh64":"0x3E54565BD0AFA7FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210529003:1":{"text":"索尼娅，你要杀了我吗？","source_cn":"索尼娅，你要杀了我吗？","status":"matched","hash_xxh64":"0x757508617C25ACE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210529004:1":{"text":"……","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210529005:1":{"text":"我是你的“父亲”……当年，如果不是我把你救起，你早就死在了海难里，和你的妹妹一样。","source_cn":"我是你的“父亲”……当年，如果不是我把你救起，你早就死...","status":"matched","hash_xxh64":"0xC73C622C1756AC0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1210529006:1":{"text":"我知道。","source_cn":"我知道。","status":"matched","hash_xxh64":"0xB188B8685FB0426C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1210529007:1":{"text":"我把你当亲生孩子一样养大，教你剑术，让你上学……甚至还把血薇帮交给你，你如果连我都要清算，就会永远失去人心。","source_cn":"我把你当亲生孩子一样养大，教你剑术，让你上学……甚至还...","status":"matched","hash_xxh64":"0x27E2299C450B3A00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210529008:1":{"text":"还记得吗？我把血薇别在你胸口，告诉所有人，你就是我的“孩子”，你也承诺，永远忠诚于我。","source_cn":"还记得吗？我把血薇别在你胸口，告诉所有人，你就是我的“...","status":"matched","hash_xxh64":"0xCF275628B24D43C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210529009:1":{"text":"没忘。","source_cn":"没忘。","status":"matched","hash_xxh64":"0x663CF830BBC86C2A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210529010:1":{"text":"我的……我的孩子。你不可能杀我，你也杀不了我。认命吧。","source_cn":"我的……我的孩子。你不可能杀我，你也杀不了我。认命吧。","status":"matched","hash_xxh64":"0x75297F6DEC6B6F59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1210529011:1":{"text":"父亲……","source_cn":"父亲……","status":"matched","hash_xxh64":"0x968A077B58AA7863","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1210529012:1":{"text":"不是吧，索尼娅，你吃这套？","source_cn":"不是吧，索尼娅，你吃这套？","status":"matched","hash_xxh64":"0xCDC002211A1692C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1210529013:1":{"text":"你相信泰西欧当你是亲人？还是信我和卢卡是失散多年的亲兄弟？","source_cn":"你相信泰西欧当你是亲人？还是信我和卢卡是失散多年的亲兄弟？","status":"matched","hash_xxh64":"0x4D71ECC3716F0A22","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1210529014:1":{"text":"谁是你兄弟？","source_cn":"谁是你兄弟？","status":"matched","hash_xxh64":"0xD9C8A0111D692ABF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1210529015:1":{"text":"真啰嗦。卢卡，铐上他。","source_cn":"真啰嗦。卢卡，铐上他。","status":"matched","hash_xxh64":"0x0F24B98342068D10","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1210529016:1":{"text":"是。","source_cn":"是。","status":"matched","hash_xxh64":"0x46CC2E142C5C636F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1210529017:0":{"text":"——你？！索尼娅？！你竟然让手下碰我？！","source_cn":"——你？！索尼娅？！你竟然让手下碰我？！","status":"matched","hash_xxh64":"0x00F4F67716672BD6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1210529018:1":{"text":"原来是给这老东西上铐？哈哈哈哈！","source_cn":"原来是给这老东西上铐？哈哈哈哈！","status":"matched","hash_xxh64":"0xA08EF50BC5EE6E59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1210529019:1":{"text":"父亲大人，你真的老了，变唠叨了，而且眼神也不好。","source_cn":"父亲大人，你真的老了，变唠叨了，而且眼神也不好。","status":"matched","hash_xxh64":"0x935603B770632451","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1210529020:1":{"text":"看清楚！我，索尼娅，不是谁的孩子。","source_cn":"看清楚！我，索尼娅，不是谁的孩子。","status":"matched","hash_xxh64":"0x66226F16D0C1C266","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1210529021:1":{"text":"我是血薇帮的老大——在你死后。","source_cn":"我是血薇帮的老大——在你死后。","status":"matched","hash_xxh64":"0xC141A8564ECD59D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1210529022:1":{"text":"你竟敢——","source_cn":"你竟敢——","status":"matched","hash_xxh64":"0xC734E413241FCCDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1210529023:1":{"text":"当年，锈锚港海盗横行，很多人想离开锈锚港。","source_cn":"当年，锈锚港海盗横行，很多人想离开锈锚港。","status":"matched","hash_xxh64":"0x700E431B9AF9A52C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1210529024:1":{"text":"于是你策划了一场海难，你让人磨断了桅杆，船舱里绑了炸药。故意让人落难，好让血薇帮成为他们的拯救者。","source_cn":"于是你策划了一场海难，你让人磨断了桅杆，船舱里绑了炸药...","status":"matched","hash_xxh64":"0x35DCCEBBD6E771AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1210529025:1":{"text":"果然……海难后，血薇帮的人望迅速攀升，大家都尊称你为教父。","source_cn":"果然……海难后，血薇帮的人望迅速攀升，大家都尊称你为教父。","status":"matched","hash_xxh64":"0x67AAE50BF54CC9AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1210529026:1":{"text":"奇怪我怎么知道的？","source_cn":"奇怪我怎么知道的？","status":"matched","hash_xxh64":"0x2D3F7E586E3F8348","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1210529027:1":{"text":"别忘了，你把我教的很好。","source_cn":"别忘了，你把我教的很好。","status":"matched","hash_xxh64":"0xD8F6B7ABB8AEA235","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1210529028:1":{"text":"这有什么，我给了他们新的生命……我就是他们的救世主。","source_cn":"这有什么，我给了他们新的生命……我就是他们的救世主。","status":"matched","hash_xxh64":"0x8C70FD60C0DFF760","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1210529029:1":{"text":"所有人都应该知道，救世主的帮助不是无偿的。","source_cn":"所有人都应该知道，救世主的帮助不是无偿的。","status":"matched","hash_xxh64":"0x0A7E8F9F3237A713","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1210529030:1":{"text":"救世主犯下罪孽也是要偿还的。","source_cn":"救世主犯下罪孽也是要偿还的。","status":"matched","hash_xxh64":"0x7FE2EA5EF02A565C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1210529031:1":{"text":"我用鲜血哺育血薇帮，有什么错呢？花要想开的好，沾血的肥料最佳。","source_cn":"我用鲜血哺育血薇帮，有什么错呢？花要想开的好，沾血的肥...","status":"matched","hash_xxh64":"0xB3A0B0C41AD4DC46","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1210529032:1":{"text":"别狡辩了，你会迎来审判。","source_cn":"别狡辩了，你会迎来审判。","status":"matched","hash_xxh64":"0xB3B2FB44EBA8536B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1210529033:1":{"text":"……审判？","source_cn":"……审判？","status":"matched","hash_xxh64":"0x3AA401EDA8F4FE0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1210529034:1":{"text":"还不到时候！","source_cn":"还不到时候！","status":"matched","hash_xxh64":"0xDEAAE898129BCA93","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:泰西欧":{"text":"泰西欧","source":"泰西欧","status":"source"},"speaker:索尼娅":{"text":"索尼娅","source":"索尼娅","status":"source"},"speaker:辛巴达":{"text":"辛巴达","source":"辛巴达","status":"source"},"speaker:卢卡":{"text":"卢卡","source":"卢卡","status":"source"}},"stats":{"flow_row_count":35,"localized_text_count":34,"speaker_count":4}}