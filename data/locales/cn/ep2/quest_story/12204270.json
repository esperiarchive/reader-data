的，她才是真正的心思细腻，比我更有洞察力。","source_cn":"这都是从索尼娅那里学到的，她才是真正的心思细腻，比我更...","status":"matched","hash_xxh64":"0xB049C14211685557","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1220427007:1":{"text":"上吧！再不把温蒂小姐救出来，斯坦顿就要急坏了！","source_cn":"上吧！再不把温蒂小姐救出来，斯坦顿就要急坏了！","status":"matched","hash_xxh64":"0x0577D836294B2659","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢卡":{"text":"卢卡","source":"卢卡","status":"source"},"speaker:血薇帮暗哨":{"text":"血薇帮暗哨","source":"血薇帮暗哨","status":"source"},"speaker:漫漫":{"text":"漫漫","source":"漫漫","status":"source"},"speaker:满满":{"text":"满满","source":"满满","status":"source"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":4}}