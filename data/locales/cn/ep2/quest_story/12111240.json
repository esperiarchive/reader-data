ument_title_status":""},"say:16:1211124011:0":{"text":"为什么奈拉没有资格？","source_cn":"为什么奈拉没有资格？","status":"matched","hash_xxh64":"0xDC0BD653313AB07B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1211124012:0":{"text":"提问之前，先拿走你们的奖品吧。","source_cn":"提问之前，先拿走你们的奖品吧。","status":"matched","hash_xxh64":"0x9666F27478398FFC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1211124013:0":{"text":"来吧，索尼娅，告诉我，你的梦寐之物是什么？","source_cn":"来吧，索尼娅，告诉我，你的梦寐之物是什么？","status":"matched","hash_xxh64":"0x3A78B255691BC1FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1211124014:0":{"text":"此时此刻你的眼中，看到了什么？","source_cn":"此时此刻你的眼中，看到了什么？","status":"matched","hash_xxh64":"0xC7BC07621CDC88BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1211124015:0":{"text":"你是说……这柄血蔷薇权杖？和……","source_cn":"你是说……这柄血蔷薇权杖？和……","status":"matched","hash_xxh64":"0xA7987761B8950CE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1211124016:0":{"text":"和什么呢？你的宝藏，只有你自己能看到哦。","source_cn":"和什么呢？你的宝藏，只有你自己能看到哦。","status":"matched","hash_xxh64":"0x2D344C17E92F77C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1211124017:0":{"text":"另一个，是奈拉的蝴蝶结和她折的纸船……","source_cn":"另一个，是奈拉的蝴蝶结和她折的纸船……","status":"matched","hash_xxh64":"0x72D701791C617C52","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1211124018:0":{"text":"很难抉择吗？直到现在，你都在纠结应该怎么选？","source_cn":"很难抉择吗？直到现在，你都在纠结应该怎么选？","status":"matched","hash_xxh64":"0xE4DCDCE88C767D1F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1211124019:0":{"text":"不是的……","source_cn":"不是的……","status":"matched","hash_xxh64":"0x1047DD05087B3BEE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1211124020:0":{"text":"可不能贪心哦，我不能全都给你，只能给你最想要的那一个。","source_cn":"可不能贪心哦，我不能全都给你，只能给你最想要的那一个。","status":"matched","hash_xxh64":"0x191EC3AEF4535CF4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1211124021:0":{"text":"……不必了。我的人生，不会因为在这里做出选择而有所改变。","source_cn":"……不必了。我的人生，不会因为在这里做出选择而有所改变。","status":"matched","hash_xxh64":"0x5C6066A36F3450CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1211124022:0":{"text":"我要带奈拉回锈锚港，赶走死潮舰队。无论怎么选，都不会影响我接下来要做的事。","source_cn":"我要带奈拉回锈锚港，赶走死潮舰队。无论怎么选，都不会影...","status":"matched","hash_xxh64":"0x5DBCD3E7BBBB09B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1211124023:0":{"text":"有意思……第一次碰到愿意放弃宝藏的人。","source_cn":"有意思……第一次碰到愿意放弃宝藏的人。","status":"matched","hash_xxh64":"0x86968592E3C73DDD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1211124024:0":{"text":"我不会强迫你，既然你已经做出了你的选择，祝你好运。","source_cn":"我不会强迫你，既然你已经做出了你的选择，祝你好运。","status":"matched","hash_xxh64":"0xD95ACFC50B8D5AFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1211124025:0":{"text":"但你毕竟完成了试炼，要是需要的话，就把我脚下这箱金子拿去吧。","source_cn":"但你毕竟完成了试炼，要是需要的话，就把我脚下这箱金子拿去吧。","status":"matched","hash_xxh64":"0x5C3D40DC4219755F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1211124026:0":{"text":"那么，接下来，到你了——辛巴达！","source_cn":"那么，接下来，到你了——辛巴达！","status":"matched","hash_xxh64":"0xCE5E6AF5C48870A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1211124027:0":{"text":"好紧张……不知道会得到什么样的宝物。","s