{"asset_key":"ep2/quest_story_12204440","episode":"ep2","category":"quest_story","story_id":"12204440","schema_version":1,"lang":"cn","texts":{"say:3:1220444001:0":{"text":"臭小子，敢骗我们，胆子真不小啊！","source_cn":"臭小子，敢骗我们，胆子真不小啊！","status":"matched","hash_xxh64":"0x0E72465C03CEE4EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220444002:0":{"text":"我……我根本就没答应过你们！","source_cn":"我……我根本就没答应过你们！","status":"matched","hash_xxh64":"0xB43224C51E3417DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1220444003:0":{"text":"你敢得罪大老板？在锈锚港，惹了大老板的人，都得被丢进海里喂鲨鱼！","source_cn":"你敢得罪大老板？在锈锚港，惹了大老板的人，都得被丢进海...","status":"matched","hash_xxh64":"0xE459E9303874457A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1220444004:0":{"text":"我还真不知道，锈锚港的鲨鱼伙食这么好啊。","source_cn":"我还真不知道，锈锚港的鲨鱼伙食这么好啊。","status":"matched","hash_xxh64":"0xD2C883AC9A55CFA5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1220444005:0":{"text":"卢卡？你……你、你想干什么！这事可跟血薇帮没关系！","source_cn":"卢卡？你……你、你想干什么！这事可跟血薇帮没关系！","status":"matched","hash_xxh64":"0x44F2F093AD40459F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}