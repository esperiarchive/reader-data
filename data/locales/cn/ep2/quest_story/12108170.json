{"asset_key":"ep2/quest_story_12108170","episode":"ep2","category":"quest_story","story_id":"12108170","schema_version":1,"lang":"cn","texts":{"say:3:1210817001:1":{"text":"找到了，瀑布汇流的地方！","source_cn":"找到了，瀑布汇流的地方！","status":"matched","hash_xxh64":"0xE3EB3F07EB4C4EEE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1210817002:0":{"text":"壮观，我第一次见到这么大的瀑布。","source_cn":"壮观，我第一次见到这么大的瀑布。","status":"matched","hash_xxh64":"0x796FF4E31C7A0184","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210817003:0":{"text":"简直……和民谣中记载的一模一样——四瀑汇流而下！","source_cn":"简直……和民谣中记载的一模一样——四瀑汇流而下！","status":"matched","hash_xxh64":"0xF0FBD9BB5CB90E3B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210817004:0":{"text":"那么，按民谣的下半句，瀑布下面应该有宝藏？","source_cn":"那么，按民谣的下半句，瀑布下面应该有宝藏？","status":"matched","hash_xxh64":"0x59B718D30BF337DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1210817005:1":{"text":"但是这里只有瀑布，没有大漩涡啊。更不用说宝藏和光了……","source_cn":"但是这里只有瀑布，没有大漩涡啊。更不用说宝藏和光了……","status":"matched","hash_xxh64":"0x0E2EF01E1EBDF185","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1210817006:1":{"text":"那是因为漩涡就是通往宝藏的门。要看到门，还需要钥匙！想要拿到钥匙，就要通过试炼！","source_cn":"那是因为漩涡就是通往宝藏的门。要看到门，还需要钥匙！想...","status":"matched","hash_xxh64":"0x48F5ADE41592E153","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210817007:1":{"text":"辛巴达怎么懂这么多？","source_cn":"辛巴达怎么懂这么多？","status":"matched","hash_xxh64":"0xEEB79182F32CE98F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210817008:1":{"text":"冒险故事里都是这么写的。","source_cn":"冒险故事里都是这么写的。","status":"matched","hash_xxh64":"0x353D3F268868EB63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210817009:1":{"text":"姐姐！前面！那里有块石碑，上面好像有字！","source_cn":"姐姐！前面！那里有块石碑，上面好像有字！","status":"matched","hash_xxh64":"0x8E52A3478476E4FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1210817010:1":{"text":"什么？","source_cn":"什么？","status":"matched","hash_xxh64":"0x52B79F244F93B82C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"辛巴达","source":"辛巴达","status":"source"},"speaker:索尼娅":{"text":"索尼娅","source":"索尼娅","status":"source"},"speaker:漫漫":{"text":"漫漫","source":"漫漫","status":"source"},"speake