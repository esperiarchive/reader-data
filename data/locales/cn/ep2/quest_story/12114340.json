{"asset_key":"ep2/quest_story_12114340","episode":"ep2","category":"quest_story","story_id":"12114340","schema_version":1,"lang":"cn","texts":{"picture:0::1":{"text":"魔法通讯器","source_cn":"魔法通讯器","status":"matched","hash_xxh64":"0x947F19C1A7611A38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:0:1211434015:2":{"text":"呼金的声音突然从通讯器中传来……","source_cn":"呼金的声音突然从通讯器中传来……","status":"matched","hash_xxh64":"0x4C8726C4EA7C68FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211434001:0":{"text":"你们到了？谁能给我详细描述一下那大炮的样子？","source_cn":"你们到了？谁能给我详细描述一下那大炮的样子？","status":"matched","hash_xxh64":"0x5DB858AF736DD8F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1211434002:0":{"text":"呃……炮不都长得差不多吗？它的上面有一块铁板，屁股是尖的——","source_cn":"呃……炮不都长得差不多吗？它的上面有一块铁板，屁股是尖的——","status":"matched","hash_xxh64":"0xBA48CF97D69A2A9D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1211434003:0":{"text":"屁股是尖的？错不了！那是我造的炮！","source_cn":"屁股是尖的？错不了！那是我造的炮！","status":"matched","hash_xxh64":"0xDE840AD57A360D40","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1211434004:0":{"text":"准确来说，是