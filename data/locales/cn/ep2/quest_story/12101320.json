。","status":"matched","hash_xxh64":"0x84A588628A4C4B39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1210132007:0":{"text":"又是你，说，这群人什么来头？","source_cn":"又是你，说，这群人什么来头？","status":"matched","hash_xxh64":"0xC67BCA16596CB3D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1210132008:0":{"text":"海边捡来的。你瞧这个……","source_cn":"海边捡来的。你瞧这个……","status":"matched","hash_xxh64":"0xEC4715218981C9E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210132009:0":{"text":"……行啊，你小子！这活老子接了。","source_cn":"……行啊，你小子！这活老子接了。","status":"matched","hash_xxh64":"0x8C08DD878B58263E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1210132010:0":{"text":"那就麻烦你，<style=\"highlight\">好好照顾这群朋友</style>！","source_cn":"那就麻烦你，<style=highlight>好好照顾...","status":"matched","hash_xxh64":"0x5F9D2FB13BBBC790","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1210132011:0":{"text":"刚好厨房做好了饭，你们先吃吧。","source_cn":"刚好厨房做好了饭，你们先吃吧。","status":"matched","hash_xxh64":"0xDC9F3B483F57F876","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"",