{"asset_key":"ep2/quest_story_12114170","episode":"ep2","category":"quest_story","story_id":"12114170","schema_version":1,"lang":"cn","texts":{"say:3:1211417001:1":{"text":"辛巴达，你手上拿着什么？","source_cn":"辛巴达，你手上拿着什么？","status":"matched","hash_xxh64":"0xCE991A425D499922","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211417002:1":{"text":"一张什么都没写的白纸。","source_cn":"一张什么都没写的白纸。","status":"matched","hash_xxh64":"0xDB7F8303F5FB59D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:5::0":{"text":"空白的纸","source_cn":"空白的纸","status":"matched","hash_xxh64":"0x52406B157CD0D2C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211417003:1":{"text":"这……有用吗？","source_cn":"这……有用吗？","status":"matched","hash_xxh64":"0x30DCDF2CE0BA1463","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211417004:1":{"text":"当然没用。但是除此之外，我还找到了这个！","source_cn":"当然没用。但是除此之外，我还找到了这个！","status":"matched","hash_xxh64":"0xDCDDD3BA438972C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:8::0":{"text":"龙息柱","source_cn":"龙息柱","status":"matched","hash_xxh64":"0x945D34543A100365","variant_s