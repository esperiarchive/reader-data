{"asset_key":"ep2/quest_story_12111010","episode":"ep2","category":"quest_story","story_id":"12111010","schema_version":1,"lang":"cn","texts":{"say:3:1211101001:0":{"text":"辛巴达，怎么不往前走了？","source_cn":"辛巴达，怎么不往前走了？","status":"matched","hash_xxh64":"0x6478A3036D1330C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211101002:0":{"text":"好浓的雾啊……要不，咱们还是晚点再出海吧？","source_cn":"好浓的雾啊……要不，咱们还是晚点再出海吧？","status":"matched","hash_xxh64":"0x0BB13B96823DC12A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211101003:0":{"text":"与锈锚港附近的浓雾相比，这里的天气不算恶劣。","source_cn":"与锈锚港附近的浓雾相比，这里的天气不算恶劣。","status":"matched","hash_xxh64":"0x7259B85DCD58A685","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211101004:0":{"text":"我、我知道……但我的意思是，都到这一步了，小心驶得万年船嘛。","source_cn":"我、我知道……但我的意思是，都到这一步了，小心驶得万年船嘛。","status":"matched","hash_xxh64":"0xFA0E6EBC2A399F80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211101005:0":{"text":"你害怕了？","source_cn":"你害怕了？","status":"matched","hash_xxh64":"0x31C39BB52794D29C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1211101006:0":{"text":"我可没有。","source_cn":"我可没有。","status":"matched","hash_xxh64":"0x0EFF3C4A87FCE4E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1211101007:0":{"text":"可你的手在发抖。","source_cn":"可你的手在发抖。","status":"matched","hash_xxh64":"0x90C270B1C24429FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1211101008:0":{"text":"这都怕？辛巴达是胆小鬼！","source_cn":"这都怕？辛巴达是胆小鬼！","status":"matched","hash_xxh64":"0xDE0890EFD8AB86E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1211101009:0":{"text":"辛巴达，你来掌舵，我给你当副手。","source_cn":"辛巴达，你来掌舵，我给你当副手。","status":"matched","hash_xxh64":"0x4AB0EC12CC3F533A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1211101010:0":{"text":"你要当副手？","source_cn":"你要当副手？","status":"matched","hash_xxh64":"0xF4DB32BA824C780E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1211101011:0":{"text":"是啊，如果航行中遇到了敌人，我来应付。","source_cn":"是啊，如果航行中遇到了敌人，我来应付。","status":"matched","hash_xxh64":"0x3C21C7FE7B2C98B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1211101012:0":{"text":"我的意思是……你竟然愿意给我当副手。","source_cn":"我的意思是……你竟然愿意给我当副手。","status":"matched","hash_xxh64":"0x54F82658DB72F2DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1211101013:0":{"text":"别想太多了。我只是心血来潮，想陪你玩玩扮演船长的游戏。","source_cn":"别想太多了。我只是心血来潮，想陪你玩玩扮演船长的游戏。","status":"matched","hash_xxh64":"0xD11A7230E75F20F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1211101014:0":{"text":"这一路上，你不是很有船长的风范吗？","source_cn":"这一路上，你不是很有船长的风范吗？","status":"matched","hash_xxh64":"0xF1CB8A8E6FEDC0C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1211101015:0":{"text":"船长……我真的能当船长吗？","source_cn":"船长……我真的能当船长吗？","status":"matched","hash_xxh64":"0xD46AA2256A4F26AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1211101015":{"text":"船长……我真的能当船长吗？","source_cn":"船长……我真的能当船长吗？","status":"matched","hash_xxh64":"0xD46AA2256A4F26AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1211101016:0":{"text":"是吗，既然你都这么说了。","source_cn":"是吗，既然你都这么说了。","status":"matche