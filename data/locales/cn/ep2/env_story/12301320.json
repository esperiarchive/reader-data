{"asset_key":"ep2/env_story_12301320","episode":"ep2","category":"env_story","story_id":"12301320","schema_version":1,"lang":"cn","texts":{"say:1:1230132001:1":{"text":"什么？来自海上的客人？你是说——你们？","source_cn":"什么？来自海上的客人？你是说——你们？","status":"matched","hash_xxh64":"0x5CD2FF1792B05FBF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230132002:1":{"text":"确实是没见过的新面孔……","source_cn":"确实是没见过的新面孔……","status":"matched","hash_xxh64":"0xEAA01E77F1CA4E91","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230132003:1":{"text":"你们要是被海怪掀翻了漂流过来的，那身上应该一个铜币都没有吧。","source_cn":"你们要是被海怪掀翻了漂流过来的，那身上应该一个铜币都没有吧。","status":"matched","hash_xxh64":"0x51B86676A7AA7B0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230132004:1":{"text":"同病相怜！别看我是开店的，我兜里也没钱，哈哈！","source_cn":"同病相怜！别看我是开店的，我兜里也没钱，哈哈！","status":"matched","hash_xxh64":"0x05A9D7D3B8FD8163","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:旅店老板艾瑞特":{"text":"旅店老板艾瑞特","source":"旅店老板艾瑞特","status":"source"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}