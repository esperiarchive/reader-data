{"asset_key":"ep2/env_story_12311660","episode":"ep2","category":"env_story","story_id":"12311660","schema_version":1,"lang":"cn","texts":{"say:1:1231166001:1":{"text":"我也不知道……血薇帮说我的孩子是水鬼帮间谍。","source_cn":"我也不知道……血薇帮说我的孩子是水鬼帮间谍。","status":"matched","hash_xxh64":"0xC45EA8D1C7C6B0C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1231166002:1":{"text":"然后冲进我的家，将我的孩子带走。","source_cn":"然后冲进我的家，将我的孩子带走。","status":"matched","hash_xxh64":"0x9F67DC592D6E7A1B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1231166003:1":{"text":"可我的孩子最近明明是在海边钓鱼……他们一定是弄错了。","source_cn":"可我的孩子最近明明是在海边钓鱼……他们一定是弄错了。","status":"matched","hash_xxh64":"0xFB782D4AC3896541","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1231166004:1":{"text":"我要守在这里，跟血薇帮的老大解释这一切。","source_cn":"我要守在这里，跟血薇帮的老大解释这一切。","status":"matched","hash_xxh64":"0x7A8EA6062DF8B119","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:居民柯莉娅":{"text":"居民柯莉娅","source":"居民柯莉娅","status":"source"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}