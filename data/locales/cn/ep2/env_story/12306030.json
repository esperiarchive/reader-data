{"asset_key":"ep2/env_story_12306030","episode":"ep2","category":"env_story","story_id":"12306030","schema_version":1,"lang":"cn","texts":{"say:2:1230603001:1":{"text":"是、是第一次遇到……","source_cn":"是、是第一次遇到……","status":"matched","hash_xxh64":"0x2BE675E7E13DF839","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230603002:1":{"text":"帮里的兄弟们说，要想避开海怪行动，有一套特殊的航行办法。但是我没学会。","source_cn":"帮里的兄弟们说，要想避开海怪行动，有一套特殊的航行办法...","status":"matched","hash_xxh64":"0xE0EC336A19EE1A8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230603003:1":{"text":"不是说海怪不会袭击我们吗？咱们的大姐头可是和死潮舰队一伙啊！","source_cn":"不是说海怪不会袭击我们吗？咱们的大姐头可是和死潮舰队一伙啊！","status":"matched","hash_xxh64":"0xA317F37B6A555310","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1230603004:1":{"text":"你没看大姐头情况也怪怪的，不会是被海怪拍坏了脑子吧……","source_cn":"你没看大姐头情况也怪怪的，不会是被海怪拍坏了脑子吧……","status":"matched","hash_xxh64":"0xD913DD8BA5BC9D40","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:水鬼帮弗农":{"text":"水鬼帮弗农","source":"水鬼帮弗农","status":"source"},"speaker:水鬼帮伊凡":{"text":"水鬼帮伊凡","source":"水鬼帮伊凡","status":"source"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}