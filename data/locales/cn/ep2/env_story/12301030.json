{"asset_key":"ep2/env_story_12301030","episode":"ep2","category":"env_story","story_id":"12301030","schema_version":1,"lang":"cn","texts":{"say:1:1230103001:1":{"text":"是这样嘛？咳！我是说，我也这样认为。","source_cn":"是这样嘛？咳！我是说，我也这样认为。","status":"matched","hash_xxh64":"0x89B774047588BC98","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230103002:1":{"text":"这首《神之瀑》我们这人人都会唱，我更喜欢在海边唱起它！","source_cn":"这首《神之瀑》我们这人人都会唱，我更喜欢在海边唱起它！","status":"matched","hash_xxh64":"0x470D68D2468D1E52","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230103003:1":{"text":"不过这段时间海上一直大雾弥漫，我的渔船也已经半年没出航。","source_cn":"不过这段时间海上一直大雾弥漫，我的渔船也已经半年没出航。","status":"matched","hash_xxh64":"0x85F6F91D6DAF2B81","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230103004:1":{"text":"唉……真怀念一边唱歌一边和巨齿海鳗搏斗的日子。","source_cn":"唉……真怀念一边唱歌一边和巨齿海鳗搏斗的日子。","status":"matched","hash_xxh64":"0x9D1A442013E374AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:老渔夫罗塞尔":{"text":"老渔夫罗塞尔","source":"老渔夫罗塞尔","status":"source"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}