{"asset_key":"ep5/quest_story_15222090","episode":"ep5","category":"quest_story","story_id":"15222090","schema_version":1,"lang":"cn","texts":{"say:1:1522209001:0":{"text":"你们是跟着副将的那些人……我、我没有偷懒！我在认真发粮食！","source_cn":"你们是跟着副将的那些人……我、我没有偷懒！我在认真发粮食！","status":"matched","hash_xxh64":"0x2A559CFE623C7FF5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1522209002:0":{"text":"不必紧张，我们只是好奇赈灾粮的发放情况。","source_cn":"不必紧张，我们只是好奇赈灾粮的发放情况。","status":"matched","hash_xxh64":"0x1A7A3A3BECE9131D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1522209003:0":{"text":"但是你们还带着一个兽人……我不能说。","source_cn":"但是你们还带着一个兽人……我不能说。","status":"matched","hash_xxh64":"0x7449C3F832BF855B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1522209004:0":{"text":"……","source_cn":"……<key:dialog93>","status":"matched","hash_xxh64":"0xC693D3730DDCF945","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1522209004":{"text":"……","source_cn":"……<key:dialog93>","status":"matched","hash_xxh64":"0xC693D3730DDCF945","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1522209005:0":{"text":"我们询问