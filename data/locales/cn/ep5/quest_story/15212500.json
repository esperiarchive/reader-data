{"asset_key":"ep5/quest_story_15212500","episode":"ep5","category":"quest_story","story_id":"15212500","schema_version":1,"lang":"cn","texts":{"say:1:1521250001:0":{"text":"经过清点，今晚猎物数量最多的人是——","source_cn":"经过清点，今晚猎物数量最多的人是——","status":"matched","hash_xxh64":"0xFE184A08CC93143E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1521250002:0":{"text":"——巴！","source_cn":"——巴！","status":"matched","hash_xxh64":"0x73C27B416CC302FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521250003:0":{"text":"哈，我就说嘛！肯定是——","source_cn":"哈，我就说嘛！肯定是——","status":"matched","hash_xxh64":"0xD0237C7427E7B414","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521250004:0":{"text":"但是，这场选拔最后的胜者是——<style=\"highlight\">索斯</style>！","source_cn":"但是，这场选拔最后的胜者是——<style=highl...","status":"matched","hash_xxh64":"0x37D040F322A01545","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521250005:0":{"text":"<shk>什、什么？！</shk>","source_cn":"<shk>什、什么？！</shk>","status":"matched","hash_xxh64":"0x012FC70E0A3D3B1A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521250006:0":{"text":"……是