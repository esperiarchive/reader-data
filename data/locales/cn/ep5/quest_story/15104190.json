{"asset_key":"ep5/quest_story_15104190","episode":"ep5","category":"quest_story","story_id":"15104190","schema_version":1,"lang":"cn","texts":{"say:1:1510419001:0":{"text":"<style=\"highlight\">阿邦德领主</style>同意接见你们了。","source_cn":"<style=highlight>阿邦德领主</sty...","status":"matched","hash_xxh64":"0x56D3F78D9DEF7B47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1510419002:0":{"text":"你们已经亲眼见到呼临城的现状，有何感觉？","source_cn":"你们已经亲眼见到呼临城的现状，有何感觉？","status":"matched_runtime_gender","hash_xxh64":"0xED90C16CF6228F35","variant_status":"runtime_gender_keys_target_same","male":"你们已经亲眼见到呼临城的现状，有何感觉？","female":"你们已经亲眼见到呼临城的现状，有何感觉？","variant_male_record_index":"180262","variant_female_record_index":"180263","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1510419002":{"text":"你们已经亲眼见到呼临城的现状，有何感觉？","source_cn":"你们已经亲眼见到呼临城的现状，有何感觉？","status":"matched_runtime_gender","hash_xxh64":"0xED90C16CF6228F35","variant_status":"runtime_gender_keys_target_same","male":"你们已经亲眼见到呼临城的现状，有何感觉？","female":"你们已经亲眼见到呼临城的现状，有何感觉？","variant_male_record_index":"180262","variant_female_record_index":"180263","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510419003:0":{"text":"没错。","source_cn":"没错。<key:dialog52>","status":"matched_runtime_gender","hash_xxh64":"0xA0CFC6D1B0ABA9D1","variant_status":"runtime_gender_keys_target_same","male":"没错。","female":"没错。","variant_male_record_index":"180264","variant_female_record_index":"180265","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510419006:0":{"text":"呼临城需要一条活路。","source_cn":"呼临城需要一条活路。","status":"matched","hash_xxh64":"0