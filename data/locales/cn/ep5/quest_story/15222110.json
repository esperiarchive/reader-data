{"asset_key":"ep5/quest_story_15222110","episode":"ep5","category":"quest_story","story_id":"15222110","schema_version":1,"lang":"cn","texts":{"say:1:1522211001:0":{"text":"几位大人，你们是副将大人的手下吗？","source_cn":"几位大人，你们是副将大人的手下吗？","status":"matched","hash_xxh64":"0x91FF3AFD2B006B90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1522211001":{"text":"几位大人，你们是副将大人的手下吗？","source_cn":"几位大人，你们是副将大人的手下吗？","status":"matched","hash_xxh64":"0x91FF3AFD2B006B90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1522211002:0":{"text":"什……什么？","source_cn":"什……什么？","status":"matched","hash_xxh64":"0x4F9043C8DE6D9833","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1522211003:0":{"text":"请容许我做自我介绍：我们三人是魔法师协会的成员，此次来到呼临城是为了面见领主。","source_cn":"请容许我做自我介绍：我们三人是魔法师协会的成员，此次来...","status":"matched","hash_xxh64":"0xEC82CA2A48DC8021","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1522211004:0":{"text":"魔法师？还能面见领主？那你们一定都是了不起的大人物……","source_cn":"魔法师？还能面见领主？那你们一定都是了不起的大人物……","status":"matched","hash_xxh64":"0x4E3FF738796C48BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"