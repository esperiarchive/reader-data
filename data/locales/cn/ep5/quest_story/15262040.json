{"asset_key":"ep5/quest_story_15262040","episode":"ep5","category":"quest_story","story_id":"15262040","schema_version":1,"lang":"cn","texts":{"say:3:1526204001:1":{"text":"雅库伯尔已经警告过呼临，不准再靠近麦田。你们来做什么？","source_cn":"雅库伯尔已经警告过呼临，不准再靠近麦田。你们来做什么？","status":"matched","hash_xxh64":"0x14BC30A7D80D8612","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1526204002:1":{"text":"我、我们……不小心走错路了，就……","source_cn":"我、我们……不小心走错路了，就……","status":"matched","hash_xxh64":"0xB16CB6391170368B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1526204003:1":{"text":"说真话。","source_cn":"说真话。","status":"matched","hash_xxh64":"0x63A1841F47E447FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1526204004:1":{"text":"我们什么都没拿！不是，我们也没想拿什么！放过我们吧！","source_cn":"我们什么都没拿！不是，我们也没想拿什么！放过我们吧！","status":"matched","hash_xxh64":"0x822764868E22F4F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1526204005:1":{"text":"你们想<style=\"highlight\">窃取小麦</style>。","source_cn":"你们想<style=highlight>窃取小麦</s...","status":"matched","hash_xxh64":"0x48355959082921D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":"