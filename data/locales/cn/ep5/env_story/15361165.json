{"asset_key":"ep5/env_story_15361165","episode":"ep5","category":"env_story","story_id":"15361165","schema_version":1,"lang":"cn","texts":{"say:1:1536116501:1":{"text":"等猎血节的勇士归来，第一时间送花过去呀！","source_cn":"等猎血节的勇士归来，第一时间送花过去呀！","status":"matched","hash_xxh64":"0x0450248C1354FE87","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1536116502:1":{"text":"这可是雅库伯尔最稀有的花，只有被狩猎神认可的勇士才配得上！","source_cn":"这可是雅库伯尔最稀有的花，只有被狩猎神认可的勇士才配得上！","status":"matched","hash_xxh64":"0x7DC3C02AA3BE60EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1536116503:1":{"text":"他们要花做什么？没事找事！","source_cn":"他们要花做什么？没事找事！","status":"matched","hash_xxh64":"0xC0CD6A1A654C59F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1536116504:1":{"text":"别人都拿着花的时候，只有你手上没有，会显得你不尊重勇士！","source_cn":"别人都拿着花的时候，只有你手上没有，会显得你不尊重勇士！","status":"matched","hash_xxh64":"0xD7A379B64F01F35D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1536116505:1":{"text":"那……那我自己去采。","source_cn":"那……那我自己去采。","status":"matched","hash_xxh64":"0x23BAAB475E0B764A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1536116506:1":{"text":"你采的肯定没我这里卖的好看！一张兔皮就能换一朵，省时省力！","source_cn":"你采的肯定没我这里卖的好看！一张兔皮就能换一朵，省时省力！","status":"matched","hash_xxh64":"0xE6292413F204812C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1536116507:1":{"text":"好吧，给我来一朵。","source_cn":"好吧，给我来一朵。","status":"matched","hash_xxh64":"0x8B146C6A4F6E9953","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:羊角":{"text":"羊角","source":"羊角","status":"source"},"speaker:凯":{"text":"凯","source":"凯","status":"source"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}}