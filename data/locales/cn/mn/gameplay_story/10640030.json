le_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1064003031:1":{"text":"听说介于牛肉和鸡肉之间……","source_cn":"听说介于牛肉和鸡肉之间……","status":"hash_not_found","hash_xxh64":"0x00AEE61D0BAB0608","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1064003032:1":{"text":"既然如此，那就切块做成肉串。这样能品尝到它最原始的味道。","source_cn":"既然如此，那就切块做成肉串。这样能品尝到它最原始的味道。","status":"hash_not_found","hash_xxh64":"0x4C8EC30A7EE2BB9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1064003033:1":{"text":"森西，我也要切！","source_cn":"森西，我也要切！","status":"hash_not_found","hash_xxh64":"0xC26827A2E4AA4A72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:49:1064003034:1":{"text":"那我去准备点盐津仁粉，作为撒料。","source_cn":"那我去准备点盐津仁粉，作为撒料。","status":"hash_not_found","hash_xxh64":"0xB12B8599E3C130AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1064003035:1":{"text":"嗯……那我去弄点蛇骨草水来，给大家解腻。","source_cn":"嗯……那我去弄点蛇骨草水来，给大家解腻。","status":"hash_not_found","hash_xxh64":"0xAE491C20E0889352","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:52:1064003036:1":{"text":"蛇骨草，是植物吗？我有点想看看！","source_cn":"蛇骨草，是植物吗？我有点想看看！","status":"hash_not_found","hash_xxh64":"0x48150EE255B0E089","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:54:1064003037:1":{"text":"我和满满也去帮忙！","source_cn":"我和满满也去帮忙！","status":"hash_not_found","hash_xxh64":"0xA339FD3ED0A42B1A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:56:1064003038:1":{"text":"……怎么又只剩下我了！","source_cn":"……怎么又只剩下我了！","status":"hash_not_found","hash_xxh64":"0xACF730C93407EB14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:57:1064003038":{"text":"……怎么又只剩下我了！","source_cn":"……怎么又只剩下我了！","status":"hash_not_found","hash_xxh64":"0xACF730C93407EB14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:58:1064003039:1":{"text":"只能看看有没有什么力所能及的活了……","source_cn":"只能看看有没有什么力所能及的活了……","status":"hash_not_found","hash_xxh64":"0x06982B819FA26DA1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:59:1064003040:1":{"text":"唔，那我们去准备篝火吧。","source_cn":"唔，那我们去准备篝火吧。","status":"hash_not_found","hash_xxh64":"0xC013779114FAB227","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:61:1064003041:1":{"text":"就这样，大家热火朝天地忙了起来。","source_cn":"就这样，大家热火朝天地忙了起来。","status":"hash_not_found","hash_xxh64":"0x62A2FBEC449DA4E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:62:1064003042:1":{"text":"很快地，<style=highlight>盐津仁沙虫肉...","source_cn":"很快地，<style=highlight>盐津仁沙虫肉...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:62::2":{"text":"盐津仁沙虫肉串与荒角蛇骨草水","source_cn":"盐津仁沙虫肉串与荒角蛇骨草水","status":"matched","hash_xxh64":"0x2BF1920F8017E516","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:64:1064003043:0":{"text":"老夫也是第一次料理沙虫肉，各位先尝尝看吧。","source_cn":"老夫也是第一次料理沙虫肉，各位先尝尝看吧。","status":"hash_not_found","hash_xxh64":"0x4B84EE6F4FF6ACC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:66:1064003044:1":{"text":"唔……好吃！","source_cn":"唔……好吃！","status":"hash_not_found","hash_xxh64":"0xB5186E5231521044","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:67:1064003045:1":{"text":"外脆里嫩，肉质紧实又多汁！越嚼越多汁。比牛肉多了一丝甜...","source_cn":"外脆里嫩，肉质紧实又多汁！越嚼越多汁。比牛肉多了一丝甜...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:70:1064003046:1":{"text":"怎么想都很奇怪？虫肉怎么会像鸡肉和牛肉……","source_cn":"怎么想都很奇怪？虫肉怎么会像鸡肉和牛肉……","status":"hash_not_found","hash_xxh64":"0x5241D590BB4F31A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:71:1064003046":{"text":"怎么想都很奇怪？虫肉怎么会像鸡肉和牛肉……","source_cn":"怎么想都很奇怪？虫肉怎么会像鸡肉和牛肉……","status":"hash_not_found","hash_xxh64":"0x5241D590BB4F31A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:72:1064003047:1":{"text":"……我还是先喝蛇骨草水吧。实在饿了……我再尝尝看！","source_cn":"……我还是先喝蛇骨草水吧。实在饿了……我再尝尝看！","status":"hash_not_found","hash_xxh64":"0xAB8D8D0503545BC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:74:1064003048:0":{"text":"肉要趁热吃。","source_cn":"肉要趁热吃。","status":"hash_not_found","hash_xxh64":"0xD7200FF073DC78F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:75:1064003049:0":{"text":"呜，我知道啦。我现在就吃——","source_cn":"呜，我知道啦。我现在就吃——","status":"hash_not_found","