{"asset_key":"mn/gameplay_story_10641010","episode":"mn","category":"gameplay_story","story_id":"10641010","schema_version":1,"lang":"cn","texts":{"say:1:1064101001:0":{"text":"今日祷告至此结束。愿艾雅的圣光永远照耀着你们。","source_cn":"今日祷告至此结束。愿艾雅的圣光永远照耀着你们。","status":"matched","hash_xxh64":"0x41010F04FF841E1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1064101002:1":{"text":"艾雅在上，感谢您的布道。","source_cn":"艾雅在上，感谢您的布道。","status":"matched","hash_xxh64":"0x8A4243B0D5A5A671","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1064101003:1":{"text":"时间不早了。咱们也回家吧。","source_cn":"时间不早了。咱们也回家吧。","status":"matched","hash_xxh64":"0x80369649DD6983A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1064101004:1":{"text":"好。吉拉科，记得要和修士修女们告别哦。","source_cn":"好。吉拉科，记得要和修士修女们告别哦。","status":"matched","hash_xxh64":"0x9EC61B2A21A1C313","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1064101005:1":{"text":"放心吧，妈妈，我记着呢！","source_cn":"放心吧，妈妈，我记着呢！","status":"matched","hash_xxh64":"0x58DD18EFBCFD4EF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1064101006:0":{"text":"康塔格修士，艾达姐姐，再见！","sou