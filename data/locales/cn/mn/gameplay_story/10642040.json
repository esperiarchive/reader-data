ariant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1064204012:0":{"text":"……奥萝菈？","source_cn":"……奥萝菈？","status":"matched","hash_xxh64":"0xD98CA13837272D2C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1064204013:0":{"text":"别紧张。是我，奥萝菈。","source_cn":"别紧张。是我，奥萝菈。","status":"matched","hash_xxh64":"0x974997F0F7CCCBC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1064204014:0":{"text":"你……你到底是什么人？","source_cn":"你……你到底是什么人？","status":"matched","hash_xxh64":"0xA672232077000CB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1064204015:0":{"text":"无需担忧……我不会伤害你。","source_cn":"无需担忧……我不会伤害你。","status":"matched","hash_xxh64":"0x6DAE368DDC7B1DC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1064204016:1":{"text":"也许你已经猜到，我是梦境的引路人。我来到这里，是为了引导你走出那可怕的噩梦……","source_cn":"也许你已经猜到，我是梦境的引路人。我来到这里，是为了引...","status":"matched","hash_xxh64":"0x1CEC227BD368493D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1064204017:1":{"text":"噩梦……？什么意思？","source_cn":"噩梦……？什么意思？","status":"matched","hash_xxh64":"0x7D7DAB6456C9A8F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1064204018:1":{"text":"长久以来，你都被困在一场噩梦之中……","source_cn":"长久以来，你都被困在一场噩梦之中……","status":"matched","hash_xxh64":"0xD2AFC8E077F68D16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1064204019:1":{"text":"噩梦中，战火连天……迈克尔临死前的场景一次又一次重复上演……","source_cn":"噩梦中，战火连天……迈克尔临死前的场景一次又一次重复上演……","status":"matched","hash_xxh64":"0xBDD3FBE53DE707E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1064204020:1":{"text":"而你，一遍遍地扶起他，想要将他带离战场，拯救他的生命……","source_cn":"而你，一遍遍地扶起他，想要将他带离战场，拯救他的生命……","status":"matched","hash_xxh64":"0x563D6471A38284EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1064204021:1":{"text":"没有任何一次，你真的狠下心，抛弃他。","source_cn":"没有任何一次，你真的狠下心，抛弃他。","status":"matched","hash_xxh64":"0xE3769D0C04CE9F0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1064204022:1":{"text":"但是……但是我没有真的救下他。对吗？","source_cn":"但是……但是我没有真的救下他。对吗？","status":"matched","hash_xxh64":"0x1894661AC0B50947","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1064204023:1":{"text":"甚至……甚至我的两条腿也因此受伤，再也行动不了了……","source_cn":"甚至……甚至我的两条腿也因此受伤，再也行动不了了……","status":"matched","hash_xxh64":"0xAF9B9DCF7DBCDB2B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1064204024:1":{"text":"所以，你不断地想：假如……当时没有救他。","source_cn":"所以，你不断地想：假如……当时没有救他。","status":"matched","hash_xxh64":"0x1384201CEE563584","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1064204025:1":{"text":"………………","source_cn":"………………","status":"matched","hash_xxh64":"0x197F0BE8A09E0D34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1064204026:1":{"text":"可你是一个善良的人。在你内心深处，光辉始终抵抗着这份灰暗的想法……","source_cn":"可你是一个善良的人。在你内心深处，光辉始终抵抗着这份灰...","status":"matched","hash_xxh64":"0x9D6373A3FEF3A4E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1064204027:1":{"text":"光与暗的碰撞中，影子，诞生了……那便是一直折磨着你，令你痛苦的心魔。","source_cn":"光与暗的碰撞中，影子，诞生了……那便是一直折磨着你，令...","status":"matched","hash_xxh64":"0x2A8E19F48F108B80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1064204028:1":{"text":"但你看……你战胜它了。噩梦消散了。","source_cn":"但你看……你战胜它了。噩梦消散了。","status":"matched","hash_xxh64":"0xB6B41342A3EAAD20","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1064204029:1":{"text":"……可我还是没有救下迈克尔。","source_cn":"……可我还是没有救下迈克尔。","status":"matched","hash_xxh64":"0xAB0D3D36AEE25D58","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1064204030:1":{"text":"那不是你的错。战争，从来都是无情的……","source_cn":"那不是你的错。战争，从来都是无情的……","status":"matched","hash_xxh64":"0xEC22BD475C0A0FD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1064204031:1":{"text":"而且，你也成功救下了很多人，不是吗？凯特、劳恩、萨米尔……","source_cn":"而且，你也成功救下了很多人，不是吗？凯特、劳恩、萨米尔……","status":"matched","hash_xxh64":"0x0B4A252DA37ED9FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1064204032:1":{"text":"去看看他们寄来的信吧。我能感受到……即使在梦境之中，他们依然牵挂着你，如此真切……","source_cn":"去看看他们寄来的信吧。我能感受到……即使在梦境之中，他...","status":"matched","hash_xxh64":"0x1C7BCEA37D9AF7AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_