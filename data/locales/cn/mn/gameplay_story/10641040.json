","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1064104033:1":{"text":"可是您看，黑魔法药剂并没有生效，这足以说明埃米妮和黑金商会之间早已没有任何瓜葛。","source_cn":"可是您看，黑魔法药剂并没有生效，这足以说明埃米妮和黑金...","status":"matched","hash_xxh64":"0x1517D2CF9BF23770","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1064104034:1":{"text":"我再次恳求您——请您宽恕埃米妮的罪孽！","source_cn":"我再次恳求您——请您宽恕埃米妮的罪孽！","status":"matched","hash_xxh64":"0x0442879EEA5187B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1064104035:1":{"text":"不可能。","source_cn":"不可能。","status":"matched","hash_xxh64":"0xE749646A618006FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1064104036:1":{"text":"艾雅女神不再降临于世不过短短十年，凡人便忘却了当年的仇恨，忘却了黑金商会曾与引发大战的恶魔们勾结。","source_cn":"艾雅女神不再降临于世不过短短十年，凡人便忘却了当年的仇...","status":"matched","hash_xxh64":"0xA685C1ABBD7C2020","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1064104037:1":{"text":"——这是对女神的亵渎与背叛！绝不可原谅！","source_cn":"——这是对女神的亵渎与背叛！绝不可原谅！","status":"matched","hash_xxh64":"0x7A6718BB652A8D86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","documen