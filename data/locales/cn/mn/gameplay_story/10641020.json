_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:102:1064102081:1":{"text":"我现在就去找她！","source_cn":"我现在就去找她！","status":"matched","hash_xxh64":"0x5C73A3A4AB86214C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:103:1064102082:0":{"text":"……","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:104:1064102083:1":{"text":"战争结束已经十年了……这十年间，半神们现身的次数却寥寥无几……","source_cn":"战争结束已经十年了……这十年间，半神们现身的次数却寥寥...","status":"matched","hash_xxh64":"0xD9964CB54ABA6F1B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:105:1064102084:1":{"text":"阿塔利娅大人，若您能听到凡人的祈祷，祈求您怜悯这对可怜的母子，铲除令他们家庭破碎的恶徒吧……","source_cn":"阿塔利娅大人，若您能听到凡人的祈祷，祈求您怜悯这对可怜...","status":"matched","hash_xxh64":"0xC7B929DB645D90EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:旁白":{"text":"旁白","source":"旁白","status":"source"},"speaker:埃米妮":{"text":"埃米妮","source":"埃米妮","status":"source"},"speaker:吉拉科":{"text":"吉拉科","source":"吉拉科","status":"source"},"speaker:修女路易莎":{"text":"修女路易莎","source":"修女路易莎","status":"source"},"speaker:修女艾达":{"text":"修女艾达","source":"修女艾达","status":"source"},"speaker:黑屏文字":{