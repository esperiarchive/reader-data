_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1064004016:1":{"text":"不是啦，我们所说的冥湾美人其实是深海鱼。","source_cn":"不是啦，我们所说的冥湾美人其实是深海鱼。","status":"hash_not_found","hash_xxh64":"0x7CCE00B52FD5C5E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1064004017:1":{"text":"外表和人完全不相似，反倒是有点令人毛骨悚然。","source_cn":"外表和人完全不相似，反倒是有点令人毛骨悚然。","status":"hash_not_found","hash_xxh64":"0xB1C6963DFA1709C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1064004018:1":{"text":"毛骨悚然……真的没问题吗？","source_cn":"毛骨悚然……真的没问题吗？","status":"hash_not_found","hash_xxh64":"0xF375DCD6ADD7D33B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:28:1064004018":{"text":"虽说是鱼，但这么恐怖真的没问题吗？","source_cn":"虽说是鱼，但这么恐怖真的没问题吗？","status":"hash_not_found","hash_xxh64":"0x51BE1A0C040D6279","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1064004019:1":{"text":"既然生活在深海里，我们该如何捕获它呢？","source_cn":"既然生活在深海里，我们该如何捕获它呢？","status":"hash_not_found","hash_xxh64":"0x97E7053F3F220235","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1064004020:0":{"text":"主人和我们之前钓到过，交给我们吧。","sourc