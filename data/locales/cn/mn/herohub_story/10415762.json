3B7E76633E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1041576212:1":{"text":"这有什么不好理解的！","source_cn":"这有什么不好理解的！","status":"matched","hash_xxh64":"0x9F352D6458EA14FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1041576213:1":{"text":"当然是因为在我们孤单的时候，奇奇和艾尔总会陪在我们身边啊！","source_cn":"当然是因为在我们孤单的时候，奇奇和艾尔总会陪在我们身边啊！","status":"matched","hash_xxh64":"0x2483A5A4B9029C58","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1041576214:1":{"text":"那些不理解你的人不仅不会陪在你身边，反倒正是他们给你带来了很多烦恼吧！","source_cn":"那些不理解你的人不仅不会陪在你身边，反倒正是他们给你带...","status":"matched","hash_xxh64":"0x60542168CC779766","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1041576215:1":{"text":"我的确也为他们烦恼过……","source_cn":"我的确也为他们烦恼过……","status":"matched","hash_xxh64":"0xE369C149B083705F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1041576216:1":{"text":"所以，我们就不要去管他们的想法啦！","source_cn":"所以，我们就不要去管他们的想法啦！","status":"matched","hash_xxh64":"0x1DD6DFD799B8967F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1041576217:1":{"text":"一定会有和我们一样喜欢奇奇和艾尔的人的，我们只要和他们成为伙伴就好了。","source_cn":"一定会有和我们一样喜欢奇奇和艾尔的人的，我们只要和他们...","status":"matched","hash_xxh64":"0x87F26A0A66743DB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1041576218:1":{"text":"世界很大很大，奇奇和艾尔，你和我，一定不会孤单的！","source_cn":"世界很大很大，奇奇和艾尔，你和我，一定不会孤单的！","status":"matched","hash_xxh64":"0xE735E629F1B55DD4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1041576219:1":{"text":"是啊……就像你和我，不就已经成为可以互相理解的朋友了吗？","source_cn":"是啊……就像你和我，不就已经成为可以互相理解的朋友了吗？","status":"matched","hash_xxh64":"0x44BC395B4E21FFD9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1041576220:1":{"text":"戴蒙，奇奇……我格温妮丝，很高兴能认识你们，和你们做朋友！","source_cn":"戴蒙，奇奇……我格温妮丝，很高兴能认识你们，和你们做朋友！","status":"matched","hash_xxh64":"0x28D3BC98816E1249","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:格温妮丝":{"text":"格温妮丝","source":"格温妮丝","status":"source"},"speaker:戴蒙":{"text":"戴蒙","source":"戴蒙","status":"source"}},"stats":{"flow_row_count":21,"localized_text_count":20,"speaker_count":2}}