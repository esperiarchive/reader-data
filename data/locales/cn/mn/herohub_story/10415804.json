cument_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1041580417:1":{"text":"不过，如果你真的放不下他，变成亡灵和他永远作伴难道不是更好的选择？啊，当然，我不是说现在，而是说将来。","source_cn":"不过，如果你真的放不下他，变成亡灵和他永远作伴难道不是...","status":"matched","hash_xxh64":"0x111CEC7FB0D60534","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1041580418:1":{"text":"……我说过，我绝不会变成亡灵。","source_cn":"……我说过，我绝不会变成亡灵。","status":"matched","hash_xxh64":"0x69DB7FB8A4FB9573","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1041580419:1":{"text":"如果不是当时情况紧急，如果不是没有选择……我也不想他变成亡灵。","source_cn":"如果不是当时情况紧急，如果不是没有选择……我也不想他变...","status":"matched","hash_xxh64":"0x15297C4C88DC50AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1041580420:1":{"text":"但事情已经发生，谁都无力改变，不是吗？","source_cn":"但事情已经发生，谁都无力改变，不是吗？","status":"matched","hash_xxh64":"0x9DECA560B4C0BE59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1041580421:1":{"text":"如果要我来说，与家人永远相伴——哪怕是以亡灵的身份——也是一种别样美好的生活。","source_cn":"如果要我来说，与家人永远相伴——哪怕是以亡灵的身份——...","status":"matched","hash_xxh64":"0x36E27C52C4ABB5A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":