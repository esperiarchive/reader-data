{"asset_key":"mn/herohub_story_10415044","episode":"mn","category":"herohub_story","story_id":"10415044","schema_version":1,"lang":"cn","texts":{"say:2:1041504401:1":{"text":"……你闻起来不好吃。","source_cn":"……你闻起来不好吃。","status":"matched","hash_xxh64":"0x9676BBD78F9A4D89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1041504402:1":{"text":"被食欲冲昏了头的傻瓜，死潮舰队最没用的男儿都比你强。","source_cn":"被食欲冲昏了头的傻瓜，死潮舰队最没用的男儿都比你强。","status":"matched","hash_xxh64":"0xE859BFF6916CF07F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041504403:1":{"text":"别挡路，让开！","source_cn":"别挡路，让开！","status":"matched","hash_xxh64":"0x6D3D39DFDA5B8AFE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041504404:1":{"text":"挡路的是你！","source_cn":"挡路的是你！","status":"matched","hash_xxh64":"0x19CB12E1A414A905","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041504405:1":{"text":"吼——！","source_cn":"吼——！","status":"matched","hash_xxh64":"0xEA1170FCECA0E340","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1041504406:1":{"text":"嗬，四肢倒是发达，就是没脑子。","source_cn":"嗬，四肢倒是发达，就是没脑子。","status":"matched","hash_xx