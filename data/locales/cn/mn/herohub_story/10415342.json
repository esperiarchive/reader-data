{"asset_key":"mn/herohub_story_10415342","episode":"mn","category":"herohub_story","story_id":"10415342","schema_version":1,"lang":"cn","texts":{"say:2:1041534201:1":{"text":"哈哈哈，好久不见了！隆冬节快乐！","source_cn":"哈哈哈，好久不见了！隆冬节快乐！","status":"matched","hash_xxh64":"0xAE4E3EC776B25F79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1041534202:1":{"text":"隆冬节快乐，呼金！你总算来了！感觉怎么样？","source_cn":"隆冬节快乐，呼金！你总算来了！感觉怎么样？","status":"matched","hash_xxh64":"0x572732E07BCC518D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041534203:1":{"text":"嚯——你们这个地方，装饰得非常像样啊？！从外头可看不出来！","source_cn":"嚯——你们这个地方，装饰得非常像样啊？！从外头可看不出来！","status":"matched","hash_xxh64":"0xE504C77363388CA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041534204:1":{"text":"那当然！这可是有着了不起魔法的神秘屋！","source_cn":"那当然！这可是有着了不起魔法的神秘屋！","status":"matched","hash_xxh64":"0x405FF0E45CF53E2F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041534205:1":{"text":"不过这些装饰可没有用魔法，都是多莉小姐订购和布置的。","source_cn":"不过这些装饰可没有用魔法，都是多莉小姐订购和布置的。","status":"matched","hash_xxh64":"0xEBD963C40D1EA742","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1041534206:1":{"text":"当然，我们也帮了一点点忙！","source_cn":"当然，我们也帮了一点点忙！","status":"matched","hash_xxh64":"0x9A0064DFCA229183","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1041534207:1":{"text":"那我也来帮帮忙吧，你们这里灯光的开关还可以再调整一下——","source_cn":"那我也来帮帮忙吧，你们这里灯光的开关还可以再调整一下——","status":"matched","hash_xxh64":"0x410F02AF31FC20C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1041534208:1":{"text":"太好了，那就一起动手吧！","source_cn":"太好了，那就一起动手吧！","status":"matched","hash_xxh64":"0x1477B97498904D65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:呼金":{"text":"呼金","source":"呼金","status":"source"},"speaker:满满":{"text":"满满","source":"满满","status":"source"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":2}}