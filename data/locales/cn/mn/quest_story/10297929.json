{"asset_key":"mn/quest_story_10297929","episode":"mn","category":"quest_story","story_id":"10297929","schema_version":1,"lang":"cn","texts":{"say:3:1029792901:1":{"text":"比我想象的要朴素不少啊，也没什么人。","source_cn":"比我想象的要朴素不少啊，也没什么人。","status":"matched","hash_xxh64":"0x29C1BCAE19B2B430","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1029792902:1":{"text":"……是你的品味过于奢华了。","source_cn":"……是你的品味过于奢华了。","status":"matched","hash_xxh64":"0x71E6C3008C80E0AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1029792903:1":{"text":"这里只是普通的矮人村落，没法和你的王宫比。","source_cn":"这里只是普通的矮人村落，没法和你的王宫比。","status":"matched","hash_xxh64":"0x35E4D3C512760872","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1029792904:1":{"text":"不不，第一，王宫可不是我的；第二，我的私宅可比王宫要漂亮多了。","source_cn":"不不，第一，王宫可不是我的；第二，我的私宅可比王宫要漂...","status":"matched","hash_xxh64":"0x9F99ACC54EA273E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1029792905:1":{"text":"总而言之，这里我看够了，接下来是不是可以去别处逛逛？","source_cn":"总而言之，这里我看够了，接下来是不是可以去别处逛逛？","status":"matched","hash_xxh64":"0xD5B6925501014E0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1029792906:1":{"text":"或者干脆让游客们进入萨洛克兰吧！我会用全部的热情迎接他们的。","source_cn":"或者干脆让游客们进入萨洛克兰吧！我会用全部的热情迎接他们的。","status":"matched","hash_xxh64":"0x2B28B2372AB7009D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1029792907:1":{"text":"相信我，我最适合的工作就是外交！","source_cn":"相信我，我最适合的工作就是外交！","status":"matched","hash_xxh64":"0x7308E2AEAFB43945","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1029792908:1":{"text":"想都别想。","source_cn":"想都别想。","status":"matched","hash_xxh64":"0x8DF1C2D7FBF5FB64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1029792909:1":{"text":"……还有，说到工作，现在不是工作时间吗？","source_cn":"……还有，说到工作，现在不是工作时间吗？","status":"matched","hash_xxh64":"0x1CCA21006A9BA0CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1029792910:1":{"text":"……糟糕。","source_cn":"……糟糕。","status":"matched","hash_xxh64":"0xB95CE5EE95C72D71","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:沙利叶":{"text":"沙利叶","source":"沙利叶","status":"source"},"speaker:因度厄":{"text":"因度厄","source":"因度厄","status":"source"}},"stats":{"flow_row_count":11,"localized_text_count":10,"spe