{"asset_key":"mn/quest_story_10104050","episode":"mn","category":"quest_story","story_id":"10104050","schema_version":1,"lang":"cn","texts":{"say:2:1010405001:0":{"text":"……总之，夫人有事外出了，弗朗茨先生，请回吧。","source_cn":"……总之，夫人有事外出了，弗朗茨先生，请回吧。","status":"matched","hash_xxh64":"0xC01F3A83F26540A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1010405002:0":{"text":"等等！你想要什么？我都可以给你！让我见见<style=\"highlight\">维拉夫人</style>！","source_cn":"等等！你想要什么？我都可以给你！让我见见维拉夫人！","status":"matched","hash_xxh64":"0x340920EFD4B56113","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1010405003:0":{"text":"抱歉，我还有事，先告退了。","source_cn":"抱歉，我还有事，先告退了。","status":"matched","hash_xxh64":"0x571C2BAEA85ADB04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1010405004:0":{"text":"啧，可恶的女人……","source_cn":"啧，可恶的女人……","status":"matched_runtime_gender","hash_xxh64":"0xF7A9D0F56A7825F8","variant_status":"runtime_gender_keys_target_same","male":"啧，可恶的女人……","female":"啧，可恶的女人……","variant_male_record_index":"99263","variant_female_record_index":"99264","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1010405005:0":{"text":"这世界上有不少东西，无法用金钱购买。","source_cn":"这世界上有不少东西，无法用金钱购买。","status":"matched","hash_xxh64":"0xB270148886087817","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_tit