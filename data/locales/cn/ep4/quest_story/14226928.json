ent_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1422692817:1":{"text":"我、我不敢说……","source_cn":"我、我不敢说……","status":"matched","hash_xxh64":"0x3F3DDB8B237B9BD5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1422692818:1":{"text":"不必害怕，我们就是来解决此事的。","source_cn":"不必害怕，我们就是来解决此事的。","status":"matched","hash_xxh64":"0x9FCB7036E5B7F7C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1422692819:0":{"text":"好吧……是银月祭庭的祭司们……她们说诅咒是假的！","source_cn":"好吧……是银月祭庭的祭司们……她们说诅咒是假的！","status":"matched","hash_xxh64":"0xBC80A4B1F8EDC5E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:24:1422692819":{"text":"好吧……是银月祭庭的祭司们……她们说诅咒是假的！","source_cn":"好吧……是银月祭庭的祭司们……她们说诅咒是假的！","status":"matched","hash_xxh64":"0xBC80A4B1F8EDC5E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1422692820:1":{"text":"我、我就是复述。她们说那些关于诅咒和龙的故事都是谎言。","source_cn":"我、我就是复述。她们说那些关于诅咒和龙的故事都是谎言。","status":"matched","hash_xxh64":"0x5727CD6E8F562A17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1422692821:1":{"tex