{"asset_key":"ep4/quest_story_14233290","episode":"ep4","category":"quest_story","story_id":"14233290","schema_version":1,"lang":"cn","texts":{"say:3:1423329001:1":{"text":"你们来啦！我提前做了一些功课，查阅了书籍，带了炊具……还有各种可能会用上的东西。","source_cn":"你们来啦！我提前做了一些功课，查阅了书籍，带了炊具……...","status":"matched","hash_xxh64":"0xDB3B430653ECC86B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423329002:1":{"text":"我看了地图，月落升降井处的升降机可以通往泽被平民区，所以这次我们可以沿着那条路出发？","source_cn":"我看了地图，月落升降井处的升降机可以通往泽被平民区，所...","status":"matched","hash_xxh64":"0x51F6CBEF120EFD7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423329003:1":{"text":"感觉欧罗娜都可以为我们带路了呢。","source_cn":"感觉欧罗娜都可以为我们带路了呢。","status":"matched","hash_xxh64":"0x37F122EDF1ED6E00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423329004:1":{"text":"那条路线我们也很熟悉！我们出发吧！","source_cn":"那条路线我们也很熟悉！我们出发吧！","status":"matched","hash_xxh64":"0xA9A303203FEC8337","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:欧罗娜":{"text":"欧罗娜","source":"欧罗娜","status":"source"},"speaker:漫漫":{"text":"漫漫","source":"漫漫","status":"source"},"speaker:满满":{"text":"满满","source":"满满","status":"source"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":3}}