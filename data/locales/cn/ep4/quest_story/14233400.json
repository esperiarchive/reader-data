{"asset_key":"ep4/quest_story_14233400","episode":"ep4","category":"quest_story","story_id":"14233400","schema_version":1,"lang":"cn","texts":{"say:1:1423340001:1":{"text":"詹米，你没出什么事吧！","source_cn":"詹米，你没出什么事吧！","status":"matched","hash_xxh64":"0x09634E854622F92F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423340002:1":{"text":"妈妈，我没事！我只是跟希娜他们去玩捉迷藏了。","source_cn":"妈妈，我没事！我只是跟希娜他们去玩捉迷藏了。","status":"matched","hash_xxh64":"0xC1EAAAF5596F4DCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423340003:1":{"text":"多谢你们这些好心人带詹米回来……希娜他们呢，没有回来吗？","source_cn":"多谢你们这些好心人带詹米回来……希娜他们呢，没有回来吗？","status":"matched","hash_xxh64":"0x6B3CC976B89DE1A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423340004:1":{"text":"抱歉，他们还想继续玩游戏，没有回来……","source_cn":"抱歉，他们还想继续玩游戏，没有回来……","status":"matched","hash_xxh64":"0xCFE6F1A4A86D6B1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423340005:1":{"text":"唉，真是让人不省心的孩子啊。","source_cn":"唉，真是让人不省心的孩子啊。","status":"matched","hash_xxh64":"0x738C8F7010B0381A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423340006:1":{"t