{"asset_key":"ep4/quest_story_14107330","episode":"ep4","category":"quest_story","story_id":"14107330","schema_version":1,"lang":"cn","texts":{"say:1:1410733001:0":{"text":"裁决已定——","source_cn":"裁决已定——","status":"matched","hash_xxh64":"0x153EC2FB72B28931","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1410733002:0":{"text":"都铎，将因度厄押下去，让迷失的孩子在黑暗中思考背叛的代价。","source_cn":"都铎，将因度厄押下去，让迷失的孩子在黑暗中思考背叛的代价。","status":"matched","hash_xxh64":"0xB72166B06CC42645","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1410733003:0":{"text":"至于这两位不速之客——","source_cn":"至于这两位不速之客——","status":"matched_runtime_gender","hash_xxh64":"0x42D1D6B9CE85988D","variant_status":"runtime_gender_keys_target_same","male":"至于这两位不速之客——","female":"至于这两位不速之客——","variant_male_record_index":"158502","variant_female_record_index":"158503","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410733004:1":{"text":"我可不是你们的人，少给我下判决。","source_cn":"我可不是你们的人，少给我下判决。","status":"matched","hash_xxh64":"0x8049D4146C9E39B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1410733005:0":{"text":"如你所愿。奎茵，将他们交给我们的矮人朋友处理吧。","source_cn":"如你所愿。奎茵，将他们交给我们的矮人朋友处理吧。","status":"matched","hash_xxh64":"0x8764BFA87EB546AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1410733006:0":{"text":"我不希望这件事引起任何……不必要的关注。","source_cn":"我不希望这件事引起任何……不必要的关注。","status":"matched","hash_xxh64":"0xB32FBFE9BE76290A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1410733007:1":{"text":"遵命，我的女王。","source_cn":"遵命，我的女王。","status":"matched","hash_xxh64":"0x93EE3AE24F038FEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1410733008:0":{"text":"我们会妥善处理的，陛下。","source_cn":"我们会妥善处理的，陛下。","status":"matched","hash_xxh64":"0x6882C226E469C0AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:1410733009:0":{"text":"奎茵找来了村长弗林，将我们移交了过去……","source_cn":"奎茵找来了村长弗林，将我们移交了过去……","status":"matched","hash_xxh64":"0x574ECB028B2551C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:奈萨雷斯":{"text":"奈萨雷斯","source":"奈萨雷斯","status":"source"},"speaker:祖娅":{"text":"祖娅","source":"祖娅","status":"source"},"speaker:奎茵":{"text":"奎茵","source":"奎茵","status":"source"},"speaker:都铎":{"text":"都铎","source":"都铎","status":"source"},"speaker:黑屏字幕":{"text":"黑屏字幕","source":"黑屏字幕","status":"source"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":5}}