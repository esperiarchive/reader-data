{"asset_key":"ep4/quest_story_14103010","episode":"ep4","category":"quest_story","story_id":"14103010","schema_version":1,"lang":"cn","texts":{"say:3:1410301001:1":{"text":"祖娅，我们这是到地表了吗？","source_cn":"祖娅，我们这是到地表了吗？","status":"matched","hash_xxh64":"0x4376118848CA1AAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1410301002:1":{"text":"哈哈！这才哪到哪？我们还在地底呢。","source_cn":"哈哈！这才哪到哪？我们还在地底呢。","status":"matched","hash_xxh64":"0x615623FD6B174210","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410301003:1":{"text":"距离目的地还远得很，得走一段路！跟我来！","source_cn":"距离目的地还远得很，得走一段路！跟我来！","status":"matched","hash_xxh64":"0x71A5087D0DC68597","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1410301004:1":{"text":"好奇妙，这里的景色和矿洞里完全不同，简直像另一种地面的世界。","source_cn":"好奇妙，这里的景色和矿洞里完全不同，简直像另一种地面的世界。","status":"matched","hash_xxh64":"0x71F15983D4D93E7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1410301005:1":{"text":"蘑菇比树还高……真想知道它们是怎么长这么大的！","source_cn":"蘑菇比树还高……真想知道它们是怎么长这么大的！","status":"matched","hash_xxh64":"0x15AE38D223CAC22C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1410301006:1":{"text":"看归看，可不要乱吃啊。地底的植物毒性可大着呢！一不小心就能让你变成发光仓鼠。","source_cn":"看归看，可不要乱吃啊。地底的植物毒性可大着呢！一不小心...","status":"matched","hash_xxh64":"0xAA1E9D209DCDDD5B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1410301007:1":{"text":"发光的漫漫啊……感觉会是个很好看的落地灯，嘿嘿——","source_cn":"发光的漫漫啊……感觉会是个很好看的落地灯，嘿嘿——","status":"matched","hash_xxh64":"0x76AC3809A1F5B7D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1410301008:1":{"text":"适合摆在神秘屋里最显眼的位置！","source_cn":"适合摆在神秘屋里最显眼的位置！","status":"matched","hash_xxh64":"0xD4DD3E6E7BD8F32A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1410301009:1":{"text":"笨蛋满满！停止你的想象！我才不要当落地灯！","source_cn":"笨蛋满满！停止你的想象！我才不要当落地灯！","status":"matched","hash_xxh64":"0x26AD29EBF9D616AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"满满","source":"满满","status":"source"},"speaker:祖娅":{"text":"祖娅","source":"祖娅","status":"source"},"speaker:漫漫":{"text":"漫漫","source":"漫漫","status":"source"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":3}}