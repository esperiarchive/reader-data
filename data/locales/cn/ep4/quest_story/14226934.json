cord_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1422693411:1":{"text":"我们可以去地表，可以去晒太阳，只要忍忍——","source_cn":"我们可以去地表，可以去晒太阳，只要忍忍——","status":"matched","hash_xxh64":"0x1A5F679E38D55A85","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1422693412:1":{"text":"你给出了一个虚无缥缈的幻象，然后让更多人陷入疯狂……","source_cn":"你给出了一个虚无缥缈的幻象，然后让更多人陷入疯狂……","status":"matched","hash_xxh64":"0xBAB1DC2ADD7F4EDF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1422693413:1":{"text":"那么，灵露又有何不可呢？！","source_cn":"那么，灵露又有何不可呢？！","status":"matched","hash_xxh64":"0xD3B53096CFF1FFA4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1422693414:1":{"text":"比起你那只存在于幻梦中的情景，灵露至少实实在在地给予了肉体上的安宁。","source_cn":"比起你那只存在于幻梦中的情景，灵露至少实实在在地给予了...","status":"matched","hash_xxh64":"0xB81E8400D00BBB87","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1422693415:1":{"text":"但那最终会引导向孽化的结局。扭曲，变异，肉体腐败，彻底癫狂——","source_cn":"但那最终会引导向孽化的结局。扭曲，变异，肉体腐败，彻底...","status":"matched","hash_xxh64":"0x2D3BEA61327C71CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn