{"asset_key":"ep4/herohub_story_14411290","episode":"ep4","category":"herohub_story","story_id":"14411290","schema_version":1,"lang":"cn","texts":{"say:1:1441129001:1":{"text":"一国无主，群狼环伺，还有这无尽的公务和琐事……","source_cn":"一国无主，群狼环伺，还有这无尽的公务和琐事……","status":"matched","hash_xxh64":"0x69E91704373720C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1441129002:1":{"text":"因度厄可真是给我留下了不小的麻烦啊。","source_cn":"因度厄可真是给我留下了不小的麻烦啊。","status":"matched","hash_xxh64":"0x637A99E9AEB9DAD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1441129003:1":{"text":"难道我优美而闲散的生活就要这样结束了吗？","source_cn":"难道我优美而闲散的生活就要这样结束了吗？","status":"matched","hash_xxh64":"0xB45BE4E0D745FAE2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1441129004:1":{"text":"不行，他可别想躲着清闲……这些、还有这些……","source_cn":"不行，他可别想躲着清闲……这些、还有这些……","status":"matched","hash_xxh64":"0xEF422EB017B08790","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1441129005:1":{"text":"这些最麻烦的事全都交给他吧！","source_cn":"这些最麻烦的事全都交给他吧！","status":"matched","hash_xxh64":"0xFA902CA6343BA1F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"