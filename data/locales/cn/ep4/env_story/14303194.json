{"asset_key":"ep4/env_story_14303194","episode":"ep4","category":"env_story","story_id":"14303194","schema_version":1,"lang":"cn","texts":{"say:2:1430319401:1":{"text":"他是我们的英雄！而且我听说，他长得也很好看……","source_cn":"他是我们的英雄！而且我听说，他长得也很好看……","status":"matched","hash_xxh64":"0x178E6796B6419403","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1430319402:1":{"text":"他长得好看和你有什么关系？劝你不要随地做美梦。","source_cn":"他长得好看和你有什么关系？劝你不要随地做美梦。","status":"matched","hash_xxh64":"0x20EA374732FF542B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1430319403:1":{"text":"现在萨洛克兰没有贵族，艾塞勒平等……我这不是美梦，是梦想！","source_cn":"现在萨洛克兰没有贵族，艾塞勒平等……我这不是美梦，是梦想！","status":"matched","hash_xxh64":"0xB572AE0AF6E88276","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:平民维瑟尔":{"text":"平民维瑟尔","source":"平民维瑟尔","status":"source"},"speaker:平民艾德":{"text":"平民艾德","source":"平民艾德","status":"source"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}