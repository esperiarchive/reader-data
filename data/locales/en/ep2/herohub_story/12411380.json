{"asset_key":"ep2/herohub_story_12411380","episode":"ep2","category":"herohub_story","story_id":"12411380","schema_version":1,"lang":"en","texts":{"say:2:1241138001:1":{"text":"Here's the latest update: Tesio is making a scene and demanding to see you.","source_cn":"刚送来的消息：泰西欧很不安分，嚷着要见你。","status":"matched","hash_xxh64":"0xB157B1BDE8ED7B8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1241138002:1":{"text":"Should I go knock some sense into him?","source_cn":"我去让他安静几天？","status":"matched","hash_xxh64":"0xFA34AA25F46C8466","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1241138003:1":{"text":"No need for that. The trial's just around the corner.","source_cn":"不用。审判就快开始了。","status":"matched","hash_xxh64":"0xEE45630A32ACFE4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1241138004:1":{"text":"He's right about this—if I lay a finger on him now, it will just undermine the people's support for me.","source_cn":"他在这方面上没说错。现在动手，只会让我失去人心。","status":"matched","hash_xxh64":"0x3FBF946DC77E4A62","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1241138005:1":{"text":"We can deal with him after all the scores have been settled.","source_cn":"等到清算彻底完成，再动手也不迟。","status":"matched","hash_xxh64":"0xA8B772079750BDDC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}}