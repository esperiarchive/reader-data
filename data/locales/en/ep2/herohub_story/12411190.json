{"asset_key":"ep2/herohub_story_12411190","episode":"ep2","category":"herohub_story","story_id":"12411190","schema_version":1,"lang":"en","texts":{"say:3:1241119001:1":{"text":"Can magic bring people back to life?","source_cn":"魔法能让人死而复生吗？","status":"matched","hash_xxh64":"0x61031DBAE4386EC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1241119002:1":{"text":"I'm not talking about becoming a Graveborn. I mean truly... alive. Able to speak, laugh, and feel soft and warm.","source_cn":"不是说变成亡灵的那种复生。是真正的……像活着一样。会说...","status":"matched","hash_xxh64":"0x5A322AC4EB0254E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1241119003:1":{"text":"That's a dangerous question to ask!","source_cn":"好、好危险的问题！","status":"matched","hash_xxh64":"0xAEB491D90C88AD71","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1241119004:1":{"text":"I understand your thoughts. But the kind of revival you're looking for... no magic can achieve that.","source_cn":"我理解你的想法。但你想要的那种死而复生……没有魔法能做到。","status":"matched","hash_xxh64":"0xBE5B122846338B98","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1241119005:1":{"text":"...I understand. And I appreciate your honesty.","source_cn":"……我知道了。谢谢你的提醒。","status":"matched","hash_xxh64":"0xBA4AF4C9BB387071","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":3}}