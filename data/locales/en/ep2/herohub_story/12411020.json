{"asset_key":"ep2/herohub_story_12411020","episode":"ep2","category":"herohub_story","story_id":"12411020","schema_version":1,"lang":"en","texts":{"say:2:1241102001:1":{"text":"Well, to be honest, your timing couldn't have been worse.","source_cn":"嗯，说真的，你们来得不是时候。","status":"matched","hash_xxh64":"0x503747030DCA78C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1241102002:1":{"text":"My budget is tight as of late, but I'd love to treat you to some of Rustport's most famous seafood.","source_cn":"要不是最近周转不开，怎么也得带你们尝尝锈锚港特色的海鱼全宴。","status":"matched","hash_xxh64":"0x4D5186285F5D2A1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1241102003:1":{"text":"You'd go wild for a steaming plate of sharp-toothed eel. When cooked just right, it melts in your mouth! The taste is truly...","source_cn":"尤其是巨齿海鳗。只要做得好，入口即化！那味道真是……","status":"matched","hash_xxh64":"0x2F18F23F20273DB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1241102004:1":{"text":"You see, I'm happy to host, but of course, you'd have to foot the bill.","source_cn":"当然了，我请客归我请客，钱得你们掏。","status":"matched","hash_xxh64":"0x54C3604D3AF3A85A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1241102005:1":{"text":"...Huh? Is that what you consider hosting?!","source_cn":"……啊？这算什么请客呀！","status":"matched","hash_xxh64":"0x093B7868BDEB82E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}}