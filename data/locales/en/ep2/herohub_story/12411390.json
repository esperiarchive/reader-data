{"asset_key":"ep2/herohub_story_12411390","episode":"ep2","category":"herohub_story","story_id":"12411390","schema_version":1,"lang":"en","texts":{"say:2:1241139001:1":{"text":"Mr. Lucca, that's a beautiful belt you have there.","source_cn":"卢卡先生，你这条腰带好精致呀。","status":"matched","hash_xxh64":"0xEEB4F264AFD7F615","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1241139002:1":{"text":"This? It's a championship belt I won from an underground boxing match.","source_cn":"这个？冠军腰带，我从地下拳击场赢来的。","status":"matched","hash_xxh64":"0x195E5CE07F15C8AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1241139003:1":{"text":"It's proof of strength.","source_cn":"是力量的证明。","status":"matched","hash_xxh64":"0x392F7D6DDB8E9AEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1241139004:1":{"text":"By wearing it, those idiotic subordinates of Tesio won't have the guts to provoke me.","source_cn":"戴着它，跟着泰西欧干的那群废物就没胆挑衅我。","status":"matched","hash_xxh64":"0xCA7CA5DCA2D17BA1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}