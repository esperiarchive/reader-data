{"asset_key":"ep2/herohub_story_12411120","episode":"ep2","category":"herohub_story","story_id":"12411120","schema_version":1,"lang":"en","texts":{"say:3:1241112001:1":{"text":"Master Mage, why are you so fixated on my Hardhead?","source_cn":"魔法师大人，为什么盯着我的铁头瞧？","status":"matched_runtime_gender","hash_xxh64":"0x56C0C1065805F8E2","variant_status":"runtime_gender_keys_target_same","male":"Master Mage, why are you so fixated on my Hardhead?","female":"Master Mage, why are you so fixated on my Hardhead?","variant_male_record_index":"137516","variant_female_record_index":"137517","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1241112001":{"text":"Master Mage, why are you so fixated on my Hardhead?","source_cn":"魔法师大人，为什么盯着我的铁头瞧？","status":"matched_runtime_gender","hash_xxh64":"0x56C0C1065805F8E2","variant_status":"runtime_gender_keys_target_same","male":"Master Mage, why are you so fixated on my Hardhead?","female":"Master Mage, why are you so fixated on my Hardhead?","variant_male_record_index":"137516","variant_female_record_index":"137517","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1241112002:1":{"text":"Haha, the kid's got a head like granite, so I call him Hardhead.","source_cn":"哇哈哈，因为这孩子头很坚硬，所以我叫他铁头。","status":"matched_runtime_gender","hash_xxh64":"0x5B34C0BA4C2D484C","variant_status":"runtime_gender_keys_target_same","male":"Haha, the kid's got a head like granite, so I call him Hardhead.","female":"Haha, the kid's got a head like granite, so I call him Hardhead.","variant_male_record_index":"137518","variant_female_record_index":"137519","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1241112004:1":{"text":"Master Mage, come say hello to Hardhead!","source_cn":"魔法师大人，来和铁头打个招呼吧！","status":"matched_runtime_gender","hash_xxh64":"0x020C5DE9CC714FE9","variant_status":"runtime_gender_keys_target_same","male":"Master Mage, come say hello to Hardhead!","female":"Master Mage, come say hello to Hardhead!","variant_male_record_index":"137522","variant_female_record_index":"137523","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1241112004":{"text":"Master Mage, come say hello to Hardhead!","source_cn":"魔法师大人，来和铁头打个招呼吧！","status":"matched_runtime_gender","hash_xxh64":"0x020C5DE9CC714FE9","variant_status":"runtime_gender_keys_target_same","male":"Master Mage, come say hello to Hardhead!","female":"Master Mage, come say hello to Hardhead!","variant_male_record_index":"137522","variant_female_record_index":"137523","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1241112005:1":{"text":"Look there, Hardhead seems to have taken a liking to you! Ha!","source_cn":"没错，这就对了，铁头看起来对你印象不错哈哈哈！","status":"matched","hash_xxh64":"0x7D4479A2F371EA7B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1241112006:1":{"text":"You really seem to like these... creations... uh, little critters, of yours?","source_cn":"你看起来真的很喜欢这些……你造的……呃，小家伙？","status":"matched","hash_xxh64":"0xF8AFB91703C6DCCB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1241112007:1":{"text":"Little critters? I like that, it suits them!","source_cn":"小家伙？这个称呼不错，我喜欢！","status":"matched","hash_xxh64":"0x267190B35A70D5AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1241112008:1":{"text":"Would you care to pet them?","source_cn":"你想摸摸他们吗？","status":"matched","hash_xxh64":"0x309C9E533295C2F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1241112009:1":{"text":"Erm... I think I'll give it a miss!","source_cn":"呃……我、我想还是，不必了！","status":"matched","hash_xxh64":"0x5942C2F9DAB60BD0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1241112010:1":{"text":"Ah, not to worry! Hardhead, Fireside, and Shorty are all friendly kids.","source_cn":"不用介意！铁头，火墙，矮地都是很大方的孩子。","status":"matched","hash_xxh64":"0xF029B5692281855E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1241112011:1":{"text":"Except for Whistler. Bit shy, that one.","source_cn":"除了尖哨，他有点害羞，是个内敛的小家伙。","status":"matched","hash_xxh64":"0xA2321220515FD9EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1241112012:1":{"text":"Oh! You mean your leg...?","source_cn":"哦！你是说你的腿……","status":"matched","hash_xxh64":"0xB931CF1144C3682B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1241112013:1":{"text":"That's right—look, Whistler is my metal leg! Almost called it \"Dum-Dum,\" but it seemed like Whistler had more of a ring to it.","source_cn":"没错——瞧，尖哨就是我的金属腿！我本想叫它顿顿，但他觉...","status":"matched","hash_xxh64":"0x8A8A74998836518D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1241112014:1":{"text":"The names Hugin gave them really seem to fit!","source_cn":"呼金起的名字都很特别，而且和它们的特征很贴近！","status":"matched","hash_xxh64":"0x1F2ACAA81E5E8E74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1241112015:1":{"text":"Naming? Haha, I never bothered with that! They told me their own names!","source_cn":"起名？哈哈，我才不费这个脑筋！他们的名字都是他们自己告...","status":"matched","hash_xxh64":"0x185D91AE181E3F5F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1241112016:1":{"text":"What? They can talk?!","source_cn":"什么？他们会说话？？","status":"matched","hash_xxh64":"0xF84AD6B5A536BB96","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1241112017:1":{"text":"Of course! Little knight, hasn't your helmet told you its name?","source_cn":"当然！小骑士，你是不是还不知道你的金属头盔叫什么？","status":"matched","hash_xxh64":"0xB784B6F84EE276A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1241112018:1":{"text":"Chippy's helmet has a name too? Please, say it!","source_cn":"啊，我的头盔也有名字？告诉我吧，我很想知道！","status":"matched","hash_xxh64":"0xD0A018EBF58206E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1241112019:1":{"text":"Hmm, let me see... Oh, it's a quiet and steadfast one. It says its name is Mountain.","source_cn":"唔，让我看看……哦，这是个沉默坚毅的孩子，它说它叫默默。","status":"matched","hash_xxh64":"0x042A47D93DB36B91","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:23:1241112019":{"text":"Hmm, let me see... Oh, it's a quiet and steadfast one. It says its name is Mountain.","source_cn":"唔，让我看看……哦，这是个沉默坚毅的孩子，它说它叫默默。","status":"matched","hash_xxh64":"0x042A47D93DB36B91","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1241112020:1":{"text":"How did you achieve that?! You can really speak with them?","source_cn":"天呐！你是怎么做到的？！你难道能和它们说话吗？","status":"matched","hash_xxh64":"0x7B998055FA0E1274","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1241112021:1":{"text":"Not really. Most of the time I can only pick up on the feelings of the little guys I've created.","source_cn":"没有，大多数时候，我只能读懂我造出来的小家伙们的心思。","status":"matched","hash_xxh64":"0x652FF5FA7AB99901","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1241112022:1":{"text":"I suppose the reason I know the name of this helmet is probably because the little knight is upright and honest—what you see is what you get!","source_cn":"之所以能知道小骑士头盔的名字，大概是因为小骑士正直正义...","status":"matched","hash_xxh64":"0x21C25C514F2C98E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1241112023:1":{"text":"But this is an incredible skill! How do you do it?","source_cn":"但是！能读懂造物的名字也很厉害了！您是怎么做到的？","status":"matched","hash_xxh64":"0xF7C2D6D75EBB53A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1241112024:1":{"text":"I'm not sure either, haha!","source_cn":"我也不知道嚯！","status":"matched","hash_xxh64":"0x6684B2DF80682092","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1241112025:1":{"text":"How can this be? There really isn't some secret trick?","source_cn":"怎么会……？难道没有什么秘诀之类的吗？","status":"matched","hash_xxh64":"0xD49CAE07187918FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1241112026:1":{"text":"My master said we must be able to see the breath of our creations.","source_cn":"我的师傅说我们需要看到造物的呼吸。","status":"matched","hash_xxh64":"0xDD1E86951091C40F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1241112027:1":{"text":"Huh? Breath?","source_cn":"啊？呼吸？","status":"matched","hash_xxh64":"0x3BE887E9D9B9D6BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1241112028:1":{"text":"A unique soul can only be forged when the spirit and the breath of the creation are in perfect harmony.","source_cn":"只有心灵与造物的呼吸同频，才能锻炼出独一无二的灵魂。","status":"matched","hash_xxh64":"0x4B9A6429226FFB1B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1241112029:1":{"text":"Chippy's head is spinning...","source_cn":"越来越听不懂了……","status":"matched","hash_xxh64":"0x6C457FB1BE6D9C51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1241112030:1":{"text":"Don't be discouraged, Chippy. To reach Hugin's mastery, you'd have to dedicate decades of unwavering passion to forging.","source_cn":"满满别沮丧，要达到呼金的境界，应该要数十年如一日地倾注...","status":"matched","hash_xxh64":"0xF6E197F36ACAFAA4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1241112031:1":{"text":"Rather than saying Hugin forges unique souls from scratch, it's more accurate to say...","source_cn":"与其说是呼金锻造出了独一无二的灵魂，不如说……","status":"matched","hash_xxh64":"0x015EE064CF5D779C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1241112032:1":{"text":"He has embedded bits of his own soul into these little critters while forging with love, day in and day out.","source_cn":"他在日复一日的锻造中，把自己的灵魂赋予了这些小家伙。","status":"matched","hash_xxh64":"0xE14F0952EC162240","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1241112033:1":{"text":"Brilliantly said! Hear that? Hardhead and the others are applauding you!","source_cn":"哇嚯，说得太棒了！听，铁头他们在为你欢呼！","status":"matched","hash_xxh64":"0x78A82D6BDF4C33D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:23:0:1":{"text":"That's incredible!","source_cn":"好神奇","status":"matched_runtime_gender","hash_xxh64":"0x4635CECBA24E74CB","variant_status":"runtime_gender_keys_target_same","male":"That's incredible!","female":"That's incredible!","variant_male_record_index":"66948","variant_female_record_index":"66949","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:23:1:2":{"text":"Hard to believe!","source_cn":"难以置信","status":"matched_runtime_gender","hash_xxh64":"0x75F24FA1B2989DB4","variant_status":"runtime_gender_keys_target_same","male":"Hard to believe!","female":"Hard to believe!","variant_male_record_index":"66950","variant_female_record_index":"66951","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"Hello... Hardhead?","source_cn":"你好？铁头？","status":"matched_runtime_gender","hash_xxh64":"0xB0A6C101C53141E2","variant_status":"runtime_gender_keys_target_same","male":"Hello... Hardhead?","female":"Hello... Hardhead?","variant_male_record_index":"66944","variant_female_record_index":"66945","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"Ahem... Hardhead?","source_cn":"呃……铁头？","status":"matched_runtime_gender","hash_xxh64":"0x2A4023485BA7EF94","variant_status":"runtime_gender_keys_target_same","male":"Ahem... Hardhead?","female":"Ahem... Hardhead?","variant_male_record_index":"66946","variant_female_record_index":"66947","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"Hardhead?","source_cn":"铁头？","status":"matched_runtime_gender","hash_xxh64":"0x4B050672499173C0","variant_status":"runtime_gender_keys_target_same","male":"Hardhead?","female":"Hardhead?","variant_male_record_index":"66940","variant_female_record_index":"66941","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1241112003:1":{"text":"The name is Hardhead! Don't get it wrong, or he'll make ya sorry.","source_cn":"是铁头！别叫错了，这孩子会不高兴的。","status":"matched_runtime_gender","hash_xxh64":"0xE9A3D36B85CDC0A6","variant_status":"runtime_gender_keys_target_same","male":"The name is Hardhead! Don't get it wrong, or he'll make ya sorry.","female":"The name is Hardhead! Don't get it wrong, or he'll make ya sorry.","variant_male_record_index":"137520","variant_female_record_index":"137521","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:1:2":{"text":"You mean... your hammer?","source_cn":"你是说……你的锤子？","status":"matched_runtime_gender","hash_xxh64":"0xF41A47DCA6F0E821","variant_status":"runtime_gender_keys_target_same","male":"You mean... your hammer?","female":"You mean... your hammer?","variant_male_record_index":"66942","variant_female_record_index":"66943","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:呼金":{"text":"Hugin","source":"呼金","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":43,"localized_text_count":42,"speaker_count":3}}