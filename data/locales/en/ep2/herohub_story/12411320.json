{"asset_key":"ep2/herohub_story_12411320","episode":"ep2","category":"herohub_story","story_id":"12411320","schema_version":1,"lang":"en","texts":{"say:1:1241132001:1":{"text":"Dead Tide Fleet... Hmph, they have captured many of my peers.","source_cn":"死潮舰队……呵，他们抓了不少我的兄弟姐妹。","status":"matched","hash_xxh64":"0xDB070BBAEE5E803F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1241132002:1":{"text":"At least up until now, none of them has been converted into Graveborns, as far as I observe.","source_cn":"至少到现在，我还没有遇到被转化的人。","status":"matched","hash_xxh64":"0x63F6C994C3F7A47B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1241132003:1":{"text":"I vow to avenge their grievances one day.","source_cn":"但是我早晚会替他们报仇。我发誓。","status":"matched","hash_xxh64":"0x76FC0A38C18E3B3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}