{"asset_key":"ep2/herohub_story_12411060","episode":"ep2","category":"herohub_story","story_id":"12411060","schema_version":1,"lang":"en","texts":{"say:2:1241106001:1":{"text":"Amazing... truly fantastic!","source_cn":"神奇……真是神奇！","status":"matched","hash_xxh64":"0xA84E322471BEE1C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1241106002:1":{"text":"Er... Hugin, why are you watching me and Chippy so closely?","source_cn":"呃……呼金，你为什么一直盯着我和满满看？","status":"matched","hash_xxh64":"0xE23BE8BEC3E364D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1241106003:1":{"text":"Did I scare you? Don't mind me! It's just the first time I've seen a familiar, especially two chatty little hamsters!","source_cn":"吓着你们啦？别介意！我第一次亲眼瞧见使魔，还是两只能说...","status":"matched","hash_xxh64":"0xE78F5F365AEAADD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1241106004:1":{"text":"If only Whistler and Hardhead could run around and help me out, it would save so much trouble! Hahaha!","source_cn":"要是尖哨铁头他们也能满地乱跑，帮我一起忙前忙后就好了，...","status":"matched","hash_xxh64":"0xD1D5E21AFF0DAFDF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1241106005:1":{"text":"—That's it! I should build two mechanical hamsters to assist me! Would you two be willing to serve as prototypes?","source_cn":"——对！我得造两只机械仓鼠帮忙打下手！你们给我当设计原...","status":"matched","hash_xxh64":"0x4E9AC543E532C423","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:呼金":{"text":"Hugin","source":"呼金","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}}