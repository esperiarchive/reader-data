{"asset_key":"ep2/quest_story_12214170","episode":"ep2","category":"quest_story","story_id":"12214170","schema_version":1,"lang":"en","texts":{"say:2:1221417001:1":{"text":"Listen, Karl. This is my final lesson for you.","source_cn":"卡尔，听好，这是我教给你的最后一课。","status":"matched","hash_xxh64":"0xFBDFBAD9E4794822","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1221417002:1":{"text":"Remember... stop giving people random nicknames! My name's Chippy!","source_cn":"最后一课就是……不要给别人乱起外号啊！我叫满满！","status":"matched","hash_xxh64":"0x96F454FC7CD4DA6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1221417003:1":{"text":"Sorry, Master Ham—I mean, Master Chippy!","source_cn":"对不起！仓、啊不！满满老师！","status":"matched","hash_xxh64":"0x984EA0DD4AF5E8A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1221417004:1":{"text":"Karl, here's the money from selling the recipe. It's a little something from me as your master.","source_cn":"卡尔，这是刚才卖掉配方的钱，拿着吧，就当是我作为“战斗...","status":"matched","hash_xxh64":"0x5F62F281FE5877BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1221417005:1":{"text":"I can't take it! I haven't even paid you for your lessons!","source_cn":"不！老师教我变强，我还没付学费，我不能收钱！","status":"matched","hash_xxh64":"0x4EC8CE819797A637","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1221417006:1":{"text":"It isn't just a gift for you! I want you to learn from stronger masters, hone your skills, and protect your loved ones with the money.","source_cn":"并不是白白让你收下，你要好好利用这些钱，去拜访更强的老...","status":"matched","hash_xxh64":"0xF0DE7E78E21CBEEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1221417007:1":{"text":"You must become as confident, resilient, and brave as me. Can you do it?","source_cn":"你还要变得自信、坚强、勇敢，像满满我一样。怎么样，可以...","status":"matched","hash_xxh64":"0x05C3D376B614DB7B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1221417008:1":{"text":"...That's for sure! I—I believe I can!","source_cn":"……那是当然！我、我有这个信心！","status":"matched","hash_xxh64":"0x389685D1EF33DA05","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1221417009:1":{"text":"Very well, it's time for us to go.","source_cn":"很好，那么，我们该告别了。","status":"matched","hash_xxh64":"0xC5414277DA973D7B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1221417010:0":{"text":"*Sobbing*... I'll keep your words in mind, Master Hamster!","source_cn":"呜呜……我会记住您的话，仓鼠老师！","status":"matched","hash_xxh64":"0x956FF588E54AE5B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1221417011:1":{"text":"Again, my name is Chippy!","source_cn":"我看你根本就没记住！我叫满满！","status":"matched","hash_xxh64":"0xD7C09F0924D57980","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1221417012:1":{"text":"Keep up the good work, Karl! Until next time!","source_cn":"卡尔，你可要继续努力，再见啦！","status":"matched","hash_xxh64":"0xFDA3BB5BF05B9D82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:卡尔":{"text":"Karl","source":"卡尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":2}}