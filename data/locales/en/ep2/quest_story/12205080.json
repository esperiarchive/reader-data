{"asset_key":"ep2/quest_story_12205080","episode":"ep2","category":"quest_story","story_id":"12205080","schema_version":1,"lang":"en","texts":{"say:1:1220508001:1":{"text":"It's over... the angry pig scared all the little ones away!","source_cn":"完蛋了……那只发怒的猪把其它小猪都吓跑了！","status":"matched","hash_xxh64":"0xF50C2375B79172A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1220508002:1":{"text":"Hey, relax! It looks like they ran in the direction of the village.","source_cn":"先别紧张！看它们跑的方向，像是回村里去了。","status":"matched","hash_xxh64":"0xA4C9159B024B8CDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220508003:1":{"text":"Chippy, any ideas on how to calm this big pig?","source_cn":"满满，你有办法制服这只大猪吗？","status":"matched","hash_xxh64":"0x7729F981028A8876","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1220508004:1":{"text":"Huh?! Chippy is no pig whisperer!","source_cn":"哎——？！可满满不会驯兽啊！","status":"matched","hash_xxh64":"0x61C654BA495936F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1220508005:1":{"text":"Then I suppose we should head back and ask its owner how to deal with it.","source_cn":"要不然，我们先回去问问它的主人有没有驯服的办法？","status":"matched","hash_xxh64":"0x35424503A9BB06D1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220508006:1":{"text":"Chippy will stay here to keep an eye on that angry pig while you hurry to <style=\"highlight\">Brineville</style> to find a solution!","source_cn":"好像只能这样了……那满满留下来保护这只猪，免得它跑丢！...","status":"matched","hash_xxh64":"0x1FA3741DD79300C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":2}}