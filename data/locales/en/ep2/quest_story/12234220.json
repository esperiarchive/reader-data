{"asset_key":"ep2/quest_story_12234220","episode":"ep2","category":"quest_story","story_id":"12234220","schema_version":1,"lang":"en","texts":{"say:2:1223422001:1":{"text":"Renata, you scum!","source_cn":"雷纳塔那混球！","status":"matched","hash_xxh64":"0x0EB528905EEDBA8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1223422002:1":{"text":"Well, at least no one got injured. Let's go.","source_cn":"人就没事就行，该走了。","status":"matched","hash_xxh64":"0x196E29C900FB2153","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1223422003:1":{"text":"Argh... Damn it! Thoreau spent two whole days catching those fish, and they just blew them up like that!","source_cn":"可恶……可恶！梭罗花了两天两夜抓的鱼，全炸飞了！","status":"matched","hash_xxh64":"0x955FE09825ABE2FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1223422004:0":{"text":"The Carmine Whispers will get here soon! We have to go, Al!","source_cn":"血薇帮的人快到了，是时候跑路了！阿尔！","status":"matched","hash_xxh64":"0x6789F26B785DF87A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1223422005:1":{"text":"It's indeed the Water Wights' doing! Bring them all back!","source_cn":"果然是水鬼帮搞的鬼！全部带走！","status":"matched","hash_xxh64":"0x815730774E17F293","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1223422006:1":{"text":"No! Renata's behind this! It has nothing to do with us!","source_cn":"不！这都是雷纳塔搞的鬼，跟我们没关系！","status":"matched","hash_xxh64":"0x835B3AC0E01C2A7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1223422007:1":{"text":"Nonsense! Everyone in Rustport knows you Water Wights are running a fish stall. This cart is yours, right?","source_cn":"什么雷纳塔，现在全港口的人都知道你们水鬼在开鱼铺，这货...","status":"matched","hash_xxh64":"0xD9CC9BCC03C3138F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1223422008:1":{"text":"Oh, please! Why on earth would I bring my cart all the way here to blow it up? What can I gain from that?","source_cn":"你动动脑子！我特意把车推过来炸的吗？我能有什么好处！","status":"matched","hash_xxh64":"0x93A2BEFA52500CAA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1223422009:1":{"text":"Save your explanation for Lucca!","source_cn":"去和卢卡交代吧，少废话！","status":"matched","hash_xxh64":"0x74DC3D3587A4F836","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1223422009":{"text":"Save your explanation for Lucca!","source_cn":"去和卢卡交代吧，少废话！","status":"matched","hash_xxh64":"0x74DC3D3587A4F836