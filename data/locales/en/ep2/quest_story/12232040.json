{"asset_key":"ep2/quest_story_12232040","episode":"ep2","category":"quest_story","story_id":"12232040","schema_version":1,"lang":"en","texts":{"say:2:1223204001:1":{"text":"Hey, we agreed on the rate! Are you trying to weasel out of paying?!","source_cn":"混蛋啊！我们谈好的价格，你想赖账吗？！","status":"matched","hash_xxh64":"0xAAF9AF07FF6743FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1223204002:1":{"text":"It's funny to hear that accusation coming from a Water Wight.","source_cn":"赖账？这句话从你们水鬼帮嘴里说出来真是好笑。","status":"matched","hash_xxh64":"0xA67A079B97BF453C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1223204003:1":{"text":"Isn't this what you and your fellow thugs specialize in? Did you ever pay for the things you took from us?","source_cn":"这不是你们最擅长的吗，抢我们东西的时候，你们付过钱了吗？","status":"matched","hash_xxh64":"0x4DC0FE40ED8276CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1223204004:1":{"text":"Just cut the crap and pay for my hours!","source_cn":"别耍嘴皮子，帮你做了事，你就得付钱！","status":"matched","hash_xxh64":"0x209F80878FC2C436","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1223204005:1":{"text":"I will after you pay for what you stole before.","source_cn":"行啊，你先付抢的东西的钱。","status":"matched","hash_xxh64":"0x3032853139F6203E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1223204006:1":{"text":"Don't play games with me or you'll regret it!","source_cn":"别耍心眼，想吃点苦头是吧？","status":"matched","hash_xxh64":"0xA6AADDAF89DF4501","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1223204007:1":{"text":"Just try laying a finger on me! Everyone's watching!","source_cn":"你们敢动手吗？这段时间，大家都提着一口气盯着你们呢。","status":"matched","hash_xxh64":"0x5D32488FBC71B745","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1223204008:1":{"text":"If you touch me, you'll ruin your hard-earned...","source_cn":"你们要是动手，好不容易建立起来的……","status":"matched","hash_xxh64":"0xD9D7E928C072FEFD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1223204009:0":{"text":"Ugh! Who did that?!","source_cn":"哎呦，谁打我？","status":"matched","hash_xxh64":"0xB6D22460C7C86A4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1223204010:1":{"text":"Sir Chippy is here! No bullying is allowed under my watch, even if the victim's a Water Wight!","source_cn":"仓鼠骑士满满，不允许坏蛋在这里欺负人，即使欺负的是水鬼...","status":"matched","hash_xxh64":"0x3CDE983014B52F09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1223204011:1":{"text":"I see you've got some help. Do you think I'm scared?","source_cn":"好啊！你还叫了人是吧？我怕你们？","status":"matched","hash_xxh64":"0xEF0437F51891181F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1223204012:1":{"text":"Let's get'em, guys!","source_cn":"兄弟们，给我上！","status":"matched","hash_xxh64":"0x26C79522F4DFAE98","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:水鬼帮梭罗":{"text":"Wight Thoreau","source":"水鬼帮梭罗","status":"matched_dialogue_flow"},"speaker:蛮横的混混":{"text":"Rude Thug","source":"蛮横的混混","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":3}}