{"asset_key":"ep2/quest_story_12103320","episode":"ep2","category":"quest_story","story_id":"12103320","schema_version":1,"lang":"en","texts":{"say:3:1210332001:1":{"text":"After crossing the bridge in front, if you continue west, you'll reach the Whispers' shipyard.","source_cn":"过了前面的小木桥，继续往西，就是血薇帮的造船厂了。","status":"matched","hash_xxh64":"0x48F67406585683FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1210332002:1":{"text":"Sounds dangerous...","source_cn":"听起来很危险……","status":"matched","hash_xxh64":"0x34E79FF19AA0D93B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210332003:1":{"text":"Are you scared?","source_cn":"怕啦？","status":"matched","hash_xxh64":"0x13B420186F7906FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1210332003":{"text":"Are you scared?","source_cn":"怕啦？","status":"matched","hash_xxh64":"0x13B420186F7906FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210332005:1":{"text":"We can't let our guard down now. It's better to leave as soon as possible.","source_cn":"现在还不能放松警惕，还是早点离开这里比较好。","status":"matched","hash_xxh64":"0xBDDBB6015BC65292","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","doc