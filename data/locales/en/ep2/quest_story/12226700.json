{"asset_key":"ep2/quest_story_12226700","episode":"ep2","category":"quest_story","story_id":"12226700","schema_version":1,"lang":"en","texts":{"say:2:1222670001:1":{"text":"We've detained Nalianne and locked the assassin up in the high-security cell.","source_cn":"……事情就是这样，纳莉安我们暂时羁押起来，而西尔维娜被...","status":"matched","hash_xxh64":"0xA89B7E27DD4B7B59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1222670002:1":{"text":"And we found this on the assassin.","source_cn":"以及，我们从她身上找到了这个……","status":"matched","hash_xxh64":"0xEB71FD70B7016956","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:4::0":{"text":"Graveborn Relic","source_cn":"亡灵圣器","status":"matched","hash_xxh64":"0x250EAA1E289E7D25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1222670003:1":{"text":"The Void Relic, just like we thought. After all this trouble, it's finally in our hands.","source_cn":"……果然是班题斯圣器。兜兜转转，总算回到了我们的手上。","status":"matched","hash_xxh64":"0x8EA92DAE3EB7DA40","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1222670004:0":{"text":"Good. Now, bring in the assassin. I'll handle her interrogation.","source_cn":"很好，现在把那个亡灵杀手带来，我要亲自审讯她。","status":"matched","hash_xxh64":"0x9503E5B37270DAF7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1222670005:0":{"text":"Done, boss!","source_cn":"当家，人带过来了！","status":"matched","hash_xxh64":"0x19CABF91DF78AB33","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1222670006:1":{"text":"... I can walk on my own.","source_cn":"……我自己会走。","status":"matched","hash_xxh64":"0xE1BA9A25B6DEC0A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1222670007:1":{"text":"You're Silvina? What's your connection to the Dead Tide Fleet? And why steal the Void Relic?","source_cn":"你就是西尔维娜？你与死潮舰队是什么关系？为什么要抢夺班...","status":"matched","hash_xxh64":"0x3F8056BA2466692C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1222670008:1":{"text":"Let her go.","source_cn":"放了纳莉安。","status":"matched","hash_xxh64":"0xBEFEAC18890B868E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1222670009:1":{"text":"Hm?","source_cn":"什么？","status":"matched","hash_xxh64":"0x2F10522BBA1B0CFC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1222670010:1":{"text":"Let Nalianne go, and I'll talk.","source_cn":"先放了纳莉安，该说的我会说。","status":"matched","hash_xxh64":"0xF99DE6D964B67E19","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1222670011:0":{"text":"Fine. Vayne, go send word and tell them to release Nalianne.","source_cn":"可以。瓦因，你去传话，拿我的手令去把纳莉安放了。","status":"matched","hash_xxh64":"0xC14CA2CAE5957DC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1222670012:0":{"text":"You should know how the Whispers operate. We never go back on our word.","source_cn":"我们血薇帮的行事你应该也清楚，我不会出尔反尔，说放人就...","status":"matched","hash_xxh64":"0x189488DF9A62B954","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1222670013:1":{"text":"... Understood. I'll answer your questions.","source_cn":"……明白了，我会回答你的问题。","status":"matched","hash_xxh64":"0x851505CAB5E5EC03","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1222670014:1":{"text":"I'm from the Bantus Empire. I serve the king. Silencing, assassination, covert killings—that's my job.","source_cn":"我来自班题斯帝国，为骸骨之王效力。主要工作是封口、行刺...","status":"matched","hash_xxh64":"0xC47B88DC8FF21501","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1222670015:1":{"text":"Is there a difference between those?","source_cn":"这三件事有什么差别吗？","status":"matched","hash_xxh64":"0x8E8F3AC9D89D9F97","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1222670016:1":{"text":"Professionally? Yes.","source_cn":"从专业角度来说，差异很大。","status":"matched","hash_xxh64":"0xBD402D63FA9E7336","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1222670017:1":{"text":"Alright then... You came to Rustport for the Void Relic, didn't you?","source_cn":"好吧……西尔维娜小姐，你来到锈锚港，是为了班题斯圣器吗？","status":"matched","hash_xxh64":"0x6E3D0CEC5A1ED122","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1222670018:1":{"text":"For the king. I came to retrieve what's his.","source_cn":"我接受骸骨之王的命令，前来回收属于他的班题斯圣器。","status":"matched","hash_xxh64":"0x8A20A467421F40DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1222670019:1":{"text":"But I failed. That's it.","source_cn":"但我的任务已经失败，到此为止了。","status":"matched","hash_xxh64":"0xC30CBC37FE357B71","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1222670020:1":{"text":"You failed to get the relic. Your king won't just let it go, will he?","source_cn":"……圣器没能回收，骸骨之王不会就这样善罢甘休？","status":"matched","hash_xxh64":"0xB46C1351A1523A3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1222670021:1":{"text":"That's right.","source_cn":"没错。","status":"matched","hash_xxh64":"0xC8D40D82DFFDE8C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1222670022:0":{"text":"Once they hear about my failure, the Empire will send more assassins. They'll finish the job.","source_cn":"等我失败的消息传回帝国，会有第二批精英杀手来到锈锚港，...","status":"matched","hash_xxh64":"0xB0007AC7098B0E90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1222670023:0":{"text":"I see. Take her back to the cell.","source_cn":"我知道了。来人，带她回牢房。","status":"matched","hash_xxh64":"0xC54ABE4DBE62EB8F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:35:1222670024:0":{"text":"After Silvina is led away, Sonja stands there, thinking...","source_cn":"西尔维娜被带走后，索尼娅陷入沉思——","status":"matched","hash_xxh64":"0xC084B443757A364E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1222670025:0":{"text":"From what she said, the Bantus Empire will keep coming after the relic.","source_cn":"索尼娅，听她的意思，班题斯帝国还会派人来锈锚港抢夺圣器。","status":"matched","hash_xxh64":"0x0C097D4A07341D78","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1222670026:0":{"text":"As long as we have it, the fighting won't stop...","source_cn":"只要留着圣器，锈锚港的纷争将会没完没了……","status":"matched","hash_xxh64":"0xC7B900C0CF784671","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1222670027:1":{"text":"Is the relic even useful to the Carmine Whispers?","source_cn":"圣器对血薇帮来说有什么用吗？","status":"matched","hash_xxh64":"0x77EB3AA1841D0E82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1222670028:1":{"text":"No, but we're more worried about it falling into the hands of people like the Dead Tide Fleet.","source_cn":"没用，但我们担心圣器回到死潮舰队手中。","status":"matched","hash_xxh64":"0x79B95B03F267FA22","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1222670029:1":{"text":"Maybe... we could just give it to Silvina.","source_cn":"或许……交给西尔维娜也是一种选择。","status":"matched","hash_xxh64":"0x9459C5D3A0988236","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1222670030:1":{"text":"If you don't let her go, what are you planning to do with her?","source_cn":"如果不放走她，你们打算怎么处置她呢？","status":"matched","hash_xxh64":"0xA522540B473F06F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1222670031:0":{"text":"I haven't decided yet. I need more time to think.","source_cn":"我还没想好，请再给我一些时间。","status":"matched","hash_xxh64":"0x2364D1375D85B762","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:探子瓦因":{"text":"Vayne","source":"探子瓦因","status":"matched_dialogue_flow"},"speaker:西尔维娜":{"text":"Silvina","source":"西尔维娜","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:黑屏":{"text":"Black Screen","source":"黑屏","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":33,"localized_text_count":32,"speaker_count":7}}