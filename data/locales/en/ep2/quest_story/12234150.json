{"asset_key":"ep2/quest_story_12234150","episode":"ep2","category":"quest_story","story_id":"12234150","schema_version":1,"lang":"en","texts":{"say:3:1223415001:1":{"text":"*Woof*Woof*","source_cn":"汪！汪汪！","status":"matched","hash_xxh64":"0x6D69E4122176A0EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1223415002:1":{"text":"Attagirl!","source_cn":"干得好，好姑娘！","status":"matched","hash_xxh64":"0xD7E787610F83262C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1223415003:0":{"text":"*Woof*","source_cn":"唔~","status":"matched","hash_xxh64":"0xD5BFFF36147408B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1223415004:1":{"text":"There's a hidden tree door here!","source_cn":"这里有一个隐蔽的树门！","status":"matched","hash_xxh64":"0xA08E225A16140AE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1223415005:1":{"text":"Looks like I came at just the right time.","source_cn":"看来我来的正是时候。","status":"matched","hash_xxh64":"0xAD26B9665C7A14DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1223415006:0":{"text":"How did you find your way here?","source_cn":"你怎么找到这里的？","status":"matched","hash_xxh64":"0x5F663A478E2D391A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1223415007:0":{"text":"Paz left marks along the way that only Water Wights can recognize.","source_cn":"帕斯在路上做了标记，只有水鬼能看懂。","status":"matched","hash_xxh64":"0x0ECA780405D4D268","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1223415008:0":{"text":"Renata and her men are at it again. We have to teach them a lesson this time!","source_cn":"又是雷纳塔干的，准备好打一架吧。","status":"matched","hash_xxh64":"0x004C194EF2E2B3EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1223415009:0":{"text":"I can't wait to give them a good beating!","source_cn":"我早就想揍他们了！","status":"matched","hash_xxh64":"0xCE149B07CE9BDF4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1223415010:1":{"text":"Shh! As you've surely noticed, many Carmine Whispers are patrolling this area.","source_cn":"嘘——你们应该也注意到了，这里有很多血薇帮的人在巡逻。","status":"matched","hash_xxh64":"0xA80F41B24DA15D5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1223415011:1":{"text":"This is their territory, and it's dangerous for you to be here.","source_cn":"这是血薇帮的地盘，你们出现在这很危险的。","status":"matched","hash_xxh64":"0xE753F4A028356DFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1223415012:1":{"text":"<style=\"stress\"><player_name></style>, the hamster lady's right. We aren't supposed to be here.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xC67048070639FE22","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, the hamster lady's right. We aren't supposed to be here.","female":"<style=\"stress\"><player_name></style>, the hamster lady's right. We aren't supposed to be here.","variant_male_record_index":"138689","variant_female_record_index":"138690","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1223415013:0":{"text":"But we have to get our buddy out of here anyway. How about we disguise ourselves?","source_cn":"但人还是要救的，不然咱们伪装一下？","status":"matched_runtime_gender","hash_xxh64":"0xC2705DAD1E6C5902","variant_status":"runtime_gender_keys_target_same","male":"But we have to get our buddy out of here anyway. How about we disguise ourselves?","female":"But we have to get our buddy out of here anyway. How about we disguise ourselves?","variant_male_record_index":"138691","variant_female_record_index":"138692","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:25:1223415013":{"text":"But we have to get our buddy out of here anyway. How about we disguise ourselves?","source_cn":"但人还是要救的，不然咱们伪装一下？","status":"matched_runtime_gender","hash_xxh64":"0xC2705DAD1E6C5902","variant_status":"runtime_gender_keys_target_same","male":"But we have to get our buddy out of here anyway. How about we disguise ourselves?","female":"But we have to get our buddy out of here anyway. How about we disguise ourselves?","variant_male_record_index":"138691","variant_female_record_index":"138692","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1223415014:0":{"text":"That's brilliant! But we don't have their uniforms...","source_cn":"好主意！但我们没有血薇帮的衣服……","status":"matched_runtime_gender","hash_xxh64":"0x9685F86AFAB00BEA","variant_status":"runtime_gender_keys_target_same","male":"That's brilliant! But we don't have their uniforms...","female":"That's brilliant! But we don't have their uniforms...","variant_male_record_index":"138693","variant_female_record_index":"138694","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1223415015:0":{"text":"This is simple—you can pretend to be captured by Magister, who is going to be dressed like a Carmine Whisper!","source_cn":"这简单，假装你们是被主人这个血薇帮成员抓住的水鬼不就行了？","status":"matched","hash_xxh64":"0x8B6F663CBCC2828C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1223415016:0":{"text":"Sounds good. Let's do it!","source_cn":"有道理，那就走吧！","status":"matched_runtime_gender","hash_xxh64":"0x06BCF520EC1084E0","variant_status":"runtime_gender_keys_target_same","male":"Sounds good. Let's do it!","female":"Sounds good. Let's do it!","variant_male_record_index":"138696","variant_female_record_index":"138697","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:0:1":{"text":"Should I dress as a Whisper?","source_cn":"我扮成血薇帮？","status":"matched_runtime_gender","hash_xxh64":