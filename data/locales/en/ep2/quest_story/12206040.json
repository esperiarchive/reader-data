{"asset_key":"ep2/quest_story_12206040","episode":"ep2","category":"quest_story","story_id":"12206040","schema_version":1,"lang":"en","texts":{"say:1:1220604001:1":{"text":"Stop right there! Come any closer and I won't be taking any prisoners!","source_cn":"站住！再敢靠近一步，我就不客气了！","status":"matched","hash_xxh64":"0x2F59B31CD801E1A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1220604002:1":{"text":"Go on then, do your worst.","source_cn":"来啊，快来打我啊。","status":"matched","hash_xxh64":"0x58613A94EE1670D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220604003:1":{"text":"You better not underestimate me!","source_cn":"别小看人！","status":"matched","hash_xxh64":"0x4F450DC3C94563DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1220604004:1":{"text":"Ha! That all you can muster up? This is beyond pathetic.","source_cn":"噢，就这么点力气吗？这种力道也算打人？真让人发笑。","status":"matched","hash_xxh64":"0xAEDFBE1F7BB3CCF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220604005:1":{"text":"Quit jawing and grab what's in her hands! It's worth a ton!","source_cn":"别跟她废话了，她手里的东西很不错，抢过来！","status":"matched","hash_xxh64":"0x1BF07EE18190ED02","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title