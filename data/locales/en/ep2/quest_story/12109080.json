{"asset_key":"ep2/quest_story_12109080","episode":"ep2","category":"quest_story","story_id":"12109080","schema_version":1,"lang":"en","texts":{"say:1:1210908001:1":{"text":"Ah... Is everyone alright?","source_cn":"唉……果然中招了……大家都没事吧？","status":"matched","hash_xxh64":"0x6EB38EBEDFD74DF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1210908002:1":{"text":"One, two, three, four, five... With me, there's six. Whew, everyone's okay!","source_cn":"一、二、三、四、五……算上我，六个。还好还好……都在。","status":"matched","hash_xxh64":"0x4362BA0C08FEB7FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1210908002":{"text":"One, two, three, four, five... With me, there's six. Whew, everyone's okay!","source_cn":"一、二、三、四、五……算上我，六个。还好还好……都在。","status":"matched","hash_xxh64":"0x4362BA0C08FEB7FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1210908003:1":{"text":"That's right.","source_cn":"没错。","status":"matched_runtime_gender","hash_xxh64":"0x21C71526BAA2F65D","variant_status":"runtime_gender_keys_target_same","male":"That's right.","female":"That's right.","variant_male_record_index":"130702","variant_female_record_index":"130703","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210908005:1":{"text":"That was a trap, designed to teleport anyone who opens it without permission to dangerous places.","source_cn":"那个宝箱是陷阱宝箱，会把擅自打开它的人传送到某些危险区域。","status":"matched","hash_xxh64":"0xB6C44B8920DB8D7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210908006:1":{"text":"Those traps are usually meant for thieves, teleporting them into pits filled with knives or cages with hungry lions...","source_cn":"这种陷阱一般用来对付盗贼，往往会把人传到什么布满了刀的...","status":"matched","hash_xxh64":"0x2908C686453369EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1210908007:1":{"text":"But we got lucky. This place doesn't seem very dangerous.","source_cn":"……看来我们运气好，这附近不像有什么机关。","status":"matched","hash_xxh64":"0x1BE8B0A35F0B48E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210908008:1":{"text":"Sorry, Sonja... It's my fault for getting too excited.","source_cn":"对、对不起，索尼娅姐姐，是我……太贪玩了。","status":"matched","hash_xxh64":"0x6C2D46B1E2EB9AD0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210908009:1":{"text":"Don't blame yourself, Nara. Chippy would do the same thing in front of pretty treasure like that!","source_cn":"不怪奈拉啦，要是满满看到宝箱，也会第一时间打开的。","status":"matched","hash_xxh64":"0x23E6753810F006B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1210908009":{"text":"Don't blame yourself, Nara. Chippy would do the same thing in front of pretty treasure like that!","source_cn":"不怪奈拉啦，要是满满看到宝箱，也会第一时间打开的。","status":"matched","hash_xxh64":"0x23E6753810F006B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210908010:1":{"text":"<style=\"stress\"><player_name></style>... That's your name, right?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xE5A3344EB836A011","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>... That's your name, right?","female":"<style=\"stress\"><player_name></style>... That's your name, right?","variant_male_record_index":"130711","variant_female_record_index":"130712","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1210908011:1":{"text":"You're even comforting me. You're so kind!","source_cn":"你不怪我，还安慰我！你真好！","status":"matched_runtime_gender","hash_xxh64":"0x6FC7CA1DFD3AFF52","variant_status":"runtime_gender_keys_target_same","male":"You're even comforting me. You're so kind!","female":"You're even comforting me. You're so kind!","variant_male_record_index":"130713","variant_female_record_index":"130714","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1210908013:1":{"text":"Nara, you agreed not to act too impulsively.","source_cn":"奈拉，我们约定好了，不能冲动。","status":"matched","hash_xxh64":"0xE7E1BD24DCA91CD8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1210908014:1":{"text":"I pinky promise, it won't happen again!","source_cn":"拉钩钩，约定不会变！","status":"matched","hash_xxh64":"0x1235979BF4DAF90F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1210908015:1":{"text":"Alright, alright, enough with the lecture. Let's get out of here.","source_cn":"好了好了，对小孩的教育就到此为止，我们赶紧离开吧。","status":"matched","hash_xxh64":"0x1EEBA51F98596247","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1210908016:1":{"text":"Even though there aren't any visible dangers nearby, we should still be cautious.","source_cn":"毕竟这里是陷阱区，虽然一时半会还没遇到危险，但是小心点...","status":"matched","hash_xxh64":"0x1BE02970270201B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1210908017:1":{"text":"Sonja, could you hold my hand?","source_cn":"姐姐，可以抓住我的手吗？","status":"matched","hash_xxh64":"0x323390E97EF66096","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1210908018:1":{"text":"... Yes. Let's go.","source_cn":"……嗯。走吧。","status":"matched","hash_xxh64":"0x897B0971C5D3248D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"It's alright, Nara.","source_cn":"嗯，不是奈拉的错","status":"matched_runtime_gender","hash_xxh64":"0xFB86DF98BDB4B582","variant_status":"runtime_gender_keys_target_same","male":"It's alright, Nara.","female":"It's alright, Nara.","variant_male_record_index":"65768","variant_female_record_index":"65769","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1210908012:1":{"text":"Yes... I know adults don't like disobedient kids. I'll be better next time!","source_cn":"知道了……下次我会听话的……","status":"matched_runtime_gender","hash_xxh64":"0xF93ABB85CCA39A41","variant_status":"runtime_gender_keys_target_same","male":"Yes... I know adults don't like disobedient kids. I'll be better next time!","female":"Yes... I know adults don't like disobedient kids. I'll be better next time!","variant_male_record_index":"130715","variant_female_record_index":"130716","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:1:2":{"text":"You should be more careful.","source_cn":"下次要谨慎","status":"matched_runtime_gender","hash_xxh64":"0x7359164D1DB763F6","variant_status":"runtime_gender_keys_target_same","male":"You should be more careful.","female":"You should be more careful.","variant_male_record_index":"65770","variant_female_record_index":"65771","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"We've been teleported again?","source_cn":"我们又被传送了？","status":"matched_runtime_gender","hash_xxh64":"0x69530DC0EDF6F3DD","variant_status":"runtime_gender_keys_target_same","male":"We've been teleported again?","female":"We've been teleported again?","variant_male_record_index":"65764","variant_female_record_index":"65765","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1210908004