{"asset_key":"ep2/quest_story_12204460","episode":"ep2","category":"quest_story","story_id":"12204460","schema_version":1,"lang":"en","texts":{"say:1:1220446001:0":{"text":"Mr. Stanton, I look forward to our cooperation.","source_cn":"斯坦顿先生，合作愉快。","status":"matched","hash_xxh64":"0x760CC65D7AF4E3A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1220446002:0":{"text":"I can't believe it. I've become a pro boxer!","source_cn":"简直不敢相信……我、我成为职业拳手了！","status":"matched","hash_xxh64":"0x64ABC341B4A6A9C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220446003:0":{"text":"Thank you... I don't know what to say, but I'm really grateful for your help.","source_cn":"谢谢……我……我不知道该说什么好，但真的很感谢你们的帮助。","status":"matched","hash_xxh64":"0x54C819D08C3F094A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1220446004:0":{"text":"Sir, you said you wanted me to agree to a condition... can you tell me what it is now?","source_cn":"卢卡先生，你说过要我答应你一个条件，现在可以告诉我是什...","status":"matched","hash_xxh64":"0x01B22D1EFD6174F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220446005:0":{"text":"Sonja rescued me years ago, and I've shown my worth, proving her judgment correct.","source_cn":"索尼娅当年救了我，我已经证明了自己，证明了她的眼光没错。","status":"matched","hash_xxh64":"0x07EF45CF9038E19F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1220446006:0":{"text":"As for you, you must bring home a champion's belt to prove that mine was. Got it, kid?","source_cn":"而你，你要拿着冠军的金腰带来见我，证明我的眼光也没错。...","status":"matched","hash_xxh64":"0x5E4DA32471095B29","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1220446007:0":{"text":"I understand, sir! I'll do it. I promise I will!","source_cn":"我记住了，卢卡先生！我会做到的……我一定会！","status":"matched","hash_xxh64":"0xF05416692297116A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1220446008:0":{"text":"Alright, kid, go do your thing. I'll be waiting for that day.","source_cn":"好了，小子，做你该做的事情去吧，我等着你证明自己的那天。","status":"matched","hash_xxh64":"0x19D489EF7AF5F1E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:拳击掮客希尔森":{"text":"Broker Hilson","source":"拳击掮客希尔森","status":"matched_dialogue_flow"},"speaker:地下拳手斯坦顿":{"text":"Boxer Stanton","source":"地下拳手斯坦顿","status":"matched_dialogue_flow"},"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":3}}