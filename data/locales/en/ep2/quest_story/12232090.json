{"asset_key":"ep2/quest_story_12232090","episode":"ep2","category":"quest_story","story_id":"12232090","schema_version":1,"lang":"en","texts":{"say:2:1223209001:0":{"text":"Brrr... Ugh... I'm so cold...","source_cn":"嚯……嗬……好冷……","status":"matched","hash_xxh64":"0xC0E985E534AB1339","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1223209002:0":{"text":"What's going on, Paz? How come you look so sick?","source_cn":"怎么回事，帕斯，怎么跟个痨病鬼似的。","status":"matched","hash_xxh64":"0xC6AA396AA63CECFE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1223209003:0":{"text":"Non... sense! I...","source_cn":"说什么……鬼话！老子……","status":"matched","hash_xxh64":"0x9B9946AE124BAAF7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1223209004:0":{"text":"Get hold of yourself! Your knees are buckling!","source_cn":"喂！站稳了！怎么还摔倒了！","status":"matched","hash_xxh64":"0x59485D4BAD4B3479","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1223209005:0":{"text":"I'm... perfectly... fine!","source_cn":"老子……精神得……很！","status":"matched","hash_xxh64":"0x6AD80231C72F9B7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1223209006:0":{"text":"Let me see... You're burning up! You have a fever, idiot!","source_cn":"让我看看，温度这么高？！帕斯发烧了，该死！","status":"matched","hash_xxh64":"0xB5FB8B74FA145B57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1223209007:0":{"text":"This is not something you can just tough it out! Hey, you alright?! Talk to me, Paz!","source_cn":"能挺过去吗？帕斯，回答我！","status":"matched","hash_xxh64":"0xFDCC629C44FC7143","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1223209008:0":{"text":"Ugh... Grr...","source_cn":"嗬、嗬……","status":"matched","hash_xxh64":"0x11C5AA5C69149E09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1223209009:0":{"text":"He's in bad shape; he needs medication immediately.","source_cn":"他的情况看起来很糟糕，得赶紧用药。","status":"matched","hash_xxh64":"0xE5AF7ABD6DB71CD2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1223209010:0":{"text":"Barnacles! We got no medicine right now!","source_cn":"该死！我们没有药！","status":"matched","hash_xxh64":"0xBC29B16F031F88D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1223209010":{"text":"Barnacles! We got no medicine right now!","source_cn":"该死！我们没有药！","status":"matched","hash_xxh64":"0xBC29B16F031F88D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1223209011:1":{"text":"I mean everybody gets sick one time or another. We usually just tough it out.","source_cn":"生病很常见，一般都能硬挨过去。","status":"matched_runtime_gender","hash_xxh64":"0xF087767CE900A9F6","variant_status":"runtime_gender_keys_target_same","male":"I mean everybody gets sick one time or another. We usually just tough it out.","female":"I mean everybody gets sick one time or another. We usually just tough it out.","variant_male_record_index":"139921","variant_female_record_index":"139922","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1223209012:1":{"text":"If things get real bad, we'll make fish soup or use some herbs.","source_cn":"实在情况糟糕，就熬一大碗鱼汤或者搞点药草。","status":"matched_runtime_gender","hash_xxh64":"0x21CFB60F2247E269","variant_status":"runtime_gender_keys_target_same","male":"If things get real bad, we'll make fish soup or use some herbs.","female":"If things get real bad, we'll make fish soup or use some herbs.","variant_male_record_index":"139924","variant_female_record_index":"139925","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1223209013:1":{"text":"But we don't have time to prepare any of those now!","source_cn":"可恶，现在去弄鱼汤和药草也来不及了！","status":"matched_runtime_gender","hash_xxh64":"0xEE78D17F9389F20E","variant_status":"runtime_gender_keys_target_same","male":"But we don't have time to prepare any of those now!","female":"But we don't have time to prepare any of those now!","variant_male_record_index":"139926","variant_female_record_index":"139927","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1223209016:0":{"text":"<style=\"stress\"><player_name></style>, can you help him?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x7D48492815AE46D3","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, can you help him?","female":"<style=\"stress\"><player_name></style>, can you help him?","variant_male_record_index":"139932","variant_female_record_index":"139933","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:19:1223209016":{"text":"<style=\"stress\"><player_name></style>, can you help him?","source_cn":"<style=stress><player_name></style>，能救救他吗？","status":"matched_runtime_gender","hash_xxh64":"0x7D48492815AE46D3","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, can you help him?","female":"<style=\"stress\"><player_name></style>, can you help him?","variant_male_record_index":"139932","variant_female_record_index":"139933","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1223209017:0":{"text":"You guys are lucky. Your friend would be in danger if weren't for the Magister.","source_cn":"你们运气好，要不是主人会炼药，他就危险了。","status":"matched_runtime_gender","hash_xxh64":"0xF6E2EDB42653B16D","variant_status":"runtime_gender_keys_target_same","male":"You guys are lucky. Your friend would be in danger if weren't for the Magister.","female":"You guys are lucky. Your friend would be in danger if weren't for the Magister.","variant_male_record_index":"139934","variant_female_record_index":"139935","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1223209018:0":{"text":"If you manage to save Paz, we Water Wights will forever be in your debt!","source_cn":"如果你能救我兄弟，以后水鬼让你随便差遣！","status":"matched_runtime_gender","hash_xxh64":"0x5AE22DC3270519C8","variant_status":"runtime_gender_keys_target_same","male":"If you manage to save Paz, we Water Wights will forever be in your debt!","female":"If you manage to save Paz, we Water Wights will forever be in your debt!","variant_male_record_index":"139936","variant_female_record_index":"139937","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1223209019:1":{"text":"You don't need to make that promise. There's nothing we need from you anyway.","source_cn":"咳咳，倒也不用发这样的誓言，我们也没什么需要差遣你们的。","status":"matched","hash_xxh64":"0x0CC4E4D936CF699E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1223209020:0":{"text":"Just know that the magister's <style=\"highlight\">anti-fever elixir</style> is going to cure Paz.","source_cn":"放心吧，梅林炼制的<style=highlight>驱...","status":"matched_runtime_gender","hash_xxh64":"0x69EC6399422664FC","variant_status":"runtime_gender_keys_target_same","male":"Just know that the magister's <style=\"highlight\">anti-fever elixir</style> is going to cure Paz.","female":"Just know that the magister's <style=\"highlight\">anti-fever elixir</style> is going to cure Paz.","variant_male_record_index":"139939","variant_female_record_index":"139940","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1223209021:1":{"text":"I'm counting on you...","source_cn":"那就拜托了……","status":"matched_runtime_gender","hash_xxh64":"0x6C5B0D535FD9A653","variant_status":"runtime_gender_keys_target_same","male":"I'm counting on you...","female":"I'm counting on you...","variant_male_record_index":"139941","variant_female_record_index":"139942","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:0:1":{"text":"Let me prepare a potion.","source_cn":"我来弄药","status":"matched_runtime_gender","hash_xxh64":"0x59EBCC7A34A011F4","variant_status":"runtime_gender_keys_target_same","male":"Let me prepare a potion.","female":"Let me prepare a potion.","variant_male_record_index":"67594","variant_female_record_index":"67595","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:1:2":{"text":"Okay.","source_cn":"行吧","status":"matched_runtime_gender","hash_xxh64":"0x9083011DB661877E","variant_status":"runtime_gender_keys_target_same","male":"Okay.","female":"Okay.","variant_male_record_index":"67596","variant_female_record_index":"67597","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"Why?","source_cn":"为什么没药","status":"matched_runtime_gender","hash_xxh64":"0x34BF5FE232BAD23C","variant_status":"runtime_gender_keys_target_same","male":"Why?","female":"Why?","variant_male_record_index":"67588","variant_female_record_index":"67589","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1223209014:1":{"text":"We can't afford a doctor, and those doctors look down on us.","source_cn":"……我们从来没钱去看医生，那些医生也不待见我们。","status":"matched_runtime_gender","hash_xxh64":"0x7084E1A87F575DA4","variant_status":"runtime_gender_keys_target_same","male":"We can't afford a doctor, and those doctors look down on us.","female":"We can't afford a doctor, and those doctors look down on us.","variant_male_record_index":"139928","variant_female_record_index":"139929","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:1:2":{"text":"Get a doctor here.","source_cn":"去找医生看看","status":"matched_runtime_gender","hash_xxh64":"0xEE7D13866D8CA1DB","variant_status":"runtime_gender_keys_target_same","male":"Get a doctor here.","female":"Get a doctor here.","variant_male_record_index":"67590","variant_female_record_index":"67591","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1223209015:1":{"text":"His teeth are chattering. If we don't act soon, it'll be hard to feed him the medicine later.","source_cn":"他牙齿都在打颤了，再过一会怕是药都灌不进去。","status":"matched_runtime_gender","hash_xxh64":"0x6DABD7D57B2BCE62","variant_status":"runtime_gender_keys_target_same","male":"His teeth are chattering. If we don't act soon, it'll be hard to feed him the medicine later.","female":"His teeth are chattering. If we don't act soon, it'll be hard to feed him the medicine later.","variant_male_record_index":"139930","variant_female_record_index":"139931","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:2:3":{"text":"Don't worry, it's just fever.","source_cn":"发烧而已，不要慌","status":"matched_runtime_gender","hash_xxh64":"0x87486574B4EF4974","variant_status":"runtime_gender_keys_target_same","male":"Don't worry, it's just fever.","female":"Don't worry, it's just fever.","variant_male_record_index":"67592","variant_female_record_index":"67593","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:水鬼帮帕斯":{"text":"Wight Paz","source":"水鬼帮帕斯","status":"matched_dialogue_flow"},"speaker:水鬼帮阿尔":{"text":"Wight Al","source":"水鬼帮阿尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"m