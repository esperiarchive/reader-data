{"asset_key":"ep2/quest_story_12206060","episode":"ep2","category":"quest_story","story_id":"12206060","schema_version":1,"lang":"en","texts":{"say:1:1220606001:1":{"text":"You're not from the village.","source_cn":"你们不是村里的人。","status":"matched","hash_xxh64":"0xDCE782902D2DD46F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1220606001":{"text":"You're not from the village.","source_cn":"你们不是村里的人。","status":"matched","hash_xxh64":"0xDCE782902D2DD46F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1220606002:1":{"text":"But... you used magic just now, didn't you? You seem more like a mage than a captain.","source_cn":"但是……你刚才用的是魔法吧？比起船长，你更像是个魔法师。","status":"matched_runtime_gender","hash_xxh64":"0x7991F9C7CA85229E","variant_status":"runtime_gender_keys_target_same","male":"But... you used magic just now, didn't you? You seem more like a mage than a captain.","female":"But... you used magic just now, didn't you? You seem more like a mage than a captain.","variant_male_record_index":"135988","variant_female_record_index":"135989","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1220606006:1":{"text":"You should hurry back to the village. Chippy bet your mother is very worried about you.","source_cn":"快点回村子吧，你的妈妈很担心你。","status":"matched","hash_xxh64":"0xE153125C79EB8E4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1220606007:1":{"text":"Alright... I've been out long enough. Let me just get my bag... Oh no!","source_cn":"好吧……我出来得也够久了，等我拿上我的小包……天呐！","status":"matched","hash_xxh64":"0xAB232DD9512041E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220606008:1":{"text":"What happened?","source_cn":"发生什么了？","status":"matched","hash_xxh64":"0x98148B02B964260D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1220606009:1":{"text":"Those slimy Water Wights! They... they just ripped up the star map from my bag!","source_cn":"这些该死的水鬼！他们……他们刚才扯坏了我包里的星座图！","status":"matched","hash_xxh64":"0x399F4D338A258E75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1220606010:1":{"text":"I spent so many nights under the stars drawing it... *sniffle*... How could they?","source_cn":"那是我花了好多个晚上，对着星空一笔一笔画出来的……呜呜……","status":"matched","hash_xxh64":"0x404EEAF029A5B0B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1220606010":{"text":"I spent so many nights under the stars drawing it... *sniffle*... How could they?","source_cn":"那是我花了好多个晚上，对着星空一笔一笔画出来的……呜呜……","status":"matched","hash_xxh64":"0x404EEAF029A5B0B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":