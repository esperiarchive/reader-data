{"asset_key":"ep2/quest_story_12226470","episode":"ep2","category":"quest_story","story_id":"12226470","schema_version":1,"lang":"en","texts":{"say:3:1222647001:1":{"text":"Good morning.","source_cn":"早上好。","status":"matched","hash_xxh64":"0x5481691EBFC39BF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1222647002:0":{"text":"Lucca, you're awake!","source_cn":"卢卡！你醒了！","status":"matched","hash_xxh64":"0x1CCEF3AF496E3776","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1222647003:1":{"text":"Sorry for the trouble. Must've been quite the ordeal hauling a big guy like me all the way back to Rustport, huh?","source_cn":"麻烦你们了。把我这大块头搬回锈锚港是不是挺费劲？","status":"matched","hash_xxh64":"0x636E018C7D4158A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1222647004:1":{"text":"If you're gonna thank anyone, give credit to the two behind you.","source_cn":"要谢就谢你身后的两位同伴吧。","status":"matched","hash_xxh64":"0x85E2F18C92ADD7AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1222647005:1":{"text":"They're the ones who brought me back?","source_cn":"是他们两个把我带回来的？","status":"matched","hash_xxh64":"0x1CFAB6A8CB6CCB65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1222647006:1":{"text":"Heh... Second-in-command, yep, it was us!","source_cn":"嘿嘿……二当家……是我们。","status":"matched","hash_xxh64":"0x25A7623C332BA265","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1222647007:1":{"text":"I was wondering why you kept rubbing your backs. Guess lugging around a useless lump like me wore you out.","source_cn":"我说你们怎么老是捶后腰，原来是累着了。","status":"matched","hash_xxh64":"0x53A06309E3CD1F15","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1222647008:1":{"text":"Boss! Don't talk like that—you're not just dead weight! You're the heart and soul of the Whispers!","source_cn":"二当家！别把自己说得像是一坨肉，您可是血薇帮不可或缺的...","status":"matched","hash_xxh64":"0x3E97DC101A8DA1FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1222647009:1":{"text":"You two... usually love taking all the credit. Why so shy all of a sudden?","source_cn":"你们两个……平时喜欢抢功劳，怎么这回谦虚起来了？","status":"matched","hash_xxh64":"0xA91A94B73C3F85A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1222647010:1":{"text":"Well... we can't exactly say it's because we might've dropped you off the cart and, uh... you hit your head...","source_cn":"总不能说是因为搬运过程中不小心让您掉下马车，撞到了头……","status":"matched","hash_xxh64":"0xDA49AE3D2B4DFFD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1222647011:1":{"text":"Shut up, you idiot!","source_cn":"闭嘴！你这笨蛋！","status":"matched","hash_xxh64":"0xA93D3CE59034810B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1222647012:1":{"text":"Alright, alright. I'll let it slide this time. And...","source_cn":"行了。我不会追究你们的过失。还有……","status":"matched","hash_xxh64":"0xCF86430C745AF64B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1222647013:1":{"text":"Thanks.","source_cn":"谢谢。","status":"matched","hash_xxh64":"0x91632399FB4AAAC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1222647014:1":{"text":"... Sir!","source_cn":"……二当家！","status":"matched","hash_xxh64":"0x668D4EE38246D389","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1222647015:1":{"text":"*Sniffle* You're such a good person!","source_cn":"呜呜呜……二当家真是好人啊！","status":"matched","hash_xxh64":"0x8563B62B63131C62","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1222647016:1":{"text":"Alright, enough with the waterworks. Sonja's looking for us.","source_cn":"好了，别站在这里闲聊了，索尼娅有事找我们。","status":"matched","hash_xxh64":"0x9BBFF066F8B7B464","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1222647017:1":{"text":"She's organized all the intel we've gathered, let's go meet her.","source_cn":"她将这段时间收集到的信息整理了一番，我们去找她吧。","status":"matched","hash_xxh64":"0xB88A680F87E9A215","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:血薇帮的阿柴":{"text":"Anders","source":"血薇帮的阿柴","status":"matched_dialogue_flow"},"speaker:血薇帮的阿吉":{"text":"Ashby","source":"血薇帮的阿吉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":18,"localized_text_count":17,"speaker_count":5}}