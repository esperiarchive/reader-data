{"asset_key":"ep2/quest_story_12246390","episode":"ep2","category":"quest_story","story_id":"12246390","schema_version":1,"lang":"en","texts":{"say:2:1224639001:1":{"text":"Look, Dori! What a groundbreaking discovery!","source_cn":"这个生物——丝道瑞，这是突破性的发现！","status":"matched","hash_xxh64":"0x8D27FE08F90C9485","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1224639002:1":{"text":"A study on this creature will surely get funded.","source_cn":"它作为课题，这份报告一定能申请到基金。","status":"matched","hash_xxh64":"0xFEB0198548450BAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1224639003:1":{"text":"What a fruitful trip! I've found a direction for our papers and projects!","source_cn":"不虚此行！我们的论文和项目有着落了！","status":"matched","hash_xxh64":"0x9EF905D35CCEAFB5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1224639004:1":{"text":"Are these scholars using a Graveborn as a specimen? How bold!","source_cn":"这帮学者胆子真大，居然把亡灵当标本研究。","status":"matched","hash_xxh64":"0xDDE32A2D5D1ED9CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1224639005:0":{"text":"I heard there are some marine biology scholars at Blackwood Loch. Let's check in with them.","source_cn":"听说还有研究鱼类的学者在黑木湖，我们快去看看。","status":"matched","hash_xxh64":"0x16711BB289A5F8BD","variant_status":"","mal