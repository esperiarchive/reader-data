{"asset_key":"ep2/quest_story_12201170","episode":"ep2","category":"quest_story","story_id":"12201170","schema_version":1,"lang":"en","texts":{"say:3:1220117001:0":{"text":"Ce... ci...","source_cn":"哩……呀呀呀呀……","status":"matched","hash_xxh64":"0xC15795A3A0F912EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220117002:1":{"text":"He's not attacking us anymore... But we can't communicate with him.","source_cn":"不行，虽然不攻击我们了，但完全没法交流啊……","status":"matched","hash_xxh64":"0x99EC1897FF72CA64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1220117002":{"text":"He's not attacking us anymore... But we can't communicate with him.","source_cn":"不行，虽然不攻击我们了，但完全没法交流啊……","status":"matched","hash_xxh64":"0x99EC1897FF72CA64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1220117003:0":{"text":"Do you remember Cecilia?","source_cn":"乔纳森，你还记得塞西莉亚小姐吗？","status":"matched","hash_xxh64":"0xB0A73A26D2C9C71A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220117004:0":{"text":"Ce... ci...","source_cn":"……萨……啊……","status":"matched","hash_xxh64":"0xDA044ED2F26E3376","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1220117005:0":{"text":"When the Dead Tide Fleet attacked, you told her to hide at home, right? Don't worry, she's safe! They didn't find her.","source_cn":"死潮舰队上岸时，你让她躲在家里，对吧？放心吧，她很安全...","status":"matched","hash_xxh64":"0x89A224722FBE38F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1220117006:0":{"text":"... lia...","source_cn":"……呀呀呀……","status":"matched","hash_xxh64":"0x56FC8FD61D58FD68","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1220117007:0":{"text":"But her supplies must be running low by now. We need to get her out of there.","source_cn":"但是，现在物资可能不够了，我们得让塞西莉亚小姐出来。","status":"matched","hash_xxh64":"0x0B512347B92AB0C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1220117008:0":{"text":"So could you tell us where you hid the spare key? We swear we'll keep Cecilia safe.","source_cn":"你能把开门钥匙交给我们吗？我们一定会保证她的安全的。","status":"matched","hash_xxh64":"0x7BC52EB26409E11C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1220117009:0":{"text":"Ce... ci... lia...","source_cn":"萨……西……哩……呀……","status":"matched","hash_xxh64":"0x021230B19A767FCD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:1220117010:0":{"text":"The undead body before you rips open his stomach and pulls out a small item.","source_cn":"面前的亡灵生物剖开肚子，取出一把钥匙。","status":"matched","hash_xxh64":"0x9F29F25502F49E58","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1220117011:1":{"text":"Is this... the key?! He hid the key inside his stomach?!","source_cn":"这是……钥匙？！他把钥匙藏在肚子里了？！","status":"matched","hash_xxh64":"0x420B643BE62C95C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:15::2":{"text":"Dirty Key","source_cn":"脏兮兮的钥匙","status":"matched","hash_xxh64":"0x9399D998DCC403DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1220117012:0":{"text":"Did he swallow it to keep it hidden from the Dead Tide Fleet...?","source_cn":"是为了防止死潮舰队拿走，所以被转化为亡灵前，把钥匙吞进...","status":"matched","hash_xxh64":"0x32797331025F6CB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1220117013:0":{"text":"Uh... uh...","source_cn":"……唔……呃。","status":"matched","hash_xxh64":"0xAB1F4E473C913765","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female