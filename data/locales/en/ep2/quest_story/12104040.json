{"asset_key":"ep2/quest_story_12104040","episode":"ep2","category":"quest_story","story_id":"12104040","schema_version":1,"lang":"en","texts":{"say:0:1210404001:0":{"text":"What's that thing on the side of the road? It looks a little familiar.","source_cn":"看到路边黑不溜秋的东西了吗？是不是很眼熟？","status":"matched","hash_xxh64":"0xD42078C8C4D43F62","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1210404002:0":{"text":"Oh, it's a cannonball. The Whispers are digging up materials to make them.","source_cn":"这就是炮弹，血薇帮在黑石洞加工这玩意。","status":"matched","hash_xxh64":"0xFBF2637E86CE801A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1210404003:0":{"text":"Didn't you say they used them for the ships?","source_cn":"你不是说他们造石头用在船上吗？压舱石？","status":"matched","hash_xxh64":"0xB5AFC4BB2FF41DD9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1210404004:0":{"text":"Yeah, for the cannons on the ships.","source_cn":"没说错，是在船上大炮用啊。","status":"matched","hash_xxh64":"0xFE8550A7F2DF5AC7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}