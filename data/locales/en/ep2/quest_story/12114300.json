{"asset_key":"ep2/quest_story_12114300","episode":"ep2","category":"quest_story","story_id":"12114300","schema_version":1,"lang":"en","texts":{"say:2:1211430001:1":{"text":"Huh! Hodgkin, that sly bastard... He's just toying with us!","source_cn":"霍德希金这混蛋……跟我们玩阴的。","status":"matched","hash_xxh64":"0x6C0BE298518BC901","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1211430002:1":{"text":"Stay calm. You'll make more careless mistakes if you're riled up.","source_cn":"沉住气，越是急躁，越容易露出破绽。","status":"matched","hash_xxh64":"0x4A0267B02E36BC43","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211430003:1":{"text":"He's afraid of us. That's why he's pulling underhanded tricks like this.","source_cn":"他对我们有所畏惧，否则也不会与我们在暗中周旋。","status":"matched","hash_xxh64":"0xD73EF82FAF0D9963","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211430004:1":{"text":"His defeat was sealed from the moment he began fearing us.","source_cn":"从他对我们心怀畏惧的那一刻起，他的失败已经注定了。","status":"matched","hash_xxh64":"0x6B1B920734E71B20","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}