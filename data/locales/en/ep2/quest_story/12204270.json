{"asset_key":"ep2/quest_story_12204270","episode":"ep2","category":"quest_story","story_id":"12204270","schema_version":1,"lang":"en","texts":{"say:2:1220427001:1":{"text":"What's the situation now?","source_cn":"现在情况怎么样？","status":"matched","hash_xxh64":"0xAAE2D4580F9D940A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1220427002:0":{"text":"The bookie just left and took some people with him. It's go time, boss.","source_cn":"庄家刚走不久，带走了不少人。二当家，现在进去正好。","status":"matched","hash_xxh64":"0xA7D3D4BE1ED4A4CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220427003:1":{"text":"Lucca, you're so meticulous!","source_cn":"卢卡先生，你早就在这里安排了人手？","status":"matched","hash_xxh64":"0x8C4FBF9A4587155C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1220427004:0":{"text":"Wow, you seem so rough... uh, so rugged, but you're actually very thorough!","source_cn":"哇，没想到你看上去很粗鲁……呃，很粗犷，但其实心思很缜密！","status":"matched","hash_xxh64":"0x3925807E4883D35F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1220427005:0":{"text":"Chippy, mind your manners!","source_cn":"满满，注意礼貌！","status":"matched","hash_xxh64":"0xC76DED556EBBCAA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1220427006:0":{"text":"I picked all this up from Sonja; she's the real brains, she's even more perceptive than I am.","source_cn":"这都是从索尼娅那里学到的，她才是真正的心思细腻，比我更...","status":"matched","hash_xxh64":"0xB049C14211685557","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1220427007:1":{"text":"Let's go! If we don't rescue Miss Wendy soon, Stanton will lose his mind with worry!","source_cn":"上吧！再不把温蒂小姐救出来，斯坦顿就要急坏了！","status":"matched","hash_xxh64":"0x0577D836294B2659","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"},"speaker:血薇帮暗哨":{"text":"Carmine Sentry","source":"血薇帮暗哨","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":4}}