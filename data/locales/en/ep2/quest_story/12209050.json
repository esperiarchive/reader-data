{"asset_key":"ep2/quest_story_12209050","episode":"ep2","category":"quest_story","story_id":"12209050","schema_version":1,"lang":"en","texts":{"say:2:1220905001:0":{"text":"Sir, do you know the kids who shine shoes around here?","source_cn":"先生，你认识在这里给人擦鞋的那几个孩子吗？","status":"matched","hash_xxh64":"0xE874BF8AD286A2EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1220905002:0":{"text":"The kids who shine shoes... are you talking about Feodor and his crew?","source_cn":"擦鞋的孩子……是费曼他们吧？","status":"matched","hash_xxh64":"0x49FFE33E50B4BDBF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220905003:1":{"text":"You know them! Can you tell me where they stay?","source_cn":"哇，你认识他们！他们住在哪里呢？","status":"matched","hash_xxh64":"0xEFD4D81A3C79B046","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1220905004:1":{"text":"I wouldn't say I know them, but I see them often on my way back and sometimes say hello.","source_cn":"算不上认识，我回家路上总能看到他们，偶尔也打个招呼。","status":"matched","hash_xxh64":"0x107AABF6837B0EC5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1220905005:0":{"text":"Oh, right <style=\"highlight\">over the bridge to the west</style>.","source_cn":"哦，就在<style=highlight>西边，前面过...","status":"matched","hash_xxh64":"0x60E2FA35B08F1395","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220905006:0":{"text":"Thank you so much!","source_cn":"太感谢了！","status":"matched","hash_xxh64":"0x42148BAFBF80CFB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:水手":{"text":"Sailor","source":"水手","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":2}}