{"asset_key":"ep2/quest_story_12225250","episode":"ep2","category":"quest_story","story_id":"12225250","schema_version":1,"lang":"en","texts":{"say:3:1222525001:0":{"text":"Don't! Don't go over there!","source_cn":"不要，不要过去！","status":"matched","hash_xxh64":"0xD75D8F89600B78E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1222525002:1":{"text":"Big, scary guy! Over there!","source_cn":"前面，很大、很饿、很厉害的家伙！可怕！","status":"matched","hash_xxh64":"0x45ED7F9345B5398E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1222525003:1":{"text":"So the Hypogean is really here... It seems like we found the right place after all.","source_cn":"所以恶魔就在前面？看来咱们没找错地方！","status":"matched","hash_xxh64":"0x34E526C4B1AD9C13","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1222525004:1":{"text":"Don't go there! You'll be eaten! One bite! And you're dead!","source_cn":"不——不可以去！会被吃掉！一口！全吃掉！","status":"matched","hash_xxh64":"0x35F6A7805C77BFF4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1222525005:1":{"text":"These little guys are really scared. I wonder what that monster looks like.","source_cn":"哇哦，竟然能把这些小东西吓成这样。那家伙看起来还挺厉害的？","status":"matched","hash_xxh64":"0x09FCCFA530C81D4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222525006:0":{"text":"Poor little ones, don't be afraid.","source_cn":"可怜的小家伙，不要害怕。","status":"matched","hash_xxh64":"0x9F1F0B8357F039C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1222525007:1":{"text":"Can you take us to where the Hypogean is? We'll defeat him together.","source_cn":"可以带我们到那个恶魔的所在地吗？我们会一起战胜他。","status":"matched","hash_xxh64":"0x2C8A9A603CA6D41B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1222525008:1":{"text":"If it gets dangerous, you can escape first. We promise we won't let you get hurt!","source_cn":"要是路上很危险，你可以先离开，我们不会让你受到伤害！","status":"matched","hash_xxh64":"0x3EDB5865009F2BC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1222525008":{"text":"If it gets dangerous, you can escape first. We promise we won't let you get hurt!","source_cn":"要是路上很危险，你可以先离开，我们不会让你受到伤害！","status":"matched","hash_xxh64":"0x3EDB5865009F2BC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1222525009:1":{"text":"Merlin...","source_cn":"梅林……<key:dialog3>","status":"matched_runtime_gender","hash_xxh64":"0x0AEF4932B6AD7300","variant_status":"runtime