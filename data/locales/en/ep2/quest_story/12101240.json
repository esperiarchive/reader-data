{"asset_key":"ep2/quest_story_12101240","episode":"ep2","category":"quest_story","story_id":"12101240","schema_version":1,"lang":"en","texts":{"say:2:1210124001:0":{"text":"Don't you dare touch him! Chippy, are you okay?!","source_cn":"住手！不许动满满！","status":"matched","hash_xxh64":"0xE15E77AEECE60A09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1210124002:0":{"text":"You know him? This sea rat has a name?","source_cn":"你们认识？这海耗子还有名字？","status":"matched","hash_xxh64":"0x8A531A7FDCE8DF47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1210124003:0":{"text":"Chippy, wake up!","source_cn":"满满，你醒醒！","status":"matched","hash_xxh64":"0x4910AA4BE87FEA46","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210124004:0":{"text":"He's not moving! And his complexion is pale!","source_cn":"怎么会……他脸色好差……满满他不动了！","status":"matched","hash_xxh64":"0x4CD4BDB9CA30D441","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210124005:0":{"text":"Hey, he might've drowned! You need to give him mouth-to-mouth.","source_cn":"喂，这溺水得很严重！你们做过人工呼吸吗？！","status":"matched","hash_xxh64":"0xD6EBA6225AE8A251","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1210124006:0":{"text":"Mouth-to-mouth? I don't even know what this thing is!","source_cn":"这、这怎么做人工呼吸？我连他是什么都不知道！","status":"matched","hash_xxh64":"0xF0923CCCEDA4800E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1210124007:0":{"text":"Chippy is not a thing! We're familiars!","source_cn":"——我们是使魔！！不许说满满什么都不是！","status":"matched","hash_xxh64":"0x1B843431D65F486E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1210124008:0":{"text":"*Cry*... Please, wake up Chippy!","source_cn":"呜……满满，醒醒呀……！","status":"matched","hash_xxh64":"0xB165000BBE5F8D7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1210124009:0":{"text":"I don't know what to do either. Do you have any other ideas?","source_cn":"啧，没救过这样的……喂，你有招吗？","status":"matched_runtime_gender","hash_xxh64":"0x66F8EDFDE44BA18C","variant_status":"runtime_gender_keys_target_same","male":"I don't know what to do either. Do you have any other ideas?","female":"I don't know what to do either. Do you have any other ideas?","variant_male_record_index":"129117","variant_female_record_index":"129118","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:15:1210124009":{"text":"I don't know what to do either. Do you have any other ideas?","source_cn":"啧，没救过这样的……喂，你有招吗？","status":"matched_runtime_gender","hash_xxh64":"0x66F8EDFDE44BA18C","variant_status":"runtime_gender_keys_target_same","male":"I don't know what to do either. Do you have any other ideas?","female":"I don't know what to do either. Do you have any other ideas?","variant_male_record_index":"129117","variant_female_record_index":"129118","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1210124010:0":{"text":"Yes! We can use magic, <style=\"stress\"><player_name></style>.","source_cn":"对、对了！<style=stress><player_...","status":"matched_runtime_gender","hash_xxh64":"0xAE767F7276C7FBDB","variant_status":"runtime_gender_keys_target_same","male":"Yes! We can use magic, <style=\"stress\"><player_name></style>.","female":"Yes! We can use magic, <style=\"stress\"><player_name></style>.","variant_male_record_index":"129119","variant_female_record_index":"129120","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1210124011:0":{"text":"If we had a <style=\"highlight\">breathing tonic</style>, Chippy would definitely get better!","source_cn":"要是有<style=highlight>呼吸药剂</s...","status":"matched","hash_xxh64":"0x76FCED7F0410C7A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1210124012:1":{"text":"Great! So, where do we find one of these things?","source_cn":"有招就行！东西去哪找？","status":"matched","hash_xxh64":"0xD6DF58E8CDB25394","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1210124013:0":{"text":"Umm... They're mostly sold at qualified apothecaries and magic shops. If you have the materials, you can craft them yourself using a mortar and pestle and sometimes a crucible.","source_cn":"呃，金冠级的魔法药剂店会卖，有材料的话，直接用坩埚炼制...","status":"matched","hash_xxh64":"0x9388C2AE59D8002A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1210124014:1":{"text":"I don't really get it. All I'm hearing is that he needs medicine.","source_cn":"听不懂，总之是要找药，对吧？","status":"matched","hash_xxh64":"0x237A264C63BF3636","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1210124015:1":{"text":"There is an apothecary in the <style=\"highlight\">upper district</style>. I'll head there now. Someone's life is at stake.","source_cn":"<style=highlight>上城区</style...","status":"matched","hash_xxh64":"0x8138006EB666F3B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1210124016:0":{"text":"Wait, I'll go with you. You won't recognize what we need.","source_cn":"等等，我也去，你认不出来的！","status":"matched","hash_xxh64":"0xC0831549F22E31ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:15:0:1":{"text":"Magic could work...","source_cn":"用魔法试试……？","status":"matched_runtime_gender","hash_xxh64":"0x745A49407D7388C6","variant_status":"runtime_gender_keys_target_same","male":"Magic could work...","female":"Magic could work...","variant_male_record_index":"65306","variant_female_record_index":"65307","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:15:1:2":{"text":"Don't panic, Hammie.","source_cn":"漫漫别慌，之前……","status":"matched_runtime_gender","hash_xxh64":"0xA1B90E259DFB1581","variant_status":"runtime_gender_keys_target_same","male":"Don't panic, Hammie.","female":"Don't panic, Hammie.","variant_male_record_index":"65308","variant_female_record_index":"65309","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:码头渔夫":{"text":"Fisherman","source":"码头渔夫","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":20,"localized_text_count":19,"speaker_count":3}}