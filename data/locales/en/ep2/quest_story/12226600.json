{"asset_key":"ep2/quest_story_12226600","episode":"ep2","category":"quest_story","story_id":"12226600","schema_version":1,"lang":"en","texts":{"say:6:1222660001:0":{"text":"Hands up!","source_cn":"束手就擒吧！","status":"matched","hash_xxh64":"0x74424E20E8ED206A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1222660002:1":{"text":"Who's there?!","source_cn":"谁！","status":"matched","hash_xxh64":"0x15954C1D987EA405","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222660003:1":{"text":"We could ask you the same thing!","source_cn":"我们才想问你呢！","status":"matched","hash_xxh64":"0x6F68105A0126637B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1222660004:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1222660005:1":{"text":"Not talking, huh? You must know who I am. Hiding things from me won't end well for you.","source_cn":"不说吗？你应该知道我是谁，瞒着我，可能不会有什么好下场。","status":"matched","hash_xxh64":"0x6E3D15B3296C672D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1222660006:0":{"text":"... My name is Nalianne. I'm a repairwoman, I usually fix fishing boat sails.","source_cn":"……我叫纳莉安，是个修理工，经常帮渔船修补船帆。","status":"matched","hash_xxh64":"0x4C9A836FD353D89B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1222660007:0":{"text":"Well then, you seem like an honest worker. Why are you trying to break the rules, then?","source_cn":"那么，纳莉安小姐，你是个本分的工人，为什么要违背禁令呢？","status":"matched","hash_xxh64":"0x365ACAEF978DE019","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1222660008:0":{"text":"I... had no choice. I got a letter from my brother. He's gravely ill and wanted to see me one last time.","source_cn":"我……我走投无路了。我收到弟弟的信，他说自己得了重病，...","status":"matched","hash_xxh64":"0x37D096F34390C145","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1222660009:0":{"text":"But the Carmine Whispers issued a blockade, banning all ships from leaving the port. I was desperate...","source_cn":"但是血薇帮下了封锁令，不许船只出港，我没有办法，又很着急……","status":"matched","hash_xxh64":"0x6D06123612755A7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1222660010:0":{"text":"I see. You must be very close to your brother, Miss Nalianne! After all, it's no small feat to earn enough for a ship and hire sailors.","source_cn":"这样啊，纳莉安小姐和弟弟的感情一定很深，毕竟一整艘船和...","status":"matched","hash_xxh64":"0x4DEC5DB14B73C2C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1222660011:0":{"text":"Hmph, that gamblin—I mean, yes, we're very close. I'd do anything for him.","source_cn":"哼，那个赌鬼……不，我是说，我们感情确实很好，所以花再...","status":"matched","hash_xxh64":"0xB5EF3E555DFEA5B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1222660012:1":{"text":"Though ships are banned from leaving, you can apply for a special permit with a legitimate reason.","source_cn":"虽然封锁了船只进出，但只要有正当理由，提出申请后，就能...","status":"matched","hash_xxh64":"0x1F30601724E06570","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1222660013:1":{"text":"It usually doesn't take more than a day for a permit to get processed.","source_cn":"审核的批复效率很高，最多不超过一天。","status":"matched","hash_xxh64":"0xF09D41CDD3F84EFF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1222660014:1":{"text":"How about this? I'll give you a fast-track certificate. Submit your application now, and you'll have it by the end of the day.","source_cn":"这样吧，我给你开个加急证明，你现在去提交申请，今天之内...","status":"matched","hash_xxh64":"0x8FAE7F030C4C7104","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1222660015:1":{"text":"Huh? You're... letting me go?","source_cn":"哎？你们这是要……要放我走？","status":"matched","hash_xxh64":"0x4BCDA5367D477B7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1222660016:1":{"text":"Of course, your reasoning is understandable. The Whispers don't mess with decent folk.","source_cn":"当然，你的违规情有可原。血薇帮不会为难善良的居民。","status":"matched","hash_xxh64":"0xBF0CE2A783BA22CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1222660017:0":{"text":"You've been through enough, there's no need to waste your hard-earned money on illegal deals. Just go get a legal permit.","source_cn":"你也不容易，没必要把血汗钱浪费在违法交易，去拿正规的离...","status":"matched","hash_xxh64":"0xF9051FAECCF9C5FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1222660018:1":{"text":"I... um...","source_cn":"这……啊……","status":"matched","hash_xxh64":"0x144EB0AF31066A74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1222660019:0":{"text":"What's the matter? You save money and get to see your brother. Aren't you happy?","source_cn":"怎么了？又能省下钱，又能见到弟弟，你不开心吗？","status":"matched","hash_xxh64":"0xE8074E4EE9DF1A19","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1222660020:0":{"text":"If all goes well, you might even be able to leave tomorrow.","source_cn":"顺利的话，明天说不定就能离港出去了哦？","status":"matched","hash_xxh64":"0x266B82D383C4D46D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1222660021:0":{"text":"... I'm just very moved. Thank you, I'll go submit my application right away.","source_cn":"……我只是太感动了。谢谢你们，我马上去写申请。","status":"matched","hash_xxh64":"0x2C13C5EECAA0A0C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:32:1222660022:0":{"text":"Nalianne bows deeply and walks away, still looking a bit confused.","source_cn":"纳莉安深深地鞠躬道谢，面带疑惑地走远了","status":"matched","hash_xxh64":"0xA7B9DE7A2371DE74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1222660023:0":{"text":"Hey, you're letting her go just like that? She's so suspicious!","source_cn":"到底在搞什么……不是，你们这就放她走了？她很可疑啊！","status":"matched","hash_xxh64":"0x25B0212D8261311D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:34:1222660023":{"text":"Hey, you're letting her go just like that? She's so suspicious!","source_cn":"到底在搞什么……不是，你们这就放她走了？她很可疑啊！","status":"matched","hash_xxh64":"0x25B0212D8261311D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1222660024:0":{"text":"Gunnar, we're not as clueless as you think. Vayne! Come here.","source_cn":"红锚，我们没你想得那么蠢。瓦因！过来。","status":"matched","hash_xxh64":"0x195E91BA834B3361","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1222660025:0":{"text":"Boss, what can I do for you?","source_cn":"卢卡老大，您吩咐。","status":"matched","hash_xxh64":"0x7620799E9CDE3FD1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1222660026:0":{"text":"Follow that woman, but keep your distance. Don't let her know you're there. Report everything she does to me.","source_cn":"你远远地跟上那个女人，不要打草惊蛇，把她之后的行动都汇...","status":"matched","hash_xxh64":"0xC30AC1465478E094","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1222660027:0":{"text":"Yes!","source_cn":"是！<key:dialog2>","status":"matched","hash_xxh64":"0xCD57FE676D9F022B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1222660028:0":{"text":"And you, Gunnar, go find Grayfang. I know you two are close.","source_cn":"至于你，红锚，你现在去找灰舌，我知道你们很熟。","status":"matched","hash_xxh64":"0xD60B10D7BD49BD09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1222660029:0":{"text":"Give him a message: if that woman comes to buy a boat, sell one to her.","source_cn":"你给灰舌带个话，如果那女人找灰舌买船，记住，卖给她。","status":"matched","hash_xxh64":"0x24ED19EA735A57F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1222660030:0":{"text":"Earning money from you guys takes way too much effort.","source_cn":"真麻烦……想从你们手上挣点钱也太不容易了。","status":"matched","hash_xxh64":"0xE0721093748F4465","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1222660031:0":{"text":"You can back out if you want, but I can't promise when you'll see any reward.","source_cn":"你现在退出也可以，但我不保证赏金什么时候才能到你手中。","status":"matched","hash_xxh64":"0x0F2A526F660CF042","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1222660032:0":{"text":"Fine! I'll do it, alright?","source_cn":"知道了！我照做还不行吗？","status":"matched","hash_xxh64":"0x66CBE273892368A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1222660033:1":{"text":"You can go now.","source_cn":"快去。","status":"matched","hash_xxh64":"0x6F3E7E18C8BE559C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:51:1222660034:0":{"text":"Is Miss Nalianne really a bad person?","source_cn":"纳莉安小姐……是坏人吗？","status":"matched","hash_xxh64":"0x0EE726AE037FFCC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:52:1222660035:0":{"text":"We've pointed her in the right direction. If she's being honest, she'll take me up on my offer.","source_cn":"我们已经为她指明了道路，要是她没骗我们，现在也知道该怎...","status":"matched","hash_xxh64":"0xDC479822B1844892","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:53:1222660036:0":{"text":"But if she buys a boat illegally or contacts anyone suspicious...","source_cn":"如果她还是选择私自买船，甚至和其他可疑的人接触……","status":"matched","hash_xxh64":"0xCECC6F636770DC82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:54:1222660037:0":{"text":"Then we'll have our target in our sights!","source_cn":"那我们就抓到亡灵杀手的尾巴了！","status":"matched","hash_xxh64":"0x45F70E4F2E0F8913","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:34:0:1":{"text":"Don't misunderstand.","source_cn":"不能只看表面","status":"matched_runtime_gender","hash_xxh64":"0xCF36BFEFACEA676A","variant_status":"runtime_gender_keys_target_same","male":"Don't misunderstand.","female":"Don't misunderstand.","variant_male_record_index":"67484","variant_female_record_index":"67485","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:34:1:2":{"text":"She'll lead us to a bigger catch.","source_cn":"放长线，钓大鱼","status":"matched_runtime_gender","hash_xxh64":"0xA65CB9F9BBE2F38C","variant_status":"runtime_gender_keys_target_same","male":"She'll lead us to a bigger catch.","female":"She'll lead us to a bigger catch.","variant_male_record_index":"67486","variant_female_record_index":"67487","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:56:12602512:0":{"text":"While Gunnar is dealing with the mysterious buyer, Lucca and you quickly move in to surround them.","source_cn":"趁着水手“红锚”和神秘买家接头，你们和卢卡迅速上前围住他们。","status":"matched","hash_xxh64":"0x22401872066AC7E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"},"speaker:神秘的买家":{"text":"Mysterious Buyer","source":"神秘的买家","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:纳莉安":{"text":"Nalianne","source":"纳莉安","status":"matched_dialogue_flow"},"speaker:黑屏":{"text":"Black Screen","source":"黑屏","status":"matched_dialogue_flow"},"speaker:水手“红锚”":{"text":"Sailor Gunnar","source":"水手“红锚”","status":"matched_dialogue_flow"},"speaker:探子瓦因":{"text":"Vayne","source":"探子瓦因","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":