{"asset_key":"ep2/quest_story_12232020","episode":"ep2","category":"quest_story","story_id":"12232020","schema_version":1,"lang":"en","texts":{"say:1:1223202001:0":{"text":"Magister <style=\"stress\"><player_name></style>! Welcome!","source_cn":"是<style=stress><player_name...","status":"matched_runtime_gender","hash_xxh64":"0x1E4FC4DC39E8E658","variant_status":"runtime_gender_keys_target_same","male":"Magister <style=\"stress\"><player_name></style>! Welcome!","female":"Magister <style=\"stress\"><player_name></style>! Welcome!","variant_male_record_index":"139803","variant_female_record_index":"139804","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1223202002:1":{"text":"Have you guys found a job?","source_cn":"你们找到活了吗？","status":"matched","hash_xxh64":"0x9C330A9EF664B387","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1223202003:1":{"text":"We have, but...","source_cn":"找是找到了，但……","status":"matched","hash_xxh64":"0xA420B1CDC90BB109","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1223202004:1":{"text":"A—Al! Bad news!","source_cn":"阿、阿尔，大事不好了！","status":"matched","hash_xxh64":"0xFE0F232992C665D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1223202005:1":{"text":"Thoreau's in trouble in the upper district. Could you go take a look?","source_cn":"梭罗在上城区遇到点麻烦，你能去看下吗？","status":"matched","hash_xxh64":"0xAA7F7777E3412AC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1223202006:1":{"text":"See? I knew trouble would find us. Care to join me?","source_cn":"你瞧，又来了。要跟我一起去看看吗？","status":"matched","hash_xxh64":"0x6567F02535E94C72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1223202007:1":{"text":"Sure, but just to be clear, we aren't here to help. We just want to keep an eye on you!","source_cn":"看热闹可以，但先说好，我们不是来帮忙的，我们是来监督你们的！","status":"matched","hash_xxh64":"0x5D17FDE46D4853B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1223202008:1":{"text":"Naturally. In fact, just having you around can help me solve a lot of problems!","source_cn":"当然，当然。其实只要你们站在我们身边，就能解决很多问题了！","status":"matched","hash_xxh64":"0xBB511C8EFB990ADD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1223202009:1":{"text":"Let's head out first. We don't know what might happen if we're late.","source_cn":"不说了，快点走出发吧，去晚了还不知道会发生什么。","status":"matched","hash_xxh64":"0xC1BC05737CE7D28E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:水鬼帮阿尔":{"text":"Wight Al","source":"水鬼帮阿尔","status":