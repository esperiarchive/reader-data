{"asset_key":"ep2/quest_story_12243050","episode":"ep2","category":"quest_story","story_id":"12243050","schema_version":1,"lang":"en","texts":{"say:2:1224305001:1":{"text":"Everyone, look who's back!","source_cn":"各位，看看谁回来了！","status":"matched","hash_xxh64":"0x7E417CBAC8D6EFB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1224305002:0":{"text":"Sinbad! It's been so long!","source_cn":"辛巴达，你这孩子，这么久才回来一趟。","status":"matched","hash_xxh64":"0x9DC02548CF9C41E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1224305003:1":{"text":"The Magister's here too! This lady is...","source_cn":"恩人<male>先生</male><female>小姐...","status":"matched_runtime_gender","hash_xxh64":"0xCF6FA59079302505","variant_status":"runtime_gender_keys_target_same","male":"The Magister's here too! This lady is...","female":"The Magister's here too! This lady is...","variant_male_record_index":"140901","variant_female_record_index":"140902","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1224305004:1":{"text":"It's me, Bella.","source_cn":"……是我，贝拉。","status":"matched","hash_xxh64":"0x0340D6EC37AE4A4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1224305005:1":{"text":"Bella... It's really you! I could hardly believe my eyes just now...","source_cn":"贝拉……真是你！我还以为是自己认错了……","status":"matched","hash_xxh64":"0x95E530A6A78A6428","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1224305006:1":{"text":"You're a Carmine Whisper now. What are you doing here?","source_cn":"你一个血薇帮，来小水村做什么？","status":"matched","hash_xxh64":"0x9C457E685DF85B56","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1224305007:1":{"text":"We need your help to repair our ships.","source_cn":"血薇帮想请你们帮忙，维护出航的船只。","status":"matched","hash_xxh64":"0x3B2898477DAE919A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1224305008:0":{"text":"That's out of the question! Just leave!","source_cn":"别浪费口舌了，我告诉你，没门！你走吧！","status":"matched","hash_xxh64":"0x94C9EF88FC962D92","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1224305009:1":{"text":"We're rebuilding the docks to revive the trading activities in Rustport.","source_cn":"血薇帮正在重建码头，目的是恢复锈锚港的贸易货运。","status":"matched","hash_xxh64":"0xC002F3F724F20D90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1224305010:1":{"text":"This is for the common good, so please think it over.","source_cn":"这是对大家都好的事，你们应该好好考虑一下。","status":"matched","hash_xxh64":"0xF49F73097236EA4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1224305011:1":{"text":"Let's bury the hatchet and put our past conflict behind us—","source_cn":"以前的事都过去了，你们不要受私人恩怨影响——","status":"matched","hash_xxh64":"0x4AFE2DBAA3604206","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1224305012:0":{"text":"Say no more!","source_cn":"——闭嘴！！","status":"matched","hash_xxh64":"0x4A6D72DB33271D04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1224305013:0":{"text":"I've said it before—we'll never do anything for the Carmine Whispers!","source_cn":"我早就说过，我们绝对不可能帮血薇帮做事！","status":"matched","hash_xxh64":"0x3FCDD048193C6D33","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1224305014:0":{"text":"Nothing can change our minds, not even Tesio's imprisonment! Just give up already!","source_cn":"即使泰西欧被拉下马，即使他被关押、被审判，这件事也不会...","status":"matched","hash_xxh64":"0x8786B51B40119AE1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1224305015:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1224305016:1":{"text":"*Sigh*... Tasha might sound harsh, but she's got a point. You should go back.","source_cn":"唉……塔莎的话是难听了点，但理是这个理。你回去吧。","status":"matched","hash_xxh64":"0x89058B10875C1450","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1224305017:0":{"text":"There's simply no room for negotiation with the villagers!","source_cn":"村民们……拒绝得也太干脆了！","status":"matched","hash_xxh64":"0xD715E608E770C4ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1224305018:1":{"text":"Was it just me, or did something seem off about the way they treated Bella?","source_cn":"是我的错觉吗？大家对贝拉的态度好像有点奇怪……","status":"matched","hash_xxh64":"0xE4E8A443E706CAB8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:32:1224305018":{"text":"Was it just me, or did something seem off about the way they treated Bella?","source_cn":"是我的错觉吗？大家对贝拉的态度好像有点奇怪……","status":"matched","hash_xxh64":"0xE4E8A443E706CAB8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1224305019:1":{"text":"Hmm, Sinbad did mention knowing Bella for a long time.","source_cn":"唔，辛巴达也说过，他认识贝拉很多年了。","status":"matched","hash_xxh64":"0x1A5E824CEC803D1B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1224305020:1":{"text":"Chippy bet the villagers and Bella know each other!","source_cn":"满满猜，他们肯定认识！","status":"matched","hash_xxh64":"0xB50B39B3C1168E5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1224305021:1":{"text":"I think they're more than just acquaintances...","source_cn":"肯定不仅是认识这么简单啦……","status":"matched","hash_xxh64":"0x0F347A205381EC91","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1224305022:0":{"text":"I have an idea.","source_cn":"……我还有一个提议。","status":"matched","hash_xxh64":"0x66734BED570B3783","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1224305023:1":{"text":"Not interested! Just go!","source_cn":"不想听！你走吧！","status":"matched","hash_xxh64":"0x0873BB54236DCCC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1224305024:1":{"text":"What if you can play a part in Tesio's upcoming trial?","source_cn":"如果以泰西欧的审判作为交换条件呢？","status":"matched","hash_xxh64":"0xE6EB6FF3208B7666","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1224305025:1":{"text":"What do you mean?","source_cn":"……你什么意思？","status":"matched","hash_xxh64":"0xBE4EB628E8D3FCA4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1224305026:1":{"text":"You can testify in court and provide your statements to prove that Tesio was responsible for the death of Julius' fleet.","source_cn":"泰西欧即将被审判，你们可以出庭作证，也可以提前到议事厅...","status":"matched","hash_xxh64":"0x9177A23F4199C311","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1224305027:1":{"text":"I'll have Sonja and Lucca clear the names of Julius and the rest.","source_cn":"我也会请老大和二当家做主，给尤里叔叔他们正名。","status":"matched","hash_xxh64":"0x7D879541392DDA36","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1224305028:1":{"text":"In that case, their reputation can be salvaged.","source_cn":"……这样的话，尤里叔叔他们就能洗刷冤屈，你们也不会再被骂了。","status":"matched","hash_xxh64":"0x91A014C40DA7DCAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1224305029:1":{"text":"Do your words carry enough weight?","source_cn":"你说话作数吗？","status":"matched","hash_xxh64":"0x06934BD5E75E63DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1224305030:1":{"text":"I'm now the assistant of Lucca, the second-in-command of the Carmine Whispers.","source_cn":"我已经是二当家卢卡的副手。","status":"matched","hash_xxh64":"0x608E3529BCAEBB75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:49:1224305031:1":{"text":"I have to discuss this with the other ladies in the village. You wait here.","source_cn":"……我一个人不能做决定，要和村里的姐妹商量一下。你等着吧。","status":"matched","hash_xxh64":"0x0A4A395E3F8E868C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:51:1224305032:1":{"text":"Sinbad, come over!","source_cn":"辛巴达，你也过来！","status":"matched","hash_xxh64":"0xF498CF5CC24EC878","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:52:1224305033:0":{"text":"The villagers of Brineville hustle together and engage in a long discussion...","source_cn":"小水村的村民们聚在一起，商量了很久很久……","status":"matched","hash_xxh64":"0x4119BBBB7153B0A5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:32:0:1":{"text":"They seemed to know her well.","source_cn":"她们似乎和贝拉很熟悉","status":"matched_runtime_gender","hash_xxh64":"0x94D0D7FC1E90EBFE","variant_status":"runtime_gender_keys_target_same","male":"They seemed to know her well.","female":"They seemed to know her well.","variant_male_record_index":"67832","variant_female_record_index":"67833","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:32:1:2":{"text":"They didn't drive Bella away.","source_cn":"她们憎恶血薇帮，却没有把贝拉赶走","status":"matched_runtime_gender","hash_xxh64":"0x99668A9B07C5E809","variant_status":"runtime_gender_keys_target_same","male":"They didn't drive Bella away.","female":"They didn't drive Bella away.","variant_male_record_index":"67834","variant_female_record_index":"67835","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:村长碧希":{"text":"Blanca","source":"村长碧希","status":"matched_dialogue_flow"},"speaker:血薇帮贝拉":{"text":"Bella","source":"血薇帮贝拉","status":"matched_dialogue_flow"},"speaker:村民塔莎":{"text":"Tasha","source":"村民塔莎","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":37,"localized_text_count":36,"speaker_count":6}}