{"asset_key":"ep2/quest_story_12112140","episode":"ep2","category":"quest_story","story_id":"12112140","schema_version":1,"lang":"en","texts":{"say:2:1211214001:1":{"text":"... It's a piece of fabric. It looks like it was torn off from a shirt or something.","source_cn":"……这是布料？看着像是从衣服上被扯下来的碎片。","status":"matched","hash_xxh64":"0x2ABB40916AAF4195","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211214002:1":{"text":"It's actually from a pair of linen pants. <style=\"highlight\">Fishermen usually wear these when they're out at sea.</style>","source_cn":"是直笼裤，<style=highlight>渔民出海常...","status":"matched","hash_xxh64":"0x5F5E6014535617F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211214003:1":{"text":"Fishermen...? But we found this among the mud and bones...","source_cn":"渔民……？但这布料在淤泥和骨架中间……","status":"matched","hash_xxh64":"0xB74051A1F89A6513","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211214004:1":{"text":"Could it be that all the villagers who disappeared are here...?","source_cn":"难道、难道村里消失的人，都在这里——","status":"matched","hash_xxh64":"0xD14F9E188CAF2F2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1211214005:1":{"text":"Let's focus on our target.","source_cn":"锁定目标。","status":"matched","hash_xxh64":"0x403A9F86C647D2E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1211214006:1":{"text":"If the Dead Tide Fleet is defeated, these tragedies will never happen again.","source_cn":"只要击溃死潮舰队，类似的惨剧就不会再重演。","status":"matched","hash_xxh64":"0x0E430BED3D9C0F47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1211214007:1":{"text":"Let's go. They're waiting for us ahead.","source_cn":"走，前面肯定还有人在等着我们。","status":"matched_runtime_gender","hash_xxh64":"0xA75D580FE9C8FB16","variant_status":"runtime_gender_keys_target_same","male":"Let's go. They're waiting for us ahead.","female":"Let's go. They're waiting for us ahead.","variant_male_record_index":"130298","variant_female_record_index":"130299","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":3}}