variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1224301022:1":{"text":"It's just something about my past. You'll find out when the time comes.","source_cn":"没什么，一些过去的故事，等时机到了你就知道了。","status":"matched_runtime_gender","hash_xxh64":"0x9510075CFDA879C1","variant_status":"runtime_gender_keys_target_same","male":"It's just something about my past. You'll find out when the time comes.","female":"It's just something about my past. You'll find out when the time comes.","variant_male_record_index":"140852","variant_female_record_index":"140853","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1224301023:1":{"text":"I think we should meet with Sinbad first. At this hour, he's probably fishing on the <style=\"highlight\">island in the lake south of the lumberyard</style>.","source_cn":"先去找辛巴达吧。这个时间，他大概还在<style=hi...","status":"matched_runtime_gender","hash_xxh64":"0xABE6524438DCCF07","variant_status":"runtime_gender_keys_target_same","male":"I think we should meet with Sinbad first. At this hour, he's probably fishing on the <style=\"highlight\">island in the lake south of the lumberyard</style>.","female":"I think we should meet with Sinbad first. At this hour, he's probably fishing on the <style=\"highlight\">island in the lake south of the lumberyard</style>.","variant_male_record_index":"140854","variant_female_record_index":"140855","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1224301024:1":{"text":"How come you know him so well?","source_cn":"咦，你怎么知道得这么清楚？","status":"matched","hash_xxh64":"0x4EFF643843B424FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","docum