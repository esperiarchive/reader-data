{"asset_key":"ep2/quest_story_12210120","episode":"ep2","category":"quest_story","story_id":"12210120","schema_version":1,"lang":"en","texts":{"say:1:1221012001:1":{"text":"Ugh... wh-where am I? Am I still alive...?","source_cn":"呃啊……这、这是哪？我还活着吗……","status":"matched","hash_xxh64":"0xE903AA5E3C32122E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1221012002:1":{"text":"Awake! Awake!","source_cn":"醒了！醒了！","status":"matched","hash_xxh64":"0x006314EF73608A6D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1221012003:1":{"text":"A t-talking plant! I must be dreaming... am I already...?","source_cn":"会……会说话的植物！我一定在做梦……难道我已经……","status":"matched","hash_xxh64":"0x10BCD33529FA3E67","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1221012004:1":{"text":"Don't worry! You're fine now, and your wounds are healed!","source_cn":"别紧张！你已经没事了，连身上的伤都好了！","status":"matched","hash_xxh64":"0x8495D6732B7C72AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1221012005:1":{"text":"These glimmerblooms saved you, so there's no need to fear them!","source_cn":"是这些荧荧花救了你，所以你不用害怕它们！","status":"matched","hash_xxh64":"0x10A7A058B9420DAA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1221012006:1":{"text":"They saved me? This is like something out of a fairy tale...","source_cn":"它们救了我……？这，这简直像是讲给小孩的冒险故事一样。","status":"matched","hash_xxh64":"0xDC8263441A57C607","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1221012007:0":{"text":"Um, in any case, thank you... You're called glimmerblooms, right?","source_cn":"呃，总之要谢谢你们……是叫荧荧花来着吧？","status":"matched","hash_xxh64":"0xE2C109D9FAFF20E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1221012008:1":{"text":"You're welcome! Welcome!","source_cn":"不客气！不客气！","status":"matched","hash_xxh64":"0x63C6D0F89D8D1601","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1221012009:1":{"text":"The glimmerblooms granted his wish!","source_cn":"荧荧花是，帮他，实现心愿！","status":"matched","hash_xxh64":"0x5E7C6830BE15071A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1221012010:0":{"text":"...Hold on! Don't start pointing at me again!","source_cn":"……等等！别又指着我啊！","status":"matched","hash_xxh64":"0xA05178458EA7126B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1221012011:0":{"text":"A Wight? What's a Wight doing here?!","source_cn":"水鬼？！怎么水鬼也在这里？！","status":"matched","hash_xxh64":"0x263F1589A69DBFB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1221012012:0":{"text":"What, I'm not good enough for a deserted island? This place isn't in the Whispers' territory!","source_cn":"怎么，我待在这里不行吗？这座岛又不是你们血薇帮的地盘！","status":"matched","hash_xxh64":"0x678EE34B47335A59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1221012013:0":{"text":"I'm just an unlucky guy falsely accused by your companion and forced to come out and find you!","source_cn":"至于我——是一个被你的同伴误会、被迫出来找你的倒霉蛋！","status":"matched","hash_xxh64":"0x1073658BC0675CE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1221012014:1":{"text":"Uh...","source_cn":"这……","status":"matched","hash_xxh64":"0xF1A23A7738193A97","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1221012014":{"text":"Uh...","source_cn":"这……","status":"matched","hash_xxh64":"0xF1A23A7738193A97","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1221012015:0":{"text":"Yes! And the glimmerblooms said they healed your wounds because he wished for you to recover!","source_cn":"没错！而且荧荧花说，是因为他希望你能尽快好起来，所以才...","status":"matched","hash_xxh64":"0x062CA1264FE11FB6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1221012018:0":{"text":"The glimmerblooms healed me thanks to him...?\nThis doesn't sound right...","source_cn":"因为他，所以这些荧荧花治好了我……？\\n听起来好像不太...","status":"matched","hash_xxh64":"0x51CAA3B53D11AE4F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1221012019:0":{"text":"But since Magister <style=\"stress\"><player_name></style> said so, I have no reason to doubt it.","source_cn":"不过，既然<style=stress><player_...","status":"matched_runtime_gender","hash_xxh64":"0x5ED9618E2CDF4DE0","variant_status":"runtime_gender_keys_target_same","male":"But since Magister <style=\"stress\"><player_name></style> said so, I have no reason to doubt it.","female":"But since Magister <style=\"stress\"><player_name></style> said so, I have no reason to doubt it.","variant_male_record_index":"136278","variant_female_record_index":"136279","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1221012020:1":{"text":"... I apologize, young man.","source_cn":"……抱歉了，这位小哥。","status":"matched","hash_xxh64":"0x3819CFB9C02EBC26","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1221012021:0":{"text":"Alright, alright, as long as everything's fine.","source_cn":"行了行了，没事就好。","status":"matched","hash_xxh64":"0x6D89FE89DB13DD2B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1221012022:0":{"text":"Hurry and come back with me to <style=\"highlight\">the coast</style>. I'm still waiting for you to clear my name! Your Whispers brothers are still looking for you.","source_cn":"赶紧和我回<style=highlight>海岸边</...","status":"matched","hash_xxh64":"0xEC3CBE3101893372","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1221012023:1":{"text":"You're leaving? Goodbye! Bye-bye!","source_cn":"你们要，回去了？那，再见！再见！","status":"matched","hash_xxh64":"0x2BA4C17CCDAD4C80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1221012024:1":{"text":"Farewell. I'll remember your kindness, little ones.","source_cn":"再见了。我会记住你们的恩情的，小家伙。","status":"matched","hash_xxh64":"0xFF590FC9C01A4A48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:0:1":{"text":"He came looking for you.","source_cn":"他是出来找你的","status":"matched_runtime_gender","hash_xxh64":"0x26A9C0F3D19723C1","variant_status":"runtime_gender_keys_target_same","male":"He came looking for you.","female":"He came looking for you.","variant_male_record_index":"66846","variant_female_record_index":"66847","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1221012016:1":{"text":"The one you should be thanking is this Water Wight! He asked the Magister to help make the awakening elixir to get you on your feet.","source_cn":"你最该感谢的其实是你面前的这个水鬼帮！为了让你快点醒过...","status":"matched_runtime_gender","hash_xxh64":"0x1AE1C74E6C420CC6","variant_status":"runtime_gender_keys_target_same","male":"The one you should be thanking is this Water Wight! He asked the Magister to help make the awakening elixir to get you on your feet.","female":"The one you should be thanking is this Water Wight! He asked the Magister to help make the awakening elixir to get you on your feet.","variant_male_record_index":"136274","variant_female_record_index":"136275","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1221012017:1":{"text":"And the glimmerblooms healed your wounds thanks to his wish for your speedy recovery!","source_cn":"而且你身上的伤，也是因为他希望你能尽快康复，这些荧荧花...","status":"matched","hash_xxh64":"0x46752629C577D18A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:1:2":{"text":"Don't thank me, just pay me.","source_cn":"不用谢我，我救人是要收钱的","status":"matched_runtime_gender","hash_xxh64":"0xDDAF951771752B95","variant_status":"runtime_gender_keys_target_same","male":"Don't thank me, just pay me.","female":"Don't thank me, just pay me.","variant_male_record_index":"66848","variant_female_record_index":"66849","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:埃尔伍":{"text":"Elwood","source":"埃尔伍","status":"matched_dialogue_flow"},"speaker:圆润的荧荧花":{"text":"Round Bloom","source":"圆润的荧荧花","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:尤赖亚":{"text":"Urio","source":"尤赖亚","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":28,"localized_text_count":27,"speaker_count":4}}