{"asset_key":"ep2/quest_story_12245110","episode":"ep2","category":"quest_story","story_id":"12245110","schema_version":1,"lang":"en","texts":{"say:2:1224511001:0":{"text":"I've got some good news to share with you all.","source_cn":"有个好消息要告诉几位。","status":"matched","hash_xxh64":"0x51D894D83FCC87A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1224511002:0":{"text":"Bella agreed to lead the advance fleet, right?","source_cn":"我猜，是贝拉答应带领先遣队出航了吧？","status":"matched","hash_xxh64":"0x701004F83CA3BBD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1224511003:1":{"text":"Seems like you've got wind of it. Yes, she's now on her way to Holistone.","source_cn":"你们听说了？她已经出发了，去圣石镇。","status":"matched","hash_xxh64":"0xD574D391103C6CFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1224511004:1":{"text":"That's wonderful! General Hogan will surely welcome her with great hospitality. This bodes well for the trade between the two places!","source_cn":"那太好了！霍根将军肯定会好好招待她的，锈锚港和圣石镇的...","status":"matched","hash_xxh64":"0x1AAC3881D3106D65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1224511005:1":{"text":"It's all thanks to you.","source_cn":"这一点要感谢你们。","status":"matched","hash_xxh64":"0x5903B8B32FFCC3A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1224511006:1":{"text":"For some reason, Bella changed her mind soon after you visited Brineville.","source_cn":"说起来奇怪。上次请你们去打探消息没多久，贝拉突然就愿意...","status":"matched","hash_xxh64":"0xB59C4577688C2109","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1224511007:1":{"text":"What happened? What made her change her mind?","source_cn":"发生了什么？她为什么会突然改变想法？","status":"matched","hash_xxh64":"0x2BAAA3D40E63C406","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1224511007":{"text":"What happened? What made her change her mind?","source_cn":"发生了什么？她为什么会突然改变想法？","status":"matched","hash_xxh64":"0x2BAAA3D40E63C406","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1224511008:1":{"text":"...What's the point of keeping the suspense?","source_cn":"……搞不明白你们。","status":"matched","hash_xxh64":"0x76AAA6BFCD7BC642","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1224511011:1":{"text":"It's a long story in any case. You can get the truth from the star of the story!","source_cn":"总之，这是个很长的故事！想要了解真相的话，就去问故事的...","status":"matched","hash_xxh64":"0x28C1A2A38EC85557","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"It's a secret!","source_cn":"秘密！","status":"matched_runtime_gender","hash_xxh64":"0xB187D216D8E9448B","variant_status":"runtime_gender_keys_target_same","male":"It's a secret!","female":"It's a secret!","variant_male_record_index":"67458","variant_female_record_index":"67459","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1224511009:1":{"text":"I'm surprised he played a part in this.","source_cn":"这事还和他有关系？","status":"matched","hash_xxh64":"0x9D4642562653D1D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"You can ask Sinbad about it.","source_cn":"你可以去问辛巴达","status":"matched_runtime_gender","hash_xxh64":"0x6028026511FD0001","variant_status":"runtime_gender_keys_target_same","male":"You can ask Sinbad about it.","female":"You can ask Sinbad about it.","variant_male_record_index":"67460","variant_female_record_index":"67461","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1224511010:1":{"text":"She won't tell me anything.","source_cn":"她不会说的。","status":"matched","hash_xxh64":"0xE74974A0D413E770","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:2:3":{"text":"Ask Bella when she comes back.","source_cn":"等贝拉回来，你再问她吧","status":"matched_runtime_gender",