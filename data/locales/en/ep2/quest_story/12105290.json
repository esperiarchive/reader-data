{"asset_key":"ep2/quest_story_12105290","episode":"ep2","category":"quest_story","story_id":"12105290","schema_version":1,"lang":"en","texts":{"say:3:1210529001:1":{"text":"*Cough*","source_cn":"咳、咳咳咳！","status":"matched","hash_xxh64":"0x2551F5F917AAF195","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1210529002:1":{"text":"You lose.","source_cn":"你输了。","status":"matched","hash_xxh64":"0x3E54565BD0AFA7FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210529003:1":{"text":"Are you going to kill me, Sonja?","source_cn":"索尼娅，你要杀了我吗？","status":"matched","hash_xxh64":"0x757508617C25ACE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210529004:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210529005:1":{"text":"I am your father. If I hadn't saved you from that shipwreck, you would've died back then like your sister.","source_cn":"我是你的“父亲”……当年，如果不是我把你救起，你早就死...","status":"matched","hash_xxh64":"0xC73C622C1756AC0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1210529006:1":{"text":"I know.","source_cn":"我知道。","status":"matched","hash_xxh64":"0xB188B8685FB0426C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1210529007:1":{"text":"I raised you like one of my own, taught you how to use a sword, and sent you to the best schools. I even handed you the Carmine Whispers. If you kill me now, you'll lose the support of everyone.","source_cn":"我把你当亲生孩子一样养大，教你剑术，让你上学……甚至还...","status":"matched","hash_xxh64":"0x27E2299C450B3A00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210529008:1":{"text":"Do you remember when I pinned that rose on your chest and told everyone that you were my child? You promised me eternal loyalty.","source_cn":"还记得吗？我把血薇别在你胸口，告诉所有人，你就是我的“...","status":"matched","hash_xxh64":"0xCF275628B24D43C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210529009:1":{"text":"I did not forget.","source_cn":"没忘。","status":"matched","hash_xxh64":"0x663CF830BBC86C2A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210529010:1":{"text":"You can't bring yourself to take my life, my child. Killing me would not benefit you. Accept your fate.","source_cn":"我的……我的孩子。你不可能杀我，你也杀不了我。认命吧。","status":"matched","hash_xxh64":"0x75297F6DEC6B6F59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1210529011:1":{"text":"Father...","source_cn":"父亲……","status":"matched","hash_xxh64":"0x968A077B58AA7863","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1210529012:1":{"text":"No way, Sonja. Don't tell me you're buying this!","source_cn":"不是吧，索尼娅，你吃这套？","status":"matched","hash_xxh64":"0xCDC002211A1692C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1210529013:1":{"text":"Do you really believe that Tesio regards you as family? If you believe that, then Lucca is my twin brother.","source_cn":"你相信泰西欧当你是亲人？还是信我和卢卡是失散多年的亲兄弟？","status":"matched","hash_xxh64":"0x4D71ECC3716F0A22","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1210529014:1":{"text":"Shut your mouth.","source_cn":"谁是你兄弟？","status":"matched","hash_xxh64":"0xD9C8A0111D692ABF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1210529015:1":{"text":"Lucca, put him in chains.","source_cn":"真啰嗦。卢卡，铐上他。","status":"matched","hash_xxh64":"0x0F24B98342068D10","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1210529016:1":{"text":"Understood.","source_cn":"是。","status":"matched","hash_xxh64":"0x46CC2E142C5C636F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1210529017:0":{"text":"Sonja?! I can't believe you're doing this!","source_cn":"——你？！索尼娅？！你竟然让手下碰我？！","status":"matched","hash_xxh64":"0x00F4F67716672BD6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1210529018:1":{"text":"Whew, I thought I was the one you were gonna put in chains!","source_cn":"原来是给这老东西上铐？哈哈哈哈！","status":"matched","hash_xxh64":"0xA08EF50BC5EE6E59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1210529019:1":{"text":"Father, you've grown old. Your eyesight isn't what it used to be, and you nag all the time.","source_cn":"父亲大人，你真的老了，变唠叨了，而且眼神也不好。","status":"matched","hash_xxh64":"0x935603B770632451","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1210529020:1":{"text":"Look at me. I'm no one's child.","source_cn":"看清楚！我，索尼娅，不是谁的孩子。","status":"matched","hash_xxh64":"0x66226F16D0C1C266","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1210529021:1":{"text":"I'm the boss of the Carmine Whispers... after you die.","source_cn":"我是血薇帮的老大——在你死后。","status":"matched","hash_xxh64":"0xC141A8564ECD59D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1210529022:1":{"text":"How dare you?","source_cn":"你竟敢——","status":"matched","hash_xxh64":"0xC734E413241FCCDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1210529023:1":{"text":"Years ago, pirates were rampant in Rustport. Many people wanted to leave.","source_cn":"当年，锈锚港海盗横行，很多人想离开锈锚港。","status":"matched","hash_xxh64":"0x700E431B9AF9A52C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1210529024:1":{"text":"So you organized a shipwreck. You had explosives in the cabin and had the main mast compromised. You purposefully put people in danger so that the Carmine Whispers would come to their rescue.","source_cn":"于是你策划了一场海难，你让人磨断了桅杆，船舱里绑了炸药...","status":"matched","hash_xxh64":"0x35DCCEBBD6E771AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1210529025:1":{"text":"As expected... after the shipwreck, the popularity of the Whispers soared, and everyone respected you and called you the Don.","source_cn":"果然……海难后，血薇帮的人望迅速攀升，大家都尊称你为教父。","status":"matched","hash_xxh64":"0x67AAE50BF54CC9AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1210529026:1":{"text":"You're probably wondering how I know all of this.","source_cn":"奇怪我怎么知道的？","status":"matched","hash_xxh64":"0x2D3F7E586E3F8348","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1210529027:1":{"text":"Don't forget. You taught me everything you knew.","source_cn":"别忘了，你把我教的很好。","status":"matched","hash_xxh64":"0xD8F6B7ABB8AEA235","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1210529028:1":{"text":"What's the big deal? I gave everyone a new purpose... A new life! I am their savior.","source_cn":"这有什么，我给了他们新的生命……我就是他们的救世主。","status":"matched","hash_xxh64":"0x8C70FD60C0DFF760","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1210529029:1":{"text":"Everyone knows that help isn't free.","source_cn":"所有人都应该知道，救世主的帮助不是无偿的。","status":"matched","hash_xxh64":"0x0A7E8F9F3237A713","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1210529030:1":{"text":"Even saviors have to pay for their sins.","source_cn":"救世主犯下罪孽也是要偿还的。","status":"matched","hash_xxh64":"0x7FE2EA5EF02A565C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1210529031:1":{"text":"I grew the Carmine Whispers with my blood, sweat, and tears. What's wrong with that? If you want flowers to bloom, blood is the perfect fertilizer.","source_cn":"我用鲜血哺育血薇帮，有什么错呢？花要想开的好，沾血的肥...","status":"matched","hash_xxh64":"0xB3A0B0C41AD4DC46","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1210529032:1":{"text":"You will be judged.","source_cn":"别狡辩了，你会迎来审判。","status":"matched","hash_xxh64":"0xB3B2FB44EBA8536B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1210529033:1":{"text":"Me...? Judged?","source_cn":"……审判？","status":"matched","hash_xxh64":"0x3AA401EDA8F4FE0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1210529034:1":{"text":"I don't think so.","source_cn":"还不到时候！","status":"matched","hash_xxh64":"0xDEAAE898129BCA93","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:泰西欧":{"text":"Tesio","source":"泰西欧","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":35,"localized_text_count":34,"speaker_count":4}}