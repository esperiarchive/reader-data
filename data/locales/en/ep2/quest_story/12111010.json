{"asset_key":"ep2/quest_story_12111010","episode":"ep2","category":"quest_story","story_id":"12111010","schema_version":1,"lang":"en","texts":{"say:3:1211101001:0":{"text":"Sinbad, what's wrong?","source_cn":"辛巴达，怎么不往前走了？","status":"matched","hash_xxh64":"0x6478A3036D1330C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211101002:0":{"text":"It's so foggy... How about we wait a bit before setting sail?","source_cn":"好浓的雾啊……要不，咱们还是晚点再出海吧？","status":"matched","hash_xxh64":"0x0BB13B96823DC12A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211101003:0":{"text":"This is nothing compared to the fog in Rustport.","source_cn":"与锈锚港附近的浓雾相比，这里的天气不算恶劣。","status":"matched","hash_xxh64":"0x7259B85DCD58A685","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211101004:0":{"text":"R-Right... But what I'm saying is, since we've come this far, it's better to play it safe.","source_cn":"我、我知道……但我的意思是，都到这一步了，小心驶得万年船嘛。","status":"matched","hash_xxh64":"0xFA0E6EBC2A399F80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211101005:0":{"text":"Are you scared?","source_cn":"你害怕了？","status":"matched","hash_xxh64":"0x31C39BB52794D29C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1211101006:0":{"text":"Of course not.","source_cn":"我可没有。","status":"matched","hash_xxh64":"0x0EFF3C4A87FCE4E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1211101007:0":{"text":"Then why are you shaking?","source_cn":"可你的手在发抖。","status":"matched","hash_xxh64":"0x90C270B1C24429FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1211101008:0":{"text":"Hah! Sinbad, you're as spineless as a jellyfish!","source_cn":"这都怕？辛巴达是胆小鬼！","status":"matched","hash_xxh64":"0xDE0890EFD8AB86E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1211101009:0":{"text":"Sinbad, how about you steer the boat, and I'll be your first mate?","source_cn":"辛巴达，你来掌舵，我给你当副手。","status":"matched","hash_xxh64":"0x4AB0EC12CC3F533A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1211101010:0":{"text":"You wanna be the first mate?","source_cn":"你要当副手？","status":"matched","hash_xxh64":"0xF4DB32BA824C780E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1211101011:0":{"text":"Uh-huh. I'll see to any trouble we run into on the high seas.","source_cn":"是啊，如果航行中遇到了敌人，我来应付。","status":"matched","hash_xxh64":"0x3C21C7FE7B2C98B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1211101012:0":{"text":"I mean... I never thought you would be willing to be my first mate.","source_cn":"我的意思是……你竟然愿意给我当副手。","status":"matched","hash_xxh64":"0x54F82658DB72F2DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1211101013:0":{"text":"Don't make a big deal out of it. I'm just in the mood to change things up a bit.","source_cn":"别想太多了。我只是心血来潮，想陪你玩玩扮演船长的游戏。","status":"matched","hash_xxh64":"0xD11A7230E75F20F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1211101014:0":{"text":"Besides, you've been acting like quite the captain on this journey.","source_cn":"这一路上，你不是很有船长的风范吗？","status":"matched","hash_xxh64":"0xF1CB8A8E6FEDC0C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1211101015:0":{"text":"Do you really think I could be a good captain...?","source_cn":"船长……我真的能当船长吗？","status":"matched","hash_xxh64":"0xD46AA2256A4F26AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1211101015":{"text":"Do you really think I could be a good captain...?","source_cn":"船长……我真的能当船长吗？","status":"matched","hash_xxh64":"0xD46AA2256A4F26AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1211101016:0":{"text":"Well, if you say so... Guess I'll give it a go then.","source_cn":"是吗，既然你都这么说了。","status":"matched_runtime_gender","hash_xxh64":"0x013BD273600461E6","variant_status":"runtime_gender_keys_target_same","male":"Well, if you say so... Guess I'll give it a go then.","female":"Well, if you say so... Guess I'll give it a go then.","variant_male_record_index":"129948","variant_female_record_index":"129949","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1211101019:0":{"text":"Argh, no more delays! Let's set sail!","source_cn":"好……我准备好了。","status":"matched","hash_xxh64":"0xBF20955038160874","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1211101020:0":{"text":"All hands on deck! From now on, you must all follow Captain Sinbad's orders! Ha!","source_cn":"水手们！从现在起，要听辛巴达船长的号令！","status":"matched","hash_xxh64":"0xE131DD9AC766D259","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1211101021:0":{"text":"Let's plow through the fog and sail straight to the treasure!","source_cn":"我们要冲破迷雾！抵达宝藏的所在！","status":"matched","hash_xxh64":"0xA0CE1CE3814F145A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:0:1":{"text":"Of course!","source_cn":"你能当好船长","status":"matched_runtime_gender","hash_xxh64":"0x4761354B77F2D020","variant_status":"runtime_gender_keys_target_same","male":"Of course!","female":"Of course!","variant_male_record_index":"65448","variant_female_record_index":"65449","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1211101017:0":{"text":"Aye, I know... I'm still miles away from being a true captain.","source_cn":"是啊……我知道，和一位真正的船长相比，我还差得远呢。","status":"matched_runtime_gender","hash_xxh64":"0x9B8806F863CE1FCC","variant_status":"runtime_gender_keys_target_same","male":"Aye, I know... I'm still miles away from being a true captain.","female":"Aye, I know... I'm still miles away from being a true captain.","variant_male_record_index":"129950","variant_female_record_index":"129951","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1211101018:0":{"text":"And if I keep dragging my feet...","source_cn":"所以，如果我迟迟不能迈出第一步的话——","status":"matched_runtime_gender","hash_xxh64":"0x1A63E32BF2F98784","variant_status":"runtime_gender_keys_target_same","male":"And if I keep dragging my feet...","female":"And if I keep dragging my feet...","variant_male_record_index":"129952","variant_female_record_index":"129953","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:1:2":{"text":"You have a long way to go.","source_cn":"你还需要成长","status":"matched_runtime_gender","hash_xxh64":"0x7498FBF8E66A2B2E","variant_status":"runtime_gender_keys_target_same","male":"You have a long way to go.","female":"You have a long way to go.","variant_male_record_index":"65450","variant_female_record_index":"65451","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":25,"localized_text_count":24,"speaker_count":3}}