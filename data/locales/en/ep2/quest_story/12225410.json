{"asset_key":"ep2/quest_story_12225410","episode":"ep2","category":"quest_story","story_id":"12225410","schema_version":1,"lang":"en","texts":{"say:3:1222541001:1":{"text":"Tasi! We're back, and we've brought help!","source_cn":"塔西，我们叫帮手回来了！","status":"matched","hash_xxh64":"0xAF634DE878A429B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1222541002:1":{"text":"Hahaha! Show me where this Hypogean is!","source_cn":"嚯嚯嚯，让我看看，用来当靶子的恶魔在哪呢？","status":"matched","hash_xxh64":"0x2DBAE8AEDF5FEE39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1222541003:1":{"text":"Don't tell me it's this little thing. Sonja told me the monster looked like a shark, not some pretty butterfly.","source_cn":"……是这个？索尼娅说那恶魔像鲨鱼，但这个明显是蝴蝶。还...","status":"matched","hash_xxh64":"0xA4B8ABA3059F4E64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1222541004:0":{"text":"<style=\"stress\"><player_name></style>, who's this?!","source_cn":"——<style=stress><player_nam...","status":"matched_runtime_gender","hash_xxh64":"0x11CBE705045BA723","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, who's this?!","female":"<style=\"stress\"><player_name></style>, who's this?!","variant_male_record_index":"138375","variant_female_record_index":"138376","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222541005:1":{"text":"He's rash, rough, and rude! Do I look like a monster?! I'm the fairy that guards your dreams!","source_cn":"粗野，鲁莽，没礼貌！我哪里像恶魔？我是守护梦境的妖精！","status":"matched","hash_xxh64":"0xA140E2D7C225D20A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1222541006:0":{"text":"Everything on the Dream Isle, including the ground you're standing on, was created by me! How can you confuse me with that horrendous Hypogean?!","source_cn":"你脚下站的地面，还有整个闪闪发光的藏梦岛，都是我编织的...","status":"matched","hash_xxh64":"0x163DF2537ED8F078","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1222541007:1":{"text":"A fairy? Fairies are extremely rare in Esperia! I've heard that fairy dust is highly prized for its light and magical attributes. Even the imperial smiths at the royal capital have little in stock.","source_cn":"妖精？妖精也稀奇！我听说妖精洒下的粉末是轻盈又含魔力的...","status":"matched","hash_xxh64":"0x64503BDD1C5726A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1222541008:0":{"text":"After we deal with the Hypogean, can you share a bit of your fairy dust with me?","source_cn":"等处理完恶魔的需求，分点材料让我试试呗？","status":"matched","hash_xxh64":"0xD8C9D49F55C0CCBA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1222541009:0":{"text":"Get away from me! How dare you try to steal my fairy dust?!","source_cn":"——不要靠近我！竟然还想取我翅膀上的磷粉，真是太野蛮了！","status":"matched","hash_xxh64":"0x6FA9E0B78CB07143","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1222541010:0":{"text":"Don't worry, child. Once you see how my cannons will obliterate that monster, you'll change your mind about hardworking dwarves like myself.","source_cn":"孩子，等用呼金炮把那个恶魔轰飞，你就会对勤勉踏实的矮人...","status":"matched","hash_xxh64":"0xF6B344E6E929CF2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1222541011:0":{"text":"Child?! You're clearly shorter than I am! Plus, I'm much older than you!","source_cn":"孩子？！你明明比我还矮！而且我岁数比你大！大很多很多！","status":"matched","hash_xxh64":"0x2FFC5DAD9B6EB183","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1222541011":{"text":"Child?! You're clearly shorter than I am! Plus, I'm much older than you!","source_cn":"孩子？！你明明比我还矮！而且我岁数比你大！大很多很多！","status":"matched","hash_xxh64":"0x2FFC5DAD9B6EB183","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1222541012:0":{"text":"Alright, alright... Remember, we're here to deal with the Hypogean.","source_cn":"好了好了，别忘了，我们是来对付恶魔的！","status":"matched","hash_xxh64":"0xDA5DE854340BCBFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1222541013:0":{"text":"Although you two started off on the wrong foot, I can guarantee that Hugin's skills are the real deal.","source_cn":"虽然初次会面不太愉快，但我可以担保，呼金的技艺绝对值得信赖。","status":"matched","hash_xxh64":"0xBF6E67303B9EE95C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1222541014:1":{"text":"He's our best shot at defeating this Hyposhark.","source_cn":"他是我们击败鲨鱼恶魔最好的助力！","status":"matched","hash_xxh64":"0x08E2120BA9601F1B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1222541015:0":{"text":"Hmph!","source_cn":"哼……唔！","status":"matched","hash_xxh64":"0xA605CBDDE958EEF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1222541016:0":{"text":"Since you brought him, I will reluctantly allow him and his mechanical doodads to enter my dream realm.","source_cn":"既然是你们带来的人，我就勉为其难地准许他和他的机械造物...","status":"matched","hash_xxh64":"0x9E9B9A49C903B1EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1222541017:0":{"text":"Ha! That took longer than I expected. So, where's the target? Shorty and Hardhead are roaring to go!","source_cn":"嚯嚯，耽误了不少时间。真正的靶子在哪里，铁头和矮地他们...","status":"matched","hash_xxh64":"0x4BB262A497C3B527","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1222541018:1":{"text":"Let's take a look at the compass.","source_cn":"让我用罗盘瞧瞧。","status":"matched","hash_xxh64":"0x75B1170FCC9E8906","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:27::2":{"text":"Compass","source_cn":"罗盘","status":"matched","hash_xxh64":"0x39BF68A0B410B505","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:30::0":{"text":"Sinbad's Compass","source_cn":"辛巴达的罗盘","status":"matched","hash_xxh64":"0x2C7EDD1BF5B2E0CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1222541019:0":{"text":"Based on the direction it's pointing, he's still at <style=\"highlight\">Wind's Point</style>.","source_cn":"这个方位……看起来他还在<style=highligh...","status":"matched","hash_xxh64":"0xFDC530DCE75E7203","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1222541020:0":{"text":"Then let's go! It's time to show that Hypogean what we're made of!","source_cn":"嚯哈哈哈，走！让那个恶魔瞧瞧我们的厉害！","status":"matched","hash_xxh64":"0xFA3C1CDA61A34447","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1222541021:0":{"text":"Whoa! Hugin is really pumped!","source_cn":"呼金真是风风火火……","status":"matched","hash_xxh64":"0x36C149557744C60C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1222541022:0":{"text":"He's definitely more fired up than usual.","source_cn":"干劲满满！","status":"matched","hash_xxh64":"0xC4C17D13627F2DDA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1222541023:1":{"text":"Let's quickly get to that monster. If Hugin gets antsy and starts testing his cannons on other things on the island, then Ulmus is cooked.","source_cn":"咱们也快跟上，要是呼金一时兴起用岛上其他东西试炮，奥曼...","status":"matched","hash_xxh64":"0xF7CAB27BC7788A78","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1222541024:0":{"text":"Just be careful, and don't underestimate the enemy!","source_cn":"喂——你们大家都小心呀！别轻敌！","status":"matched","hash_xxh64":"0x4EF5AA5D6E3E7E7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1222541025:0":{"text":"I really hope you all return safely...","source_cn":"真是的……希望他们能平安归来。","status":"matched","hash_xxh64":"0xD44B81EEBD95628B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1222541026:0":{"text":"Oh, Grandpa Ulmus! How are you feeling? I'll try my best to fill your dreams with all the happiest things in the world.","source_cn":"奥曼斯爷爷，你感觉怎么样？我会尽力用世界上所有好玩的东...","status":"matched","hash_xxh64":"0x779BA15414C2E21E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:49:1222541027:0":{"text":"Don't you dare lose to that monster! You can't let him devour your mind!","source_cn":"不要输给那个讨厌的恶魔，不要被他吞噬意识！","status":"matched","hash_xxh64":"0x754BBC4B71D6D398","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1222541028:0":{"text":"Please hold on...","source_cn":"坚持住……","status":"matched","hash_xxh64":"0x091657FDB42A7CC8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"We're going to use Hugin's cannons.","source_cn":"我们准备用呼金的炮对付恶魔","status":"matched_runtime_gender","hash_xxh64":"0xC857B313D10AF2C9","variant_status":"runtime_gender_keys_target_same","male":"We're going to use Hugin's cannons.","female":"We're going to use Hugin's cannons.","variant_male_record_index":"67220","variant_female_record_index":"67221","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"Some people don't mix.","source_cn":"天性不合啊……","status":"matched_runtime_gender","hash_xxh64":"0x2EF234E814EBDAA8","variant_status":"runtime_gender_keys_target_same","male":"Some people don't mix.","female":"Some people don't mix.","variant_male_record_index":"67222","variant_female_record_index":"67223","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:2:3":{"text":"\"No one is allowed to argue.\"","source_cn":"“谁都不许吵架！”","status":"matched_runtime_gender","hash_xxh64":"0x6D82D29D3BD74D5F","variant_status":"runtime_gender_keys_target_same","male":"\"No one is allowed to argue.\"","female":"\"No one is allowed to argue.\"","variant_male_record_index":"67224","variant_female_record_index":"67225","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:呼金":{"text":"Hugin","source":"呼金","status":"matched_dialogue_flow"},"speaker:塔西":{"text":"Tasi","source":"塔西","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":35,"localized_text_count":34,"speaker_count":5}}