{"asset_key":"ep2/quest_story_12226340","episode":"ep2","category":"quest_story","story_id":"12226340","schema_version":1,"lang":"en","texts":{"say:3:1222634001:1":{"text":"Is everyone alright?!","source_cn":"喂，你们没事吧！","status":"matched","hash_xxh64":"0xE9944A56F5822A4B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1222634002:1":{"text":"No! The second-in-command is losing a lot of blood! Is he...","source_cn":"不、不好了，二当家流了好多血！他是不是——","status":"matched","hash_xxh64":"0xE52D2DC82182438E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1222634003:1":{"text":"Don't jinx it! Sir Lucca is just unconscious.","source_cn":"别说晦气话，卢卡只是暂时昏迷了。","status":"matched","hash_xxh64":"0xBB4FEB7F448915AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222634004:1":{"text":"What are you two doing here, anyway? Where's Bonnie?","source_cn":"倒是你们两个，怎么跑到这边来了？波妮呢！","status":"matched","hash_xxh64":"0x202766FFE3558461","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1222634005:1":{"text":"That Graveborn woman has been taken back to headquarters. We wanted to see if there's anything we can do here.","source_cn":"那个女亡灵已经被弟兄们押回总部了，我们想着你们估计也需...","status":"matched","hash_xxh64":"0x03AF68D43F7382BD","variant_status":"","male":"","female":"","variant_male_re