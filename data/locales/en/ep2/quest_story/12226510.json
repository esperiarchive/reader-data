{"asset_key":"ep2/quest_story_12226510","episode":"ep2","category":"quest_story","story_id":"12226510","schema_version":1,"lang":"en","texts":{"say:2:1222651001:1":{"text":"Those two guys over there? Total con men, trying to scam the bounty. But my info? It's real, I swear on my life!","source_cn":"那两个家伙只想骗取赏金，我的情报才保真，我敢用自己这条...","status":"matched","hash_xxh64":"0x6D8286A388CA2336","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1222651002:1":{"text":"Alright, what do you know?","source_cn":"你知道些什么？","status":"matched","hash_xxh64":"0xA61BCD873BD97D05","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1222651003:1":{"text":"I've got two small boats tied up at the pier. One of 'em I barely use.","source_cn":"我有两艘小船停靠在码头，其中一艘不常用，一直栓在船坞里。","status":"matched","hash_xxh64":"0xA69FD79B4F013BC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1222651004:1":{"text":"But yesterday, I found the rope cut!","source_cn":"可我昨天发现，那艘船的绳子被割开了！","status":"matched","hash_xxh64":"0x8464D220CBD92C67","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1222651005:1":{"text":"I saw the criminal with my own eyes! She was trying to steal my boat! If I hadn't shown up when I did, it would've been gone!","source_cn":"我亲眼看见通缉犯了！她想偷我的船！要不是我去的及时，我...","status":"matched","hash_xxh64":"0xE6DE00B4C4E23C52","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1222651005":{"text":"I saw the criminal with my own eyes! She was trying to steal my boat! If I hadn't shown up when I did, it would've been gone!","source_cn":"我亲眼看见通缉犯了！她想偷我的船！要不是我去的及时，我的船就没了！","status":"matched","hash_xxh64":"0xE6DE00B4C4E23C52","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222651006:1":{"text":"Yes! Even though it was dark, I saw her clear as day—it was a woman. It had to be her!","source_cn":"对啊！虽然当时天很黑，但我看见了，那是个女的，肯定是通缉犯！","status":"matched","hash_xxh64":"0x091227632CFEF464","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1222651008:1":{"text":"The rope's been cut a little more each day. I've noticed it three times!","source_cn":"从昨天开始，绑船的绳子每天都会被割断一点点，我发现三次了！","status":"matched","hash_xxh64":"0xDDFAAC0E7281F80E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1222651008":{"text":"The rope's been cut a little more each day. I've noticed it three times!","source_cn":"从昨天开始，绑船的绳子每天都会被割断一点点，我发现三次了！","status":"matched","hash_xxh64":"0xDDFAAC0E7281F80E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1222651009:1":{"text":"Uh... no, wait, including today, it's been two days, so I've noticed it twice!","source_cn":"呃……不对，昨天加上今天是两天，也就是说我发现了两次！","status":"matched","hash_xxh64":"0x327919C646B551C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1222651010:1":{"text":"How many times exactly? Your story isn't adding up.","source_cn":"到底是几次……你的话有些可疑。","status":"matched","hash_xxh64":"0xC2B90CD29BD0E6CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1222651012:1":{"text":"It's a solid boat, perfect for long trips!","source_cn":"反正，我那船可是一艘好船，吃水深！能远航！","status":"matched","hash_xxh64":"0xBF5DE47CDE1E1359","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1222651012":{"text":"It's a solid boat, perfect for long trips!","source_cn":"反正，我那船可是一艘好船，吃水深！能远航！","status":"matched","hash_xxh64":"0xBF5DE47CDE1E1359","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1222651013:1":{"text":"Did I say that? You must've heard wrong.","source_cn":"我说过吗？你听错了吧。","status":"matched","hash_xxh64":"0xAD0AB4914936AC4F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1222651016:1":{"text":"Anyway, something happened to my boat, so it must be the criminal!","source_cn":"总之，我的船遭到这种事，肯定除了通缉犯没有别人！","status":"matched","hash_xxh64":"0xD771176DF6C61026","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:17:1222651016":{"text":"Anyway, something happened to my boat, so it must be the criminal!","source_cn":"总之，我的船遭到这种事，肯定除了通缉犯没有别人！","status":"matched","hash_xxh64":"0xD771176DF6C61026","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1222651017:1":{"text":"Besides a wanted criminal, what kind of person would mess with my boat?","source_cn":"呃，除了通缉犯，不会有别人……吧。","status":"matched","hash_xxh64":"0xACEA1043B696B862","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1222651020:1":{"text":"I-I mean, who else could it have been?","source_cn":"总、总之，至少船绳子被割，肯定有凶手吧……","status":"matched","hash_xxh64":"0x79DFC51B4F4A2A48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1222651020":{"text":"I-I mean, who else could it have been?","source_cn":"总、总之，至少船绳子被割，肯定有凶手吧……","status":"matched","hash_xxh64":"0x79DFC51B4F4A2A48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1222651021:1":{"text":"Don't be mad! I'm... Actually... I just thought maybe I'd give this bounty a shot since the rope was cut...","source_cn":"别发火！我说实话！其实……是因为船的绳子被弄断了，我才...","status":"matched","hash_xxh64":"0x5F4CDD8889853EA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:0:1":{"text":"Did you see the criminal or not?!","source_cn":"你到底有没有看到通缉犯本人！","status":"matched_runtime_gender","hash_xxh64":"0x75DD0DF57227F68E","variant_status":"runtime_gender_keys_target_same","male":"Did you see the criminal or not?!","female":"Did you see the criminal or not?!","variant_male_record_index":"67452","variant_female_record_index":"67453","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:0:1":{"text":"Not necessarily.","source_cn":"不一定是通缉犯","status":"matched_runtime_gender","hash_xxh64":"0xA4B6A12898C30605","variant_status":"runtime_gender_keys_target_same","male":"Not necessarily.","female":"Not necessarily.","variant_male_record_index":"67446","variant_female_record_index":"67447","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1222651018:1":{"text":"Th-this, uh... well...","source_cn":"这、这个，反正，呃……","status":"matched","hash_xxh64":"0x4FADF078691A1492","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:1:2":{"text":"Are you sure?","source_cn":"你确定不是别人？","status":"matched_runtime_gender","hash_xxh64":"0x8BA0AC40BD7E4C0D","variant_status":"runtime_gender_keys_target_same","male":"Are you sure?","female":"Are you sure?","variant_male_record_index":"67448","variant_female_record_index":"67449","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1222651019:1":{"text":"Ah, uh, well, um, this...","source_cn":"啊，呃，这个，这个，其实，那个……","status":"matched","hash_xxh64":"0xE906105AB052117A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:2:3":{"text":"I really doubt your story...","source_cn":"你没看见通缉犯吧","status":"matched_runtime_gender","hash_xxh64":"0x2A45E09D5A50CEFF","variant_status":"runtime_gender_keys_target_same","male":"I really doubt your story...","female":"I really doubt your story...","variant_male_record_index":"67450","variant_female_record_index":"67451","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"Isn't your boat small?","source_cn":"你那不是小船吗？","status":"matched_runtime_gender","hash_xxh64":"0x223B2F17ABFD4D1E","variant_status":"runtime_gender_keys_target_same","male":"Isn't your boat small?","female":"Isn't your boat small?","variant_male_record_index":"67442","variant_female_record_index":"67443","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1222651014:1":{"text":"Uh... It could probably fit two or three people, I guess?","source_cn":"我估摸着……载两三个人还是够的吧？","status":"matched","hash_xxh64":"0x129E626A13180B87","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","doc