{"asset_key":"ep2/quest_story_12226120","episode":"ep2","category":"quest_story","story_id":"12226120","schema_version":1,"lang":"en","texts":{"say:3:1222612001:1":{"text":"It's such a mess! There's barely room to walk. Be careful, everyone.","source_cn":"简直乱得下不去脚！你们小心。","status":"matched","hash_xxh64":"0x787162A19F529AB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1222612002:1":{"text":"Magister is so agile—whoa!","source_cn":"主人的身手可是很敏捷的——哇呀呀呀！","status":"matched_runtime_gender","hash_xxh64":"0xCA90A3A42E8D61EC","variant_status":"runtime_gender_keys_target_same","male":"Magister is so agile—whoa!","female":"Magister is so agile—whoa!","variant_male_record_index":"138990","variant_female_record_index":"138991","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1222612003:1":{"text":"Ouch, ouch! Why is there a drawer here?","source_cn":"疼死了……这里怎么会有个抽屉？","status":"matched","hash_xxh64":"0x8AFD02D1B2832668","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1222612004:1":{"text":"Everything in that cabinet was taken out, even the drawers.","source_cn":"柜子里的东西全都倒在地上了，连抽屉都没放过。","status":"matched","hash_xxh64":"0xBD6291AD7D56CD8F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222612005:1":{"text":"Maybe someone was searching for something and fled in a hurry.","source_cn":"看着像是听到了什么风吹草动，于是翻到一半就跑了。","status":"matched","hash_xxh64":"0xA355CD512265EFF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1222612006:1":{"text":"That means there's a good chance they'll return. Let's stake out here, we might catch them!","source_cn":"这意味着对方返回的概率很高。我们在这里蹲守，说不定会有...","status":"matched","hash_xxh64":"0x90DE9B7ABA937A47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1222612007:1":{"text":"Let's do it! We'll find a good hiding spot.","source_cn":"那就试试运气吧！我们找个地方埋伏起来。","status":"matched","hash_xxh64":"0xE7986C040D78789D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":3}}