{"asset_key":"ep2/quest_story_12245070","episode":"ep2","category":"quest_story","story_id":"12245070","schema_version":1,"lang":"en","texts":{"say:3:1224507001:1":{"text":"Hey! You're really here.","source_cn":"嘿！你果然在这。","status":"matched","hash_xxh64":"0xFB92D5512200B555","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1224507002:0":{"text":"Shoot it if you've got something to say. Otherwise, just get lost.","source_cn":"有事快说，没事就滚。","status":"matched","hash_xxh64":"0x91EA0322CE1FDF38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1224507003:1":{"text":"Feeling blue because you can't go sailing?","source_cn":"心情不好？为了不能出海的事情？","status":"matched","hash_xxh64":"0xCE6617596A13AD64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1224507004:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1224507005:1":{"text":"Aren't you weird? You turned down the chance yourself, yet you're acting like you've been rejected.","source_cn":"你这人太奇怪了，明明是你自己拒绝了，却像是被拒绝了一样伤心。","status":"matched","hash_xxh64":"0x4784F9CA55D024D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1224507006:1":{"text":"You're right. I don't understand myself either.","source_cn":"是啊，我也搞不懂我自己。","status":"matched","hash_xxh64":"0x02139B6B453A5B6E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1224507007:1":{"text":"Look at this.","source_cn":"瞧瞧，这是什么？","status":"matched","hash_xxh64":"0xEAB9A8E9EDA783D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:9::2":{"text":"Compass","source_cn":"罗盘","status":"matched","hash_xxh64":"0x39BF68A0B410B505","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1224507008:1":{"text":"You had it with you the day you came back from the sea.","source_cn":"你从海上回来的第一天就拿着它在我眼前晃过一次了。","status":"matched","hash_xxh64":"0x1D115422F804DE22","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1224507009:1":{"text":"You have a great memory! Now, who promised to be my first mate back then? And why are you acting like this now?","source_cn":"记得很清楚嘛。那当年是谁说要当我的大副，现在却这个德行？","status":"matched","hash_xxh64":"0x84BB93054B3F1870","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1224507010:1":{"text":"That's in the past. I don't feel like sailing anymore.","source_cn":"那已经是过去了，我现在不想航海。","status":"matched","hash_xxh64":"0x9F8D35322FDD73D1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1224507011:1":{"text":"It's time you move on, don't you think?","source_cn":"……我说，你该放下了吧？","status":"matched","hash_xxh64":"0x2AE7BDEDB602D1B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1224507012:1":{"text":"Tesio's been sentenced, and the Carmine Whispers have proven the innocence of my father and his crew.","source_cn":"泰西欧已经受到了审判，血薇帮也证明了老爹他们的清白。","status":"matched","hash_xxh64":"0x0E07ED88FA8B3807","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1224507013:1":{"text":"Although both our fathers can never return, I'm sure my old man had no regrets about sacrificing his life for his passion.","source_cn":"虽然你和我的父亲都不会再回来了，但为自己热爱的事业奉献...","status":"matched","hash_xxh64":"0xE9D12D3431F055DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1224507014:1":{"text":"Given how common it is for sailors to die at sea, your father must have prepared you for the day.","source_cn":"出航的水手死在海里——这事太常见了，你父亲肯定和你打过...","status":"matched","hash_xxh64":"0x1D284EEF02E6A8DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1224507015:1":{"text":"I bet you just can't accept that he was killed by a villain instead of by the waves.","source_cn":"你只是不能接受他不是死在航海冒险上，而是被一个小人所害。","status":"matched","hash_xxh64":"0x8ED0BCA4E53B81E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1224507016:1":{"text":"That's not true!","source_cn":"……我没有！","status":"matched","hash_xxh64":"0xF0E8FD6D656B38C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1224507017:1":{"text":"Tell me the truth—did you join the Carmine Whispers to gather evidence against Tesio?","source_cn":"喂，你老实说，你当年加入血薇帮是不是为了寻找泰西欧的罪证？","status":"matched","hash_xxh64":"0xC676B64108311F1A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1224507018:1":{"text":"I doubt you contributed nothing to Tesio's trial.","source_cn":"要说对泰西欧的公审里你没出一点力，我反正不信。","status":"matched","hash_xxh64":"0x95B453EDF152AF69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1224507019:1":{"text":"You can say anything you want.","source_cn":"……随便你怎么说。","status":"matched","hash_xxh64":"0x981F5B257EF5A669","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1224507020:1":{"text":"I know you too well to need an answer.","source_cn":"行了，我还不了解你吗？","status":"matched","hash_xxh64":"0x2779F82361835A01","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1224507021:1":{"text":"Listen to me—it's not our fault that we failed to convince our fathers to stay...","source_cn":"醒一醒吧，当年，你没劝下你父亲，我没劝下我老爹……这都...","status":"matched","hash_xxh64":"0xF203D90169011A09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1224507022:1":{"text":"Even if we clung ourselves to their legs and cried our hearts out, they'd just shake us off and leave to find the treasure that Tesio claimed could save Rustport.","source_cn":"就算咱们都抱着他们的大腿哭，他们也会甩开，然后带着船队...","status":"matched","hash_xxh64":"0xA49429E977C38141","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1224507023:0":{"text":"Nothing could have talked them out of venturing the waters, and you know it.","source_cn":"他们就是这样的人，你知道的，没什么能拦下他们一次次迎击...","status":"matched","hash_xxh64":"0x7C800A423C012424","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1224507024:1":{"text":"Give yourself a break, Bella.","source_cn":"你该放过你自己了，贝拉。","status":"matched","hash_xxh64":"0xCACE4DB8A1A73F5B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1224507025:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1224507026:1":{"text":"Why are you so quiet? I remember you used to be quite chatty.","source_cn":"怎么又不说话了……我记得你小时候话挺多的啊？","status":"matched","hash_xxh64":"0x70C52C6F034A830E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1224507027:1":{"text":"<style=\"stress\"><player_name></style>, say something!","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x37328E59047487FF","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, say something!","female":"<style=\"stress\"><player_name></style>, say something!","variant_male_record_index":"141223","variant_female_record_index":"141224","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:30:1224507027":{"text":"<style=\"stress\"><player_name></style>, say something!","source_cn":"<style=stress><player_name></style>，你也帮忙说两句！","status":"matched_runtime_gender","hash_xxh64":"0x37328E59047487FF","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, say something!","female":"<style=\"stress\"><player_name></style>, say something!","variant_male_record_index":"141223","variant_female_record_index":"141224","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1224507028:1":{"text":"That's more like it!","source_cn":"这话才像样！","status":"matched_runtime_gender","hash_xxh64":"0x034E34651D9C23B5","variant_status":"runtime_gender_keys_target_same","male":"That's more like it!","female":"That's more like it!","variant_male_record_index":"141225","variant_female_record_index":"141226","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1224507031:1":{"text":"Now, here's a sea chart drawn by your father, which was left at my place before they departed. Unfortunately, it's in bad shape now.","source_cn":"我也懒得说那么多了。这有一份海图，是你父亲画的，他们离...","status":"matched","hash_xxh64":"0xC4EA0D08C8D7136F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1224507032:1":{"text":"If you're ready to go sailing, you can meet me on the ship. You know where it's docked, don't you?","source_cn":"如果你愿意出海，我会在船上等你。你知道血薇帮把船停在哪吧？","status":"matched","hash_xxh64":"0x91553A7128688F17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1224507033:1":{"text":"You!","source_cn":"你……！","status":"matched","hash_xxh64":"0xD3E1C1F6825DC296","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1224507034:1":{"text":"See ya! I'll be waiting for you, my first mate!","source_cn":"走了！我等着你来，大副！","status":"matched","hash_xxh64":"0x83F51AEC8D4C45AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:30:0:1":{"text":"You should really move on.","source_cn":"辛巴达说的对，你该放下了","status":"matched_runtime_gender","hash_xxh64":"0xD7E70E24B5B73334","variant_status":"runtime_gender_keys_target_same","male":"You should really move on.","female":"You should really move on.","variant_male_record_index":"67910","variant_female_record_index":"67911","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1224507029:1":{"text":"Exactly. There's a reason he passed on so many sailing skills to you.","source_cn":"就是这个道理。要不然，他也不会教你这么多航海技巧了。","status":"matched","hash_xxh64":"0x4633CCEBEDA801A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:30:1:2":{"text":"Your father would be happy.","source_cn":"你父亲一定希望你能继承他的事业","status":"matched_runtime_gender","hash_xxh64":"0x9D07863482A8EC41","variant_status":"runtime_gender_keys_target_same","male":"Your father would be happy.","female":"Your father would be happy.","variant_male_record_index":"67912","variant_female_record_index":"67913","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1224507030:1":{"text":"Who are you trying to fool?","source_cn":"……你骗谁啊？","status":"matched_runtime_gender","hash_xxh64":"0x890566F4C9D07338","variant_status":"runtime_gender_keys_target_same","male":"Who are you trying to fool?","female":"Who are you trying to fool?","variant_male_record_index":"141228","variant_female_record_index":"141229","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:30:2:3":{"text":"I'm not good with words!","source_cn":"我不善言辞！","status":"matched_runtime_gender","hash_xxh64":"0x08233C24D3F81D22","variant_status":"runtime_gender_keys_target_same","male":"I'm not good with words!","female":"I'm not good with words!","variant_male_record_index":"67914","variant_female_record_index":"67915","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:血薇帮贝拉":{"text":"Bella","source":"血薇帮贝拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":40,"localized_text_count":39,"speaker_count":2}}