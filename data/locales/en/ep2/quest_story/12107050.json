{"asset_key":"ep2/quest_story_12107050","episode":"ep2","category":"quest_story","story_id":"12107050","schema_version":1,"lang":"en","texts":{"say:2:1210705001:0":{"text":"Hold up.","source_cn":"站住。","status":"matched","hash_xxh64":"0xF5ED1E71E564F598","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1210705002:0":{"text":"What's up?","source_cn":"老哥，怎么了？","status":"matched","hash_xxh64":"0xA0FA9620EDF9FC30","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1210705003:0":{"text":"Password.","source_cn":"暗号。","status":"matched","hash_xxh64":"0x8A0678BE84AF9E4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210705004:0":{"text":"Password?","source_cn":"暗号？","status":"matched","hash_xxh64":"0x8ECF9180C6B3C9C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210705005:0":{"text":"Ah, let me think. I got into a brawl with some dirty seadogs last night, so my head's still kinda fuzzy.","source_cn":"——啊，让我想想，昨天酒喝多，和人打了一架，脑子还没缓过来。","status":"matched","hash_xxh64":"0xFE8B8C6D846ECB47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210705006:0":{"text":"Psst. Why would we even need a password? Do you think he's suspicious of us?","source_cn":"为什么还有暗号这种东西，我们是不是要暴露了？","status":"matched","hash_xxh64":"0x4FB1928AFEDFDE75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210705007:0":{"text":"Sinbad, do you actually know the password?","source_cn":"辛巴达，你知道暗号是什么吗？","status":"matched","hash_xxh64":"0x34EC3351802AEF69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1210705008:0":{"text":"Don't rush me! Give me some space to hit my creative groove.","source_cn":"急什么？正在编。","status":"matched","hash_xxh64":"0xC088BC6BB7166E20","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210705009:0":{"text":"What?!","source_cn":"什么？！！","status":"matched","hash_xxh64":"0x88363543AD044CB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1210705010:0":{"text":"I can just knock him out—","source_cn":"战斗准备——","status":"matched","hash_xxh64":"0xEF7776E9904A70CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1210705011:0":{"text":"Ah, I got it!","source_cn":"哥们，我想起来了！","status":"matched","hash_xxh64":"0xA84EC374996700E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1210705012:0":{"text":"Lemme slip you a little something. You haven't eaten yet today, right? Here's some freshly caught fish.","source_cn":"刚钓的鱼，肉质鲜嫩，笑纳。","status":"matched","hash_xxh64":"0xF1678353404A78ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1210705013:0":{"text":"Oh... This looks really tempting, but I really can't let you pass without a password.","source_cn":"算你上道，但是暗号还是要——","status":"matched","hash_xxh64":"0xE12DA3575D1018A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1210705014:0":{"text":"Alright, alright. How long has your shift been? You probably wouldn't fill up on just one fish. Lucky for you, I got another one in my bag!","source_cn":"我懂，我懂，瞧我这脑子，这还有两条，都孝敬您了。","status":"matched","hash_xxh64":"0x58FDC80AACA797A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1210705015:0":{"text":"Ah, jeez. You know my weak spot! Alright, buddy. Go on through and leave me to enjoy this fish in peace. And don't get involved in too many brawls in the future, alright?","source_cn":"哼，悠着点，别把脑子都泡酒坛里了，过去吧。","status":"matched","hash_xxh64":"0xBDEFBC7997147945","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1210705016:0":{"text":"Alright. Thanks, pal!","source_cn":"谢谢大哥！","status":"matched","hash_xxh64":"0x53A9ECBEB39FE0B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:水鬼帮奈克":{"text":"Wight Niko","source":"水鬼帮奈克","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":17,"localized_text_count":16,"speaker_count":5}}