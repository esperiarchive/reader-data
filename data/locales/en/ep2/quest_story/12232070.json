{"asset_key":"ep2/quest_story_12232070","episode":"ep2","category":"quest_story","story_id":"12232070","schema_version":1,"lang":"en","texts":{"say:2:1223207001:0":{"text":"Hey! I know some of your stuff went missing, but there's no need to make such a big deal out of it!","source_cn":"喂！不就是弄丢了你的东西吗？叫嚷什么！","status":"matched","hash_xxh64":"0x793A1DBCE5EF3DAE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1223207002:0":{"text":"Everyone! I have with me a sneaky theiving Water Wight here!","source_cn":"大家快来看啊，水鬼耍赖了！","status":"matched","hash_xxh64":"0x783F257CB6F7CCA8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1223207003:1":{"text":"Not only did he refuse to compensate me for losing my stuff, but he also threatened me with violence!","source_cn":"不仅弄丢了我的东西不赔钱，还威胁要打我！","status":"matched","hash_xxh64":"0xFE206F2A501559D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1223207004:1":{"text":"I had to carry so many things back and forth! How can you blame me for losing a box or two?","source_cn":"谁让你的东西那么多，来回搬来搬去，丢了能怪我吗？","status":"matched","hash_xxh64":"0xB3148846E708DAE4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1223207005:1":{"text":"Enough with the excuses and pay up! Or I'll get the Carmine Whispers here!","source_cn":"你……你！少废话，赔钱！不然我就找血薇帮来了！","status":"matched","hash_xxh64":"0x19D0F96C1D5CD93D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1223207006:1":{"text":"Relax, Sir. Just let us know the how much you want, and we'll cover it.","source_cn":"老板别担心，你给个数，我们赔！","status":"matched","hash_xxh64":"0x9952689DD4369CE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1223207007:1":{"text":"Ten thousand gold!","source_cn":"一万金币！给钱吧！","status":"matched","hash_xxh64":"0x6AE2A790810F1153","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1223207008:1":{"text":"That's daylight robbery! How can two crates of fruit be worth that much?!","source_cn":"你打劫呢？！两箱水果值这么多钱？！","status":"matched","hash_xxh64":"0xF7FC33589D63C13C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1223207009:1":{"text":"That amount includes the cost of the damaged goods, the delay, and the emotional damage you've caused me. I could ask for more if you want.","source_cn":"货品损失费，误工费，以及我的心情损失费，一万金币，我还...","status":"matched","hash_xxh64":"0x7690F1991EBFC73D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1223207010:1":{"text":"Damn it! There's no way I'm forking over this money!","source_cn":"妈的！老子今天要是给了这个钱，以后在兄弟们面前头都抬不起！","status":"matched","hash_xxh64":"0x58D37D0B756403DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1223207011:1":{"text":"How about I replace one of your teeth with a golden one? That'll fetch a pretty penny...","source_cn":"要钱是吧？我给你换颗金牙吧？金牙多值钱——","status":"matched","hash_xxh64":"0xB6D9DBF6AA3E7C51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1223207012:1":{"text":"Magister <style=\"stress\"><player_name></style>! Help! This Water Wight's going pry out one of my teeth!","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x8A08E729A9C265F5","variant_status":"runtime_gender_keys_target_same","male":"Magister <style=\"stress\"><player_name></style>! Help! This Water Wight's going pry out one of my teeth!","female":"Magister <style=\"stress\"><player_name></style>! Help! This Water Wight's going pry out one of my teeth!","variant_male_record_index":"139860","variant_female_record_index":"139861","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1223207013:1":{"text":"Cecil, I understand you're angry, so I won't stop you from whatever you want to do.","source_cn":"西索，你心里有火，我不拦你。","status":"matched","hash_xxh64":"0x04B7AD736C29B77F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1223207014:1":{"text":"But I want you to think twice—do you want to end up in jail along with Ralph?","source_cn":"你想清楚，这一拳下去，你就能去和关在审判庭的劳夫做邻居了。","status":"matched","hash_xxh64":"0xD48427B3822BE955","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1223207015:1":{"text":"Kraken's spit! Who has ten thousand gold just lying around?!","source_cn":"妈的！难道你有一万金币？！","status":"matched","hash_xxh64":"0xB70AD068B1039EC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1223207016:1":{"text":"No, but—","source_cn":"我没有，但——","status":"matched","hash_xxh64":"0xBEB96178C4521C65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:22:1223207016":{"text":"No, but—","source_cn":"我没有，但——","status":"matched","hash_xxh64":"0xBEB96178C4521C65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1223207017:0":{"text":"Don't look at us! Even if we had that kind of money, we aren't paying for you!","source_cn":"别看我们，我们就算有，这个钱也该你们自己赔！","status":"matched","hash_xxh64":"0xD506BE673B766253","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1223207018:0":{"text":"Exactly. After all, you're the one responsible for the missing items!","source_cn":"没错，毕竟你弄丢了别人的东西！","status":"matched","hash_xxh64":"0x50D2086B186BC7DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1223207019:1":{"text":"Why don't you try negotiating for a lower amount?","source_cn":"如果钱不够，试着向对方砍价呢？","status":"matched","hash_xxh64":"0xDE0E802BF46FF883","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1223207020:1":{"text":"Negotiate? I only know how to cut throats, not handle figures.","source_cn":"砍价？我只会砍人。","status":"matched","hash_xxh64":"0xCB206CA79130F9ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1223207021:1":{"text":"Uh...","source_cn":"呃……<key:dialog2>","status":"matched","hash_xxh64":"0xF63409B58DA27ED4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:32:1223207021":{"text":"Uh...","source_cn":"呃……","status":"matched","hash_xxh64":"0xF63409B58DA27ED4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1223207023:0":{"text":"Let's give it a try then.","source_cn":"那就试试吧。","status":"matched_runtime_gender","hash_xxh64":"0x05F16A7CAC90E705","variant_status":"runtime_gender_keys_target_same","male":"Let's give it a try then.","female":"Let's give it a try then.","variant_male_record_index":"139873","variant_female_record_index":"139874","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:32:0:1":{"text":"I can help you.","source_cn":"我可以帮你","status":"matched_runtime_gender","hash_xxh64":"0x2D30AB80F382C850","variant_status":"runtime_gender_keys_target_same","male":"I can help you.","female":"I can help you.","variant_male_record_index":"67576","variant_female_record_index":"67577","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:32:1:2":{"text":"Negotiation is what I do best.","source_cn":"我擅长砍价","status":"matched_runtime_gender","hash_xxh64":"0x3ABA6CE52C519A75","variant_status":"runtime_gender_keys_target_same","male":"Negotiation is what I do best.","female":"Negotiation is what I do best.","variant_male_record_index":"67578","variant_female_record_index":"67579","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1223207022:0":{"text":"That's right! The Magister's good at negotiating for discounts and many other stuff!","source_cn":"没错，主人不仅擅长砍价，也擅长砍……呃，总感觉这样说怪怪的！","status":"matched_runtime_gender","hash_xxh64":"0xE2919C0E232BE562","variant_status":"runtime_gender_keys_target_same","male":"That's right! The Magister's good at negotiating for discounts and many other stuff!","female":"That's right! The Magister's good at negotiating for discounts and many other stuff!","variant_male_record_index":"139871","variant_female_record_index":"139872","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:32:2:3":{"text":"I'm slightly better than you.","source_cn":"我比你强一点","status":"matched_runtime_gender","hash_xxh64":"0x20221CA2640BD48F","variant_status":"runtime_gender_keys_target_same","male":"I'm slightly better than you.","female":"I'm slightly better than you.","variant_male_record_index":"67580","variant_female_record_index":"67581","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:0:1":{"text":"I don't either.","source_cn":"我也没有","status":"matched_runtime_gender","hash_xxh64":"0xD3378CDB72CDA124","variant_status":"runtime_gender_keys_target_same","male":"I don't either.","female":"I don't either.","variant_male_record_index":"67570","variant_female_record_index":"67571","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:1:2":{"text":"You should pay.","source_cn":"该你们赔","status":"matched_runtime_gender","hash_xxh64":"0xBC9F6B234A254946","variant_status":"runtime_gender_keys_target_same","male":"You should pay.","female":"You should pay.","variant_male_record_index":"67572","variant_female_record_index":"67573","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:2:3":{"text":"I'm only here to supervise.","source_cn":"我只是来监督的","status":"matched_runtime_gender","hash_xxh64":"0xF67EC98685DAF5D8","variant_status":"runtime_gender_keys_target_same","male":"I'm only here to supervise.","female":"I'm only here to supervise.","variant_male_record_index":"67574","variant_female_record_index":"67575","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:水鬼帮西索":{"text":"Wight Cecil","source":"水鬼帮西索","status":"matched_dialogue_flow"},"speaker:懒洋洋的雇主":{"text":"Lazy Merchant","source":"懒洋洋的雇主","status":"matched_dialogue_flow"},"speaker:水鬼帮阿尔":{"text":"Wight Al","source":"水鬼帮阿尔","status":"matched_dialogu