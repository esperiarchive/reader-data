{"asset_key":"ep2/quest_story_12114380","episode":"ep2","category":"quest_story","story_id":"12114380","schema_version":1,"lang":"en","texts":{"say:2:1211438001:1":{"text":"He tried to control the sea, only to be swallowed by it...","source_cn":"妄图掌控海洋，却最终被海洋吞没……","status":"matched","hash_xxh64":"0x8F710E4EA2AA2E9A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1211438002:1":{"text":"A fittingly ironic end.","source_cn":"多么可笑的结局，倒是与他相配。","status":"matched","hash_xxh64":"0x884DD9508589C45C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211438003:0":{"text":"There's no time to dwell on that!","source_cn":"打住！我们可没空替他伤感！","status":"matched","hash_xxh64":"0xC184BE9FA434537A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211438004:1":{"text":"Sinbad, we gotta run! The Immortal's sinking and creating a whirlpool. We can't get caught in it!","source_cn":"辛巴达，得赶紧远离这里！不死号沉没会形成虹吸的漩涡，我...","status":"matched","hash_xxh64":"0x5F47F7993AB58B97","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1211438005:1":{"text":"On it!","source_cn":"知道了！","status":"matched","hash_xxh64":"0x93C37180AFEA4968","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1211438006:0":{"text":"We've won... so there's no way I'd let us die with that madman!","source_cn":"好不容易才赢得了胜利……我不会让大家给那疯子陪葬！","status":"matched","hash_xxh64":"0xBC9DDC12F5C8232C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1211438007:1":{"text":"Hold on tight! Full sail... port side!","source_cn":"都抓稳了！顺风……左满舵！","status":"matched","hash_xxh64":"0x1762ACEA1172562B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1211438008:1":{"text":"Next stop, Rustport!","source_cn":"目的地——锈锚港！","status":"matched","hash_xxh64":"0x5C24223017AE7DC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:15:1211438009:0":{"text":"You sail back to Rustport...","source_cn":"我们乘船回到了锈锚港……","status":"matched","hash_xxh64":"0x322E7447B32142F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:呼金":{"text":"Hugin","source":"呼金","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_co