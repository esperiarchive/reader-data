{"asset_key":"ep2/quest_story_12202220","episode":"ep2","category":"quest_story","story_id":"12202220","schema_version":1,"lang":"en","texts":{"say:3:1220222001:1":{"text":"<style=\"stress\"><player_name></style>, I'm amazed.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xF6AC919F29F8F34B","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, I'm amazed.","female":"<style=\"stress\"><player_name></style>, I'm amazed.","variant_male_record_index":"134873","variant_female_record_index":"134874","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220222002:0":{"text":"Hehe. This is all a part of the magister's ingenious plan!","source_cn":"哼哼，这一切都是主人的神机妙算！","status":"matched_runtime_gender","hash_xxh64":"0xB194C06165DF52B0","variant_status":"runtime_gender_keys_target_same","male":"Hehe. This is all a part of the magister's ingenious plan!","female":"Hehe. This is all a part of the magister's ingenious plan!","variant_male_record_index":"134875","variant_female_record_index":"134876","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1220222003:1":{"text":"How did you do it?","source_cn":"你们是怎么和呼金说的？","status":"matched","hash_xxh64":"0xBC0DC60618AC0E35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220222004:0":{"text":"\"A groundbreaking invention that will revolutionize Rustport!\"\nI told him about a high-precision solution separation, extraction, and circulation processing device, along with a fully automatic regional coverage system for water circulation!","source_cn":"“一定会改变锈锚港的伟大发明！”\\n高精度溶液分离析出...","status":"matched","hash_xxh64":"0xFB42CD72E088691D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1220222005:0":{"text":"...","source_cn":"………………","status":"matched","hash_xxh64":"0x197F0BE8A09E0D34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1220222006:0":{"text":"I... don't fully understand it, but it clearly ignited Hugin's passion.","source_cn":"完全听不懂。但一听就知道能激起呼金的挑战欲。","status":"matched","hash_xxh64":"0x4CD26EBE1C59EC4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1220222007:0":{"text":"It's not too costly, is it? After all, Rustport's finances are in shambles after being blocked off for so long, and our gang isn't bringing in much.","source_cn":"成本不高吧？咳！那个，经过长时间封锁，现在锈锚港的财政...","status":"matched","hash_xxh64":"0xAD8716D972CD6235","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1220222007":{"text":"It's not too costly, is it? After all, Rustport's finances are in shambles after being blocked off for so long, and our gang isn't bringing in much.","source_cn":"成本不高吧？咳！那个，经过长时间封锁，现在锈锚港的财政一塌糊涂，我们帮派也收不上多少钱。","status":"matched","hash_xxh64":"0xAD8716D972CD6235","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1220222008:0":{"text":"Don't worry, Sonja! We're just going to upgrade the old pipes, so it won't cost much.","source_cn":"放心吧，索尼娅！这是依托旧的净水管道改造，造价不高的。","status":"matched","hash_xxh64":"0x858AA4067A2AC928","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1220222009:0":{"text":"Yeah! No matter how to change a filter, it's still cheaper than building ships and cannons!","source_cn":"对！净水装置再怎么改造价格也不会比造船造大炮贵！","status":"matched","hash_xxh64":"0xA79C85F0BD245CA4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1220222010:0":{"text":"It really is reassuring to have you all here.","source_cn":"果然，有你们在，很安心。","status":"matched","hash_xxh64":"0x5CAF7001E4DB4F16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1220222011:0":{"text":"I'll go assign some people to move Hugin's tools. Want to come along?","source_cn":"我要让人去搬呼金的工具，一起去看看？","status":"matched","hash_xxh64":"0x86C2187C4F286E19","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1220222012:1":{"text":"The guys may not know the different types of equipment well, I'm worried they may break something.","source_cn":"兄弟们不了解需要哪些设备，我担心碰坏。","status":"matched","hash_xxh64":"0x816C2B5AA780D251","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1220222013:1":{"text":"Hmm. Hugin's tools should be similar to the magister's alchemy equipment. We know how to pack them!","source_cn":"唔……呼金的工具应该和梅林的炼金装备很像，我们知道怎么收拾。","status":"matched","hash_xxh64":"0xE48046ACBDEAF63E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1220222014:0":{"text":"Yeah, Chippy will make sure everything goes alright!","source_cn":"没错，交给我们吧！","status":"matched","hash_xxh64":"0x1328557C78CC6EA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1220222015:1":{"text":"Alright, then follow me.","source_cn":"跟我来，在这边。","status":"matched","hash_xxh64":"0x3854FA8CB76BA7FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"It won't be expensive.","source_cn":"成本不高","status":"matched_runtime_gender","hash_xxh64":"0x2814256D5B52016E","variant_status":"runtime_gender_keys_target_same","male":"It won't be expensive.","female":"It won't be expensive.","variant_male_record_index":"66504","variant_female_record_index":"66505","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"It'll just be a couple pipes.","source_cn":"净水装置和输水管道而已","status":"matched_runtime_gender","hash_xxh64":"0x880E04055F0AE3AB","variant_status":"runtime_gender_keys_target_same","male":"It'll just be a couple pipes.","female":"It'll just be a couple pipes.","variant_male_record_index":"66506","variant_female_record_index":"66507","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:2:3":{"text":"We'll use the existing infrastructure.","source_cn":"可以在旧的基础上改造","status":"matched_runtime_gender","hash_xxh64":"0x1DAE0412C2652898","variant_status":"runtime_gender_keys_target_same","male":"We'll use the existing infrastructure.","female":"We'll use the existing infrastructure.","variant_male_record_index":"66508","variant_female_record_index":"66509","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":20,"localized_text_count":19,"speaker_count":3}}