{"asset_key":"ep2/quest_story_12226590","episode":"ep2","category":"quest_story","story_id":"12226590","schema_version":1,"lang":"en","texts":{"say:3:1222659001:1":{"text":"You're right on time.","source_cn":"你来了啊，还挺准时。","status":"matched","hash_xxh64":"0xC70C405B4856A86E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1222659002:1":{"text":"You said there weren't any boats available last time, now there suddenly is?","source_cn":"你上次说没货，现在有了？","status":"matched","hash_xxh64":"0x82429D176371692A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1222659003:1":{"text":"You want a ship that can sail far, but a ship like that usually needs sailors and supplies. It ain't easy getting a hold of all that.","source_cn":"你想要能远航的大船，这种船啊，一般都得配上水手和物资，...","status":"matched","hash_xxh64":"0xEC826D1368AA3CD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1222659004:1":{"text":"I don't need sailors or supplies. Just the ship.","source_cn":"水手和物资，我都用不上，我只要船。","status":"matched","hash_xxh64":"0x7A4E264C656C212E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1222659005:1":{"text":"Alright, well, you're in luck. One of my clients went broke, and his merchant ship's up for grabs. It could be yours.","source_cn":"好吧，你很幸运，我有个客户的资金链断了，他拿自己做生意...","status":"matched","hash_xxh64":"0x27F8E404C5CD6B96","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222659006:1":{"text":"Take me to see it.","source_cn":"带我去看。","status":"matched","hash_xxh64":"0x0E0F98BEB2E97F21","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1222659007:1":{"text":"Hold on, we haven't even discussed the terms yet. Let's talk it over...","source_cn":"别急啊……买卖条款的具体事项都还没聊好呢，你听我慢慢说啊——","status":"matched","hash_xxh64":"0x561DA18825CDBE19","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:水手“红锚”":{"text":"Sailor Gunnar","source":"水手“红锚”","status":"matched_dialogue_flow"},"speaker:神秘的买家":{"text":"Mysterious Buyer","source":"神秘的买家","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}}