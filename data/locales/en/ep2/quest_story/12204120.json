{"asset_key":"ep2/quest_story_12204120","episode":"ep2","category":"quest_story","story_id":"12204120","schema_version":1,"lang":"en","texts":{"say:2:1220412001:0":{"text":"Excuse me, do you know where \"Iron Fist\" Stanton lives?","source_cn":"打扰一下，请问你知不知道“铁拳”斯坦顿住在哪里？","status":"matched","hash_xxh64":"0x0C81F98E7BCAE5E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1220412002:0":{"text":"Stanton, I've sparred with him a few times, great guy.","source_cn":"斯坦顿，我跟他打过几场比赛，他是个厉害的家伙。","status":"matched","hash_xxh64":"0x686F869D2D36D5D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220412003:0":{"text":"We aren't close friends, though, so I'm not sure where he lives. Sorry, can't help you.","source_cn":"我们交情不深，他住在哪儿我就不知道了。抱歉，帮不了你。","status":"matched","hash_xxh64":"0x308E13DBE28BC0B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:地下拳手安尼克":{"text":"Boxer Annick","source":"地下拳手安尼克","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}