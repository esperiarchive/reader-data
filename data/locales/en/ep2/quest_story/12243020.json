{"asset_key":"ep2/quest_story_12243020","episode":"ep2","category":"quest_story","story_id":"12243020","schema_version":1,"lang":"en","texts":{"say:2:1224302001:1":{"text":"I knew you'd be here.","source_cn":"就知道你在这里。","status":"matched","hash_xxh64":"0x975E6C61A1E78610","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1224302002:1":{"text":"Wow, this is quite a surprise! What brings you here?","source_cn":"嘿，哪阵风把你吹来的？真稀奇啊。","status":"matched","hash_xxh64":"0x6FEDEA403EA7E7BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1224302003:1":{"text":"Hold on, did you finally ditch that captain uniform?","source_cn":"等等，你换衣服了？终于舍得脱下那身船长服了？","status":"matched","hash_xxh64":"0xF7EC9F52673F8030","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1224302004:1":{"text":"Everyone was watching me when I wore that at the port; that kind of attention was just too much.","source_cn":"穿那身在港口太引人注意了，不自在。","status":"matched","hash_xxh64":"0x72A42B477D82990F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1224302005:1":{"text":"Let me cut to the chase—I need help from the people of Brineville to repair ships.","source_cn":"废话少说。我要请小水村的人帮忙修船。","status":"matched","hash_xxh64":"0x24CB2ED329F4EA79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1224302006:1":{"text":"I see! No wonder you bring <style=\"stress\"><player_name></style> along to do the talking.","source_cn":"哦！难怪你们找来了<style=stress><pla...","status":"matched_runtime_gender","hash_xxh64":"0x4A44051D9A79C4DE","variant_status":"runtime_gender_keys_target_same","male":"I see! No wonder you bring <style=\"stress\"><player_name></style> along to do the talking.","female":"I see! No wonder you bring <style=\"stress\"><player_name></style> along to do the talking.","variant_male_record_index":"139329","variant_female_record_index":"139330","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1224302006":{"text":"I see! No wonder you bring <style=\"stress\"><player_name></style> along to do the talking.","source_cn":"哦！难怪你们找来了<style=stress><player_name></style>，原来是请<male>他</male><female>她</female>当说客。","status":"matched_runtime_gender","hash_xxh64":"0x4A44051D9A79C4DE","variant_status":"runtime_gender_keys_target_same","male":"I see! No wonder you bring <style=\"stress\"><player_name></style> along to do the talking.","female":"I see! No wonder you bring <style=\"stress\"><player_name></style> along to do the talking.","variant_male_record_index":"139329","variant_female_record_index":"139330","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1224302007:1":{"text":"Your presence here speaks volumes.","source_cn":"你不用说，站在那儿就足够了。","status":"matched_runtime_gender","hash_xxh64":"0x9B3B498BEA6E3606","variant_status":"runtime_gender_keys_target_same","male":"Your presence here speaks volumes.","female":"Your presence here speaks volumes.","variant_male_record_index":"139331","variant_female_record_index":"139332","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1224302010:1":{"text":"Now isn't the time to chitchat! Sinbad, I want you to go back Brineville with me.","source_cn":"现在不是闲聊的时候！辛巴达，跟我一起回小水村。","status":"matched","hash_xxh64":"0x4D3C2EB6F25916EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1224302011:1":{"text":"As a dealer of secrets, my time is billable. Are you paying for my company?","source_cn":"作为一个情报贩子，我的时间是可以卖钱的。怎么，你要付钱...","status":"matched","hash_xxh64":"0x382B1797B804B4F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1224302012:1":{"text":"I can't stand your crap.","source_cn":"油嘴滑舌。","status":"matched","hash_xxh64":"0xE4A57987FF7727D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1224302013:1":{"text":"Don't make me say it again—come with me.","source_cn":"不要再让我说一遍，跟，我，回，去。","status":"matched","hash_xxh64":"0x543633978E0F48C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1224302014:1":{"text":"You can repeat it as many times as you want, but I must catch ten fish today. I only have six now, so <style=\"highlight\">four more to go</style>!","source_cn":"说多少遍都一样。我今天得钓够十条鱼回去，现在才只有六条...","status":"matched","hash_xxh64":"0x6DEC12688E6DA786","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1224302015:1":{"text":"How about you join me in fishing?","source_cn":"要不，你和我一起钓？","status":"matched","hash_xxh64":"0x7390FAE2C59F220C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1224302016:0":{"text":"...Hmph. <style=\"stress\"><player_name></style>'s a fishing expert. Get him to help.","source_cn":"……哼。<style=stress><player_n...","status":"matched_runtime_gender","hash_xxh64":"0x64C3AF56686FEBA7","variant_status":"runtime_gender_keys_target_differs","male":"...Hmph. <style=\"stress\"><player_name></style>'s a fishing expert. Get him to help.","female":"...Hmph. <style=\"stress\"><player_name></style>'s a fishing expert. Get her to help.","variant_male_record_index":"139343","variant_female_record_index":"139344","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1224302017:1":{"text":"Wait a minute, why does Magister have to help with everything? Don't forget he's an honored guest of yours!","source_cn":"等等，怎么什么事都要主人来帮忙啊！主人明明是血薇帮的贵宾！","status":"matched_runtime_gender","hash_xxh64":"0xF6A7EF8CC02A2C5A","variant_status":"runtime_gender_keys_target_differs","male":"Wait a minute, why does Magister have to help with everything? Don't forget he's an honored guest of yours!","female":"Wait a minute, why does Magister have to help with everything? Don't forget she's an honored guest of yours!","variant_male_record_index":"139345","variant_female_record_index":"139346","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1224302018:1":{"text":"Magister <style=\"stress\"><player_name></style>, please help Sinbad.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x874D86204943CF62","variant_status":"runtime_gender_keys_target_same","male":"Magister <style=\"stress\"><player_name></style>, please help Sinbad.","female":"Magister <style=\"stress\"><player_name></style>, please help Sinbad.","variant_male_record_index":"139347","variant_female_record_index":"139348","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:21:1224302018":{"text":"Magister <style=\"stress\"><player_name></style>, please help Sinbad.","source_cn":"<style=stress><player_name></style>大人，请你帮辛巴达钓鱼吧。","status":"matched_runtime_gender","hash_xxh64":"0x874D86204943CF62","variant_status":"runtime_gender_keys_target_same","male":"Magister <style=\"stress\"><player_name></style>, please help Sinbad.","female":"Magister <style=\"stress\"><player_name></style>, please help Sinbad.","variant_male_record_index":"139347","variant_female_record_index":"139348","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1224302019:1":{"text":"Hmm... is that the right attitude when asking for someone's help?","source_cn":"啊这……拜托人帮忙还能这样吗？","status":"matched","hash_xxh64":"0x178F8547D00C8AFC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1224302020:0":{"text":"Haha, please cut Bella some slack. She just doesn't have much luck with fishing!","source_cn":"哈哈，你们就放过她吧。贝拉这家伙，钓鱼的运气太臭！","status":"matched_runtime_gender","hash_xxh64":"0x6E42743776AE9778","variant_status":"runtime_gender_keys_target_same","male":"Haha, please cut Bella some slack. She just doesn't have much luck with fishing!","female":"Haha, please cut Bella some slack. She just doesn't have much luck with fishing!","variant_male_record_index":"139350","variant_female_record_index":"139351","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:21:0:1":{"text":"...","source_cn":"…………","status":"matched_runtime_gender","hash_xxh64":"0x9D117139207F9BBF","variant_status":"runtime_gender_keys_target_same","male":"...","female":"...","variant_male_record_index":"270419","variant_female_record_index":"270420","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:21:1:2":{"text":"Is this a request or a threat?","source_cn":"我这是被请求还是被威胁了","status":"matched_runtime_gender","hash_xxh64":"0x174049BF660E0829","variant_status":"runtime_gender_keys_target_same","male":"Is this a request or a threat?","female":"Is this a request or a threat?","variant_male_record_index":"67362","variant_female_record_index":"67363","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:21:2:3":{"text":"Can you really do this?","source_cn":"还能这样？","status":"matched_runtime_gender","hash_xxh64":"0x0B5FE17C90899D4A","variant_status":"runtime_gender_keys_target_same","male":"Can you really do this?","female":"Can you really do this?","variant_male_record_index":"67364","variant_female_record_index":"67365","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:21:3:4":{"text":"You should mind your tone.","source_cn":"这是求人的语气吗","status":"matched_runtime_gender","hash_xxh64":"0xA565B74EF05A2DAA","variant_status":"runtime_gender_keys_target_same","male":"You should mind your tone.","female":"You should mind your tone.","variant_male_record_index":"6