{"asset_key":"ep2/quest_story_12225150","episode":"ep2","category":"quest_story","story_id":"12225150","schema_version":1,"lang":"en","texts":{"say:5:1222515001:0":{"text":"Bols told me you were staying at the inn.","source_cn":"波尔斯说你们来住店了。果然。","status":"matched","hash_xxh64":"0x4601777855F757E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1222515002:0":{"text":"Hey, wake up! Don't fall back asleep!","source_cn":"喂，醒醒！清醒点！","status":"matched","hash_xxh64":"0x50C681C81B953D3A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1222515003:0":{"text":"Hmm...? Sinbad...?","source_cn":"唔，辛、辛巴达……？","status":"matched","hash_xxh64":"0xBFDDF8516B49860C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222515004:0":{"text":"*Yawn* I'm still sleepy...","source_cn":"呼……啊，好累……","status":"matched","hash_xxh64":"0xF7FD9BFBB5412E5B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1222515005:1":{"text":"Why are you here so early? Did you not sleep well last night? Don't tell me that the calming elixir didn't work.","source_cn":"怎么大早上找过来……你晚上又没睡好？安神药剂没用吗……？","status":"matched","hash_xxh64":"0xE2530635AA21CC1C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1222515006:1":{"text":"It worked a little bit. I fell asleep as soon as I laid down.","source_cn":"有用，但只有一点用。我一躺下就睡着了，从没有那么快过。","status":"matched","hash_xxh64":"0xD8BE74A247AAEBB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1222515007:1":{"text":"But I had the same dream again, only this time it was different. The dream was so clear.","source_cn":"但我还是做梦了，和之前一样的梦！只不过这次不一样，那个...","status":"matched","hash_xxh64":"0x3CF725D542875E9D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1222515007":{"text":"But I had the same dream again, only this time it was different. The dream was so clear.","source_cn":"但我还是做梦了，和之前一样的梦！只不过这次不一样，那个梦非常清晰——","status":"matched","hash_xxh64":"0x3CF725D542875E9D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1222515009:0":{"text":"Chippy remembers! Someone kept nagging Chippy in his dreams!","source_cn":"满满……满满想起来了！好像也有人在我的梦里叽叽喳喳！","status":"matched","hash_xxh64":"0x54A091BD854F1010","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1222515010:1":{"text":"Me too!","source_cn":"我也是！","status":"matched","hash_xxh64":"0x00E75ABFC6921997","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1222515011:1":{"text":"What's going on? Did we really all have the same dream?","source_cn":"……怎么回事，咱们都做了类似的梦？","status":"matched","hash_xxh64":"0x8946ED5D89A8268B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1222515012:1":{"text":"<style=\"stress\"><player_name></style>, is this even possible?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x2DCAD40C0DAADBC2","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, is this even possible?","female":"<style=\"stress\"><player_name></style>, is this even possible?","variant_male_record_index":"138141","variant_female_record_index":"138142","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:17:1222515012":{"text":"<style=\"stress\"><player_name></style>, is this even possible?","source_cn":"<style=stress><player_name></style>，这种情况很常见吗？","status":"matched_runtime_gender","hash_xxh64":"0x2DCAD40C0DAADBC2","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, is this even possible?","female":"<style=\"stress\"><player_name></style>, is this even possible?","variant_male_record_index":"138141","variant_female_record_index":"138142","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1222515013:1":{"text":"I dreamed Tasi was saying, \"The Dream Isle is about to be destroyed!\"","source_cn":"我记得梦里的塔西说，“<style=highlight...","status":"matched_runtime_gender","hash_xxh64":"0x2E351E476BF061EF","variant_status":"runtime_gender_keys_target_same","male":"I dreamed Tasi was saying, \"The Dream Isle is about to be destroyed!\"","female":"I dreamed Tasi was saying, \"The Dream Isle is about to be destroyed!\"","variant_male_record_index":"138143","variant_female_record_index":"138144","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1222515014:1":{"text":"Something must've happened at the Dream Isle. That's why she came to all of us in our dreams.","source_cn":"也许藏梦岛的确出事了，所以她才入梦来向我们求援。","status":"matched","hash_xxh64":"0xEE36C5C1F191BFDE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1222515015:1":{"text":"Magister, we have to go and check! Tasi may really need us!","source_cn":"主人，我们去看看吧，也许塔西真的需要我们！","status":"matched_runtime_gender","hash_xxh64":"0x2AA315211E18771C","variant_status":"runtime_gender_keys_target_same","male":"Magister, we have to go and check! Tasi may really need us!","female":"Magister, we have to go and check! Tasi may really need us!","variant_male_record_index":"138146","variant_female_record_index":"138147","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1222515016:1":{"text":"Count me in too. I still miss that mountain of gold she has there.","source_cn":"算我一个。我还惦记着藏宝地里那座用金币堆成的小山。","status":"matched","hash_xxh64":"0xCB04A40BFE033DBB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1222515017:1":{"text":"Even if I can't bring any of it back, it'd be nice to jump into that pile of gold and swim around again.","source_cn":"就算带不回来，能再多看几眼也不错！","status":"matched","hash_xxh64":"0x4867D88C6F641B61","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:23:1222515017":{"text":"Even if I can't bring any of it back, it'd be nice to jump into that pile of gold and swim around again.","source_cn":"就算带不回来，能再多看几眼也不错！","status":"matched","hash_xxh64":"0x4867D88C6F641B61","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1222515018:1":{"text":"Hey, I love helping people, and taking a quick dip isn't gonna stop me from doing that. ","source_cn":"帮人，欣赏宝贝，都不耽误！","status":"matched","hash_xxh64":"0xD42AADD7A8659474","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1222515019:1":{"text":"Get ready! Dream Isle, here we come!","source_cn":"走，咱们去藏梦岛。","status":"matched","hash_xxh64":"0x1E5A5E09ADF1EE49","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:23:0:1":{"text":"We're going there to help, remember?","source_cn":"我们是为了帮人……","status":"matched_runtime_gender","hash_xxh64":"0x5F2F237C1D2EC67C","variant_status":"runtime_gender_keys_target_same","male":"We're going there to help, remember?","female":"We're going there to help, remember?","variant_male_record_index":"67154","variant_female_record_index":"67155","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:0:1":{"text":"It's my first time encountering this.","source_cn":"第一次遇到","status":"matched_runtime_gender","hash_xxh64":"0x2993CA6F3259C900","variant_status":"runtime_gender_keys_target_same","male":"It's my first time encountering this.","female":"It's my first time encountering this.","variant_male_record_index":"67148","variant_female_record_index":"67149","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:1:2":{"text":"This might've happened before, but I forgot.","source_cn":"可能发生过，但我忘了","status":"matched_runtime_gender","hash_xxh64":"0x05F3A81D81A70501","variant_status":"runtime_gender_keys_target_same","male":"This might've happened before, but I forgot.","female":"This might've happened before, but I forgot.","variant_male_record_index":"67150","variant_female_record_index":"67151","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:2:3":{"text":"Something must've happened.","source_cn":"也许真的出事了？","status":"matched_runtime_gender","hash_xxh64":"0x907DAAFCE88B3B84","variant_status":"runtime_gender_keys_target_same","male":"Something must've happened.","female":"Something must've happened.","variant_male_record_index":"67152","variant_female_record_index":"67153","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:0:1":{"text":"Something is wrong at the Dream Isle.","source_cn":"藏梦岛出事了？","status":"matched_runtime_gender","hash_xxh64":"0xFEB63051B12905A0","variant_status":"runtime_gender_keys_target_same","male":"Something is wrong at the Dream Isle.","female":"Something is wrong at the Dream Isle.","variant_male_record_index":"67142","variant_female_record_index":"67143","document_title":"","docum