{"asset_key":"ep2/quest_story_12235010","episode":"ep2","category":"quest_story","story_id":"12235010","schema_version":1,"lang":"en","texts":{"say:2:1223501001:1":{"text":"There you are...","source_cn":"你来了……","status":"matched_runtime_gender","hash_xxh64":"0x1EB9FB203447F4C7","variant_status":"runtime_gender_keys_target_same","male":"There you are...","female":"There you are...","variant_male_record_index":"138795","variant_female_record_index":"138796","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1223501002:1":{"text":"How come you're all battered and bruised? Are you okay?","source_cn":"你怎么浑身是伤，没事吧？","status":"matched","hash_xxh64":"0x778D3669E537370E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1223501003:1":{"text":"I'm going to tell Renata that I was beaten up by the Carmine Whispers.","source_cn":"我寻思见雷纳塔时候，就说被血薇帮打了。","status":"matched","hash_xxh64":"0x345AE9FB1DB0B260","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1223501004:1":{"text":"Given how paranoid she is, she'll only believe me when she sees my wounds.","source_cn":"她性子多疑，看到我身上的伤，才会相信我。","status":"matched","hash_xxh64":"0xE8D7CA67427C48D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1223501005:1":{"text":"Still, you look pretty rough. Who did this to you?","source_cn":"也真敢下手啊，谁打的？","status":"matched","hash_xxh64":"0x674E4B7DCF8EA4AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1223501006:1":{"text":"Paz and Thoreau. Maybe they've long been itching to punch me. I don't think they held back, haha!","source_cn":"帕斯和梭罗，可能他俩早就想打我了，打的很真哈哈哈！","status":"matched","hash_xxh64":"0x79BF0085C47D41E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1223501006":{"text":"Paz and Thoreau. Maybe they've long been itching to punch me. I don't think they held back, haha!","source_cn":"帕斯和梭罗，可能他俩早就想打我了，打的很真哈哈哈！","status":"matched","hash_xxh64":"0x79BF0085C47D41E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1223501007:0":{"text":"Looks like they went really hard with their punches...","source_cn":"看来打得真的很重……","status":"matched","hash_xxh64":"0x8B0B9A6149521142","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1223501008:1":{"text":"Everything's worthwhile as long as I can gain Renata's trust. I've arranged to meet her at Ashen Bay.","source_cn":"这不重要，重要的是让雷纳塔相信我，我和她约了在灰烬湾见面。","status":"matched","hash_xxh64":"0xBDE53AD60F7B379F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1223501009:1":{"text":"We Water Wights have an unspoken rule. Are you aware of it?","source_cn":"但……水鬼帮有个不成文的规矩，你们也知道吧？","status":"matched","hash_xxh64":"0x2EA4E96D733BB09F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1223501009":{"text":"We Water Wights have an unspoken rule. Are you aware of it?","source_cn":"但……水鬼帮有个不成文的规矩，你们也知道吧？","status":"matched","hash_xxh64":"0x2EA4E96D733BB09F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1223501010:1":{"text":"That's right! You must have seen how it's done when you raided us at the Lookout Point last time.","source_cn":"对对对，你们去瞭望角抄我们家的时候，应该见识过。","status":"matched_runtime_gender","hash_xxh64":"0x2C371A2219CF332E","variant_status":"runtime_gender_keys_target_same","male":"That's right! You must have seen how it's done when you raided us at the Lookout Point last time.","female":"That's right! You must have seen how it's done when you raided us at the Lookout Point last time.","variant_male_record_index":"138805","variant_female_record_index":"138806","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1223501011:1":{"text":"Simply put, it's bribery.","source_cn":"说白了就是贿赂。","status":"matched_runtime_gender","hash_xxh64":"0xC2C1CF9D024316D9","variant_status":"runtime_gender_keys_target_same","male":"Simply put, it's bribery.","female":"Simply put, it's bribery.","variant_male_record_index":"138807","variant_female_record_index":"138808","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1223501014:1":{"text":"What should you offer them? Fish or cash?","source_cn":"那要上贡什么东西呢？鱼？还是钱？","status":"matched","hash_xxh64":"0xD1F25DD5EF9F7B0D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1223501015:1":{"text":"A damedangler, at the very least. I'll get Paz to catch it.","source_cn":"最次也要冥湾美人，我准备让帕斯去钓。","status":"matched","hash_xxh64":"0xD24EF86583FAE1F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1223501016:1":{"text":"Paz isn't the brightest among us, but he's really good at fishing.","source_cn":"帕斯虽然脑子不太好，但钓鱼还是有一手的。","status":"matched","hash_xxh64":"0xB995AA75F9542F9D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1223501017:1":{"text":"How about we go with him to make sure everything goes well?","source_cn":"为免出意外，我们也跟着去瞧瞧吧？","status":"matched","hash_xxh64":"0x3630DFCC71BA7020","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1223501018:1":{"text":"Great! With you around, I won't have to worry about Paz.","source_cn":"有你们跟着，我就更放心了。","status":"matched","hash_xxh64":"0xEE2807C53D2B9EA9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"Paying tribute?","source_cn":"上贡？","status":"matched_runtime_gender","hash_xxh64":"0xF726EC3075AC38B8","variant_status":"runtime_gender_keys_target_same","male":"Paying tribute?","female":"Paying tribute?","variant_male_record_index":"67240","variant_female_record_index":"67241","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1223501012:1":{"text":"What are you talking about? I have to pay them tribute! Simply put, it's bribery.","source_cn":"什么话，是上贡！说白了就是贿赂。<key:dialog1>","status":"matched_runtime_gender","hash_xxh64":"0x673BF74675EF7A9F","variant_status":"runtime_gender_keys_target_same","male":"What are you talking about? I have to pay them tribute! Simply put, it's bribery.","female":"What are you talking about? I have to pay them tribute! Simply put, it's bribery.","variant_male_record_index":"138809","variant_female_record_index":"138810","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:1:2":{"text":"Getting trampled?","source_cn":"上吊？","status":"matched_runtime_gender","hash_xxh64":"0xD9056870462928AC","variant_status":"runtime_gender_keys_target_same","male":"Getting trampled?","female":"Getting trampled?","variant_male_record_index":"67242","variant_female_record_index":"67243","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1223501013:1":{"text":"What are you talking about? I have to pay them tribute! Simply put, it's bribery.","source_cn":"什么话，是上贡！说白了就是贿赂。<key:dialog2>","status":"matched_runtime_gender","hash_xxh64":"0x123F3C259B8AEC63","variant_status":"runtime_gender_keys_target_same","male":"What are you talking about? I have to pay them tribute! Simply put, it's bribery.","female":"What are you talking about? I have to pay them tribute! Simply put, it's bribery.","variant_male_record_index":"138811","variant_female_record_index":"138812","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:2:3":{"text":"Treating them like god?","source_cn":"上香？","status":"matched_runtime_gender","hash_xxh64":"0x0CE9368291762559","variant_status":"runtime_gender_keys_target_same","male":"Treating them like god?","female":"Treating them like god?","variant_male_record_index":"67244","variant_female_record_index":"67245","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"Did you just crack a joke?","source_cn":"这是水鬼的冷笑话吗","status":"matched_runtime_gender","hash_xxh64":"0x951D2A8F876F90B2","variant_status":"runtime_gender_keys_target_same","male":"Did you just crack a joke?","female":"Did you just crack a joke?","variant_male_record_index":"67234","variant_female_record_index":"67235","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"We can take over next time.","source_cn":"下次我们可以代劳","status":"matched_runtime_gender","hash_xxh64":"0x6BC7B058C1DF792D","variant_status":"runtime_gender_keys_target_same","male":"We can take over next time.","female":"We can take over next time.","variant_male_record_index":"67236","variant_female_record_index":"67237","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:2:3":{"text":"You have a positive mentality.","source_cn":"你们心态不错","status":"matched_runtime_gender","hash_xxh64":"0xB1E49258AE4425BA","variant_status":"runtime_gender_keys_target_same","male":"You have a positive mentality.","female":"You have a positive mentality.","variant_male_record_index":"67238","variant_female_record_index":"67239","document_title":"","document_title_male":"","document_title_female":"","document_title_