{"asset_key":"ep2/quest_story_12211030","episode":"ep2","category":"quest_story","story_id":"12211030","schema_version":1,"lang":"en","texts":{"say:3:1221103001:1":{"text":"Something shiny! In the sea!","source_cn":"海面有，亮晶晶的，东西！","status":"matched","hash_xxh64":"0x70B93182F7DC328B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1221103002:1":{"text":"Eh? There really is something shiny in the water. Did you drop it?","source_cn":"咦？海面上真的有个闪闪发光的东西。是你们掉的吗？","status":"matched","hash_xxh64":"0x507C69424D05A921","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1221103003:1":{"text":"No, it drifted over here. From somewhere really far away!","source_cn":"不是。它从——很远很远，漂过来！","status":"matched","hash_xxh64":"0x5C9556DB92C37989","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1221103004:1":{"text":"Drifted over? Could it be a floating bottle?","source_cn":"漂过来的？难道是漂流瓶之类的东西？","status":"matched","hash_xxh64":"0x94DCFEBEB66654B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1221103005:1":{"text":"A lot of good stuff! In the bottle!","source_cn":"瓶子，很多！里面，会有好东西！","status":"matched","hash_xxh64":"0x3D562E1DF41FA591","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1221103006:1":{"text":"I want it! But can't reach it...","source_cn":"荧荧花，喜欢！可是，拿不到……","status":"matched","hash_xxh64":"0x042B4944CEE0F76D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1221103007:1":{"text":"A floating bottle is a rare find. I wonder what's inside...","source_cn":"居然会有漂流瓶漂到这里，真是难得一见。不知道瓶子里会装...","status":"matched","hash_xxh64":"0x31CAFA6D14724794","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1221103008:1":{"text":"Magister, should we fish it out and take a look?","source_cn":"主人，我们要不要把它捞上来看看？","status":"matched_runtime_gender","hash_xxh64":"0xF7FA03CD637FA24D","variant_status":"runtime_gender_keys_target_same","male":"Magister, should we fish it out and take a look?","female":"Magister, should we fish it out and take a look?","variant_male_record_index":"134616","variant_female_record_index":"134617","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1221103009:1":{"text":"But we don't have anything to fish it out with...","source_cn":"可我们手头也没有打捞工具呀……","status":"matched","hash_xxh64":"0xBCE3265B608634F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1221103010:1":{"text":"There are... some torn <style=\"highlight\">fishing nets</style> nearby! You can... piece them together!","source_cn":"附近，有<style=highlight>渔网</st...","status":"matched","hash_xxh64":"0xDC65B9E6CDA283D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1221103011:1":{"text":"We can do that?! Then what are we waiting for? Let's make a big net right away!","source_cn":"还可以这样！？那我们还等什么，赶紧拼张大网出来吧！","status":"matched","hash_xxh64":"0xBEF455154A1D67BB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:蓝叶荧荧花":{"text":"Blue Leaf Bloom","source":"蓝叶荧荧花","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:绿叶荧荧花":{"text":"Green Leaf Bloom","source":"绿叶荧荧花","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":12,"localized_text_count":11,"speaker_count":4}}