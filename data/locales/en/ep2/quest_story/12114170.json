{"asset_key":"ep2/quest_story_12114170","episode":"ep2","category":"quest_story","story_id":"12114170","schema_version":1,"lang":"en","texts":{"say:3:1211417001:1":{"text":"Sinbad, what are you holding?","source_cn":"辛巴达，你手上拿着什么？","status":"matched","hash_xxh64":"0xCE991A425D499922","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211417002:1":{"text":"A blank sheet of paper.","source_cn":"一张什么都没写的白纸。","status":"matched","hash_xxh64":"0xDB7F8303F5FB59D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:5::0":{"text":"Blank Page","source_cn":"空白的纸","status":"matched","hash_xxh64":"0x52406B157CD0D2C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211417003:1":{"text":"Is it... useful?","source_cn":"这……有用吗？","status":"matched","hash_xxh64":"0x30DCDF2CE0BA1463","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211417004:1":{"text":"Not at all. But look at what's in my other hand. I also found this!","source_cn":"当然没用。但是除此之外，我还找到了这个！","status":"matched","hash_xxh64":"0xDCDDD3BA438972C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:8::0":{"text":"Dragonflame Spire","source_cn":"龙息柱","status":"matched","hash_xxh64":"0x945D34543A100365","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1211417005:1":{"text":"This is a Dragonflame Spire. It's highly sought after during wars, and it's a super rare item.","source_cn":"这叫龙息柱，在战争时期可是旅人们梦寐以求的物品，现在已...","status":"matched","hash_xxh64":"0xCB42489A1E9E6115","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1211417006:1":{"text":"The flames ignite if you blow lightly on the ring. It's very handy for people who can't use magic.","source_cn":"只要在圈口轻轻吹气，随时能点燃火焰。对于不会魔法的旅行...","status":"matched","hash_xxh64":"0x696CBA438A231359","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1211417007:1":{"text":"Why would someone use that when matches exist? It's pretty big compared to matches.","source_cn":"如今火柴很普遍了，这东西也没什么用处嘛。","status":"matched","hash_xxh64":"0xE4C8B4F4777AB9F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1211417008:1":{"text":"Those two are completely different!","source_cn":"那能一样吗？","status":"matched","hash_xxh64":"0xAE6C6307EA3A0CE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1211417009:0":{"text":"There's supposedly dragon grease at the base. Dragon flames can burn anywhere, even on water.","source_cn":"据说这东西底部储存着龙的油脂。龙焰能在任何地方燃烧，甚...","status":"matched","hash_xxh64":"0x68FDF01ABD5D3081","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1211417010:1":{"text":"It can burn anywhere, you say...?","source_cn":"能在任何地方燃烧啊……","status":"matched","hash_xxh64":"0x413621B216AEAA11","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1211417011:1":{"text":"Sonja, did you think of something?","source_cn":"索尼娅，你想到什么了？","status":"matched","hash_xxh64":"0x9FA55F75127AF31D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1211417012:1":{"text":"Something's felt off to me ever since we entered this study. Call it years of honing my instincts.","source_cn":"其实进入这间书房后，我有种不协调的感觉。","status":"matched","hash_xxh64":"0xBDA38FACE0273503","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1211417013:1":{"text":"There are six candelabras arranged symmetrically, but the one by the window isn't lit.","source_cn":"屋内共有六盏对称分布的烛台，唯独窗边的这一盏熄灭了。","status":"matched","hash_xxh64":"0x30162967620B50DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1211417014:1":{"text":"I tried to light it, but the wick is damp and it won't catch fire.","source_cn":"我试着点燃它，却发现烛芯潮湿软塌，难以燃烧。","status":"matched","hash_xxh64":"0xF7A67B67C9A3E679","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:22:1211417014":{"text":"I tried to light it, but the wick is damp and it won't catch fire.","source_cn":"我试着点燃它，却发现烛芯潮湿软塌，难以燃烧。","status":"matched","hash_xxh64":"0xF7A67B67C9A3E679","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1211417015:1":{"text":"Exactly. Sinbad said this ship is full of traps and various mechanisms. This might unlock one of them.","source_cn":"没错，辛巴达说过，不死号内藏有各式机关。这或许是突破口。","status":"matched_runtime_gender","hash_xxh64":"0xC278C04BA8307C0A","variant_status":"runtime_gender_keys_target_same","male":"Exactly. Sinbad said this ship is full of traps and various mechanisms. This might unlock one of them.","female":"Exactly. Sinbad said this ship is full of traps and various mechanisms. This might unlock one of them.","variant_male_record_index":"132160","variant_female_record_index":"132161","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1211417017:1":{"text":"B-but! Dragonflame Spires are extremely rare! And look how much dust is accumulated on this one, there's no telling how old it is! Who knows how many uses it has left...?","source_cn":"龙息柱很稀有啊！这根都旧了，也不知道还能用几次……","status":"matched","hash_xxh64":"0xBFFB65A4EEEBD851","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1211417018:1":{"text":"My dearest, most wonderful, absolutely favorite fellow travelers, couldn't we... maybe think of another way?","source_cn":"要不……你们再想想？","status":"matched","hash_xxh64":"0xE111EF392BBC460C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:26:1211417018":{"text":"My dearest, most wonderful, absolutely favorite fellow travelers, couldn't we... maybe think of another way?","source_cn":"要不……你们再想想？","status":"matched","hash_xxh64":"0xE111EF392BBC460C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1211417019:1":{"text":"Hey, be careful with that! That's probably worth 100 times of what I make in a year!","source_cn":"诶——拿稳了！这东西贵着呢！","status":"matched_runtime_gender","hash_xxh64":"0xB0E59AF1E69C691D","variant_status":"runtime_gender_keys_target_same","male":"Hey, be careful with that! That's probably worth 100 times of what I make in a year!","female":"Hey, be careful with that! That's probably worth 100 times of what I make in a year!","variant_male_record_index":"132166","variant_female_record_index":"132167","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1211417022:1":{"text":"Please light the candle, <style=\"stress\"><player_name></style>.","source_cn":"那么，劳烦你点燃蜡烛了，<style=stress><...","status":"matched_runtime_gender","hash_xxh64":"0xFBCCD9676C8D0C5E","variant_status":"runtime_gender_keys_target_same","male":"Please light the candle, <style=\"stress\"><player_name></style>.","female":"Please light the candle, <style=\"stress\"><player_name></style>.","variant_male_record_index":"132172","variant_female_record_index":"132173","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:0:1":{"text":"Give it to me.","source_cn":"（拿过龙息柱）","status":"matched_runtime_gender","hash_xxh64":"0x9CFC9500B57A80B3","variant_status":"runtime_gender_keys_target_same","male":"Give it to me.","female":"Give it to me.","variant_male_record_index":"66074","variant_female_record_index":"66075","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1211417020:1":{"text":"Fine, fine! Just take it, you cruel, cruel person!","source_cn":"好了好了……我给你还不行吗！","status":"matched_runtime_gender","hash_xxh64":"0xBC7D487E1727C25E","variant_status":"runtime_gender_keys_target_same","male":"Fine, fine! Just take it, you cruel, cruel person!","female":"Fine, fine! Just take it, you cruel, cruel person!","variant_male_record_index":"132168","variant_female_record_index":"132169","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:1:2":{"text":"I'll count down from 3... 2...","source_cn":"（盯着辛巴达）","status":"matched_runtime_gender","hash_xxh64":"0xEC9B2F83330A7966","variant_status":"runtime_gender_keys_target_same","male":"I'll count down from 3... 2...","female":"I'll count down from 3... 2...","variant_male_record_index":"66076","variant_female_record_index":"66077","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1211417021:1":{"text":"How did you turn from an angel to a devil so quickly?! Fine, I guess I have no choice...","source_cn":"你这人……变脸也太快了吧！我给你就是……","status":"matched_runtime_gender","hash_xxh64":"0xD8748F50C35D91BF","variant_status":"runtime_gender_keys_target_same","male":"How did you turn from an angel to a devil so quickly?! Fine, I guess I have no choice...","female":"How did you turn from an angel to a devil so quickly?! Fine, I guess I have no choice...","variant_male_record_index":"132170","variant_female_record_index":"132171","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:2:3":{"text":"You'll regret it if you don't.","source_cn":"（威胁辛巴达）","status":"matched_runtime_gender","hash_xxh64":"0x21CAFA402D3A76E8","variant_status":"runtime_gender_keys_target_same","male":"You'll regret it if you don't.","female":"You'll regret it if you don't.","variant_male_record_index":"66078","variant_female_record_index":"66079","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:0:1":{"text":"There's a hidden mechanism!","source_cn":"这里藏有机关","status":"matched_runtime_gender","hash_xxh64":"0xBB6D66E48DB5F774","variant_status":"runtime_gender_keys_target_same","male":"There's a hidden mechanism!","female":"There's a hidden mechanism!","variant_male_record_index":"66070","variant_female_record_index":"66071","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1211417016:1":{"text":"You took the words right out of my mouth.","source_cn":"嗯，我也是这么想的。","status":"matched_runtime_gender","hash_xxh64":"0x894A559D822AEB6C","variant_status":"runtime_gender_keys_target_same","male":"You took the words right out of my mouth.","female":"You took the words right out of my mouth.","variant_male_record_index":"132162","variant_female_record_index":"132163","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:1