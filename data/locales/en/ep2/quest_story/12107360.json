{"asset_key":"ep2/quest_story_12107360","episode":"ep2","category":"quest_story","story_id":"12107360","schema_version":1,"lang":"en","texts":{"say:2:1210736001:1":{"text":"Sonja, you finally made it! I've been waiting, waiting, waiting!","source_cn":"姐姐，你终于来了？我等你好久了！","status":"matched","hash_xxh64":"0x4B49E0C233E40F9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1210736002:0":{"text":"... You knew about us all along?","source_cn":"……！\\n你早就发现我们了？","status":"matched","hash_xxh64":"0x5887662BDC580A34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1210736003:0":{"text":"Did you think I only had eyes for that dumb Bonnie? Oh, you sweet, naive thing! Hahaha!","source_cn":"不然呢，你以为我只发现了波妮那个蠢货吗？！天真哈哈哈哈！","status":"matched","hash_xxh64":"0x4726E712803B03DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1210736003":{"text":"Did you think I only had eyes for that dumb Bonnie? Oh, you sweet, naive thing! Hahaha!","source_cn":"不然呢，你以为我只发现了波妮那个蠢货吗？！天真哈哈哈哈！","status":"matched","hash_xxh64":"0x4726E712803B03DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210736004:0":{"text":"Zip it! When my sister and I are talking, you keep your trap shut!","source_cn":"喂，你是什么东西？我和姐姐在聊天的时候，给我闭上嘴！","status":"matched_runtime_gender","hash_xxh64":"0x514B52FD9CC9D6B7","variant_status":"runtime_gender_keys_target_same","male":"Zip it! When my sister and I are talking, you keep your trap shut!","female":"Zip it! When my sister and I are talking, you keep your trap shut!","variant_male_record_index":"131414","variant_female_record_index":"131415","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210736005:0":{"text":"Weren't you looking for Tesio, Sonja? I brought him right to you. How was it? Did ya have fun?","source_cn":"姐姐，你不是想要泰西欧吗？我送给你啦，怎么样，玩得开心吗？","status":"matched","hash_xxh64":"0xFE84E5466B78AB2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1210736006:0":{"text":"Judging by your face, you're not having as much fun as I am. What's the matter? I... couldn't be happier!","source_cn":"瞧你的表情，好像不是很开心呢……怎么办？我可……开心地...","status":"matched","hash_xxh64":"0x6918418D1D859D4F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1210736007:0":{"text":"Nara...","source_cn":"奈拉……","status":"matched","hash_xxh64":"0x6955F4AFE1F2D403","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210736008:0":{"text":"Enough with that pitying look. Don't treat me like I'm dead! My body may be wrecked, but my ears are sharp.","source_cn":"收起你可笑的怜悯，别把我当个死人！！虽然我的身体的确破...","status":"matched","hash_xxh64":"0xB47B6C5B9C34E490","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210736009:0":{"text":"Right now, I hear your heart pounding like crazy and the blood rushing through your veins.","source_cn":"比如现在，我就听到了你胸膛……用力收缩的……心脏，还有...","status":"matched","hash_xxh64":"0xCAD9C2611246AA88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210736010:0":{"text":"Oh, sister dear, don't tell me you're nervous, or maybe even a little... scared?","source_cn":"噢，不是吧？亲爱的姐姐，你的心跳告诉我，你很紧张？还有...","status":"matched","hash_xxh64":"0x0AF6BC2A36D90661","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1210736011:0":{"text":"What's got you trembling? Me? My hook? Or are you scared you'll end up like me?","source_cn":"你在怕什么？怕我？怕我的钩锁，还是……怕我把你也变成我这样？","status":"matched","hash_xxh64":"0xE607D796197607C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1210736012:0":{"text":"Enough.","source_cn":"……够了。","status":"matched","hash_xxh64":"0x6DC3EBBD5441C104","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210736013:0":{"text":"Hahahaha! I see now. You're afraid... of my hatred?","source_cn":"哈哈哈哈哈哈！我知道了，你怕……我的恨？","status":"matched","hash_xxh64":"0xD95AEF2C51D77D71","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1210736014:0":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1210736015:0":{"text":"Ha! It's just too funny! *Manic laughter*","source_cn":"哈哈哈……哈哈哈哈哈……哈哈！太好笑了哈哈哈哈……","status":"matched","hash_xxh64":"0x48D5B2E9A5FCF109","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1210736016:0":{"text":"Can you do anything but laugh now?","source_cn":"如果不想笑，就别笑。","status":"matched","hash_xxh64":"0x66673EC03AEA75EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1210736017:0":{"text":"Since you're not in the mood to chat, then say hello to my hook. It's been dying to meet you...","source_cn":"……既然你不想和我叙旧，那就来和我的钩锁打招呼吧，它可...","status":"matched","hash_xxh64":"0x6C66D758E48E3F8D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1210736018:0":{"text":"Your head, your heart, your limbs... It wants them all!","source_cn":"——你的头，你的心脏，四肢，它全都想割下来呢！！！","status":"matched","hash_xxh64":"0x28DE75D1A8A06E0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"You knew all along?","source_cn":"你在守株待兔？","status":"matched_runtime_gender","hash_xxh64":"0x9FBF5AA8739735D2","variant_status":"runtime_gender_keys_target_same","male":"You knew all along?","female":"You knew all along?","variant_male_record_index":"65910","variant_female_record_index":"65911","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:1:2":{"text":"I can't believe this.","source_cn":"谁蠢还不一定呢","status":"matched_runtime_gender","hash_xxh64":"0x6AAEA6F981CF198D","variant_status":"runtime_gender_keys_target_same","male":"I can't believe this.","female":"I can't believe this.","variant_male_record_index":"65912","variant_female_record_index":"65913","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":22,"localized_text_count":21,"speaker_count":2}}