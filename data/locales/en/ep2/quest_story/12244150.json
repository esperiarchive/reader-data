{"asset_key":"ep2/quest_story_12244150","episode":"ep2","category":"quest_story","story_id":"12244150","schema_version":1,"lang":"en","texts":{"say:2:1224415001:1":{"text":"Lucca, how did the discussion with the Brineville villagers go?","source_cn":"卢卡先生，小水村的人谈下来长期合作了吗？","status":"matched","hash_xxh64":"0xF3F40D7F38145A96","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1224415002:1":{"text":"It turned out fine.","source_cn":"还行。","status":"matched","hash_xxh64":"0x93EC901B6F9EE5EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1224415003:1":{"text":"They were happy with the trial, so we've finalized a long-term collaboration plan.","source_cn":"她们满意审判，我们定下了合作计划。","status":"matched","hash_xxh64":"0x3F3B6A4F05305685","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1224415004:1":{"text":"That's great! Sinbad doesn't have to do the talking anymore!","source_cn":"那太好了，看来用不上辛巴达去劝她们了！","status":"matched","hash_xxh64":"0xF533FEEB9FE40199","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1224415005:1":{"text":"There's one more thing.","source_cn":"还有另一件事。","status":"matched","hash_xxh64":"0x3B26254E8A4BD38C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1224415006:1":{"text":"Once all the ships have been repaired, we'll send out an advance fleet to explore the route.","source_cn":"船只修理全部完成之后，我们会派先遣队出航，先去探探路。","status":"matched","hash_xxh64":"0x9C1DD51DA712FD88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1224415007:1":{"text":"And Sonja wants your take on this matter.","source_cn":"这件事，索尼娅让我问问你们的意见。","status":"matched","hash_xxh64":"0x69A223204DE1A4A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1224415007":{"text":"And Sonja wants your take on this matter.","source_cn":"这件事，索尼娅让我问问你们的意见。","status":"matched","hash_xxh64":"0x69A223204DE1A4A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1224415008:1":{"text":"Holistone?","source_cn":"圣石镇？","status":"matched","hash_xxh64":"0xC04C12F6D42AF925","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1224415009:1":{"text":"That's right! The magistrate there, General Hogan, is a friend of Magister's! With his help, you can do business with Holistone again in no time!","source_cn":"没错！那里的治安官，霍根将军，是主人的朋友！有了他的帮...","status":"matched_runtime_gender","hash_xxh64":"0x8BBC2A5EC4061DBF","variant_status":"runtime_gender_keys_target_same","male":"That's right! The magistrate there, General Hogan, is a friend of Magister's! With his help, you can do business with Holistone again in no time!","female":"That's right! The magistrate there, General Hogan, is a friend of Magister's! With his help, you can do business with Holistone again in no time!","variant_male_record_index":"139545","variant_female_record_index":"139546","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1224415012:1":{"text":"Sounds good. I'll run the idea by Sonja for her to deploy the advance fleet to Holistone.","source_cn":"好主意。我会上报给索尼娅，请她派先遣队前往圣石镇。","status":"matched","hash_xxh64":"0x657E32486B99E7D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1224415013:1":{"text":"Let's put contacting General Hogan on the back burner for now.","source_cn":"至于联络圣石镇的事，不着急。","status":"matched","hash_xxh64":"0x8E6EB1ED79AE96CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1224415014:1":{"text":"Eh? Aren't the ships going to be ready soon?","source_cn":"哎？你们的船队不是修理得差不多了吗？","status":"matched","hash_xxh64":"0x4D8657DED5E7596F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1224415015:1":{"text":"We have yet to appoint the navigator for the advance fleet. You know, there aren't many suitable candidates in our gang.","source_cn":"先遣队的领头人选还没定。血薇帮里，能领航的人不多。","status":"matched","hash_xxh64":"0x17F48AAB1D4B1CD0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1224415016:1":{"text":"This is tough, especially when Sonja and you can't be away.","source_cn":"说的也是呢……你和索尼娅又不能亲自出海。","status":"matched","hash_xxh64":"0x3A595B5765B7578E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1224415017:1":{"text":"Away?","source_cn":"出海？","status":"matched","hash_xxh64":"0xDE407C3AFDD6280D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1224415018:1":{"text":"Bella, I'll just say it since you're here.","source_cn":"贝拉——既然你在，我就直说了。","status":"matched","hash_xxh64":"0x9687EDED039DD041","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1224415019:1":{"text":"As you have the navigation skills, I'll assign the navigator role to—","source_cn":"你懂领航。带领先遣队出航的任务，就交给——","status":"matched","hash_xxh64":"0x7A943FE4622B5761","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1224415020:1":{"text":"Not me, Lucca. Please forgive me for turning it down.","source_cn":"别交给我，二当家。请恕我拒绝。","status":"matched","hash_xxh64":"0xD4D0BFBBAEEEB6D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1224415021:1":{"text":"... Why not?","source_cn":"……为什么？<key:dialog2>","status":"matched","hash_xxh64":"0x008DE222E271B37E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1224415022:1":{"text":"Sorry, but I'm not the right person for this task. Go ahead if you want to punish me.","source_cn":"我没法完成这项任务。很抱歉，您要罚就罚吧。","status":"matched","hash_xxh64":"0x10A7D648FC48100E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1224415023:0":{"text":"She's acting weird.","source_cn":"她很奇怪。","status":"matched_runtime_gender","hash_xxh64":"0x34904FC5E74C3E88","variant_status":"runtime_gender_keys_target_same","male":"She's acting weird.","female":"She's acting weird.","variant_male_record_index":"139561","variant_female_record_index":"139562","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:31:1224415023":{"text":"She's acting weird.","source_cn":"她很奇怪。","status":"matched_runtime_gender","hash_xxh64":"0x34904FC5E74C3E88","variant_status":"runtime_gender_keys_target_same","male":"She's acting weird.","female":"She's acting weird.","variant_male_record_index":"139561","variant_female_record_index":"139562","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1224415025:1":{"text":"She isn't one to act willfully. There must be a reason.","source_cn":"她不是任性的人，一定有情况。","status":"matched_runtime_gender","hash_xxh64":"0x6254E489F26DE7CC","variant_status":"runtime_gender_keys_target_same","male":"She isn't one to act willfully. There must be a reason.","female":"She isn't one to act willfully. There must be a reason.","variant_male_record_index":"139565","variant_female_record_index":"139566","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1224415026:1":{"text":"Forget it. We still have time to decide.","source_cn":"算了，人选还不急。","status":"matched_runtime_gender","hash_xxh64":"0xA99B78A76661957B","variant_status":"runtime_gender_keys_target_same","male":"Forget it. We still have time to decide.","female":"Forget it. We still have time to decide.","variant_male_record_index":"139567","variant_female_record_index":"139568","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1224415027:1":{"text":"Let me ask her again later.","source_cn":"之后我再问问她。","status":"matched_runtime_gender","hash_xxh64":"0x3A29489114B8B33F","variant_status":"runtime_gender_keys_target_same","male":"Let me ask her again later.","female":"Let me ask her again later.","variant_male_record_index":"139569","variant_female_record_index":"139570","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:31:0:1":{"text":"She seems moody.","source_cn":"她看起来心情不太好","status":"matched_runtime_gender","hash_xxh64":"0x54B00EB65277A388","variant_status":"runtime_gender_keys_target_same","male":"She seems moody.","female":"She seems moody.","variant_male_record_index":"67406","variant_female_record_index":"67407","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:31:1:2":{"text":"You can't force her.","source_cn":"强扭的瓜不甜","status":"matched_runtime_gender","hash_xxh64":"0x8443F7F2948FD08C","variant_status":"runtime_gender_keys_target_same","male":"You can't force her.","female":"You can't force her.","variant_male_record_index":"67408","variant_female_record_index":"67409","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1224415024:1":{"text":"Certainly.","source_cn":"当然。<key:dialog3>","status":"matched_runtime_gender","hash_xxh64":"0xE5F040E023BCD0B2","variant_status":"runtime_gender_keys_target_same","male":"Certainly.","female":"Certainly.","variant_male_record_index":"139563","variant_female_record_index":"139564","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:31:2:3":{"text":"You won't punish her, right?","source_cn":"血薇帮不会随便罚人吧？","status":"matched_runtime_gender","hash_xxh64":"0xAB25ED3619622616","variant_status":"runtime_gender_keys_target_same","male":"You won't punish her, right?","female":"You won't punish her, right?","variant_male_record_index":"67410","variant_female_record_index":"67411","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"Head to Holistone first.","source_cn":"先去圣石镇","status":"matched_runtime_gender","hash_xxh64":"0xEEBE72F993ED1BF2","variant_status":"runtime_gender_keys_target_same","male":"Head to Holistone first.","female":"Head to Holistone first.","variant_male_record_index":"67402","variant_female_record_index":"67403","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1224415010:1":{"text":"General Hogan is the magistrate of Holistone as well as Magister's friend.","source_cn":"霍根将军是圣石镇的治安官，也是主人的朋友。","status":"matched_runtime_gender","hash_xxh64":"0x09EF15EA9E13DF48","variant_status":"runtime_gender_keys_target_same","male":"General Hogan is the magistrate of Holistone as well as Magister's friend.","female":"General Hogan is the magistrate of Holistone as well as Magister's friend.","variant_male_record_index":"139547","variant_female_record_index":"139548","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1224415011:1":{"text":"With his help, restoring trade between Rustport and Holistone will be a breeze!","source_cn":"如果有他的帮忙，锈锚港和圣石镇的贸易肯定不成问题~","status":"matched","hash_xxh64":"0x34E568BB07255703","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"I can contact Hogan for you.","source_cn":"我可以帮你们联络霍根","status":"matched_runtime_gender","hash_xxh64":"0xD540DA20EDD6D265","variant_status":"runtime_gender_keys_target_same","male":"I can contact Hogan for you.","female":"I can contact Hogan for you.","variant_male_record_index":"67404","variant_female_record_index":"67405","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:血薇帮贝拉":{"text":"Bella","source":"血薇帮贝拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":35,"localized_text_count":34,"speaker_count":4}}