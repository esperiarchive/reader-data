{"asset_key":"ep2/quest_story_12226680","episode":"ep2","category":"quest_story","story_id":"12226680","schema_version":1,"lang":"en","texts":{"say:3:1222668001:1":{"text":"Ah!","source_cn":"啊——！","status":"matched","hash_xxh64":"0x2064C725DA07BEA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1222668002:1":{"text":"Move, and I kill her.","source_cn":"血薇帮，你们别乱动，否则我会杀了她。","status":"matched","hash_xxh64":"0xA9A66E1D89485671","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1222668003:1":{"text":"Do it. She betrayed Rustport by siding with you. You'll actually be doing us a favor.","source_cn":"动手吧，她替你做事，已经背叛了锈锚港。你愿意帮忙，我们...","status":"matched","hash_xxh64":"0x16EED9640DD95C7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1222668004:1":{"text":"What...","source_cn":"什么……","status":"matched","hash_xxh64":"0x09F7F07DED2EE939","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1222668005:1":{"text":"I'm not afraid! My life was yours anyway. Just take it now!","source_cn":"我不怕！我这条命本来就是你给的，你可以拿走！","status":"matched","hash_xxh64":"0x81FD21D90A89DD1B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222668006:1":{"text":"Fool...! You're giving them more leverage with your words!","source_cn":"笨蛋……！你的话会成为他们的把柄！","status":"matched","hash_xxh64":"0x85AE19FACC405669","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1222668006":{"text":"Fool...! You're giving them more leverage with your words!","source_cn":"笨蛋……！你的话会成为他们的把柄！","status":"matched","hash_xxh64":"0x85AE19FACC405669","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1222668007:1":{"text":"Ugh...","source_cn":"诡计多端……","status":"matched","hash_xxh64":"0x29BCFD275D24B391","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1222668009:1":{"text":"Magister, she dropped her weapons!","source_cn":"主人，她放下武器了！","status":"matched_runtime_gender","hash_xxh64":"0x375DF2816CB8E05D","variant_status":"runtime_gender_keys_target_same","male":"Magister, she dropped her weapons!","female":"Magister, she dropped her weapons!","variant_male_record_index":"137928","variant_female_record_index":"137929","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1222668010:1":{"text":"Heh, we finally caught you! You really gave Lucca a hard time, he was so hurt.","source_cn":"哼哼……总算抓到你了，当时你对卢卡下手那么重——","status":"matched","hash_xxh64":"0x9D58BBE9D20015EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1222668011:1":{"text":"I can hit a tiny hamster like you even harder.","source_cn":"我对仓鼠下手更重。","status":"matched","hash_xxh64":"0x92FF83883C7ADE3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1222668012:1":{"text":"Eek! What a terrifying aura! Someone protect Chippy!","source_cn":"咿——！好可怕的杀气！","status":"matched","hash_xxh64":"0xEA5A85FE1EA518A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1222668013:1":{"text":"Tie both of them up and take them back to Rustport. Sonja will handle the interrogation... personally.","source_cn":"把她们两个都捆起来送回锈锚港，索尼娅会亲自审问。","status":"matched","hash_xxh64":"0xA83E425559A21D4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1222668014:1":{"text":"She's not involved in this.","source_cn":"她和这一切无关。","status":"matched","hash_xxh64":"0x62950977F4ECB94F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1222668015:1":{"text":"Release Nalianne and I won't resist.","source_cn":"你们放了纳莉安，我不会抵抗。","status":"matched","hash_xxh64":"0x04E37145A30207E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1222668016:1":{"text":"That's up to Sonja. You know we're not just targeting you because of the scars you gave me.","source_cn":"这要等索尼娅的决断。你也知道，我们追捕你，不是因为你给...","status":"matched","hash_xxh64":"0x4D7E9E88B919EA17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1222668017:1":{"text":"Let's move. Behave, and we'll treat her with respect.","source_cn":"走吧，你老实一点，我们也会对她客气些。","status":"matched","hash_xxh64":"0xE5D444E96DE6FF2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1222668018:1":{"text":"No... no!! Please don't take her! She's a good person! Let me go!","source_cn":"不……不不不！求求你们别带走她！她是好人！你们放开我！","status":"matched","hash_xxh64":"0x1264908A2A92CF1C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1222668019:1":{"text":"Silvina!","source_cn":"——西尔维娜！","status":"matched","hash_xxh64":"0x800E34185CBEBA36","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1222668020:1":{"text":"Oh, is that your name?","source_cn":"西尔维娜？那是你的名字吗？","status":"matched","hash_xxh64":"0x6212818A8F37DD65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","documen