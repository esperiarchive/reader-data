{"asset_key":"ep2/quest_story_12211130","episode":"ep2","category":"quest_story","story_id":"12211130","schema_version":1,"lang":"en","texts":{"say:3:1221113001:1":{"text":"Madam, do you know where Almer lives?","source_cn":"婆婆，请问你知道安尔姆家在哪吗？","status":"matched","hash_xxh64":"0x309B9CF53143B8CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1221113002:1":{"text":"Oh, you're looking for little Almer! Just head toward the bridge. The <style=\"highlight\">house to the north of the bridge</style> is where he stays.","source_cn":"哦，小安尔姆啊！你们沿着路往木桥的方向走，<style...","status":"matched","hash_xxh64":"0x0E0A094783113C22","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1221113003:0":{"text":"Are you his friends, or are you here to deliver a message?","source_cn":"你们是他的朋友？还是来送信的？","status":"matched","hash_xxh64":"0x2D24C10A9A2A4DB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1221113004:1":{"text":"Well, we received a letter from him. I suppose we're his friends.","source_cn":"唔……我们收到了他写的信，应该算是他的朋友吧。","status":"matched","hash_xxh64":"0x9740E097DC1693E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1221113005:1":{"text":"It's good as long as you aren't here to deliver bad news...","source_cn":"那就好，只要不是送来噩耗就好……","status":"matched","hash_