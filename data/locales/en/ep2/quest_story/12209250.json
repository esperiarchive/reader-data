{"asset_key":"ep2/quest_story_12209250","episode":"ep2","category":"quest_story","story_id":"12209250","schema_version":1,"lang":"en","texts":{"say:3:1220925001:0":{"text":"Sir! Sir! We found your money pouch!","source_cn":"大叔，大叔！你的钱袋找回来啦！","status":"matched","hash_xxh64":"0xBC0A6B0D50DCB68F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220925002:1":{"text":"What? Dura above, you're amazing!","source_cn":"什么？找到了！艾雅在上，你们可真厉害啊！","status":"matched","hash_xxh64":"0x786472906B8AD5C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1220925003:0":{"text":"Were those children truly thieves?","source_cn":"窃贼难道真的是那些小孩子？","status":"matched_runtime_gender","hash_xxh64":"0x94EC2C5634E771E2","variant_status":"runtime_gender_keys_target_same","male":"Were those children truly thieves?","female":"Were those children truly thieves?","variant_male_record_index":"135342","variant_female_record_index":"135343","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1220925003":{"text":"Were those children truly thieves?","source_cn":"窃贼难道真的是那些小孩子？","status":"matched_runtime_gender","hash_xxh64":"0x94EC2C5634E771E2","variant_status":"runtime_gender_keys_target_same","male":"Were those children truly thieves?","female":"Were those children truly thieves?","variant_male_record_index":"135342","variant_female_record_index":"135343","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220925004:0":{"text":"I see... Dura, please forgive those little ones...","source_cn":"原来是这样……艾雅啊，原谅那些孩子们吧……","status":"matched_runtime_gender","hash_xxh64":"0x135A5623C6787E74","variant_status":"runtime_gender_keys_target_same","male":"I see... Dura, please forgive those little ones...","female":"I see... Dura, please forgive those little ones...","variant_male_record_index":"135344","variant_female_record_index":"135345","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1220925005:0":{"text":"Sir, I-I'm sorry... We really didn't know what else to do...","source_cn":"大叔，对、对不起……咱当时实在是不知道该怎么办了。","status":"matched","hash_xxh64":"0x851BDF81B4965944","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1220925006:0":{"text":"We promise to make back the spent money and return it to you.","source_cn":"花掉的钱，咱一定能赚回来还给你。","status":"matched","hash_xxh64":"0xD4200DA1BF82FA41","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1220925007:1":{"text":"No, child. There's no need to repay me.","source_cn":"不，孩子。这些钱不用再还给我了。","status":"matched","hash_xxh64":"0x5D36F484DB2B1B60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1220925008:0":{"text":"Young one, listen. I love to travel, but now that I'm blind, it's very difficult for me.","source_cn":"孩子，听我说。我喜欢到处旅行，但我现在看不见了，做什么...","status":"matched","hash_xxh64":"0xEF347AA49A039E3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1220925009:0":{"text":"If you're willing, I'd like to hire you to guide me around Rustport, and that money shall be your payment. So, how about it?","source_cn":"如果你愿意的话，我想雇你带我游览锈锚港。那些钱就是我付...","status":"matched","hash_xxh64":"0xFF0511932B2BE901","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1220925010:0":{"text":"But, sir... you...","source_cn":"可是，大叔……您……","status":"matched","hash_xxh64":"0x164B39E8C566B074","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1220925010":{"text":"But, sir... you...","source_cn":"可是，大叔……您……","status":"matched","hash_xxh64":"0x164B39E8C566B074","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1220925011:0":{"text":"Alright, sir, thank you for your kindness. And thank you all for helping us...","source_cn":"好吧，大叔，谢谢你的善意，也谢谢你们的帮助……","status":"matched","hash_xxh64":"0x39A4548C7798B29D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1220925012:0":{"text":"Leave the Rustport tour to us! All the others will help out!","source_cn":"游览锈锚港的事，大叔就放心交给咱安排吧！咱所有的兄弟姐...","status":"matched","hash_xxh64":"0x505426AB20D6F480","variant_status":"","male":"","female":"