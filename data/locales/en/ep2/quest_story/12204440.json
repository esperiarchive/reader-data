{"asset_key":"ep2/quest_story_12204440","episode":"ep2","category":"quest_story","story_id":"12204440","schema_version":1,"lang":"en","texts":{"say:3:1220444001:0":{"text":"You little punk, how dare you deceive us? You've got some nerve!","source_cn":"臭小子，敢骗我们，胆子真不小啊！","status":"matched","hash_xxh64":"0x0E72465C03CEE4EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1220444002:0":{"text":"I... I never agreed to anything with you!","source_cn":"我……我根本就没答应过你们！","status":"matched","hash_xxh64":"0xB43224C51E3417DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1220444003:0":{"text":"You have the guts to offend the boss? In Rustport, anyone who messes with him gets fed to the sharks!","source_cn":"你敢得罪大老板？在锈锚港，惹了大老板的人，都得被丢进海...","status":"matched","hash_xxh64":"0xE459E9303874457A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1220444004:0":{"text":"I had no idea the sharks in Rustport were so well-fed.","source_cn":"我还真不知道，锈锚港的鲨鱼伙食这么好啊。","status":"matched","hash_xxh64":"0xD2C883AC9A55CFA5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1220444005:0":{"text":"Lucca? What are you doing here?! This has nothing to do with the Whispers!","source_cn":"卢卡？你……你、你想干什么！这事可跟血薇帮没关系！","status":"matched","hash_xxh64":"0x44F2F093AD40459F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1220444006:0":{"text":"If I cross you, will I also be tossed into the sea to feed the fishes?","source_cn":"我要是得罪了你，是不是也要被扔到海里当鱼食？","status":"matched","hash_xxh64":"0xE9FC5E54D2603A29","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1220444007:0":{"text":"What do you think you're doing, getting involved in the underground fight scene? We have rules...","source_cn":"你……你什么意思，想插手黑拳市场？咱们也是要讲规矩的……","status":"matched","hash_xxh64":"0x32BFA709E18005A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1220444008:0":{"text":"In Rustport, we, the Carmine Whispers, set the rules!","source_cn":"在锈锚港，我们血薇帮才是规矩！","status":"matched","hash_xxh64":"0x70BB62F49459B188","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1220444009:0":{"text":"You! What are you doing—","source_cn":"你！你干什么——","status":"matched","hash_xxh64":"0x9580A7636B957D01","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:黑拳庄家“大老板”":{"text":"Ringleader","source":"黑拳庄家“大老板”","status":"matched_dialogue_flow"},"speaker:地下拳手斯坦顿":{"text":