{"asset_key":"ep2/quest_story_12110933","episode":"ep2","category":"quest_story","story_id":"12110933","schema_version":1,"lang":"en","texts":{"say:3:1211093301:1":{"text":"Oh, it's you again. Tell me where you're going. The Heroic Order has already paid for passage.","source_cn":"又是你们。不管要去哪里，骑士团都已经付过钱了。","status":"matched","hash_xxh64":"0x4B751B5FAE3F4815","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211093302:1":{"text":"We're going to Cedartown in the Duchy of Whiteridge.","source_cn":"我们要去白山公国的雪松镇！","status":"matched","hash_xxh64":"0x725DE2EC9606C2EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1211093303:1":{"text":"General Hogan said we would pass through the Stormy Strait.","source_cn":"霍根将军说，会途经斯托密海峡。","status":"matched","hash_xxh64":"0x57C7AC5B0E63A804","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211093304:1":{"text":"My boat can't take you out that far, but the general has already made arrangements.","source_cn":"原来是要出海。我这艘小艇送不了你们太远。不过将军已经打...","status":"matched","hash_xxh64":"0x0C39E4B27FA87DDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1211093305:1":{"text":"I'll take you all to the frigate that's waiting for you, and then you can tell them where you want to go.","source_cn":"我会把你们安安稳稳送上三桅帆船，之后入了海，航线就靠你...","status":"matched","hash_xxh64":"0xFBABEEC9674B9BF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1211093306:1":{"text":"Alright, let's head out... and don't puke in my boat.","source_cn":"那么，坐稳了——小心晕船！","status":"matched","hash_xxh64":"0x2DE5D6D2D2F6E879","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:船夫费舍尔":{"text":"Boatman Fischer","source":"船夫费舍尔","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":3}}