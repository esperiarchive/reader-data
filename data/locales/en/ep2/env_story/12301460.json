{"asset_key":"ep2/env_story_12301460","episode":"ep2","category":"env_story","story_id":"12301460","schema_version":1,"lang":"en","texts":{"say:1:1230146001:1":{"text":"Indeed. My vacation is over, and I'm about to return to the deck.","source_cn":"是的，我的假期结束了，水手即将返回到甲板上。","status":"matched","hash_xxh64":"0xF2FE418DDF790376","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230146002:1":{"text":"When my ship departs, Rustport will eventually fade out of my sight...","source_cn":"随着航船启程，锈锚港将会离我越来越远……","status":"matched","hash_xxh64":"0x0CD66C813E20A284","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230146003:1":{"text":"Farewell, my fishing rod and straw hat.","source_cn":"别了，我的鱼竿，我的草帽。","status":"matched","hash_xxh64":"0x9C6C9A56630AB5BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230146004:1":{"text":"Why do I feel so gloomy on such a sunny day?","source_cn":"明明是阳光灿烂的日子，为什么我却感觉到满眼灰暗。","status":"matched","hash_xxh64":"0x1DD77C9329E3CCD6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:镇民奥特":{"text":"Otto","source":"镇民奥特","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}