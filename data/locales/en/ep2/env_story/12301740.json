{"asset_key":"ep2/env_story_12301740","episode":"ep2","category":"env_story","story_id":"12301740","schema_version":1,"lang":"en","texts":{"say:1:1230174001:1":{"text":"Y—You must have heard wrong!","source_cn":"你……你一定是听错了！","status":"matched","hash_xxh64":"0x9DF2A6C6D43C251F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230174002:1":{"text":"The Water Wights are a bunch of smelly and narrow-minded roughnecks—that's what my family says, and I agree!","source_cn":"粗野、一身海腥味、目光短浅——家都这么说水鬼帮。我也是...","status":"matched","hash_xxh64":"0x53BF26F82C75BF4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230174003:1":{"text":"So, please don't get the wrong idea! I have nothing to do with the Water Wights!","source_cn":"所以，你可千万不能乱说！我和水鬼帮一条鱼的关系都没有！","status":"matched","hash_xxh64":"0xC9793E839E351360","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230174004:1":{"text":"If the Carmine Whispers heard our conversation, I could lose my job!","source_cn":"要是被血薇帮听到，我连现在的工作都会丢了！","status":"matched","hash_xxh64":"0x1EB558E888ECE8E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:码头工人奇卡瓦":{"text":"Worker Chancy","source":"码头工人奇卡瓦","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_c