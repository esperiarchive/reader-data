{"asset_key":"ep2/env_story_12301840","episode":"ep2","category":"env_story","story_id":"12301840","schema_version":1,"lang":"en","texts":{"say:3:1230184001:1":{"text":"No, I'm no match for my father when it comes to fishing. I'm well-paid for this voyage, so I have enough to cover my family expenses!","source_cn":"不，我的捕鱼技术可比不过我的父亲。但是这趟航行，我带回...","status":"matched","hash_xxh64":"0x95C9440FC52234CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230184002:1":{"text":"Haha, there's no need to be overly modest, son.","source_cn":"哈哈哈，孩子，过分谦虚可不是什么好事。","status":"matched","hash_xxh64":"0x7070068EF51B6027","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1230184003:1":{"text":"Can't you tell Picard says that on purpose?","source_cn":"哎呀，你难道没听出来孩子是故意这么说的！","status":"matched","hash_xxh64":"0x2B755A75C3EEBCFD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1230184004:1":{"text":"I can now. I'm so happy that we've raised a good son!","source_cn":"听出来了，那我也开心！咱们有一个好儿子！","status":"matched","hash_xxh64":"0xA7A8BED34F1BE718","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:水手普卡德":{"text":"Sailor Picard","source":"水手普卡德","status":"matched_dialogue_flow"},"speaker:老头卡欧":{"text":"Callum","source":"老头卡欧","status":"matched_dialogue_f