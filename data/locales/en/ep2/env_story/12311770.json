{"asset_key":"ep2/env_story_12311770","episode":"ep2","category":"env_story","story_id":"12311770","schema_version":1,"lang":"en","texts":{"say:2:1231177001:1":{"text":"I'm more of a believer in the god of the waves when it comes to catching fish.","source_cn":"在出航和鱼获上，我更信风浪与漂泊之神。","status":"matched","hash_xxh64":"0x585223A8096B8EBC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1231177002:1":{"text":"The tribute is ready, and the first living thing I catch each day will be used to honor the great Tritonus!","source_cn":"贡品已经准备好了，每天钓上的第一只活物，我会心怀感激地...","status":"matched","hash_xxh64":"0xFC0D47F71590B4C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1231177003:1":{"text":"Despite our different beliefs, Lincon and I have the same goal.","source_cn":"虽然信仰不同，但我和林科夫目标一致。","status":"matched","hash_xxh64":"0x3F39A0E772A3F4E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1231177004:1":{"text":"Work hard, live well!","source_cn":"——好好工作，好好生活！","status":"matched","hash_xxh64":"0xFD18CA2DF5121EA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:渔夫林科夫":{"text":"Fisherman Lincon","source":"渔夫林科夫","status":"matched_dialogue_flow"},"speaker:渔夫克林顿":{"text":"Fisherman Clint","source":"渔夫克林顿","status":"matched_dialogue_flow