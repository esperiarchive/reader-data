{"asset_key":"ep2/env_story_12311120","episode":"ep2","category":"env_story","story_id":"12311120","schema_version":1,"lang":"en","texts":{"say:1:1231112001:1":{"text":"You mean Gordy? He left Rustport.","source_cn":"你是说葛塔吗？他离开锈锚港了。","status":"matched","hash_xxh64":"0xA2C219275CFB5519","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1231112002:1":{"text":"As soon as the blockade was lifted, he grabbed his gear and hopped on a ship.","source_cn":"港口解开封锁不久后，他就背着行李上了船。","status":"matched","hash_xxh64":"0x68360D105921CD01","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1231112003:1":{"text":"He mentioned this fishing spot before he left, and I've had nothing but good luck here.","source_cn":"这个钓点就是他在离开前告诉我的，我每次都收获满满。","status":"matched","hash_xxh64":"0x70E72AACF892A09B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1231112004:1":{"text":"May his journey be smooth, and the sea treat him kindly.","source_cn":"希望他的旅途一路顺风，永不倾覆。","status":"matched","hash_xxh64":"0x1527E9F526331F92","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:渔夫奇科夫":{"text":"Fisherman Chikol","source":"渔夫奇科夫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}