{"asset_key":"ep2/env_story_12311070","episode":"ep2","category":"env_story","story_id":"12311070","schema_version":1,"lang":"en","texts":{"say:3:1231107001:1":{"text":"Scented Tea, furs, fresh wheat... all premium goods, I assure you.","source_cn":"花茶、皮毛、小麦……放心吧，我带来的都是上等货。","status":"matched","hash_xxh64":"0x68D9E05EBFE3171E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1231107002:1":{"text":"I'll take ten bags of Scented Tea, and make it snappy!","source_cn":"花茶，快给我装十包！","status":"matched","hash_xxh64":"0x1D9D0C653E43469A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1231107003:1":{"text":"Ten bags? Coin burning a hole in your purse, Phoebe?","source_cn":"十包？看来帕加尼你的钱包很充沛。","status":"matched","hash_xxh64":"0xBCB95DB37D063560","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1231107004:1":{"text":"Well, with the blockade lifted, I don't have to live like such a penny-pincher anymore.","source_cn":"彼此彼此，港口重开后有了工作，我至少不用再紧巴巴的过日子了。","status":"matched","hash_xxh64":"0xE4E8EE30653310A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:商人梅妮吉":{"text":"Merchant Maggie","source":"商人梅妮吉","status":"matched_dialogue_flow"},"speaker:居民帕加尼":{"text":"Villager Phoebe","source":"居民帕加尼","status":"matched_dialogue_flow"},"speake