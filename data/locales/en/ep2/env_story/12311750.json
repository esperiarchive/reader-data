{"asset_key":"ep2/env_story_12311750","episode":"ep2","category":"env_story","story_id":"12311750","schema_version":1,"lang":"en","texts":{"say:1:1231175001:1":{"text":"Dura will surely hear our voices!","source_cn":"艾雅一定会听到我们的声音！","status":"matched","hash_xxh64":"0x9C1C39EFC4C28FE0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1231175002:1":{"text":"But while we wait, we need to be prepared.","source_cn":"所以在等待的这段时间内，我们需要做好准备。","status":"matched","hash_xxh64":"0x129A2B38298ED411","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1231175003:1":{"text":"We'll sew nets and mend fishing gear. Who knows, the fog could lift tomorrow, or maybe in a few days.","source_cn":"缝补渔网，修补渔具。或许明天，或许几天后。","status":"matched","hash_xxh64":"0x79E9DA4D14BBDF5F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1231175004:1":{"text":"We'll set sail as soon as it's all clear again.","source_cn":"当大雾散去，我们终将再次启航。","status":"matched","hash_xxh64":"0xCE4AE062FEBA1720","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:渔夫克林顿":{"text":"Fisherman Clint","source":"渔夫克林顿","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}