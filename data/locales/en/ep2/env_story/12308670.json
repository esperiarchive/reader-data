{"asset_key":"ep2/env_story_12308670","episode":"ep2","category":"env_story","story_id":"12308670","schema_version":1,"lang":"en","texts":{"say:2:1230867001:1":{"text":"But it's so dark and mysterious, so a secret passage works too!","source_cn":"可是它也很黑很暗，所以叫暗道也没问题！","status":"matched","hash_xxh64":"0xD22C822EF2ADF665","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230867002:1":{"text":"At the end of this black tunnel, there's bound to be a secret that no one has found yet! We'll have an exciting adventure!","source_cn":"在这条暗道的终点，一定隐藏着没人发现的秘密！我们可以进...","status":"matched","hash_xxh64":"0xB64AF9505A25BA5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230867003:1":{"text":"But it's so dark down there... I'm scared...","source_cn":"可是下面看起来好黑，我害怕……","status":"matched","hash_xxh64":"0x19D3F148BCB83861","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1230867004:1":{"text":"Find your courage! Only the brave can be heroes of Rustport!","source_cn":"拿出你的勇气，只有勇敢者才能成为锈锚港的英雄！","status":"matched","hash_xxh64":"0xCF7ADA383EC9A632","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:小男孩莱昂":{"text":"Little Leon","source":"小男孩莱昂","status":"matched_dialogue_flow"},"speaker:小女孩卡乐佛":{"text":"Little Carissa","source":"小女孩卡乐佛","status