{"asset_key":"ep2/env_story_12308300","episode":"ep2","category":"env_story","story_id":"12308300","schema_version":1,"lang":"en","texts":{"say:1:1230830001:1":{"text":"Leaving? Absolutely, and I must say I cannot wait.","source_cn":"离开？是的，我已经迫不及待。","status":"matched","hash_xxh64":"0x3F50971E4DAD641A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230830002:1":{"text":"I'll set off as soon as my cargo makes it onto the ship.","source_cn":"只要我的货物装上船，我立刻就要离开这里。","status":"matched","hash_xxh64":"0x2E59B236D08BB71A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230830003:1":{"text":"I can't believe how long I've been stranded here.","source_cn":"真不敢相信，我竟然被困在这里这么久了。","status":"matched","hash_xxh64":"0xDFB9340BC55B11DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230830004:1":{"text":"I hope these goods can help make up for some of my losses.","source_cn":"希望这些货物能为我挽回一些损失。","status":"matched","hash_xxh64":"0x0FA7B8C18618D220","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:商人科博":{"text":"Trader Colin","source":"商人科博","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}