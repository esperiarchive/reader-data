{"asset_key":"ep2/env_story_12301170","episode":"ep2","category":"env_story","story_id":"12301170","schema_version":1,"lang":"en","texts":{"say:1:1230117001:1":{"text":"It's actually a good job for me.","source_cn":"修船很好，对于我来说确实是份好工作。","status":"matched","hash_xxh64":"0x114296C7866553F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230117002:1":{"text":"It's been my livelihood for over two decades, and I'm already used to working at the dock.","source_cn":"我干这行已经二十多年了，我已经习惯这份守着锈锚港船坞的工作。","status":"matched","hash_xxh64":"0xDF88FA0E0CF426A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230117003:1":{"text":"Nevertheless, if I can't earn enough to support my family...","source_cn":"可是如果这份工作的酬劳无法为我的家人支付牛奶和面包……","status":"matched","hash_xxh64":"0x8539B76292F76EDF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230117004:1":{"text":"Maybe it's time for a change.","source_cn":"我想，是时候考虑改变了。","status":"matched","hash_xxh64":"0x88AC340901964ABF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:工匠埃隆阿":{"text":"Craftsman Elijah","source":"工匠埃隆阿","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}