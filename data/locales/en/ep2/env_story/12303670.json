{"asset_key":"ep2/env_story_12303670","episode":"ep2","category":"env_story","story_id":"12303670","schema_version":1,"lang":"en","texts":{"say:1:1230367001:1":{"text":"Yeah, ever since Rustport was blockaded, business has been tough...","source_cn":"是啊，锈锚港被封锁后，大家的买卖都不好做……","status":"matched","hash_xxh64":"0x2C9FD7BDD5431FC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230367002:1":{"text":"I set up my stall every day, but it's not just for making money.","source_cn":"但人家每天出摊，其实不是为了做买卖啦。","status":"matched","hash_xxh64":"0xB1F6994E621CE975","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230367003:1":{"text":"I'm just waiting for somebody.","source_cn":"人家是在等一个人。","status":"matched","hash_xxh64":"0x0D08AB72CCE1BAC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230367004:1":{"text":"She comes regularly for Bloodrose flowers, so maybe I'll catch her if I stay here.","source_cn":"她每天有采血薇花的习惯，只要在这里守着，也许就能见到她。","status":"matched","hash_xxh64":"0xCAE532D08B3D795B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卖花女格妮":{"text":"Flower Girl Jen","source":"卖花女格妮","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}