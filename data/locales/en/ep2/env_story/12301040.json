{"asset_key":"ep2/env_story_12301040","episode":"ep2","category":"env_story","story_id":"12301040","schema_version":1,"lang":"en","texts":{"say:1:1230104001:1":{"text":"Don't get too excited, youngster.","source_cn":"嘿，年轻人，不要激动。","status":"matched","hash_xxh64":"0x5DCC687A7798B5EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230104002:1":{"text":"The treasure mentioned in the lyrics is just a legend. It's a common folk song everyone in Rustport is familiar with.","source_cn":"《神之瀑》提到神明宝藏只是传说，这只是一首锈锚港人人都...","status":"matched","hash_xxh64":"0x840D44FA9F68F589","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230104003:1":{"text":"Look at the thick fog over the sea.","source_cn":"看看这片大海上浓厚不散的大雾。","status":"matched","hash_xxh64":"0x467D09F809DED5B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230104004:1":{"text":"Who'd be crazy enough to set sail in such weather?","source_cn":"哪个不要命的敢在这样的天气里出航？","status":"matched","hash_xxh64":"0xF33838CB20FDE38E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:老渔夫罗塞尔":{"text":"Fisherman Russel","source":"老渔夫罗塞尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}