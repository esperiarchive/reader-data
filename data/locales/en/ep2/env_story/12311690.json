{"asset_key":"ep2/env_story_12311690","episode":"ep2","category":"env_story","story_id":"12311690","schema_version":1,"lang":"en","texts":{"say:1:1231169001:1":{"text":"That's right, it's unbelievable.","source_cn":"对吧，简直难以置信。","status":"matched","hash_xxh64":"0x5FAFF390A92D3BEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1231169002:1":{"text":"We had planned to find an artist to capture the beautiful sunset on the roof.","source_cn":"我们本打算找一位画师记录下夕阳照在屋顶上的美丽时刻。","status":"matched","hash_xxh64":"0x81C096E06B47B79B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1231169003:1":{"text":"But we searched for hours without any luck.","source_cn":"可没想到我们找了一圈，也没有找到一家画像馆。","status":"matched","hash_xxh64":"0x67217E552094826A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1231169004:1":{"text":"The people in this city are all so busy making money that they haven't realized how beautiful it is.","source_cn":"这座城里的人都忙着赚钱，可完全没有去注意到这座港口城市...","status":"matched","hash_xxh64":"0x3AA7F576EA10991A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:旅客沙罗丽":{"text":"Traveler Shae","source":"旅客沙罗丽","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}