{"asset_key":"ep2/env_story_12301810","episode":"ep2","category":"env_story","story_id":"12301810","schema_version":1,"lang":"en","texts":{"say:2:1230181001:1":{"text":"We're fishing.","source_cn":"我们正在捕鱼。","status":"matched","hash_xxh64":"0x95261755BEE9B313","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230181002:1":{"text":"Our son's out at sea, and it's just two of us at home. And now, the Carmine Whispers are raiding every house for Water Wights...","source_cn":"儿子出海在外，家里就剩我们两个，结果还赶上血薇帮四处查人……","status":"matched","hash_xxh64":"0xA3D0799B5349FF69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230181003:1":{"text":"Callum, it's up to you whether we have something to eat tonight!","source_cn":"卡欧，今晚我们两个人能不能吃上晚餐，就全靠你了！","status":"matched","hash_xxh64":"0x6F668CE296E64D3B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1230181004:1":{"text":"Got it, Beverly. No need to keep reminding me. I'm just trying to distract myself from my back pain with old memories.","source_cn":"我知道，巴福莉。不要催我，我只是借着回忆舒缓一下快要散...","status":"matched","hash_xxh64":"0xFA645CF65D922A6E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:老头卡欧":{"text":"Callum","source":"老头卡欧","status":"matched_dialogue_flow"},"speaker:老妇巴福莉":{"text":"Lady Beverly","source":"老妇巴福莉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}