{"asset_key":"ep2/env_story_12301730","episode":"ep2","category":"env_story","story_id":"12301730","schema_version":1,"lang":"en","texts":{"say:1:1230173001:1":{"text":"N—Nothing! I didn't say anything!","source_cn":"没、没什么，你什么也没听见！","status":"matched","hash_xxh64":"0x30F2C07E2046E280","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230173002:1":{"text":"I used to have many colleagues here, but I'm the only one left since the dock was closed.","source_cn":"我曾经有很多工友，但港口一封，如今这里只剩我一个人。","status":"matched","hash_xxh64":"0x40FBE132AC068C68","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230173003:1":{"text":"Everyone's found a way out. Maybe I should just join a gang like they did...","source_cn":"大家都各有出路。我要是和他们混，去投靠几个靠谱的帮派也...","status":"matched","hash_xxh64":"0xF141CDE795435566","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230173004:1":{"text":"But I know myself well—I'd more likely stay on the fence than take action.","source_cn":"但我也知道，按照我的性子，我很可能会继续考虑下去。","status":"matched","hash_xxh64":"0x22A204E327951E4A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:码头工人奇卡瓦":{"text":"Worker Chancy","source":"码头工人奇卡瓦","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}