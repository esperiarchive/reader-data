{"asset_key":"ep2/env_story_12301350","episode":"ep2","category":"env_story","story_id":"12301350","schema_version":1,"lang":"en","texts":{"say:1:1230135001:1":{"text":"The occupancy now is far from my goal.","source_cn":"离我心目中预想的客人数量，还差很多。","status":"matched","hash_xxh64":"0x4CA1E2DA965FCD99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230135002:1":{"text":"I need to at least catch up with the occupancy of Bols' inn.","source_cn":"我每天接待的客人，起码要追平波尔斯旅店的客人才可以。","status":"matched","hash_xxh64":"0x1676AD19BF316A69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230135003:1":{"text":"His inn has a better location than mine.","source_cn":"虽然他的旅店位于城里，位置比我的旅店好。","status":"matched","hash_xxh64":"0xD5DF6DD6BACE45A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230135004:1":{"text":"But if he gets too far ahead, I might never catch up!","source_cn":"可一旦被他甩开太多，那我将再也追不上他！","status":"matched","hash_xxh64":"0xA8F76408F83DB0C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:旅店老板艾瑞特":{"text":"Innkeeper Emmet","source":"旅店老板艾瑞特","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}