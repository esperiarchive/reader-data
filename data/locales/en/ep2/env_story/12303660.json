{"asset_key":"ep2/env_story_12303660","episode":"ep2","category":"env_story","story_id":"12303660","schema_version":1,"lang":"en","texts":{"say:1:1230366001:1":{"text":"I price them based on how I feel.","source_cn":"看眼缘卖。","status":"matched","hash_xxh64":"0x2438D9668626660D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230366002:1":{"text":"If you're like Sonja… I could give them to you for free.","source_cn":"如果你是像索尼娅那样的人……送你也行呀。","status":"matched","hash_xxh64":"0xA51FF5CB79008E13","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230366003:1":{"text":"Why are you staring? Is it strange that I look up to Sonja?","source_cn":"咦，怎么这样看着人家？人家崇拜索尼娅，是很奇怪的事吗？","status":"matched","hash_xxh64":"0xF48BEDBD8797020F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230366004:1":{"text":"Sonja is the coolest person in the world!","source_cn":"索尼娅可是这个世界上最帅气的人！","status":"matched","hash_xxh64":"0xA903C95808FA178A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1230366005:1":{"text":"If you had met her, you'd understand.","source_cn":"如果你见过她，就会理解人家的。","status":"matched","hash_xxh64":"0x87B367425B019099","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_