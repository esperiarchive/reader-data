{"asset_key":"ep2/env_story_12301190","episode":"ep2","category":"env_story","story_id":"12301190","schema_version":1,"lang":"en","texts":{"say:2:1230119001:1":{"text":"The demand for my service has picked up since the fog cleared.","source_cn":"自从迷雾消散之后，修船的人就多了起来。","status":"matched","hash_xxh64":"0x9049ED728DA3D7E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230119002:1":{"text":"Even though I've been telling them there's no rush, they just insist on lining up here.","source_cn":"尽管我全力劝解他们修船不急于一时，可修船的人还是排起长队。","status":"matched","hash_xxh64":"0x0233C195B35F70C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230119003:1":{"text":"No rush? Don't you know how tough things have been for us fishermen in the past six months?","source_cn":"不急于一时？你是不知道这半年我们这些渔夫的处境有多难？","status":"matched","hash_xxh64":"0x74313506DAAF9221","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1230119004:1":{"text":"How could I not know? That doesn't mean you can cut the queue!","source_cn":"我怎么不知道？可就算再难你也要给我排队！","status":"matched","hash_xxh64":"0x3C1F1E9004BAEBBC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:工匠埃隆阿":{"text":"Craftsman Elijah","source":"工匠埃隆阿","status":"matched_dialogue_flow"},"speaker:渔夫塔富林":{"text":"Fisherman Torbin","source":"渔夫塔富林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}