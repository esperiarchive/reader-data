{"asset_key":"ep2/env_story_12301450","episode":"ep2","category":"env_story","story_id":"12301450","schema_version":1,"lang":"en","texts":{"say:1:1230145001:1":{"text":"Yes. With the sea routes reopening after the fog has cleared, I've been called up to set sail.","source_cn":"是的，迷雾散去，海上航路恢复，我也接到了出海的消息。","status":"matched","hash_xxh64":"0x898EA710B18D9499","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230145002:1":{"text":"And I heard that this upcoming voyage will last at least six months...","source_cn":"而且这次出海据说至少要在海上航行半年……","status":"matched","hash_xxh64":"0xBD0835B3FBD2CC5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230145003:1":{"text":"Time really flies when one is on vacation.","source_cn":"休假的时光，怎么能过得这么快？","status":"matched","hash_xxh64":"0x14006F6D244FB77C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:镇民奥特":{"text":"Otto","source":"镇民奥特","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}