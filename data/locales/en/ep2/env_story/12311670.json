{"asset_key":"ep2/env_story_12311670","episode":"ep2","category":"env_story","story_id":"12311670","schema_version":1,"lang":"en","texts":{"say:1:1231167001:1":{"text":"That's right, they took him!","source_cn":"是的，他们抓了我的孩子！","status":"matched","hash_xxh64":"0x230332FD5B866D7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1231167002:1":{"text":"They stormed into my house and stole him away.","source_cn":"他们粗鲁的冲进家中，将我的孩子抓走。","status":"matched","hash_xxh64":"0x00C98FB501B2FD06","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1231167003:1":{"text":"My children were so scared they all just went silent.","source_cn":"我的孩子当时都被吓傻了，一句话都没有说。","status":"matched","hash_xxh64":"0xC2662EC3729DC94C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1231167004:1":{"text":"Hopefully this gets cleared up soon, but I'll be waiting out here every day until it does!","source_cn":"希望能尽早日解开误会，我会在外面等着，直到他出来！","status":"matched","hash_xxh64":"0xBB96A5F52194470F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:居民柯莉娅":{"text":"Villager Cora","source":"居民柯莉娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}