{"asset_key":"ep2/env_story_12301320","episode":"ep2","category":"env_story","story_id":"12301320","schema_version":1,"lang":"en","texts":{"say:1:1230132001:1":{"text":"What? From the sea? Are you talking about... yourselves?","source_cn":"什么？来自海上的客人？你是说——你们？","status":"matched","hash_xxh64":"0x5CD2FF1792B05FBF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230132002:1":{"text":"All new faces indeed...","source_cn":"确实是没见过的新面孔……","status":"matched","hash_xxh64":"0xEAA01E77F1CA4E91","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230132003:1":{"text":"If you drifted here after your ship was wrecked by the sea monster, you must be penniless now.","source_cn":"你们要是被海怪掀翻了漂流过来的，那身上应该一个铜币都没有吧。","status":"matched","hash_xxh64":"0x51B86676A7AA7B0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230132004:1":{"text":"I am too! I might own this place, but I'm broke, haha!","source_cn":"同病相怜！别看我是开店的，我兜里也没钱，哈哈！","status":"matched","hash_xxh64":"0x05A9D7D3B8FD8163","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:旅店老板艾瑞特":{"text":"Innkeeper Emmet","source":"旅店老板艾瑞特","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}