{"asset_key":"ep2/env_story_12301703","episode":"ep2","category":"env_story","story_id":"12301703","schema_version":1,"lang":"en","texts":{"say:2:1230170301:1":{"text":"Some friends of mine who went out to sea have yet to return.","source_cn":"我的几个朋友出海，至今都没能归来。","status":"matched","hash_xxh64":"0x5DD1004B131CE08F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230170302:1":{"text":"Captain, I already said we should set out to look for them!","source_cn":"船长，我早说过我们应该出海去找他们！","status":"matched","hash_xxh64":"0xC5F2134F733E072A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1230170303:1":{"text":"That's not an option. As the captain, I must ensure your safety.","source_cn":"不行，身为船长，我要为你们的安全负责。","status":"matched","hash_xxh64":"0x73362582F4CD0974","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1230170304:1":{"text":"I can't put you all in danger just to achieve what I want like those gangsters!","source_cn":"我做不到，也不能像城里那些帮派一样，为了达成目的，罔顾...","status":"matched","hash_xxh64":"0xADD924BD4AF0983E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:船长布莱杰":{"text":"Captain Bridger","source":"船长布莱杰","status":"matched_dialogue_flow"},"speaker:水手欧米拉":{"text":"Sailor Omiro","source":"水手欧米拉","status":"matched_dialogue_flow"}},"s