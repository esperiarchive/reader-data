{"asset_key":"ep2/env_story_12308100","episode":"ep2","category":"env_story","story_id":"12308100","schema_version":1,"lang":"en","texts":{"say:1:1230810001:1":{"text":"Fog, sea monsters... there's nothing out there that can scare me!","source_cn":"迷雾也好，其中的海怪也好，我一点都不害怕！","status":"matched","hash_xxh64":"0x77FCC8C6D7068533","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1230810002:1":{"text":"As a helmsman, all fear evaporates as soon as I take the wheel.","source_cn":"身为掌舵手，从握住舵盘的那一刻起，我就会无所畏惧。","status":"matched","hash_xxh64":"0xF96E0F98AEDA5592","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1230810003:1":{"text":"Without confidence like this, how else can one become the best sailor?!","source_cn":"没有这种自信，怎么能成为最出色的水手呢！","status":"matched","hash_xxh64":"0xE4EE721F4F6D1012","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:水手塞德":{"text":"Sailor Cedric","source":"水手塞德","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}