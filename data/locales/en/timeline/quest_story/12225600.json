{"asset_key":"timeline/quest_story_12225600","episode":"timeline","category":"quest_story","story_id":"12225600","schema_version":1,"lang":"en","texts":{"say:3:1222560001:0":{"text":"Now it's up to me.","source_cn":"这次该到我了。","status":"matched","hash_xxh64":"0x75B6B85EFB897C6C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1222560002:0":{"text":"Stand back, everyone. I've no idea what type of crazy thing Tasi will make out of my desires. Maybe I'll even be a hero that saves the world.","source_cn":"你们小心点，都往后站。不知道塔西会用我的心愿做出多惊险...","status":"matched","hash_xxh64":"0x14902BF060155B47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1222560003:0":{"text":"Wow! Really?!","source_cn":"哇，真的吗？！","status":"matched","hash_xxh64":"0xAF9D7B2DDE17D441","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1222560004:0":{"text":"I've seen Sinbad's dreams. They're always colorful and constantly shifting, even beyond a bard's imagination.","source_cn":"哼哼，我见过辛巴达的梦哦，确实绚烂多彩变化万千，比吟游...","status":"matched","hash_xxh64":"0xE410E9011F66CC55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1222560005:0":{"text":"However, I wonder if that's truly your deepest desire.","source_cn":"不过，那真的是你心中最深层的愿望吗？","status":"matched","hash_xxh64":"0x329A36ADD2C2E495","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222560006:1":{"text":"I can't wait to see what unfolds.","source_cn":"让我们拭目以待——！","status":"matched","hash_xxh64":"0x026D14BDEFC8D15E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:12:1222561001:":{"text":"Sinbad, we prepared this for you.","source_cn":"辛巴达，这是大家给你准备的","status":"matched","hash_xxh64":"0x9D5F48DC1AE29DAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:12:1222561002:":{"text":"Don't forget us, even when you're off on an adventure.","source_cn":"就算去冒险，也别忘了我们","status":"matched","hash_xxh64":"0x3739306FF76B470F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1222560007:0":{"text":"Blanca and Lucy?! What are they doing here?","source_cn":"碧希和鲁西？！怎么会是她们？","status":"matched","hash_xxh64":"0x59E1FC6EDC912049","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1222560008:0":{"text":"Ah, they're from Brineville...","source_cn":"咦，是小水村的人……","status":"matched","hash_xxh64":"0xC0B9E08F21C22C49","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1222560009:1":{"text":"Chippy smells something! It's the delicious scent of yummy food!","source_cn":"满满闻到了，锅里飘来了食物的香味！","status":"matched","hash_xxh64":"0x4C8DFBD5E172EBFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1222560010:0":{"text":"That's the smell of wild greens and cheese... That was dinner when I was young.","source_cn":"那是野菜和芝士的味道……小时候她们常常给我用那些食材做晚饭。","status":"matched","hash_xxh64":"0xC470D6D4DF66D504","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1222560011:1":{"text":"Fresh wild greens picked from the woods outside the village, homemade fish, and cheap cheese bought from Rustport, all stewed together...","source_cn":"从村外树林里采摘回来的新鲜野菜，自家捕的鱼，还有锈锚港...","status":"matched","hash_xxh64":"0x02BB61866B3024CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:21:1222560011":{"text":"Fresh wild greens picked from the woods outside the village, homemade fish, and cheap cheese bought from Rustport, all stewed together...","source_cn":"从村外树林里采摘回来的新鲜野菜，自家捕的鱼，还有锈锚港商铺里买到的廉价芝士，全部炖在一起……","status":"matched","hash_xxh64":"0x02BB61866B3024CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1222560012:1":{"text":"Oh, it was terrible!","source_cn":"难吃得很！","status":"matched","hash_xxh64":"0x3762C6D5096B7A59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1222560014:0":{"text":"At that time, the village was too poor to buy good salt, so we made sea salt ourselves. And the mix of leafy greens and cheese... Oh man, I promise you'll never have anything so awful!","source_cn":"那时候村里没钱买精盐，都是自家晒的粗制海盐。配上菜叶子...","status":"matched","hash_xxh64":"0xA65573EC1F71CBA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1222560015:0":{"text":"Still... I miss it.","source_cn":"但是，我很怀念。","status":"matched","hash_xxh64":"0x983A5E353E02EA7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1222560016:1":{"text":"One day, I'll sail off. That day will probably come soon.","source_cn":"我迟早会扬帆远航，那一天不会太远。","status":"matched","hash_xxh64":"0xD9FC932B2C198439","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1222560017:0":{"text":"I was thinking of sharing one last terrible meal with everyone at the village, one so bad it'll make everyone cry...","source_cn":"要是能在最后和村里的大家聚在一起，吃一顿难吃到能让人哭...","status":"matched","hash_xxh64":"0x8514B7A39B8AD94F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1222560018:0":{"text":"That wouldn't be too bad, I guess.","source_cn":"我想，那还不错。","status":"matched","hash_xxh64":"0x32AB5E75118E1711","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1222560019:1":{"text":"That's Sinbad's wish. Quite unexpected, isn't it?","source_cn":"这就是辛巴达的愿望，非常出人意料，是不是？","status":"matched","hash_xxh64":"0x367F6D2192C2AC6B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1222560020:1":{"text":"Some people say one thing but mean another. It seems facing your true self isn't so easy.","source_cn":"不过有些人就是会口是心非。看来学会正视自己的内心，并不...","status":"matched","hash_xxh64":"0xB5E13EB44048FD94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1222560021:1":{"text":"Alright, the fairy dust has been scattered. Let's continue setting more traps.","source_cn":"催眠的鳞粉也洒好了。我们继续布置陷阱吧！","status":"matched","hash_xxh64":"0x7F83E462A31E1DE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:21:0:1":{"text":"Is it tasty?","source_cn":"好吃吗？","status":"matched_runtime_gender","hash_xxh64":"0x9756AD9B2AE864B6","variant_status":"runtime_gender_keys_target_same","male":"Is it tasty?","female":"Is it tasty?","variant_male_record_index":"66850","variant_female_record_index":"66851","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1222560013:1":{"text":"Ha! Yeah, it's funny to think about it now, but I ate that stuff all the time growing up!","source_cn":"哈哈哈哈，对吧！现在想想真是不可思议，我就是吃那些杂烩...","status":"matched","hash_xxh64":"0x11FD460865AE480E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:21:1:2":{"text":"What kind of dish was that?","source_cn":"救命，那是什么黑暗料理？！","status":"matched_runtime_gender","hash_xxh64":"0xF70E5DE82F854E81","variant_status":"runtime_gender_keys_target_same","male":"What kind of dish was that?","female":"What kind of dish was that?","variant_male_record_index":"66852","variant_female_record_index":"66853","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:37:12022084:0":{"text":"Tasi shows Sinbad's wish, which is to have a meal with his family in Brineville.","source_cn":"塔西把辛巴达的心愿展示在了你们面前，原来辛巴达的心愿只...","status":"matched","hash_xxh64":"0x5557A18885FDD91A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:塔西":{"text":"Tasi","source":"塔西","status":"matched_dialogue_flow"},"speaker:小水村村长碧希":{"text":"Blanca","source":"小水村村长碧希","status":"matched_dialogue_flow"},"speaker:村民鲁西":{"text":"Lucy","source":"村民鲁西","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":32,"localized_text_count":27,"speaker_count":7}}