{"asset_key":"timeline/quest_story_12105330","episode":"timeline","category":"quest_story","story_id":"12105330","schema_version":1,"lang":"en","texts":{"say:3:1210533001:1":{"text":"Slow down. You can't get past that door.","source_cn":"跑慢点，前面的门你们过不去。","status":"matched","hash_xxh64":"0x2D603A5350559339","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1210533002:1":{"text":"How do you know?","source_cn":"你怎么知道？","status":"matched","hash_xxh64":"0x399C303FFEFEBDE8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210533003:1":{"text":"Look, this door can only be opened with a special mechanism.","source_cn":"瞧，这道门是单向门，只能从一边打开。","status":"matched","hash_xxh64":"0x07FD757735139FA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210533004:1":{"text":"Do you know how to open it?","source_cn":"你会开？","status":"matched","hash_xxh64":"0x5D823720EA012A47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210533005:1":{"text":"Certainly.","source_cn":"当然。","status":"matched","hash_xxh64":"0x7CD3748C00199F0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1210533006:1":{"text":"Then open the door.","source_cn":"那就开门。","status":"matched","hash_xxh64":"0xDE1E444904EB8C8D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1210533007:0":{"text":"Yeah, well, you have to untie my rope first.","source_cn":"你们得先把我的绳子解开。","status":"matched","hash_xxh64":"0x8D60535BF3E5D4B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210533008:1":{"text":"Wait, you're not lying to us again, are you? Trying to find a way to escape...","source_cn":"等等，你不会又在骗我们，想趁机逃走吧……","status":"matched","hash_xxh64":"0x4B4A2521AE348E7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210533009:1":{"text":"Come on, guys! There are so many of you, and the great Magister Merlin is here as well. What are you afraid of?","source_cn":"你们这么多人，还有大魔法师梅林在，难道还怕我一个？","status":"matched_runtime_gender","hash_xxh64":"0xB68950FF5E1D5675","variant_status":"runtime_gender_keys_target_same","male":"Come on, guys! There are so many of you, and the great Magister Merlin is here as well. What are you afraid of?","female":"Come on, guys! There are so many of you, and the great Magister Merlin is here as well. What are you afraid of?","variant_male_record_index":"130032","variant_female_record_index":"130033","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210533010:1":{"text":"The only way you'd know how to find this door mechanism is if you were a part of the Water Wights and a traitor to the Carmine Whispers.","source_cn":"会开这道门的，除了血薇帮的叛徒，就是水鬼。","status":"matched","hash_xxh64":"0xFAA3FADD420CCB7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1210533011:1":{"text":"So which side are you on?","source_cn":"你又是哪边的？","status":"matched","hash_xxh64":"0x073E082DB96D717C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1210533012:1":{"text":"Hey, don't swing that sword around! We're friends, remember? Let me explain.","source_cn":"哎，哎！朋友，有话好好说，别拿剑吓唬人。","status":"matched","hash_xxh64":"0xC032B80C07EA2DDE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210533013:0":{"text":"A guy like me who barely makes a living can't depend on just one employer. I have to freelance. I have to hustle. Can I really turn down a job from the Water Wights?","source_cn":"我这种在码头勉强讨生活的穷人，不可能只有一个雇主。再说...","status":"matched","hash_xxh64":"0xFC327F442464223E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1210533014:1":{"text":"If you open the door and help us catch Tesio, I won't feed you to the sharks. How's that?","source_cn":"开门，帮我们抓到泰西欧，我可以不把你扔到海里喂鱼。","status":"matched","hash_xxh64":"0x2E78BAC53D18A795","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1210533015:1":{"text":"Untie me and it's a deal.","source_cn":"我只想拜托你解开绳子，放我自由。","status":"matched","hash_xxh64":"0xB029D02EB2E1B4B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1210533016:1":{"text":"What do you think, Magister Merlin?","source_cn":"……梅林，你怎么看？","status":"matched_runtime_gender","hash_xxh64":"0x04AAA21E1E034522","variant_status":"runtime_gender_keys_target_same","male":"What do you think, Magister Merlin?","female":"What do you think, Magister Merlin?","variant_male_record_index":"130040","variant_female_record_index":"130041","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:19:1210533016":{"text":"What do you think, Magister Merlin?","source_cn":"……梅林，你怎么看？","status":"matched_runtime_gender","hash_xxh64":"0x04AAA21E1E034522","variant_status":"runtime_gender_keys_target_same","male":"What do you think, Magister Merlin?","female":"What do you think, Magister Merlin?","variant_male_record_index":"130040","variant_female_record_index":"130041","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1210533019:0":{"text":"Thanks. Let me just open this door for ya.","source_cn":"呼……感谢。我这就帮你们开门……","status":"matched","hash_xxh64":"0x06E0312D3C5715F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:23:1210532001:":{"text":"I'll go first!","source_cn":"我先走一步啦！","status":"matched","hash_xxh64":"0x4BB5A04945CCBB76","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1210534001:0":{"text":"Sinbad ran away! Chippy knew we couldn't trust him!","source_cn":"辛巴达果然跑了，就知道不能相信他！","status":"matched","hash_xxh64":"0x2F01C374A37ADE2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1210534002:0":{"text":"He's not running away. He's chasing after Tesio.","source_cn":"不用追，他不是逃跑，而是去追泰西欧了。","status":"matched","hash_xxh64":"0xB1B6E31FD6F4FCEE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1210534003:0":{"text":"Why is he chasing Tesio? Does he have a grudge against him or something?","source_cn":"为什么他要追泰西欧？他们有仇还是……","status":"matched","hash_xxh64":"0x39F25791FA510EFF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1210534004:1":{"text":"Long story short: yes, he does.","source_cn":"长话短说：有。","status":"matched","hash_xxh64":"0x9A096E8BB8607EB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1210534005:1":{"text":"It's revenge for his father.","source_cn":"而且是父仇。","status":"matched","hash_xxh64":"0x106755AA3CBECA74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1210534006:1":{"text":"He's never mentioned this before.","source_cn":"哎？从没听他提起过……","status":"matched","hash_xxh64":"0x768BAC019754174C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1210534007:1":{"text":"It's rather complicated. You can ask him later. Let's not lose sight of him.","source_cn":"这事比较复杂，你们以后问他吧，我们先追，别跟丢了。","status":"matched","hash_xxh64":"0xB0611877208BC64D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:35:12010532:0":{"text":"Sinbad dashes out immediately after opening the door to the secret passage.","source_cn":"辛巴达帮你们打开密道的机关门，抢先一步追了出去。","status":"matched","hash_xxh64":"0xB26297F838F44046","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:0:1":{"text":"Untie him.","source_cn":"解开吧","status":"matched_runtime_gender","hash_xxh64":"0x0C0516BC46BC1B92","variant_status":"runtime_gender_keys_target_same","male":"Untie him.","female":"Untie him.","variant_male_record_index":"65550","variant_female_record_index":"65551","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1210533017:0":{"text":"Stop joking around. We still have to catch Tesio. You know I can help!","source_cn":"喂喂，拜托，不是还要追泰西欧吗，我真能帮上忙！","status":"matched","hash_xxh64":"0x26ED88DEACA58208","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1210533018:0":{"text":"There won't be a second chance after this.","source_cn":"我不会再给你第二次机会。","status":"matched","hash_xxh64":"0x3A074A2A310380CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:1:2":{"text":"We can tie him up again after.","source_cn":"要不，再绑一会？","status":"matched_runtime_gender","hash_xxh64":"0x40809B712CE8C522","variant_status":"runtime_gender_keys_target_same","male":"We can tie him up again after.","female":"We can tie him up again after.","variant_male_record_index":"65552","variant_female_record_index":"65553","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":36,"localized_text_count":31,"speaker_count":5}}