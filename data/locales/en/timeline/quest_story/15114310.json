{"asset_key":"timeline/quest_story_15114310","episode":"timeline","category":"quest_story","story_id":"15114310","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1511430001:":{"text":"Thanks for standing watch for me, Dunn.","source_cn":"谢谢你替我守夜，顿","status":"matched","hash_xxh64":"0x7878A7188ABEF410","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511430002:":{"text":"It was nothing...","source_cn":"只是一件小事……","status":"matched","hash_xxh64":"0xCCC0477B04CB5B76","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511430003:":{"text":"...","source_cn":"……","status":"matched_runtime_gender","hash_xxh64":"0xF6FCAFD420F69F57","variant_status":"runtime_gender_keys_target_same","male":"...","female":"...","variant_male_record_index":"270750","variant_female_record_index":"270751","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1511431001:0":{"text":"And thank you again for yesterday.","source_cn":"谢谢你昨天帮我守夜，顿。","status":"matched","hash_xxh64":"0xCDECE650FAA1C500","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1511431002:0":{"text":"As a reward... I could give you anything you want. Just name it.","source_cn":"作为回报，我可以给你一些奖励。无论你想要什么，都可以告...","status":"matched","hash_xxh64":"0xB4F36B40468C57B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1511431003:1":{"text":"T-this...","source_cn":"这、这个……","status":"matched","hash_xxh64":"0x18A03BEE25585AAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1511431004:0":{"text":"... Let's wait until the Bloodhunt Festival is over, Ames!","source_cn":"……还是等到猎血节结束后再说吧，阿米！","status":"matched","hash_xxh64":"0x68B186D8C88892AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1511431005:0":{"text":"Haha... you're adorable.","source_cn":"哈哈，你真可爱。","status":"matched","hash_xxh64":"0x857D0B60AB794C70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1511431006:0":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1511431006":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1511431007:0":{"text":"I don't know her well enough.","source_cn":"不知道。我和她不算很熟。","status":"matched_runtime_gender","hash_xxh64":"0xD1C38E9837361A9C","variant_status":"runtime_gender_keys_target_same","male":"I don't know her well enough.","female":"I don't know her well enough.","variant_male_record_index":"191197","variant_female_record_index":"191198","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1511431010:1":{"text":"Either way, if Dunn's happy, I'll be happy for him.","source_cn":"不管怎么样，如果顿的心愿能达成，我会替他高兴。","status":"matched_runtime_gender","hash_xxh64":"0x12664A055B01965C","variant_status":"runtime_gender_keys_target_same","male":"Either way, if Dunn's happy, I'll be happy for him.","female":"Either way, if Dunn's happy, I'll be happy for him.","variant_male_record_index":"191203","variant_female_record_index":"191204","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1511431011:1":{"text":"Ames never cared for him before... maybe because he took watch, she warmed up to him.","source_cn":"以前阿米不喜欢顿。也许是因为昨晚顿主动帮她守夜，讨得她...","status":"matched_runtime_gender","hash_xxh64":"0x1FC6D09E2DA547FB","variant_status":"runtime_gender_keys_target_same","male":"Ames never cared for him before... maybe because he took watch, she warmed up to him.","female":"Ames never cared for him before... maybe because he took watch, she warmed up to him.","variant_male_record_index":"191205","variant_female_record_index":"191206","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1511431011":{"text":"Ames never cared for him before... maybe because he took watch, she warmed up to him.","source_cn":"以前阿米不喜欢顿。也许是因为昨晚顿主动帮她守夜，讨得她的欢心了。","status":"matched_runtime_gender","hash_xxh64":"0x1FC6D09E2DA547FB","variant_status":"runtime_gender_keys_target_same","male":"Ames never cared for him before... maybe because he took watch, she warmed up to him.","female":"Ames never cared for him before... maybe because he took watch, she warmed up to him.","variant_male_record_index":"191205","variant_female_record_index":"191206","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1511431012:1":{"text":"We grew up together. He's my friend.","source_cn":"我们一起长大，是朋友。","status":"matched_runtime_gender","hash_xxh64":"0x8800D4EDAAB8DD3D","variant_status":"runtime_gender_keys_target_same","male":"We grew up together. He's my friend.","female":"We grew up together. He's my friend.","variant_male_record_index":"191207","variant_female_record_index":"191208","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1511431013:0":{"text":"Nazrik, stop muttering to yourself. It's time to hunt!","source_cn":"那非，别再自言自语了，该去狩猎了！","status":"matched","hash_xxh64":"0x8E809D22314E61C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1511431014:0":{"text":"Ames just counted. The festival's nearly over. We should split up to <style=\"highlight\">hunt faster</style>.","source_cn":"阿米刚才算了一下，猎血节差不多要结束了。不如我们<st...","status":"matched","hash_xxh64":"0x3028CC5A4BECC050","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1511431015:0":{"text":"Split up? What if Gorgonna targets you?","source_cn":"分开狩猎？我担心露会去找你们。","status":"matched","hash_xxh64":"0x744FBFDBB7C72E6A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1511431016:0":{"text":"Hmm... then I'll pair up with Dunn, alright?","source_cn":"唔……那么，我就和顿一组吧？","status":"matched","hash_xxh64":"0x75097ADD73B02BF9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1511431017:0":{"text":"As long as we're together, she can't touch us. Isn't that right, Dunn?","source_cn":"只要我和顿在一起，露就伤害不到我们。对吧，顿？","status":"matched","hash_xxh64":"0x5194F47806A5F68C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1511431018:0":{"text":"Ah... y-yeah, of course!","source_cn":"啊……对，你说的当然是对的！","status":"matched","hash_xxh64":"0x95C780B668306CCC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1511431019:0":{"text":"... Do as you like.","source_cn":"……随你们吧。","status":"matched","hash_xxh64":"0xA438F0E5ADCF21E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1511431020:0":{"text":"Come on, let's go!","source_cn":"那我们快走吧，阿米！","status":"matched","hash_xxh64":"0x493411FDC44F75CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1511431021:0":{"text":"See you later, Nazrik.","source_cn":"待会再见，那非。","status":"matched","hash_xxh64":"0xAA503188BDB23513","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"How do you know Dunn?","source_cn":"你和顿很熟悉？","status":"matched_runtime_gender","hash_xxh64":"0x9F38F28933E15AB0","variant_status":"runtime_gender_keys_target_same","male":"How do you know Dunn?","female":"How do you know Dunn?","variant_male_record_index":"79887","variant_female_record_index":"79888","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"You and Dunn seem close.","source_cn":"你和顿的感情似乎比别人更深","status":"matched_runtime_gender","hash_xxh64":"0x8DE9EC42B9CB2811","variant_status":"runtime_gender_keys_target_same","male":"You and Dunn seem close.","female":"You and Dunn seem close.","variant_male_record_index":"79889","variant_female_record_index":"79890","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:0:1":{"text":"Was Ames always like this?","source_cn":"阿米原本就是这个性格吗？","status":"matched_runtime_gender","hash_xxh64":"0xD656CD2BCADE98C7","variant_status":"runtime_gender_keys_target_same","male":"Was Ames always like this?","female":"Was Ames always like this?","variant_male_record_index":"79881","variant_female_record_index":"79882","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1511431008:0":{"text":"... A little.","source_cn":"……有一点。","status":"matched_runtime_gender","hash_xxh64":"0xDE897A06EACD8787","variant_status":"runtime_gender_keys_target_same","male":"... A little.","female":"... A little.","variant_male_record_index":"191199","variant_fe