{"asset_key":"timeline/quest_story_15110141","episode":"timeline","category":"quest_story","story_id":"15110141","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1511014001:":{"text":"Please, open your eyes.","source_cn":"快点醒来吧，珀尔修斯……","status":"matched","hash_xxh64":"0xD086ABE8B2F619F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511014002:":{"text":"Azora! Stop this!","source_cn":"奥法迦！快停下！","status":"matched","hash_xxh64":"0xD6431F8337CA8B5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511014201:":{"text":"No one stands in my way! I won't be denied again!","source_cn":"谁也别想阻拦我！","status":"matched","hash_xxh64":"0xB3461E02B22C2CE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1511014101:0":{"text":"You have to stop.","source_cn":"停手吧，奥法迦。","status":"matched","hash_xxh64":"0xAAF7C54DC1CA2CC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1511014102:0":{"text":"You again... <style=\"highlight\">Dura</style>!","source_cn":"又是你……<style=highlight>艾雅</s...","status":"matched","hash_xxh64":"0x091EE5FF5E0C2EC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_fem