{"asset_key":"timeline/quest_story_13109060","episode":"timeline","category":"quest_story","story_id":"13109060","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1310905001:":{"text":"Oh, Dura... No...","source_cn":"艾雅啊……不——","status":"matched","hash_xxh64":"0x4F5F3FB5B8F1A5FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1310906001:1":{"text":"There's a Hypogean ritual here as well!","source_cn":"这里竟然也进行过恶魔献祭的仪式！","status":"matched","hash_xxh64":"0x0A814739A274BDD8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1310906002:1":{"text":"Fate is ever brimming with ill intent... Let us destroy the altar as before.","source_cn":"果然，命运总是充满恶意……先按照之前的方式破坏祭坛吧。","status":"matched","hash_xxh64":"0x89907702A952E1F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1310906003:0":{"text":"Yes! <style=\"highlight\">Let's end that special Hypofiend and destroy the magic circle</style>!","source_cn":"好！<style=highlight>干掉那个特殊的魔...","status":"matched","hash_xxh64":"0x953CAD556928AC26","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:8:13010913:0":{"text":"The acolytes at St. Valesa's Temple have turned into Hypofiends under the influence of the altar.","source_cn":"在献祭祭坛的影响下，圣瓦勒沙教堂的修士们也变成了魔物。","status":"matched","hash_xxh64":"