{"asset_key":"timeline/quest_story_18105300","episode":"timeline","category":"quest_story","story_id":"18105300","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1810529001:":{"text":"The full moon!","source_cn":"满月了！","status":"matched_runtime_gender","hash_xxh64":"0x19603FBF8351D9CB","variant_status":"runtime_gender_keys_target_same","male":"The full moon!","female":"The full moon!","variant_male_record_index":"243563","variant_female_record_index":"243564","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529002:":{"text":"Keep moving!","source_cn":"继续向前！","status":"matched","hash_xxh64":"0xF56535BB5DDA2CF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529003:":{"text":"We're too late!","source_cn":"不，来不及了！","status":"matched","hash_xxh64":"0x31CE9D57CF2DB9FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529005:":{"text":"Thane!","source_cn":"瑟恩——！","status":"matched","hash_xxh64":"0x586998BAE6FBC283","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529004:":{"text":"Go! I'll hold it off!","source_cn":"你们先走，这里交给我！","status":"matched","hash_xxh64":"0x22DA5D5E44EECC09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529006:":{"text":"Look out!","source_cn":"小心！<key:dialog88>","status":"matched","hash_xxh64":"0xEF2EBD9AE98AED27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810529007:":{"text":"GRAAH!!","source_cn":"嗬啊啊啊……！","status":"matched","hash_xxh64":"0x9CE16E827A3EBFCD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1810530001:0":{"text":"Thane, are you alright?","source_cn":"瑟恩，你没事吧？","status":"matched","hash_xxh64":"0x140905E08853DA5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1810530002:0":{"text":"I'm unharmed. Don't worry.","source_cn":"没有受伤，不用担心。","status":"matched","hash_xxh64":"0xB0FFEB4E84A2917A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1810530003:0":{"text":"You, on the other hand, Baden... That was reckless. Attacking without a weapon... Did you even think about what you'd do after?","source_cn":"倒是巴登……你太鲁莽了，不拿武器就发起攻击，你想过后面...","status":"matched","hash_xxh64":"0x76DFD44699969660","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1810530004:0":{"text":"Shouldn't I be asking you that? You look like a veteran warrior. How did you get pinned down after a single exchange?","source_cn":"你才是轻敌的那个人吧？明明看起来身经百战，为什么才一招...","status":"matched","hash_xxh64":"0x91F05F3AD131E6B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1810530005:1":{"text":"... I've spent too many years occupied with other matters and neglected my training.","source_cn":"……或许是我这几年一直忙于其他事务，疏于锻炼。","status":"matched","hash_xxh64":"0x5E662BFC6E4121D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1810530006:1":{"text":"I'll admit, there are situations where a one-armed man is at a serious disadvantage.","source_cn":"我也得承认，有些局面，独臂确实应对不来。","status":"matched","hash_xxh64":"0x45648D91914B0C25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1810530007:1":{"text":"Hey... I wasn't trying to blame you.","source_cn":"哎……我不是想责怪你。","status":"matched","hash_xxh64":"0x5AF1327B46598B71","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1810530008:1":{"text":"I just meant—\nAh, forget it. I don't even know how to explain.","source_cn":"我只是想说——\\n哎呀，我也不知道该怎么解释了。","status":"matched","hash_xxh64":"0x6415D852DA661DD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1810530009:1":{"text":"I understand what you're trying to say.","source_cn":"不必解释，我明白你的意思。","status":"matched","hash_xxh64":"0xA321B4E228369ED6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1810530010:0":{"text":"The fact that you're willing to risk yourself to protect others proves you're still the Baden I know.","source_cn":"你能为保护他人挺身而出，足以证明，你还是我认识的那个巴登。","status":"matched","hash_xxh64":"0x9D4CCFDD4FE7FFAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1810530011:0":{"text":"I don't like hearing that... But maybe there's a small chance you're right.","source_cn":"我不喜欢听到这些话，但……也许你说的有那么一点可能是真的。","status":"matched","hash_xxh64":"0xFCF83BB7A566546D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1810530012:0":{"text":"Really? You're starting to believe what Thane and I have been saying?","source_cn":"真的？你愿意相信我和瑟恩说的话了？","status":"matched","hash_xxh64":"0x8476F56D189DFFB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1810530013:1":{"text":"Just a little. Instincts don't lie.","source_cn":"只是有一点相信，毕竟下意识的反应没办法骗人。","status":"matched","hash_xxh64":"0xF693032A6590070E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1810530014:1":{"text":"My connection to you and <style=\"stress\"><player_name></style> makes sense. But Thane...","source_cn":"以我和你、和<style=stress><player...","status":"matched_runtime_gender","hash_xxh64":"0xA43486DE9FA7D184","variant_status":"runtime_gender_keys_target_same","male":"My connection to you and <style=\"stress\"><player_name></style> makes sense. But Thane...","female":"My connection to you and <style=\"stress\"><player_name></style> makes sense. But Thane...","variant_male_record_index":"243581","variant_female_record_index":"243582","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:23:1810530014":{"text":"My connection to you and <style=\"stress\"><player_name></style> makes sense. But Thane...","source_cn":"以我和你、和<style=stress><player_name></style>的交情还说得过去，但瑟恩嘛……","status":"matched_runtime_gender","hash_xxh64":"0xA43486DE9FA7D184","variant_status":"runtime_gender_keys_target_same","male":"My connection to you and <style=\"stress\"><player_name></style> makes sense. But Thane...","female":"My connection to you and <style=\"stress\"><player_name></style> makes sense. But Thane...","variant_male_record_index":"243581","variant_female_record_index":"243582","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1810530015:1":{"text":"Do we? That sounds like your imagination.","source_cn":"是吗？是你的错觉吧。","status":"matched_runtime_gender","hash_xxh64":"0x49A18DB3764D7B51","variant_status":"runtime_gender_keys_target_same","male":"Do we? That sounds like your imagination.","female":"Do we? That sounds like your imagination.","variant_male_record_index":"243583","variant_female_record_index":"243584","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1810530016:0":{"text":"If you recover your memories, you'll realize <style=\"stress\"><player_name></style> is absolutely correct.","source_cn":"如果你能尽早恢复记忆，你就会发现<style=stre...","status":"matched_runtime_gender","hash_xxh64":"0x5AB4066C8C3AD4C9","variant_status":"runtime_gender_keys_target_same","male":"If you recover your memories, you'll realize <style=\"stress\"><player_name></style> is absolutely correct.","female":"If you recover your memories, you'll realize <style=\"stress\"><player_name></style> is absolutely correct.","variant_male_record_index":"243585","variant_female_record_index":"243586","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1810530017:0":{"text":"That day can't be too far off...","source_cn":"那一天肯定不会太远的……","status":"matched","hash_xxh64":"0x65E500BC440AFB0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1810530018:0":{"text":"... Wait! Behind you!","source_cn":"……等等！小心背后——！","status":"matched","hash_xxh64":"0x7B2596D4C4BE1C62","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:30:1810531001:":{"text":"Baden, look out!","source_cn":"巴登小心！","status":"matched","hash_xxh64":"0x15D0A1E9AFD48C21","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dial