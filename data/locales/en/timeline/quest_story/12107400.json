{"asset_key":"timeline/quest_story_12107400","episode":"timeline","category":"quest_story","story_id":"12107400","schema_version":1,"lang":"en","texts":{"say:2:1210740001:0":{"text":"These ruffians want to surrender! What should we do now?","source_cn":"索尼娅，这帮水鬼要投降，我们接下来怎么办？","status":"matched","hash_xxh64":"0x49ECD0F792CBEDBA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1210740002:0":{"text":"Let's seize the Chainkeeper!","source_cn":"夺取枷锁号！","status":"matched","hash_xxh64":"0xE099E6A45A3CD5CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210740003:0":{"text":"Hey fellas! Did I hear you're seizing the ship? Guess I caught up at the right time!","source_cn":"——嘿，我听到你们说要夺船？正好！看来我没错过什么。","status":"matched","hash_xxh64":"0x75811FA8BBA1473D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210740004:1":{"text":"Sinbad, you're here. What about Tesio?","source_cn":"辛巴达，你来了？泰西欧呢？","status":"matched","hash_xxh64":"0xF5DDACB708A06B47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210740005:0":{"text":"I tied him up and dumped him in the hold, under the watchful eye of some other Whispers. Don't worry, we gave him some special treatment. He's not going anywhere.","source_cn":"绑好了，丢在船舱里，血薇帮的弟兄们看着呢。别担心，给了...","status":"matched","hash_xxh64":"0x2F92786F649F9724","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210740006:0":{"text":"Boss, thanks to the marks you left us, we've taken full control of the Chainkeeper! We've gotten most of the ruffians settled. Anyone else who doesn't cooperate... can become fish food!","source_cn":"大姐头，兄弟们跟着你留下的记号上船了。现在，枷锁号已经...","status":"matched","hash_xxh64":"0x0B44E944C3697B88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210740007:0":{"text":"Send a messenger back to Lucca to prepare a victory feast. The rest of you, tally up our spoils. If everything's in order, it's time to head back.","source_cn":"派个人回去给卢卡送信，让他准备庆功宴。其余人清点一下战...","status":"matched","hash_xxh64":"0x54ADDF43D48115F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210740008:1":{"text":"Let's set sail! Wheee!","source_cn":"好耶！开枷锁号回去！","status":"matched","hash_xxh64":"0x250CD20BFF43D440","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210740009:1":{"text":"Oh, need me at the helm? I know the way.","source_cn":"要让我来掌舵吗？我知道怎么回去。","status":"matched","hash_xxh64":"0x27A353D9777CB316","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1210740010:0":{"text":"That would be appreciated.","source_cn":"那就有劳了。","status":"matched","hash_xxh64":"0x9D9B0211CD7B69FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:20:1210741001:":{"text":"Holy Kraken!","source_cn":"那是！！！","status":"matched","hash_xxh64":"0x767E4C411180D7A5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:20:1210741002:":{"text":"Aahhh! A sea monster!!!","source_cn":"糟了，是海怪！","status":"matched","hash_xxh64":"0xD99449CBFE8DDF8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:22:120107511:0":{"text":"A kraken attacks the Chainkeeper on your way back, causing it to run aground on an unfamiliar island.","source_cn":"返程的路上，枷锁号被海怪袭击，被迫搁浅在一处陌生的海滩上。","status":"matched","hash_xxh64":"0x5C05D5A65653B8AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:血薇帮的诺克":{"text":"Knox","source":"血薇帮的诺克","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source"