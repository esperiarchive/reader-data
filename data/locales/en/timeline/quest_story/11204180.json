{"asset_key":"timeline/quest_story_11204180","episode":"timeline","category":"quest_story","story_id":"11204180","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1120419001:":{"text":"Children of the sands... Shed your fear...","source_cn":"砂中的孩子，丢掉恐惧","status":"matched","hash_xxh64":"0xAFEAD72DE9A58DCA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120419002:":{"text":"I shall sing to you the song of childhood.","source_cn":"我会为你唱响童年的歌谣","status":"matched","hash_xxh64":"0x05ABF8032D2D8AAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120419003:":{"text":"If you feel lost...","source_cn":"随风飘零的灵魂，若你感到彷徨","status":"matched","hash_xxh64":"0xE33F6DD91C2418EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120419004:":{"text":"Just return to the song...","source_cn":"随着歌声回来吧","status":"matched","hash_xxh64":"0x813BF56C57919A14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120419009:":{"text":"Farewell, my friends...","source_cn":"再见了，我的朋友……","status":"matched","hash_xxh64":"0xADF4CE41FE0B9314","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120419005:":{"text":"May tears cleanse your weary soul...","source_cn":"泪水洗涤疲惫的灵魂","status":"matched","hash_xxh64":"0xC17362EE974C58F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120419008:":{"text":"Many thanks to you, Mother!","source_cn":"谢谢，母亲","status":"matched","hash_xxh64":"0xC3E6B1F29D390D2F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120419007:":{"text":"*Sobbing*","source_cn":"呜呜……<key:dialog1>","status":"matched","hash_xxh64":"0x5803DDBD679F7301","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120419006:":{"text":"May you have a peaceful journey...","source_cn":"愿你在归途中，有所依靠","status":"matched","hash_xxh64":"0xBE3A053B6B4B55FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120418001:1":{"text":"You've come to participate in the ceremony? Who is the deceased?","source_cn":"你们也是来参加仪式的吗？逝者是谁？","status":"matched","hash_xxh64":"0xAED0F9B5681A3823","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120418002:0":{"text":"The deceased... You mean Jackson?","source_cn":"逝者……你是说，贾克松？","status":"matched","hash_xxh64":"0x3523DB5D53E6F3E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120418003:1":{"text":"Jackson, you say? ... A man who once took part in the ceremony... Is he now a slumbering spirit...?","source_cn":"贾克松，是他吗……曾经参加仪式的人，今天却要成为安眠的...","status":"matched","hash_xxh64":"0x68E7C1FE287A4B19","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120418004:0":{"text":"Apologies, but what exactly is this ceremony? We're not Maulers, but we brought Jackson's farewell letter...","source_cn":"不好意思，请问，在这里举办的仪式是什么？我们虽然不是蛮...","status":"matched","hash_xxh64":"0x1028B93D6D8B583E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1120418005:1":{"text":"We are preparing to enact the extremely ancient <style=\"highlight\">Weeping Ceremony</style>. Have you heard of it?","source_cn":"我们在筹备非常传统、非常古老的<style=highl...","status":"matched","hash_xxh64":"0x1BF564D3132761DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1120418005":{"text":"We are preparing to enact the extremely ancient <style=\"highlight\">Weeping Ceremony</style>. Have you heard of it?","source_cn":"我们在筹备非常传统、非常古老的<style=highlight>泣祷仪式</style>，如果你们听说过的话。","status":"matched","hash_xxh64":"0x1BF564D3132761DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1120418006:1":{"text":"To weep and to wail is to pray. To soothe the hearts of the living, and to wish peaceful slumber upon the departed.","source_cn":"泣祷——哭泣。放声大哭。以此来抚平生者的内心，慰藉逝者...","status":"matched","hash_xxh64":"0xB7288142101B2A39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1120418007:1":{"text":"This may seem perfectly ordinary to you, but to us, these are anything but ordinary. One might even say that they're shameful for us.","source_cn":"这对于你们来说可能再普通不过，但是对于我们来说却很特殊...","status":"matched","hash_xxh64":"0x2D4223FA1518F70A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1120418008:1":{"text":"Maulers pride themselves on strength, so the shedding of tears is frowned upon. Despite this, a few clans hold secret Weeping Ceremonies to honor their dead. This is done in secret because if it is discovered, these Maulers will be shunned by their clansmen.","source_cn":"因为蛮血以坚毅不屈为荣，流泪是弱化内心的陋习。虽然少数...","status":"matched","hash_xxh64":"0xD82A080213B311EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1120418009:1":{"text":"So please, what happens here today must remain strictly confidential.","source_cn":"所以，请你们对今天看到的一切保密。","status":"matched","hash_xxh64":"0x4617189471955327","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1120418010:0":{"text":"Thanks for letting us know. We won't tell a soul.","source_cn":"谢谢你的介绍，我们一定会保护你们的秘密。","status":"matched","hash_xxh64":"0x67D99CF47628A83F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1120418011:0":{"text":"Very well. You can go inside. Mother is ready. May the departed find peace.","source_cn":"那么，请进吧，“母亲”已经准备好，愿你们的朋友得到安眠。","status":"matched","hash_xxh64":"0x47E29C91E4CFAEF4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1120418012:0":{"text":"Mother?!","source_cn":"母亲？！","status":"matched","hash_xxh64":"0xCE6525E43BCD5863","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1120418013:0":{"text":"Look, Gali! It's...","source_cn":"伽利，你看，那是——","status":"matched","hash_xxh64":"0x5D5358972F3CF679","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1120418014:0":{"text":"Eleanor!","source_cn":"埃莉诺前辈！","status":"matched","hash_xxh64":"0xADF0796C991608CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"What's a Weeping Ceremony?","source_cn":"泣祷仪式是什么？","status":"matched_runtime_gender","hash_xxh64":"0x3ED6360A0F4A2A37","variant_status":"runtime_gender_keys_target_same","male":"What's a Weeping Ceremony?","female":"What's a Weeping Ceremony?","variant_male_record_index":"64662","variant_female_record_index":"64663","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"Sounds like a depressing ritual.","source_cn":"听起来是一种很悲伤的仪式","status":"matched_runtime_gender","hash_xxh64":"0x52E3A689653DF1A5","variant_status":"runtime_gender_keys_target_same","male":"Sounds like a depressing ritual.","female":"Sounds like a depressing ritual.","variant_male_record_index":"64664","variant_female_record_index":"64665","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:22:1101020443:0":{"text":"Eleanor sheds tears while singing an ancient Mauler song, completing the Weeping Ceremony.","source_cn":"埃莉诺一边落泪，一边唱着古老的蛮血歌谣，完成了这场泣祷仪式。","status":"matched","hash_xxh64":"0x3E98035E8A3070D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:埃莉诺":{"text":"Eleanor","source":"埃莉诺","status":"matched_dialogue_flow"},"speaker:悲伤的蛮血":{"text":"Sad Mauler","source":"悲伤的蛮血","status":"matched_dialogue_flow"},"speaker:沉默的蛮血":{"text":"Quiet Mauler","source":"沉默的蛮血","status":"matched_dialogue_flow"},"speaker:哭泣的蛮血":{"text":"Crying Mauler","source":"哭泣的蛮血","status":"matched_dialogue_flow"},"speaker:温和的蛮血居民":{"text":"Gentle Villager","source":"温和的蛮血居民","status":"matched_dialogue_flow"},"speaker:伽利":{"text":"Gali","source":"伽利","status":"matched_dialogue_flow"},"speaker:梅丽莎":{"text":"Melissa","source":"梅丽莎","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":32,"localized_text_count":27,"speaker_count":8}}