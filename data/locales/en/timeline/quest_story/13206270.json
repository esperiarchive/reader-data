{"asset_key":"timeline/quest_story_13206270","episode":"timeline","category":"quest_story","story_id":"13206270","schema_version":1,"lang":"en","texts":{"say:1:1320627001:0":{"text":"There still seems to be no response. These handwritten letters alone are not enough.","source_cn":"……还是没有反应。光凭这些手写书信仍然不够。","status":"matched","hash_xxh64":"0xE5B76ACACDA8EBAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1320627002:1":{"text":"What precious item would awaken his Callan's soul then...?","source_cn":"对于哥哥来说，能唤起他灵魂的珍贵东西到底是什么呢？","status":"matched","hash_xxh64":"0xEB75CA9CA05D3B70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1320627003:1":{"text":"Miss Carolina, did Callan leave behind any other important belongings before his death?","source_cn":"卡列琳娜小姐，铐兰生前没有再留下其他重要的东西了吗？","status":"matched","hash_xxh64":"0x9E7451F8A78E6ABA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1320627004:1":{"text":"Nothing... He stayed with me after he was turned into a golem. We wandered around the snowy remains of our estate, but all that was left were broken walls and empty rooms.","source_cn":"没有了，他变成机械人偶后一直陪着我，我们在下雪的庄园遗...","status":"matched","hash_xxh64":"0x04DF2DB240042CE0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1320627005:1":{"text":"His past, my childhood, and everything we've been through... It's all gone.","source_cn":"他的过去，我的童年，我们共同经历过的一切……都已经不复存在。","status":"matched","hash_xxh64":"0x98F3FDC441D40994","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1320627005":{"text":"His past, my childhood, and everything we've been through... It's all gone.","source_cn":"他的过去，我的童年，我们共同经历过的一切……都已经不复存在。","status":"matched","hash_xxh64":"0x98F3FDC441D40994","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1320627006:1":{"text":"You wish for Carolina to act as a medium to bring her brother's soul back? She's not an object; she's a living being with her own soul!","source_cn":"你想让卡列琳娜亲自当牵引铐兰灵魂的媒介？她不是一件物品...","status":"matched_runtime_gender","hash_xxh64":"0xBA1BF0C7FAA24116","variant_status":"runtime_gender_keys_target_same","male":"You wish for Carolina to act as a medium to bring her brother's soul back? She's not an object; she's a living being with her own soul!","female":"You wish for Carolina to act as a medium to bring her brother's soul back? She's not an object; she's a living being with her own soul!","variant_male_record_index":"145938","variant_female_record_index":"145939","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1320627007:1":{"text":"The magic for extracting and transferring souls is incredibly dangerous. If done incorrectly, it could cause irreversible harm to both Carolina and Callan.","source_cn":"牵引灵魂的魔法极其危险，操作不当会对铐兰和卡列琳娜的灵...","status":"matched_runtime_gender","hash_xxh64":"0xA7D667D60D8AA86A","variant_status":"runtime_gender_keys_target_same","male":"The magic for extracting and transferring souls is incredibly dangerous. If done incorrectly, it could cause irreversible harm to both Carolina and Callan.","female":"The magic for extracting and transferring souls is incredibly dangerous. If done incorrectly, it could cause irreversible harm to both Carolina and Callan.","variant_male_record_index":"145940","variant_female_record_index":"145941","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1320627008:1":{"text":"But is it possible?","source_cn":"所以，是可行的吗？","status":"matched","hash_xxh64":"0x21CC6BACF1901EF7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1320627009:1":{"text":"I haven't tested it on anyone, and I don't plan to.","source_cn":"我没有试过，而且不想在任何人身上尝试。","status":"matched","hash_xxh64":"0x0531D7F3E09D4BC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1320627010:1":{"text":"My lord, please hear what I have to say. I honestly don't mind.","source_cn":"……子爵先生，请听我说。我不介意。","status":"matched","hash_xxh64":"0xCCCDAE0E4567D2E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1320627011:1":{"text":"In fact, I very much like to try.","source_cn":"不如说，我非常愿意。","status":"matched","hash_xxh64":"0x00F3047FC97FBEFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1320627012:1":{"text":"Your soul could be torn asunder, and you might endure unbearable pain just like Callan. This agony will embed itself in your soul, lasting beyond any eternity you can conceive.","source_cn":"你的灵魂可能被撕裂，和铐兰一样承受难以忍受的痛苦，那种...","status":"matched","hash_xxh64":"0xEE8408FCE5A5CADF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1320627013:1":{"text":"It's what my brother has been enduring, is it not?","source_cn":"这就是哥哥一直在承受的，对么？","status":"matched","hash_xxh64":"0xE720614B99626797","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1320627014:1":{"text":"Yes, but Callan has already suffered. You're different.","source_cn":"铐兰已经承受过痛苦了，你和他不一样。","status":"matched","hash_xxh64":"0x26010F4F3665C900","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1320627015:1":{"text":"Your willingness to sacrifice yourself shows you're truly a Radinov... Why must fate torment Eamon's descendants this way?","source_cn":"你是拉季诺夫家的人……命运为什么一定要这样作弄叶夫尼的...","status":"matched","hash_xxh64":"0x03E1ADDFA2D76B25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1320627016:1":{"text":"I appreciate your concern, my lord, but how can I run away when I can now share his pain after making my brother suffer for so long due to my own selfish desires?","source_cn":"感谢您的关怀，子爵先生。但是我已经为了自己自私的愿望而...","status":"matched","hash_xxh64":"0xD69358CFBC5E38B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1320627017:1":{"text":"Moreover, your cautious nature reassures me that you will strive to fulfill my and my brother's wishes.","source_cn":"而且，您那么谨慎温柔，我相信您会拼尽全力实现我和哥哥的愿望。","status":"matched","hash_xxh64":"0x3E7F2D7AC5DED36C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1320627018:1":{"text":"Let us have him rest in peace.","source_cn":"——让他安息。","status":"matched","hash_xxh64":"0x8AFE10CB12C4BD33","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1320627019:1":{"text":"...","source_cn":"…………","status":"matched","hash_xxh64":"0x70646B5D874C111A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:21:1320627019":{"text":"...","source_cn":"…………","status":"matched","hash_xxh64":"0x70646B5D874C111A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1320627020:1":{"text":"It's maddening that the Radinovs always choose to sacrifice themselves...","source_cn":"……我讨厌拉季诺夫家的人总是选择自我牺牲。","status":"matched","hash_xxh64":"0x3E91074DA11A62D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1320627021:1":{"text":"If you're prepared, Carolina, step in front of Callan, and please don't let me regret this.","source_cn":"如果你做好了准备……卡列琳娜，站到铐兰面前吧，不要给我...","status":"matched","hash_xxh64":"0xEF9ADDA1FC027992","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1320627022:1":{"text":"Thank you, my lord.","source_cn":"谢谢您，先生。","status":"matched","hash_xxh64":"0x57DADCDE6E6FBB54","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:28:1320628001:":{"text":"Hear us, bound soul!","source_cn":"聆听吧，受缚的灵魂","status":"matched","hash_xxh64":"0x93B530205341BF0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:28:1320628002:":{"text":"Hear me, Callan!","source_cn":"哥哥，听见我吧！","status":"matched","hash_xxh64":"0xBA54624ADC8698F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:28:1320628003:":{"text":"Little... Carly...","source_cn":"小……卡……莎……","status":"matched","hash_xxh64":"0x92206CEECCC6756F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:28:1320628005:":{"text":"Something's wrong!","source_cn":"不对——","status":"matched","hash_xxh64":"0xE42062AAFD8332BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:28:1320628006:":{"text":"He's resisting the magic!","source_cn":"他在抗拒灵魂转移的魔法！","status":"matched","hash_xxh64":"0x403123B4F80604E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:28:1320628004:":{"text":"Little Carly!","source_cn":"小卡莎！！！","status":"matched","hash_xxh64":"0x2F28CDF9E6466664","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:28:1320628004:timeline_repeat_1":{"text":"Little Carly!","source_cn":"小卡莎！！！","status":"matched","hash_xxh64":"0x2F28CDF9E6466664","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:30:13020646:0":{"text":"Carolina volunteers to be the guidepost for transferring souls. Callan finally reacts, but it is to resist Ludovic's magic.","source_cn":"这一次，卡列琳娜自愿充当转移灵魂的媒介，铐兰终于出现了...","status":"matched","hash_xxh64":"0x7557C6311345724D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:21:0:1":{"text":"Still can't make up your mind?","source_cn":"还是无法下定决心吗？","status":"matched_runtime_gender","hash_xxh64":"0x7818623356D139E8","variant_status":"runtime_gender_keys_target_same","male":"Still can't make up your mind?","female":"Still can't make up your mind?","variant_male_record_index":"68818","variant_female_record_index":"68819","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:21:1:2":{"text":"Everything depends on you.","source_cn":"这一切取决于你了","status":"matched_runtime_gender","hash_xxh64":"0xA7EF0A04BB68E47B","variant_status":"runtime_gender_keys_target_same","male":"Everything depends on you.","female":"Everything depends on you.","variant_male_record_index":"68820","variant_female_record_index":"68821","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"You and your memory of him are still here.","source_cn":"但你还在这里，你还记得他","status":"matched_runtime_gender","hash_xxh64":"0xB4CE9F5D24195C86","variant_status":"runtime_gender_keys_target_same","male":"You and your memory of him are still here.","female":"You and your memory of him are still here.","variant_male_record_index":"68814","variant_female_record_index":"68815","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"Can another soul serve as a medium?","source_cn":"……有灵魂的存在能当媒介吗？","status":"matched_runtime_gender","hash_xxh64":"0x0B56D72686893DDD","variant_status":"runtime_gender_keys_target_same","male":"Can another soul serve as a medium?","female":"Can another soul serve as a medium?","variant_male_record_index":"68816","variant_female_record_index":"68817","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:柳博米尔":{"text":"Ludovic","source":"柳博米尔","status":"matched_dialogue_flow"},"speaker:卡列琳娜":{"text":"Carolina","source":"卡列琳娜","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:铐兰":{"text":"Callan","source":"铐兰","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":41,"localized_text_count":36,"speaker_count":5}}