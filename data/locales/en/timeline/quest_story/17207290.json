{"asset_key":"timeline/quest_story_17207290","episode":"timeline","category":"quest_story","story_id":"17207290","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1720728001:":{"text":"No cash, no entry!","source_cn":"没钱就下次再来吧","status":"matched","hash_xxh64":"0xE38E789132DA7031","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1720728002:":{"text":"Rude! How rude!","source_cn":"粗鲁！真是粗鲁！","status":"matched","hash_xxh64":"0x836882FB8D379B48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1720728003:":{"text":"That was beautiful!","source_cn":"真好听！<key:dialog1>","status":"matched","hash_xxh64":"0xD91F87BB0DFC198D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1720728004:":{"text":"A round of applause!","source_cn":"鼓掌鼓掌！","status":"matched","hash_xxh64":"0x81668F2F8DC2B6A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1720728005:":{"text":"Bravo!","source_cn":"太精彩了！","status":"matched","hash_xxh64":"0x64D07C42A84C2947","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1720728006:":{"text":"Thanks for the performance!","source_cn":"谢谢你的表演！","status":"matched","hash_xxh64":"0xA4AA60ADEAE66043","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1720729001:0":{"text":"That poor minstrel looks hungry. Should we help him?","source_cn":"那是个吟游诗人吧？他是不是也饿着肚子？我们能不能帮帮他？","status":"matched","hash_xxh64":"0xA5B8655F1A15165F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1720729002:0":{"text":"Prin... Lady Penny, hold on. Your heart's in the right place, but you'll need the right approach so you don't hurt his pride.","source_cn":"佩……佩小姐，等等。帮忙也得讲究方法，成年人的自尊心，...","status":"matched","hash_xxh64":"0xB9F9A765AEBC6772","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1720729003:0":{"text":"I know! I'll be tactful about it. Just watch me!","source_cn":"我知道！我会很礼貌地提供帮助的。看我的吧！","status":"matched","hash_xxh64":"0x2D76B50C6AEABCB8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1720729004:0":{"text":"Peggy steadies herself with a deep breath before moving toward the minstrel...","source_cn":"佩吉深吸了一口气，走上前去——","status":"matched","hash_xxh64":"0xFAF5E87358EEF427","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1720729005:0":{"text":"Rude! How rude! Fine wine should be enjoyed with music and poetry, not tainted by the vulgar stink of money!","source_cn":"粗鲁！真是粗鲁！美酒应当搭配音乐和诗歌，而不是铜臭味！","status":"matched","hash_xxh64":"0x201AFCC5EBFCBB27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1720729006:0":{"text":"May I speak to you for a second, sir?","source_cn":"这位先生，请留步。","status":"matched","hash_xxh64":"0xB22DE23DB93937A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1720729007:0":{"text":"I-I really admire your talent. If you don't mind, I'd like to pay for your drinks... Consider it my way of supporting your art.","source_cn":"我、我很欣赏您的才华，如果您不介意的话，我想替您支付酒...","status":"matched","hash_xxh64":"0xB5049BBD7D69B49D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1720729008:0":{"text":"Pay for my drinks? Supporting my art?","source_cn":"替我付钱？为了艺术？","status":"matched","hash_xxh64":"0xC57F417164CD630C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1720729009:0":{"text":"Young lady, your courtesy is admirable, but I can tell it's driven by pity.","source_cn":"小姑娘，你的礼仪无可挑剔，但我听得出来，你的举动只不过...","status":"matched","hash_xxh64":"0x24BB5CEAD27720E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1720729010:0":{"text":"What? That's... not the case...","source_cn":"哎？我……我没有……","status":"matched","hash_xxh64":"0x0DBA37C20F2B95AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1720729011:0":{"text":"Please, spare me your kindness. I don't need any handouts, no matter what you call them.","source_cn":"收起你的好意吧。我的才华不需要施舍，哪怕是包装得再精美...","status":"matched","hash_xxh64":"0xF584F26A8F2666FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1720729012:0":{"text":"Just enjoy my performance if you really like what I do.","source_cn":"如果你真的欣赏我的才华，就该安静地站在这里，听我唱完这首歌。","status":"matched","hash_xxh64":"0xED1582DF1CD46CCD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1720729013:0":{"text":"Should my voice move you, leave me a coin. If not, you're free to walk away, guilt-free.","source_cn":"要是我的歌声打动了你，我很欢迎你把那枚该死的金币放进我...","status":"matched","hash_xxh64":"0x900C4204C3EF7996","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1720729014:0":{"text":"That's what you do if you respect me as a minstrel, not paying me off before I've even sung a note.","source_cn":"那才是一个吟游诗人应得的尊严，而不是像现在这样，还没开...","status":"matched","hash_xxh64":"0x994E288FC07F4EE0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1720729015:0":{"text":"S-Sorry, I meant well...","source_cn":"对……对不起。我只是想帮忙……","status":"matched","hash_xxh64":"0x07A994FECBD2B7AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1720729016:0":{"text":"Then give me your full attention. That's all I ask. You're listening to the finest minstrel in all of Savannah!","source_cn":"想帮忙？那就竖起耳朵认真听吧。这可是全赛凡纳最好的吟游...","status":"matched","hash_xxh64":"0x29C189A43318F576","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:25:1720728001:":{"text":"No cash, no entry!","source_cn":"没钱就下次再来吧","status":"matched","hash_xxh64":"0xE38E789132DA7031","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:25:1720728002:":{"text":"Rude! How rude!","source_cn":"粗鲁！真是粗鲁！","status":"matched","hash_xxh64":"0x836882FB8D379B48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:25:1720728003:":{"text":"That was beautiful!","source_cn":"真好听！<key:dialog1>","status":"matched","hash_xxh64":"0xD91F87BB0DFC198D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:25:1720728004:":{"text":"A round of applause!","source_cn":"鼓掌鼓掌！","status":"matched","hash_xxh64":"0x81668F2F8DC2B6A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:25:1720728005:":{"text":"Bravo!","source_cn":"太精彩了！","status":"matched","hash_xxh64":"0x64D07C42A84C2947","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:25:1720728006:":{"text":"Thanks for the performance!","source_cn":"谢谢你的表演！","status":"matched","hash_xxh64":"0xA4AA60ADEAE66043","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1720729017:0":{"text":"... From a faraway land, a young man sets forth. His old lute is his oar, he carries nothing more...","source_cn":"……他从千里之外的村庄启程，一把旧琴是他的舟桨……","status":"matched","hash_xxh64":"0xE1E6FC4C0F03DEFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1720729018:0":{"text":"... He arrives in the royal capital, radiant and surreal. Mistaking its splendor for a haven ideal...","source_cn":"……他来到了纸醉金迷的王都，以为这里是梦中的故乡……","status":"matched","hash_xxh64":"0x44029EFDA77AB8DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1720729019:0":{"text":"... The crowd drifts past, unmoved by his song. Like rivers they rush, relentless, headstrong...","source_cn":"……人群流水般匆匆经过，没有人驻足听他歌唱……","status":"matched","hash_xxh64":"0x31F7E1FC25E7C683","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1720729020:0":{"text":"... Yet the wind lingers softly, the birds sing along...","source_cn":"……人群流水般迢迢路过，风和鸟儿在听他唱歌……","status":"matched","hash_xxh64":"0xAEBD20DAB66B639B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1720729021:0":{"text":"... They lift up his spirit, and show he belongs...","source_cn":"……风儿为他温柔地停留，鸟儿为了他鸣鸣啾啾……","status":"matched","hash_xxh64":"0x954E30D23C2BA225","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1720729022:0":{"text":"... O young minstrel, do not grieve, so long as your strings still breathe...","source_cn":"……年轻的吟游诗人啊，不要忧伤，只要琴弦未断……","status":"matched","hash_xxh64":"0xFCBB41F7D3B80B8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1720729023:0":{"text":"... Simply savor the wandering free, for freedom itself is melody...","source_cn":"……就暂且享受这自由的流浪……","status":"matched","hash_xxh64":"0xBD7BBD4001EC137E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:34:1720729024:0":{"text":"The minstrel wraps up his performance...","source_cn":"一曲表演结束后——","status":"matched","hash_xxh64":"0xA4BE153D793083F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:37:1720728001:":{"text":"No cash, no entry!","source_cn":"没钱就下次再来吧","status":"matched","hash_xxh64":"0xE38E789132DA7031","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:37:1720728002:":{"text":"Rude! How rude!","source_cn":"粗鲁！真是粗鲁！","status":"matched","hash_xxh64":"0x836882FB8D379B48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:37:1720728003:":{"text":"That was beautiful!","source_cn":"真好听！<key:dialog1>","status":"matched","hash_xxh64":"0xD91F87BB0DFC198D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:37:1720728004:":{"text":"A round of applause!","source_cn":"鼓掌鼓掌！","status":"matched","hash_xxh64":"0x81668F2F8DC2B6A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:37:1720728005:":{"text":"Bravo!","source_cn":"太精彩了！","status":"matched","hash_xxh64":"0x64D07C42A84C2947","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:37:1720728006:":{"text":"Thanks for the performance!","source_cn":"谢谢你的表演！","status":"matched","hash_xxh64":"0xA4AA60ADEAE66043","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:39:1702072203:0":{"text":"When the song ends, the children clap with genuine delight. Peggy drops a gold coin into the minstrel's instrument case.","source_cn":"一曲表演结束后，孩子们发自内心地为吟游诗人鼓掌，佩吉把...","status":"matched","hash_xxh64":"0x97ABA83CEB0209CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:40:1702072202:0":{"text":"The minstrel begins to play his instrument and sing.","source_cn":"吟游诗人开始弹奏起了音乐，唱起了歌。","status":"matched","hash_xxh64":"0x8E711A600C7B5CAA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:41:1702072201:0":{"text":"On your way to the temple, you see a bartender throw a ragged minstrel out of the tavern.","source_cn":"在前往教堂的路上，你们看到酒保把一个衣衫褴褛的吟游诗人...","status":"matched_runtime_gender","hash_xxh64":"0xCF0DEEC10C1B4BBB","variant_status":"runtime_gender_keys_target_same","male":"On your way to the temple, you see a bartender throw a ragged minstrel out of the tavern.","female":"On your way to the temple, you see a bartender throw a ragged minstrel out of the tavern.","variant_male_record_index":"236447","variant_female_record_index":"236448","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:酒保1":{"text":"酒保1","source":"酒保1","status":"source"},"speaker:骄傲的吟游诗人":{"text":"Haughty Minstrel","source":"骄傲的吟游诗人","status":"matched_dialogue_flow"},"speaker:小孩珍妮":{"text":"Jenine","source":"小孩珍妮","status":"matched_dialogue_flow"},"speaker:小孩莫莉":{"text":"Mollie","source":"小孩莫莉","status":"matched_dialogue_flow"},"speaker:佩吉":{"text":"Peggy","source":"佩吉","status":"matched_dialogue_flow"},"speaker:罗万":{"text":"Rowan","source":"罗万","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"},"speaker:黑屏文本":{"text":"Black Screen Text","source":"黑屏文本","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":58,"localized_text_count":45,"speaker_count":9}}