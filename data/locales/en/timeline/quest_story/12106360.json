{"asset_key":"timeline/quest_story_12106360","episode":"timeline","category":"quest_story","story_id":"12106360","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1210635001:":{"text":"Have you set loose my experimental subjects?","source_cn":"是你们把我的实验材料放走了？","status":"matched","hash_xxh64":"0x77AA284A864B3F1F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210636001:0":{"text":"No wonder my darling was on high alert. It was your meddling all along...","source_cn":"难怪我的小宝贝警戒起来了，原来是你们搞的鬼……","status":"matched","hash_xxh64":"0x8B7DA1AD13047A3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210636002:0":{"text":"Darling? You call that snake your darling?!","source_cn":"宝贝？你叫这条蛇宝贝？！","status":"matched","hash_xxh64":"0x78AE2842FA773BE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210636003:0":{"text":"Insolent rodents! You comprehend nothing of a snake's grace and slender form.","source_cn":"无礼的啮齿动物！你们对于骨感的美一无所知。","status":"matched","hash_xxh64":"0x23F6858B43F0F7BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210636004:0":{"text":"Did you say these people are your \"experimental subjects\"? How cruel!","source_cn":"你刚才说这些人都是你的实验材料，太过分了！","status":"matched","hash_xxh64":"0x70BE2C1968C3B4FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210636005:0":{"text":"*Cackle* Soon, you shall join my esteemed subjects.","source_cn":"呵呵……你们也将成为我的实验材料……","status":"matched","hash_xxh64":"0x63A36CBBEE70B866","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210636006:0":{"text":"Wouldn't you agree, my darling?","source_cn":"乖孩子……你说是吧？","status":"matched","hash_xxh64":"0x422DDCBA8F8C6A9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210636007:0":{"text":"Magister, this guy is scaring Chippy!","source_cn":"主人，这个人让满满的寒毛都竖起来了！","status":"matched_runtime_gender","hash_xxh64":"0x5642FF4F16920EB1","variant_status":"runtime_gender_keys_target_same","male":"Magister, this guy is scaring Chippy!","female":"Magister, this guy is scaring Chippy!","variant_male_record_index":"131073","variant_female_record_index":"131074","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1210636008:0":{"text":"Tremble with fear. How fortunate you are... to become sustenance for my darling.","source_cn":"为之颤栗吧，你们竟然有这等幸运……成为我小宝贝的食物。","status":"matched","hash_xxh64":"0xACF458A41861266C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:18:12010645:0":{"text":"After rescuing all the widows, a Graveborn sorcerer appears before you.","source_cn":"在你们救出所有船员遗孀后，一位亡灵术士出现在了你们眼前。","status":"matched","hash_xxh64":"0x344A796B316313C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:亡灵术士":{"text":"Graveborn","source":"亡灵术士","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":15,"localized_text_count":10,"speaker_count":4}}