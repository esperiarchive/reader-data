{"asset_key":"timeline/quest_story_16207360","episode":"timeline","category":"quest_story","story_id":"16207360","schema_version":1,"lang":"en","texts":{"say:1:1620735001:1":{"text":"Is that an owlbear?! Oh no, a student must've gone wild with chaos magic!","source_cn":"啊啊啊！这是、是枭熊？！我懂了，又一个用了混沌魔法的学生！","status":"matched","hash_xxh64":"0x9129CD7E403EC46A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1620735002:0":{"text":"Don't worry, I'm coming to save you!","source_cn":"别害怕，我马上就来救你！","status":"matched","hash_xxh64":"0x1E7873C91CEF4522","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1620736001:1":{"text":"Hold up! I thought you turned yourself into an owlbear. How come my magic turned you into me, and then a professor?!","source_cn":"欸欸欸？！你不是被变成了枭熊的学生吗？！为什么会变成我...","status":"matched","hash_xxh64":"0x009EA9258DCB81B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1620736002:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1620736003:1":{"text":"Oh... you're actually Professor Hepler, aren't you?","source_cn":"所以……您……真的是赫普老师？","status":"matched","hash_xxh64":"0x9D68E90FDF0B510B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1620736004:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1620736005:1":{"text":"S-sorry, sorry, sorry! I didn't realize it was you, Professor. But... um... why are you here?","source_cn":"对不起对不起对不起！我不知道是赫普老师您！可是您为什么...","status":"matched","hash_xxh64":"0x61EDE06B55B2D5DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1620736006:1":{"text":"... My afternoon nap.","source_cn":"……午睡。","status":"matched","hash_xxh64":"0x2855F205F1529BE1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1620736007:1":{"text":"Ah, sorry for crashing your nap, sir. Let me get out of your hair.","source_cn":"非常抱歉打扰了您的午睡！我马上从您的视线中离开！","status":"matched","hash_xxh64":"0x57C4DAF846026C6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1620736008:1":{"text":"... Professor Solise is just ahead.","source_cn":"……娑丽丝就在前面。","status":"matched","hash_xxh64":"0xBC9803E0C440B9F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"