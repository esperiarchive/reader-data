{"asset_key":"timeline/quest_story_12104020","episode":"timeline","category":"quest_story","story_id":"12104020","schema_version":1,"lang":"en","texts":{"say:4:1210402001:1":{"text":"This shipyard is much larger than what Chippy imagined. ","source_cn":"这个造船厂比满满想象中大太多了。","status":"matched","hash_xxh64":"0xBEB03ED49FC82896","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210402002:0":{"text":"Sinbad, this shipyard seems to have no ships...","source_cn":"辛巴达，这个造船厂……好像没有船？","status":"matched","hash_xxh64":"0xFD90060B27760300","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210402003:1":{"text":"Look at the cannon on the wall, it's so shiny. Are you sure this is a shipyard? It feels like a weapons workshop.","source_cn":"瞧那城墙上的大炮，炮口锃亮锃亮的。你确定这是造船厂吗？...","status":"matched","hash_xxh64":"0x090C35805E8FBEEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210402004:1":{"text":"Whether it's a shipyard or a weapons workshop, they're all about making weapons. It doesn't really matter, does it? Would you not have come this way anyway?","source_cn":"不管是造船厂，还是军工厂，总之都是武器厂，也没什么关系...","status":"matched","hash_xxh64":"0x4EAC181E785053FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1210402004":{"text":"Whether it's a shipyard or a weapons workshop, they're all about making weapons. It doesn't really matter, does it? Would you not have come this way anyway?","source_cn":"不管是造船厂，还是军工厂，总之都是武器厂，也没什么关系吧？难道就因为是军工厂，你们就不走这条路了吗？","status":"matched","hash_xxh64":"0x4EAC181E785053FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1210402005:1":{"text":"I feel like Sinbad isn't being honest with us.","source_cn":"总感觉……辛巴达没有对我们坦诚呢。","status":"matched","hash_xxh64":"0xD2BB26CDA1EED3E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210402006:1":{"text":"Alright, I admit that I didn't tell you the truth, but it's because this place is a secret.","source_cn":"好啦，别猜了。我承认，没有对你们说实话。因为这里是干什...","status":"matched","hash_xxh64":"0xC82107F7D5B66701","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210402007:0":{"text":"Watch out!","source_cn":"如果你们——小心！","status":"matched","hash_xxh64":"0xB13973EE7FA865EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1210403001:0":{"text":"Wow! Is that how powerful mages are? You actually blocked a cannonball!","source_cn":"哇……这就是魔法师的力量吗？竟然能挡下炮弹？","status":"matched_runtime_gender","hash_xxh64":"0x50837C387A28C646","variant_status":"runtime_gender_keys_target_same","male":"Wow! Is that how powerful mages are? You actually blocked a cannonball!","female":"Wow! Is that how powerful mages are? You actually blocked a cannonball!","variant_male_record_index":"128032","variant_female_record_index":"128033","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1210403002:0":{"text":"Who fired that shot?!","source_cn":"谁在开炮？！","status":"matched","hash_xxh64":"0x600D6F8ABAA65394","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1210403003:0":{"text":"You urchins better get up here or you'll get shot again!","source_cn":"你们几个娃子！我看见你们了！乖乖爬上来，不然就再吃一炮！","status":"matched","hash_xxh64":"0x9B8864E250504E43","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1210403004:1":{"text":"Oh no, we've been spotted!","source_cn":"呃……不好，我们被发现了！","status":"matched","hash_xxh64":"0x1B98DDFABE80010D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1210403005:1":{"text":"What should we do? Should we listen to him?","source_cn":"怎么办，我们要听他的话上去吗？","status":"matched","hash_xxh64":"0x9C60B83B125CB6F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1210403006:1":{"text":"No way! What if he's lying to us? We've been tricked before.","source_cn":"不要！万一他是骗我们的……我们已经吃了几次亏了。","status":"matched","hash_xxh64":"0xF5B0ABD63B15AE9F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1210403007:1":{"text":"Good, you're learning.","source_cn":"不错，很警觉嘛。","status":"matched","hash_xxh64":"0x84B7390E352C7E7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:26:1210403007":{"text":"Good, you're learning.","source_cn":"不错，很警觉嘛。","status":"matched","hash_xxh64":"0x84B7390E352C7E7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1210403008:1":{"text":"Don't worry. That's Hugin. He won't hurt ya.","source_cn":"别担心伙计们，呼金是我的老朋友了，他不会害你们的。","status":"matched","hash_xxh64":"0x1760EC0A4F83C3ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1210403009:1":{"text":"Are you sure?","source_cn":"咦，为什么？","status":"matched","hash_xxh64":"0x65EE7C3DBC76E106","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1210403010:1":{"text":"Hugin's been looking for a mage. You'll see when you meet him.","source_cn":"因为呼金等待魔法师已经太久，哈哈，你们上去就知道了。","status":"matched_runtime_gender","hash_xxh64":"0x47D627F1AB25133D","variant_status":"runtime_gender_keys_target_same","male":"Hugin's been looking for a mage. You'll see when you meet him.","female":"Hugin's been looking for a mage. You'll see when you meet him.","variant_male_record_index":"128042","variant_female_record_index":"128043","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:0:1":{"text":"Rustport is a tough place to live.","source_cn":"毕竟锈锚港民风彪悍","status":"matched_runtime_gender","hash_xxh64":"0x7C5E804DA3381817","variant_status":"runtime_gender_keys_target_same","male":"Rustport is a tough place to live.","female":"Rustport is a tough place to live.","variant_male_record_index":"64992","variant_female_record_index":"64993","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:1:2":{"text":"It's better to be cautious.","source_cn":"谨慎总是没错的","status":"matched_runtime_gender","hash_xxh64":"0xA4FEEE7BD127D1B1","variant_status":"runtime_gender_keys_target_same","male":"It's better to be cautious.","female":"It's better to be cautious.","variant_male_record_index":"64994","variant_female_record_index":"64995","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:31:12010417:0":{"text":"A cannonball plummets from above all of a sudden. Thanks to your quick reflexes, you block it with your magic shield.","source_cn":"一颗炮弹突然从天而降。所幸你反应迅速，用魔法护盾挡下了它。","status":"matched","hash_xxh64":"0x4C1C8A1D47A7CADC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"It does matter.","source_cn":"有关系","status":"matched_runtime_gender","hash_xxh64":"0x8AA4EFB0FBF3C786","variant_status":"runtime_gender_keys_target_same","male":"It does matter.","female":"It does matter.","variant_male_record_index":"64988","variant_female_record_index":"64989","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"No worries.","source_cn":"没关系","status":"matched_runtime_gender","hash_xxh64":"0xAFDA9665E4AA5D63","variant_status":"runtime_gender_keys_target_same","male":"No worries.","female":"No worries.","variant_male_record_index":"64990","variant_female_record_index":"64991","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:粗犷的声音":{"text":"Rough Voice","source":"粗犷的声音","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":29,"localized_text_count":24,"speaker_count":5}}