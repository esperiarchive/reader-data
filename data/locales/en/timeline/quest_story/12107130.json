{"asset_key":"timeline/quest_story_12107130","episode":"timeline","category":"quest_story","story_id":"12107130","schema_version":1,"lang":"en","texts":{"say:4:1210713001:0":{"text":"Please... spare us!","source_cn":"求……求你放过我们！","status":"matched","hash_xxh64":"0x22DE2195D077A29A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210713002:0":{"text":"*Evil cackling* More! Scream louder, let me hear your desperation!","source_cn":"哈哈哈哈，不够！再叫得更惨一点，更绝望一点！","status":"matched","hash_xxh64":"0x08A35EB4A76113C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210713003:0":{"text":"Please... no more...","source_cn":"——求求你——放过我们！！","status":"matched","hash_xxh64":"0x9895E714D7C0D454","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210713004:0":{"text":"Ugh. What a waste. These two cowards can't even scream properly.","source_cn":"两个废物，惨叫都叫不出声。","status":"matched","hash_xxh64":"0xC066FA242B69A0C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1210713005:0":{"text":"Alright then. Do you want to live?","source_cn":"想活吗？我给你们机会。","status":"matched","hash_xxh64":"0x2E089E7F6DE49701","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1210713006:0":{"text":"Here, take this vial of potion. One of you drinks, and the other goes free.","source_cn":"这里有一瓶药水，你们选个人喝下去，我就把另一个放了。","status":"matched","hash_xxh64":"0x187F1E62D1C3F0F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210713007:0":{"text":"What will happen if we drink it?","source_cn":"……喝了会怎么样？","status":"matched","hash_xxh64":"0x57908C7A337A9E89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210713008:0":{"text":"*Scary giggle* See for yourselves!","source_cn":"喏~你们自己看。","status":"matched","hash_xxh64":"0xD09A63D57E8C8F8D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1210713009:0":{"text":"ROAR!!!","source_cn":"吼——","status":"matched","hash_xxh64":"0x1115B6D8CB85973D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210713010:0":{"text":"How is this better than being dead?!","source_cn":"……变成这样，和死了有什么区别？","status":"matched","hash_xxh64":"0xD677AF4E204D41EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1210713011:0":{"text":"It's your choice. Pick who dies, or you both perish together.","source_cn":"就看你们是选死一个，还是一起死咯？","status":"matched","hash_xxh64":"0x244FC84C358CAB25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1210713012:0":{"text":"You... you seadevil!","source_cn":"你是个恶魔……恶魔！","status":"matched","hash_xxh64":"0x082C0652A748AD7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1210713013:0":{"text":"*Manic laughter* Wouldn't you do anything for your wife?","source_cn":"哈哈哈！你不是说可以为她去死吗？","status":"matched","hash_xxh64":"0xD32E04B1745E469E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1210713014:0":{"text":"I'm giving you that precious chance. Why not thank me? Thank me! Hahaha!","source_cn":"我给你实现愿望的机会，为什么不感谢我？感谢我呀！哈哈哈哈！","status":"matched","hash_xxh64":"0x02FC8D9E6B3323D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1210713015:0":{"text":"Please... Just let us go...","source_cn":"求求你……放过我们吧……","status":"matched","hash_xxh64":"0xB1F63EAE7EEDAC2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1210713016:0":{"text":"But if you can't choose, well, I guess I should pick for you! Eenie meenie...","source_cn":"不选的话，我就让它帮你们选了？","status":"matched","hash_xxh64":"0x31AA40BE14FA9724","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1210713017:0":{"text":"G... gurgle...","source_cn":"咕……叽……","status":"matched","hash_xxh64":"0x4CC36F49F69E5BD1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1210713018:0":{"text":"Raya, I... I'm willing to die for you. Let me drink it!","source_cn":"拉亚，我……我愿意为了你去死，让我喝吧！","status":"matched","hash_xxh64":"0x352AE68BCD7FA058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1210713019:0":{"text":"Tyrus, if only one of us can survive, it should be you! I'll drink it!","source_cn":"提尔，如果只能活一个，我宁愿是你！让我喝！","status":"matched","hash_xxh64":"0x8586F94BD9496342","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1210713020:0":{"text":"If you die, there would be nothing worth living for!","source_cn":"你要是死了，我活着还有什么意思？","status":"matched","hash_xxh64":"0xA4538881F2716C2C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1210713021:0":{"text":"Then let's drink it together! Give us the potion!","source_cn":"那就一起喝吧！把药给我们！","status":"matched","hash_xxh64":"0xBF9E82469EDD9519","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:37:1210713022:0":{"text":"They both swallow the potion...","source_cn":"两人一起喝下了药水……","status":"matched","hash_xxh64":"0xF94749EB4B9005C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1210713023:0":{"text":"My love, not even death can separate us...","source_cn":"提尔，这下连死亡都没法分开我们了……","status":"matched","hash_xxh64":"0xC740B4C5B9D803C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1210713024:0":{"text":"*Coughing* Raya, I... I'm sorry...","source_cn":"咳咳，拉亚，我……对不起……","status":"matched","hash_xxh64":"0x332D1A7AEB638D0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1210713025:0":{"text":"You—you didn't drink it just now? You lied to me?!","source_cn":"你——你刚才没有把药水咽下去？你在骗我？！！","status":"matched","hash_xxh64":"0xF2D7B74186F4B26D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1210713026:0":{"text":"I'm sorry, but... I wanna live.","source_cn":"对不起，但是……我想活下去。","status":"matched","hash_xxh64":"0x802918DF8D3EFD29","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1210713027:0":{"text":"You said you'd die for me. You dirty liar! Go drown yourself!","source_cn":"你还说愿意为我死？！！你骗我！！！","status":"matched","hash_xxh64":"0x46E23856A1163679","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1210713028:0":{"text":"Ahahaha...! This kind of drama, no matter how many times I see it, never gets old.","source_cn":"啊哈哈哈……！这样的戏码，无论看多少次，都不会厌烦。","status":"matched","hash_xxh64":"0x116190EDA6C1ED77","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1210713029:0":{"text":"Is seawater really that delicious? Salty enough to keep tears from falling?","source_cn":"海水好喝吗？有没有苦到连眼泪都流不出来？","status":"matched","hash_xxh64":"0x9ECA1CC443AC5CE1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1210713030:0":{"text":"Wait... this is just seawater?","source_cn":"这、这只是海水？","status":"matched","hash_xxh64":"0xABF921BF20AB5A47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:49:1210713031:0":{"text":"We've been tricked?","source_cn":"我们被骗了？","status":"matched","hash_xxh64":"0x0DA7CB22E25812E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1210713032:0":{"text":"Hahaha! How could you be so naive to believe those sweet lies about dying for each other?","source_cn":"哈哈哈哈哈哈！谁让你们天真，居然相信什么愿意为你去死的谎话！","status":"matched","hash_xxh64":"0xBD0803DD2B095281","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:55:1210714001:":{"text":"Is someone eavesdropping on me?","source_cn":"喂……！偷听的，滚出来！","status":"matched","hash_xxh64":"0xE20C4133D5042AB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:59:1210715001:0":{"text":"Oh, it's just you. Do you enjoy slinking around in the shadows all the time? Ugh, you're so dark and gloomy! It ruins my mood.","source_cn":"啊，是你。你很喜欢偷听吗？","status":"matched","hash_xxh64":"0x3C517411FDC63387","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:60:1210715002:0":{"text":"Nara, are you wasting these two specimens?","source_cn":"奈拉，你浪费了两个材料。","status":"matched","hash_xxh64":"0x8DBB0A7EA4C71D0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:61:1210715003:0":{"text":"Hey! I caught these two with my own hands. I have the right to deal with them. The captain gave me that authority!","source_cn":"那两个家伙是我抓的，任我处置，船长说我有这个权利！","status":"matched","hash_xxh64":"0x3123D32DEE8B70FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:62:1210715004:0":{"text":"The day of reckoning is coming soon. The captain invested such precious power in you. I hope you do not disappoint him.","source_cn":"……决战日快到了，船长把那么珍贵的力量用在了你身上，别...","status":"matched","hash_xxh64":"0xD71967AFD3995192","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:63:1210715005:0":{"text":"Go back to the shadows and loom over someone else. I'm tired of your yapping.","source_cn":"真吵啊，这些话早都听腻了。","status":"matched","hash_xxh64":"0xE728BA3013531394","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:64:1210715006:0":{"text":"Hmm. I bet you're really scared of letting him down, aren't you?","source_cn":"我看是你……很害怕让他失望吧？","status":"matched","hash_xxh64":"0x86E62FD4F2B111B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:65:1210715007:0":{"text":"Such insolence!","source_cn":"真是无礼！","status":"matched","hash_xxh64":"0x0FFEFBE70716054B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:66:1210715008:0":{"text":"If it weren't for the captain's orders, I'd have taken your head off ten times over. Imagine it, dangling from a hook—such a delightful decoration!","source_cn":"要不是船长拦着，你的头早被我割下来十次了。串在钩索上会...","status":"matched","hash_xxh64":"0xC5471649283677E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:67:1210715009:0":{"text":"I've made my stance clear. Proceed as you wish.","source_cn":"够了。该提醒的我都提醒了，你好自为之。","status":"matched","hash_xxh64":"0x4E394BC5EA7770BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:68:1210715010:0":{"text":"Bye-bye! ...Ugh. I can't stand her.","source_cn":"啊哈哈，慢走！","status":"matched","hash_xxh64":"0xAF1C5E713267DA6B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:70:1210715011:0":{"text":"Now that's ruined my mood, I should go back to doing something fun! Back to my two little playthings... Let me think...","source_cn":"来人，把这两个人……我想想……","status":"matched","hash_xxh64":"0x70357E2E39BF2BF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:71:1210715012:0":{"text":"Oh, I know! Guard! Come put a noose around the man, and give the rope to the woman!","source_cn":"男的吊起来，绳子给女的。","status":"matched","hash_xxh64":"0x76722A21D16A9777","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:72:1210715013:0":{"text":"*Evil giggle* Seeing as you, good sir, just lied to this pretty lady, she's probably dying to kill you. I'll give her the rope that decides your fate. Let's see if she saves you. It'll be sooo interesting!","source_cn":"嘿！你刚骗了她，她恨不能杀了你。我把掌握你命运的绳子给...","status":"matched","hash_xxh64":"0x3C18754B4B5939FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:74:1210715014:0":{"text":"N-no! Wait! I'll die for sure, please!","source_cn":"不！别！我会死的——不要，不要！","status":"matched","hash_xxh64":"0x3095E8530D68DD43","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:75:1210715015:0":{"text":"Hahaha! Hearing you beg is so exhilarating. But why are you begging me? Shouldn't you be begging that little lady for your life?","source_cn":"哈哈哈哈……！求我，不如求她！","status":"matched","hash_xxh64":"0xCE10F73EC4577C96","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:76:1210715016:0":{"text":"Anyways... These two are no fun anymore. Let's find some other entertainment.","source_cn":"哈哈…这俩人没意思了，去找点别的乐子。","status":"matched","hash_xxh64":"0xAAD64771E0031853","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:80:1210714001:":{"text":"Is someone eavesdropping on me?","source_cn":"喂……！偷听的，滚出来！","status":"matched","hash_xxh64":"0xE20C4133D5042AB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:82:12010734:0":{"text":"Nara is sharp enough to catch someone eavesdropping. As you are gripped by anxiety, a female Graveborn walks up to Nara.","source_cn":"奈拉敏锐地发现了有人在偷听。正当你们心惊之际，另一个女...","status":"matched","hash_xxh64":"0xD3000DD2ED7C109A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:83:12010734:0":{"text":"Nara is sharp enough to catch someone eavesdropping. As you are gripped by anxiety, a female Graveborn walks up to Nara.","source_cn":"奈拉敏锐地发现了有人在偷听。正当你们心惊之际，另一个女...","status":"matched","hash_xxh64":"0xD3000DD2ED7C109A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:绝望的女人":{"text":"Upset Woman","source":"绝望的女人","status":"matched_dialogue_flow"},"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"},"speaker:崩溃的男人":{"text":"Broken Man","source":"崩溃的男人","status":"matched_dialogue_flow"},"speaker:半人半鬼的怪物":{"text":"Monster","source":"半人半鬼的怪物","status":"matched_dialogue_flow"},"speaker:神秘女亡灵":{"text":"Graveborn","source":"神秘女亡灵","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":61,"localized_text_count":52,"speaker_count":6}}