{"asset_key":"timeline/quest_story_15213560","episode":"timeline","category":"quest_story","story_id":"15213560","schema_version":1,"lang":"en","texts":{"say:2:1521356001:0":{"text":"Marco... we finally made it!","source_cn":"马尔科……我们终于可以在一起了！","status":"matched","hash_xxh64":"0x298554D9E4D004A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521356002:0":{"text":"You did it... I knew you would...","source_cn":"你做到了……我就知道你一定可以的……","status":"matched","hash_xxh64":"0xD9B0784846703CFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521356003:0":{"text":"Thank you for believing in me...","source_cn":"谢谢你相信我……","status":"matched","hash_xxh64":"0x663BC691313B541A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521356004:0":{"text":"Honestly, I was terrified. I kept thinking... if I died, would it break your heart?","source_cn":"我刚刚真的很害怕……害怕如果我真的死了，你也会难过……","status":"matched","hash_xxh64":"0x968D2634D59AFB65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521356005:0":{"text":"That wouldn't happen. Father is not a killer.","source_cn":"不会，阿爹才不会那么狠心。","status":"matched","hash_xxh64":"0xA33A549555379F70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521356006:0":{"text":"Come on, let me take you back to Mirehold so you can rest. When you're better, we'll find somewhere quiet, just for us.","source_cn":"我带你回水泽营地养伤吧。等到你养好了，我们找一个没人打...","status":"matched","hash_xxh64":"0xB2B8FE96EA41C743","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521356007:0":{"text":"Yeah... no one's going to stand in our way again.","source_cn":"好……不会再有任何人阻拦我们了。","status":"matched","hash_xxh64":"0xBE41A929D2B2804B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521356008:0":{"text":"We'll be together forever.","source_cn":"我们会永远在一起。","status":"matched","hash_xxh64":"0x06976AFE547FDB6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:15:15020256:0":{"text":"With Sharpjaw's blessing, Marco and Fufu are together at last.","source_cn":"马尔科获得了颚的认可，和芙终成眷属。","status":"matched","hash_xxh64":"0x5E89D2C14D526AEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:芙":{"text":"Fufu","source":"芙","status":"matched_dialogue_flow"},"speaker:马尔科":{"text":"Marco","source":"马尔科","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"