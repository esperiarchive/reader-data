{"asset_key":"timeline/quest_story_15206220","episode":"timeline","category":"quest_story","story_id":"15206220","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1520621001:":{"text":"Ho ho! I'm back with the candy!","source_cn":"哦呼！糖来了！马修来了！","status":"matched","hash_xxh64":"0x3EDD494416FB592F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1520621002:":{"text":"Eat and share our god's blessings!","source_cn":"——神的恩赐降临了！","status":"matched","hash_xxh64":"0xEAC975A635EA6073","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1520621003:":{"text":"Matthew!","source_cn":"马修叔叔！","status":"matched","hash_xxh64":"0xBCCAC2F26B7E3928","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1520621004:":{"text":"Candy! So yummy!","source_cn":"糖……好吃的糖！","status":"matched","hash_xxh64":"0x9C32B6700398C93A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1520622001:1":{"text":"So that's Matthew?\nHe seems... off.","source_cn":"那个人就是马修叔叔？\\n他看上去……不正常。","status":"matched","hash_xxh64":"0x3A07D8A79241F461","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1520622001":{"text":"So that's Matthew?\nHe seems... off.","source_cn":"那个人就是马修叔叔？\\n他看上去……不正常。","status":"matched","hash_xxh64":"0x3A07D8A79241F461","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1520622003:0":{"text":"<hpy>Ho ho! I'm back, my dears! And there's candy for everyone!!!</hpy>","source_cn":"<hpy>哈哈！呼呼！马修叔叔回来了，可爱的孩子们！还...","status":"matched","hash_xxh64":"0xC4573E968577CD96","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1520622004:0":{"text":"Hurray! Matthew, I want candy!","source_cn":"好耶！马修叔叔，我要吃糖！","status":"matched","hash_xxh64":"0xB3BDF4043B9E7A04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1520622005:0":{"text":"I want to play with the kitty again... Matthew, I want candy too!","source_cn":"我想再和小猫玩……马修叔叔，我要吃糖！","status":"matched","hash_xxh64":"0x5465B59C58034D08","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1520622006:0":{"text":"Now, now, don't be so hasty!\nDon't forget the rules for getting candy!","source_cn":"不要着急，不要着急！\\n——不要忘记领糖的规矩！","status":"matched","hash_xxh64":"0xB75A46F564D15377","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1520622007:0":{"text":"This is a gift from our god... You must <style=\"highlight\">first thank the God of Harvest</style> before you can have any!","source_cn":"甜蜜的糖果是丰饶神的恩赐……你们要<style=hig...","status":"matched","hash_xxh64":"0xC2DB83CA5F903015","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1520622008:0":{"text":"We know the rules!","source_cn":"我们记得！","status":"matched","hash_xxh64":"0x2E669B57E3088F38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1520622009:1":{"text":"O, God of Bountiful Harvests, give us grain and fruit for food...","source_cn":"无尽丰饶的神，您将麦穗和果实，赐给我们作食物……","status":"matched","hash_xxh64":"0x89AEEDC9630831FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1520622010:0":{"text":"You make the barren valleys bloom and lifeless limbs burst into leaf. Though your faithful may die, they shall rise again in the sweetness you provide!","source_cn":"您让麦谷生长，枯木生芽！您的信徒虽然死了，也会在您赐予...","status":"matched","hash_xxh64":"0x0DE1E0836CC9DE25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1520622011:0":{"text":"Good, good! Now take a piece of candy and rejoice!","source_cn":"哦呼！祷告完成！现在，接受神的恩赐，享用甜蜜吧！","status":"matched","hash_xxh64":"0x464F40CAF119890E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:19:1520622011":{"text":"Good, good! Now take a piece of candy and rejoice!","source_cn":"哦呼！祷告完成！现在，接受神的恩赐，享用甜蜜吧！","status":"matched","hash_xxh64":"0x464F40CAF119890E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:20:1520622012:0":{"text":"You and Gala dash out from behind the rock to grab Matthew.","source_cn":"你和加拉从巨石后跑出，准备抓住马修","status":"matched","hash_xxh64":"0x5164E9A8C871AB55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:21:1520622013:0":{"text":"But the moment you appear, Matthew's demeanor flips, and he starts screaming like a madman...","source_cn":"但你们刚一出现，马修就像变了个人似的，疯疯癫癫地尖叫起来——","status":"matched","hash_xxh64":"0xB82CA8D103681403","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:24:1520623001:":{"text":"You'll never take me alive!","source_cn":"不要抓我！","status":"matched","hash_xxh64":"0x02A9C07FAA16AF76","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:24:1520623003:":{"text":"Don't you touch Matthew!","source_cn":"坏人！不许抓马修叔叔！","status":"matched","hash_xxh64":"0x622335E2BDBDE211","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1520622016:0":{"text":"Wait... what is he saying?!","source_cn":"等……等等！","status":"matched","hash_xxh64":"0x1DC168FB6CD803FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:29:15022023:0":{"text":"Matthew panics at the sight of you and Gala and flees. You move to give chase, but angry children block your way.","source_cn":"马修被你和加拉的出现吓到了，慌张地逃跑了。你正准备追赶...","status":"matched_runtime_gender","hash_xxh64":"0xFE7075EFFEE1D497","variant_status":"runtime_gender_keys_target_same","male":"Matthew panics at the sight of you and Gala and flees. You move to give chase, but angry children block your way.","female":"Matthew panics at the sight of you and Gala and flees. You move to give chase, but angry children block your way.","variant_male_record_index":"192099","variant_female_record_index":"192100","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:0:1":{"text":"He's giving them more candy!","source_cn":"不好，他又要让那些孩子吃糖了！","status":"matched_runtime_gender","hash_xxh64":"0x7B0F07FEDBD2ADE2","variant_status":"runtime_gender_keys_target_same","male":"He's giving them more candy!","female":"He's giving them more candy!","variant_male_record_index":"77296","variant_female_record_index":"77297","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:1:2":{"text":"Stop him!","source_cn":"快拦住他！","status":"matched_runtime_gender","hash_xxh64":"0x0A417AE