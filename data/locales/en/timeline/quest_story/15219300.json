{"asset_key":"timeline/quest_story_15219300","episode":"timeline","category":"quest_story","story_id":"15219300","schema_version":1,"lang":"en","texts":{"say:1:1521930001:0":{"text":"So this is Halia? It's not quite like how Mom and Dad described it...","source_cn":"这里就是呼临城吗？和爸爸妈妈说的不太一样……","status":"matched","hash_xxh64":"0xE4DFAAD2FAA4E4A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1521930002:0":{"text":"Don't be scared, Renee. I'm right here.","source_cn":"蕾妮，不要怕。我在这里。","status":"matched","hash_xxh64":"0x5A7282E05AE1F1EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521930003:1":{"text":"Mm... As long as you're with me, Aunt Nanri, I'm not scared!","source_cn":"嗯……有南茜阿姨在，我不怕！","status":"matched","hash_xxh64":"0x4C3C4FB3D9BC0CF6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1521930003":{"text":"Mm... As long as you're with me, Aunt Nanri, I'm not scared!","source_cn":"嗯……有南茜阿姨在，我不怕！","status":"matched","hash_xxh64":"0x4C3C4FB3D9BC0CF6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521930005:1":{"text":"Thank you... Thank you for saving me.","source_cn":"谢谢你们……谢谢你们救了我。","status":"matched","hash_xxh64":"0xE37F6CA1E4A307FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521930006:0":{"text":"I'll take good care of Renee. She's the last hope of Tuttleton... and mine too.","source_cn":"我会一定会好好照顾好蕾妮……她是图塔镇的希望，也是我的希望。","status":"matched","hash_xxh64":"0x761537E1A4B989BB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521930007:0":{"text":"When she's older, I'll try to tell her everything about Tuttleton. Maybe one day... Tuttleton will return...","source_cn":"如果可以，等她长大以后，我会给她讲更多图塔镇的故事。也...","status":"matched","hash_xxh64":"0xA1664AA539EB60E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:10:1521931001:":{"text":"Do they grow wheat here, too?","source_cn":"这里也种麦子吗？","status":"matched","hash_xxh64":"0xAB690D759D5C92E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:10:1521931002:":{"text":"They used to...","source_cn":"嗯，以前也种……","status":"matched","hash_xxh64":"0x8716F41F88E55454","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:12:15021131:0":{"text":"Nanri takes Renee back to Halia to begin a new life...","source_cn":"南茜带着蕾妮回到呼临城，开始了她们的新生活……","status":"matched","hash_xxh64":"0x27C93D418D30D274","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"We'll leave you two here.","source_cn":"我们就送到这里了","status":"matched_runtime_gender","hash_xxh64":"0xFF7E5BDF57847506","variant_status":"runtime_gender_keys_target_same","male":"We'll leave you two here.","female":"We'll leave you two here.","variant_male_record_index":"78199","variant_female_record_index":"78200","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1521930004:0":{"text":"I understand... Don't worry. I won't go down that path again.","source_cn":"我明白……你们放心，我不会再做那种事了。","status":"matched","hash_xxh64":"0xB3EBFF59ADC43FC8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:1:2":{"text":"Nanri, from now on...","source_cn":"南茜，你以后……","status":"matched_runtime_gender","hash_xxh64":"0x699E779C5580F0FE","variant_status":"runtime_gender_keys_target_same","male":"Nanri, from now on...","female":"Nanri, from now on...","variant_male_record_index":"78201","variant_female_record_index":"78202","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:蕾妮":{"text":"Renee","source":"蕾妮","status":"matched_dialogue_flow"},"speaker:南茜":{"text":"Nanri","source":"南茜","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":18,"localized_text_count":13,"speaker_count":3}}