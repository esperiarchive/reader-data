{"asset_key":"timeline/quest_story_11110190","episode":"timeline","category":"quest_story","story_id":"11110190","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1111018001:":{"text":"Look around carefully!","source_cn":"都给我仔细找","status":"matched","hash_xxh64":"0x5C8C2C9C05F0E607","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1111018002:":{"text":"Take everything useful back to the main camp!","source_cn":"还能用的东西全带回主营去！","status":"matched","hash_xxh64":"0x60253762F164EE65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1111018003:":{"text":"Boys, we've got company.","source_cn":"瞧瞧，弟兄们，有人来了","status":"matched","hash_xxh64":"0x6F322A8214FF18AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1111018004:":{"text":"Walker, my old friend...","source_cn":"瓦尔克，我们的老熟人……","status":"matched","hash_xxh64":"0xE8407E7C217168C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111019001:1":{"text":"Look who we've stumbled upon! The hero of Alkali, the one who dared to take on the chief of the Quicksand Claws—bounty hunter extraordinaire, Walker!","source_cn":"看看谁来了？咸水镇的大英雄，曾经刺杀流沙之爪首领的赏金...","status":"matched","hash_xxh64":"0xAE41679E8FE5E293","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111019002:1":{"text":"Almost forgot. That assassination attempt didn't go quite as planned, did it? You barely dodged Ferranc's blade, am I right?","source_cn":"哦——对不起，我忘了，那次刺杀行动失败了，对吧？你从弗...","status":"matched","hash_xxh64":"0x407EEEBC986AB300","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1111019003:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111019004:1":{"text":"And your partner... What was his name again? White? Tiat?","source_cn":"你的搭档。我还记得他。怀特？还是提亚特？","status":"matched","hash_xxh64":"0xDE125151B8492592","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111019005:1":{"text":"Quite the odd pair, you two. Walker and Tiat, a human and a Mauler. There wasn't a job you guys couldn't handle for the right price...","source_cn":"奇怪的赏金猎人搭档，瓦尔克与提亚特，人类和蛮血，只要价...","status":"matched","hash_xxh64":"0x7487CCE177FB6692","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1111019005":{"text":"Quite the odd pair, you two. Walker and Tiat, a human and a Mauler. There wasn't a job you guys couldn't handle for the right price...","source_cn":"奇怪的赏金猎人搭档，瓦尔克与提亚特，人类和蛮血，只要价格合适，没有完不成的任务……","status":"matched","hash_xxh64":"0x7487CCE177FB6692","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111019006:1":{"text":"It's Wyatt.","source_cn":"他叫怀亚特。","status":"matched","hash_xxh64":"0xECBA0CAD6B278899","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111019007:1":{"text":"That's right, Wyatt! His new name! Remember that day? Bossman Ferranc put a bullet in his head out in the desert. How was the funeral?","source_cn":"哦，对，怀亚特！那是他的新名字！我记得弗兰克头儿在沙漠...","status":"matched","hash_xxh64":"0xCA7AA3314F5C9958","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1111019008:1":{"text":"Maulers don't shed tears for the weak. But what about you humans? Did ya cry your eyes out over his coffin?","source_cn":"蛮血不会为弱者哭泣，那你们人类呢？会对着棺材哀悼吗？","status":"matched","hash_xxh64":"0x48B4824B569EF0BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1111019009:1":{"text":"Shut your mouth.","source_cn":"闭嘴。","status":"matched","hash_xxh64":"0xB919F76B0D8C6BE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1111019010:1":{"text":"Ha! Another Mauler brat.","source_cn":"哈！又一个蛮血小子。","status":"matched","hash_xxh64":"0xB47536EA9A96EDC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1111019011:1":{"text":"So, Walker's recruited you to come after us for revenge?","source_cn":"搭档死了，瓦尔克想找我们复仇，就找上你了？","status":"matched","hash_xxh64":"0x65C94EC48998C18A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1111019012:1":{"text":"I'm not anyone's partner! Quit making up stories.","source_cn":"我、不是、任何人的搭档！别拿我和他混为一谈！","status":"matched","hash_xxh64":"0x34A2AB13F4CBE244","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1111019013:1":{"text":"Watch your tongue, Mauler punk. Your buddy here is leading you straight to hell.","source_cn":"蛮血小子，别不知好歹，你信任的同伴正在把你送上绝路呢。","status":"matched","hash_xxh64":"0x96B236D928038967","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1111019014:1":{"text":"He knows damn well how tough we are, yet he's still brought you here to challenge us. Aren't you scared of biting the dust?","source_cn":"他知道我们的厉害，所以才带着你来挑战我们，你就不怕陪他...","status":"matched","hash_xxh64":"0xA320DE712B3589A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1111019015:0":{"text":"I couldn't care less about his history.","source_cn":"瓦尔克的过去，我管不着。","status":"matched","hash_xxh64":"0x245EC046662687F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1111019016:1":{"text":"But you on the other hand are really getting on my nerves!","source_cn":"我只知道，你，让我很不爽！","status":"matched","hash_xxh64":"0x89F3CE9032292FE2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"Your ex-partner was a Mauler?","source_cn":"瓦尔克之前的搭档，是蛮血？","status":"matched_runtime_gender","hash_xxh64":"0x5FC1CD5F67E292AC","variant_status":"runtime_gender_keys_target_same","male":"Your ex-partner was a Mauler?","female":"Your ex-partner was a Mauler?","variant_male_record_index":"63894","variant_female_record_index":"63895","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"That name sounds familiar...","source_cn":"之前听过类似的名字……","status":"matched_runtime_gender","hash_xxh64":"0xA2025BCC868C934E","variant_status":"runtime_gender_keys_target_same","male":"That name sounds familiar...","female":"That name sounds familiar...","variant_male_record_index":"63896","variant_female_record_index":"63897","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:2:3":{"text":"I knew it wasn't just a gun.","source_cn":"我就猜到那不光是一把枪的名字","status":"matched_runtime_gender","hash_xxh64":"0xE5412E9D214524DD","variant_status":"runtime_gender_keys_target_same","male":"I knew it wasn't just a gun.","female":"I knew it wasn't just a gun.","variant_male_record_index":"63898","variant_female_record_index":"63899","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:24:11010110:0":{"text":"The raiders of the caravan are indeed a group of Quicksand Claws. They seem to know Walker.","source_cn":"劫掠商队的果然是一群流沙之爪。他们似乎认识瓦尔克。","status":"matched","hash_xxh64":"0x62A95DF8D06975BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:鬣心":{"text":"Lionheart","source":"鬣心","status":"matched_dialogue_flow"},"speaker:瓦尔克":{"text":"Walker","source":"瓦尔克","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":30,"localized_text_count":25,"speaker_count":4}}