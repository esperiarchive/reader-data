{"asset_key":"timeline/quest_story_13224400","episode":"timeline","category":"quest_story","story_id":"13224400","schema_version":1,"lang":"en","texts":{"say:1:1322440001:1":{"text":"We've lived on this land our entire lives and have never known true happiness. Cold, hunger, and poverty have always been with us!","source_cn":"我们生在这片土地上从来没有真正幸福过，寒冷，饥饿，贫穷...","status":"matched","hash_xxh64":"0xBEB9D342ECE3F8C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322440002:0":{"text":"And when we suffer, where's Dura? Have you ever wondered, like I do, if she's ever cared at all? She's not our goddess!","source_cn":"我们受苦的时候艾雅在哪里？你是否跟我一样怀疑过艾雅从未...","status":"matched","hash_xxh64":"0x0DF816A38AFC5C8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322440003:1":{"text":"Praise the true almighty god, the only one who can truly guide us!","source_cn":"赞美伟大真神，只有伟大意志才会指引我们！","status":"matched","hash_xxh64":"0x6C26530C87842B45","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322440004:1":{"text":"Praise the true god!","source_cn":"赞美伟大真神！","status":"matched","hash_xxh64":"0x95674434202EEFA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:9:1322439001:":{"text":"You feel weak...","source_cn":"你们感到虚弱","status":"matched","hash_xxh64":"0x6ADAE30D80F645C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:9:1322439002:":{"text":"That's because you're just flesh and bone.","source_cn":"因为你们是肉体凡躯！","status":"matched","hash_xxh64":"0x5771BDF45720833F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:9:1322439003:":{"text":"The true almighty god!","source_cn":"信仰伟大真神！","status":"matched","hash_xxh64":"0x108880FC5F5E0FF7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:9:1322439004:":{"text":"Lead us to salvation!","source_cn":"引渡我们的灵魂！","status":"matched","hash_xxh64":"0x561228FB3FEEBEE2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1322440005:1":{"text":"Sir, we've caught a heretic. What should we do with her?","source_cn":"引导者大人，我们抓到了一位异教徒，该如何处置？","status":"matched","hash_xxh64":"0x71228625164ABA00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1322440006:1":{"text":"Quit calling them that. There's no such thing as a heretic. They're just lost, that's all.","source_cn":"别这样说，根本不存在什么异教徒，他们只是短暂的迷失了方...","status":"matched","hash_xxh64":"0x9598E659B398D020","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1322440007:1":{"text":"Look at me, child. What do you need? What can I do for you?","source_cn":"看着我，孩子，我能帮助你做些什么吗？","status":"matched","hash_xxh64":"0x5B6CAEB8F64971B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1322440008:1":{"text":"I... I'm looking for someone...","source_cn":"我……我……捉、找人……","status":"matched","hash_xxh64":"0x26F201471EE1E323","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1322440009:1":{"text":"Looking for someone? You better not be looking for trouble.","source_cn":"你说什么？捉人？难道是来找事的？！","status":"matched","hash_xxh64":"0x43902165FDD3C2E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1322440010:1":{"text":"Take it easy. She's just having trouble speaking.","source_cn":"冷静，她只是口齿不清罢了。","status":"matched","hash_xxh64":"0x9DEFCE758CF9D4F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1322440011:1":{"text":"I'm looking for... Lev...","source_cn":"找……找列夫哥哥……","status":"matched","hash_xxh64":"0xA790A1E245827B5F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1322440012:1":{"text":"You're looking for Lev? Ha! You must be Irina, then!","source_cn":"你的意思是，来找列夫的吗？哈！原来你就是伊琳娜是吗！","status":"matched","hash_xxh64":"0xE1B60AB47C534BC7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1322440013:1":{"text":"You know... him...?","source_cn":"你认识……列夫哥哥？","status":"matched","hash_xxh64":"0xF49F021DF111A8B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1322440014:1":{"text":"Of course, I know him. Lev's a drifter. He used to be a minstrel. Got his leg injured out in the cold, and now he'll never walk properly again.","source_cn":"当然孩子，当然。列夫是个流浪汉，对吗？他原本是个吟游诗...","status":"matched","hash_xxh64":"0xCD95C98568DCBFA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1322440015:1":{"text":"Poor guy... When I first met him, I thought he was looking to get his leg fixed. But then he said, without hesitation, that he wanted to help you with your speech.","source_cn":"真是个可怜人……我第一次见到他，还一位他的愿望是治好自...","status":"matched","hash_xxh64":"0xF7472271CAEABED6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1322440016:1":{"text":"Lev... *Sniffle*","source_cn":"列夫……哥哥……","status":"matched","hash_xxh64":"0x24402C56A835FCF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1322440017:1":{"text":"What a selfless man. The true almighty god answered his prayer and took him to paradise!","source_cn":"多么善良无私的人啊，伟大真神已经回应了列夫！将他带到了乐园！","status":"matched","hash_xxh64":"0x93440C4BADDDD960","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1322440018:1":{"text":"But father, her speech... it's still not healed...","source_cn":"神父，但这女孩的口疾也没好不是吗……","status":"matched","hash_xxh64":"0x41E1F8FA51F39E5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1322440019:1":{"text":"Yeah. So, where's Lev now?","source_cn":"是啊，所以列夫去哪了？","status":"matched","hash_xxh64":"0x729D7126B57A58B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1322440020:1":{"text":"Oh, you lost souls... You stand here among miracles, and you don't even see them.","source_cn":"迷途的人啊……你们身在神迹中，却不知神迹已经发生着。","status":"matched","hash_xxh64":"0x67E78FD996CA9BDD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1322440021:1":{"text":"Have you thought about why she's here? She's been sent to us by the Great Will. Her speech will be healed in the ritual!","source_cn":"你们有没有想过她为什么会出现这？这一切都是伟大意志的调...","status":"matched","hash_xxh64":"0xE81ED3D8420A221B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1322440022:1":{"text":"Praise the Great Will!","source_cn":"赞美伟大意志！","status":"matched","hash_xxh64":"0x2D629139474B9343","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1322440023:1":{"text":"Praise the true god!","source_cn":"赞美伟大真神！","status":"matched","hash_xxh64":"0x95674434202EEFA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1322440024:1":{"text":"Now listen, child. As promised, I need to invite you to the ritual. Will you come?","source_cn":"孩子，按照约定，我必须邀请你参加祭祀，你愿意来吗？","status":"matched","hash_xxh64":"0xF2CFF2BA869BCE0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1322440025:1":{"text":"I... I just want my best friend. I don't want any... ritual.","source_cn":"我……要列夫哥哥，不要……祭祀。","status":"matched","hash_xxh64":"0x8F66C14994DA0BF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1322440026:1":{"text":"To heal you, your friend Lev passed his test and went to paradise. Do you really want all the suffering he went through to be in vain?","source_cn":"孩子，为了能治好你的病，你的列夫哥哥已经完成了考验，前...","status":"matched","hash_xxh64":"0x998B260540EE2DF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1322440027:1":{"text":"Paradise...?","source_cn":"乐园……？","status":"matched","hash_xxh64":"0xC2A7D45BAFCF644B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1322440028:1":{"text":"Yes! It's a place with no cold, no poverty. A warm and bountiful land, a true paradise!","source_cn":"是的！那是一个没有寒冷贫穷，一个温暖富饶的地方，是真正...","status":"matched","hash_xxh64":"0x6D40BDA9A2224B40","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1322440029:1":{"text":"All you have to do is believe in the Great Will, and you'll be guided there. You'll be chosen to live in paradise!","source_cn":"只要虔诚地信仰伟大意志，得到伟大意志的引渡，你们都会成...","status":"matched","hash_xxh64":"0x4552BA1B3CF1CCD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1322440030:1":{"text":"And you, my dear Irina, will be reunited with your dear friend there!","source_cn":"而你，我的孩子伊琳娜，你会与你的列夫哥哥在乐园团聚！","status":"matched","hash_xxh64":"0xC54BAC9CAE9696FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1322440031:1":{"text":"Brothers and sisters, in just a few days, the foretold time will come! We'll be waiting in the Duskmire Forest to welcome all who truly believe!","source_cn":"诸位信众，再过几天便是神的伟大时日！我们将在黑沼森林恭...","status":"matched","hash_xxh64":"0x3D796548A0034E13","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:43:13052415:0":{"text":"As the cult leader preaches to the villagers, one of the cultists brings Irina to stand at his side.","source_cn":"邪教首领向镇民们传教时，一位邪教徒将伊琳娜带到了他的旁边。","status":"matched","hash_xxh64":"0x73E3F67CA0A2C463","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:兹比格涅夫":{"text":"Zaneus","source":"兹比格涅夫","status":"matched_dialogue_flow"},"speaker:癫狂的镇民":{"text":"Deranged Citizen","source":"癫狂的镇民","status":"matched_dialogue_flow"},"speaker:神志不清的镇民":{"text":"Delirious Citizen","source":"神志不清的镇民","status":"matched_dialogue_flow"},"speaker:邪教徒守卫":{"text":"Cultist Guard","source":"邪教徒守卫","status":"matched_dialogue_flow"},"speaker:伊琳娜":{"text":"Irina","source":"伊琳娜","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":41,"localized_text_count":36,"speaker_count":6}}