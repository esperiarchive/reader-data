ument_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"Lord Progenitor?","source_cn":"吸血鬼始祖？","status":"matched_runtime_gender","hash_xxh64":"0xC7B4B042E8CC6B04","variant_status":"runtime_gender_keys_target_same","male":"Lord Progenitor?","female":"Lord Progenitor?","variant_male_record_index":"95510","variant_female_record_index":"95511","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"Mr. Mortimer?","source_cn":"莫蒂默先生？","status":"matched_runtime_gender","hash_xxh64":"0x4C5065B05EFB4ACA","variant_status":"runtime_gender_keys_target_same","male":"Mr. Mortimer?","female":"Mr. Mortimer?","variant_male_record_index":"95512","variant_female_record_index":"95513","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:2:3":{"text":"Is it true that you know the God of Death personally?","source_cn":"听说你也认识死神？","status":"matched_runtime_gender","hash_xxh64":"0x7C1C752A5022E1D3","variant_status":"runtime_gender_keys_target_same","male":"Is it true that you know the God of Death personally?","female":"Is it true that you know the God of Death personally?","variant_male_record_index":"95514","variant_female_record_index":"95515","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1826062009":{"text":"Enough. I shall waste no more breath chastising you... Make haste with your recovery, then <style=\"highlight\">purge the outskirts of the Bantus filth</style>.","source_cn":"算了，指责你你也不会听……你还是快些恢复，去<style=highlight>清理聚在城外的班题斯虫豸</style>吧。","status":"matched","hash_xxh64":"0x985CF4085F43BC60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_st