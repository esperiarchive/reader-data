cument_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:0:1":{"text":"班题斯军队已经在城外了？","source_cn":"班题斯军队已经在城外了？","status":"target_text_empty","hash_xxh64":"0x65ABC6C1F9CEDB99","variant_status":"runtime_gender_keys_target_same","male":"","female":"","variant_male_record_index":"94815","variant_female_record_index":"94816","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:1:2":{"text":"可恶！他们想趁虚而入！","source_cn":"可恶！他们想趁虚而入！","status":"target_text_empty","hash_xxh64":"0xA681899EB7D14117","variant_status":"runtime_gender_keys_target_same","male":"","female":"","variant_male_record_index":"94817","variant_female_record_index":"94818","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:2:3":{"text":"不对啊，他们没有正当理由强攻","source_cn":"不对啊，他们没有正当理由强攻","status":"target_text_empty","hash_xxh64":"0x4D1A44A00CD2EDD4","variant_status":"runtime_gender_keys_target_same","male":"","female":"","variant_male_record_index":"94819","variant_female_record_index":"94820","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"吸血鬼始祖？","source_cn":"吸血鬼始祖？","status":"target_text_empty","hash_xxh64":"0xC7B4B042E8CC6B04","variant_status":"runtime_gender_keys_target_same","male":"","female":"","variant_male_record_index":"94809","variant_female_record_index":"94810","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"莫蒂默先生？","source_cn":"莫蒂默先生？","status":"target_text_empty","hash_xxh64":"0x4C5065B05EFB4ACA","variant_status":"runtime_gender_keys_target_same","male":"","female":"","variant_male_record_index":"94811","variant_female_record_index":"94812","document_title":"","document_title_male":"","document_title_female":"","docu