{"asset_key":"timeline/quest_story_18208050","episode":"timeline","category":"quest_story","story_id":"18208050","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:3:1820804001:":{"text":"I think... I'm about to...","source_cn":"我……已经快要……","status":"matched","hash_xxh64":"0x7387869CE6F43F67","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1820804002:":{"text":"Please, just hang in there!","source_cn":"再坚持一下！求你了！","status":"matched","hash_xxh64":"0x20F72F3D060B64DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1820805001:1":{"text":"Baba Muriel tried it again yesterday. She's close to getting it right!","source_cn":"坚持住啊！穆婆婆昨天又试了一次，她就快成功了！","status":"matched","hash_xxh64":"0x915FE79820A3AF3E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1820805002:0":{"text":"Everything will be all right once she moves your soul into a new body! She sent me here to ask what kind of body you'd prefer, so tell me!","source_cn":"等她帮你把灵魂转移到其他躯体上，你就不会忘记自己了！她...","status":"matched","hash_xxh64":"0x1D45C5714A5C6A55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1820805003:0":{"text":"No... Just go, Bessie. I'm done for...","source_cn":"不……你走吧，蓓丝安。我已经……没救了……","status":"matched","hash_xxh64":"0x59532B134B385047","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1820805004:0":{"text":"No, I'm staying! At least I can keep you company!","source_cn":"不行！我要留在这！至少能陪你说说话！","status":"matched","hash_xxh64":"0x08DC7FA36E0DC122","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1820805005:0":{"text":"Bessie... take good care of our <style=\"highlight\">token</style>. Maybe... someday, it'll be the only thing I can still recognize.","source_cn":"蓓丝安……好好保管我们两人的<style=highli...","status":"matched","hash_xxh64":"0xDDB5E3380057C7F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1820805006:0":{"text":"Go now, before I become... ugh, I don't want to hurt you!","source_cn":"快走吧，否则我很快又要……呜，我不想伤害你！","status":"matched","hash_xxh64":"0xD83C3CF29CBCD110","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1820805007:0":{"text":"Oh, Hilda...","source_cn":"哦，希尔达……","status":"matched","hash_xxh64":"0xEB08CE06622571C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:14:18020814:0":{"text":"You hear the strange figure speaking with a muffled voice.","source_cn":"你们听见奇异的身影在与一个模糊的声音对话。","stat