{"asset_key":"timeline/quest_story_17217090","episode":"timeline","category":"quest_story","story_id":"17217090","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1721708001:":{"text":"You're all dismissed.","source_cn":"其他人先行退下吧","status":"matched","hash_xxh64":"0xE4EDF02F808163BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1721708002:":{"text":"I need to speak with Commander Hendrik in private.","source_cn":"我与亨德里克卿有事相谈","status":"matched","hash_xxh64":"0x3F83B9033FF8F864","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1721708003:":{"text":"Yes, Your Highness!","source_cn":"是！<key:dialog67>","status":"matched","hash_xxh64":"0xD7C3D2F2D0F425F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1721708005:":{"text":"Yes, Your Highness!","source_cn":"是！<key:dialog8>","status":"matched","hash_xxh64":"0xB38242E392B111CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1721708004:":{"text":"Yes, Your Highness!","source_cn":"是！<key:dialog7>","status":"matched","hash_xxh64":"0xBA80ED37F21F2D72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1721708006:":{"text":"Yes, Your Highness!","source_cn":"是！<key:dialog15>","status":"matched","hash_xxh64":"0xBC3FA42F3F28093C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1721709001:0":{"text":"Your Highness, pardon my unannounced visit. There are matters I must inquire of you in person.","source_cn":"殿下，冒昧前来，是因为有些话，我必须当面问清楚。","status":"matched","hash_xxh64":"0x706ECEC5119FEA84","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1721709002:0":{"text":"May I ask... what you and Magister Cyran did in the Hall of Ancients on the day it disappeared?","source_cn":"圣古堂失踪的那天……您和迪尔格雷首席，在里面做了什么？","status":"matched","hash_xxh64":"0xB99A02FD25C4A415","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1721709003:0":{"text":"Commander Hendrik, we simply paid our respects to my ancestors that day. Is there a problem with that?","source_cn":"亨德里克卿，我不明白你的意思。那天我和首席只是祭拜了大...","status":"matched","hash_xxh64":"0x60F2A134A80B848B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1721709004:0":{"text":"The chapel vanished along with Princess Peggy right after you left. That can't be a mere coincidence!","source_cn":"这就是最大的问题。您前脚刚离开，后脚佩吉殿下进去就出了...","status":"matched","hash_xxh64":"0xAE26C21A4DF44F82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1721709005:0":{"text":"... Your Highness, I've known you since you were young. You have a good heart.","source_cn":"……殿下，我看着您长大，我知道您本性纯良。","status":"matched","hash_xxh64":"0xBFFAC56087C499B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1721709006:0":{"text":"But Cyran... he's been close with House Hastings and a handful of scheming nobles. It's no secret at court.","source_cn":"但是迪尔格雷……那个老家伙跟黑斯廷斯家族，还有几个不安...","status":"matched","hash_xxh64":"0x3183BB942FECAA75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1721709007:0":{"text":"Could they have exploited your trust to serve their own ends?","source_cn":"不是他们利用您的信任，在圣古堂里动了什么手脚，甚至……...","status":"matched","hash_xxh64":"0xB1984DEEF47B604D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1721709008:0":{"text":"You're making baseless conjectures, Commander Hendrik...","source_cn":"亨德里克卿，你的想象力很丰富。竟然有这种无端的猜测……","status":"matched","hash_xxh64":"0xA198BC46B905DFF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1721709009:0":{"text":"As Commander of the Royal Guard, it is unwise of you to accuse the chief court mage and House Hastings without evidence.","source_cn":"作为守备军司令，在这没有证据的情况下指控宫廷首席魔法师...","status":"matched","hash_xxh64":"0x0B12E011F410EF56","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1721709010:0":{"text":"... Your Highness, our investigation has traced the matter to Silken Snare in the upper district. Its owner, Voracia...","source_cn":"……殿下，现有调查已经追溯到了上城区的丝绒陷阱。那个名...","status":"matched","hash_xxh64":"0xAFA4767D76AB0511","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1721709011:0":{"text":"She was invited to Savannah to open her restaurant by <style=\"highlight\">Marquis Gervais</style>, the head of House Hastings.","source_cn":"她是当初被<style=highlight>嘉德侯爵<...","status":"matched","hash_xxh64":"0x22779290FCB896AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1721709012:0":{"text":"House Hastings, Voracia, and Cyran... They've cast their net far and wide.","source_cn":"黑斯廷斯家族、法蒂玛、迪尔格雷……这张网已经织得够大了。","status":"matched","hash_xxh64":"0x84987E8EB8B2F02D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1721709013:0":{"text":"Your Highness, whatever you're trying to do, it's not too late to turn back now!","source_cn":"殿下，不管您是为了什么目的，或者受了谁的蒙蔽，现在收手...","status":"matched","hash_xxh64":"0xDCE7650396BACF72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1721709014:0":{"text":"If things go too far, I'm afraid I can't speak in your defense before His Majesty!","source_cn":"如果真的闹到不可收拾的地步，就算是我，也没法在陛下面前...","status":"matched","hash_xxh64":"0xAC94AAFE0B33DE86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1721709015:0":{"text":"Speak in my defense? Commander Hendrik, I think you're mistaken. I'm the future king of the Lightbearer Empire. I don't need anyone's \"protection\".","source_cn":"保全我？亨德里克卿，您似乎搞错了一件事。我是耀光的王储...","status":"matched","hash_xxh64":"0xDA97AF264135E200","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1721709016:0":{"text":"It seems that the investigation has worn you down, so much so that it's clouding your judgment...","source_cn":"看来，最近这一连串的事情，确实让您太累了。累到让您开始...","status":"matched","hash_xxh64":"0x69219C70FF92E2A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1721709017:0":{"text":"You should rest. I hereby excuse you from escorting me at today's royal hunt.","source_cn":"既然您的心思已经不在守备军的正事上，那么，今日的皇家行...","status":"matched","hash_xxh64":"0x1DDA1D02FCDD1AF7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1721709018:0":{"text":"I'll assign someone else to handle security.","source_cn":"我会安排人手接手防务。亨德里克卿，您还是留在驻地，好好...","status":"matched","hash_xxh64":"0x8B01D2D0204BAA0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1721709019:0":{"text":"Your Highness...","source_cn":"殿下……<key:dialog3>","status":"matched","hash_xxh64":"0x452E33441BD7A9BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1721709020:0":{"text":"This is an order, Commander Hendrik. You are dismissed.","source_cn":"这是命令，亨德里克司令。退下吧。","status":"matched","hash_xxh64":"0x6D578C9E60991EA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1721709021:0":{"text":"... As you command. I hope... you won't come to regret this.","source_cn":"……遵命。希望您……好自为之。","status":"matched","hash_xxh64":"0x8A3394CBFF03BE5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:26:17021714:0":{"text":"Orion and Hendrik send the others away. It seems they have something important to discuss.","source_cn":"奥利安与亨德里克屏退众人，似乎要商量什么要事。","status":"matched","hash_xxh64":"0xCB34CBC9D455E2BB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:奥利安":{"text":"Orion","source":"奥利安","status":"matched_dialogue_flow"},"speaker:守备军1":{"text":"守备军1","source":"守备军1","status":"source"},"speaker:守备军3":{"text":"守备军3","source":"守备军3","status":"source"},"speaker:守备军2":{"text":"守备军2","source":"守备军2","status":"source"},"speaker:守备军4":{"text":"守备军4","source":"守备军4","status":"source"},"speaker:亨德里克":{"text":"Hendrik","source":"亨德里克","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":33,"localized_text_count":28,"speaker_count":7}}