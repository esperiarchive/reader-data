{"asset_key":"timeline/quest_story_12103060","episode":"timeline","category":"quest_story","story_id":"12103060","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1210304001:":{"text":"Take this!","source_cn":"瞧着！","status":"matched","hash_xxh64":"0x8F7917805DD0C9C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1210304002:":{"text":"What?","source_cn":"咦——？！","status":"matched","hash_xxh64":"0xC4544A690899D375","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1210304003:":{"text":"Ugh...! No!","source_cn":"呃……唔……<key:dialog2>","status":"matched","hash_xxh64":"0xC736E8564AD94ED9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1210304004:":{"text":"Tie them up and take them away","source_cn":"捆起来，都带走","status":"matched","hash_xxh64":"0x4355D4E3CBE83757","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:5:1210305002:":{"text":"*Muffled sounds*","source_cn":"唔——！","status":"matched","hash_xxh64":"0x74E3A9E7447E372C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:5:1210305001:":{"text":"*Muffled sounds*","source_cn":"唔唔！","status":"matched","hash_xxh64":"0x2DE20CAE70393E91","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:5:1210305003:":{"text":"He's awake.","source_cn":"老大，<male>他</male><female>她</female>醒了","status":"matched_runtime_gender","hash_xxh64":"0xF009D6C63ADCC110","variant_status":"runtime_gender_keys_target_differs","male":"He's awake.","female":"She's awake.","variant_male_record_index":"129395","variant_female_record_index":"129396","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210306001:0":{"text":"So, Water Wight, tell me your name.","source_cn":"水鬼帮的，报上名来。","status":"matched_runtime_gender","hash_xxh64":"0x735AEF8A18B4693D","variant_status":"runtime_gender_keys_target_same","male":"So, Water Wight, tell me your name.","female":"So, Water Wight, tell me your name.","variant_male_record_index":"129397","variant_female_record_index":"129398","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1210306001":{"text":"So, Water Wight, tell me your name.","source_cn":"水鬼帮的，报上名来。","status":"matched_runtime_gender","hash_xxh64":"0x735AEF8A18B4693D","variant_status":"runtime_gender_keys_target_same","male":"So, Water Wight, tell me your name.","female":"So, Water Wight, tell me your name.","variant_male_record_index":"129397","variant_female_record_index":"129398","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1210306002:0":{"text":"Lucca, bring what we found.","source_cn":"卢卡，把东西拿上来。","status":"matched","hash_xxh64":"0x5D09B3FF83BC5F5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210306003:0":{"text":"Understood.","source_cn":"是。","status":"matched","hash_xxh64":"0x485CFF86C2310EED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:13::0":{"text":"A tattered banner featuring bones and sharp claws.","source_cn":"画着骨头和利爪的破旧旗帜","status":"matched","hash_xxh64":"0x596E97F5296A42B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210306004:0":{"text":"This is the sail from the boat we were using.","source_cn":"——那是我们找到的船上的旗子！","status":"matched","hash_xxh64":"0xA9D1F64846B73206","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1210306005:0":{"text":"It's the<style=\"highlight\"> flag of the Water Wights</style>.","source_cn":"这是<style=highlight>水鬼帮的旗帜</...","status":"matched","hash_xxh64":"0xC88ECC8A7210CECF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1210306006:1":{"text":"You came to Rustport on a Water Wight boat and injured our patrol team at the lumberyard. Do you have anything else to say?","source_cn":"你们乘着水鬼帮的船来到锈锚港，又在伐木场打伤了我们的巡...","status":"matched","hash_xxh64":"0x63E37A3F4BAC2CBD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:19:1210306006":{"text":"You came to Rustport on a Water Wight boat and injured our patrol team at the lumberyard. Do you have anything else to say?","source_cn":"你们乘着水鬼帮的船来到锈锚港，又在伐木场打伤了我们的巡查队。还有什么想说的？","status":"matched","hash_xxh64":"0x63E37A3F4BAC2CBD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1210306007:1":{"text":"Every Wight we catch always says the same thing. You're smart enough to know that begging for mercy is useless at this point.","source_cn":"每一个被抓住的水鬼都这么说。但聪明的人应该知道，这时候...","status":"matched","hash_xxh64":"0x9F123E999E094708","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1210306008:1":{"text":"Give up your accomplices and tell us why you're in Rustport, and we'll take it easy on you.","source_cn":"供出你的同伙，说出你们潜入锈锚港的目的，或许你能少受点罪。","status":"matched","hash_xxh64":"0x6A4EB569C210C28A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1210306009:1":{"text":"Don't want to tell me? Most Water Wights aren't as stubborn as you.","source_cn":"……不说吗？水鬼帮倒是少见你这样的倔骨头。","status":"matched","hash_xxh64":"0xCF48A65E2F22F513","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1210306010:1":{"text":"Lucca, rip the tongues off those rodents.","source_cn":"卢卡，撬开那两只小老鼠的嘴。","status":"matched","hash_xxh64":"0xAE3299626B700184","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:24:1210306010":{"text":"Lucca, rip the tongues off those rodents.","source_cn":"卢卡，撬开那两只小老鼠的嘴。","status":"matched","hash_xxh64":"0xAE3299626B700184","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1210306011:0":{"text":"Smart.","source_cn":"聪明人。","status":"matched_runtime_gender","hash_xxh64":"0xD4EB4C1A6A8B950C","variant_status":"runtime_gender_keys_target_same","male":"Smart.","female":"Smart.","variant_male_record_index":"129408","variant_female_record_index":"129409","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:26:1210306011":{"text":"Smart.","source_cn":"聪明人。","status":"matched_runtime_gender","hash_xxh64":"0xD4EB4C1A6A8B950C","variant_status":"runtime_gender_keys_target_same","male":"Smart.","female":"Smart.","variant_male_record_index":"129408","variant_female_record_index":"129409","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1210306012:0":{"text":"*Muffled sounds*","source_cn":"——唔唔唔！！！","status":"matched","hash_xxh64":"0xDB4B6BCFF2E4E76B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1210306013:0":{"text":"Lucca, remove the cloth from their mouths.","source_cn":"卢卡，把他们嘴里的布拿开。","status":"matched","hash_xxh64":"0xAB8B963EB8A0B365","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1210306014:0":{"text":"We're not Water Wights! Sinbad can attest to that!","source_cn":"我们真的不是水鬼，辛巴达——辛巴达能证明！","status":"matched","hash_xxh64":"0x234B2C23B5F01BE6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1210306015:0":{"text":"He saved us at the beach, took us to Bols' inn, and told us where to go fishing. He knows everything we did the last few days.","source_cn":"他在海岸边救了我们，给我们介绍了旅店，又指了钓鱼的方向...","status":"matched","hash_xxh64":"0xDE62EE87EFC729BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1210306016:1":{"text":"Sinbad?","source_cn":"辛巴达？","status":"matched","hash_xxh64":"0x7BA3A0CDA1260507","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1210306017:1":{"text":"It's that fish-brained urchin with the scar on his face. He's the one who recommended <style=\"highlight\">Hugin</style>.","source_cn":"那个脸上有疤的轻浮小子，<style=highligh...","status":"matched","hash_xxh64":"0xE8311FAE866A7121","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1210306018:0":{"text":"You can't trust anyone in Rustport, especially him.","source_cn":"哼，锈锚港谁的话都不能信，尤其是他。","status":"matched","hash_xxh64":"0x59F17AD0CBCEE55B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1210306019:1":{"text":"Alright, keep talking. The information you provide will decide your fate.","source_cn":"好了，继续交代。根据供出的情报，我会决定你的下场。","status":"matched","hash_xxh64":"0xEFFD1E83073F2FAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:40:1210306019":{"text":"Alright, keep talking. The information you provide will decide your fate.","source_cn":"好了，继续交代。根据供出的情报，我会决定你的下场。","status":"matched","hash_xxh64":"0xEFFD1E83073F2FAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1210306020:1":{"text":"Merlin...? Who's Merlin?","source_cn":"……梅林？梅林是谁？","status":"matched_runtime_gender","hash_xxh64":"0x4070F4924F5A9B49","variant_status":"runtime_gender_keys_target_same","male":"Merlin...? Who's Merlin?","female":"Merlin...? Who's Merlin?","variant_male_record_index":"129418","variant_female_record_index":"129419","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1210306021:0":{"text":"Haven't you ever heard of Merlin? He's the greatest mage alive. Also, show some respect and address him as Magister Merlin.","source_cn":"你们、你们完全没听说过吗？梅林是最伟大的魔法师！你们应...","status":"matched_runtime_gender","hash_xxh64":"0xAE42797E5100153E","variant_status":"runtime_gender_keys_target_differs","male":"Haven't you ever heard of Merlin? He's the greatest mage alive. Also, show some respect and address him as Magister Merlin.","female":"Haven't you ever heard of Merlin? She's the greatest mage alive. Also, show some respect and address her as Magister Merlin.","variant_male_record_index":"129420","variant_female_record_index":"129421","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1210306022:1":{"text":"A mage?","source_cn":"魔法师……？","status":"matched_runtime_gender","hash_xxh64":"0x73E3D41115384ECF","variant_status":"runtime_gender_keys_target_same","male":"A mage?","female":"A mage?","variant_male_record_index":"129422","variant_female_record_index":"129423","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1210306023:1":{"text":"Isn't Rustport still a part of the Lightbearer Empire? How have you never heard of Magister Merlin?! I'm sorry to say this, but you are truly ill-informed.","source_cn":"这里明明是耀光帝国的管辖地，你们竟然没听过梅林的名字？...","status":"matched_runtime_gender","hash_xxh64":"0x51F3613DF5F681B1","variant_status":"runtime_gender_keys_target_same","male":"Isn't Rustport still a part of the Lightbearer Empire? How have you never heard of Magister Merlin?! I'm sorry to say this, but you are truly ill-informed.","female":"Isn't Rustport still a part of the Lightbearer Empire? How have you never heard of Magister Merlin?! I'm sorry to say this, but you are truly ill-informed.","variant_male_record_index":"129424","variant_female_record_index":"129425","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1210306024:1":{"text":"What nonsense.","source_cn":"……胡言乱语。","status":"matched","hash_xxh64":"0x9987DA891F12606F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1210306025:1":{"text":"Since you're unwilling to tell the truth, I'll have Lucca deal with you.","source_cn":"既然不愿意说实话，卢卡，把他们处理了。","status":"matched","hash_xxh64":"0x01F212F64504F68E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1210306026:0":{"text":"Understood.","source_cn":"是。","status":"matched","hash_xxh64":"0xDE105F7A02D04B84","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:52:1210306027:1":{"text":"Excuse me...","source_cn":"咳咳——","status":"matched","hash_xxh64":"0x754DEFEB1C284AD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:53:1210306028:1":{"text":"Father...","source_cn":"……父亲？","status":"matched","hash_xxh64":"0xC9B9C1DB084A12CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:54:1210306029:1":{"text":"Sonja, these people might be useful. We should not waste resources at a time like this.","source_cn":"索尼娅，现在我们正是要用人的时候。别浪费资源。","status":"matched","hash_xxh64":"0x786F498D6401C7B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:55:1210306030:1":{"text":"But they're Water Wights.","source_cn":"但他们是水鬼。","status":"matched","hash_xxh64":"0x36B1E034F821C2EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:56:1210306031:1":{"text":"That's only your suspicion. It's not a fact.","source_cn":"只是疑似，还没有定论。","status":"matched","hash_xxh64":"0x782C874C89AB0084","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:57:1210306032:1":{"text":"The Carmine Whispers do not tolerate betrayal. My suspicion is enough for them to die.","source_cn":"血薇帮不容背叛，疑似就足够他们去死了。","status":"matched","hash_xxh64":"0xF582AFFE0EB3E076","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:58:1210306033:1":{"text":"You can't always run a gang with an iron fist. Besides, we need to prepare for <style=\"highlight\">\"that\"</style>. Throw them into <style=\"highlight\">Darkstone Cave</style> for now.","source_cn":"管理帮派不能全靠铁腕。更何况，我们还需要为<style...","status":"matched","hash_xxh64":"0x78452E8A0F05DE26","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:59:1210306034:1":{"text":"Take your time. You still have a lot to learn.","s