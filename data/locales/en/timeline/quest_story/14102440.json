{"asset_key":"timeline/quest_story_14102440","episode":"timeline","category":"quest_story","story_id":"14102440","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1410243501:":{"text":"What's that?","source_cn":"那是？","status":"matched","hash_xxh64":"0x79FF051AE12C4BE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1410243502:":{"text":"Ah, that? That's a lift.","source_cn":"是一台大升降机","status":"matched","hash_xxh64":"0x3736EDC7870129E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410244001:1":{"text":"Where does it go?","source_cn":"祖娅，这台升降机通向哪里啊？","status":"matched","hash_xxh64":"0x812E633FB72E8A17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1410244002:1":{"text":"This beauty connects the surface to the deeper levels in one smooth ride. The problem is, you can't board it from here.","source_cn":"它是连通地面与更深处的直达升降机，但是你们没法在这一层...","status":"matched","hash_xxh64":"0x6C9DDB46B5A7ADD5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1410244003:1":{"text":"Think of it like this: if the usual path has eight stops between your place and mine, this lift is the express carriage that skips all the stops and takes you straight there.","source_cn":"就像是从你家去我家原本有八个驿站，而这一台升降机就像豪...","status":"matched","hash_xxh64":"0x3C4351CF70375CF4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1410244004:1":{"text":"Oh! So it's for getting to places faster?","source_cn":"我懂了，是为了更快到达想去的地方。","status":"matched","hash_xxh64":"0x63EE4726BD7AD252","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1410244005:0":{"text":"Exactly.","source_cn":"就是这个意思。","status":"matched","hash_xxh64":"0xED9B086B85F36F1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1410244005":{"text":"Exactly.","source_cn":"就是这个意思。","status":"matched","hash_xxh64":"0xED9B086B85F36F1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1410244006:0":{"text":"It starts at Brimstone Village, but where exactly it ends... well, that's a mystery even to me.","source_cn":"起点是深岩村，至于确切的终点……我现在也不太确定。","status":"matched","hash_xxh64":"0x260B23E01F8F101C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1410244008:0":{"text":"Look, I'd love to give you the full historical rundown, really, but I'm an inventor, not a historian.","source_cn":"唉！这些事情说来话长，我又不是学者，现在没心思给你们上...","status":"matched","hash_xxh64":"0x4930D1CA66939FFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1410244009:0":{"text":"In any case, don't think you can ride this lift back to the surface. You'll have to walk, now chop chop!","source_cn":"总之，别想着乘坐这个返回地面了，老老实实走路吧！","status":"matched","hash_xxh64":"0xB525CEEA6D3A32B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:16:1410243501:":{"text":"What's that?","source_cn":"那是？","status":"matched","hash_xxh64":"0x79FF051AE12C4BE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:16:1410243502:":{"text":"Ah, that? That's a lift.","source_cn":"是一台大升降机","status":"matched","hash_xxh64":"0x3736EDC7870129E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:18:14010232:0":{"text":"You glance over and see a giant lift creaking its way slowly upward","source_cn":"你向旁边望去，有个巨型升降机正在缓缓上行。","status":"matched_runtime_gender","hash_xxh64":"0x662F950A0A5A76D4","variant_status":"runtime_gender_keys_target_same","male":"You glance over and see a giant lift creaking its way slowly upward","female":"You glance over and see a giant lift creaking its way slowly upward","variant_male_record_index":"168086","variant_female_record_index":"168087","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"Where does it stop?","source_cn":"（询问升降机的起点与终点）","status":"matched_runtime_gender","hash_xxh64":"0x75E95525417D48F0","variant_status":"runtime_gender_keys_target_same","male":"Where does it stop?","female":"Where does it stop?","variant_male_record_index":"71640","variant_female_record_index":"71641","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1410244007:1":{"text":"It was built by the villagers. It's been around for decades.","source_cn":"是村里人造的，得有个好几十年了。","status":"matched","hash_xxh64":"0x1A8A5EB4F685EC6D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"Who created this lift?","source_cn":"（询问升降机的制造者）","status":"matched_runtime_gender","hash_xxh64":"0x4A506C8E5BE0A9E1","variant_status":"runtime_gender_keys_target_same","male":"Who created this lift?","female":"Who created this lift?","variant_male_record_index":"71642","variant_female_record_index":"71643","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:20:14010232:0":{"text":"You glance over and see a giant lift creaking its way slowly upward","source_cn":"你向旁边望去，有个巨型升降机正在缓缓上行。","status":"matched_runtime_gender","hash_xxh64":"0x662F950A0A5A76D4","variant_status":"runtime_gender_keys_target_same","male":"You glance over and see a giant lift creaking its way slowly upward","female":"You glance over and see a giant lift creaking its way slowly upward","variant_male_record_index":"168086","variant_female_record_index":"168087","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:祖娅":{"text":"Zanie","source":"祖娅","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":27,"localized_text_count":18,"speaker_count":4}}