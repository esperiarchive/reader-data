{"asset_key":"timeline/quest_story_12107010","episode":"timeline","category":"quest_story","story_id":"12107010","schema_version":1,"lang":"en","texts":{"say:5:1210701001:0":{"text":"Yay, we've finally reached Lookout Point! And we didn't run into any creepy sea monsters on the way!","source_cn":"太好了！终于平安到瞭望角了！一路上也没遇到海怪！","status":"matched","hash_xxh64":"0x85D84B2A3BF0DDE4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210701002:1":{"text":"Yeah, but there are so many guards here... How do we get in?","source_cn":"但这里的守卫很多……我们要怎么进去？","status":"matched","hash_xxh64":"0x65B2B88F299700CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1210701003:1":{"text":"They're just lackeys. They're no match for us.","source_cn":"只是喽啰，不是我们的对手。","status":"matched","hash_xxh64":"0x4425F715D2372159","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210701004:0":{"text":"Come on, we don't always have to use brute force.","source_cn":"没必要硬闯。","status":"matched","hash_xxh64":"0x8A34D68451DC13F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1210701005:1":{"text":"We could knock a few of them out, steal their clothes, and just sneak in! Easy-peasy, right?","source_cn":"随手打晕几个水鬼，换上他们的衣服，不就能光明正大地进去了？","status":"matched","hash_xxh64":"0xAD958CD6BB7688EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1210701006:1":{"text":"I suppose you're right. We should conserve our energy.","source_cn":"……也不是不行。","status":"matched","hash_xxh64":"0x772418FC09B9ADE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210701007:1":{"text":"Let's go for those guards at the entrance. It's their lucky day!","source_cn":"那就选守在入口的那几个幸运儿吧。","status":"matched","hash_xxh64":"0x8CCA28D8BDB8D21E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:18:12010711:0":{"text":"You finally arrive at the Lookout Point, but it is hard to sneak into the camp with Water Wights everywhere.","source_cn":"你们终于抵达了瞭望角，但这里四处都是水鬼帮，难以闯入。","status":"matched","hash_xxh64":"0x4C0ED8542DF5E761","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:辛巴达":{"text":"Sinbad","source":"辛巴达","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":8,"speaker_count":5}}