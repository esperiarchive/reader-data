{"asset_key":"timeline/quest_story_11103160","episode":"timeline","category":"quest_story","story_id":"11103160","schema_version":1,"lang":"en","texts":{"say:1:1110316001:1":{"text":"Do you accept defeat? Do you accept that the Uru Clan lost?","source_cn":"不甘心吗？你会接受吗，乌尔氏族在战歌节的失败？","status":"matched","hash_xxh64":"0x2AE3D0845E23AF27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110316002:0":{"text":"I won't give up! But... I have to concede. It was a fair fight, and I couldn't best you.","source_cn":"我——我不甘心！但必须承认，这是公平的战斗，我无法战胜您……","status":"matched","hash_xxh64":"0xE0DC10DCACE8E818","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110316003:0":{"text":"Understood. I will now proclaim the results of the Trial of Souls.","source_cn":"我明白了，那么，乌尔氏族的魂之试炼……","status":"matched","hash_xxh64":"0xA4A099BC5C565D5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:8:1110317001:":{"text":"Wait! Just a minute!","source_cn":"等等！请等一下！","status":"matched","hash_xxh64":"0x54CA9845BD7CC21B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:8:1110317002:":{"text":"Sorry! I'm late!","source_cn":"不好意思，我来迟了！","status":"matched","hash_xxh64":"0xD5B42E2D5D0B76A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:8:1110317003:":{"text":"Alsa, you...","source_cn":"阿尔萨，你……","status":"matched","hash_xxh64":"0x9B802EBB51ED4278","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1110316004:1":{"text":"Sir! The Uru Clan sent two warriors to the trials. I apologize for my tardiness...","source_cn":"布鲁特斯大人，如您所见，乌尔氏族的代表是两个人！","status":"matched","hash_xxh64":"0x5B85BF04A8CC7B27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1110316005:1":{"text":"Could you give us one more chance?","source_cn":"您看，我们……可以再得到一次试炼的机会吗？","status":"matched","hash_xxh64":"0x8FDB0888BB4F9ED1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1110316006:1":{"text":"The Warsong Festival rules don't address this, so I suppose it's my call...","source_cn":"战歌节的规则并没有涵盖你们这种情况。也就是说，裁量权在我——","status":"matched","hash_xxh64":"0xFE2BCB668EFD6E13","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1110316007:1":{"text":"I've made my decision... Let's see what you two can do together!","source_cn":"不过，我同意。让我看看你们两个人拼尽全力的样子吧！","status":"matched","hash_xxh64":"0xBE2E25F04C0635CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:16:11010103:0":{"text":"Alsa appears when Brutus is about to announce the result of the trial.","source_cn":"就在布鲁特斯即将宣布试炼失败时，阿尔萨出现了。","status":"matched","hash_xxh64":"0x355CC91D2CBD3180","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:布鲁特斯":{"text":"Brutus","source":"布鲁特斯","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"},"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":16,"localized_text_count":11,"speaker_count":4}}