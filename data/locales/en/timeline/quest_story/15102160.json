{"asset_key":"timeline/quest_story_15102160","episode":"timeline","category":"quest_story","story_id":"15102160","schema_version":1,"lang":"en","texts":{"say:3:1510216001:0":{"text":"You flea-bitten howlers! We're just here hunting game!","source_cn":"野蛮的兽人杂种！我们只是来狩猎野兽！","status":"matched","hash_xxh64":"0x0AC154D89B535619","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510216002:0":{"text":"Just you wait! General Perseus will crush you all!","source_cn":"等着瞧，珀尔修斯统帅会把你们——","status":"matched","hash_xxh64":"0x3412B2049BFC0B74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:6:1510216003:1":{"text":"Kordan reels back and drives his fist straight into the captive soldier's face, his nose crunching under the blow.","source_cn":"戈丹挥拳砸碎了被俘士兵的鼻子","status":"matched","hash_xxh64":"0x9D62669FE3A268E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510216004:0":{"text":"Uh...!","source_cn":"唔……！","status":"matched","hash_xxh64":"0x598B0D640FD7F2A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510216005:0":{"text":"The beasts of these lands belong to the Wildborn.","source_cn":"这片领地的野兽属于雅库伯尔。","status":"matched","hash_xxh64":"0xDAA08B0912AA544D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510216006:0":{"text":"I'll slit you open and let the vultures feast on your guts!","source_cn":"我会把你们的肚子剖开，让秃鹫啄食内脏……","status":"matched","hash_xxh64":"0xEC98D681A658897C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510216007:0":{"text":"Death won't take you... not until the sun scorches your insides dry.","source_cn":"在肠子被太阳晒干之前，你们都死不掉。","status":"matched","hash_xxh64":"0xAAE2DC21F15F14CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510216008:0":{"text":"That's the price you pay for setting foot in our lands!","source_cn":"听清了吗？这就是你们踏入雅库伯尔的代价！","status":"matched","hash_xxh64":"0x5EC711E80B8DB793","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510216009:0":{"text":"Praise the Hunting God! By his mercy, we are shielded!","source_cn":"赞美狩猎神！赞美<male>他</male><fema...","status":"matched_runtime_gender","hash_xxh64":"0x09FC622BC7820641","variant_status":"runtime_gender_keys_target_differs","male":"Praise the Hunting God! By his mercy, we are shielded!","female":"Praise the Hunting Goddess! By her mercy, we are shielded!","variant_male_record_index":"177832","variant_female_record_index":"177833","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1510216010:0":{"text":"All hail the Wild Moon!","source_cn":"赞美狩猎神！<key:dialog1>","status":"matched_runtime_gender","hash_xxh64":"0x2963608F7FEB9C03","variant_status":"runtime_gender_keys_target_same","male":"All hail the Wild Moon!","female":"All hail the Wild Moon!","variant_male_record_index":"177834","variant_female_record_index":"177835","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:25:1510216010":{"text":"All hail the Wild Moon!","source_cn":"赞美狩猎神！<key:dialog1>","status":"matched_runtime_gender","hash_xxh64":"0x2963608F7FEB9C03","variant_status":"runtime_gender_keys_target_same","male":"All hail the Wild Moon!","female":"All hail the Wild Moon!","variant_male_record_index":"177834","variant_female_record_index":"177835","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1510216011:0":{"text":"Should we gut the enemies here in honor of the Herdmaster?","source_cn":"要在这里剖开敌人的腹脏，为狩猎神庆贺吗？","status":"matched_runtime_gender","hash_xxh64":"0x9A46A6DCD0C21970","variant_status":"runtime_gender_keys_target_same","male":"Should we gut the enemies here in honor of the Herdmaster?","female":"Should we gut the enemies here in honor of the Herdmaster?","variant_male_record_index":"177836","variant_female_record_index":"177837","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1510216012:0":{"text":"No, tie them up. Let's take them back to the tribe.","source_cn":"不，把他们捆起来带回部落。","status":"matched","hash_xxh64":"0xC66B3C6637890D2C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1510216013:0":{"text":"We'll hold a sacrifice there to please the Herdmaster. Let them die on 