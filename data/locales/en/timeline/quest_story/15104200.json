{"asset_key":"timeline/quest_story_15104200","episode":"timeline","category":"quest_story","story_id":"15104200","schema_version":1,"lang":"en","texts":{"say:4:1510420001:0":{"text":"Outsiders, you're in the presence of the Regulus of Halia.","source_cn":"咳嗯。外来者，你们正在觐见呼临城的领主。","status":"matched","hash_xxh64":"0xB614E06384F6C3FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510420002:0":{"text":"State your business!","source_cn":"说明你们的来意！","status":"matched","hash_xxh64":"0x4C77A9F52ADAF25F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510420003:0":{"text":"This whelp is the ruler of the city?","source_cn":"……小孩？","status":"matched","hash_xxh64":"0x9E8373446D68F4DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510420004:0":{"text":"What did you just say?! Did you just call me a whelp?!","source_cn":"你、你说什么，谁是小孩？！","status":"matched","hash_xxh64":"0x8D24650475ACADBD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510420005:0":{"text":"Please, Regulus Abundius, stay calm. We're from the Arcane Council, and we've been researching the recent famine and drought troubling Halia.","source_cn":"尊敬的阿邦德殿下啊，请息怒。我们是魔法师协会，一直在研...","status":"matched","hash_xxh64":"0x0C2ABC58039D2853","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510420006:0":{"text":"There's a way to turn the tide. But for it to work, the Arcane Council must be allowed to move and cast magic unhindered within the city. Only then can we help you and Halia.","source_cn":"现在，我们已经想出了能改变现状的方法。希望您能赐予魔法...","status":"matched","hash_xxh64":"0x041C0E2C3E07ED9F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510420007:1":{"text":"Oh, Perseus told me that Halia is like a sick old man, and you're the healers who can fix him, right?","source_cn":"呃，珀尔修斯说过，呼临城是生病的人，你们是来治疗的医师。","status":"matched","hash_xxh64":"0x5109D6AD97627480","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510420008:0":{"text":"It was a figure of speech, my lord.","source_cn":"那是一种比喻，殿下。","status":"matched","hash_xxh64":"0xDDC6FE63B8B7851F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1510420009:1":{"text":"Well, since Perseus says you're all good people, I believe you.","source_cn":"呃，是吗？不管怎样，珀尔修斯说你们是好人。","status":"matched","hash_xxh64":"0x571610170D6C585D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1510420010:0":{"text":"I won't object.","source_cn":"他给你们担保，那我也不会不同意！","status":"matched","hash_xxh64":"0xBFD6764036DE1F94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510420011:0":{"text":"As the Regulus of Halia, I hereby grant you... all sorts of powers! Really important ones!","source_cn":"作为呼临城领主，我给你们……各种权力！","status":"matched","hash_xxh64":"0x82A13FD461EAC8A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510420012:1":{"text":"How was that, Perseus? Did I get everything right?","source_cn":"这样就可以了吗，珀尔修斯？","status":"matched","hash_xxh64":"0x4C8054251BB5790C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1510420013:0":{"text":"The people of Halia will be forever grateful for your wisdom, my lord.","source_cn":"呼临城会感激殿下的英明。","status":"matched","hash_xxh64":"0xB512C484A72855E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1510420014:0":{"text":"That's good to hear. You can take them down and show them my city.","source_cn":"嗯，那就好！可以带他们下去了。","status":"matched","hash_xxh64":"0xBB2BE8B1C329B4F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1510420015:0":{"text":"Yes, Regulus.","source_cn":"是。<key:dialog7>","status":"matched","hash_xxh64":"0x464C72B88D8828DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1510420016:1":{"text":"Hey! Wait!","source_cn":"……诶，等等！","status":"matched","hash_xxh64":"0xDC4BAE27E0172E19","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1510420017:0":{"text":"You have big ears. Who are you?","source_cn":"那个有大耳朵的女孩，你是谁？","status":"matched","hash_xxh64":"0xFA184EC2AFAD7203","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1510420018:0":{"text":"I am Master <style=\"stress\"><player_name></style>'s servant.","source_cn":"加拉是<style=stress><player_na...","status":"matched_runtime_gender","hash_xxh64":"0xFAC7C773317C9940","variant_status":"runtime_gender_keys_target_same","male":"I am Master <style=\"stress\"><player_name></style>'s servant.","female":"I am Master <style=\"stress\"><player_name></style>'s servant.","variant_male_record_index":"180299","variant_female_record_index":"180300","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1510420019:0":{"text":"You're a Wildborn, aren't you? You have big fluffy ears and a tail.","source_cn":"你……你是兽人？有大耳朵，还有好长的尾巴。","status":"matched","hash_xxh64":"0x55E65216CA594C0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1510420020:1":{"text":"Oh, Perseus, I want a Wildborn servant too!","source_cn":"真有趣，我也想要一个兽人仆人。","status":"matched","hash_xxh64":"0xD39F669C8FC970D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1510420021:0":{"text":"My lord, this is no way to treat our guests. We still need the Arcane Council's support.","source_cn":"殿下！这不是呼临城的待客之道，我们还仰仗魔法师协会的协助。","status":"matched","hash_xxh64":"0xB900EC2BE13A84C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1510420022:0":{"text":"Oh, alright...","source_cn":"唔……好吧……","status":"matched","hash_xxh64":"0xCD0534B1849839EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1510420023:1":{"text":"Bakis was right. The Wildborn are like animals and beasts. Do you really bite people and eat raw meat?","source_cn":"比博老师说得没错，兽人果然更像野兽。你是不是也咬人、吃生肉？","status":"matched","hash_xxh64":"0x5D45C1CEF15CB510","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1510420024:0":{"text":"I don't eat raw meat, but I do bite people...","source_cn":"加拉不吃生肉，但是加拉咬人。而且很疼。","status":"matched","hash_xxh64":"0xFF1ABB5FB9C76C2B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1510420025:0":{"text":"... especially people I don't like.","source_cn":"尤其是讨厌的人！","status":"matched","hash_xxh64":"0xFB3AF3E4E65D6311","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1510420026:0":{"text":"Ah! Don't come near me!","source_cn":"……噫！真可怕！","status":"matched","hash_xxh64":"0xAA620A99FE6DF083","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1510420027:0":{"text":"Perseus, take them away! I don't want a Wildborn servant anymore!","source_cn":"珀尔修斯，快、快把他们带下去！我不要兽人仆人了！","status":"matched","hash_xxh64":"0x5C02E137A6281F9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1510420028:0":{"text":"Yes, my lord.","source_cn":"……是。殿下。","status":"matched","hash_xxh64":"0xA53F780018068C3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:41:1510420029:0":{"text":"Perseus leads you all out.","source_cn":"珀尔修斯带你们离开了","status":"matched","hash_xxh64":"0x6D8DCC0D2E096FB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1510420030:0":{"text":"I didn't expect the Regulus to be a child. No wonder Halia is such a mess.","source_cn":"没想到领主竟然是个小孩，怪不得呼临城会变成这幅惨象。","status":"matched","hash_xxh64":"0x9A07F9C26DBD5D05","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1510420031:0":{"text":"The young lord needs guidance, and that's not for outsiders to question.","source_cn":"领主年幼，需要旁人辅佐，轮不到外人置喙。","status":"matched","hash_xxh64":"0x925316DC55F898A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1510420032:1":{"text":"You should learn to keep your mouth shut.","source_cn":"该闭嘴的时候，把嘴闭上。","status":"matched","hash_xxh64":"0xF5B012FA6055F510","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:47:1510420032":{"text":"You should learn to keep your mouth shut.","source_cn":"该闭嘴的时候，把嘴闭上。","status":"matched","hash_xxh64":"0xF5B012FA6055F510","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1510420034:0":{"text":"Let's find a place to discuss our next steps. Follow me.","source_cn":"先找个地方从长商议之后的行动。跟我来。","status":"matched","hash_xxh64":"0x37055CF25BA65867","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:47:0:1":{"text":"What do we do now?","source_cn":"接下来怎么办？","status":"matched_runtime_gender","hash_xxh64":"0xD80E3ADD02639831","variant_status":"runtime_gender_keys_target_same","male":"What do we do now?","female":"What do we do now?","variant_male_record_index":"76732","variant_female_record_index":"76733","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:47:1:2":{"text":"Should we try the magic circle now?","source_cn":"我们立刻开始在城内设阵施法？","status":"matched_runtime_gender","hash_xxh64":"0x526073A57B3B305E","variant_status":"runtime_gender_keys_target_same","male":"Should we try the magic circle now?","female":"Should we try the magic circle now?","variant_male_record_index":"76734","variant_female_record_index":"76735","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1510420033:0":{"text":"At least you have a sense of humor.","source_cn":"看，这新人至少还有点幽默感。","status":"matched_runtime_gender","hash_xxh64":"0x987E5F3700AFE579","variant_status":"runtime_gender_keys_target_same","male":"At least you have a sense of humor.","female":"At least you have a sense of humor.","variant_male_record_index":"180315","variant_female_record_index":"180316","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:47:2:3":{"text":"You're hilarious, Morgan.","source_cn":"摩根说话好听又有趣，别阻止他","status":"matched_runtime_gender","hash_xxh64":"0x35D30A3B71CDAE70","variant_status":"runtime_gender_keys_target_same","male":"You're hilarious, Morgan.","female":"You're hilarious, Morgan.","variant_male_record_index":"76736","variant_female_record_index":"76737","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:51:15010432:0":{"text":"Led by Perseus, you offer your salute to Abundius, the Regulus of Halia.","source_cn":"在珀尔修斯的带领下，你们向呼临城领主阿邦德敬礼。","status":"matched_runtime_gender","hash_xxh64":"0x2888D42E07C6EC0F","variant_status":"runtime_gender_keys_target_same","male":"Led by Perseus, you offer your salute to Abundius, the Regulus of Halia.","female":"Led by Perseus, you offer your salute to Abundius, the Regulus of Halia.","variant_male_record_index":"193646","variant_female_record_index":"193647","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:领主阿邦德":{"text":"Abundius","source":"领主阿邦德","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"},"speaker:珀尔修斯":{"text":"Perseus","source":"珀尔修斯","status":"matched_dialogue_flow"},"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":44,"localized_text_count":39,"speaker_count":6}}