{"asset_key":"timeline/quest_story_12201200","episode":"timeline","category":"quest_story","story_id":"12201200","schema_version":1,"lang":"en","texts":{"say:4:1220120001:0":{"text":"You found it? But where's Jonah? Why didn't he come back with you?","source_cn":"你们拿到钥匙了？乔纳森呢？他怎么没和你们一起回来？","status":"matched","hash_xxh64":"0xB87813350E2CCECD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1220120002:0":{"text":"Cecilia?! You... you look—","source_cn":"塞西莉亚？！你、你这个样子是——","status":"matched","hash_xxh64":"0x56F02724F8CEEEE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1220120002":{"text":"Cecilia?! You... you look—","source_cn":"塞西莉亚？！你、你这个样子是——","status":"matched","hash_xxh64":"0x56F02724F8CEEEE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1220120003:0":{"text":"...Ah, I see. So I've already...","source_cn":"……啊，是这样啊，原来我早已经……","status":"matched","hash_xxh64":"0xFE66CC2D57627BAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1220120004:1":{"text":"Miss Cecilia...","source_cn":"塞西莉亚小姐……","status":"matched","hash_xxh64":"0xFBFA56C7FBECA25A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1220120005:0":{"text":"I remember now. When the Graveborns attacked, everyone was fleeing...","source_cn":"我想起来了，亡灵海盗来的时候，大家都在奔逃……","status":"matched","hash_xxh64":"0x91B1FF57C973FCAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1220120006:0":{"text":"Jonah hid me here and told me to hold on and wait for him.","source_cn":"乔纳森把我藏在了这个房间里，让我坚持住，一定要等他回来。","status":"matched","hash_xxh64":"0xD05A878A0D8E68DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1220120007:0":{"text":"So... I waited.","source_cn":"所以我坚持着，等待着。","status":"matched","hash_xxh64":"0x3778FF3B43CB550B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1220120008:0":{"text":"It's been so long... so long that I forgot I had died.","source_cn":"原来已经过了这么久啊……久到我连自己已经死去这件事都忘记了。","status":"matched","hash_xxh64":"0x191AD6A38883916A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1220120009:0":{"text":"I'm so sorry, Cecilia... I can't get my words out!","source_cn":"……很抱歉，塞西莉亚……呜，我说不下去了！","status":"matched","hash_xxh64":"0xCE47D9AEABCC0B5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1220120010:0":{"text":"Cecilia... Jonah, he actually...","source_cn":"塞西莉亚……乔纳森他、他其实……","status":"matched","hash_xxh64":"0xA1220F2E08407F55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1220120011:0":{"text":"He's gone, isn't he? I should have known... If he were alive, he wouldn't have left me here, all alone.","source_cn":"他去世了吧。我应该知道的……毕竟，如果他还活着，不会让...","status":"matched","hash_xxh64":"0x6CB59F8ACE5C3CCA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1220120012:0":{"text":"Even when we fought, we'd always make up within two days... We've never been apart this long.","source_cn":"我们就算吵架，没有两天也一定会和好……我们从来没有分开...","status":"matched","hash_xxh64":"0x2AEA9A96E77B64B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1220120013:0":{"text":"You managed to open the door. That means you found him, right?","source_cn":"你们能打开房门，说明已经找到乔纳森了，对不对？","status":"matched","hash_xxh64":"0x383099A98487A8E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1220120014:0":{"text":"Please, take me to him. Even with... the way I am now, I need to see him one last time.","source_cn":"请带我去见他吧……即便已经成为幽灵，我也想再见他一面。","status":"matched","hash_xxh64":"0xB12041BB8B1FB115","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"You look like a ghost.","source_cn":"你看起来像是幽灵","status":"matched_runtime_gender","hash_xxh64":"0x1AAD1B73C92471C3","variant_status":"runtime_gender_keys_target_same","male":"You look like a ghost.","female":"You look like a ghost.","variant_male_record_index":"66178","variant_female_record_index":"66179","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"I'm so sorry...","source_cn":"我很抱歉……","status":"matched_runtime_gender","hash_xxh64":"0x3269B841BFD03387","variant_status":"runtime_gender_keys_target_same","male":"I'm so sorry...","female":"I'm so sorry...","variant_male_record_index":"66180","variant_female_record_index":"66181","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:2:3":{"text":"We were too late.","source_cn":"看来，我们来得太晚了","status":"matched_runtime_gender","hash_xxh64":"0x27BB08C85B7F377B","variant_status":"runtime_gender_keys_target_same","male":"We were too late.","female":"We were too late.","variant_male_record_index":"66182","variant_female_record_index":"66183","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:24:12020132:0":{"text":"Cecilia finally steps out of the room. You notice she has turned into a spirit.","source_cn":"塞西莉亚终于走出了房间。直到这时你们才发现，她已经变成...","status":"matched","hash_xxh64":"0x4E9C9FC56B8EF8E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{