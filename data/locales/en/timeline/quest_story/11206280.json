{"asset_key":"timeline/quest_story_11206280","episode":"timeline","category":"quest_story","story_id":"11206280","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1120627001:":{"text":"We got trouble, Boss!","source_cn":"老大！不好了！","status":"matched","hash_xxh64":"0x557666E35F4494A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120627002:":{"text":"Why are you the only one here?","source_cn":"怎么就你一个？其他人呢？","status":"matched","hash_xxh64":"0xF18B3058555AF002","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120627003:":{"text":"The camp collapsed!","source_cn":"营地……营地塌了！","status":"matched","hash_xxh64":"0xA39EDCBEDB7197EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120628001:0":{"text":"The whole thing came crashing down... Our men are still stuck in the rubble...","source_cn":"老大，营地塌了，兄弟们被压在下面了……","status":"matched","hash_xxh64":"0xBBC26C0839D03485","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120628002:0":{"text":"What are you blabbering about?!","source_cn":"啊？你在说什么胡话？","status":"matched","hash_xxh64":"0x64AA37027BD47474","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120628003:0":{"text":"We're back, Magister!","source_cn":"主人，我们回来啦！","status":"matched_runtime_gender","hash_xxh64":"0xA41EECDFBF12F1F1","variant_status":"runtime_gender_keys_target_same","male":"We're back, Magister!","female":"We're back, Magister!","variant_male_record_index":"125783","variant_female_record_index":"125784","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1120628003":{"text":"We're back, Magister!","source_cn":"主人，我们回来啦！","status":"matched_runtime_gender","hash_xxh64":"0xA41EECDFBF12F1F1","variant_status":"runtime_gender_keys_target_same","male":"We're back, Magister!","female":"We're back, Magister!","variant_male_record_index":"125783","variant_female_record_index":"125784","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1120628004:0":{"text":"There they are! Those two rodents dug out the ground beneath our camp and made it collapse!","source_cn":"就是这两只仓鼠！它们把我们的营地下面都挖空了！","status":"matched","hash_xxh64":"0x484FE6A34B1DD43F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1120628005:0":{"text":"Chippy and Hammie? But I thought they were off looking for the treasure... What's going on here?!","source_cn":"满满和漫漫？你们不是去探查藏宝点……这一切是怎么回事？","status":"matched","hash_xxh64":"0x1F58068767EF278F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1120628006:0":{"text":"Long story short, our friend and I noticed something was off about Ch