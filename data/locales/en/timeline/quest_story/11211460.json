{"asset_key":"timeline/quest_story_11211460","episode":"timeline","category":"quest_story","story_id":"11211460","schema_version":1,"lang":"en","texts":{"say:1:1121146001:1":{"text":"... Everyone, stop!","source_cn":"……大家停步！","status":"matched","hash_xxh64":"0xE38B56E9B48FE18D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1121146002:1":{"text":"This aura... belongs to a Hypogean. It's nearby!","source_cn":"这股气息……是恶魔。就在这附近！","status":"matched","hash_xxh64":"0xA128DDDFAB157AC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1121146003:1":{"text":"What? A Hypogean? Where? Chippy will protect everyone!","source_cn":"什么，恶魔？！在哪里！？满满要保护大家！","status":"matched","hash_xxh64":"0x3AA48C9775BC0ADB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1121146004:1":{"text":"The aura's moving further away from us at a very fast speed... We can't let it escape.","source_cn":"气息在远离我们，速度很快……不能让他逃走。","status":"matched","hash_xxh64":"0x2E9570B3964376C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1121146005:1":{"text":"This is too dangerous. Please stay here while I go after him!","source_cn":"太危险了，你们不要跟来，我去追上他！","status":"matched","hash_xxh64":"0xEED639C41D34D7C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1121146006:1":{"text":"Hey! Wait!","source_cn":"诶，塔琳小姐——！等等呀！","status":"matched","hash_xxh64":"0x410AC632E592EEE8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:11:1121147001:":{"text":"You're not going anywhere, Hypogean!","source_cn":"恶魔，别想逃！","status":"matched","hash_xxh64":"0x33934A99175D803D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1121146007:1":{"text":"Wow, she just unfolded her wings and flew off...","source_cn":"哇，她振翅飞走了……","status":"matched","hash_xxh64":"0x5C6B8C2C677D8250","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1121146008:1":{"text":"Forgive me for eavesdropping, but did that lady just mention... a Hypogean?","source_cn":"恕我冒昧，刚才那位陌生的女士，是不是提到了——恶魔？","status":"matched","hash_xxh64":"0x29CEAC8C212D5014","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1121146008":{"text":"Forgive me for eavesdropping, but did that lady just mention... a Hypogean?","source_cn":"恕我冒昧，刚才那位陌生的女士，是不是提到了——恶魔？","status":"matched","hash_xxh64":"0x29CEAC8C212D5014","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1121146009:2":{"text":"... I see. A Celestial who lost her memory, an unidentified Hypogean, and the mysteriously duplicated statue.","source_cn":"原来如此，失忆的半神与身份不明的恶魔，还有神秘增加的神像。","status":"matched","hash_xxh64":"0x441B319FA5348C98","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1121146010:1":{"text":"Thank you all for coming. The same thing has happened here.","source_cn":"感谢诸位愿意前来。同样的事情正在发生。","status":"matched","hash_xxh64":"0xDF439C3796D350C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1121146011:1":{"text":"W-what? The same thing?!","source_cn":"什——什么？同样的事情？","status":"matched","hash_xxh64":"0x1523806170311245","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1121146012:1":{"text":"Do you guys also have two Deer Spirit statues here?","source_cn":"难道鹿灵雕像也变成了两个？！","status":"matched","hash_xxh64":"0x65D5340CCC1E509A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1121146013:1":{"text":"The situation is slightly different.","source_cn":"略有不同。","status":"matched","hash_xxh64":"0x54A897C86658CF9E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1121146014:3":{"text":"So, do you want to go directly to the Spirit Mound or wait here for Lady Talene to return?","source_cn":"那么，诸位是要直接前往鹿灵圣丘，或是在这里等待塔琳女士回归？","status":"matched","hash_xxh64":"0xCE279CF7D091AC7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1121146015:1":{"text":"Chippy's worried about her... That's a Hypogean, you know! All the Hypogeans we have encountered are vicious and sly!","source_cn":"满满还是不放心……那可是恶魔哇！我们见过的恶魔都又阴险...","status":"matched","hash_xxh64":"0x13881E36F99514B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1121146016:1":{"text":"Even if a Celestial is capable of fending off a Hypogean, Talene is alone and without her memories...","source_cn":"就算半神有对抗恶魔的力量，但就塔琳她一个人，而且还失忆了……","status":"matched","hash_xxh64":"0xC4185BC8487CA1A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:25:1121146016":{"text":"Even if a Celestial is capable of fending off a Hypogean, Talene is alone and without her memories...","source_cn":"就算半神有对抗恶魔的力量，但就塔琳她一个人，而且还失忆了……","status":"matched","hash_xxh64":"0xC4185BC8487CA1A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1121146019:0":{"text":"Let's catch up with Miss Talene. Since we've dealt with Hypogeans before, I'm sure we can be helpful!","source_cn":"要是不放心的话，还是先追上塔琳小姐吧。我们也不是第一次...","status":"matched","hash_xxh64":"0x779E2D602A310C14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:0:1":{"text":"Let's find her!","source_cn":"我们去找她吧！","status":"matched_runtime_gender","hash_xxh64":"0x7B8C96003AF417B7","variant_status":"runtime_gender_keys_target_same","male":"Let's find her!","female":"Let's find her!","variant_male_record_index":"59112","variant_female_record_index":"59113","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:1:2":{"text":"She can't do this without us!","source_cn":"我们也去帮忙","status":"matched_runtime_gender","hash_xxh64":"0xE468D73EA0764EDE","variant_status":"runtime_gender_keys_target_same","male":"She can't do this without us!","female":"She can't do this without us!","variant_male_record_index":"59114","variant_female_record_index":"59115","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1121146017:1":{"text":"Don't worry, Chippy is sure you'll recover your memories!","source_cn":"没关系，主人慢慢也能想起来的。","status":"matched_runtime_gender","hash_xxh64":"0xBCB3CD6B9A9FB181","variant_status":"runtime_gender_keys_target_same","male":"Don't worry, Chippy is sure you'll recover your memories!","female":"Don't worry, Chippy is sure you'll recover your memories!","variant_male_record_index":"99574","variant_female_record_index":"99575","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1121146018:0":{"text":"Exactly! We'll help you remember all our adventures together.","source_cn":"——没错！在那之前，我们会陪你记住所有的新冒险！","status":"matched_runtime_gender","hash_xxh64":"0xF425DB6BFB41FAB5","variant_status":"runtime_gender_keys_target_same","male":"Exactly! We'll help you remember all our adventures together.","female":"Exactly! We'll help you remember all our adventures together.","variant_male_record_index":"99576","variant_female_record_index":"99577","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:2:3":{"text":"I also suffer from amnesia!","source_cn":"我也是个失忆的人啊！","status":"matched_runtime_gender","hash_xxh64":"0x8BE6B0BA32CFF3DE","variant_status":"runtime_gender_keys_target_same","male":"I also suffer from amnesia!","female":"I also suffer from amnesia!","variant_male_record_index":"59116","variant_female_record_index":"59117","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"That was Talene.","source_cn":"（介绍塔琳）","status":"matched_runtime_gender","hash_xxh64":"0x6AA61236D62C7056","variant_status":"runtime_gender_keys_target_same","male":"That was Talene.","female":"That was Talene.","variant_male_record_index":"59106","variant_female_record_index":"59107","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"I'll tell you about Dura's Statue...","source_cn":"（介绍在圣石镇发生的事情）","status":"matched_runtime_gender","hash_xxh64":"0xEB0D36FC88AFACFD","variant_status":"runtime_gender_keys_target_same","male":"I'll tell you about Dura's Statue...","female":"I'll tell you about Dura's Statue...","variant_male_record_index":"59108","variant_female_record_index":"59109","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:2:3":{"text":"I totally saved the day there!","source_cn":"（夸耀自己如何智慧地寻回女神像）","status":"matched_runtime_gender","hash_xxh64":"0x9097CCF6BDF144E0","variant_status":"runtime_gender_keys_target_same","male":"I totally saved the day there!","female":"I totally saved the day there!","variant_male_record_index":"59110","variant_female_record_index":"59111","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:30:110102114:0":{"text":"On the way to Spirit Mound, Talene suddenly senses the aura of a Hypogean and flies off by herself in pursuit of it.","source_cn":"前往鹿灵圣丘的路上，塔琳突然感受到恶魔的气息，独自飞走...","status":"matched","hash_xxh64":"0xD9ED75B3EAE2D951","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:塔琳":{"text":"Talene","source":"塔琳","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:布莱恩":{"text":"Bryon","source":"布莱恩","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":34,"localized_text_count":29,"speaker_count":5}}