{"asset_key":"timeline/quest_story_13221160","episode":"timeline","category":"quest_story","story_id":"13221160","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1322115001:":{"text":"Dura...","source_cn":"女神啊……","status":"matched","hash_xxh64":"0xB9B1000F3820762C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1322115002:":{"text":"Please grant those laid low eternal rest.","source_cn":"请赐下永恒的安息","status":"matched","hash_xxh64":"0x9A2B4FC526464571","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1322115003:":{"text":"Let the souls of the deceased...","source_cn":"让所有逝者的灵魂","status":"matched","hash_xxh64":"0xCADD2919254AD538","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1322115004:":{"text":"...rest in peace.","source_cn":"得到祝福与安宁……","status":"matched","hash_xxh64":"0xED7930FEE3B29DA8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322116001:1":{"text":"Strange... I hear something. W-who's there?!","source_cn":"奇怪，什么声音……谁！谁在那里？！","status":"matched","hash_xxh64":"0x169F8DB279AF7A2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322116002:1":{"text":"Are you here to attend the funeral, young lady? How come you suddenly appeared at the cemetery? We didn't see you when we were inspecting the area earlier.","source_cn":"咦，这位女士，你是来参加葬礼仪式的吗？为什么会突然从墓...","status":"matched","hash_xxh64":"0xE099580131DD0877","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1322116003:1":{"text":"I...","source_cn":"我……<key:dialog31>","status":"matched","hash_xxh64":"0x842BD49F1E0099A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1322116004:1":{"text":"Wait... Your face... It's as pale as the... undead! You're not human!","source_cn":"等等……你、你的脸色……苍白得和活死人一样！你——你不...","status":"matched","hash_xxh64":"0xFFB57ECA6982AAC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1322116005:1":{"text":"Undead?! Stop her! Don't let her hurt anyone!","source_cn":"什么，活死人？！快……快拦住她，不要让她伤害这里的人！","status":"matched","hash_xxh64":"0xD91BA7DFFB4521AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1322116006:1":{"text":"Threat detected.","source_cn":"警告，发现威胁！","status":"matched","hash_xxh64":"0x5995F2AD780DD859","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1322116007:1":{"text":"Protect, Little Carly. Threats must be eliminated.","source_cn":"必须清除！保护，小卡莎！","status":"matched","hash_xxh64":"0xC39A0F780DA8B9F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1322116008:1":{"text":"Dura above! What is this? What are you going to do?!","source_cn":"艾雅啊！这……这是什么东西……你……你们要干什么！","status":"matched","hash_xxh64":"0x17B4705845241F2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1322116009:1":{"text":"Callan! No! Don't hurt them!","source_cn":"铐兰哥哥，快住手！不要伤害他们！","status":"matched","hash_xxh64":"0x2598C0ABE18D8C9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1322116010:1":{"text":"T-they must be followers of the Hypogean! Everyone, run!","source_cn":"恶魔……他们肯定是恶魔的眷属！大家快跑、快跑啊！！","status":"matched","hash_xxh64":"0x9B8107B616D3B01F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1322117001:":{"text":"Evil has descended! Run!","source_cn":"恶魔眷属来了！快跑啊！","status":"matched","hash_xxh64":"0xCA12F5891F420E86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1322117002:":{"text":"Run! There's a Hypogean!","source_cn":"快跑！恶魔出现了！","status":"matched","hash_xxh64":"0x88CC81DFC50FA0AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1322117003:":{"text":"Dura above! Save us!","source_cn":"艾雅在上，救救我们！","status":"matched","hash_xxh64":"0x8A1FF4AEF6028917","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:20:13050313:0":{"text":"Callan shows up to protect Carolina, but his appearance scares off the crowd.","source_cn":"铐兰出现保护卡列琳娜，却意外吓跑了所有的民众。","status":"matched","hash_xxh64":"0x1865D919CA834B66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:21:13050312:0":{"text":"During a prayer for the deceased, two acolytes notice Carolina quietly praying among the crowd.","source_cn":"众人正为亡者祈祷时，两位修士发现了前来祈祷的卡列琳娜。","status":"matched","hash_xxh64":"0xB0AC1C15A21BDB07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修士马克西姆":{"text":"Acolyte Maxim","source":"修士马克西姆","status":"matched_dialogue_flow"},"speaker:修士费尔德南":{"text":"Acolyte Ferin","source":"修士费尔德南","status":"matched_dialogue_flow"},"speaker:修女特里莎":{"text":"Acolyte Theresa","source":"修女特里莎","status":"matched_dialogue_flow"},"speaker:卡列琳娜":