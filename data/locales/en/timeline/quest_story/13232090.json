{"asset_key":"timeline/quest_story_13232090","episode":"timeline","category":"quest_story","story_id":"13232090","schema_version":1,"lang":"en","texts":{"say:4:1323209001:1":{"text":"Perfect! Now the wind won't bother us later tonight!","source_cn":"完美！这样后半夜我们就无惧冷风了！","status":"matched_runtime_gender","hash_xxh64":"0x9A3E752C2C0F08EC","variant_status":"runtime_gender_keys_target_same","male":"Perfect! Now the wind won't bother us later tonight!","female":"Perfect! Now the wind won't bother us later tonight!","variant_male_record_index":"155171","variant_female_record_index":"155172","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1323209001":{"text":"Perfect! Now the wind won't bother us later tonight!","source_cn":"完美！这样后半夜我们就无惧冷风了！","status":"matched_runtime_gender","hash_xxh64":"0x9A3E752C2C0F08EC","variant_status":"runtime_gender_keys_target_same","male":"Perfect! Now the wind won't bother us later tonight!","female":"Perfect! Now the wind won't bother us later tonight!","variant_male_record_index":"155171","variant_female_record_index":"155172","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1323209002:1":{"text":"Chippy's fur is standing on end from the wind!","source_cn":"满满的毛发都被冷风吹得竖起来了！","status":"matched","hash_xxh64":"0x4A6C6D3775564F6A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1323209003:1":{"text":"My ears are about to freeze!","source_cn":"我的耳朵都要缩起来了！","status":"matched","hash_xxh64":"0xD818F1770142A4FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1323209004:1":{"text":"If you're cold now, wait until midnight. You'll need a fire, and you'll hear the wind howling outside the tent.","source_cn":"这就觉得冷了，那半夜就得点火了，你们还会听到帐篷外的狂...","status":"matched","hash_xxh64":"0xB9A814A8637B640E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1323209005:1":{"text":"Whoa, this feels straight out of a ghost story that happens in the middle of nowhere!","source_cn":"哇啊，好像发生在荒郊野岭的鬼故事里的情景啊！","status":"matched","hash_xxh64":"0x75D57E4C764E74F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1323209006:1":{"text":"Chippy, stop talking like that!","source_cn":"满满你不要再说了！","status":"matched","hash_xxh64":"0xAC6928B77A576604","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1323209006":{"text":"Chippy, stop talking like that!","source_cn":"满满你不要再说了！","status":"matched","hash_xxh64":"0xAC6928B77A576604","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1323209007:1":{"text":"There's no other way. The Fish King only shows up under <style=\"highlight\">the ice at dawn</style>. I've already spent several cold nights here waiting.","source_cn":"没办法，玩意儿就只有<style=highlight>...","status":"matched","hash_xxh64":"0x49655DAFA06BD159","variant_status":"","