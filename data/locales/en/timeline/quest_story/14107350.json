{"asset_key":"timeline/quest_story_14107350","episode":"timeline","category":"quest_story","story_id":"14107350","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1410733101:":{"text":"Don't resist!","source_cn":"老实点！<key:dialog42>","status":"matched","hash_xxh64":"0xDF1AAC9F756E6561","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1410733102:":{"text":"Damn it...","source_cn":"可恶……","status":"matched","hash_xxh64":"0x4F874984482DC30F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1410733103:":{"text":"Over there!","source_cn":"过去！","status":"matched","hash_xxh64":"0x53BA4B4C6DE2A314","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410735001:0":{"text":"Eldric, you scoundrel! How dare you appear before me!","source_cn":"弗林……你这混球，还敢出现在我的面前！","status":"matched","hash_xxh64":"0xB850644D8A8F5C9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1410735002:0":{"text":"What in Helthor's name have these cretins done now? How dare they try to destroy the ties between our people?!","source_cn":"这些混蛋都做了什么好事！竟敢破坏我们两族的关系！","status":"matched","hash_xxh64":"0xF38FCD27587869B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1410735003:0":{"text":"High Priestess Velara, I swear I'll make sure they regret what they've done!","source_cn":"奎茵大祭司，放心吧！我一定好好处理他们！","status":"matched","hash_xxh64":"0xE4920D4F2AFBAD42","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1410735004:0":{"text":"Chief Eldric, Her Majesty has decided to leave these two in your hands to prevent diplomatic discord.","source_cn":"弗林先生，女王陛下担忧引起外交纠纷，所以特意将此二人转...","status":"matched","hash_xxh64":"0x8AA5F5B1553E530F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1410735005:0":{"text":"I hope you understand her painstaking efforts. After all, some things shouldn't happen in Sal'thorin...","source_cn":"希望您能明白她的苦心，毕竟有些事情不该在萨洛克兰发生……","status":"matched","hash_xxh64":"0xF0C29BB623AD2BF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1410735006:0":{"text":"Understood. You can rest assured that I will handle everything personally from here.","source_cn":"明白明白，您放心就是。","status":"matched","hash_xxh64":"0xAF4F48E0E7C5B88C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1410735007:0":{"text":"Pfft! Rockknobber!","source_cn":"呸，装模作样！","status":"matched","hash_xxh64":"0x328C904AD30DA4C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1410735008:0":{"text":"It seems some dwarves don't know their manners, Chief Eldric, and may need to be taught.","source_cn":"弗林先生，有些矮人不懂礼数，看来还需要好好管教。","status":"matched","hash_xxh64":"0x3D4F781AE292EFE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1410735009:0":{"text":"Yes, High Priestess. Once we return, I will ensure she receives a proper lesson.","source_cn":"大祭司说得对。回去后我一定好好……教训她。","status":"matched","hash_xxh64":"0x219056E4A66CAFCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1410735010:0":{"text":"It's getting late. I'll take them up first and offer you my apologies later.","source_cn":"时候不早了，我们先带他们上去，之后再给您赔罪！","status":"matched","hash_xxh64":"0x50A0757E6BFECFB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1410735011:0":{"text":"I look forward to hearing from you soon. Farewell.","source_cn":"那就期待您的好消息了，再会。","status":"matched","hash_xxh64":"0x814FEDAC3868E904","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:22:1410733101:":{"text":"Don't resist!","source_cn":"老实点！<key:dialog42>","status":"matched","hash_xxh64":"0xDF1AAC9F756E6561","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:22:1410733102:":{"text":"Damn it...","source_cn":"可恶……","status":"matched","hash_xxh64":"0x4F874984482DC30F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:22:1410733103:":{"text":"Over there!","source_cn":"过去！","status":"matched","hash_xxh64":"0x53BA4B4C6DE2A314","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:24:14010726:0":{"text":"Velara hands you over to Eldric.","source_cn":"奎茵将你们移交给了弗林。","status":"matched_runtime_gender","hash_xxh64":"0xA893C4BBB90D1DB7","variant_status":"runtime_gender_keys_target_same","male":"Velara hands you over to Eldric.","female":"Velara hands you over to Eldric.","variant_male_record_index":"168154","variant_female_record_index":"168155","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:25:14010726:0":{"text":"Velara hands you over to Eldric.","source_cn":"奎茵将你们移交给了弗林。","status":"matched_runtime_gender","hash_xxh64":"0xA893C4BBB90D1DB7","variant_status":"runtime_gender_keys_target_same","male":"Velara hands you over to Eldric.","female":"Velara hands you over to Eldric.","variant_male_record_index":"168154","variant_female_record_index":"168155","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_