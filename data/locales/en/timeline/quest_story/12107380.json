{"asset_key":"timeline/quest_story_12107380","episode":"timeline","category":"quest_story","story_id":"12107380","schema_version":1,"lang":"en","texts":{"say:2:1210738001:1":{"text":"Are you gonna do it? Are you gonna kill me, sister?","source_cn":"哈哈哈哈……要杀了我吗？姐姐？","status":"matched","hash_xxh64":"0x9FFD791E25481878","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1210738002:1":{"text":"Nara...","source_cn":"奈拉……","status":"matched","hash_xxh64":"0x4F8F8C6ADEC920CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1210738003:1":{"text":"Come on! Kill me, like you did eleven years ago! Do it again!","source_cn":"来啊！杀了我吧，像十一年前那样！再一次杀了我吧！","status":"matched","hash_xxh64":"0x5EB5348DF654B998","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210738004:1":{"text":"Do it, dear sister!","source_cn":"——动手啊，索尼娅！","status":"matched","hash_xxh64":"0x7067EE0E00A537C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210738005:1":{"text":"I'm sorry... Nara.","source_cn":"对不起……奈拉。","status":"matched","hash_xxh64":"0x60C393688C67E9CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210738006:1":{"text":"Sorry? It's too late now!","source_cn":"对不起？太晚了！","status":"matched","hash_xxh64":"0x55F4D11272607A28","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1210738007:1":{"text":"If you don't strike, I'll kill you instead sooner or later!","source_cn":"你不动手，我迟早要杀了你！","status":"matched","hash_xxh64":"0x365B2F4E72FFDE75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1210738008:1":{"text":"I'll keep your head right by my bed. Your eyes will watch me. Always watching! Watching as I tear bodies apart and snap their necks!","source_cn":"我要把你的人头放在我的床边，我要你的眼睛看着我！一直看...","status":"matched","hash_xxh64":"0xD11B01DD99F3F5A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210738009:1":{"text":"See these scars, Sonja? They're just like sewing a rag doll together with fish bones and fishing lines!","source_cn":"姐姐，看到了吗？这缝缝补补的伤口……就像做布娃娃一样，...","status":"matched","hash_xxh64":"0x3CFFF4C6F0665899","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210738010:1":{"text":"I came back from the depths of the sea just to see you again!","source_cn":"为了见你，我从海底回来了！","status":"matched","hash_xxh64":"0x368EEAE0A12E6EDA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210738011:1":{"text":"Nara, I...","source_cn":"奈拉，我……","status":"matched","hash_xxh64":"0xE176C4898C417682","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1210738012:1":{"text":"Hahaha! That look in your eyes, yes! That's it! Keep looking at me just like that!","source_cn":"呵哈哈哈……就是这样的眼神，你现在看着我的眼神！多棒啊……","status":"matched","hash_xxh64":"0xFF23471F1EE6037C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1210738013:1":{"text":"You were the one who taught me how to sew dolls. Did I learn well?","source_cn":"你教我缝的布娃娃，我是不是学的很好？哈哈哈哈！！！","status":"matched","hash_xxh64":"0x352B0DD91480C3FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210738014:0":{"text":"What are you waiting for? Do it! Kill me... kill me!","source_cn":"姐姐！还在犹豫什么呢？！动手啊！杀了我吧……杀了我吧！！！","status":"matched","hash_xxh64":"0x9CF4121B88CB9C4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1210738015:0":{"text":"Even if you kill me, I'll find you again! Hahahaha!!","source_cn":"就算你杀了我，我也会回来找你！啊哈哈哈哈哈！","status":"matched","hash_xxh64":"0xEF00870A64ACD49A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1210738016:0":{"text":"... I'm sorry.","source_cn":"……对不起。","status":"matched","hash_xxh64":"0x2691977D0A535DF9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:19:1210738017:0":{"text":"Sonja, unable to harm Nara, reluctantly knocks her unconscious...","source_cn":"索尼娅终究不忍心伤害奈拉，无奈地把她打晕了……","status":"matched","hash_xxh64":"0x04CD396FC3E6B7A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1210738018:0":{"text":"I'm sorry... I can't do it.","source_cn":"对不起，我下不了手。","status":"matched","hash_xxh64":"0x1CD7529093AD54A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1210738019:0":{"text":"I'll take her back and lock her up.","source_cn":"我会把她带回去，关起来。","status":"matched","hash_xxh64":"0x54FD15CF7E44DFEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1210738020:1":{"text":"We understand, Miss Sonja! This must have been a very difficult decision for you.","source_cn":"我们明白的，这对你来说是个非常艰难的选择。","status":"matched","hash_xxh64":"0xE5744DAF843D0DA4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:25:1210738020":{"text":"We understand, Miss Sonja! This must have been a very difficult decision for you.","source_cn":"我们明白的，这对你来说是个非常艰难的选择。","status":"matched","hash_xxh64":"0xE5744DAF843D0DA4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1210738021:0":{"text":"But make sure to keep an eye on her! We can't afford to have her showing up in Rustport again. That would be hard to explain.","source_cn":"至少别让她再在锈锚港民众面前出现，不然索尼娅你没法解释的。","status":"matched","hash_xxh64":"0xAFFB52B09F4E3E76","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1210738022:1":{"text":"I know.","source_cn":"我知道。","status":"matched","hash_xxh64":"0x8DAC1B379BD75D70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1210738023:0":{"text":"Let's deal with the other Wights. With Nara out of the picture, maybe they'll wise up and surrender.","source_cn":"那么，去看看其他水鬼吧，老大都被我们收拾了，他们会不会...","status":"matched","hash_xxh64":"0x96B65EF0F16E2EE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:32:1210739001:":{"text":"They took out the boss lady!","source_cn":"大姐头被干掉了！","status":"matched","hash_xxh64":"0x58AD5EDCF474EDE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:32:1210739002:":{"text":"Ahhh! We surrender, we're sorry!!","source_cn":"别动手，我们投降！！！","status":"matched","hash_xxh64":"0x8C1C8A6F8D7C509D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:34:120107510:0":{"text":"Seeing Nara defeated, the Water Wights on the Chainkeeper all surrender.","source_cn":"看到奈拉被你们打败后，枷锁号上的水鬼全都主动投降了。","status":"matched","hash_xxh64":"0xE8FA724E988EB3A5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:0:1":{"text":"I understand your pain.","source_cn":"我们理解","status":"matched_runtime_gender","hash_xxh64":"0x8AFF68F6DAC85893","variant_status":"runtime_gender_keys_target_same","male":"I understand your pain.","female":"I understand your pain.","variant_male_record_index":"65444","variant_female_record_index":"65445","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:1:2":{"text":"Watch over her carefully.","source_cn":"索尼娅，你要看好她","status":"matched_runtime_gender","hash_xxh64":"0x86A026E8D64A20C0","variant_status":"runtime_gender_keys_target_same","male":"Watch over her carefully.","female":"Watch over her carefully.","variant_male_record_index":"65446","variant_female_record_index":"65447","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:奈拉":{"text":"Nara","source":"奈拉","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source":"索尼娅","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:水鬼帮帮众":{"text":"Wight Thug","source":"水鬼帮帮众","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":34,"localized_text_count":29,"speaker_count":5}}