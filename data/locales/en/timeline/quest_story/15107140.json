{"asset_key":"timeline/quest_story_15107140","episode":"timeline","category":"quest_story","story_id":"15107140","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1510713001:":{"text":"This shipment only goes to the guard post?","source_cn":"送到哨卡就行了？","status":"matched","hash_xxh64":"0x462E5AC70F7B4588","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1510713002:":{"text":"Yeah, but the next run goes to the front lines.","source_cn":"对，下一趟再送去前线","status":"matched","hash_xxh64":"0x47C440A5596A72F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1510713003:":{"text":"The road is blocked.","source_cn":"路被拦住了","status":"matched","hash_xxh64":"0xD1192C2EF5327B57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1510713004:":{"text":"We have to catch up to that soldier!","source_cn":"想办法追上那个士兵，不能跟丢！","status":"matched_runtime_gender","hash_xxh64":"0x8E0F755947A8FC35","variant_status":"runtime_gender_keys_target_same","male":"We have to catch up to that soldier!","female":"We have to catch up to that soldier!","variant_male_record_index":"181510","variant_female_record_index":"181511","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1510713005:":{"text":"I've got this.","source_cn":"交给我","status":"matched","hash_xxh64":"0xF45C83566185120B","variant_status":"","male":"","