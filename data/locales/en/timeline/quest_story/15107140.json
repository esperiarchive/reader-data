":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510714006:0":{"text":"Follow me.","source_cn":"跟上我。","status":"matched","hash_xxh64":"0xBA4890DB85F09A72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:15010721:0":{"text":"While pursuing the lone soldier, a convoy of supply wagons blocks your path. In the nick of time, Nazrik hurls his tracking spear at the soldier.","source_cn":"追踪落单士兵的途中，你们被军备马车挡住去路。紧要关头，...","status":"matched_runtime_gender","hash_xxh64":"0x7629CAC84DA5EEC9","variant_status":"runtime_gender_keys_target_same","male":"While pursuing the lone soldier, a convoy of supply wagons blocks your path. In the nick of time, Nazrik hurls his tracking spear at the soldier.","female":"While pursuing the lone soldier, a convoy of supply wagons blocks your path. In the nick of time, Nazrik hurls his tracking spear at the soldier.","variant_male_record_index":"193675","variant_female_record_index":"193676","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:运送军备的士兵A":{"text":"运送军备的士兵A","source":"运送军备的士兵A","status":"source"},"speaker:运送军备的士兵B":{"text":"运送军备的士兵B","source":"运送军备的士兵B","status":"source"},"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"},"speaker:主角":{"text":"Player","source":"主角","status":"matched_dialogue_flow"},"speaker:那非":{"text":"Nazrik","source":"那非","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":17,"localized_text_count":12,"speaker_count":6}}