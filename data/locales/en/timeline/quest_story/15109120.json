{"asset_key":"timeline/quest_story_15109120","episode":"timeline","category":"quest_story","story_id":"15109120","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:3:1510911001:":{"text":"Fall back! That's an order.","source_cn":"撤军！这是我的命令！","status":"matched","hash_xxh64":"0x26089FDD432643EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510911002:":{"text":"With all due respect—no!","source_cn":"绝对不行！","status":"matched","hash_xxh64":"0xBB07BBDAA42906FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510913001:":{"text":"This isn't where you belong, Perseus!","source_cn":"那里不是你该在的地方，珀尔修斯！","status":"matched","hash_xxh64":"0xA9C618C262668C88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510913002:":{"text":"Come back to me!","source_cn":"回到我身边！","status":"matched","hash_xxh64":"0x2B63862048C5DE78","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510913003:":{"text":"Perseus...","source_cn":"珀尔修斯……<key:dialog2>","status":"matched","hash_xxh64":"0x12F006BC5B32996E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510913004:":{"text":"You... betrayed us?!","source_cn":"你背叛了我们吗？！","status":"matched","hash_xxh64":"0xA4A1CA10D275270B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510913006:":{"text":"—PERSEUS!","source_cn":"——珀尔修斯！！","status":"matched","hash_xxh64":"0xA074D6820261F383","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510913005:":{"text":"Lygos... What are you doing...","source_cn":"隆尔……你在做什么……","status":"matched","hash_xxh64":"0x433E7A014FF1389F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:3:1510913007:":{"text":"No... Lygos!","source_cn":"不……隆尔！","status":"matched","hash_xxh64":"0x78D3C8A2099DBB69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510912001:1":{"text":"I'm not negotiating! <style=\"highlight\">Retreat.</style> That's an order!","source_cn":"我不是在和你商议！<style=highlight>撤...","status":"matched","hash_xxh64":"0x2A857525BA518C1F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510912002:0":{"text":"And what? Let the Wildborn think us cowards? You're the general. You know your troops—","source_cn":"现在撤退只会助长兽人的气焰，让他们笑话呼临人全都是懦夫！","status":"matched","hash_xxh64":"0x18F01723D6BA68D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510912003:1":{"text":"We'd sooner fall on this soil than be mocked as spineless deserters! We'll hold this damn fort with our bare hands if we have to. Halia will not fall!","source_cn":"你是统帅，你应该最了解士兵们的想法！我们宁可死在战场上...","status":"matched","hash_xxh64":"0xD41A7DBB9340EB4A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510912004:0":{"text":"... Listen to me, Lygos. I know your courage. I trust your loyalty. But the Wildborn aren't just some warband; they fight under the Hunting Goddess' protection.","source_cn":"……听着，隆尔。我相信你和士兵们的忠勇，也相信你们的能...","status":"matched","hash_xxh64":"0x77C8E9BD26B2F008","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510912005:0":{"text":"Pitting steel against a god's favor is slaughter, not bravery! How many more must die before you see that?","source_cn":"用凡人的力量对抗神力，纯粹是在白白送死！难道你要眼睁睁...","status":"matched","hash_xxh64":"0x166D16A1DAEA17DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510912006:0":{"text":"If we pull back now, we live to regroup—to strike when the odds are ours again.","source_cn":"现在，只有撤退才能保住我们的力量，等待反攻的时机。","status":"matched","hash_xxh64":"0x56149152154C6A0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510912007:0":{"text":"Stop fearmongering, Perseus! If we retreat now, all that awaits us is death!","source_cn":"别危言耸听了，珀尔修斯！一旦撤退，等着我们的只有死亡！","status":"matched","hash_xxh64":"0xEB58930A38BF08D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510912008:0":{"text":"Where would we even retreat to? How long could we hide?! Only by fighting the Wildborn to the death do we have even a sliver of hope!","source_cn":"退能退到什么地方？躲又能躲到何时！只有与兽人决一死战，...","status":"matched","hash_xxh64":"0xEB6F8FFF517C341E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510912009:1":{"text":"Lygos! That's not hope—that's sacrificing lives for nothing!","source_cn":"隆尔！那不是生机，是让士兵们去送死！","status":"matched","hash_xxh64":"0xE00206474BA35B1F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510912010:0":{"text":"Defy me again, and I will bring down the full weight of martial law. I won't let your pride kill us all.","source_cn":"若你再不听令……我只能按军规处置！","status":"matched","hash_xxh64":"0xC1D3844793F864AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1510911001:":{"text":"Fall back! That's an order.","source_cn":"撤军！这是我的命令！","status":"matched","hash_xxh64":"0x26089FDD432643EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1510911002:":{"text":"With all due respect—no!","source_cn":"绝对不行！","status":"matched","hash_xxh64":"0xBB07BBDAA42906FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1510913001:":{"text":"This isn't where you belong, Perseus!","source_cn":"那里不是你该在的地方，珀尔修斯！","status":"matched","hash_xxh64":"0xA9C618C262668C88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1510913002:":{"text":"Come back to me!","source_cn":"回到我身边！","status":"matched","hash_xxh64":"0x2B63862048C5DE78","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1510913003:":{"text":"Perseus...","source_cn":"珀尔修斯……<key:dialog2>","status":"matched","hash_xxh64":"0x12F006BC5B32996E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cine