{"asset_key":"timeline/quest_story_13102070","episode":"timeline","category":"quest_story","story_id":"13102070","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1310206001:":{"text":"I don't have any money...","source_cn":"可我没有钱……","status":"matched","hash_xxh64":"0xD6541A196214A198","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1310206002:":{"text":"Then pay with something else!","source_cn":"那就用物品抵！","status":"matched","hash_xxh64":"0xE015E38ACC8A6F48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1310207001:0":{"text":"Don't think I'll let you off easy just because you're a girl! You're not leaving until you pay me!","source_cn":"别以为你是个小姑娘我就会心软！不给钱，今天你哪儿都别想去！","status":"matched","hash_xxh64":"0x8709404F95905AAA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1310207002:0":{"text":"I'm really sorry, I forgot my money at home!","source_cn":"我不是故意的，我真的忘了带钱，对不起嘛……","status":"matched","hash_xxh64":"0x33646C3BAEF7246D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1310207003:0":{"text":"Sorry? Oh, how sweet... but let me ask you, what's an apology worth these days?\nBut since you look sincere, I'll make you a deal...","source_cn":"对不起？一句对不起值几个钱？\\n咳，但是嘛，看在你够诚...","status":"matched","hash_xxh64":"0x74CB85E695AAD991","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1310207004:0":{"text":"That bracelet you're wearing... now that's something special. Fine craftsmanship... Look at those shimmering gemstones. Must be worth a pretty penny, huh?","source_cn":"这样吧，我看你这件裙子很精致。啧啧，这布料，这手工……...","status":"matched","hash_xxh64":"0x345144454A234A1A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1310207005:0":{"text":"Hmph, just hand it over and we'll call it even.","source_cn":"嘿嘿，你把它脱下来给我，咱们就两清了！","status":"matched","hash_xxh64":"0xD180128B543C6688","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1310207006:0":{"text":"What—","source_cn":"这怎么能——","status":"matched","hash_xxh64":"0x642A622818DF0CEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1310207007:0":{"text":"So you'll accept this bracelet as payment? Sure, here you go!","source_cn":"用这条裙子就可以抵清？好的呀，我这就脱下来给你！","status":"matched","hash_xxh64":"0x83230D7207E288AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1310207007":{"text":"So you'll accept this bracelet as payment? Sure, here you go!","source_cn":"用这条裙子就可以抵清？好的呀，我这就脱下来给你！","status":"matched","hash_xxh64":"0x83230D7207E288AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1310207008:0":{"text":"H-hey, who are you? What's this got to do with you?","source_cn":"嗯？你什么人啊？关你什么事？","status":"matched_runtime_gender","hash_xxh64":"0xBD59126FB2B9540C","variant_status":"runtime_gender_keys_target_same","male":"H-hey, who are you? What's this got to do with you?","female":"H-hey, who are you? What's this got to do with you?","variant_male_record_index":"144883","variant_female_record_index":"144884","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1310207009:0":{"text":"How could you be trying to swindle a sweet girl like her?!","source_cn":"你！你怎么能让她这样当众脱衣服？","status":"matched","hash_xxh64":"0xF656936BE5E03426","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1310207010:0":{"text":"The audacity! And that bracelet is worth more than your whole shop!","source_cn":"一点都不尊重人！而且这件衣服的价值都足够买下你的店铺了！","status":"matched","hash_xxh64":"0x7F827484F66110DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1310207013:0":{"text":"Mind your own business, outsider! A deal's a deal!","source_cn":"外乡人，少多管闲事！这小姑娘自己都答应把裙子抵给我了，...","status":"matched","hash_xxh64":"0x81AF57A26CD9FD36","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1310207013":{"text":"Mind your own business, outsider! A deal's a deal!","source_cn":"外乡人，少多管闲事！这小姑娘自己都答应把裙子抵给我了，你们凑什么热闹！","status":"matched","hash_xxh64":"0x81AF57A26CD9FD36","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1310207014:0":{"text":"I won't accept a single coin less!","source_cn":"你把钱拿出来再说话，我跟你说，一分都不能少！","status":"matched","hash_xxh64":"0x519A0D7734A6A906","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:22:1310207014":{"text":"I won't accept a single coin less!","source_cn":"你把钱拿出来再说话，我跟你说，一分都不能少！","status":"matched","hash_xxh64":"0x519A0D7734A6A906","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1310207015:0":{"text":"Now is this enough?!","source_cn":"这些够了吧？主人才不会少给你的！","status":"matched_runtime_gender","hash_xxh64":"0xF45128475A85A457","variant_status":"runtime_gender_keys_target_same","male":"Now is this enough?!","female":"Now is this enough?!","variant_male_record_index":"144892","variant_female_record_index":"144893","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1310207017:0":{"text":"Grrr... Alright, fine. This'll do. You can go...","source_cn":"让我数数……嗯，这还差不多，行了行了，你们走吧。","status":"matched","hash_xxh64":"0xC32FC4F35067EDC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1310207018:0":{"text":"I'm so sorry you all had to pay for me... I totally don't have anything to repay you... unless... maybe this cute bracelet?","source_cn":"让你们替我付钱真是不好意思，我身上没什么能补偿你们的…...","status":"matched","hash_xxh64":"0xF56E46670593806C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1310207019:0":{"text":"No no no! We can't take that! Consider the meal our treat!","source_cn":"啊？不不不，这……这可不能啊！哎呀，就算我们请客！","status":"matched","hash_xxh64":"0xECD83469C34C8984","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1310207020:0":{"text":"Haha, I was just kidding! But really, thank you all so much. You're such kind people!","source_cn":"哈哈，我开玩笑的。总之，我要谢谢你们，你们都是很好很好的人！","status":"matched","hash_xxh64":"0x96A0C24AA04FD301","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:33:1310206001:":{"text":"I don't have any money...","source_cn":"可我没有钱……","status":"matched","hash_xxh64":"0xD6541A196214A198","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:33:1310206002:":{"text":"Then pay with something else!","source_cn":"那就用物品抵！","status":"matched","hash_xxh64":"0xE015E38ACC8A6F48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1310208001:0":{"text":"Prin...","source_cn":"殿……","status":"matched","hash_xxh64":"0xB682D238C132B9D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1310208002:0":{"text":"Shh! I told you not to call me that when we're out!","source_cn":"嘘！都说了出门不要这么叫……","status":"matched","hash_xxh64":"0xFA1231768AA0363C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1310208003:0":{"text":"Ahem... Miss Yolena, running around like this isn't safe. If your father finds out, he's going to be furious...","source_cn":"咳……亚莲娜小姐，这样到处乱跑很不安全，您父亲知道了会...","status":"matched","hash_xxh64":"0x4E261C9DA0A33CFD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1310208004:0":{"text":"Oh, come on! It's fine just this once!","source_cn":"哎呀，没关系的，就这一次嘛。","status":"matched","hash_xxh64":"0x668DC8B7A24E45A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1310208005:0":{"text":"Ugh, pleeeease, Rodrigo! Don't tell him. I'm begging you!","source_cn":"拜托了，罗德里戈，不要告诉我父亲好不好？求你了……","status":"matched","hash_xxh64":"0x12540B4165DFB5A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1310208006:0":{"text":"But... *Sigh* Alright. Still, your father's going to arrive in Cedartown soon.","source_cn":"可是……唉，好吧。不过您父亲很快就要抵达雪松镇了……","status":"matched","hash_xxh64":"0x1F7B12E74B90B7BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1310208007:0":{"text":"Ugh, I know, I know... I really don't want him mad at me...","source_cn":"父亲……唉，好吧。我也不想让他生气呀。","status":"matched","hash_xxh64":"0x32360433D9E4EB8D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1310208008:0":{"text":"Heyyy, my new friends! Let's totally hang out again at the festival, okay?","source_cn":"几位可爱的朋友，咱们祭典的时候再一起玩吧！","status":"matched","hash_xxh64":"0x32807D14A54BF0E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1310208009:0":{"text":"You better be there!","source_cn":"你们可一定要来呀！","status":"matched","hash_xxh64":"0x64E1C5B723D5B2B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1310208010:0":{"text":"Yeah, see you there!","source_cn":"嗯嗯，祭典的时候再见！","status":"matched","hash_xxh64":"0xDF452329612B8966","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:50:1310206001:":{"text":"I don't have any money...","source_cn":"可我没有钱……","status":"matched","hash_xxh64":"0xD6541A196214A198","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:50:1310206002:":{"text":"Then pay with something else!","source_cn":"那就用物品抵！","status":"matched","hash_xxh64":"0xE015E38ACC8A6F48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:52:13010214:0":{"text":"In front of a shop, a lady who has forgotten her purse is stopped by the owner.","source_cn":"在一家商铺前，一个忘记带钱出门的女孩被老板拦住了。","status":"matched","hash_xxh64":"0xF2CB756363CF9A8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:53:13010214:0":{"text":"In front of a shop, a lady who has forgotten her purse is stopped by the owner.","source_cn":"在一家商铺前，一个忘记带钱出门的女孩被老板拦住了。","status":"matched","hash_xxh64":"0xF2CB756363CF9A8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:0:1":{"text":"Here.","source_cn":"（递过钱币）","status":"matched_runtime_gender","hash_xxh64":"0x370026BDF653CE7C","variant_status":"runtime_gender_keys_target_same","male":"Here.","female":"Here.","variant_male_record_index":"68714","variant_female_record_index":"68715","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:0:1":{"text":"I'll cover her bill.","source_cn":"我来替她付钱","status":"matched_runtime_gender","hash_xxh64":"0xAFF611059DE155FA","variant_status":"runtime_gender_keys_target_same","male":"I'll cover her bill.","female":"I'll cover her bill.","variant_male_record_index":"68710","variant_female_record_index":"68711","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:54:1310207016:0":{"text":"We won't allow you to bully this girl any longer! We'll cover her bill.","source_cn":"不准你欺负别人，她的钱我们来付！","status":"matched","hash_xxh64":"0x771185C7F552D4B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:1:2":{"text":"Here's the money.","source_cn":"（掏出钱币递过去）","status":"matched_runtime_gender","hash_xxh64":"0xD29D061FADC879A2","variant_status":"runtime_gender_keys_target_same","male":"Here's the money.","female":"Here's the money.","variant_male_record_index":"68712","variant_female_record_index":"68713","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:0:1":{"text":"Wait!","source_cn":"等等，不要！","status":"matched_runtime_gender","hash_xxh64":"0x0197AD15C4A1697E","variant_status":"runtime_gender_keys_target_same","male":"Wait!","female":"Wait!","variant_male_record_index":"68706","variant_female_record_index":"68707","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:55:1310207011:0":{"text":"Is it not fair?","source_cn":"等价？","status":"matched","hash_xxh64":"0x0883585253FE3B39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:58:1310207012:0":{"text":"Your bracelet is far more valuable than the meal you just had. You shouldn't hand it over so easily!","source_cn":"主人是说，你的衣服比一顿饭贵重多了，根本不应该就这样给他！","status":"matched_runtime_gender","hash_xxh64":"0xB65D509B87FECAAF","variant_status":"runtime_gender_keys_target_same","male":"Your bracelet is far more valuable than the meal you just had. You shouldn't hand it over so easily!","female":"Your bracelet is far more valuable than the meal you just had. You shouldn't hand it over so easily!","variant_male_record_index":"144888","variant_female_record_index":"144889","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:1:2":{"text":"This isn't a fair exchange.","source_cn":"这可不是等价交换","status":"matched_runtime_gender","hash_xxh64":"0x2AC0FF47EB0ED380","variant_status":"runtime_gender_keys_target_same","male":"This isn't a fair exchange.","female":"This isn't a fair exchange.","variant_male_record_index":"68708","variant_female_record_index":"68709","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:59:13010214:0":{"text":"In front of a shop, a lady who has forgotten her purse is stopped by the owner.","source_cn":"在一家商铺前，一个忘记带钱出门的女孩被老板拦住了。","status":"matched","hash_xxh64":"0xF2CB756363CF9A8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speake