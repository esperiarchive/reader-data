{"asset_key":"timeline/quest_story_15114530","episode":"timeline","category":"quest_story","story_id":"15114530","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1511452001:":{"text":"Come on. Don't sink into grief. Let's go.","source_cn":"别再伤心了，走吧","status":"matched","hash_xxh64":"0x5C0CD586E640713D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511452002:":{"text":"... It's her!","source_cn":"是……是兽群之主！","status":"matched","hash_xxh64":"0x417902575433F379","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511452003:":{"text":"The Wild Moon...","source_cn":"雅库伯尔之月……","status":"matched","hash_xxh64":"0xBBAD92004DDBC421","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511454001:":{"text":"Dunn, stop!","source_cn":"等等，顿！","status":"matched","hash_xxh64":"0xEF9137A0E2A814F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511454003:":{"text":"What... what have you done?!","source_cn":"你……你做了什么？！","status":"matched","hash_xxh64":"0x1D5113A495B6AFFE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511454002:":{"text":"So this is your choice?","source_cn":"这就是你们的判断吗","status":"matched","hash_xxh64":"0x414ABF197F42D420","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511456001:":{"text":"My avatar is your final trial.","source_cn":"我的分身，就是你最后的考验","status":"matched","hash_xxh64":"0x9DFD1336E08FFCFE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511456002:":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511456003:":{"text":"Now's not the time to be discouraged!","source_cn":"现在不是沮丧的时候！","status":"matched_runtime_gender","hash_xxh64":"0x8B1C42D7954797C8","variant_status":"runtime_gender_keys_target_same","male":"Now's not the time to be discouraged!","female":"Now's not the time to be discouraged!","variant_male_record_index":"192929","variant_female_record_index":"192930","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1511453001:0":{"text":"H-Herdmaster!","source_cn":"兽、兽群之主……！","status":"matched","hash_xxh64":"0x57CF878076A4F0B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1511453002:0":{"text":"... Exalted Wild Moon, I offer you my respects.","source_cn":"……崇高的雅库伯尔之月，请接受那非的敬意。","status":"matched","hash_xxh64":"0xA1F98F24E096476B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1511453003:0":{"text":"You have done well. The blood of beasts stains the land and the swamps, and that pleases me.","source_cn":"你们两个做得不错。野兽的鲜血浸染了土地和沼泽，令我非常喜悦。","status":"matched","hash_xxh64":"0x9AD162EF66D62A3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1511453004:0":{"text":"As a reward, I grant you the highest honor—<style=\"highlight\">the chance to challenge me</style>.","source_cn":"为了奖励你们，我赐予你们无上的殊荣——<style=h...","status":"matched","hash_xxh64":"0x1BF43E294EFC1FD9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1511453005:0":{"text":"Defeat me, and you will stand as victor of the Bloodhunt Festival, bearing the divine power I bestow.","source_cn":"战胜我之人，将成为猎血节的胜者，获得我赐下的神力。","status":"matched","hash_xxh64":"0xDD4C7BEA5935F804","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1511453006:0":{"text":"Challenge... a goddess?!","source_cn":"挑战……神？！","status":"matched","hash_xxh64":"0x178623961004D364","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1511453006":{"text":"Challenge... a goddess?!","source_cn":"挑战……神？！","status":"matched","hash_xxh64":"0x178623961004D364","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1511453007:0":{"text":"Pathetic, trembling servants. Why do you falter? Show me your faith.","source_cn":"软弱无用的仆从，犹豫什么？向我证明你们的虔诚和勇武！","status":"matched","hash_xxh64":"0x7CCB8707823E67ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1511453008:0":{"text":"... Yes!","source_cn":"……是！","status":"matched","hash_xxh64":"0x0D7CF9AF25CA9511","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1511453009:0":{"text":"Wait, Dunn!","source_cn":"等等！顿——！","status":"matched","hash_xxh64":"0xEFE0C003F0273659","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511452001:":{"text":"Come on. Don't sink into grief. Let's go.","source_cn":"别再伤心了，走吧","status":"matched","hash_xxh64":"0x5C0CD586E640713D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511452002:":{"text":"... It's her!","source_cn":"是……是兽群之主！","status":"matched","hash_xxh64":"0x417902575433F379","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511452003:":{"text":"The Wild Moon...","source_cn":"雅库伯尔之月……","status":"matched","hash_xxh64":"0xBBAD92004DDBC421","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511454001:":{"text":"Dunn, stop!","source_cn":"等等，顿！","status":"matched","hash_xxh64":"0xEF9137A0E2A814F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511454003:":{"text":"What... what have you done?!","source_cn":"你……你做了什么？！","status":"matched","hash_xxh64":"0x1D5113A495B6AFFE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511454002:":{"text":"So this is your choice?","source_cn":"这就是你们的判断吗","status":"matched","hash_xxh64":"0x414ABF197F42D420","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511456001:":{"text":"My avatar is your final trial.","source_cn":"我的分身，就是你最后的考验","status":"matched","hash_xxh64":"0x9DFD1336E08FFCFE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511456002:":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511456003:":{"text":"Now's not the time to be discouraged!","source_cn":"现在不是沮丧的时候！","status":"matched_runtime_gender","hash_xxh64":"0x8B1C42D7954797C8","variant_status":"runtime_gender_keys_target_same","male":"Now's not the time to be discouraged!","female":"Now's not the time to be discouraged!","variant_male_record_index":"192929","variant_female_record_index":"192930","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1511455001:0":{"text":"What did you do to Dunn?! He was your faithful devotee!","source_cn":"你……你对顿做了什么？！他是你的信徒！","status":"matched","hash_xxh64":"0x0C0AE8A4443007C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1511455002:0":{"text":"A true hunter knows the measure of their prey.","source_cn":"真正的猎手，要会正确评估猎物的力量。","status":"matched","hash_xxh64":"0x86B6D40FD5BFD4AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1511455003:0":{"text":"To fall by my hand, that is his honor.","source_cn":"能死在我手中，是他的荣幸。","status":"matched","hash_xxh64":"0xC2897853F4B5963B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1511455004:0":{"text":"Better that than wallowing in the filth of slaughtering each other like frightened animals. At least I saw his courage before he died. You should be happy for him.","source_cn":"比起那些死于自相残杀的战士，至少我见证了他的勇气。你该...","status":"matched","hash_xxh64":"0x1DCE9D3C6272F4D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1511455005:0":{"text":"You knew they were killing each other... and you didn't stop it?!","source_cn":"你知道其他人在互相残杀……为什么不阻止他们？！","status":"matched","hash_xxh64":"0x59736582FF7BAFC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1511455006:0":{"text":"And that Hypogean! She ruined everything!","source_cn":"还有那个恶魔！她搅乱了整个猎血节！","status":"matched","hash_xxh64":"0x2D9020E0EC5E58C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1511455007:0":{"text":"Ruined? Hah. You Wildborn are my creations. Like the beasts of the jungle, your only purpose is to amuse me.","source_cn":"你们——雅库伯尔人，是我的造物。你们和丛林里的野兽一样...","status":"matched","hash_xxh64":"0x0FF935B932400A2C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1511455008:0":{"text":"Your blood, your screams, your deaths—these are the offerings I demand.","source_cn":"你们应当将一切都敬献给我！鲜血、惨叫——还有生命！","status":"matched","hash_xxh64":"0x862BD2C9A4072695","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1511455009:0":{"text":"As for that Hypogean? A scrap of shadow, nothing more. Yet her little trick delighted me.","source_cn":"那个恶魔？她做了些有意思的事，让战士互相猎杀，才能决出...","status":"matched","hash_xxh64":"0xC6670B21D0492DE8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1511455010:0":{"text":"She turned you on each other and stripped away the weak. That alone was worth my laughter.","source_cn":"她的存在不值一提，但她所做的事可博我一笑，不枉来这世间一回。","status":"matched","hash_xxh64":"0xAD4F7D437FBAA7A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1511455011:0":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1511455012:0":{"text":"So to you... our lives mean nothing? That's all we are to you?","source_cn":"在你看来，这就是我们存在的意义……？！","status":"matched","hash_xxh64":"0xF0CFDA3890BFEB3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:39:1511455012":{"text":"So to you... our lives mean nothing? That's all we are to you?","source_cn":"在你看来，这就是我们存在的意义……？！","status":"matched","hash_xxh64":"0xF0CFDA3890BFEB3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1511455013:0":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1511455014:0":{"text":"Heh. At last, you hold back. You did not strike at your exalted goddess.","source_cn":"呵，你居然忍住了，没有挑战崇高的神。","status":"matched","hash_xxh64":"0x6C839A313B778238","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1511455015:0":{"text":"It seems you've learned when to bide your fangs. Good.","source_cn":"看来你已经懂得如何评判狩猎的时机了，很好。","status":"matched","hash_xxh64":"0x557D57F62FD9CC48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1511455016:0":{"text":"Then I grant you the final, true trial—<style=\"highlight\">to face my avatar</style>.","source_cn":"我允许你接受最后的，真正的考验——<style=hig...","status":"matched","hash_xxh64":"0x37F21760DF92F69F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1511455017:0":{"text":"Defeat it, and I grant you the <style=\"highlight\">Power of Tracking</style>, and the right to revel in blood as a true warrior.","source_cn":"若你能战胜分身，<style=highlight>追踪...","status":"matched","hash_xxh64":"0x6F67E6813DF85EEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1511455018:0":{"text":"But fail... and the Wildborn will have no champion. The festival ends with no victor... and no survivors.","source_cn":"若你失败，那么雅库伯尔便没有令我满意的勇士，猎血节没有...","status":"matched","hash_xxh64":"0xFCF120C1ABE46987","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1511455019:0":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:51:1511452001:":{"text":"Come on. Don't sink into grief. Let's go.","source_cn":"别再伤心了，走吧","status":"matched","hash_xxh64":"0x5C0CD586E640713D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:51:1511452002:":{"text":"... It's her!","source_cn":"是……是兽群之主！","status":"matched","hash_xxh64":"0x417902575433F379","