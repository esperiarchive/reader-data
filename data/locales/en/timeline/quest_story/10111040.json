{"asset_key":"timeline/quest_story_10111040","episode":"timeline","category":"quest_story","story_id":"10111040","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1011101001:":{"text":"Korin, what should we do?","source_cn":"科林，我们怎么办？","status":"matched","hash_xxh64":"0xFCDA577A62ECB688","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1011101002:":{"text":"Why do the Wilders want us out?","source_cn":"绿裔的人为什么要赶我们？","status":"matched","hash_xxh64":"0x53BB3AFF9E06469A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1011102001:":{"text":"Mr. Korin! Look! A ship!","source_cn":"科林先生，船！有船来了！","status":"matched","hash_xxh64":"0xE9D510E95154D679","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1011102002:":{"text":"More refugees?","source_cn":"又有逃难者来了？","status":"matched","hash_xxh64":"0x13B729AFC2C0D7BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1011103001:":{"text":"You should head back. This isn't the best place to stay.","source_cn":"回去吧，这里无法长待","status":"matched","hash_xxh64":"0x410A168A89354123","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1011104001:0":{"text":"Ahhh!! What's happening here?!\nThe Dark Forest should be <style=\"highlight\">Wilder</style> territory, but it's swarming with Lightbearers everywhere!","source_cn":"哇哇哇，这是怎么回事？！\\n薄暮丛林明明应该是绿裔联盟...","status":"matched","hash_xxh64":"0xFC10D461D076818B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1011104002:0":{"text":"Plus, people here seem like they've been wallowing in the mud, all grubby and upset.","source_cn":"而且看大家的样子，像是在地上滚过一样，脏兮兮的……好可怜。","status":"matched","hash_xxh64":"0x65AD916E007992D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1011104002":{"text":"Plus, people here seem like they've been wallowing in the mud, all grubby and upset.","source_cn":"而且看大家的样子，像是在地上滚过一样，脏兮兮的……好可怜。","status":"matched","hash_xxh64":"0x65AD916E007992D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1011104003:0":{"text":"Since you have a ship, it's best to depart from here.","source_cn":"你们几个，既然有船，就快走吧。","status":"matched","hash_xxh64":"0xADC1F9AFB1400272","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1011104004:1":{"text":"If there's space on your ship, kindly consider taking these refugees too.","source_cn":"要是还有空舱，就把我身后那些可怜的逃难者也接上船，赶快...","status":"matched","hash_xxh64":"0x9E2E919B0267F21B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1011104004":{"text":"If there's space on your ship, kindly consider taking these refugees too.","source_cn":"要是还有空舱，就把我身后那些可怜的逃难者也接上船，赶快离开这里吧。","status":"matched","hash_xxh64":"0x9E2E919B0267F21B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1011104005:1":{"text":"Listen up, Korin my friend, regardless of your identities and origins, this place doesn't seem fit for camping.","source_cn":"我说科林老兄，先不管你们是谁，从哪儿来，这地方怎么看都...","status":"matched","hash_xxh64":"0x5B7BBE97724504FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1011104006:1":{"text":"It's pretty damp and cold by the river. You should take everyone into the forest and let my people take good care of them!","source_cn":"河边潮湿又阴冷，对身体不好，快带大家进丛林吧，我的族人...","status":"matched","hash_xxh64":"0x0808CB7016C30267","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1011104007:1":{"text":"Those bunny ears... Are you one of the Wilders?","source_cn":"你……那双耳朵，你是绿裔联盟的人？","status":"matched","hash_xxh64":"0xD50EB11DD5ED1C6B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1011104008:1":{"text":"You bet I am! Thanks to my ears, I was able to hear them say your name. ","source_cn":"没错，科林老兄！凭借这双耳朵，我听到他们刚才叫你的名字来着。","status":"matched","hash_xxh64":"0xBEE00B5D6DB8C740","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1011104009:1":{"text":"You lot issued an <style=\"highlight\">exclusion edict</style> and are forcing refugees to leave the Dark Forest! I haven't had a chance to sort things out with you!","source_cn":"——就是你们，突然下达<style=highlight...","status":"matched","hash_xxh64":"0x983F3F85A4CD6F57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1011104010:1":{"text":"Look at the weak and elderly! Is this the Wilders' way of welcoming guests? What happened to your once peaceful and benevolent demeanor?","source_cn":"看看周围的老弱妇孺，这是绿裔联盟的待客之道吗？！你们往...","status":"matched","hash_xxh64":"0x8AFF72776290B740","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1011104011:1":{"text":"Hold on, hold on! What exclusion edict?","source_cn":"等等等，等一下，什么封锁令？","status":"matched","hash_xxh64":"0x3E4A68E643D464BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1011104012:1":{"text":"Enough talk. I am taking them into the forest no matter what it takes.","source_cn":"多说无益，就算用强硬手段，今天我也要带他们进丛林！","status":"matched","hash_xxh64":"0x07A71F61A434574E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:0:1":{"text":"Refugees...?","source_cn":"逃难者……？","status":"matched_runtime_gender","hash_xxh64":"0x4A93B2E958AD0C9D","variant_status":"runtime_gender_keys_target_same","male":"Refugees...?","female":"Refugees...?","variant_male_record_index":"60260","variant_female_record_index":"60261","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"Something's not right. What happened?","source_cn":"情况不对劲，发生了什么？","status":"matched_runtime_gender","hash_xxh64":"0x78706ACC906649CA","variant_status":"runtime_gender_keys_target_same","male":"Something's not right. What happened?","female":"Something's not right. What happened?","variant_male_record_index":"60258","variant_female_record_index":"60259","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:25:1011112:0":{"text":"Many Lightbearer refugees have gathered on the outskirts of the Dark Forest. A man named Colin mistakenly thinks you're one of them and urges you to leave.","source_cn":"薄暮丛林外围聚集着许多耀光难民。一个名叫科林的男人误以...","status":"matched","hash_xxh64":"0x2DCBC5486505C30F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:难民老人":{"text":"Elder","source":"难民老人","status":"matched_dialogue_flow"},"speaker:女性难民":{"text":"Woman","source":"女性难民","status":"matched_dialogue_flow"},"speaker:科林":{"text":"Korin