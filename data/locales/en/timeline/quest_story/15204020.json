{"asset_key":"timeline/quest_story_15204020","episode":"timeline","category":"quest_story","story_id":"15204020","schema_version":1,"lang":"en","texts":{"say:1:1520402001:0":{"text":"Are we really going to the <style=\"highlight\">south</style>? After starving this long... can we really <style=\"highlight\">hunt any beasts</style>? What if it's just a lie?","source_cn":"我们真的要去<style=highlight>南边</...","status":"matched","hash_xxh64":"0x2D84F950278B11D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1520402002:1":{"text":"Don't worry, it's real!","source_cn":"放心吧，肯定是真的！","status":"matched","hash_xxh64":"0xFD185939B716CEDF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1520402003:1":{"text":"There's a little <style=\"highlight\">camp</style> down south. Hunters have been going there for days. They say every few days you get a full meal—and if you're lucky, even soup with meat in it!","source_cn":"你没听说那附近有个<style=highlight>小...","status":"matched","hash_xxh64":"0x5A029867C58E3E6B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1520402004:0":{"text":"A full meal... and soup...","source_cn":"能吃饱……还有肉汤……","status":"matched","hash_xxh64":"0xA91C5B91641A7FF7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1520402005:0":{"text":"Mom, I want to go... I want to drink soup...","source_cn":"妈妈，我也想去……我也想喝肉汤！","status":"matched","hash_xxh64":"0xC8E7E85D7469FF85","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1520402006:0":{"text":"I...","source_cn":"这……<key:dialog3>","status":"matched","hash_xxh64":"0xD138B4DADD74A1CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1520402007:0":{"text":"Well, I'm planning on going anyway. Why don't we go together?","source_cn":"反正我准备过去投奔他们了，不如一起搭伙过去吧。","status":"matched","hash_xxh64":"0x03BB73BC55D07869","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1520402008:0":{"text":"Heh... Sure, \"together\". Together to die, more like.","source_cn":"噗……搭伙？搭伙去送死吗？","status":"matched","hash_xxh64":"0x132945FA60666A93","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1520402009:1":{"text":"Even hyenas are hungry. After starving this long, how much strength do you really have? Enough to give them a free meal?","source_cn":"鬣狗也想吃饱饭，你们饿了这么久，还有多少力气？够它们吃吗？","status":"matched","hash_xxh64":"0xEFF38BB38DA07F27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1520402010:0":{"text":"How can you say that?! We just want to live!","source_cn":"你……你这人怎么说话呢？！我们只是想吃顿饱饭，想活下去！","status":"matched","hash_xxh64":"0x5A4DFB58600C527B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1520402011:0":{"text":"Everyone, calm yourselves. I apologize on his behalf.","source_cn":"诸位，请勿动怒。我代替他向你们道歉。","status":"matched","hash_xxh64":"0x3FC95C41879E05F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1520402012:0":{"text":"Morgan is blunt, but he means no insult. And he isn't wrong—any beast surviving a famine is far beyond a normal hunter.","source_cn":"摩根说话直白，但请相信他绝无冒犯之意。更何况的确如他所...","status":"matched","hash_xxh64":"0x4D47E2AA53373970","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1520402013:0":{"text":"Then what choice do we have?!","source_cn":"那又怎么样？我们没有别的选择了！","status":"matched","hash_xxh64":"0xA8340C5226361311","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1520402014:1":{"text":"... There's no other choice.","source_cn":"是的……我们没有不去的选择。","status":"matched","hash_xxh64":"0x82DD5EA5C649EA74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1520402015:0":{"text":"If we stay, we starve. If we go... maybe we live.","source_cn":"就算留在这里，我们也会饿死。但如果去了南边，说不定还能...","status":"matched","hash_xxh64":"0x2CF1A535E5C37A9D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1520402016:0":{"text":"As long as my son survives... it doesn't matter if I die.","source_cn":"只要我儿子能活下来，哪怕我死了也没关系……","status":"matched","hash_xxh64":"0xCD44A9138A41348C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1520402017:0":{"text":"Step aside. <style=\"highlight\">We're going south.</style>","source_cn":"请让开路吧，<style=highlight>我们要去...","status":"matched","hash_xxh64":"0xDFB1BB6734867C2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1520402018:0":{"text":"Then don't let me stop you.","source_cn":"那就请便。","status":"matched","hash_xxh64":"0xEA249CC276CCA73E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:25:1520403001:":{"text":"South...","source_cn":"南边……","status":"matched","hash_xxh64":"0xB211A0DCBAFF0EB8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:27:15020411:0":{"text":"Ignoring Morgan's warning, they head to the small camp to the south.","source_cn":"几人不听摩根的劝告，向着南边的小营地而去。","status":"matched","hash_xxh64":"0x153CDDECD7B20EDE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:利维娅":{"text":"Evia","source":"利维娅","status":"matched_dialogue_flow"},"speaker:亚什":{"text":"Asen","source":"亚什","status":"matched_dialogue_flow"},"speaker:昆图":{"text":"Quinto","source":"昆图","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":25,"localized_text_count":20,"speaker_count":6}}