{"asset_key":"timeline/quest_story_18104370","episode":"timeline","category":"quest_story","story_id":"18104370","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1810436001:":{"text":"... Estrilda.","source_cn":"……爱丝特瑞达","status":"matched","hash_xxh64":"0xE33033ECE1B33A79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810436002:":{"text":"Thane?!","source_cn":"瑟恩？！","status":"matched","hash_xxh64":"0x8BAE3C1012BC5B74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810436003:":{"text":"W-What are you doing here?","source_cn":"你、你怎么会来这里","status":"matched","hash_xxh64":"0x75F3BDDA01E1D3CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810436004:":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1810436005:":{"text":"Thank goodness you're still in one piece.","source_cn":"幸好你没事","status":"matched","hash_xxh64":"0x49982DEE28AAE18C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1810437001:0":{"text":"Thane, I...","source_cn":"瑟恩，我……","status":"matched","hash_xxh64":"0x2BE131CCD6CD8FAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1810437002:1":{"text":"<style=\"stress\"><player_name></style> told me everything.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x23AFBCF0B06EAAAA","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style> told me everything.","female":"<style=\"stress\"><player_name></style> told me everything.","variant_male_record_index":"243133","variant_female_record_index":"243134","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1810437003:0":{"text":"Everything? Like what, exactly?","source_cn":"<male>他</male><female>她</fe...","status":"matched_runtime_gender","hash_xxh64":"0x24E14CB4701D8D2E","variant_status":"runtime_gender_keys_target_same","male":"Everything? Like what, exactly?","female":"Everything? Like what, exactly?","variant_male_record_index":"243135","variant_female_record_index":"243136","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1810437004:1":{"text":"Don't make me spell it out.","source_cn":"你自己清楚。","status":"matched","hash_xxh64":"0xC6CC015D7669E83A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1810437005:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1810437006:1":{"text":"We'll be having a long conversation about your reckless stunt, but it can wait until we're back.","source_cn":"关于你不顾自身安危，私自潜入诺珐斯，独闯苍骸花海等事，...","status":"matched","hash_xxh64":"0xDF2540BE11366EC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1810437007:1":{"text":"Now, it's time for you to go home.","source_cn":"现在，立刻离开这里。","status":"matched","hash_xxh64":"0xB486A8744FF8CABB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1810437008:0":{"text":"No! Not when I finally have a lead on Baden! I'm coming with you!","source_cn":"不！好不容易有了线索，我要和你一起找到堂哥！","status":"matched","hash_xxh64":"0xC6FBEE684069E48D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1810437009:1":{"text":"No.","source_cn":"不行。","status":"matched","hash_xxh64":"0xAE047EEEC7DC63A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1810437010:1":{"text":"Why not? You left a note and just... disappeared. You didn't even tell me where you were going.","source_cn":"怎么不行？你一声招呼都没打，留了张字条就消失。","status":"matched","hash_xxh64":"0x0C83C193CDD6CE34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1810437011:0":{"text":"You came here all by yourself too! If you hadn't run into <style=\"stress\"><player_name></style> in the Refinery, you might not even—","source_cn":"你不是也独自一人来诺珐斯调查吗？如果你没在炼化间遇到<...","status":"matched_runtime_gender","hash_xxh64":"0x9722FEE8A77A79F0","variant_status":"runtime_gender_keys_target_same","male":"You came here all by yourself too! If you hadn't run into <style=\"stress\"><player_name></style> in the Refinery, you might not even—","female":"You came here all by yourself too! If you hadn't run into <style=\"stress\"><player_name></style> in the Refinery, you might not even—","variant_male_record_index":"243143","variant_female_record_index":"243144","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1810437012:1":{"text":"<style=\"highlight\">Don't forget your duty, Estrilda!</style>","source_cn":"<style=highlight>别忘了你的职责，爱丝...","status":"matched","hash_xxh64":"0x05B2CA41597834BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1810437013:0":{"text":"Now that the war is over, finding Baden is my duty! As long as he's alive, I have to bring him home!","source_cn":"这就是我的职责！战事已消，我本就该负起责任找回堂哥。只...","status":"matched","hash_xxh64":"0x4B92FC92F6EBA9F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:17:1810437013":{"text":"Now that the war is over, finding Baden is my duty! As long as he's alive, I have to bring him home!","source_cn":"这就是我的职责！战事已消，我本就该负起责任找回堂哥。只要他还活着，我就必须把他带回耀光！","status":"matched","hash_xxh64":"0x4B92FC92F6EBA9F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1810437014:1":{"text":"My apologies. We got a little carried away.","source_cn":"是我们失态了。","status":"matched","hash_xxh64":"0x122F1BDC0B69C833","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1810437015:0":{"text":"Sorry, <style=\"stress\"><player_name></style>, I should've made the introductions first.","source_cn":"对不起，<style=stress><player_n...","status":"matched_runtime_gender","hash_xxh64":"0x1BE51B9585DC0E11","variant_status":"runtime_gender_keys_target_same","male":"Sorry, <style=\"stress\"><player_name></style>, I should've made the introductions first.","female":"Sorry, <style=\"stress\"><player_name></style>, I should've made the introductions first.","variant_male_record_index":"243148","variant_female_record_index":"243149","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1810437016:0":{"text":"This is Thane, my... swordsmanship mentor and a close friend of Baden.","source_cn":"这位是瑟恩，我的……剑术老师，同时也是我堂哥巴登的好友。","status":"matched_runtime_gender","hash_xxh64":"0x042B1BA782C265C1","variant_status":"runtime_gender_keys_target_same","male":"This is Thane, my... swordsmanship mentor and a close friend of Baden.","female":"This is Thane, my... swordsmanship mentor and a close friend of Baden.","variant_male_record_index":"243150","variant_female_record_index":"243151","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1810437017:0":{"text":"Thank you for looking after Estrilda, <style=\"stress\"><player_name></style>. It means a lot to me.","source_cn":"谢谢你救了爱丝，<style=stress><play...","status":"matched_runtime_gender","hash_xxh64":"0x6F79336D7118C01A","variant_status":"runtime_gender_keys_target_same","male":"Thank you for looking after Estrilda, <style=\"stress\"><player_name></style>. It means a lot to me.","female":"Thank you for looking after Estrilda, <style=\"stress\"><player_name></style>. It means a lot to me.","variant_male_record_index":"243152","variant_female_record_index":"243153","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1810437018:0":{"text":"Baden is my best friend, and Estrilda is his only family. I have to keep her safe.","source_cn":"巴登是我的挚友，爱丝是他唯一的亲人，我必须保护好她。","status":"matched_runtime_gender","hash_xxh64":"0xC267D72765C4DB0F","variant_status":"runtime_gender_keys_target_same","male":"Baden is my best friend, and Estrilda is his only family. I have to keep her safe.","female":"Baden is my best friend, and Estrilda is his only family. I have to keep her safe.","variant_male_record_index":"243154","variant_female_record_index":"243155","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1810437019:0":{"text":"But your safety matters too...","source_cn":"那你也不能无视自己的安危呀……","status":"matched","hash_xxh64":"0x0CFDBCF472EBDABB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1810437020:0":{"text":"Do you have something to say?","source_cn":"你可以大声表达意见，爱丝。","status":"matched","hash_xxh64":"0xEC9D75621D2AE976","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1810437021:0":{"text":"Nope!","source_cn":"我没有意见！","status":"matched","hash_xxh64":"0x66D2D68887560E82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:26:1810437021":{"text":"Nope!","source_cn":"我没有意见！","status":"matched","hash_xxh64":"0x66D2D68887560E82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1810437022:1":{"text":"Sorry! This is Graveborn territory, so I couldn't let my guard down.","source_cn":"抱歉，身处亡灵领地，我必须谨慎行事。","status":"matched","hash_xxh64":"0x073C39836F8918F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1810437023:1":{"text":"Thane, besides <style=\"stress\"><player_name></style>, I've also received help from two other kind Graveborn.","source_cn":"瑟恩，除了<style=stress><player_...","status":"matched_runtime_gender","hash_xxh64":"0xF9DDEF4FCD311492","variant_status":"runtime_gender_keys_target_same","male":"Thane, besides <style=\"stress\"><player_name></style>, I've also received help from two other kind Graveborn.","female":"Thane, besides <style=\"stress\"><player_name></style>, I've also received help from two other kind Graveborn.","variant_male_record_index":"243160","variant_female_record_index":"243161","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1810437024:1":{"text":"As Estrilda recounts how Rain and Baba Muriel looked after her, Thane's expression grows increasingly grim.","source_cn":"爱丝特瑞达为瑟恩讲述了里纳、穆婆婆关照她的事情。不知为...","status":"matched","hash_xxh64":"0x4EE513E3CC519BF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1810437025:1":{"text":"... That young man. He called himself Rain?","source_cn":"……那个青年，他说他叫里纳？","status":"matched","hash_xxh64":"0xA4308F516B2278D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1810437026:1":{"text":"Yes. His voice reminds me of Baden's, but their personalities are worlds apart.","source_cn":"对，他的声音和巴登有点像，但性格完全不一样。","status":"matched","hash_xxh64":"0xEFCD9FDC33577A34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1810437027:1":{"text":"He's always been tactless. He actually told me becoming a Graveborn isn't such a bad thing. As if that would help! What was he thinking?","source_cn":"说话总是没轻没重，还“安慰“我说变成亡灵也挺好的……哼。","status":"matched","hash_xxh64":"0x5C6273A48D9A7066","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:33:1810437027":{"text":"He's always been tactless. He actually told me becoming a Graveborn isn't such a bad thing. As if that would help! What was he thinking?","source_cn":"说话总是没轻没重，还“安慰“我说变成亡灵也挺好的……哼。","status":"matched","hash_xxh64":"0x5C6273A48D9A7066","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1810437028:1":{"text":"... <style=\"highlight\">I'm quite positive he's Baden.</style>","source_cn":"……<style=highlight>他很像是巴登。<...","status":"matched","hash_xxh64":"0x63920A6C422A6FB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1810437029:1":{"text":"That's impossible! Baden is so gentle, well-mannered, and always knows exactly what to say to make people feel better.","source_cn":"一点都不像！巴登温柔、体贴，礼数周到，还很会安慰人。","status":"matched","hash_xxh64":"0xF36B168A9BF8C078","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1810437030:1":{"text":"And Rain? He could kill a Graveborn with his blunt words!","source_cn":"而里纳，他耿直到连亡灵都能再气死一次！","status":"matched","hash_xxh64":"0xCBDE30C2D5797539","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1810437031:1":{"text":"Well, Baden's nice to you only because you're his family.","source_cn":"你是巴登最亲的堂妹，他必然会在你的面前摆出兄长的样子。","status":"matched","hash_xxh64":"0xF5C446FB8B8A3FE8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1810437032:1":{"text":"He's not at all like that when he's around others. With me, he's always been forthright—or \"tactless\", as you would call it—much like the Rain you described.","source_cn":"换成别人——比如不喜欢的人，他就会像你所说的“里纳”那...","status":"matched","hash_xxh64":"0xC06F2271465CD996","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:39:1810437032":{"text":"He's not at all like that when he's around others. With me, he's always been forthright—or \"tactless\", as you would call it—much like the Rain you described.","source_cn":"换成别人——比如不喜欢的人，他就会像你所说的“里纳”那样，在我们二人私下对话时，不留情面地说出真实想法。","status":"matched","hash_xxh64":"0xC06F2271465CD996","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1810437033:1":{"text":"I-I'm not sure. They were in such a hurry that I didn't get a chance to ask. Rain wanted to bring me along, but Baba Muriel said no.","source_cn":"我……我不知道，他们之前走得很匆忙，里纳想带我一起，但...","status":"matched","hash_xxh64":"0xD473174F1F4CC7A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1810437034:1":{"text":"She sounded anxious, even a little panicked. <style=\"highlight\">It felt like she was trying to hide from someone.</style>","source_cn":"她语气急切，甚至有点慌张。<style=highlig...","status":"matched_runtime_gender","hash_xxh64":"0x02A9A1E8DDD424FA","variant_status":"runtime_gender_keys_target_same","male":"She sounded anxious, even a little panicked. <style=\"highlight\">It felt like she was trying to hide from someone.</style>","female":"She sounded anxious, even a little panicked. <style=\"highlight\">It felt like she was trying to hide from someone.</style>","variant_male_record_index":"243172","variant_female_record_index":"243173","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1810437035:1":{"text":"... Did he tell you anything before leaving?","source_cn":"……里纳临走前，有没有跟你说过话？","status":"matched","hash_xxh64":"0x47E9C08647E3E444","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1810437036:1":{"text":"He just left this bone on the counter and said someone from the Seasong Theater would come to pick it up.","source_cn":"他只是把这枚骨头放在柜上，跟我说“海歌剧院会派人来取”...","status":"matched","hash_xxh64":"0xEF811910A0CA35BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1810437037:1":{"text":"Let me have a look.","source_cn":"让我看看。","status":"matched","hash_xxh64":"0x438D7EF60828AB19","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1810437038:1":{"text":"After inspecting the femur for a while, Thane pulls a note from its hollow interior.","source_cn":"瑟恩拿过那枚腿骨检查了一下，随即从中空的部分抽出来一张字条。","status":"matched","hash_xxh64":"0xC57379D3636902B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_titl