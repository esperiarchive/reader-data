{"asset_key":"timeline/quest_story_12105270","episode":"timeline","category":"quest_story","story_id":"12105270","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1210526001:":{"text":"Huh? Where did you come from?","source_cn":"嗯？你们从哪进来的？","status":"matched","hash_xxh64":"0x93CE7454AE08E763","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210527001:1":{"text":"This place is surrounded by my people. How did you get here?","source_cn":"……这里已经被我的人包围了，你们从哪里进来的？","status":"matched","hash_xxh64":"0x30910AED1E85DA29","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1210527002:1":{"text":"Umm... well...","source_cn":"呃……这个嘛……","status":"matched","hash_xxh64":"0x94F66C84BA37C225","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1210527003:1":{"text":"From a secret passage?","source_cn":"我猜，是密道吧？","status":"matched","hash_xxh64":"0x675D9222AE262E66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1210527003":{"text":"From a secret passage?","source_cn":"我猜，是密道吧？","status":"matched","hash_xxh64":"0x675D9222AE262E66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1210527005:1":{"text":"The Water Wights launched a sneak attack in the middle of the night, but the magister drove them away.","source_cn":"水鬼帮半夜偷袭，被主人打跑了。","status":"matched_runtime_gender","hash_xxh64":"0xF8B6779CAB96CC77","variant_status":"runtime_gender_keys_target_same","male":"The Water Wights launched a sneak attack in the middle of the night, but the magister drove them away.","female":"The Water Wights launched a sneak attack in the middle of the night, but the magister drove them away.","variant_male_record_index":"129960","variant_female_record_index":"129961","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1210527006:1":{"text":"We found a secret passage, and it brought us here.","source_cn":"我们发现了一条密道，穿过密道就到了这里！","status":"matched","hash_xxh64":"0x4540DBE35D3A3E68","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1210527007:1":{"text":"Water Wights... What else did you see in the secret passage?","source_cn":"水鬼……你们在密道里还看见了什么？","status":"matched","hash_xxh64":"0x57923CD106E71543","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1210527008:1":{"text":"We saw several guards! Some were Water Wights. Some were from the Carmine Whispers.","source_cn":"看到了守卫！有血薇帮的，还有水鬼！","status":"matched","hash_xxh64":"0x7A458B52D536BAC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1210527009:1":{"text":"Were they fighting?","source_cn":"他们在打斗？","status":"matched","hash_xxh64":"0x8145FFDFF5E0B6E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1210527010:1":{"text":"No... they were guarding the lift together.","source_cn":"不……他们在一起守卫着密道的机关电梯。","status":"matched","hash_xxh64":"0x1372A8B3C7DDCBF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1210527011:1":{"text":"Lucca, go down and take a look.","source_cn":"卢卡，下去看看。","status":"matched","hash_xxh64":"0xC7F3961F6775695F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:18:1210527012:1":{"text":"Lucca enters the secret passage and returns in less than half an hour.","source_cn":"","status":"matched","hash_xxh64":"0xC82B9856818E7202","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1210527013:1":{"text":"They're telling the truth.","source_cn":"他们说的没错。","status":"matched","hash_xxh64":"0x19BFB29E3BCA0B7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1210527014:1":{"text":"Father, do you have anything else to say?","source_cn":"父亲大人，您还要狡辩吗？","status":"matched","hash_xxh64":"0xFE3C61559ED6B266","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1210527015:1":{"text":"Sonja...","source_cn":"索尼娅，你为什么非要……","status":"matched","hash_xxh64":"0x8CA26FF454CC0FF7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1210527016:1":{"text":"Colluding with Water Wights and stealing our secrets... The Carmine Whispers do not tolerate betrayal. You taught me that.","source_cn":"勾结水鬼，窃取血薇帮机密……血薇容不下背叛，您教我的。","status":"matched","hash_xxh64":"0xCAEABD6BBD2A77BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1210527017:1":{"text":"Ha! I taught you well.","source_cn":"呵呵，我的确把你教的很好……","status":"matched","hash_xxh64":"0xD20CC0CEEDA2F4C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1210527018:1":{"text":"However, you will not end my life here.","source_cn":"但是，咳咳……我的人生，还轮不到你来和我说结束。","status":"matched","hash_xxh64":"0x833D56A9B0047622","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1210527019:1":{"text":"Come at me if you dare.","source_cn":"动手。","status":"matched","hash_xxh64":"0xFBAA79B5E1D9B569","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"You're sharp.","source_cn":"你很敏锐","status":"matched_runtime_gender","hash_xxh64":"0x100F2898B99C9001","variant_status":"runtime_gender_keys_target_same","male":"You're sharp.","female":"You're sharp.","variant_male_record_index":"65546","variant_female_record_index":"65547","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1210527004:1":{"text":"That's the only logical conclusion.","source_cn":"不难想到。","status":"matched","hash_xxh64":"0x229B862CD2673073","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"You knew?","source_cn":"你已经发现了？","status":"matched_runtime_gender","hash_xxh64":"0xEF053A0A70439F86","variant_status":"runtime_gender_keys_target_same","male":"You knew?","female":"You knew?","variant_male_record_index":"65548","variant_female_record_index":"65549","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:32:120105212:0":{"text":"You accidentally stumble into the Carmine Whispers' territory through the secret passage and see Sonja confronting Tesio.","source_cn":"你们通过密道意外闯进了血薇帮的地盘，看到索尼娅正在和泰...","status":"matched","hash_xxh64":"0xA3E7B3BDA467B2B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"},"speaker:索尼娅":{"text":"Sonja","source