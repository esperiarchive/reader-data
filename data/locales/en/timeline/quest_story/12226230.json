{"asset_key":"timeline/quest_story_12226230","episode":"timeline","category":"quest_story","story_id":"12226230","schema_version":1,"lang":"en","texts":{"say:7:1222623001:1":{"text":"She got away, just as planned. Good thing I tied the ropes loosely.","source_cn":"很好，她成功逃走了，没有辜负我故意弄松的绳索。","status":"matched","hash_xxh64":"0x57C76516C2DA54D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1222623002:0":{"text":"Let's hurry and catch up to her! It'll be terrible if she goes too far and we lose her.","source_cn":"我们赶紧追上去吧！万一她真的逃跑，那可得不偿失了。","status":"matched","hash_xxh64":"0x8C71F647E4D713F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1222623003:0":{"text":"Chippy... Hey, Chippy!","source_cn":"满满——喂……满满，满满！","status":"matched","hash_xxh64":"0xD47BD9D7189D9D57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1222623004:0":{"text":"Zzzz...","source_cn":"呼噜呼噜……","status":"matched","hash_xxh64":"0x92C3334C14268217","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1222623005:0":{"text":"<shk>Chippy!!</shk>","source_cn":"<shk>满满！！</shk>","status":"matched","hash_xxh64":"0x1D1A3611C6C8DDDD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1222623006:0":{"text":"Ah! Huh? Is it morning already?","source_cn":"啊！嗯？什么！天亮了？","status":"matched","hash_xxh64":"0x77B1AF95AE201DAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1222623007:0":{"text":"Chippy, you big idiot! We agreed you had to put on an act. How could you fall asleep for real?!","source_cn":"满满大笨蛋！说好了是演戏，你怎么真的睡着了呀！","status":"matched","hash_xxh64":"0x89B8D9B7F1070E54","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1222623008:1":{"text":"Sorry!\nChippy was pretending to sleep at first... but then...","source_cn":"对不起！\\n我一开始是装睡……但装着装着，就……","status":"matched","hash_xxh64":"0x5D58C4977E72034A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1222623009:0":{"text":"Haha! It's alright. Bonnie's quite cautious. Honestly, you falling asleep for real might have helped lower her guard.","source_cn":"哈哈哈！没关系。波妮警觉谨慎，你没装睡，而是真的睡着了...","status":"matched","hash_xxh64":"0xB6D6AD44CEE48466","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1222623010:0":{"text":"Let's go!","source_cn":"我们立刻追上去，一定会让她措手不及！","status":"matched","hash_xxh64":"0x88284A36FFAF283D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:24:12602210:0":{"text":"Bonnie breaks free and escapes while you are asleep.","source_cn":"趁着你们都睡着，波妮挣脱了束缚跑了。","status":"matched","hash_xxh64":"0x38406C77A7240B27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢卡":{"text":"Lucca","source":"卢卡","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":16,"localized_text_count":11,"speaker_count":4}}