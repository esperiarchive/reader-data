{"asset_key":"timeline/quest_story_11207340","episode":"timeline","category":"quest_story","story_id":"11207340","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1120733001:":{"text":"You better think this through.","source_cn":"你们可给我想清楚了","status":"matched","hash_xxh64":"0xEE684AFB66C0C6EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120733002:":{"text":"This is your last chance!","source_cn":"这是最后一次机会！","status":"matched","hash_xxh64":"0xB2515C84E609B497","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120734001:0":{"text":"I'm warning you one last time, <style=\"highlight\">Chak</style>.","source_cn":"这是我最后一次警告你，<style=highlight...","status":"matched","hash_xxh64":"0xF8931044DA8CCD17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120734002:0":{"text":"The Quicksand Claws deserve a new boss, and that's me, Russ! Join me now, and we'll crush Giwar's claims of ascension!","source_cn":"流沙之爪迟早会有新首领——那就是我，鲁斯！你要是现在投...","status":"matched","hash_xxh64":"0x345C26468D2C13BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120734003:0":{"text":"But if you don't know what's good for you, you can't blame me for putting aside our past friendship.","source_cn":"但要是不知好歹，就别怪我不顾念以前的情分了！","status":"matched","hash_xxh64":"0x990A8E0391D9DC3E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120734004:0":{"text":"C-Chak, are you going along with this?","source_cn":"奇……奇克，你、你要答应他吗……","status":"matched","hash_xxh64":"0x6D6C9735FC2AC958","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1120734005:1":{"text":"Nope.","source_cn":"不。","status":"matched","hash_xxh64":"0xEC74AE3C4604443D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1120734006:0":{"text":"Like I said, Rumon and I are doing our own thing. The Quicksand Claws can't keep making the same old mistakes.","source_cn":"我说过了，我和卢玛有自己的路要走。流沙之爪也不能再重复...","status":"matched","hash_xxh64":"0xCADC39ED22D02ED2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1120734007:0":{"text":"So whether you or Giwar take up the mantle, you'll get no help from us.","source_cn":"所以无论是你还是吉维尔，我都不会帮的！","status":"matched","hash_xxh64":"0x8DCCD25BB401DE93","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1120734008:0":{"text":"Guess the good old days are long gone. Time to nip this in the bud...","source_cn":"好，那就别怪我不念旧情，提前扼杀风险了——","status":"matched","hash_xxh64":"0xAD4D75988E57C708","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1120734009:0":{"text":"Those Claws are about to make a move on Rumon and his friend!","source_cn":"那些流沙之爪，要对卢玛他们动手！","status":"matched_runtime_gender","hash_xxh64":"0x1395802C7CABB59D","variant_status":"runtime_gender_keys_target_same","male":"Those Claws are about to make a move on Rumon and his friend!","female":"Those Claws are about to make a move on Rumon and his friend!","variant_male_record_index":"126191","variant_female_record_index":"126192","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1120734010:0":{"text":"We gotta stop them!","source_cn":"得阻止他们！","status":"matched_runtime_gender","hash_xxh64":"0x4C24920A07D8BC62","variant_status":"runtime_gender_keys_target_same","male":"We gotta stop them!","female":"We gotta stop them!","variant_male_record_index":"126193","variant_female_record_index":"126194","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:22:1101020731:0":{"text":"Inside the Quicksand Claw camp, a hideous Mauler is threatening Chak and Rumon.","source_cn":"流沙之爪的营地里，一个凶神恶煞的蛮血正在威胁奇克和卢玛。","status":"matched","hash_xxh64":"0x7BA088AB7D926065","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:流沙之爪鲁斯":{"text":"Russ","source":"流沙之爪鲁斯","status":"matched_dialogue_flow"},"speaker:卢玛":{"text":"Rumon","source":"卢玛","status":"matched_dialogue_flow"},"speaker:奇克":{"text":"Chak","source":"奇克","status":