{"asset_key":"timeline/env_story_11202470","episode":"timeline","category":"env_story","story_id":"11202470","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1120246001:":{"text":"I lost...","source_cn":"……是我输了。","status":"matched","hash_xxh64":"0xDA3479F6127078C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120246002:":{"text":"You're stronger than I thought, Kojin.","source_cn":"库金，你比我想象中的还要强大","status":"matched","hash_xxh64":"0x1FCC253EE9C3405D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120246003:":{"text":"Your attacks had me on the defensive more than once.","source_cn":"好几次，你的攻击都让我感到心惊","status":"matched","hash_xxh64":"0x6B8073A71E4049BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120246004:":{"text":"But I lost in the end, and I accept defeat.","source_cn":"但我还是输了，我接受这个结果","status":"matched","hash_xxh64":"0x4589712C20F7D224","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120247001:1":{"text":"Uncle, I believe you're fit to lead the Grimmaw Clan back to prosperity.","source_cn":"克鲁格，我的叔叔，我相信你是那个能带领黑嚎氏族走上巅峰的人。","status":"matched","hash_xxh64":"0xB3E4AA835B8F41BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120247002:1":{"text":"If father could see this, I'm certain he would entrust the clan to you without worry.","source_cn":"父亲如果知道了这件事……一定也会放心把黑嚎氏族交给你的。","status":"matched","hash_xxh64":"0x5080EB2CDA46BBCB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120247003:1":{"text":"You've grown into a formidable warrior, Kojin. Orson would be proud.","source_cn":"你已经成长为出色的战士了，奥格会为你感到骄傲。","status":"matched","hash_xxh64":"0x9FF4CE3D186F1DBB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120247004:1":{"text":"... Thank you, Kruger.","source_cn":"……谢谢您，克鲁格。","status":"matched","hash_xxh64":"0x674501E015953602","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1120247005:1":{"text":"You've made progress, Kojin.","source_cn":"你进步了，库金。","status":"matched","hash_xxh64":"0x8BE8BA349C1A9FC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1120247006:0":{"text":"But not enough to beat you...","source_cn":"但还比不上你，不是吗？","status":"matched","hash_xxh64":"0x04CF6FB19EB79AD6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1120247007:1":{"text":"Yes, you still lack refinement.","source_cn":"嗯，还缺点火候。","status":"matched","hash_xxh64":"0xF6E273FB309C163C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1120247008:1":{"text":"... Soren! Now's not the time to say things like that!","source_cn":"……索恩！这种时候还是别这么说啦！","status":"matched","hash_xxh64":"0x0CB720E884FC7B25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1120247009:2":{"text":"No matter. Next time we meet, I'll definitely win.","source_cn":"没关系。等下次见面，我会再和你决斗一场的。","status":"matched","hash_xxh64":"0x52E3F280EB8F653A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1120247010:1":{"text":"I'll be waiting, then.","source_cn":"那我就等着了。","status":"matched","hash_xxh64":"0x314E43F1602855A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1120247011:1":{"text":"You two...","source_cn":"你们两个……","status":"matched","hash_xxh64":"0x123803121C418040","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:19:1120247011":{"text":"You two...","source_cn":"你们两个……","status":"matched","hash_xxh64":"0x123803121C418040","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1120247012:1":{"text":"I was thinking the same thing, hah!","source_cn":"哈哈，我也这么觉得。","status":"matched","hash_xxh64":"0x1805A424BA84C824","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1120247013:1":{"text":"By the way, we're holding a clan celebration later. It'll be a grand feast, you're welcome to join us.","source_cn":"对了，稍后族内会举行一场庆祝，有一顿大餐，欢迎赏脸参与。","status":"matched","hash_xxh64":"0x0E97BDB94C018C3F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1120247014:0":{"text":"Nice, I love a good meal!","source_cn":"哇，竟然还有大餐！","status":"matched","hash_xxh64":"0x3A55ABA5FFCD381E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1120247015:0":{"text":"The clan has prepared a sumptuous feast to celebrate the new chief.","source_cn":"为了庆祝新族长的诞生，族人准备了美味的食物。","status":"matched","hash_xxh64":"0x08875D1779F0A67C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1120247016:0":{"text":"I guess we'll have to go then, right?","source_cn":"既然如此，那我们一定要去了！对吧？","status":"matched","hash_xxh64":"0x8F286B48727631FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1120247017:0":{"text":"... I'll accompany you.","source_cn":"……我可以陪你们去。","status":"matched","hash_xxh64":"0xC0162169CFCEB180","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1120247018:0":{"text":"Exactly, we can't miss out on all the good food! Let's go!","source_cn":"就当是陪我！走吧！","status":"matched","hash_xxh64":"0x57C673C4E1D32DE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:0:1":{"text":"You looked good out there.","source_cn":"看起来还挺好的","status":"matched_runtime_gender","hash_xxh64":"0xE3E78B7C363F5156","variant_status":"runtime_gender_keys_target_same","male":"You looked good out there.","female":"You looked good out there.","variant_male_record_index":"63448","variant_female_record_index":"63449","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:1:2":{"text":"You looked better than before.","source_cn":"看起来比之前好多了","status":"matched_runtime_gender","hash_xxh64":"0xA5B256DCCEC6AC1D","variant_status":"runtime_gender_keys_target_same","male":"You looked better than before.","female":"You looked better than before.","variant_male_record_index":"63450","variant_female_record_index":"63451","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:29:1101020269:0":{"text":"The match ends, and the winner is decided. Kruger is now the new leader of the Grimmaw Clan.","source_cn":"胜负已分——克鲁格将成为黑嚎氏族的新任族长。","status":"matched","hash_xxh64":"0x7F0D2EB32A9E56AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:库金":{"text":"Kojin","source":"库金","status":"matched_dialogue_flow"},"speaker:克鲁格":{"text":"Kruger","source":"克鲁格","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"},"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":31,"localized_text_count":26,"speaker_count":5}}