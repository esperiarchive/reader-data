{"asset_key":"timeline/env_story_11202340","episode":"timeline","category":"env_story","story_id":"11202340","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1120232001:":{"text":"Orson's funeral is starting soon...","source_cn":"奥格的葬礼就快开始了……","status":"matched","hash_xxh64":"0x160DBFF26C2B254A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120232002:":{"text":"Will he really come?","source_cn":"他，会过来吗？","status":"matched","hash_xxh64":"0xF3B3D0A9BAB7AF51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120232003:":{"text":"I'm sure Soren will do the right thing.","source_cn":"我相信索恩会做出正确的决定。","status":"matched_runtime_gender","hash_xxh64":"0x5CC2C3535F7393B9","variant_status":"runtime_gender_keys_target_same","male":"I'm sure Soren will do the right thing.","female":"I'm sure Soren will do the right thing.","variant_male_record_index":"118426","variant_female_record_index":"118427","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120233001:":{"text":"Soren! You came!","source_cn":"索恩，你果然来了！","status":"matched","hash_xxh64":"0x0EDCB6121DC65C15","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1120233002:":{"text":"I knew you'd come.","source_cn":"我知道你会来。","status":"matched","hash_xxh64":"0x542A14AC6DE9B783","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120234001:0":{"text":"Soren said he wasn't even sure himself if he'd make the right decision when the time came.","source_cn":"索恩说，连他自己都不确定到时候会做出什么样的选择。","status":"matched","hash_xxh64":"0x0CF444F4C15BD5D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120234002:0":{"text":"But it doesn't matter! He has his own plans.","source_cn":"不过没关系啦，他应该有自己的计划。","status":"matched","hash_xxh64":"0xE718E47554DB87B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120234003:1":{"text":"Oh! Those Grimmaw clansmen are taking Orson's body away...","source_cn":"啊！那些黑嚎族人把奥格抬走了……","status":"matched","hash_xxh64":"0x25E5263D17F2B4E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120234004:2":{"text":"This is the custom of the Grimmaw Clan. For a chief's funeral, they carry him to quicksand.","source_cn":"这是黑嚎氏族的风俗。族长的葬礼，会由族民们抬着他进入流...","status":"matched","hash_xxh64":"0xEC829F795362C38F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120234005:1":{"text":"They place him on the quicksand and let it swallow him down into the deepest reaches of the desert.","source_cn":"然后把他放在流沙中心，让金黄的流沙包裹着他，一同到达沙...","status":"matched","hash_xxh64":"0x359DF1D31B7A660B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120234006:1":{"text":"The Grimmaw are born in the desert, and they are buried there as well. The quicksand devours all, good and evil alike.","source_cn":"黑嚎氏族生于沙漠，也终将葬于沙漠。流沙会吞噬一切，不分...","status":"matched","hash_xxh64":"0xE291D43CE28B35B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1120234007:1":{"text":"But the past is past now. May he rest in peace amidst the golden sands.","source_cn":"不过现在一切都结束了。希望他能在这片沙漠之中安息。","status":"matched","hash_xxh64":"0xEE751B15A5C224B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1120234008:1":{"text":"Magister, look! Kojin put something onto Orson's body...","source_cn":"主人你看，库金好像把什么东西挂在了奥格身上……","status":"matched_runtime_gender","hash_xxh64":"0xE53DE4C7FEEE94BE","variant_status":"runtime_gender_keys_target_same","male":"Magister, look! Kojin put something onto Orson's body...","female":"Magister, look! Kojin put something onto Orson's body...","variant_male_record_index":"118435","variant_female_record_index":"118436","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1120234009:1":{"text":"Could it be that Tether of Protection Kojin mentioned before?","source_cn":"那个莫非就是库金之前说的护途之链？","status":"matched","hash_xxh64":"0x94E662C229FBBBF6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1120234010:0":{"text":"That's right. If Soren were here, he would've had to do the same.","source_cn":"嗯。如果索恩在的话，他也需要做一样的事情。","status":"matched","hash_xxh64":"0x1F2B9453C62B7735","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1120232001:":{"text":"Orson's funeral is starting soon...","source_cn":"奥格的葬礼就快开始了……","status":"matched","hash_xxh64":"0x160DBFF26C2B254A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1120232002:":{"text":"Will he really come?","source_cn":"他，会过来吗？","status":"matched","hash_xxh64":"0xF3B3D0A9BAB7AF51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1120232003:":{"text":"I'm sure Soren will do the right thing.","source_cn":"我相信索恩会做出正确的决定。","status":"matched_runtime_gender","hash_xxh64":"0x5CC2C3535F7393B9","variant_status":"runtime_gender_keys_target_same","male":"I'm sure Soren will do the right thing.","female":"I'm sure Soren will do the right thing.","variant_male_record_index":"118426","variant_female_record_index":"118427","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1120233001:":{"text":"Soren! You came!","source_cn":"索恩，你果然来了！","status":"matched","hash_xxh64":"0x0EDCB6121DC65C15","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1120233002:":{"text":"I knew you'd come.","source_cn":"我知道你会来。","status":"matched","hash_xxh64":"0x542A14AC6DE9B783","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1120234011:0":{"text":"I just want to put these offerings where they belong.","source_cn":"我只是希望物归原主而已。","status":"matched","hash_xxh64":"0xFD8652518BEC4E58","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1120234012:1":{"text":"Everything's set. Let us begin.","source_cn":"……陪葬品齐全了。我们开始吧。","status":"matched","hash_xxh64":"0x5981391587AD986B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1120234013:0":{"text":"Orson... He's already gone.","source_cn":"奥格……已经完全消失了。","status":"matched","hash_xxh64":"0x028139A1BF1C7711","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1120234014:0":{"text":"The desert devours all.","source_cn":"沙漠会吞噬一切。","status":"matched","hash_xxh64":"0xFC5CC62577644CA8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1120234015:0":{"text":"I don't know why, but I just feel... empty inside...","source_cn":"不知道为什么，总感觉心里空落落的……","status":"matched","hash_xxh64":"0xA710ED1D629DB8C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1120234016:1":{"text":"Everyone, thank you all for attending the funeral of Orson, chief of the Grimmaw Clan—and my father.","source_cn":"各位，感谢你们如约出席黑嚎族长，我的父亲，奥格的葬礼。","status":"matched","hash_xxh64":"0xCAA950D1A2DFE6D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1120234017:1":{"text":"If you have time afterward, we will hold a clan meeting in the evening—","source_cn":"如果你们之后有空的话，晚上我们还有一场族内的——","status":"matched","hash_xxh64":"0x2CEA64BD9C91314A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1120234018:1":{"text":"It's late and we'd best be getting back. I don't think we'll be seeing you again.","source_cn":"时候不早，我们已经准备回去了。之后应该也不会再见了。","status":"matched","hash_xxh64":"0x23D316DE952919F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1120234019:0":{"text":"Ack! Soren means to say... Thanks for your help with the funeral, and... We'll see you around!","source_cn":"呃，索恩的意思是……感谢你在葬礼上的帮助，我们有缘再见！","status":"matched","hash_xxh64":"0x2762FBBEB7E124C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:30:1120234019":{"text":"Ack! Soren means to say... Thanks for your help with the funeral, and... We'll see you around!","source_cn":"呃，索恩的意思是……感谢你在葬礼上的帮助，我们有缘再见！","status":"matched","hash_xxh64":"0x2762FBBEB7E124C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1120234020:0":{"text":"... I understand. Farewell.","source_cn":"……我明白了。各位，再会。","status":"matched","hash_xxh64":"0xDE99397FE2A5998B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:30:0:1":{"text":"We can all leave together.","source_cn":"我们可以陪你一起离开","status":"matched_runtime_gender","hash_xxh64":"0x2E73A284A4ACD1A7","variant_status":"runtime_gender_keys_target_same","male":"We can all leave together.","female":"We can all leave together.","variant_male_record_index":"62966","variant_female_record_index":"62967","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:30:1:2":{"text":"It's your choice.","source_cn":"现在离开，应该还来得及","status":"matched_runtime_gender","hash_xxh64":"0xC007A18FC5D0054A","variant_status":"runtime_gender_keys_target_same","male":"It's your choice.","female":"It's your choice.","variant_male_record_index":"62968","variant_female_record_index":"62969","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:33:11010203:0":{"text":"At last, Soren attends Orson's funeral.","source_cn":"索恩最终还是出席了奥格的葬礼。","status":"matched","hash_xxh64":"0x4FCF44E69B0334B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:34:11010202:0":{"text":"Orson's funeral is about to begin, but Soren is nowhere to be found.","source_cn":"奥格的葬礼就要开始了，索恩却迟迟没有出现。","status":"matched","hash_xxh64":"0x42F4D7B6492D0592","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"},"speaker:库金":{"text":"Kojin","source":"库金","status":"matched_dialogue_flow"},"speaker:主角":{"text":"Player","source":"主角","status":"matched_dialogue_flow"},"speaker:克鲁格":{"text":"Kruger","source":"克鲁格","status":"matched_dialogue_flow"},"speaker:布鲁特斯":{"text":"Brutus","source":"布鲁特斯","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":44,"localized_text_count":35,"speaker_count":8}}