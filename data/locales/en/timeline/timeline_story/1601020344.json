{"asset_key":"timeline/timeline_story_1601020344","episode":"timeline","category":"timeline_story","story_id":"1601020344","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:1:1620230001:":{"text":"By royal decree, Silven Grenvalden is hereby conferred the title of Knight.","source_cn":"今敕封休·格伦沃顿为骑士","status":"matched","hash_xxh64":"0x849CA7004ECB173A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1620230002:":{"text":"May he forever uphold the cause of justice, face all perils without fear, and remain steadfast to his oath.","source_cn":"愿他永存正义之心，不畏艰险，不违誓言","status":"matched","hash_xxh64":"0x7458D95C2163AAC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1620230003:":{"text":"I pledge to honor the oath of knighthood.","source_cn":"我必守骑士之誓","status":"matched","hash_xxh64":"0x4740DDAFA8F69310","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:1:1620230004:":{"text":"Where the oath points, there glory returns!","source_cn":"誓约所指，荣光所归！","status":"matched","hash_xxh64":"0xF9E048B3F88A674C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:佩吉":{"text":"Peggy","source":"佩吉","status":"matched_dialogue_flow"},"speaker:休":{"text":"Silven","source":"休","status":"matched_di