{"asset_key":"ep7/gameplay_story_17600020","episode":"ep7","category":"gameplay_story","story_id":"17600020","schema_version":1,"lang":"en","texts":{"narration:1:1760002001:0":{"text":"They are up and awake as soon as day breaks.","source_cn":"天才刚亮，孩子们便早早醒来","status":"matched","hash_xxh64":"0x591FABEF09AD4680","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:2:1760002002:0":{"text":"After saying goodbye to Dolly, you make your way to the Dark Forest...","source_cn":"与多莉告别后，你们踏上了前往薄暮丛林的路途……","status":"matched_runtime_gender","hash_xxh64":"0x7B6C5201E74E9CC0","variant_status":"runtime_gender_keys_target_same","male":"After saying goodbye to Dolly, you make your way to the Dark Forest...","female":"After saying goodbye to Dolly, you make your way to the Dark Forest...","variant_male_record_index":"238090","variant_female_record_index":"238091","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1760002003:0":{"text":"What a beautiful forest! There are lovely flowers and clear streams everywhere...","source_cn":"真是漂亮的森林啊！到处都是美丽的花朵，还有清澈的小溪……","status":"matched","hash_xxh64":"0xD2376E7FA0502F9A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1760002004:0":{"text":"A forest like this would be full of Digimon back in our world!","source_cn":"如果是在数码世界，这片森林里一定会住着很多数码宝贝吧？","status":"matched","hash_xxh64":"0x225217234B24DABC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","docu