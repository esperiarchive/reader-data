{"asset_key":"ep7/quest_story_17209195","episode":"ep7","category":"quest_story","story_id":"17209195","schema_version":1,"lang":"en","texts":{"say:0:1720919501:0":{"text":"With that, the butler turns on his heel and strides off, leaving Haria standing there in stunned silence.","source_cn":"管家扔下这句话后头也不回地快步离开了，只留下赫蒂奇一人...","status":"matched","hash_xxh64":"0x570147F2B005736F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1720919502:0":{"text":"Sir... I messed it up again, didn't I?","source_cn":"老师……我、我是不是又搞砸了？","status":"matched","hash_xxh64":"0xF6605F291C026C44","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1720919503:0":{"text":"You did. You made it sound like an interrogation! Stay close and watch. I'll talk to that maid myself. Maybe you'll learn something!","source_cn":"你提问的方式太直接、目的性太强了！等会儿我亲自出马套那...","status":"matched","hash_xxh64":"0xBBB54760CB61073E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"},"speaker:实习记者赫蒂奇":{"text":"Intern Haria","source":"实习记者赫蒂奇","status":"matched_dialogue_flow"},"speaker:记者马斯卡":{"text":"Reporter Maska","source":"记者马斯卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":3}}