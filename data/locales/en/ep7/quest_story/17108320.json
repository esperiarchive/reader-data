{"asset_key":"ep7/quest_story_17108320","episode":"ep7","category":"quest_story","story_id":"17108320","schema_version":1,"lang":"en","texts":{"say:1:1710832001:0":{"text":"Is it... over?","source_cn":"结束了吗……？","status":"matched","hash_xxh64":"0xF9229709ECA3EE99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1710832001":{"text":"Is it... over?","source_cn":"结束了吗……？","status":"matched","hash_xxh64":"0xF9229709ECA3EE99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1710832002:1":{"text":"Magister Merlin, I can assist now.","source_cn":"梅林大人，我现在已经可以做到这些了。","status":"matched_runtime_gender","hash_xxh64":"0xF9DC69D78EA3A5F8","variant_status":"runtime_gender_keys_target_same","male":"Magister Merlin, I can assist now.","female":"Magister Merlin, I can assist now.","variant_male_record_index":"227388","variant_female_record_index":"227389","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710832003:0":{"text":"Please, allow me to help.","source_cn":"请让我来协助您。","status":"matched_runtime_gender","hash_xxh64":"0xD40C9D155B641A98","variant_status":"runtime_gender_keys_target_same","male":"Please, allow me to help.","female":"Please, allow me to help.","variant_male_record_index":"227390","variant_female_record_index":"227391","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710832004:0":{"text":"Beyond that, Cyran escaped.","source_cn":"除此之外，那个亵渎者，迪尔格雷，他逃脱了。","status":"matched_runtime_gender","hash_xxh64":"0x4781B7941C7C3B62","variant_status":"runtime_gender_keys_target_same","male":"Beyond that, Cyran escaped.","female":"Beyond that, Cyran escaped.","variant_male_record_index":"227392","variant_female_record_index":"227393","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1710832004":{"text":"Beyond that, Cyran escaped.","source_cn":"除此之外，那个亵渎者，迪尔格雷，他逃脱了。","status":"matched_runtime_gender","hash_xxh64":"0x4781B7941C7C3B62","variant_status":"runtime_gender_keys_target_same","male":"Beyond that, Cyran escaped.","female":"Beyond that, Cyran escaped.","variant_male_record_index":"227392","variant_female_record_index":"227393","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1710832005:0":{"text":"Whatever he's planning, it won't be good.","source_cn":"他一定在谋划着更险恶的事情。我们得尽快找到他。","status":"matched_runtime_gender","hash_xxh64":"0x3C329FC374ED0F3C","variant_status":"runtime_gender_keys_target_same","male":"Whatever he's planning, it won't be good.","female":"Whatever he's planning, it won't be good.","variant_male_record_index":"227394","variant_female_record_index":"227395","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1710832005":{"text":"Whatever he's planning, it won't be good.","source_cn":"他一定在谋划着更险恶的事情。我们得尽快找到他。","status":"matched_runtime_gender","hash_xxh64":"0x3C329FC374ED0F3C","variant_status":"runtime_gender_keys_target_same","male":"Whatever he's planning, it won't be good.","female":"Whatever he's planning, it won't be good.","variant_male_record_index":"227394","variant_female_record_index":"227395","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1710832006:0":{"text":"Just as you begin tracing Cyran's magical signature, a bloodied guard rushes over.","source_cn":"就在你准备追踪迪尔格雷的魔力时，一个浑身是伤的守备军从...","status":"matched_runtime_gender","hash_xxh64":"0xBF0AC6174732AB51","variant_status":"runtime_gender_keys_target_same","male":"Just as you begin tracing Cyran's magical signature, a bloodied guard rushes over.","female":"Just as you begin tracing Cyran's magical signature, a bloodied guard rushes over.","variant_male_record_index":"227396","variant_female_record_index":"227397","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1710832007:0":{"text":"Magister! Magister Merlin!","source_cn":"阁下！梅林阁下！","status":"matched_runtime_gender","hash_xxh64":"0x52EC3305A7E36784","variant_status":"runtime_gender_keys_target_same","male":"Magister! Magister Merlin!","female":"Magister! Magister Merlin!","variant_male_record_index":"227398","variant_female_record_index":"227399","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1710832008:0":{"text":" Y-Your Majesty!","source_cn":"……大、大帝陛下！","status":"matched","hash_xxh64":"0x15E5B573744693EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1710832009:0":{"text":"Report, soldier!","source_cn":"讲重点，士兵！","status":"matched","hash_xxh64":"0xF3D2C6778BC4DCCC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1710832010:0":{"text":"The palace, it's under attack!","source_cn":"王宫、王宫遇袭！","status":"matched","hash_xxh64":"0x3B4C29EB558C2858","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1710832011:0":{"text":"What?!","source_cn":"什么？！发生了什么事？！","status":"matched","hash_xxh64":"0x03A96954DD52C0E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1710832012:0":{"text":"The traitor, Cyran! He forced his way in!","source_cn":"那个叛徒！迪尔格雷！他、他强行闯入了王宫！","status":"matched","hash_xxh64":"0x6EBA4DACD49A3AE4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1710832013:1":{"text":"He injured dozens of guards.","source_cn":"他打伤了几十名守备军同僚！","status":"matched","hash_xxh64":"0xB26A8D4F1B0AFC75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1710832014:1":{"text":"And he's heading straight for the King's chambers!","source_cn":"正朝着国王陛下的寝殿去了！","status":"matched","hash_xxh64":"0xCDD85C90A790021B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1710832015:1":{"text":"Your blood runs cold. You and Rolan both know that the King is weakened right now.","source_cn":"你和罗兰的心猛地一沉。你们比谁都清楚——国王正处于生命...","status":"matched_runtime_gender","hash_xxh64":"0xCCAC47804B74F34C","variant_status":"runtime_gender_keys_target_same","male":"Your blood runs cold. You and Rolan both know that the King is weakened right now.","female":"Your blood runs cold. You and Rolan both know that the King is weakened right now.","variant_male_record_index":"227408","variant_female_record_index":"227409","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1710832016:1":{"text":"And the Queen is exhausted from using her foresight and helping Aurora.","source_cn":"而王后，在连续使用了意象预视和协助奥罗菈之后，也已精疲力竭！","status":"matched","hash_xxh64":"0x74D03F56131B8D99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1710832017:1":{"text":"Father! Mother! I have to go!","source_cn":"父王！母后！我得回去！","status":"matched","hash_xxh64":"0xB19CD46854723C38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1710832018:1":{"text":"Peggy rushes forward, but Rolan steps in front of her.","source_cn":"佩吉几乎是本能地就要向王宫冲去，但被罗兰伸手拦住。","status":"matched","hash_xxh64":"0x66090C8AC47CD710","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1710832019:1":{"text":"You both know she cannot return to the palace.","source_cn":"你们很清楚，现在情况危急，佩吉绝不能返回王宫！","status":"matched_runtime_gender","hash_xxh64":"0xC928E47CD16FF431","variant_status":"runtime_gender_keys_target_same","male":"You both know she cannot return to the palace.","female":"You both know she cannot return to the palace.","variant_male_record_index":"227413","variant_female_record_index":"227414","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1710832020:1":{"text":"You exchange a glance with Rolan and nod.","source_cn":"你与罗兰对视一眼，默契地互相点了点头。","status":"matched_runtime_gender","hash_xxh64":"0x41F584EEB8C083DF","variant_status":"runtime_gender_keys_target_same","male":"You exchange a glance with Rolan and nod.","female":"You exchange a glance with Rolan and nod.","variant_male_record_index":"227415","variant_female_record_index":"227416","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1710832021:0":{"text":"We must split up!","source_cn":"我们必须分头行动！","status":"matched","hash_xxh64":"0x062F218EF38D3B8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1710832022:0":{"text":"Merlin, return to the palace at once.","source_cn":"梅林，你立刻回援王宫！","status":"matched_runtime_gender","hash_xxh64":"0x4562016D76C0CC4A","variant_status":"runtime_gender_keys_target_same","male":"Merlin, return to the palace at once.","female":"Merlin, return to the palace at once.","variant_male_record_index":"227418","variant_female_record_index":"227419","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1710832023:1":{"text":"Your magic is unparalleled. Only you can intercept him before he succeeds.","source_cn":"你的魔法是最厉害的——只有你能在他得手前穿过防线，拦截住他！","status":"matched_runtime_gender","hash_xxh64":"0xB3332E897E28CD4C","variant_status":"runtime_gender_keys_target_same","male":"Your magic is unparalleled. Only you can intercept him before he succeeds.","female":"Your magic is unparalleled. Only you can intercept him before he succeeds.","variant_male_record_index":"227420","variant_female_record_index":"227421","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1710832024:1":{"text":"No! I'm going too! They're my parents!","source_cn":"不！我也要去！他们是我的父母！","status":"matched","hash_xxh64":"0xD691B39F8B75F1F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1710832025:0":{"text":"Your battle is here, Princess!","source_cn":"你的战斗在这里，公主！","status":"matched","hash_xxh64":"0xE665691A0A52EE2F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1710832026:0":{"text":"The rift is the source of this disaster! Cassadee and I must focus entirely on sealing it.","source_cn":"裂隙是灾难的源头！我和科丝蒂必须集中力量关闭它！","status":"matched","hash_xxh64":"0xA3D16E9229BA18F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1710832027:0":{"text":"Once we begin, we'll be defenseless...","source_cn":"但是，一旦开始，我们两人都会毫无防备……","status":"matched","hash_xxh64":"0x028F6AFBB72C7BF9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1710832028:0":{"text":"Hendrik is protecting the civilians. Merlin must save the King. We need a steadfast guardian to hold the line.","source_cn":"亨德里克在保护民众，梅林必须去救国王！而我们，需要一个...","status":"matched_runtime_gender","hash_xxh64":"0x75FEF4849ACB27EF","variant_status":"runtime_gender_keys_target_same","male":"Hendrik is protecting the civilians. Merlin must save the King. We need a steadfast guardian to hold the line.","female":"Hendrik is protecting the civilians. Merlin must save the King. We need a steadfast guardian to hold the line.","variant_male_record_index":"227426","variant_female_record_index":"227427","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1710832029:0":{"text":"Your brother fled. Will you flee as well?","source_cn":"你的哥哥逃了。现在，你要逃吗？","status":"matched","hash_xxh64":"0x1E8470BD4CE4A480","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1710832030:0":{"text":"Or will you stand...","source_cn":"还是……你要留在这里，守护我们——","status":"matched","hash_xxh64":"0x7409BF9C0B834D70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1710832031:0":{"text":"...and defend this city behind you?","source_cn":"守护你身后的这座城市？！","status":"matched","hash_xxh64":"0x9077B3ED88E82677","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1710832032:1":{"text":"... I understand.","source_cn":"……我明白了。<key:dialog27>","status":"matched","hash_xxh64":"0xFB78536346E1ACDD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1710832033:1":{"text":"I will protect you. I won't let anything come near you!","source_cn":"我会保护你们！我绝不会让任何东西，再靠近您一步！","status":"matched","hash_xxh64":"0xF8C6653B7837E17B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:46:1710832033":{"text":"I will protect you. I won't let anything come near you!","source_cn":"我会保护你们！我绝不会让任何东西，再靠近您一步！","status":"matched","hash_xxh64":"0xF8C6653B7837E17B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1710832034:1":{"text":"You don't wait for an answer. You gather magic beneath your feet and race toward the palace at full speed.","source_cn":"你不再多言，魔力在脚下汇聚，全速返回了王宫。","status":"matched_runtime_gender","hash_xxh64":"0x5EA41A014F019D73","variant_status":"runtime_gender_keys_target_same","male":"You don't wait for an answer. You gather magic beneath your feet and race toward the palace at full speed.","female":"You don't wait for an answer. You gather magic beneath your feet and race toward the palace at full speed.","variant_male_record_index":"227433","variant_female_record_index":"227434","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:46:0:1":{"text":"I'll protect your father.","source_cn":"佩吉，我会立刻赶到","status":"matched_runtime_gender","hash_xxh64":"0x110140CD66E80520","variant_status":"runtime_gender_keys_target_same","male":"I'll protect your father.","female":"I'll protect your father.","variant_male_record_index":"89047","variant_female_record_index":"89048","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:46:1:2":{"text":"Trust me.","source_cn":"罗兰，放心","status":"matched_runtime_gender","hash_xxh64":"0x301ABB5C9D6F6A6A","variant_status":"runtime_gender_keys_target_same","male":"Trust me.","female":"Trust me.","variant_male_record_index":"89049","variant_female_record_index":"89050","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"I'll try to track his magic.","source_cn":"我试试魔力追踪","status":"matched_runtime_gender","hash_xxh64":"0xD49711C9106E220E","variant_status":"runtime_gender_keys_target_same","male":"I'll try to track his magic.","female":"I'll try to track his magic.","variant_male_record_index":"89045","variant_female_record_index":"89046","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"We must find him.","source_cn":"必须得找到他","status":"matched_runtime_gender","hash_xxh64":"0x99C750C648513F3A","variant_status":"runtime_gender_keys_target_same","male":"We must find him.","female":"We must find him.","variant_male_record_index":"89041","variant_female_record_index":"89042","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"He's planning something worse.","source_cn":"他一定还有后手","status":"matched_runtime_gender","hash_xxh64":"0xB2590B01041362B5","variant_status":"runtime_gender_keys_target_same","male":"He's planning something worse.","female":"He's planning something worse.","variant_male_record_index":"89043","variant_female_record_index":"89044","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"We still need to seal the rift Cyran summoned.","source_cn":"还得想办法封印迪尔格雷召唤的裂隙","status":"matched_runtime_gender","hash_xxh64":"0x0C4BFE4A42E451DC","variant_status":"runtime_gender_keys_target_same","male":"We still need to seal the rift Cyran summoned.","female":"We still need to seal the rift Cyran summoned.","variant_male_record_index":"89039","variant_female_record_index":"89040","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:佩吉":{"text":"Peggy","source":"佩吉","status":"matched_dialogue_flow"},"speaker:科丝蒂":{"text":"Cassadee","source":"科丝蒂","status":"matched_dialogue_flow"},"speaker:罗兰大帝":{"text":"King Rolan","source":"罗兰大帝","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"},"speaker:受伤的守备军":{"text":"Injured Guard","source":"受伤的守备军","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":45,"localized_text_count":44,"speaker_count":5}}