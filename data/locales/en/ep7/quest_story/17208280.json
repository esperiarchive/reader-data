{"asset_key":"ep7/quest_story_17208280","episode":"ep7","category":"quest_story","story_id":"17208280","schema_version":1,"lang":"en","texts":{"say:1:1720828001:1":{"text":"Heh... That particular chapter remains quite vivid in my memory.","source_cn":"呵呵……关于那段过往，时至今日，我依旧记得非常清楚。","status":"matched_runtime_gender","hash_xxh64":"0x1F29852B20320DFF","variant_status":"runtime_gender_keys_target_same","male":"Heh... That particular chapter remains quite vivid in my memory.","female":"Heh... That particular chapter remains quite vivid in my memory.","variant_male_record_index":"230457","variant_female_record_index":"230458","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1720828002:1":{"text":"Among the many who have passed through this pavilion, only one was so young, so deft with cards, and so knowing of when to press and when to withdraw.","source_cn":"毕竟牌技超群、懂得进退自制，又如此年轻的，即使在众多光...","status":"matched_runtime_gender","hash_xxh64":"0xF666E034D256D69D","variant_status":"runtime_gender_keys_target_same","male":"Among the many who have passed through this pavilion, only one was so young, so deft with cards, and so knowing of when to press and when to withdraw.","female":"Among the many who have passed through this pavilion, only one was so young, so deft with cards, and so knowing of when to press and when to withdraw.","variant_male_record_index":"230459","variant_female_record_index":"230460","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1720828003:0":{"text":"I lost again... I spent half a month saving those Azure Tokens!","source_cn":"又输了……我的青符……我攒了大半个月的青符……","status":"matched","hash_xxh64":"0x7D2C01FC40240868","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1720828004:1":{"text":"This isn't right! I calculated everything. Something's wrong! Did you tamper with the game?!","source_cn":"不可能，这不对！我算的明明不是这样的，肯定是哪里出问题...","status":"matched","hash_xxh64":"0xCB6832673B1FE712","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1720828005:1":{"text":"Oh, come now. It's called skill, my dear friend. Use your head... rely on strategy and psychology.","source_cn":"这叫牌技，亲爱的朋友。多动动脑子，用上点计谋和心理战术...","status":"matched","hash_xxh64":"0x2E907009E4D40F99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1720828006:1":{"text":"After all, you're not truly a tombstone, are you?","source_cn":"毕竟你又不是一块真正的墓碑，对吧？","status":"matched","hash_xxh64":"0x08A4C26F9F9EE260","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1720828007:1":{"text":"Hey!","source_cn":"你——<key:dialog21>","status":"matched","hash_xxh64":"0xF9F1D5B9FC2CD630","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1720828008:1":{"text":"Now then, if you'll excuse me, I believe I'll go collect my winnings.","source_cn":"现在——如果您不介意的话——我要先走一步，去兑换青符了。","status":"matched","hash_xxh64":"0xE9FFDA516084952D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1720828009:1":{"text":"A moment, if you please.","source_cn":"这位顾客，请留步。","status":"matched","hash_xxh64":"0x5E48E43311A1A742","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1720828010:1":{"text":"What is it? A problem with the tokens? Or has the pavilion decided my victory was improper?","source_cn":"……怎么，青符有问题？还是说，会馆也认为我赢得不光彩？","status":"matched","hash_xxh64":"0x42762BBAD2A3F143","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1720828011:1":{"text":"No, please don't misunderstand.","source_cn":"不，您误会了。","status":"matched","hash_xxh64":"0x006E0F1BBD9B38CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1720828012:1":{"text":"Our proprietor wishes to meet you.","source_cn":"是我们的馆主，他想要见您一面。","status":"matched","hash_xxh64":"0x3E2B2924467A07A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1720828013:1":{"text":"The proprietor?!","source_cn":"馆主？！","status":"matched","hash_xxh64":"0xF059F7AFDF5634F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1720828014:1":{"text":"I've been coming here for ages, and I've never even seen him...","source_cn":"来了会馆这么久，我还从没见过他……","status":"matched","hash_xxh64":"0xC47369A19FF3CD3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1720828015:1":{"text":"I've won a lot lately, but surely not enough to attract the proprietor's attention.","source_cn":"我最近是赢了不少，但就这点数量，还不至于惊动霁月会馆的...","status":"matched","hash_xxh64":"0x9D1B8CCE7AA324A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1720828016:1":{"text":"Your concern is quite understandable. Let me assure you, the pavilion guarantees the safety and rightful earnings of every guest.","source_cn":"您的担心我能够理解，我们向您承诺，会馆会保证每一位顾客...","status":"matched","hash_xxh64":"0xA30BF4E116AF54C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1720828017:1":{"text":"This way, please.","source_cn":"请跟我来吧。","status":"matched","hash_xxh64":"0x4995F7ADC9C77F4F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1720828018:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1720828019:1":{"text":"As the glimmerbloom follows the attendant, a crow perched on a beam flutters its wings and takes flight, disappearing toward the second floor.","source_cn":"荧荧花跟上司宾的同时，一只端坐在横梁上的乌鸦扑打双翼，...","status":"matched","hash_xxh64":"0xAF8271E3201493F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1720828020:1":{"text":"Sir, your guest has arrived. I'll return to my duties.","source_cn":"馆主，顾客已经到了。那么，我先继续回去工作了。","status":"matched","hash_xxh64":"0x4131BADC0DDDDBE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1720828021:1":{"text":"My thanks, Mei.","source_cn":"辛苦了，梅。","status":"matched","hash_xxh64":"0xC5BDBDA4710E0ABF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1720828022:1":{"text":"Welcome to the Twilight Pavilion, Valen.","source_cn":"欢迎光临霁月会馆，维伦。","status":"matched","hash_xxh64":"0xA0A50C2F675CD103","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1720828023:1":{"text":"Since this is a private conversation, shall we dispense with disguises?","source_cn":"既然这是一场私人会谈，就让我们以原本的面貌交流，如何？","status":"matched","hash_xxh64":"0x09AC2FA27007615F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1720828024:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1720828025:1":{"text":"I am Eryndor, the proprietor of this pavilion.","source_cn":"初次见面，在下名为埃德加，是霁月会馆的馆主。","status":"matched","hash_xxh64":"0x81301AEA04CCCD31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1720828026:1":{"text":"You don't seem surprised that I know your name.","source_cn":"阁下似乎对我知道你名字这件事并不惊讶。","status":"matched","hash_xxh64":"0xB3EE4F418C9E6B35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1720828027:1":{"text":"The master of this place who knows his guests? Sounds about right to me.","source_cn":"霁月会馆的馆主，对顾客的信息了如指掌，不是很正常吗？","status":"matched","hash_xxh64":"0x0A181A3658D5EF43","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1720828028:1":{"text":"Mm... if I were merely that, it would not be so simple.","source_cn":"呵……倘若在下只是寻常的馆主，是做不到这件事的。","status":"matched","hash_xxh64":"0x911012527DE47761","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1720828029:1":{"text":"You understand that as well... don't you?","source_cn":"你同样清楚这点，不是么？","status":"matched","hash_xxh64":"0x04033E7556DCBBC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1720828030:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1720828031:1":{"text":"A word of advice. Within these walls, it is far wiser to let your value be known than to hide behind modesty.","source_cn":"不妨听听我的建议：在会馆，展现自己的价值，远比示弱有用。","status":"matched","hash_xxh64":"0xCD8B386BB51E016B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1720828032:1":{"text":"All I've heard is that Savannah's got some massive information network.","source_cn":"我只听说赛凡纳里有个秘密的情报组织，他们有一套规模庞大...","status":"matched","hash_xxh64":"0x046C7FA1E7855050","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1720828033:1":{"text":"And this pavilion happens to be well-informed. That's all I know.","source_cn":"而霁月会馆恰巧是个消息很灵通的地方。仅此而已，别的我什...","status":"matched","hash_xxh64":"0xE7F52A2B94D6A4E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1720828034:1":{"text":"Is that so? Then allow me to clarify a few things.","source_cn":"哦？既然如此，我便再无偿赠送你几条情报吧。","status":"matched","hash_xxh64":"0x29C6AD4BEFC22BA1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1720828035:1":{"text":"The organization you speak of exists. It is called the Solitaries.","source_cn":"你口中的情报组织的确存在，其名为“隐士”。","status":"matched","hash_xxh64":"0x2FDF70D8A6FAFCC4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1720828036:1":{"text":"And this pavilion... is one of its foundations. As for myself, I oversee both.","source_cn":"而霁月会馆，正是隐士的根据地之一。在下管理着会馆，同时...","status":"matched","hash_xxh64":"0xB3E53E3C9DF888F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:49:1720828037:1":{"text":"... Doesn't interest me.","source_cn":"……我对这些并不感兴趣。","status":"matched","hash_xxh64":"0xE928FE58A212B9A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1720828038:1":{"text":"No? And yet my threads tell me you have already struck bargains with some of our members, gathering information on their behalf.","source_cn":"当真如此？据我所知，你已经在私下里与隐士的成员做交易，...","status":"matched","hash_xxh64":"0xC0CE4A792BF396F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:51:1720828039:0":{"text":"Which is to say, you've already stepped into our web. Leaving entirely is no longer an option.","source_cn":"换言之，你已经进入我们的信息网，早就无法置身事外了。","status":"matched","hash_xxh64":"0x60526D3524631647","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:52:1720828040:1":{"text":"I've just helped people pick up rumors in taverns. Plenty of people do the same.","source_cn":"我只是在酒馆中帮人打听了点事，这里的人多少都会干点这些...","status":"matched","hash_xxh64":"0x9ED98078B5C1EBB6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:53:1720828041:1":{"text":"Heh... there's no need to be on guard. I mean you no harm.","source_cn":"呵呵……无需紧张。我从未打算对你不利。","status":"matched","hash_xxh64":"0x9B39BC4BB900374E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:54:1720828042:1":{"text":"In fact, I invited you here to extend an honor. Join the Solitaries.","source_cn":"今日我叫来你，是希望邀请你加入隐士。","status":"matched","hash_xxh64":"0x24ACB78114131FDE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:55:1720828043:1":{"text":"What...?","source_cn":"……什么？<key:dialog17>","status":"matched","hash_xxh64":"0x77F239262D55F1C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:56:1720828044:1":{"text":"Surprised? The Empire's currents are changing; the tides shift with each passing season. For the Solitaries to hold our place in these waters, we cannot stand still. We must take on those who know how to navigate the deep.","source_cn":"很惊讶么？帝国形式诡谲、局势动荡，隐士要想维持在情报界...","status":"matched","hash_xxh64":"0x940D7635549D16A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:57:1720828045:1":{"text":"And you, Valen, have a sailor's instincts.","source_cn":"隐士需要你这样的人才。","status":"matched","hash_xxh64":"0x7F64D2E638A38541","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:58:1720828046:1":{"text":"You're giving me too much credit. I'm just getting by with street tricks and luck.","source_cn":"谬赞了，我不过是个在街头巷尾讨生活的人。最多也就懂点放...","status":"matched","hash_xxh64":"0xB5D45C7C333B01FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:59:1720828047:1":{"text":"And yet, since entering this pavilion... you haven't lost a single game.","source_cn":"自你进入会馆后，几乎从未输过任何一局牌。如此牌技，实在...","status":"matched","hash_xxh64":"0xCFF9F7C173ED0BDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:60:1720828048:1":{"text":"Call it good fortune.","source_cn":"运气而已。","status":"matched","hash_xxh64":"0x4F13082F60D96A5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:61:1720828049:1":{"text":"Mm. Curious. I seem to recall you saying, \"Use your head... rely on strategy and psychology.\"","source_cn":"哦？但我记忆中，你说的是……“多动动脑子，用上点计谋和...","status":"matched","hash_xxh64":"0x5DD63C164C695A9E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:62:1720828050:0":{"text":"... When did you—","source_cn":"……你什么时候——","status":"matched","hash_xxh64":"0x5A4CF6E801DD77A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:63:1720828051:1":{"text":"Join us, and your questions will be answered.","source_cn":"加入隐士后，你的疑问自然能够得到解答。","status":"matched","hash_xxh64":"0x8F0F3A0B286310B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:64:1720828052:1":{"text":"You're clever. Clever enough to know that entangling yourself with us carries risk.","source_cn":"你是个聪明人，知道与我们牵扯会有风险，故而迟疑。","status":"matched","hash_xxh64":"0xC48EE30668073A81","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:65:1720828053:1":{"text":"And yet, when dealing with our people, you chose to continue anyway.","source_cn":"但与我们的人交易时，你分明知道风险，却依旧选择继续交易...","status":"matched","hash_xxh64":"0x2915C16319582A70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:66:1720828054:1":{"text":"You look after others, don't you? Children in situations not unlike your own. That's why you take risks others would avoid.","source_cn":"据我所知，你还带着许多境况相似的孩子一起生活。所以，你...","status":"matched","hash_xxh64":"0xC5A1AB9C33B56B24","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:67:1720828055:1":{"text":"You've already made your choice, haven't you?","source_cn":"你早已做出了选择，不是么？","status":"matched","hash_xxh64":"0xF90D733EC4FD8FED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:68:1720828056:0":{"text":"That's none of your business.","source_cn":"先生，这与您无关。","status":"matched","hash_xxh64":"0xA7F29312DC75C6F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:69:1720828057:1":{"text":"Your abilities are notable, but alone... you can't protect them. You can't even guarantee your own safety.","source_cn":"你的技巧与能力令人侧目，但只凭你一人，无法在这座城市保...","status":"matched","hash_xxh64":"0xEB15A468BE5EEE01","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:70:1720828058:1":{"text":"The Solitaries can.","source_cn":"但隐士能够做到。","status":"matched","hash_xxh64":"0x51D52A9353DF21C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:71:1720828059:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:72:1720828060:1":{"text":"There's no need to answer now. Let us leave the matter here, for today.","source_cn":"你不必现在就给出答复，今日就先到此为止吧。","status":"matched","hash_xxh64":"0x3FA86A1B8DE60F82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:73:1720828061:0":{"text":"No need. I've already decided.","source_cn":"不用，我已经考虑好了。","status":"matched","hash_xxh64":"0xB414ECE542A6DB88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:74:1720828062:0":{"text":"I'll join.","source_cn":"我愿意加入隐士。","status":"matched","hash_xxh64":"0x6633ED136850ADB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:埃德加":{"text":"Eryndor","source":"埃德加","status":"matched_dialogue_flow"},"speaker:绝望的海怪":{"text":"Sad Sea Monster","source":"绝望的海怪","status":"matched_dialogue_flow"},"speaker:质疑的墓碑":{"text":"Doubting Tombstone","source":"质疑的墓碑","status":"matched_dialogue_flow"},"speaker:狡黠的荧荧花":{"text":"Smart Glimmerbloom","source":"狡黠的荧荧花","status":"matched_dialogue_flow"},"speaker:司宾梅":{"text":"Receptionist Mei","source":"司宾梅","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"},"speaker:屏风后的声音":{"text":"Familiar Voice","source":"屏风后的声音","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":63,"localized_text_count":62,"speaker_count":8}}