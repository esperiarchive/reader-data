{"asset_key":"ep7/quest_story_17107590","episode":"ep7","category":"quest_story","story_id":"17107590","schema_version":1,"lang":"en","texts":{"say:2:1710759001:1":{"text":"Dura above! Your Grace! You're here as well!","source_cn":"艾雅在上！亲王殿下！您也在这里！真是太好了！","status":"matched","hash_xxh64":"0x3456E0EAF2EE73B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1710759002:1":{"text":"W-where exactly are we? Last I recall, His Highness was hosting a truly magnificent banquet...","source_cn":"这、这到底是何处啊？我只记得王子殿下那场无与伦比的晚宴……","status":"matched","hash_xxh64":"0x93EC5B023400EE2F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1710759003:1":{"text":"Silence, Grandet. Are you entirely without perception?","source_cn":"哼……闭嘴！你的脑子呢，葛朗台男爵？","status":"matched","hash_xxh64":"0x7AB360C33C0D9C6A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710759004:1":{"text":"Look at the statues. The vaulted ceiling.","source_cn":"你难道看不出这标志性的雕像和拱顶吗？","status":"matched","hash_xxh64":"0x8D0BB6018D7C5629","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1710759005:1":{"text":"I... well...","source_cn":"这……","status":"matched","hash_xxh64":"0x3DFC0A906A6F5B3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710759006:1":{"text":"This is the Hall of Ancients.","source_cn":"这里是圣古堂。","status":"matched","hash_xxh64":"0x8FC8F7ECE08A8E0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1710759007:1":{"text":"Your Grace... you cannot be serious.","source_cn":"殿下，您……您真会开玩笑。","status":"matched","hash_xxh64":"0xA9DA5830DA92B235","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1710759008:1":{"text":"But the chapel vanished!","source_cn":"圣古堂……圣古堂它不是……它不是……消失了吗？","status":"matched","hash_xxh64":"0x07B03A5819B5F3D1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1710759009:1":{"text":"And yet here we stand. Everyone who attended that banquet.","source_cn":"哼……但我们，所有参加晚宴的人，现在都在这座消失的教堂里。","status":"matched","hash_xxh64":"0x0FC0D0C92DA111DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1710759010:1":{"text":"Dura above! W-we're trapped?!","source_cn":"艾雅在上！我们、我们被困住了？！","status":"matched","hash_xxh64":"0xF11AA2DE86DA11DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1710759011:1":{"text":"Your Grace! You must do something! I don't want to—","source_cn":"殿下！亲王殿下！您想想办法啊！我、我不想——","status":"matched","hash_xxh64":"0x32ED717101418133","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1710759012:1":{"text":"Enough. Leave me, Grandet.","source_cn":"滚开吧，葛朗台。","status":"matched","hash_xxh64":"0x7F8FA475C97F90D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1710759013:1":{"text":"I have no idea why Orion invited someone like you to the hunt.","source_cn":"真不知道奥利安为什么会邀请你这种货色参加行猎……","status":"matched","hash_xxh64":"0x3FAE9ED1F80FA4DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:男爵葛朗台":{"text":"Baron Grandet","source":"男爵葛朗台","status":"matched_dialogue_flow"},"speaker:亲王孔蒂":{"text":"Noble Conti","source":"亲王孔蒂","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14,"localized_text_count":13,"speaker_count":2}}