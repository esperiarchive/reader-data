{"asset_key":"ep7/quest_story_17108280","episode":"ep7","category":"quest_story","story_id":"17108280","schema_version":1,"lang":"en","texts":{"say:1:1710828001:1":{"text":"... Sleep now, my most faithful knight.","source_cn":"……安息吧，我最忠诚的骑士，雷吉纳德。","status":"matched","hash_xxh64":"0xA6162B8D8253B61F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1710828002:1":{"text":"Your battle is over.","source_cn":"你的战斗，已经结束了。","status":"matched","hash_xxh64":"0x87AC0FF511947B54","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1710828003:0":{"text":"Did we... win?","source_cn":"我们的战斗赢了吗……？","status":"matched","hash_xxh64":"0xD9AEB78B80C4AFEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1710828004:1":{"text":"No one answers.","source_cn":"她的问题，没有得到回答。","status":"matched","hash_xxh64":"0xA845A4F109C8569A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710828005:1":{"text":"Because from all around the plaza, a new wave of—","source_cn":"因为，从广场的四周，传来了新一轮的……","status":"matched","hash_xxh64":"0x383BC19B60759204","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1710828006:0":{"text":"Damn it! More monsters could appear any second.","source_cn":"该死！圣古堂的魔物还可能再度出现。","status":"matched","hash_xxh64":"0x0E9A683C78DBB8C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1710828007:0":{"text":"The rift Cyran opened is widening! Those Hypofiends are charging toward the civilians!","source_cn":"迪尔格雷打开的裂隙在广场上越来越大！那些魔物…… 它们...","status":"matched","hash_xxh64":"0x14A496CDDC83D076","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1710828007":{"text":"The rift Cyran opened is widening! Those Hypofiends are charging toward the civilians!","source_cn":"迪尔格雷打开的裂隙在广场上越来越大！那些魔物…… 它们正冲向那些手无寸铁的民众！","status":"matched","hash_xxh64":"0x14A496CDDC83D076","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1710828008:0":{"text":"I'm counting on you, Magister Merlin... and King Rolan!","source_cn":"拜托了，梅林阁下和……罗兰大帝！","status":"matched_runtime_gender","hash_xxh64":"0xE99B0CDB39970BD4","variant_status":"runtime_gender_keys_target_same","male":"I'm counting on you, Magister Merlin... and King Rolan!","female":"I'm counting on you, Magister Merlin... and King Rolan!","variant_male_record_index":"225707","variant_female_record_index":"225708","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1710828009:0":{"text":"This is the heart of it. The rift's source. I'll leave it to you two! ","source_cn":"这里是战场中心，是裂隙的源头！这里交给你们！","status":"matched","hash_xxh64":"0x7F1998EE0DAE8708","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1710828010:0":{"text":"I'll take troops to the perimeter. We can't let them overrun the capital!","source_cn":"我带一些人去冲击外围！决不能让那些魔物在王都更大范围肆虐！","status":"matched","hash_xxh64":"0xE19242D1B27829E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1710828011:0":{"text":"Go, Commander!","source_cn":"去吧，指挥官！","status":"matched","hash_xxh64":"0x7AB5D87536CAB0C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1710828012:0":{"text":"Royal Guard! With me!","source_cn":"守备军！随我来！","status":"matched","hash_xxh64":"0x0AF0B3237DC03891","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1710828013:0":{"text":"Protect the people and kill the Hypofiends! For the Empire!","source_cn":"保护民众！清剿魔物！为了耀光——！！！","status":"matched","hash_xxh64":"0xFD1C1358700BC72B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"Hendrik, let's split up.","source_cn":"亨德里克，我们得分头行动","status":"matched_runtime_gender","hash_xxh64":"0xFFB497AEE023E240","variant_stat