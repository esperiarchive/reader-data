{"asset_key":"ep7/quest_story_17107540","episode":"ep7","category":"quest_story","story_id":"17107540","schema_version":1,"lang":"en","texts":{"say:2:1710754001:1":{"text":"Your Highness, the inconvenient clamor has ceased. The stage you requested is prepared.","source_cn":"殿下，不合时宜的喧闹终于平息了。为您准备的舞台也已布置妥当。","status":"matched","hash_xxh64":"0x4C2F4D6196C10FA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1710754002:1":{"text":"Tonight's feast was merely a stopgap measure.","source_cn":"迪尔格雷，今夜这场宴会终究是权宜之计……","status":"matched","hash_xxh64":"0xD03E388007D57A40","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1710754003:0":{"text":"What comes next is what truly matters.","source_cn":"接下来的事，才是重中之重。","status":"matched","hash_xxh64":"0x44FC8F6BD060A5BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710754004:0":{"text":"We cannot afford another \"accident\" like earlier!","source_cn":"绝不能再出现白天的意外！","status":"matched","hash_xxh64":"0x7952639C466D4901","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1710754005:0":{"text":"You needn't concern yourself.","source_cn":"殿下尽可放心。","status":"matched","hash_xxh64":"0xDA53D8DA313E3425","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710754006:0":{"text":"This afternoon was merely a prelude to your grand finale.","source_cn":"白日不过是小小插曲，是为您那盛大剧目的终章……略作点缀罢了。","status":"matched","hash_xxh64":"0x809066F86A177CAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1710754007:0":{"text":"The curtain has risen precisely on schedule. No uninvited guest will disrupt what follows.","source_cn":"帷幕已在您我计划中升起，绝不会再被任何不速之客所打乱。","status":"matched","hash_xxh64":"0x5E92688484A076E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1710754008:1":{"text":"When you return in triumph, before the eyes of the realm, the final act will unfold flawlessly.","source_cn":"待您在万众瞩目下凯旋归来，这出戏的最后一幕便可完美启幕。","status":"matched","hash_xxh64":"0x8F43929FE8374839","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1710754009:0":{"text":"Good. Then let's begin.","source_cn":"如此就好。我们开始吧。","status":"matched","hash_xxh64":"0xBC99BD8C694D36CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:迪尔格雷":{"text":"Cyran","source":"迪尔格雷","status":"matched_dialogue_flow"},"speaker:奥利安":{"text":"Orion","source":"奥利安","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":2}}