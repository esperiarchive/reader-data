{"asset_key":"ep7/quest_story_17207190","episode":"ep7","category":"quest_story","story_id":"17207190","schema_version":1,"lang":"en","texts":{"say:1:1720719001:0":{"text":"What's taking you so long? What have you got today? Give it all to me!","source_cn":"慢吞吞的干什么？今天骗到的钱呢？快拿出来！","status":"matched","hash_xxh64":"0x1B6D01C8E0F1A695","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1720719002:0":{"text":"Boss... the streets were quiet today... Th-This is all I've got...","source_cn":"老大……今天街上人少……只、只有这些了……","status":"matched","hash_xxh64":"0x5CB4FAEFB880874B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1720719003:1":{"text":"That's it?! Pathetic! That's nowhere near enough! Now get out of my sight!","source_cn":"废物！就这么点？还不够老子塞牙缝的！滚一边去！","status":"matched","hash_xxh64":"0x48D545B87784DBD2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1720719004:1":{"text":"Boss...","source_cn":"老大……","status":"matched","hash_xxh64":"0x4E66D418AC99765F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1720719005:1":{"text":"And you? You'd better not be a letdown like her.","source_cn":"你呢？别告诉我你也只有这点出息。","status":"matched","hash_xxh64":"0x620C8ED6029C3D40","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1720719006:0":{"text":"Boss... I-I got this from a kind young lady...","source_cn":"老大……这是……这是一位好心的姐姐给的……","status":"matched","hash_xxh64":"0x72F55B238D0CFF13","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1720719007:0":{"text":"Gold coins?! Haha, nice work! I knew you could trick those nobles into paying just by turning on the waterworks!","source_cn":"金币？！哈哈！好家伙！我就知道你这丫头机灵，眼泪说来就...","status":"matched","hash_xxh64":"0x2BE8FA483279BEB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1720719008:0":{"text":"Wait, those noble ladies are usually quite generous. This can't be all she gave.","source_cn":"慢着。那些贵族小姐出手阔绰，不可能只给这几枚吧？","status":"matched","hash_xxh64":"0x66AFB5AF5FE77B89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1720719009:0":{"text":"I-I swear that's everything I have!","source_cn":"没、没有了！真的只有这些！我都交出来了！","status":"matched","hash_xxh64":"0x5A79121BC4478271","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1720719010:0":{"text":"Hmph, I doubt you'd dare keep anything to yourself. I'll chop your hand off if you do!","source_cn":"哼，谅你也不敢在老子眼皮底下藏私，要是敢藏一个子儿，当...","status":"matched","hash_xxh64":"0xAE242E1C6140F9AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1720719011:0":{"text":"Boss... I-I haven't eaten in three days... Can I...","source_cn":"老大……我、我已经三天没吃饭了……能不能……","status":"matched","hash_xxh64":"0x6145B361C81FCC37","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1720719012:0":{"text":"You've got the nerve to complain?! You haven't brought back anything for days! Time to beat some sense into you!","source_cn":"没出息的东西，你还敢开口说想吃饭？你都几天没骗到钱了？...","status":"matched","hash_xxh64":"0x4B62D2E09B40773E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1720719013:0":{"text":"Sorry, Boss! I was wrong!","source_cn":"不要啊，老大，我错了！","status":"matched","hash_xxh64":"0x0AE79EF0B36ABA30","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:凶恶的混混":{"text":"Fierce Thug","source":"凶恶的混混","status":"matched_dialogue_flow"},"speaker:小孩莫莉":{"text":"Mollie","source":"小孩莫莉","status":"matched_dialogue_flow"},"speaker:小孩珍妮":{"text":"Jenine","source":"小孩珍妮","status":"matched_dialogue_flow"},"speaker:小孩汤姆":{"text":"Tom","source":"小孩汤姆","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14,"localized_text_count":13,"speaker_count":4}}