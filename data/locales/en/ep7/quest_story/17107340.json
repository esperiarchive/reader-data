{"asset_key":"ep7/quest_story_17107340","episode":"ep7","category":"quest_story","story_id":"17107340","schema_version":1,"lang":"en","texts":{"say:3:1710734001:0":{"text":"Allo? Is that you?! Why are you here?","source_cn":"艾尔？是你？！你怎么会在这里？","status":"matched","hash_xxh64":"0x514FBEF2ABC61208","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1710734002:0":{"text":"It's me! I'm here with you!","source_cn":"是我，我在这里陪着你！","status":"matched","hash_xxh64":"0xAB2A49A5055C8506","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710734003:0":{"text":"But... this place is scary...","source_cn":"不过……这里有点可怕……","status":"matched","hash_xxh64":"0x016349D5B4120FEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1710734004:0":{"text":"There are dark shapes over there... and they keep saying awful things!","source_cn":"前面有好多可怕的黑影……他们一直在说着很坏的话！","status":"matched","hash_xxh64":"0x758285B2D60F9F5F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710734005:0":{"text":"Don't worry! I'll protect you with my bow.","source_cn":"别怕，艾尔！我会用我的弓保护你。","status":"matched","hash_xxh64":"0x5CFA64421C12AA07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","docume