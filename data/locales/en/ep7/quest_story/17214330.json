{"asset_key":"ep7/quest_story_17214330","episode":"ep7","category":"quest_story","story_id":"17214330","schema_version":1,"lang":"en","texts":{"say:1:1721433001:0":{"text":"Huh? Oh, I got the wrong person...","source_cn":"咦？哦，认错人了啊……","status":"matched","hash_xxh64":"0x55CA0F0BCD39E852","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1721433002:0":{"text":"Sir, are you looking for Amy?!","source_cn":"老板！您刚刚是在叫艾米吗？！","status":"matched","hash_xxh64":"0x2F0EA7AC325CE881","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1721433003:0":{"text":"Yeah. Usually, Amy's the only one dressed that well around here, so I thought you were her.","source_cn":"是啊。在这附近还穿得这么贵，也就只有艾米小姐了，这不才...","status":"matched","hash_xxh64":"0xBC92E60828C0366B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1721433004:0":{"text":"Do you know her?","source_cn":"你们认识她？","status":"matched","hash_xxh64":"0xA707703EA7333A75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1721433005:0":{"text":"... We're her friends, but we can't seem to find her anywhere...","source_cn":"……我们是她的朋友……但是，怎么找都找不到她……","status":"matched","hash_xxh64":"0x7B843335951D479D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1721433006:0":{"text":"Oh, come on, why are you crying?","source_cn":"哎哎哎，不就没找到人吗，怎么还哭起来了！","status":"matched","hash_xxh64":"0x4D4196DF98261F74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1721433007:0":{"text":"I'm sure she's fine, probably just out for a walk. She came by my place yesterday to pawn some of her stuff.","source_cn":"她人肯定没事，说不定就是去附近散散步什么的。瞧，她昨天...","status":"matched","hash_xxh64":"0x406779A066603C67","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1721433007":{"text":"I'm sure she's fine, probably just out for a walk. She came by my place yesterday to pawn some of her stuff.","source_cn":"她人肯定没事，说不定就是去附近散散步什么的。瞧，她昨天还在我这里典当了些东西呢。","status":"matched","hash_xxh64":"0x406779A066603C67","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1721433008:0":{"text":"Pretty much everything she owns. Furniture, jewelry, even her coat and dress.","source_cn":"唉，什么都当了。家具、首饰、连外套和连衣裙都拿来了。","status":"matched","hash_xxh64":"0x5032427DFD142C99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1721433009:0":{"text":"What? Her clothes too...","source_cn":"什么，连衣服都……","status":"matched","hash_xxh64":"0x6972186A983BF21C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1721433010:0":{"text":"She was in a hurry and didn't empty her pockets. I found this—nothing valuable, so I'm not sure if she still wants it.","source_cn":"不过她走得太急，衣服兜都没掏干净。倒也不是什么值钱的东...","status":"matched","hash_xxh64":"0x0DCE8B62D82BB227","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1721433011:0":{"text":"You can leave it with us. We'll return it to her.","source_cn":"您交给我们吧，我们直接还给她。","status":"matched","hash_xxh64":"0x3FB641E45EBB6D4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1721433012:0":{"text":"Oh, great! Here it is.","source_cn":"哦，那正好！喏，就是这个。","status":"matched","hash_xxh64":"0xC42894A6B2AEF100","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1721433013:1":{"text":"The pawnshop owner hands you a white silk handkerchief with the Lightbearer royal emblem stitched into the corner.","source_cn":"老板将艾米落下的东西交给了你们。那是一张白色真丝手帕，...","status":"matched_runtime_gender","hash_xxh64":"0xC72BDBF8A0BA9C39","variant_status":"runtime_gender_keys_target_same","male":"The pawnshop owner hands you a white silk handkerchief with the Lightbearer royal emblem stitched into the corner.","female":"The pawnshop owner hands you a white silk handkerchief with the Lightbearer royal emblem stitched into the corner.","variant_male_record_index":"231082","variant_female_record_index":"231083","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:15::2":{"text":"Piece of Cloth","source_cn":"手帕","status":"matched","hash_xxh64":"0x46249D6524C9B75B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1721433014:1":{"text":"The handkerchief looks worn from repeated washing, a sign that it is cherished by its owner. It still gives off a faint scent of soap.","source_cn":"手帕有些破旧，有多次水洗的痕迹。看得出持有者对它十分爱...","status":"matched_runtime_gender","hash_xxh64":"0xDCD2964A5E873408","variant_status":"runtime_gender_keys_target_same","male":"The handkerchief looks worn from repeated washing, a sign that it is cherished by its owner. It still gives off a faint scent of soap.","female":"The handkerchief looks worn from repeated washing, a sign that it is cherished by its owner. It still gives off a faint scent of soap.","variant_male_record_index":"231084","variant_female_record_index":"231085","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1721433015:0":{"text":"Dura above, this is the handkerchief Prince Orion gave to Amy when he helped her.","source_cn":"艾雅在上，这是奥利安殿下当时从人潮中扶起她时，递给她的手帕。","status":"matched","hash_xxh64":"0x6BCA9B37FD4D2E1C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1721433016:0":{"text":"I can't believe she still had it...","source_cn":"没想到艾米留到了现在……","status":"matched","hash_xxh64":"0x29B44F77B28A8304","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1721433017:0":{"text":"Look, there's something wrapped inside!","source_cn":"你们看，手帕里还包着什么东西！","status":"matched","hash_xxh64":"0x86E7FE775B65C8E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1721433018:0":{"text":"Is it... a card?","source_cn":"好像是……一张卡片？","status":"matched","hash_xxh64":"0x82D5672F87B5AFA2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"What did she pawn?","source_cn":"她典当了什么？","status":"matched_runtime_gender","hash_xxh64":"0x84177CB6FEA998B5","variant_status":"runtime_gender_keys_target_same","male":"What did she pawn?","female":"What did she pawn?","variant_male_record_index":"90041","variant_female_record_index":"90042","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:典当行老板":{"text":"Pawnshop Owner","source":"典当行老板","status":"matched_dialogue_flow"},"speaker:夏洛洛":{"text":"Charolo","source":"夏洛洛","status":"matched_dialogue_flow"},"speaker:希琳娜":{"text":"Shira","source":"希琳娜","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":22,"localized_text_count":21,"speaker_count":4}}