{"asset_key":"ep7/quest_story_17107630","episode":"ep7","category":"quest_story","story_id":"17107630","schema_version":1,"lang":"en","texts":{"say:1:1710763001:1":{"text":"Your Highness! It's you! Please, look, this place...","source_cn":"殿下！真的是您！您快看，这里是……","status":"matched","hash_xxh64":"0xD146019B558A28EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1710763002:0":{"text":"I know. You're not mistaken. This is the Hall of Ancients.","source_cn":"我知道。诸位，你们没有看错。这里就是消失的圣古堂。","status":"matched","hash_xxh64":"0xAEC1C8314A47E3BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1710763003:1":{"text":"Then we're really trapped here?","source_cn":"我们真的被困在……","status":"matched","hash_xxh64":"0x004AA02E0A326AFD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710763004:0":{"text":"Don't give in to fear. The Hall of Ancients is the Lightbearer Empire's most sacred ground.","source_cn":"无需过度惊慌。圣古堂是耀光的圣所。","status":"matched","hash_xxh64":"0x0CAF6FF8C7F47A91","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710763005:0":{"text":"Its lower halls hold the Empire's fallen heroes, and its dome bathes in Dura's divine light.","source_cn":"它的底层，长眠着护国的英烈，它的穹顶，沐浴着艾雅女神的圣光。","status":"matched","hash_xxh64":"0x66EDAF2B09FFB635","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1710763006:0":{"text":"I don't know what power brought us here.","source_cn":"我不知道是何种伟力，将我们从晚宴上齐聚于此。","status":"matched","hash_xxh64":"0x685834C77439BB11","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1710763007:0":{"text":"But I believe that we were brought here for a reason, as pillars of this Empire.","source_cn":"但我坚信，在此刻，我们——耀光的砥柱——能被选召到这圣...","status":"matched","hash_xxh64":"0x6F168B20A69269D1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1710763008:0":{"text":"Orion speaks wisely. Panic achieves nothing. We just need to figure out how to leave.","source_cn":"奥利安殿下所言甚是。现在惊慌无用，我们只需要知道，该如...","status":"matched","hash_xxh64":"0x835E45D433E64C8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1710763009:0":{"text":"Yes. Put aside your fear.","source_cn":"没错，现在最重要的是，收起你们的恐惧。","status":"matched","hash_xxh64":"0x8DE2063695218127","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1710763010:0":{"text":"As long as I stand here, I will protect you.","source_cn":"只要我奥利安还站在这里，我就会竭尽全力，保护诸位的安全。","status":"matched","hash_xxh64":"0xC9EC62068A49BD39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1710763011:0":{"text":"No harm will come to anyone under my watch.","source_cn":"我绝不会让任何人，在我的庇护下出事！","status":"matched","hash_xxh64":"0xD8AE990F138E663A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1710763012:0":{"text":"Just as he finishes speaking—","source_cn":"王子的话音刚刚落下，承诺仿佛还在圣古堂内回响之际——","status":"matched","hash_xxh64":"0x3A5C98A96A5B75C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1710763013:1":{"text":" A piercing shriek cuts through the hall!","source_cn":"一阵令人牙酸的尖啸声，从远处猛然传来！","status":"matched","hash_xxh64":"0x4926BC771E2F071C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:男爵葛朗台":{"text":"Baron Grandet","source":"男爵葛朗台","status":"matched_dialogue_flow"},"speaker:奥利安":{"text":"Orion","source":"奥利安","status":"matched_dialogue_flow"},"speaker:女公爵梦妮":{"text":"Duchess Monette","source":"女公爵梦妮","status":"matched_dialogue_flow"},"speaker:亲王孔蒂":{"text":"Noble Conti","source":"亲王孔蒂","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14,"localized_text_count":13,"speaker_count":5}}