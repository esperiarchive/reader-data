h64":"0x831972B9217A04F4","variant_status":"runtime_gender_keys_target_same","male":"My brother, the one who should be protecting the Empire, he ran...","female":"My brother, the one who should be protecting the Empire, he ran...","variant_male_record_index":"227211","variant_female_record_index":"227212","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710823005:1":{"text":"But I won't run away!","source_cn":"我不能再逃跑了！","status":"matched_runtime_gender","hash_xxh64":"0xEAE6E7C243FFEAB6","variant_status":"runtime_gender_keys_target_same","male":"But I won't run away!","female":"But I won't run away!","variant_male_record_index":"227213","variant_female_record_index":"227214","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1710823006:1":{"text":"I can't keep hiding behind Father, Mother... behind Cassadee...","source_cn":"我不能永远只躲在父王和母后、躲在科丝蒂的身后，被人保护。","status":"matched_runtime_gender","hash_xxh64":"0x98B0D60CF8895695","variant_status":"runtime_gender_keys_target_same","male":"I can't keep hiding behind Father, Mother... behind Cassadee...","female":"I can't keep hiding behind Father, Mother... behind Cassadee...","variant_male_record_index":"227215","variant_female_record_index":"227216","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1710823007:1":{"text":"I am the Princess.","source_cn":"我是耀光的公主。","status":"matched_runtime_gender","hash_xxh64":"0xAB1FA512D9571B66","variant_status":"runtime_gender_keys_target_same","male":"I am the Princess.","female":"I am the Princess.","variant_male_record_index":"227217","variant_female_record_index":"227218","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1710823008:1":{"text":"This time, I'll stay. I'll f