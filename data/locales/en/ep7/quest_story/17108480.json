{"asset_key":"ep7/quest_story_17108480","episode":"ep7","category":"quest_story","story_id":"17108480","schema_version":1,"lang":"en","texts":{"say:1:1710848001:1":{"text":"It's finally over.","source_cn":"一切终于结束了。","status":"matched_runtime_gender","hash_xxh64":"0xF011E2BDCD46452E","variant_status":"runtime_gender_keys_target_same","male":"It's finally over.","female":"It's finally over.","variant_male_record_index":"227650","variant_female_record_index":"227651","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1710848002:1":{"text":"Without you, the consequences would have been unthinkable.","source_cn":"王宫和圣古堂……如果不是您，后果不堪设想。","status":"matched_runtime_gender","hash_xxh64":"0x137BF5D07ED72B5F","variant_status":"runtime_gender_keys_target_same","male":"Without you, the consequences would have been unthinkable.","female":"Without you, the consequences would have been unthinkable.","variant_male_record_index":"227652","variant_female_record_index":"227653","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1710848003:1":{"text":"On behalf of the Royal Guard and all the people of Savannah... thank you.","source_cn":"我谨代表守备军，和赛凡纳的所有民众，感谢您的帮助。","status":"matched_runtime_gender","hash_xxh64":"0x84E2611195B8BA44","variant_status":"runtime_gender_keys_target_same","male":"On behalf of the Royal Guard and all the people of Savannah... thank you.","female":"On behalf of the Royal Guard and all the people of Savannah... thank you.","variant_male_record_index":"227654","variant_female_record_index":"227655","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1710848003":{"text":"On behalf of the Royal Guard and all the people of Savannah... thank you.","source_cn":"我谨代表守备军，和赛凡纳的所有民众，感谢您的帮助。","status":"matched_runtime_gender","hash_xxh64":"0x84E2611195B8BA44","variant_status":"runtime_gender_keys_target_same","male":"On behalf of the Royal Guard and all the people of Savannah... thank you.","female":"On behalf of the Royal Guard and all the people of Savannah... thank you.","variant_male_record_index":"227654","variant_female_record_index":"227655","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710848004:1":{"text":"Reconstruction and the purging of Cyran's remaining allies will fall to the ministries.","source_cn":"后续的重建、抚恤，以及对迪尔格雷党羽的清算，行政部和内...","status":"matched_runtime_gender","hash_xxh64":"0x32381F8D62A33459","variant_status":"runtime_gender_keys_target_same","male":"Reconstruction and the purging of Cyran's remaining allies will fall to the ministries.","female":"Reconstruction and the purging of Cyran's remaining allies will fall to the ministries.","variant_male_record_index":"227656","variant_female_record_index":"227657","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1710848005:1":{"text":"The guard's duty here is complete.","source_cn":"我们守备军的职责已经完成了。","status":"matched_runtime_gender","hash_xxh64":"0x7F54BA80F5ACAC7F","variant_status":"runtime_gender_keys_target_same","male":"The guard's duty here is complete.","female":"The guard's duty here is complete.","variant_male_record_index":"227658","variant_female_record_index":"227659","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710848006:1":{"text":"Gwyneth.","source_cn":"格温妮丝。","status":"matched","hash_xxh64":"0x7BEF23AB4B76FDCF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1710848007:1":{"text":"Yes, Commander!","source_cn":"是！司令！<key:dialog1>","status":"matched","hash_xxh64":"0x89CFE63DD2933C2F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1710848008:1":{"text":"You performed well today. You commanded decisively, and you were fearless in battle.","source_cn":"你今天做得很好。指挥果断，作战勇猛。","status":"matched","hash_xxh64":"0xD39A5E72F504009D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1710848009:1":{"text":"You've grown. The title of First Division Captain suits you.","source_cn":"你成长了，第一分队队长的名号，你当之无愧。","status":"matched","hash_xxh64":"0x9EDDC45E88C3CE11","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1710848010:1":{"text":"So... set aside thoughts of Ashvale County.","source_cn":"所以……别再去想什么灰影郡前线了。","status":"matched","hash_xxh64":"0x3AD9395C1ADE049C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1710848011:1":{"text":"What?!","source_cn":"什么？！<key:dialog37>","status":"matched","hash_xxh64":"0xDE9622A387DF8967","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1710848012:1":{"text":"Remain in Savannah. Your talents are needed here.","source_cn":"留在赛凡纳。在这里，你也能继续发挥自己的长处。","status":"matched","hash_xxh64":"0xAA5573B6E25E54DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1710848013:1":{"text":"Needed? To stay the so-called \"First Division mascot\"? Father... Commander! I need real combat!","source_cn":"发挥长处？继续当那个挂名的“第一分队”吉祥物吗？ 父…...","status":"matched","hash_xxh64":"0xA72ACF5DC5A44C12","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1710848014:1":{"text":"Not a mascot.","source_cn":"不。不是吉祥物。","status":"matched","hash_xxh64":"0xF6595D80C6B2EBA4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1710848015:1":{"text":"The core of the capital's defense.","source_cn":"是真正承担起守备军的核心职责。","status":"matched","hash_xxh64":"0x075F676F0C801DCF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1710848016:1":{"text":"Today exposed our weaknesses. We must rebuild from the ground up.","source_cn":"今日一事暴露了王都防务的空虚，守备军需要彻底重整。","status":"matched","hash_xxh64":"0x1B63AB0DAE19BFB5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1710848017:1":{"text":"I want you to help me.","source_cn":"我要你留下来，帮我。但是……","status":"matched","hash_xxh64":"0xFCD0A21B6CDBF94C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1710848018:1":{"text":"This won't be easy.","source_cn":"这可不是什么轻松的差事。你不要嫌苦。","status":"matched","hash_xxh64":"0x14A015EB24599BF6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1710848019:1":{"text":"Hmph... Rebuilding the Royal Guard?","source_cn":"哼……重整防务？","status":"matched","hash_xxh64":"0xE1874FF94A751D82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1710848020:1":{"text":"Fine. I'll think about it. Get me a formal appointment first!","source_cn":"我考虑考虑！你先给我正式的任命再说！","status":"matched","hash_xxh64":"0x611DD6D47DAA5C51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1710848021:1":{"text":"I will petition Her Majesty at once.","source_cn":"我会立刻向王后陛下请命的。","status":"matched","hash_xxh64":"0xA5B05A6AEFD2A4C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1710848022:1":{"text":"Leave that to me!","source_cn":"这个包在我身上！","status":"matched","hash_xxh64":"0x7E4A40EAD9BD7223","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1710848023:1":{"text":"I'll make sure Mother agrees! Gwyneth was truly amazing today!","source_cn":"我一定会让母后同意的！格温妮丝今天这么厉害，她留下是理...","status":"matched","hash_xxh64":"0x56D599EEB7A8407C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1710848024:1":{"text":"I'll go to the palace shortly to report to the Queen.","source_cn":"我稍后要去王宫，向王后陛下汇报此次战役的全部经过。","status":"matched","hash_xxh64":"0x6EF236D61D402995","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1710848025:1":{"text":"You... just wait for your formal position.","source_cn":"你……就等着之后的正式就任吧。","status":"matched","hash_xxh64":"0xBD48995B57DF7AED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1710848026:1":{"text":"Don't worry. I won't be late!","source_cn":"放心，我肯定不会迟到的！","status":"matched","hash_xxh64":"0xA89632D24A1D684D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:31:1710848027:1":{"text":"The shadow that loomed over the capital finally lifts. Sunlight returns to the battered plaza.","source_cn":"","status":"matched","hash_xxh64":"0x5DF8ED666F6C4922","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:32:1710848028:1":{"text":"With this victory, the Empire's path to rebuilding has only just begun...","source_cn":"","status":"matched","hash_xxh64":"0x288536F02B00C669","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"Everyone worked hard.","source_cn":"大家也都辛苦了","status":"matched_runtime_gender","hash_xxh64":"0x4981C04DE84820D8","variant_status":"runtime_gender_keys_target_same","male":"Everyone worked hard.","female":"Everyone worked hard.","variant_male_record_index":"89099","variant_female_record_index":"89100","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:1:2":{"text":"I was just doing my part.","source_cn":"顺手的事","status":"matched_runtime_gender","hash_xxh64":"0x1C8DE7034AC01974","variant_status":"runtime_gender_keys_target_same","male":"I was just doing my part.","female":"I was just doing my part.","variant_male_record_index":"89101","variant_female_record_index":"89102","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:亨德里克":{"text":"Hendrik","source":"亨德里克","status":"matched_dialogue_flow"},"speaker:格温妮丝":{"text":"Gwyneth","source":"格温妮丝","status":"matched_dialogue_flow"},"speaker:佩吉":{"text":"Peggy","source":"佩吉","status":"matched_dialogue_flow"},"speaker:黑屏文本":{"text":"Black Screen Text","source":"黑屏文本","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":32,"localized_text_count":31,"speaker_count":4}}