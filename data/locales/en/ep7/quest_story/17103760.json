{"asset_key":"ep7/quest_story_17103760","episode":"ep7","category":"quest_story","story_id":"17103760","schema_version":1,"lang":"en","texts":{"say:1:1710376001:1":{"text":"Byrne, has anything unusual happened around here?","source_cn":"伯恩！汇报一下情况。圣古堂消失的原址有何异常吗？","status":"matched","hash_xxh64":"0x2BEDBBB5D68B6D66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1710376002:1":{"text":"Captain, there has been no unusual activity, and no one has come near or tried to enter.","source_cn":"报告队长！目前原址没有任何动静。也没有任何人靠近或试图闯入！","status":"matched","hash_xxh64":"0xE806201E1EFB305E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1710376003:1":{"text":"What about... the missing people? Any updates on Princess Peggy or Commander Hendrik?","source_cn":"那么……失踪人员呢？有没有佩吉公主，或者亨德里克司令的消息？","status":"matched","hash_xxh64":"0x1D4B751C368A246F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710376004:1":{"text":"Yes, an urgent report just came in. The Commander's back!","source_cn":"关于这个，我们刚刚接到了紧急通报。司令他现身了！","status":"matched","hash_xxh64":"0x9FD0A52D9BA58077","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1710376005:1":{"text":"Fath—The Commander's back?! Where is he?","source_cn":"父——司令回来了？！他在哪里？","status":"matched","hash_xxh64":"0xF911FED27FDD37D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710376006:1":{"text":"Those on duty in the palace saw him there.","source_cn":"司令出现在了王宫内部，现在已经被宫内执勤的同僚接应了。","status":"matched","hash_xxh64":"0xFF2D73C3E08E2B89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1710376007:0":{"text":"Palace? What about Princess Peggy?","source_cn":"王宫？那佩吉公主呢？","status":"matched","hash_xxh64":"0xC1C7FDD4E8A56D3A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1710376008:0":{"text":"The report says the Commander was alone. At present, there's no news on either Princess Peggy or Magister Cassadee...","source_cn":"据通报说，司令是独自一人出现的。关于佩吉公主和宫廷魔法...","status":"matched","hash_xxh64":"0x203599CE4842BE0B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1710376009:0":{"text":"Where in the world is Peggy? I have to get to the palace right away. Maybe she's stranded somewhere nearby!","source_cn":"佩吉那家伙，到底去哪里了……不行，我也得去王宫看看，她...","status":"matched","hash_xxh64":"0x024C00D582DF4218","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1710376009":{"text":"Where in the world is Peggy? I have to get to the palace right away. Maybe she's stranded somewhere nearby!","source_cn":"佩吉那家伙，到底去哪里了……不行，我也得去王宫看看，她可能被传送到了王宫周边的什么地方！","status":"matched","hash_xxh64":"0x024C00D582DF4218","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1710376010:1":{"text":"Father must've brought back crucial information about the Hall of Ancients.","source_cn":"没错。父亲既然已经脱险，他一定是带回了关于圣古堂最关键...","status":"matched","hash_xxh64":"0xA1510FCA38E0D4B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1710376011:1":{"text":"Let's head to the palace and get more details from him!","source_cn":"走！立刻去王宫，向父亲确认具体的情况！","status":"matched","hash_xxh64":"0xE7E5B74267AA040C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:0:1":{"text":"I'll go with you.","source_cn":"那我也一起去","status":"matched_runtime_gender","hash_xxh64":"0x042E42DC846DC1E0","variant_status":"runtime_gender_keys_target_same","male":"I'll go with you.","female":"I'll go with you.","variant_male_record_index":"88763","variant_female_record_index":"88764","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:格温妮丝":{"text":"Gwyneth","source":"格温妮丝","status":"matched_dialogue_flow"},"speaker:守备军伯恩":{"text":"Guard Byrne","source":"守备军伯恩","status":"matched_dialogue_flow"},"speaker:罗万":{"text":"Rowan","source":"罗万","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14