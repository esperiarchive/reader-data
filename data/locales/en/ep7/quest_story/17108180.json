{"asset_key":"ep7/quest_story_17108180","episode":"ep7","category":"quest_story","story_id":"17108180","schema_version":1,"lang":"en","texts":{"say:1:1710818001:0":{"text":"Enough, Orion. Do not disgrace yourself further.","source_cn":"住手吧，奥利安。不要再羞辱自己了。","status":"matched","hash_xxh64":"0x0DBB093683E6A2DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1710818002:0":{"text":"Your charade ends here.","source_cn":"你的表演，该结束了。","status":"matched","hash_xxh64":"0x9E336846F50639E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1710818003:0":{"text":"No... impossible... Who are you?","source_cn":"不、不可能……你……你是谁？","status":"matched","hash_xxh64":"0x0C99A96ECF42F1F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710818004:0":{"text":"You truly do not recognize me? My descendant?","source_cn":"不认识我吗？我名义上的后代子嗣。","status":"matched","hash_xxh64":"0xA9D8A77D49BEA584","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710818005:0":{"text":"R-Rolan...","source_cn":"罗、罗兰……","status":"matched","hash_xxh64":"0xFD59865618E9F817","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1710818006:1":{"text":"People of the Empire!","source_cn":"耀光的子民们！","status":"matched","hash_xxh64":"0xD24115ED66B5C539","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1710818007:1":{"text":"Two thousand years ago, I stood with the goddess Dura and left hope upon this land.","source_cn":"两千年前，我与艾雅女神并肩，将希望留给了这片土地。","status":"matched","hash_xxh64":"0xD2AAC319F0B09521","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1710818008:1":{"text":"Together, we left Excalibur. Not to choose the strongest warrior, nor the cleverest schemer—","source_cn":"我们一同留下了这把石中剑，不是为了选出一个最强壮的战士...","status":"matched","hash_xxh64":"0x68E42F6B9BFFD7C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1710818009:1":{"text":"But to choose one who truly thinks for the people. Who would truly sacrifice for the realm, and lead the Empire toward the light.","source_cn":"而是为了选出一个——真正能为民着想、真正愿为国牺牲、真...","status":"matched","hash_xxh64":"0xCF32F73A9FB18345","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1710818010:1":{"text":"A king!","source_cn":"国王！","status":"matched","hash_xxh64":"0x0221C0611A920D63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1710818011:1":{"text":"What we need is courage. Justice. An undying sense of responsibility toward the people!","source_cn":"我们需要的，是勇气，是公正，是国王心中不灭的……对人民...","status":"matched","hash_xxh64":"0x9B068F76AA39E681","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1710818012:1":{"text":"Not someone like you, Orion. Conspiring with a court mage to vanish the Hall of Ancients, stealing glory with lies!","source_cn":"而不是像你一样，奥利安——联合宫廷魔法师，制造了圣古堂...","status":"matched","hash_xxh64":"0x0952943952A66967","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1710818013:1":{"text":"I... Silence! I am the chosen one!","source_cn":"我、我……住口！我、我是被选中的人！","status":"matched","hash_xxh64":"0xAA9176833A65E0E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1710818014:0":{"text":"No. You are not. And you cannot draw Excalibur...","source_cn":"不，你不是，你也拔不出石中剑……","status":"matched","hash_xxh64":"0x74C08E16ABB6A580","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1710818015:0":{"text":"Because it can see into your soul! It sees hollow heroism built on deception.","source_cn":"因为石中剑能看穿你的灵魂！它能看穿你那用谎言堆砌出的虚...","status":"matched","hash_xxh64":"0x4ABF3762FF9112ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1710818016:0":{"text":"You are unworthy of the throne!","source_cn":"你——德不配位！","status":"matched","hash_xxh64":"0xAAA78DD59D57D498","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1710818017:0":{"text":"No... I... This isn't true!","source_cn":"不……我……没有……这不是真的！","status":"matched","hash_xxh64":"0xA77EE99A21D9A913","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1710818018:1":{"text":"Brother...","source_cn":"……哥哥……<key:dialog2>","status":"matched","hash_xxh64":"0x64AC36BC6AAFAD9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1710818019:1":{"text":"W-what is happening?!","source_cn":"这、这到底是怎么回事？！","status":"matched","hash_xxh64":"0x632983A3BEBD4AC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1710818020:1":{"text":"The Hall of Ancients' disappearance... the Prince did that?","source_cn":"圣古堂消失……是王子做的？","status":"matched","hash_xxh64":"0xB2961B9DB29EC72F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1710818021:1":{"text":"He... he couldn't draw the sword...","source_cn":"他……他拔不出剑……","status":"matched","hash_xxh64":"0x916EDEE270E10BDD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1710818022:1":{"text":"You... on what grounds do you say that?!","source_cn":"你……你凭什么这么说？！","status":"matched","hash_xxh64":"0xAB0B59AA84E2F453","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1710818023:1":{"text":"King Rolan vanished two thousand years ago! You think you can just impersonate him?!","source_cn":"罗兰大帝已经消失两千年了！你以为你能随意冒充他吗？！","status":"matched","hash_xxh64":"0xE9228DF2F1190EFD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1710818024:1":{"text":"This must be some trick! Prove you're truly him!","source_cn":"这一定是某个魔法师耍的把戏！你怎么证明你是真的罗兰大帝？！","status":"matched","hash_xxh64":"0x6D3CD3B627B842DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1710818025:0":{"text":"You are right. Words alone are not enough.","source_cn":"啊，你说的没错。对于王者而言，言语是最无力的辩解。","status":"matched","hash_xxh64":"0xBA9F8062DA741A04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1710818026:0":{"text":"Fortunately, the proof stands before you.","source_cn":"验证方法，不就摆在这里吗？","status":"matched","hash_xxh64":"0x04E3958BB7489318","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:罗兰大帝":{"text":"King Rolan","source":"罗兰大帝","status":"matched_dialogue_flow"},"speaker:奥利安":{"text":"Orion","source":"奥利安","status":"matched_dialogue_flow"},"speaker:激动的商人":{"text":"Excited Merchant","source":"激动的商人","status":"matched_dialogue_flow"},"speaker:佩吉":{"text":"Peggy","source":"佩吉","status":"matched_dialogue_flow"},"speaker:男爵葛朗台":{"text":"Baron Grandet","source":"男爵葛朗台","status":"matched_dialogue_flow"},"speaker:欢呼的少女":{"text":"Cheering Girl","source":"欢呼的少女","status":"matched_dialogue_flow"},"speaker:欢庆的贵族":{"text":"Celebrating Noble","source":"欢庆的贵族","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":27,"localized_text_count":26,"speaker_count":7}}