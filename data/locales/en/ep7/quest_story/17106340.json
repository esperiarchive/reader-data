{"asset_key":"ep7/quest_story_17106340","episode":"ep7","category":"quest_story","story_id":"17106340","schema_version":1,"lang":"en","texts":{"say:2:1710634001:1":{"text":"Huh? Someone drop their fashion accessory?","source_cn":"咦，这是什么？是手套吗？","status":"matched","hash_xxh64":"0xCFDC7826C2011CD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1710634002:1":{"text":"A falconer's glove. Look, the back's torn from talons.","source_cn":"这是驯鹰人专用的手套，猎鹰会在上面停留，你看，它的背面...","status":"matched","hash_xxh64":"0x58DD5979F9BE99F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1710634003:1":{"text":"A glove here, all these feathers... That tower ahead must be the aviary.","source_cn":"驯鹰手套出现在这里，结合周围的羽毛痕迹……这样看来，前...","status":"matched","hash_xxh64":"0x5CD91B99C19DBB83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710634004:1":{"text":"And conveniently, it's where the scabbard's lighting up. See? I make great guesses.","source_cn":"呃，前方刚好也是剑鞘感应最强的地方！不会真被我说中了吧！","status":"matched","hash_xxh64":"0xF65EA6453C844F9F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:小狐狸":{"text":"Little Fox","source":"小狐狸","status":"matched_dialogue_flow"},"speaker:格温妮丝":{"text":"Gwyneth","source":"格温妮丝","status":"matched_dialogue_flow"}},"stats":{