{"asset_key":"ep7/quest_story_17108440","episode":"ep7","category":"quest_story","story_id":"17108440","schema_version":1,"lang":"en","texts":{"say:1:1710844001:1":{"text":"Merlin! You're back! ","source_cn":"梅林！你回来了！太好了……","status":"matched_runtime_gender","hash_xxh64":"0x9A999BB4B8B0A927","variant_status":"runtime_gender_keys_target_same","male":"Merlin! You're back! ","female":"Merlin! You're back! ","variant_male_record_index":"227574","variant_female_record_index":"227575","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1710844002:1":{"text":"Magister Merlin. As you can see, with King Rolan's aid, the rift has been completely sealed.","source_cn":"梅林大人。如您所见，在罗兰大帝的协助下……圣古堂的深渊...","status":"matched_runtime_gender","hash_xxh64":"0x7A26991EA985C83D","variant_status":"runtime_gender_keys_target_same","male":"Magister Merlin. As you can see, with King Rolan's aid, the rift has been completely sealed.","female":"Magister Merlin. As you can see, with King Rolan's aid, the rift has been completely sealed.","variant_male_record_index":"227576","variant_female_record_index":"227577","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1710844003:1":{"text":"What of the palace?","source_cn":"梅林，王宫那里如何？","status":"matched_runtime_gender","hash_xxh64":"0x1F897CBAF8C07576","variant_status":"runtime_gender_keys_target_same","male":"What of the palace?","female":"What of the palace?","variant_male_record_index":"227578","variant_female_record_index":"227579","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1710844003":{"text":"What of the palace?","source_cn":"梅林，王宫那里如何？","status":"matched_runtime_gender","hash_xxh64":"0x1F897CBAF8C07576","variant_status":"runtime_gender_keys_target_same","male":"What of the palace?","female":"What of the palace?","variant_male_record_index":"227578","variant_female_record_index":"227579","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710844004:1":{"text":"You explain Cyran's final descent into madness.","source_cn":"你言简意赅地说明了王宫的情况，并补充了最后的战况——","status":"matched_runtime_gender","hash_xxh64":"0xF363E3A459457B18","variant_status":"runtime_gender_keys_target_same","male":"You explain Cyran's final descent into madness.","female":"You explain Cyran's final descent into madness.","variant_male_record_index":"227580","variant_female_record_index":"227581","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1710844005:1":{"text":"How he sacrificed himself to summon even greater power, only to be consumed by it and dragged into the rift.","source_cn":"迪尔格雷在最后的疯狂中，不惜献祭自身，试图召唤更强大的...","status":"matched","hash_xxh64":"0xE56F3D39FC68A7D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710844006:1":{"text":"What remains now is cleanup.","source_cn":"剩下的，只是收拾残局了。","status":"matched","hash_xxh64":"0x232FAA3EC638ACB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1710844007:1":{"text":"Cyran's dark magic defiled the spirits of old heroes.","source_cn":"迪尔格雷的黑魔法亵渎了旧日英勇的灵魂。","status":"matched","hash_xxh64":"0x3411221403D371D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1710844008:1":{"text":"Hendrik!","source_cn":"亨德里克！","status":"matched","hash_xxh64":"0x77CBDBEAE056195F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1710844009:1":{"text":"Your Majesty!","source_cn":"到！陛下！","status":"matched","hash_xxh64":"0x1BEED6A079C19AC8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1710844010:1":{"text":"Clear the remaining monsters and tend to the wounded.","source_cn":"击退剩余魔物和救治伤员的任务，就交给你们了。","status":"matched","hash_xxh64":"0x447F41710F1C2887","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1710844011:1":{"text":"Yes, Your Majesty!","source_cn":"是！陛下！","status":"matched","hash_xxh64":"0xCF209207745DE475","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1710844012:1":{"text":"Cassadee and I will help too!","source_cn":"我和科丝蒂也去帮忙！","status":"matched","hash_xxh64":"0x7F878912C22CD8CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1710844013:1":{"text":"I'll treat the injured.","source_cn":"嗯！我可以救治伤员！","status":"matched","hash_xxh64":"0x9F803A5B4B1F4A8D","variant_status":"","male":"","female":"","