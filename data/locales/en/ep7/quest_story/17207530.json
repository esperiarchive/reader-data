{"asset_key":"ep7/quest_story_17207530","episode":"ep7","category":"quest_story","story_id":"17207530","schema_version":1,"lang":"en","texts":{"say:2:1720753001:1":{"text":"Ha, I knew it! This really is part of the trial!","source_cn":"看！我就知道！这果然是试炼的一部分！","status":"matched","hash_xxh64":"0xF2D2824CE6D13580","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1720753002:1":{"text":"Tsk, those two big guys are all bark and no bite! I didn't even go all out!","source_cn":"那两个大家伙虽然看起来吓人，但也就是看着唬人罢了！本公...","status":"matched","hash_xxh64":"0xA79DD3BD8BC15C54","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1720753003:1":{"text":"Peggy, don't let your guard down. This is just the beginning, and the real challenge may be yet to come.","source_cn":"佩吉，不要大意。这只是开始，真正的危险可能还在后面。","status":"matched","hash_xxh64":"0x31A06FBBE81CE03E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1720753004:1":{"text":"Let's press on! Nothing can stop me from getting the relics!","source_cn":"继续前进吧！无论里面有什么，我都一定要拿到那四件遗物！","status":"matched","hash_xxh64":"0x62C913A1F0EC9F4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:佩吉":{"text":"Peggy","source":"佩吉","status":"matched_dialogue_flow"},"speaker:格温妮丝":{"text":"Gwyneth","source":"格温妮丝","status":"matc