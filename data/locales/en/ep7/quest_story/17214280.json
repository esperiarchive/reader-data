{"asset_key":"ep7/quest_story_17214280","episode":"ep7","category":"quest_story","story_id":"17214280","schema_version":1,"lang":"en","texts":{"say:1:1721428001:0":{"text":"Excuse me, madam. Have you seen the lady who lives upstairs?","source_cn":"打扰了。女士，请问您见过住在二楼的那户小姐吗？","status":"matched","hash_xxh64":"0x473D3E9180E33A59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1721428002:0":{"text":"You mean that skinny girl?","source_cn":"你说那个很瘦的小姑娘？","status":"matched","hash_xxh64":"0x5F89374CB249612C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1721428003:0":{"text":"No idea where she went. She doesn't mingle with the likes of us.","source_cn":"不知道哪去了。她不爱跟我们这群“贫民”聊天，看都不看我...","status":"matched","hash_xxh64":"0x1E79CAA5C4B61EB6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1721428004:0":{"text":"Do you know when she last went out?","source_cn":"您知道她最后一次出门是什么时候吗？","status":"matched","hash_xxh64":"0xEBECEF5E225230CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1721428005:0":{"text":"How would I know? I barely know her!","source_cn":"我哪知道？我和她又不熟！","status":"matched","hash_xxh64":"0x3A3543A583C1F523","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","