{"asset_key":"ep7/quest_story_17107600","episode":"ep7","category":"quest_story","story_id":"17107600","schema_version":1,"lang":"en","texts":{"say:1:1710760001:1":{"text":"Is this really the Hall of Ancients?","source_cn":"……这、这里真的是圣古堂？","status":"matched","hash_xxh64":"0x474D515DB30CFDBE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1710760002:1":{"text":"I can't take it! I keep hearing something skittering in the walls!","source_cn":"我受不了了！我好像听到了什么东西在爬……","status":"matched","hash_xxh64":"0xE01C3D016BEFC6A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1710760003:1":{"text":"Monette, calm down!","source_cn":"梦妮，镇定点！","status":"matched","hash_xxh64":"0xCA5FBF0F3CD41966","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710760004:1":{"text":"... I don't want to believe it either. But this place... Last time I was here—","source_cn":"……虽然我也不愿相信，但这里，我上次来的时候——","status":"matched","hash_xxh64":"0xCC21378BE6054309","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1710760005:1":{"text":"Last time? Tannis... what happened?","source_cn":"坦尼斯！上次……上次你们遇到了什么？","status":"matched","hash_xxh64":"0x1B2B47E7FE46C223","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1710760006:1":{"text":"... Hypofiends. Endless waves of them. ","source_cn":"……魔物。如潮水一般汹涌而来的魔物。","status":"matched","hash_xxh64":"0x0E93524A0C6FE60E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1710760007:1":{"text":"We couldn't even fight back.","source_cn":"我们、我们根本无法抵抗。","status":"matched","hash_xxh64":"0x8DA94B54B159C6AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1710760008:1":{"text":"Help! Dura protect us!","source_cn":"救命啊！艾雅保佑——","status":"matched","hash_xxh64":"0x45463556F39A1B05","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1710760009:1":{"text":"Quiet!","source_cn":"公爵大人，噤声！","status":"matched","hash_xxh64":"0x63F5B9BCE34338CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1710760010:1":{"text":"Don't worry. We all made it through before.","source_cn":"别担心，我们最后都没事！","status":"matched","hash_xxh64":"0xF8FB8256539E7DC7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1710760011:1":{"text":"Excalibur... it blazed. Like the Great Emperor himself was watching over us. That light saved us.","source_cn":"圣古堂中供奉的石中剑仿佛是大帝显灵，爆发出了圣光！那把...","status":"matched","hash_xxh64":"0x34678B79D904F416","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1710760012:1":{"text":"Light...? Count Tannis, are you certain it will appear again? ","source_cn":"圣光……？坦尼斯伯爵，你确定这次……那圣光还会再出现吗？","status":"matched","hash_xxh64":"0x1986BA924FA52E17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1710760013:1":{"text":"We were all at the Prince's banquet... How can this be...?","source_cn":"毕竟我们，明明都在王子的晚宴上……","status":"matched","hash_xxh64":"0x7C6FA9C654E1273F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1710760014:1":{"text":"Where is His Highness? Is the Prince here too?","source_cn":"王子殿下呢？奥利安殿下也在这里吗？","status":"matched","hash_xxh64":"0x41F1D9B2C0775046","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1710760015:1":{"text":"We have to find him! We're his guests, after all!","source_cn":"我们得找到王子殿下！我们是他的客人啊！","status":"matched","hash_xxh64":"0x5B291BDE2FA43FEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1710760016:1":{"text":"He was fearless during the hunt. If he's here, he'll protect us for sure! ","source_cn":"殿下在猎场上何等英勇，他如果也在这里，一定会保护我们的！","status":"matched","hash_xxh64":"0x34C9996583FC9DF2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:女公爵梦妮":{"text":"Duchess Monette","source":"女公爵梦妮","status":"matched_dialogue_flow"},"speaker:伯爵坦尼斯":{"text":"Count Tannis","source":"伯爵坦尼斯","status":"matched_dialogue_flow"},"speaker:大臣康斯曼":{"text":"Minister Corsten","source":"大臣康斯曼","status":"matched_dialogue_flow"},"speaker:男爵葛朗台":{"text":"Baron Grandet","source":"男爵葛朗台","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":17,"localized_text_count":16,"speaker_count":4}}