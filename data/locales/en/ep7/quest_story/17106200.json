{"asset_key":"ep7/quest_story_17106200","episode":"ep7","category":"quest_story","story_id":"17106200","schema_version":1,"lang":"en","texts":{"say:2:1710620001:1":{"text":"They must have been starving. Good thing we changed back in time.","source_cn":"这些野狼已经饿了很久，幸好我们及时变回来了。","status":"matched","hash_xxh64":"0xA36228D9C742FA7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1710620002:1":{"text":"This view... I didn't think we could make it into the hunting grounds!","source_cn":"这熟悉的景色……我们真的进入猎场了！没想到是以这种方式……","status":"matched","hash_xxh64":"0xFD7F42FB4B15795C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1710620003:1":{"text":"How thrilling! Last time I snuck in, it wasn't that complicated.","source_cn":"唉呀，真是紧张刺激呀，本狐之前偷溜进来可没这么麻烦呢。","status":"matched","hash_xxh64":"0x4AA46011E6FCF041","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1710620004:1":{"text":"Hey, your scabbard is glowing!","source_cn":"哎，小狐狸，你背上的剑鞘……发亮了！","status":"matched","hash_xxh64":"0xEFC1AE31907BDD2B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:格温妮丝":{"text":"Gwyneth","source":"格温妮丝","status":"matched_dialogue_flow"},"speaker:小狐狸":{"text":"Little Fox","source":"小狐狸","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"locali