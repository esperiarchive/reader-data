{"asset_key":"ep7/env_story_17322455","episode":"ep7","category":"env_story","story_id":"17322455","schema_version":1,"lang":"en","texts":{"say:1:1732245501:0":{"text":"*Neigh* We're just chatting while waiting for the nobles to board.","source_cn":"咴咴，我们在闲聊，用以打发等待贵族上车前的这段时间。","status":"matched","hash_xxh64":"0x8D2F1E6EFEFF0B95","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1732245502:0":{"text":"*Neigh* I don't do chit-chat. You've been doing most of the talking.","source_cn":"咴，我可不喜欢闲聊，从头到尾都是你在那里像马蝇一样嗡嗡嗡。","status":"matched","hash_xxh64":"0x27B4DC36A3ED2536","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1732245503:1":{"text":"*Neigh* If chatting isn't your thing, how about we just press our upper and lower eyelids together...","source_cn":"咴咴，如果你不喜欢闲聊，我们也可以把上眼皮和下眼皮合在...","status":"matched","hash_xxh64":"0x8CC8EE893039053E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1732245504:1":{"text":"*Neigh* That's sleeping, basically!","source_cn":"咴，那不就是睡觉吗！","status":"matched","hash_xxh64":"0xEFE3677D79B31346","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:白马":{"text":"White Horse","source":"白马","status":"matched_dialogue_flow"},"speaker:棕马":{"text":"Brown Horse","source":"棕马","status":"matched_dialogue_flow"}},