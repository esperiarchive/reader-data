{"asset_key":"ep7/env_story_17322046","episode":"ep7","category":"env_story","story_id":"17322046","schema_version":1,"lang":"en","texts":{"say:1:1732204601:1":{"text":"Of course, it's the hottest topic at the moment! Plenty of people have been asking about it.","source_cn":"那当然，这可是最近的热门情报，不少人都来打听。","status":"matched","hash_xxh64":"0xC6186709B7417DC8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1732204602:1":{"text":"I'll tell you this—there's a secret behind the disappearance of the Hall of Ancients.","source_cn":"不怕告诉你们，圣古堂消失的背后是有秘密的。","status":"matched","hash_xxh64":"0xD943DF87BFAACA7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1732204603:1":{"text":"Tell me everything you know! Name your price, I'll pay it.","source_cn":"快跟我讲讲！对了情报多少钱，我花钱买。","status":"matched","hash_xxh64":"0x7F31DE7A53FF635E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:情报贩子肯恩":{"text":"Dealer Keni","source":"情报贩子肯恩","status":"matched_dialogue_flow"},"speaker:贵族黛娜":{"text":"Lady Dana","source":"贵族黛娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}