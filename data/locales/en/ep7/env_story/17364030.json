{"asset_key":"ep7/env_story_17364030","episode":"ep7","category":"env_story","story_id":"17364030","schema_version":1,"lang":"en","texts":{"say:1:1736403001:1":{"text":"C-Captain Gwyneth?! What brings you here?","source_cn":"格、格温妮丝大人？！您、您怎么会在这里？","status":"matched","hash_xxh64":"0x1519914E64AFA21B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1736403002:1":{"text":"There you are! I must say, your swordsmanship is exceptional. Have you had formal training?","source_cn":"我是专门来找你的。你的剑术非常出色，有人教你吗？","status":"matched","hash_xxh64":"0xCCBA33957662A900","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1736403003:1":{"text":"Formal training? No, I just figured it out myself...","source_cn":"剑术？都是我自己练的……没有人教我。","status":"matched","hash_xxh64":"0x51FAB3C4EA210FD8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1736403004:1":{"text":"Would you consider joining the Royal Guard reserves?","source_cn":"辛德瑞拉，你愿意加入皇家守备军预备役吗？","status":"matched","hash_xxh64":"0xE59FE65E0E780775","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1736403005:1":{"text":"You should use your talent to defend those in need.","source_cn":"你的才华不应该被埋没，而应该握剑，去保护更多的人！","status":"matched","hash_xxh64":"0x4971A8AC88759A3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1736403006:1":{"text":"Am I... good enough?","source_cn":"我……我真的可以吗？","status":"matched","hash_xxh64":"0x44ED44BE58A8D294","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1736403007:1":{"text":"You are! I'll train you myself until you become a full-fledged guard!","source_cn":"当然可以！只要你愿意，我会亲自教导你，直到你成为一名合...","status":"matched","hash_xxh64":"0x765927C9183D3429","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1736403008:1":{"text":"I-I'd like that!","source_cn":"我、我愿意！","status":"matched","hash_xxh64":"0xDD8BCB857F336ADC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:辛德瑞拉":{"text":"Cinderella","source":"辛德瑞拉","status":"matched_dialogue_flow"},"speaker:格温妮丝":{"text":"Gwyneth","source":"格温妮丝","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":2}}