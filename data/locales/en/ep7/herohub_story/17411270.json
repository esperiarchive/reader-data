{"asset_key":"ep7/herohub_story_17411270","episode":"ep7","category":"herohub_story","story_id":"17411270","schema_version":1,"lang":"en","texts":{"say:1:1741127001:1":{"text":"*Snore*... *Snore*...","source_cn":"呼……呼……呼……","status":"matched","hash_xxh64":"0xDA36A62D7D4D1C6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1741127002:1":{"text":"Huh? I fell asleep right here at the table? I guess foxes really do get sleepy after a good meal.","source_cn":"哎？我怎么趴在桌子上就睡着啦？果然狐吃饱了就会想睡觉呢。","status":"matched","hash_xxh64":"0x70007FDFACE9F1CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1741127003:1":{"text":"Mmm! Good food, good drinks, and a nice nap. I feel great now!","source_cn":"嗯！吃饱喝足睡好之后精神焕发！","status":"matched","hash_xxh64":"0x2F5F6E14F8C36CE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1741127004:1":{"text":"Now I'll head back to my lair... and start my next nap!","source_cn":"接下来就回窝里，开始下一轮的午休小憩吧！","status":"matched","hash_xxh64":"0x6988002D4914F0C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:小狐狸":{"text":"Little Fox","source":"小狐狸","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}