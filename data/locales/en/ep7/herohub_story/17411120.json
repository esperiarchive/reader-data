{"asset_key":"ep7/herohub_story_17411120","episode":"ep7","category":"herohub_story","story_id":"17411120","schema_version":1,"lang":"en","texts":{"say:2:1741112001:1":{"text":"Peggy, look! It's finally done!","source_cn":"佩吉，给你看这个！","status":"matched","hash_xxh64":"0x9E5C1BB94E7CC19C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:3::0":{"text":"Aix Toy","source_cn":"鸭子样品","status":"matched","hash_xxh64":"0x5D383B01F4C0282B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1741112002:0":{"text":"Oh, Rowan, is this the duck toy you kept talking about?","source_cn":"咦，罗万，这就是你之前说过要做的鸭子玩偶？","status":"matched","hash_xxh64":"0x2C8488B6B16651B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1741112003:1":{"text":"For the last time, it's a duck, not an aix... Wait, no! It's an aix, not a duck!","source_cn":"说了多少遍了，是鸭子，不是姝鸳！……不，不对，是姝鸳，...","status":"matched","hash_xxh64":"0x06C80C0FADB0AFC4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1741112004:1":{"text":"Hahaha! See? Even you can't tell the difference!","source_cn":"哈哈哈哈！你自己明明知道没什么差别！","status":"matched","hash_xxh64":"0xEBB95D52486A99D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_titl