{"asset_key":"ep7/herohub_story_17411190","episode":"ep7","category":"herohub_story","story_id":"17411190","schema_version":1,"lang":"en","texts":{"say:2:1741119001:1":{"text":"No... still not good enough.","source_cn":"不行……还是射得不够准。","status":"matched","hash_xxh64":"0x2E6AE0E6407A89C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1741119002:1":{"text":"You're hitting dead center from fifty meters. You're even splitting your own arrows. That's already incredible!","source_cn":"五十米外，箭箭十环，而且每一箭都精准地劈开了前一箭的箭...","status":"matched","hash_xxh64":"0xA4FD3DF2B159D0ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1741119003:1":{"text":"That's because the target isn't moving. In a real fight, I wouldn't have that luxury.","source_cn":"那只是针对静止目标的练习，如果是移动的物体，我的反应还...","status":"matched","hash_xxh64":"0x3C207C0A92A5EA21","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1741119004:1":{"text":"My father always says there are no second chances on the battlefield. One mistake is enough to cost a life—mine, or someone I'm trying to protect.","source_cn":"父亲常说，战场上没有第二次机会。哪怕是极其微小的失误，...","status":"matched","hash_xxh64":"0x5BF4413E027873EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1741119005:1":{"text":"I need to be faster, deadlier, more decisive... until nothing can escape my arrow.","source_cn":"我必须更快、更准、更果断……直到没有任何东西能逃过我的箭锋。","status":"matched","hash_xxh64":"0x322984A61D9DFAD0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:格温妮丝":{"text":"Gwyneth","source":"格温妮丝","status":"matched_dialogue_flow"},"speaker:小狐狸":{"text":"Little Fox","source":"小狐狸","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}}