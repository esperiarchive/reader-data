{"asset_key":"ep3/quest_story_13222500","episode":"ep3","category":"quest_story","story_id":"13222500","schema_version":1,"lang":"en","texts":{"say:1:1322250001:1":{"text":"Listen, Mister Hunter, the Duskmire Forest isn't safe at the moment. I strongly advise you not to return.","source_cn":"猎人先生，黑沼森林十分危险，请不要再闯进这里打猎了！","status":"matched","hash_xxh64":"0x203EC3FD715381D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322250002:1":{"text":"I thought the game here might be worth a bit more... I didn't expect so many Hypofiends!","source_cn":"我……我只是觉得这边的猎物可能会比较值钱……没想到这么...","status":"matched","hash_xxh64":"0x6E62A37F8019632C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322250003:1":{"text":"This place isn't suitable for hunting. We'll escort you back.","source_cn":"这里被魔物占据，不适合打猎，我们送你出去吧。","status":"matched","hash_xxh64":"0x40107FE67FF05CF9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322250004:1":{"text":"Thank you so much. I'll never come here again.","source_cn":"谢…谢谢……我不会再来这里了。","status":"matched","hash_xxh64":"0x939AE605A16CFEB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:闯入森林的猎人":{"text":"Hunter","source":"闯入森林的猎人","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}