{"asset_key":"ep3/quest_story_13113150","episode":"ep3","category":"quest_story","story_id":"13113150","schema_version":1,"lang":"en","texts":{"say:1:1311315001:0":{"text":"It's time to face the consequences of your choice, Valka.","source_cn":"去面对你的选择吧，瓦丽卡。","status":"matched","hash_xxh64":"0x4D4A030F98B21EA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1311315002:3":{"text":"What do you mean? I was only following your instructions, Lord of Death!","source_cn":"面对我自己的选择……谨遵您的教诲，死神大人！","status":"matched","hash_xxh64":"0x445C95E5FFB23576","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1311315003:3":{"text":"Relax. Do as you please. The sword is already yours.","source_cn":"喔，放松点，随便你怎么做都好，反正这把剑已经是你的了。","status":"matched","hash_xxh64":"0xB94A6B0702630279","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1311315004:0":{"text":"You won't see me for a while. I've kept my promise for two thousand years. Now I need some rest...","source_cn":"你们暂时不会见到我了。这约定的两千年，要休息多久才能补...","status":"matched","hash_xxh64":"0xF48E6B52630DE769","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:死神":{"text":"God of Death","source":"死神","status":"matched_dialogue_flow"},"speaker:瓦丽卡":{"text":"Valka","source":"瓦丽卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}