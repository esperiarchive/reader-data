{"asset_key":"ep3/quest_story_13201110","episode":"ep3","category":"quest_story","story_id":"13201110","schema_version":1,"lang":"en","texts":{"say:1:1320111001:0":{"text":"Weird. Why's it ignoring the food?","source_cn":"咦，怎么给它食物也不理睬了。","status":"matched","hash_xxh64":"0x79CA2F1CD6D591B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1320111002:0":{"text":"It's drawing again. What's it trying to tell us this time?","source_cn":"它又在涂涂画画了，到底想表达什么呢？","status":"matched","hash_xxh64":"0x482A2373405AA82F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1320111003:0":{"text":"It looks kinda like a word... But Chippy can't understand it...","source_cn":"看起来有点像是字……可这根本看不懂啊。","status":"matched","hash_xxh64":"0x0C53D111E53A76F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1320111004:1":{"text":"Has it actually learned the concept of words?!","source_cn":"它居然都成长到可以领悟文字的程度了吗！","status":"matched","hash_xxh64":"0x4B734663C33B0280","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1320111005:1":{"text":"I mean, it's totally unreadable... So it's still got some learning to do.","source_cn":"虽然完全看不懂……还需要经过一段时间学习。","status":"matched","hash_xxh64":"0x549F04010810BB35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1320111006:1":{"text":"I had no idea that any creatures besides familiars could reach this level of intelligence!","source_cn":"没想到除了被创造出来的使魔外，还有生物能达到这个智力水平！","status":"matched","hash_xxh64":"0xB69DF8FFEA2D4648","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1320111007:1":{"text":"I'm gonna pluck a few of its hairs and take them back to study.","source_cn":"我要拔几根它的毛回去研究一下。","status":"matched","hash_xxh64":"0xD3EE2104E0E7B62C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1320111008:1":{"text":"What's it trying to tell us? The crystalberries aren't yummy enough?","source_cn":"它想表达什么？觉得冰晶莓不够好吃？","status":"matched","hash_xxh64":"0x4E417C5A3F7F92A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1320111009:0":{"text":"ROAR!","source_cn":"嗷——","status":"matched","hash_xxh64":"0xD2FEAEC7F6DA2086","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1320111010:1":{"text":"Maybe it's just not hungry? Maybe it just wants to play with us?","source_cn":"难道是不饿？想要我们陪它玩？","status":"matched","hash_xxh64":"0x50E643D28F2A75CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1320111011:0":{"text":"ROAR!!!","source_cn":"嗷嗷——","status":"matched","hash_xxh64":"0xFB49653DC772AF35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1320111012:0":{"text":"Oh, I guess not?","source_cn":"嗯？也不对吗？","status":"matched","hash_xxh64":"0x0B4DA144F506ED86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1320111013:1":{"text":"Wait... It looks like it's about to cry!","source_cn":"等等——它看起来要急哭了！","status":"matched","hash_xxh64":"0x0030943C771A714D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1320111014:1":{"text":"How's it make such vivid expressions? It's really something worth studying!","source_cn":"它居然还能做出这么生动的表情！值得研究！","status":"matched","hash_xxh64":"0x758E018ECFC82A51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:叶角熊":{"text":"Hornleaf Bear","source":"叶角熊","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":15,"localized_text_count":14,"speaker_count":3}