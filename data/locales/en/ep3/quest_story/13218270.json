{"asset_key":"ep3/quest_story_13218270","episode":"ep3","category":"quest_story","story_id":"13218270","schema_version":1,"lang":"en","texts":{"say:1:1321827001:1":{"text":"Poor girl. Was the man who died a few days ago her father?","source_cn":"可怜的孩子，前几天遇难的男人是她的父亲吗？","status":"matched","hash_xxh64":"0x0A29254FFE9875A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1321827002:1":{"text":"May Dura bless her, and may her parents rest in peace in Dura's embrace.","source_cn":"愿艾雅保佑她，也愿她的父母在艾雅的国度得享安宁。","status":"matched","hash_xxh64":"0x3CE5442AF95C7C92","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1321827003:1":{"text":"Thank you, Acolyte Ogden. Please see that they are laid to rest together.","source_cn":"感谢您，奥格列修士，就请您把她父母的骸骨葬在一起吧。","status":"matched","hash_xxh64":"0xAE2BDC482C39A790","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321827004:1":{"text":"Of course. The funeral will take place at the cemetery tomorrow morning, and I'll personally conduct the ceremony.","source_cn":"我知道了。我会将他们安葬在教堂的墓地内。如果可以的话，...","status":"matched","hash_xxh64":"0xE18A34BEC924B27E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321827005:1":{"text":"Thank you...","source_cn":"谢谢你……","status":"matched","hash_xxh64":"0x607C8D9152AAD51A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321827006:1":{"text":"Thanks for taking care of this.","source_cn":"非常感谢，奥格列修士，这件事就劳烦你们了。","status":"matched","hash_xxh64":"0xEAB091157742937D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321827007:1":{"text":"We'll be there on time tomorrow morning.","source_cn":"我们明天早晨会准时来参加葬礼的。","status":"matched","hash_xxh64":"0x33AEF51A8D538899","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修士奥格列":{"text":"Acolyte Ogden","source":"修士奥格列","status":"matched_dialogue_flow"},"speaker:法拉莫尔":{"text":"Faramor","source":"法拉莫尔","status":"matched_dialogue_flow"},"speaker:奥尔嘉":{"text":"Orla","source":"奥尔嘉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":3}}