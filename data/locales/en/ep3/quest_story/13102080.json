{"asset_key":"ep3/quest_story_13102080","episode":"ep3","category":"quest_story","story_id":"13102080","schema_version":1,"lang":"en","texts":{"say:3:1310208001:1":{"text":"Prin...","source_cn":"殿……","status":"matched","hash_xxh64":"0xB682D238C132B9D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1310208002:1":{"text":"Shh! I told you not to call me that when we're out!","source_cn":"嘘！都说了出门不要这么叫……","status":"matched","hash_xxh64":"0xFA1231768AA0363C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1310208003:1":{"text":"Ahem... Miss Yolena, running around like this isn't safe. If your father finds out, he's going to be furious...","source_cn":"咳……亚莲娜小姐，这样到处乱跑很不安全，您父亲知道了会...","status":"matched","hash_xxh64":"0x4E261C9DA0A33CFD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1310208004:1":{"text":"Oh, come on! It's fine just this once!","source_cn":"哎呀，没关系的，就这一次嘛。","status":"matched","hash_xxh64":"0x668DC8B7A24E45A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1310208005:1":{"text":"Ugh, pleeeease, Rodrigo! Don't tell him. I'm begging you!","source_cn":"拜托了，罗德里戈，不要告诉我父亲好不好？求你了……","status":"matched","hash_xxh64":"0x12540B4165DFB5A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_re