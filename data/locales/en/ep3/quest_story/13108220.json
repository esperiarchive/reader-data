{"asset_key":"ep3/quest_story_13108220","episode":"ep3","category":"quest_story","story_id":"13108220","schema_version":1,"lang":"en","texts":{"say:1:1310822001:0":{"text":"Thank Dura above, you're all normal!","source_cn":"你们……你们……艾雅在上，你们还正常！","status":"matched","hash_xxh64":"0x97310198B2150B3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1310822002:0":{"text":"They've all gone crazy! Evil has inhabited their hearts!","source_cn":"他们都疯了……他们……邪恶，邪恶污染了他们的内心！","status":"matched","hash_xxh64":"0xCC52BB19DDD4D3CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1310822002":{"text":"They've all gone crazy! Evil has inhabited their hearts!","source_cn":"他们都疯了……他们……邪恶，邪恶污染了他们的内心！","status":"matched","hash_xxh64":"0xCC52BB19DDD4D3CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1310822003:0":{"text":"I'm trying to calm down.","source_cn":"冷静……我要冷静……我、我……","status":"matched_runtime_gender","hash_xxh64":"0x70346F95A6AB5F63","variant_status":"runtime_gender_keys_target_same","male":"I'm trying to calm down.","female":"I'm trying to calm down.","variant_male_record_index":"145317","variant_female_record_index":"145318","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1310822005:1":{"text":"What happened?","source_cn":"发生了什么事？","status":"matched","hash_xxh64":"0x944B535BD067270C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1310822006:0":{"text":"Y-you're one of the undead! No!","source_cn":"你、你……活死人？！啊——","status":"matched","hash_xxh64":"0x5F9E11FEF7285738","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1310822007:1":{"text":"Don't be scared! Valka won't hurt you. Look, we're with her, and we're fine.","source_cn":"不要怕！瓦丽卡不会伤害你的，你看我们一点事都没有！","status":"matched","hash_xxh64":"0x90B4C751A4E65DA8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1310822008:1":{"text":"Please calm down. Tell us exactly what happened?","source_cn":"请冷静一下，慢慢说，到底发生什么了？","status":"matched","hash_xxh64":"0xE971A6DDAAD70AEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1310822009:1":{"text":"Up at the temple! There's a monster! The monster must've corrupted the hearts of our fellow acolytes. They've all gone mad!","source_cn":"上……上面……小教堂……怪物！邪恶的怪物！一定是怪物玷...","status":"matched","hash_xxh64":"0xE088396D97F07075","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1310822010:0":{"text":"A monster at the temple? You have to tell us more than that. How about you take us there?","source_cn":"呃……小教堂……怪物？看起来你也说不清楚，干脆你带我们...","status":"matched","hash_xxh64":"0x1C837EE43C4E79BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1310822011:0":{"text":"Don't be afraid. We're all very powerful. We won't let the monster hurt you.","source_cn":"别怕，我们很厉害，不会让怪物伤害你的！","status":"matched","hash_xxh64":"0x0319EF1D3F9C4993","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"Calm yourself.","source_cn":"冷静点，别激动","status":"matched_runtime_gender","hash_xxh64":"0xEAA479459D9F488E","variant_status":"runtime_gender_keys_target_same","male":"Calm yourself.","female":"Calm yourself.","variant_male_record_index":"68794","variant_female_record_index":"68795","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1310822004:0":{"text":"I'm not crazy! They're crazy!","source_cn":"没有！我没有！疯的是他们！","status":"matched_runtime_gender","hash_xxh64":"0x8D0858D277901458","variant_status":"runtime_gender_keys_target_same","male":"I'm not crazy! They're crazy!","female":"I'm not crazy! They're crazy!","variant_male_record_index":"145319","variant_female_record_index":"145320","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"You look like the crazy one.","source_cn":"你看起来更像是疯了","status":"matched_runtime_gender","hash_xxh64":"0x7F18E348BD7A646F","variant_status":"runtime_gender_keys_target_same","male":"You look like the crazy one.","female":"You look like the crazy one.","variant_male_record_index":"68796","variant_female_record_index":"68797"