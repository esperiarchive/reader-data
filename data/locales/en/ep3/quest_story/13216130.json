{"asset_key":"ep3/quest_story_13216130","episode":"ep3","category":"quest_story","story_id":"13216130","schema_version":1,"lang":"en","texts":{"say:1:1321613001:1":{"text":"This is it! This is where I lived!","source_cn":"这里……是这里！我的家在这里……","status":"matched","hash_xxh64":"0x08CA68A49CAEEC06","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1321613002:0":{"text":"Are you sure?! Which house is yours?!","source_cn":"真的？！是哪一间房子？！","status":"matched","hash_xxh64":"0x6254DEF982580348","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321613003:1":{"text":"Wait... my house isn't here anymore... I don't see my house...","source_cn":"没有……没有我家的房子了……","status":"matched","hash_xxh64":"0x3EF38C29F101513E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321613004:0":{"text":"How long has it been since I left home? Mother, Father, Thalia... where are you?","source_cn":"我……我离开家，究竟多久了……母亲，父亲，佐娅……","status":"matched","hash_xxh64":"0xA963CC7EAEE6489E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321613005:1":{"text":"Dominique...","source_cn":"德米，别太伤心……","status":"matched","hash_xxh64":"0x30EC5AAD8130B536","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_titl