{"asset_key":"ep3/quest_story_13103550","episode":"ep3","category":"quest_story","story_id":"13103550","schema_version":1,"lang":"en","texts":{"say:3:1310355001:0":{"text":"You there—halt!","source_cn":"喂，你——站住！","status":"matched","hash_xxh64":"0xF55D002600F2F3A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1310355002:0":{"text":"Everyone, exercise caution. He's no ordinary mindless undead; this one is an actual Graveborn...","source_cn":"大家要小心，他不是那些失去理智的“活死人”，他是真正的...","status":"matched","hash_xxh64":"0xF1BD3E8201AFA446","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1310355003:1":{"text":"Hey, everyone, do you wanna keep playing?","source_cn":"嘿嘿，你们，继续玩吗？","status":"matched","hash_xxh64":"0xDBEA2026898DF3D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1310355003":{"text":"Hey, everyone, do you wanna keep playing?","source_cn":"嘿嘿，你们，继续玩吗？","status":"matched","hash_xxh64":"0xDBEA2026898DF3D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1310355004:0":{"text":"Master Mage, be careful. Do not approach him so casually...","source_cn":"魔法师大人，别离他太近……","status":"matched_runtime_gender","hash_xxh64":"0x11209CC5D960DB13","variant_status":"runtime_gender_keys_target_same","male":"Master Mage, be careful. Do not approach him so casually...","female":"Master Mage, be careful. Do not approach him so casually...","variant_male_record_index":"144297","variant_female_record_index":"144298","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1310355004":{"text":"Master Mage, be careful. Do not approach him so casually...","source_cn":"魔法师大人，别离他太近……","status":"matched_runtime_gender","hash_xxh64":"0x11209CC5D960DB13","variant_status":"runtime_gender_keys_target_same","male":"Master Mage, be careful. Do not approach him so casually...","female":"Master Mage, be careful. Do not approach him so casually...","variant_male_record_index":"144297","variant_female_record_index":"144298","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1310355005:1":{"text":"You caught up, guess we're playing together now!","source_cn":"追上来了，那就一起玩耍！","status":"matched","hash_xxh64":"0x8DFAF5759E94D996","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1310355008:0":{"text":"Wait, wait. You just wanted to play with us? No secret plan? Nothing else?","source_cn":"呃……你就只想找人一起玩耍？没有别的了？","status":"matched","hash_xxh64":"0x2D6E829718354DF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1310355009:1":{"text":"Everything else is a total snooze-fest! Playing is the best thing EVER!","source_cn":"别的，没意思！玩耍，有意思！","status":"matched","hash_xxh64":"0x79FEB20F04E5A295","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1310355010:0":{"text":"Mr. Undead, if you truly have no ill intent, I won't have to resort to force.","source_cn":"亡灵先生，如果你没有伤害别人的想法，我不会对你下死手。","status":"matched","hash_xxh64":"0xA6D066198BFE9A20","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1310355011:0":{"text":"However, this is a festival, and I have a duty to uphold. I might need to take you into custody at the guardhouse for a short while. I trust you understand.","source_cn":"但祭典期间，我必须得履行我的职责，或许得委屈你在看守室...","status":"matched","hash_xxh64":"0x621E7ABE61F91179","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1310355012:1":{"text":"Guardhouse? Ugh, no way! You can't jump off tombstones in the guardhouse! How lame is that? I'm not going!","source_cn":"不要！看守室里不能跳墓碑！无聊，不去！","status":"matched","hash_xxh64":"0xA377AB932E0028A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1310355013:1":{"text":"Let's rumble instead! It's way more fun! C'mon, all of you—get in on this!","source_cn":"来打架吧！有趣！你们都来陪我玩！","status":"matched","hash_xxh64":"0x56B6E5EE032484F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"He doesn't seem dangerous...","source_cn":"他似乎没什么恶意……","status":"matched_runtime_gender","hash_xxh64":"0x6B540FEA7BEA4BCA","variant_status":"runtime_gender_keys_target_same","male":"He doesn't seem dangerous...","female":"He doesn't seem dangerous...","variant_male_record_index":"68824","variant_female_record_index":"68825","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"What are you doing?","source_cn":"你想做什么？","status":"matched_runtime_gender","hash_xxh64":"0x9C6E351334DB4494","variant_status":"runtime_gender_keys_target_same","male":"What are you doing?","female":"What are you doing?","variant_male_record_index":"68820","variant_female_record_index":"68821","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1310355006:1":{"text":"Yes! We can bounce off tombstones and play hide-and-seek!","source_cn":"可以一起，跳墓碑！捉迷藏！","status":"matched","hash_xxh64":"0x79AEA297C89B4CD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1310355007:1":{"text":"Just like before, it's so much fun!","source_cn":"就像刚才那样！好玩！","status":"matched","hash_xxh64":"0x20AABACE675F617A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"\"Keep playing\"?","source_cn":"继续玩……？","status":"matched_runtime_gender","hash_xxh64":"0xD35E2946963FCF61","variant_status":"runtime_gender_keys_target_same","male":"\"Keep playing\"?","female":"\"Keep playing\"?","variant_male_record_index":"68822","variant_female_record_index":"68823","document_title":"","document_title_male":"","document_title_f