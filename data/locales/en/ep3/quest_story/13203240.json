{"asset_key":"ep3/quest_story_13203240","episode":"ep3","category":"quest_story","story_id":"13203240","schema_version":1,"lang":"en","texts":{"say:2:1320324001:1":{"text":"Here it is.","source_cn":"就是眼前的这棵树了。","status":"matched","hash_xxh64":"0xB97799560D142C0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1320324002:1":{"text":"Huh, is there something special about this tree? It doesn't look all that different to Chippy...","source_cn":"唔，这棵树有什么特别的吗？满满觉得和其他树好像也没什么区别。","status":"matched","hash_xxh64":"0x119094F3157F2CDC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1320324003:1":{"text":"I planted it back when I was alive.\nAfter I learned that my illness couldn't be cured, I came here to see if I could still bring life to something else.","source_cn":"它是我生前种下的树。\\n在我得知我的病无法痊愈后，就偷...","status":"matched","hash_xxh64":"0x238B511A93EA8659","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1320324004:1":{"text":"I hoped that this tree would carry my hopes and thrive in my stead.","source_cn":"那时的我想，即使我死去，这棵树也能承载着我的希望，不断...","status":"matched","hash_xxh64":"0xA685CA5B440C7946","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1320324005:1":{"text":"However, I never imagined I'd continue on in this form... Now, as it withers, here I am still.","source_cn":"我从没想过，自己会变成现在的模样。用另一种方式永恒地活...","status":"matched","hash_xxh64":"0x704AD0D7B5814629","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1320324006:1":{"text":"I once buried a charm with my name beneath it, hoping it would protect the tree.","source_cn":"我曾经将一个刻有名字的护符埋在了树下，希望它能庇佑这棵树。","status":"matched","hash_xxh64":"0xD4CFD44B7FE499E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1320324007:1":{"text":"Now it's time to take it back.","source_cn":"现在，是时候收回它了。","status":"matched","hash_xxh64":"0xC61923754178BF44","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:柳博米尔":{"text":"Ludovic","source":"柳博米尔","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}}