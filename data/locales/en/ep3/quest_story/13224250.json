{"asset_key":"ep3/quest_story_13224250","episode":"ep3","category":"quest_story","story_id":"13224250","schema_version":1,"lang":"en","texts":{"say:1:1322425001:1":{"text":"You've entered my domain, and that means you must follow my rules!","source_cn":"你们踏入了我的领地，就要听从我的指挥！","status":"matched","hash_xxh64":"0x0D50042E1E497C9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322425002:1":{"text":"Your domain?","source_cn":"领地？","status":"matched","hash_xxh64":"0x653454D98E502315","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322425003:1":{"text":"Shh! Let Chippy handle this!","source_cn":"嘘、嘘！看满满的！","status":"matched","hash_xxh64":"0x15A9CA2427A006DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322425004:1":{"text":"Ahem... Your Highness, forgive our intrusion, but we could not possibly pass through your domain without first offering our respects.","source_cn":"咳咳……殿下，我们经由您的领地，怎可不来打声招呼，献上...","status":"matched","hash_xxh64":"0x6A0559A38D25822C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322425005:1":{"text":"Hah! Now that's the proper attitude!","source_cn":"哈！说得好！说得好！","status":"matched","hash_xxh64":"0xC9C9817EDAF3AA32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1322425006:1":{"text":"I heard there's been a lot of turmoil in your domain lately—strange forces at play. Some so-called prophets of the Great Will have gained quite the following among the people. Are you aware of this?","source_cn":"我听说您的领地最近波澜四起，诡谲潜伏，有些自称伟大意志...","status":"matched","hash_xxh64":"0x15975910E138D20C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1322425007:1":{"text":"Uh... what? Strange... what now? Speak plain English!","source_cn":"呃，什么……诡……？什么意思？你还是说白话吧。","status":"matched","hash_xxh64":"0xAD1543C489118B60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1322425008:1":{"text":"They're asking if any priests have been going around preaching about the Great Will.","source_cn":"他问你最近地盘上有没有一些伟大意志的传教士。","status":"matched","hash_xxh64":"0x2A2408DCD0874920","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1322425009:1":{"text":"Oh, yeah. I've seen them. But...","source_cn":"有倒是有，不过呢……","status":"matched","hash_xxh64":"0xF2E278175CE6425B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1322425010:1":{"text":"But what? Tell us anything you know, Your Highness!","source_cn":"不过什么？殿下尽管说！","status":"matched","hash_xxh64":"0x973EF3116BAB4A0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1322425011:1":{"text":"Oh, I could, but you'll have to beat us first! Take this!","source_cn":"不过你得打赢我们！看招！","status":"matched","hash_xxh64":"0x0CA18030DB12E7CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1322425012:1":{"text":"Ow! Snowballs?! Haha... you messed with the wrong people!","source_cn":"哎哟！是雪球！哈哈……我的主人也不是吃素的！","status":"matched_runtime_gender","hash_xxh64":"0x4E1E0A7416FD004F","variant_status":"runtime_gender_keys_target_same","male":"Ow! Snowballs?! Haha... you messed with the wrong people!","female":"Ow! Snowballs?! Haha... you messed with the wrong people!","variant_male_record_index":"149869","variant_female_record_index":"149870","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1322425013:1":{"text":"Magister! We gotta fight back!","source_cn":"还击！主人我们快还击！","status":"matched_runtime_gender","hash_xxh64":"0xB2BDFBD3691B79F9","variant_status":"runtime_gender_keys_target_same","male":"Magister! We gotta fight back!","female":"Magister! We gotta fight back!","variant_male_record_index":"149871","variant_female_record_index":"149872","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:孩子王格列布":{"text":"Alpha Kid Gleb","source":"孩子王格列布","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14,"localized_text_count":13,"speaker_count":3}}