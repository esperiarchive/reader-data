{"asset_key":"ep3/quest_story_13218140","episode":"ep3","category":"quest_story","story_id":"13218140","schema_version":1,"lang":"en","texts":{"say:1:1321814001:1":{"text":"Orla, could you stay in town for a while?","source_cn":"奥尔嘉，你先在镇子里待一阵好吗？","status":"matched","hash_xxh64":"0x23B0D4919680EA7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1321814002:2":{"text":"Faramor, a-are you leaving me too?","source_cn":"呜呜……法拉莫尔，你……你要走了吗？","status":"matched","hash_xxh64":"0x69F73EDCEBDD265B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1321814003:1":{"text":"I knew it... Adults never keep their promises! *Sob* You're just like Mama and Papa...","source_cn":"我就知道……你们大人讲话从来都不算数！呜呜……妈妈是，...","status":"matched","hash_xxh64":"0x5573097172A27756","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321814004:1":{"text":"I give you my word—I will not abandon you.","source_cn":"别担心，我说了会陪着你的，我不会食言。","status":"matched","hash_xxh64":"0x84945CA6F88BC632","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321814005:1":{"text":"But... something isn't right. I don't believe your father was killed by the undead. I need to investigate.","source_cn":"我只是觉得……你父亲可能并不是被活死人袭击而亡的，我想...","status":"matched","hash_xxh64":"0x5F44D13B3153EE1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1321814005":{"text":"But... something isn't right. I don't believe your father was killed by the undead. I need to investigate.","source_cn":"我只是觉得……你父亲可能并不是被活死人袭击而亡的，我想去调查一下。","status":"matched","hash_xxh64":"0x5F44D13B3153EE1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321814006:2":{"text":"Hmm. His injuries weren't deep, yet the bleeding never stopped...","source_cn":"唔，明明不深但很难止血……确实有点蹊跷呢。","status":"matched","hash_xxh64":"0x80CA1AFF587EA12D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1321814008:1":{"text":"Let's return to the scene and search for answers.","source_cn":"我们有必要回刚才的地方好好进行一番搜索，一定能找到有用...","status":"matched","hash_xxh64":"0x8C2B613E3B7F8A3E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1321814009:1":{"text":"Faramor... Will you be back?","source_cn":"那……法拉莫尔……你，你会回来的吧？","status":"matched","hash_xxh64":"0xEE0A14141620A6AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1321814010:1":{"text":"I will. Trust me.","source_cn":"一定会的。相信我，好吗？","status":"matched","hash_xxh64":"0xCA32A37BE8A599B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1321814011:1":{"text":"Yes...","source_cn":"嗯……","status":"matched","hash_xxh64":"0xDFA76E79688862B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"His wounds were strange.","source_cn":"他的伤口很奇怪","status":"matched_runtime_gender","hash_xxh64":"0x98604E55BDF1924A","variant_status":"runtime_gender_keys_target_same","male":"His wounds were strange.","female":"His wounds were strange.","variant_male_record_index":"71098","variant_female_record_index":"71099","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1321814007:1":{"text":"I can't say for certain. But I intend to find out.","source_cn":"不好说，但我希望不是这样。","status":"matched","hash_xxh64":"0xCEF190F37CE07457","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"Another kind of monster did it?","source_cn":"难道有新的怪物？","status":"matched_runtime_gender","hash_xxh64":"0xF5F9B9446DCAFEC0","variant_status":"runtime_gender_keys_target_same","male":"Another kind of monster did it?","female":"Another kind of monster did it?","variant_male_record_index":"71100","variant_female_record_index":"71101","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:法拉莫尔":{"text":"Faramor","source":"法拉莫尔","status":"matched_dialogu