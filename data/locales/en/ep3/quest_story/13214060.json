{"asset_key":"ep3/quest_story_13214060","episode":"ep3","category":"quest_story","story_id":"13214060","schema_version":1,"lang":"en","texts":{"say:3:1321406001:1":{"text":"Hey, why is there a person lying in front of the ice sculpture?","source_cn":"奇怪，冰雕前面怎么躺着个人，还说着乱七八糟的话……","status":"matched","hash_xxh64":"0x74F6564C5741992C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321406002:1":{"text":"Stephan! You've been drinking again!","source_cn":"——哥哥！你又跑去喝酒了！","status":"matched","hash_xxh64":"0xF8A46CC383438383","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321406003:1":{"text":"He's your brother?","source_cn":"哎？倒在地上的这个人就是你哥哥？！","status":"matched","hash_xxh64":"0x37E1F98287AE6D6A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321406004:1":{"text":"Yeah, I think he went drinking again. Otherwise, he wouldn't have been away so long.","source_cn":"是啊。我就猜到他去喝酒了，不然才不会这么久都不回家！","status":"matched","hash_xxh64":"0x0457AD2B2213A78A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321406005:1":{"text":"Wake up, Stephan! It's time to go home! ","source_cn":"哥哥，快醒醒，该回家了！有人找你！","status":"matched","hash_xxh64":"0xC8DA0DDCD3A68F5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index"