{"asset_key":"ep3/quest_story_13217730","episode":"ep3","category":"quest_story","story_id":"13217730","schema_version":1,"lang":"en","texts":{"say:3:1321773001:0":{"text":"The ball has started...","source_cn":"……舞会竟然开始了。","status":"matched","hash_xxh64":"0x3AA1F437DD57CAF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321773002:0":{"text":"But Princess Yolena and Miss Lydia aren't here either...","source_cn":"可是，亚莲娜公主和莉娅女士也不在这里……","status":"matched","hash_xxh64":"0xD0E2C07C2BDF1932","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321773003:0":{"text":"No, this isn't right.","source_cn":"不……这不对。","status":"matched","hash_xxh64":"0x9E576A6591111E6E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321773004:1":{"text":"This celebration was specially prepared for Her Highness, so she should perform the opening dance. Even if she's feeling unwell, she should still be here.","source_cn":"这场庆典是特意为公主殿下准备的，所以开场舞必定要由殿下...","status":"matched","hash_xxh64":"0xFC3F3A3765FBDE7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321773005:1":{"text":"Calm down. Let's ask the maids and guards here. They should provide some information.","source_cn":"别激动。这里有不少侍女和侍卫，找他们问清楚发生了什么事...","status":"matched","hash_xxh64":"0xBBCB2FAE86BCA0FD","vari