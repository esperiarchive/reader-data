{"asset_key":"ep3/quest_story_13104200","episode":"ep3","category":"quest_story","story_id":"13104200","schema_version":1,"lang":"en","texts":{"say:2:1310420001:0":{"text":"A-are they gone? I...","source_cn":"它们、它们走了吗？……我、我……","status":"matched","hash_xxh64":"0x9AFE0BBEE190A714","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1310420002:0":{"text":"It's okay, you're safe now! We're here to protect you.","source_cn":"别害怕，它们已经没法伤到你了，有我们在呢！","status":"matched","hash_xxh64":"0xC57D9B09FCCADDFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1310420003:0":{"text":"And look over there, see that white wolf gentleman? He's every undead's worst nightmare!","source_cn":"还有那位白狼先生，看到了吗？他可是活死人的克星，所有的...","status":"matched","hash_xxh64":"0x34D3B396098BFD82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1310420004:0":{"text":"Really? Then... I'm not scared anymore.","source_cn":"真的吗？……那、那我不怕了……","status":"matched","hash_xxh64":"0x7256B75C7256B3DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1310420005:0":{"text":"You were so brave through all of that! Seriously, I was shaking in my boots, but you—you're going to be someone incredible when you grow up, I just know it.","source_cn":"哇，刚才你都没有被活死人吓哭，真厉害！我都被活死人吓得...","status":"matched","hash_xxh64":"0xD0B2454B07212A5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1310420006:0":{"text":"Alright, since you're so brave, stay close, okay? Just hang tight and watch us take care of the rest of these spooky undead.","source_cn":"好啦，你这么胆大，那就在这里不要乱跑，看我们赶走这些活...","status":"matched","hash_xxh64":"0x5AE3C8A176B2FDD9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1310420007:0":{"text":"Thank you, Mr. Rabbit... and everyone else, too...","source_cn":"嗯……谢谢你，兔子先生……谢谢你们……","status":"matched","hash_xxh64":"0x01387EFFC3C6E1F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:亚历克斯":{"text":"Alex","source":"亚历克斯","status":"matched_dialogue_flow"},"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}}