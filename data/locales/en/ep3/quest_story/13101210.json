{"asset_key":"ep3/quest_story_13101210","episode":"ep3","category":"quest_story","story_id":"13101210","schema_version":1,"lang":"en","texts":{"say:2:1310121001:0":{"text":"The soup smells so good. Chippy wants another bowl...","source_cn":"好香啊，还想再吃一点……","status":"matched","hash_xxh64":"0x6BA297950C3A96AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1310121002:0":{"text":"Chippy didn't expect Faramor to be such a good cook! And he really knows his herbs. The soup has this special, refreshing taste!","source_cn":"没想到法拉莫尔先生的厨艺这么棒！而且他还很会用草药，炖...","status":"matched","hash_xxh64":"0xA72BD6249287FAF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1310121003:0":{"text":"Yes, I've studied herbs too, but I never thought of using them in food like this...","source_cn":"的确，我也研究过草药，可是从来没试过像这样把草药和食物...","status":"matched","hash_xxh64":"0x502591E55533E90C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1310121004:0":{"text":"Faramor must be a very wise warrior.","source_cn":"法拉莫尔先生一定是位知识渊博的绿裔战士。","status":"matched","hash_xxh64":"0xBF8B18C905BAB82B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matc