{"asset_key":"ep3/quest_story_13110140","episode":"ep3","category":"quest_story","story_id":"13110140","schema_version":1,"lang":"en","texts":{"say:0:1311014001:0":{"text":"How come you know about this passage, Carolina?","source_cn":"卡列琳娜，为什么你会知道这条密道……","status":"matched","hash_xxh64":"0xBF496A9A8D433BFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1311014002:0":{"text":"My family was always connected to the temple. A past hierophant allowed an escape passage to be built.","source_cn":"我的家族世代虔诚，兴建庄园时，大主教特别允许先祖修建了...","status":"matched","hash_xxh64":"0xAE748BF6DBB4A1BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1311014003:0":{"text":"But in the end, only my brother and I have used it...","source_cn":"不过到最后，只有我和哥哥用上了它……","status":"matched","hash_xxh64":"0x59AEBAF6F50653E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:卡列琳娜":{"text":"Carolina","source":"卡列琳娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}