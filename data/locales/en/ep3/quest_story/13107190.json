{"asset_key":"ep3/quest_story_13107190","episode":"ep3","category":"quest_story","story_id":"13107190","schema_version":1,"lang":"en","texts":{"say:2:1310719001:0":{"text":"Again? I've yet to cast the spell. Have you seen me somewhere else before?","source_cn":"又？我还没有施过法啊？难道你们曾经在别的地方见过我？","status":"matched","hash_xxh64":"0x722C813B54E4B26E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1310719002:0":{"text":"Strange, I should remember a group like yours.","source_cn":"奇怪，你们这样的组合，我不该一点印象都没有。","status":"matched","hash_xxh64":"0x20B43F07466BB78B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1310719003:0":{"text":"We've met before, and it was a mess...","source_cn":"我们确实见过，而且后果一团糟……","status":"matched","hash_xxh64":"0x0C48DC667590D358","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1310719004:0":{"text":"A mess... Are you talking about the time Rezek got married? Or the rat infestation in Kopeham? Or... maybe when little Jessica's doll came alive and ran away?","source_cn":"一团糟……你们说的是雷兹克结婚那次，还是科佩村除鼠害那...","status":"matched","hash_xxh64":"0x40618DC09BBE47C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1310719005:0":{"text":"How many times have you messed up?!","source_cn":"……你到底搞砸过多少次啊！","status":"matched","hash_xxh64":"0xA942BEEDF0EFF4C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:魔法师维茨瓦夫":{"text":"Witstaff","source":"魔法师维茨瓦夫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}}