{"asset_key":"ep3/quest_story_13210090","episode":"ep3","category":"quest_story","story_id":"13210090","schema_version":1,"lang":"en","texts":{"say:3:1321009001:1":{"text":"Everyone, please, enjoy the tea!","source_cn":"各位客人，请不用客气，尽情品尝这杯茶吧。","status":"matched","hash_xxh64":"0xA3B93E72C176DB25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321009002:1":{"text":"Ahem, Mister Flower, I've specifically used the tea leaves you picked.","source_cn":"奇花，这次我可是用了你采摘的茶叶。","status":"matched","hash_xxh64":"0xA704801EDF9B119B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321009003:1":{"text":"Oh, you mean those with petals...","source_cn":"啊，你是说那些花瓣……","status":"matched","hash_xxh64":"0x16AD09E27EC02AEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1321009004:1":{"text":"Mister Teapot, is this your way of saying sorry?","source_cn":"茶壶先生，你这算是在向奇花示好吗？","status":"matched","hash_xxh64":"0x740C2F6C932134F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1321009005:1":{"text":"*Cough* Please, don't make fun of me.","source_cn":"咳……！请您不要取笑我。","status":"matched","hash_xxh64":"0x46DB10DCEB934DF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_ma