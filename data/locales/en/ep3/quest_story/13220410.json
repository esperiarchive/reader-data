{"asset_key":"ep3/quest_story_13220410","episode":"ep3","category":"quest_story","story_id":"13220410","schema_version":1,"lang":"en","texts":{"say:3:1322041001:1":{"text":"Thank you all—Magister, Mr. Igor, Alex!","source_cn":"谢谢你们——<male>大哥哥</male><fema...","status":"matched_runtime_gender","hash_xxh64":"0x027B2E267B206E1B","variant_status":"runtime_gender_keys_target_same","male":"Thank you all—Magister, Mr. Igor, Alex!","female":"Thank you all—Magister, Mr. Igor, Alex!","variant_male_record_index":"152966","variant_female_record_index":"152967","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322041002:1":{"text":"I want to continue playing with you all, but if I don't go home soon, my mother will find out...","source_cn":"我好想多和你们玩一会，可是再不回家的话，一定会被妈妈发...","status":"matched","hash_xxh64":"0xFD23C5F2B89C840E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322041003:1":{"text":"It's alright. Hurry home! Don't let her find out, and we can play next time!","source_cn":"没关系，你回去吧，别被家里人发现！我们下次再一起玩！","status":"matched","hash_xxh64":"0x5814018CA94B513B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1322041004:1":{"text":"Yes! That was fun! Call me out, too!","source_cn":"有趣，太有趣了！我也要一起！叫我！","status":"matched","hash_xxh64":"0x6D5FA1018AE3BB7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1322041005:1":{"text":"Okay, next time let's meet by the river and go ice skating.","source_cn":"好呀，下次我们在河边集合，去滑冰！","status":"matched","hash_xxh64":"0x582F36B25E1FFAC4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1322041006:1":{"text":"Yes, I'll come find you tomorrow.","source_cn":"嗯！那我明天再偷偷来找你们！","status":"matched","hash_xxh64":"0x0EE31601CDA9EAE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1322041007:1":{"text":"That's a promise. Let's meet again tomorrow, Daimon!","source_cn":"戴蒙——明天一定要再来呀！","status":"matched","hash_xxh64":"0x90DC512F7969B0BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:戴蒙":{"text":"Daimon","source":"戴蒙","status":"matched_dialogue_flow"},"speaker:亚历克斯":{"text":"Alex","source":"亚历克斯","status":"matched_dialogue_flow"},"speaker:伊戈尔":{"text":"Igor","source":"伊戈尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":3}}