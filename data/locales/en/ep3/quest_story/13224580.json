{"asset_key":"ep3/quest_story_13224580","episode":"ep3","category":"quest_story","story_id":"13224580","schema_version":1,"lang":"en","texts":{"say:1:1322458001:1":{"text":"We salute your bravery, Magister.","source_cn":"向你的英勇致敬，魔法师大人。","status":"matched_runtime_gender","hash_xxh64":"0x340DCE2C89A20B9D","variant_status":"runtime_gender_keys_target_same","male":"We salute your bravery, Magister.","female":"We salute your bravery, Magister.","variant_male_record_index":"150099","variant_female_record_index":"150100","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1322458001":{"text":"We salute your bravery, Magister.","source_cn":"向你的英勇致敬，魔法师大人。","status":"matched_runtime_gender","hash_xxh64":"0x340DCE2C89A20B9D","variant_status":"runtime_gender_keys_target_same","male":"We salute your bravery, Magister.","female":"We salute your bravery, Magister.","variant_male_record_index":"150099","variant_female_record_index":"150100","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322458002:1":{"text":"Captain, we've got all the cultists under control.","source_cn":"罗德里戈大人，所有邪教徒都被我们控制住了。","status":"matched","hash_xxh64":"0x6267CA81E73F5FF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322458003:1":{"text":"Lock them up. Keep a close watch on them until their trial.","source_cn":"将他们全数关入监牢，等待审判。看好他们。","status":"matched","hash_xxh64":"0x32C009DC83FB0EA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322458004:1":{"text":"Yes, sir!","source_cn":"是！","status":"matched","hash_xxh64":"0x7EF92FBF2D174F34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1322458005:1":{"text":"*Sobbing* What's happening...?","source_cn":"呜呜呜……发生了什么……？","status":"matched","hash_xxh64":"0x2BA46010965A06CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1322458006:1":{"text":"I... I don't want to go to the ritual... I'm scared...","source_cn":"我……害怕，不想去祭祀……","status":"matched","hash_xxh64":"0xD10AEB51766BDB12","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1322458007:1":{"text":"I couldn't stop myself... I was terrified... but I still ended up here...","source_cn":"但我控制不了……自己，好害怕……但还是，走到这里了……","status":"matched","hash_xxh64":"0xBB2EAED151BC580A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1322458008:1":{"text":"Sounds like she's under some kind of spell...","source_cn":"听起来像是被魔法控制了……","status":"matched","hash_xxh64":"0x5515E30C69146509","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1322458008":{"text":"Sounds like she's under some kind of spell...","source_cn":"听起来像是被魔法控制了……","status":"matched","hash_xxh64":"0x5515E30C69146509","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1322458009:1":{"text":"Are you saying these villagers were all controlled by dark magic?! Outrageous!","source_cn":"难道这些镇民都被黑魔控制了行动？太可恶了！","status":"matched","hash_xxh64":"0x2162074288B4EC8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1322458011:1":{"text":"Look, Irina's eyes! They're clear again!","source_cn":"看，伊琳娜的眼神变清澈了！","status":"matched","hash_xxh64":"0x71695D1403504386","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:15:1322458011":{"text":"Look, Irina's eyes! They're clear again!","source_cn":"看，伊琳娜的眼神变清澈了！","status":"matched","hash_xxh64":"0x71695D1403504386","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1322458012:1":{"text":"It's you... I've seen you before... Thank you...","source_cn":"是你……我见过你……谢谢……","status":"matched_runtime_gender","hash_xxh64":"0x39BE85854F2AE0BE","variant_status":"runtime_gender_keys_target_same","male":"It's you... I've seen you before... Thank you...","female":"It's you... I've seen you before... Thank you...","variant_male_record_index":"150112","variant_female_record_index":"150113","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1322458015:1":{"text":"Zaneus has been arrested. We'll escort the villagers back to Cedartown.","source_cn":"兹比格涅夫已经被逮捕，我们会护送这些镇民回雪松镇。","status":"matched_runtime_gender","hash_xxh64":"0x602736C22F6713EF","variant_status":"runtime_gender_keys_target_same","male":"Zaneus has been arrested. We'll escort the villagers back to Cedartown.","female":"Zaneus has been arrested. We'll escort the villagers back to Cedartown.","variant_male_record_index":"150116","variant_female_record_index":"150117","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1322458016:1":{"text":"Magister, some of the villagers still haven't shaken off the effects of the dark magic. Perhaps you could help?","source_cn":"魔法师大人，还有一些镇民的黑魔法症状没有消失，或许你可...","status":"matched_runtime_gender","hash_xxh64":"0x5DF7B2F3D8AA954A","variant_status":"runtime_gender_keys_target_same","male":"Magister, some of the villagers still haven't shaken off the effects of the dark magic. Perhaps you could help?","female":"Magister, some of the villagers still haven't shaken off the effects of the dark magic. Perhaps you could help?","variant_male_record_index":"150118","variant_female_record_index":"150119","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:21:1322458016":{"text":"Magister, some of the villagers still haven't shaken off the effects of the dark magic. Perhaps you could help?","source_cn":"魔法师大人，还有一些镇民的黑魔法症状没有消失，或许你可以帮帮他们。","status":"matched_runtime_gender","hash_xxh64":"0x5DF7B2F3D8AA954A","variant_status":"runtime_gender_keys_target_same","male":"Magister, some of the villagers still haven't shaken off the effects of the dark magic. Perhaps you could help?","female":"Magister, some of the villagers still haven't shaken off the effects of the dark magic. Perhaps you could help?","variant_male_record_index":"1