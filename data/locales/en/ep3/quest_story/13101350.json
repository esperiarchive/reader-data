{"asset_key":"ep3/quest_story_13101350","episode":"ep3","category":"quest_story","story_id":"13101350","schema_version":1,"lang":"en","texts":{"say:1:1310135001:0":{"text":"I must offer my sincerest apologies for the fright you've endured. Rest assured, the undead have been dealt with. Is everyone unharmed?","source_cn":"诸位，抱歉，让你们受惊吓了。那些活死人已经被我们制服了...","status":"matched","hash_xxh64":"0x14943CAF70186612","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1310135002:0":{"text":"We're fine, but that kid...","source_cn":"我们倒是没什么，但这个小朋友……","status":"matched","hash_xxh64":"0xEAFE57359D4E4093","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1310135003:1":{"text":"Romain is really shaken up, and now he's running a fever!","source_cn":"我的小罗曼，他吓坏了……现在似乎有些发烧！","status":"matched","hash_xxh64":"0x694D07A48EA9A7DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1310135004:0":{"text":"Let me have a look... Hmm, there's no need for alarm. I shall prepare a remedy at once. With a bit of rest, he will recover.","source_cn":"让我看看……嗯，别担心，我为他熬煮一剂药，喝下之后好好...","status":"matched","hash_xxh64":"0x5C5E8A14C5203724","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1310135005:0":{"text":"Dura above, thank you all!","source_cn":"艾雅在上，谢谢你们！","status":"matched","hash_xxh64":"0xFE1B1835EE8D1062","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1310135006:0":{"text":"It's late. Everyone, stay here for the night. At first light, we shall journey to Cedartown together. ","source_cn":"已经很晚了，大家就在这间屋子里挤挤吧。等天亮之后，我同...","status":"matched","hash_xxh64":"0x1160118CCB2EF2E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:9:1310135007:1":{"text":"The night passes slowly, and as the crows caw faintly, dawn begins to break.","source_cn":"","status":"matched","hash_xxh64":"0x6C0B0A40CCDCF3AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:法拉莫尔":{"text":"Faramor","source":"法拉莫尔","status":"matched_dialogue_flow"},"speaker:商人斯瓦夫":{"text":"Trader Swafford","source":"商人斯瓦夫","status":"matched_dialogue_flow"},"speaker:莎耶娃":{"text":"Saya","source":"莎耶娃","status":"matched_dialogue_flow"},"speaker:彼得洛夫":{"text":"Pascal","source":"彼得洛夫","status":"matched_dialogue_flow"},"speaker:黑幕":{"text":"Black Screen","source":"黑幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":5}}