{"asset_key":"ep3/quest_story_13221380","episode":"ep3","category":"quest_story","story_id":"13221380","schema_version":1,"lang":"en","texts":{"say:1:1322138001:1":{"text":"Praise the goddess, you're here! I hope Brother Maxim and I are fully prepared this time.","source_cn":"赞美女神，你们来了！希望这次我和马克西姆兄弟准备得足够充分。","status":"matched","hash_xxh64":"0x82384CD45EB463B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322138002:1":{"text":"To be honest, I'm a bit scared, and my heart's racing... but I had no reason to complain. This is my duty, and it was the right path guided by the goddess.","source_cn":"说实话，我有些害怕，心跳得很快……但我没什么可抱怨的，...","status":"matched","hash_xxh64":"0xED127AEBCB327BE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322138003:1":{"text":"Dura will bless us on this journey.","source_cn":"女神会保佑我们的。","status":"matched","hash_xxh64":"0x7EE38C391F6B2D00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322138004:1":{"text":"I have no doubt about this. Lady Carolina, please lead the way.","source_cn":"我对此坚信不疑。卡列琳娜女士，请您带路吧。","status":"matched","hash_xxh64":"0xC608EC6B6C8C8285","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修士奥格列":{"text":"Acolyte Ogden","source":"修士奥格列","status":"matched_dialogue_flow"},"speaker:修士马克西姆":{"text":"Acolyte Maxim","source":"修士马克西姆","status":"matched_dialogue_flow"},"speaker:卡列琳娜":{"text":"Carolina","source":"卡列琳娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":3}}