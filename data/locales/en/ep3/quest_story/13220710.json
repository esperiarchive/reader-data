{"asset_key":"ep3/quest_story_13220710","episode":"ep3","category":"quest_story","story_id":"13220710","schema_version":1,"lang":"en","texts":{"say:1:1322071001:1":{"text":"Daimon, we found you some playmates. Time to come out and play.","source_cn":"戴蒙，我们给你找了几个玩伴，快出来玩吧，好不好？","status":"matched","hash_xxh64":"0x2517B1F26CA23B57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322071002:1":{"text":"These snowmen are quite charming. It's so fun outside right now.","source_cn":"这些小雪人很可爱，外面很热闹……你听到它们的笑声了吧？","status":"matched","hash_xxh64":"0x12891CF1116F1442","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322071003:1":{"text":"Are you still angry, Daimon?","source_cn":"戴蒙……还在生气吗？","status":"matched","hash_xxh64":"0x94E90121EAADF503","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322071004:1":{"text":"Despite Shemira and Niru's efforts, Daimon won't come out or speak a word. His silence is heavy with meaning.","source_cn":"无论雪米拉和尼汝说什么，戴蒙都不肯出来，也不愿说一句话。","status":"matched","hash_xxh64":"0xFF1BB213199E3342","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322071005:1":{"text":"*Sigh*... Please don't be angry at Mother and Father, Daimon.","source_cn":"戴蒙……唉……别生爸爸妈妈的气了，好不好？","status":"matched","hash_xxh64":"0x993B797034ED1F07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1322071006:1":{"text":"Come on, Daimon. Can you please come out? Chippy wants to have a snowball fight with you.","source_cn":"对呀，戴蒙，你快出来吧？满满陪你打雪仗！","status":"matched","hash_xxh64":"0x3BCC0F22AEF405B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1322071007:0":{"text":"I'm about to use my fireworks magic! Come check it out!","source_cn":"我可以给你看烟花魔法！","status":"matched","hash_xxh64":"0x66B064DF7E430ED4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:11:1322071008:0":{"text":"Despite everyone's words, Daimon remained silent. His silence is unsettling.","source_cn":"不管大家说了什么，戴蒙依旧一声不吭","status":"matched","hash_xxh64":"0x74681BC4252B200D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1322071009:0":{"text":"He's not usually this quiet...","source_cn":"他平时没这么安静……","status":"matched","hash_xxh64":"0x9E2C4B630DCAF133","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1322071010:0":{"text":"Daimon has been silent too long. Could he not be feeling well...?","source_cn":"……戴蒙他一直不说话，会不会是生病了不舒服……？","status":"matched","hash_xxh64":"0xCBC2D2B9109A9B88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1322071011:0":{"text":"I have to go see him.","source_cn":"不行，我得去看看他……","status":"matched","hash_xxh64":"0xFD8D612574E5B211","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:雪米拉":{"text":"Shemira","source":"雪米拉","status":"matched_dialogue_flow"},"speaker:尼汝":{"text":"Niru","source":"尼汝","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":12,"localized_text_count":11,"speaker_count":6}}