{"asset_key":"ep3/quest_story_13104030","episode":"ep3","category":"quest_story","story_id":"13104030","schema_version":1,"lang":"en","texts":{"say:1:1310403001:0":{"text":"A person with two hamsters, one in a metal helmet and the other in a pointy hat... It's you!","source_cn":"一个人和两只大仓鼠，一只戴着金属头盔，一只戴着大尖帽子...","status":"matched","hash_xxh64":"0x75449B88B9CE40B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1310403002:0":{"text":"Huh? Do you know us?","source_cn":"啊？我们？","status":"matched","hash_xxh64":"0x51075D4089E9A1A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1310403003:0":{"text":"You must be Her Highness' esteemed guests! She personally entrusted me with preparing your outfits.","source_cn":"哎呀，你们肯定是公主殿下的贵客！殿下亲自来吩咐过，要我...","status":"matched","hash_xxh64":"0xF384A2B00CDE2C62","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1310403004:0":{"text":"Don't worry, everything's already paid for. Here you go.","source_cn":"放心，殿下已经付过钱了。来，请拿好您的物品。","status":"matched_runtime_gender","hash_xxh64":"0xA766C88EC4047C17","variant_status":"runtime_gender_keys_target_same","male":"Don't worry, everything's already paid for. Here you go.","female":"Don't worry, everything's already paid for. Here you go.","variant_male_record_index":"141818","variant_female_record_index":"141819","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1310403005