{"asset_key":"ep3/quest_story_13212260","episode":"ep3","category":"quest_story","story_id":"13212260","schema_version":1,"lang":"en","texts":{"say:1:1321226001:1":{"text":"Heavens! I'm so lucky to have met Master Arteka at the last moment.","source_cn":"天哪！幸好最后一刻见到了阿托卡大师。","status":"matched","hash_xxh64":"0x8CCA844E80C87D1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1321226002:1":{"text":"If I'd missed him... I'd have regretted it for a lifetime!","source_cn":"如果错过……我肯定追悔终身！","status":"matched","hash_xxh64":"0xD0468A61C91EF246","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1321226003:1":{"text":"You'd better thank our little snowman, then!","source_cn":"你要感谢小雪人哦！","status":"matched","hash_xxh64":"0x4BC98B96BA83E0B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321226004:1":{"text":"I'm lucky the snowman pushed me, or I'd still be obsessing over the details.","source_cn":"还好小雪人推了我一把，不然我肯定还在纠结细节。","status":"matched","hash_xxh64":"0xFCFCE10451D6DF74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321226005:1":{"text":"I felt like it had to be perfect before I could make my move.","source_cn":"觉得一定要改到自己满意，才敢出手。","status":"matched","hash_xxh64":"0xF785E71D91B533A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321226006:1":{"text":"So I kept pushing it off...","source_cn":"结果一拖再拖……","status":"matched","hash_xxh64":"0xF1E21E008EC49269","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1321226007:1":{"text":"You've got me to thank! And you've gotta fix your... your little problem!","source_cn":"多亏了咱吧！你该治……治治这个毛病了！","status":"matched","hash_xxh64":"0x195FFF83FB219D6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1321226008:1":{"text":"The scientific name for that is \"procrastination\".","source_cn":"这有个学名，叫拖延症。","status":"matched","hash_xxh64":"0x8B4A5D328B909C3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1321226009:1":{"text":"And a man of action like our little snowman is the perfect cure for procrastination.","source_cn":"小雪人这种行动派呢，专治拖延症。","status":"matched","hash_xxh64":"0x0BF46F98463570DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1321226010:1":{"text":"You always seem to be in a hurry.","source_cn":"干啥都急吼吼的。","status":"matched","hash_xxh64":"0x187B69D56760B638","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1321226011:1":{"text":"It's because... life is... so short! I've got to fight... for every second!","source_cn":"因……为咱生命短……暂呀！要争分夺……秒！","status":"matched","hash_xxh64":"0x0BB97D311A44500D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1321226012:1":{"text":"Why are you talking like that?","source_cn":"你怎么说话断断续续的！","status":"matched","hash_xxh64":"0xF0B31BFB1AF667A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1321226013:1":{"text":"Didn't you want to see the wildflowers? The scenery is great here!","source_cn":"你不是念叨着想看花吗？这里景色不错吧！","status":"matched","hash_xxh64":"0x9301194793327B57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1321226014:1":{"text":"Wild... flowers! Beautiful!","source_cn":"野……花！好看！","status":"matched","hash_xxh64":"0xB15710700807FE46","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:画家派特":{"text":"Patric","source":"画家派特","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:雪人":{"text":"Snowman","source":"雪人","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":15,"localized_text_count":14,"speaker_count":4}}