{"asset_key":"ep3/quest_story_13204210","episode":"ep3","category":"quest_story","story_id":"13204210","schema_version":1,"lang":"en","texts":{"say:3:1320421001:0":{"text":"Whew... Seems like we got them all.","source_cn":"呼……应该，没有其他恶魔了吧……","status":"matched","hash_xxh64":"0x978285D71AA94558","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1320421002:0":{"text":"The detector isn't making any noise, so it seems we've cleared them out.","source_cn":"温差探测器没发出声音，应该全都解决了。","status":"matched","hash_xxh64":"0x7786802D5584FA9F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1320421003:0":{"text":"Yes, now all the monsters that escaped from the castle have been eliminated.","source_cn":"是的，我们清点过数量，从城堡中逃脱的恶魔眷属已经全部清除了。","status":"matched","hash_xxh64":"0x7493F372CF12F46D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1320421004:1":{"text":"Good! Now nothing can harm the guests of my inn!","source_cn":"那就好，只要白熊温泉旅店附近恢复了安全就行。","status":"matched","hash_xxh64":"0x37C25D292EEAEE61","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1320421005:0":{"text":"Thank you for all your help! We shall return and report to the higher ups.","source_cn":"多谢几位的帮助！我们这就回去将这个消息汇报给侍卫长。","status":"matched","hash_xxh64":"0x8F39B21B12D2B0C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1320421006:0":{"text":"Great, the monsters have been dealt with! Let's start searching for hot springs now.","source_cn":"太好了，恶魔眷属的事顺利解决！接下来我们是不是要继续寻...","status":"matched","hash_xxh64":"0x0D1636675F4A1BB6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1320421007:0":{"text":"Let's begin at the <style=\"highlight\">hills behind the inn</style>.","source_cn":"嗯，去<style=highlight>旅店的后山上<...","status":"matched","hash_xxh64":"0x79B01E46C3F92C34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:格尔达":{"text":"Gerda","source":"格尔达","status":"matched_dialogue_flow"},"speaker:领队的士兵":{"text":"Guard Leader","source":"领队的士兵","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":4}}