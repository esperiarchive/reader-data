{"asset_key":"ep3/quest_story_13111100","episode":"ep3","category":"quest_story","story_id":"13111100","schema_version":1,"lang":"en","texts":{"say:3:1311110001:1":{"text":"My friend Ludovic lives alone in this Duskmire Forest. He rarely sees anyone and isn't keen on engaging with the outside world.","source_cn":"柳博米尔——就是我那位朋友——他独自住在这片黑沼森林中...","status":"matched","hash_xxh64":"0xB1BD88EF22235120","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1311110002:1":{"text":"What if he doesn't want to see us?","source_cn":"那……我们能见到他吗？要是他不愿意见我们该怎么办？","status":"matched","hash_xxh64":"0xC6D7B42835D3626A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1311110003:1":{"text":"Please do not be concerned, I shall present him with a gift.","source_cn":"不必担心，我会给他带上一份礼物。","status":"matched","hash_xxh64":"0x609EA3420FC8BE53","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1311110003":{"text":"Please do not be concerned, I shall present him with a gift.","source_cn":"不必担心，我会给他带上一份礼物。","status":"matched","hash_xxh64":"0x609EA3420FC8BE53","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1311110004:1":{"text":"Trust me, I know something he cannot possibly decline.","source_cn":"相信我，我知道有一样东西，他是绝对无法拒绝的。","status":"matched","hash_xxh64":"0xBA74B28D24D35FA1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1311110005:1":{"text":"What is it?","source_cn":"是什么？","status":"matched","hash_xxh64":"0x1C91AA7E400E3FAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1311110006:1":{"text":"<style=\"highlight\">Blue spiritroot</style>. It's a rare plant that glimmers with a gentle silver light at night, perfect for making pigments.","source_cn":"<style=highlight>冰蓝灵曼根</sty...","status":"matched","hash_xxh64":"0x19C60EEB75E841DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1311110007:1":{"text":"Pigments? Does Ludovic like to paint?","source_cn":"颜料？柳博米尔很喜欢画画吗？","status":"matched","hash_xxh64":"0x350E4303FDFC1EC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1311110008:1":{"text":"He does. He was renowned throughout the duchy for his exceptional painting skills. He once mentioned that there's a blue spiritroot in this forest, but it would take some effort for him to obtain it alone.","source_cn":"嗯，他生前就以高超的画技闻名整个公国。他曾提到过这片森...","status":"matched","hash_xxh64":"0xDFB438AF695F1B60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1311110009:1":{"text":"We've got this! With the four of us, we can definitely <style=\"highlight\">get this blue spiritroot</style> to make him happy! Let's go!","source_cn":"我们可有四个人呢！嘿嘿，这个礼物一定能让他心满意足的。...","status":"matched","hash_xxh64":"0xE68AB7860F3371EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"Sounds like a plan.","source_cn":"听起来是个办法","status":"matched_runtime_gender","hash_xxh64":"0xD71BE4E742E98336","variant_status":"runtime_gender_keys_target_same","male":"Sounds like a plan.","female":"Sounds like a plan.","variant_male_record_index":"68136","variant_female_record_index":"68137","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"We might need a Plan B...","source_cn":"总觉得不太保险……","status":"matched_runtime_gender","hash_xxh64":"0x76EBF29F0BEB2DBB","variant_status":"runtime_gender_keys_target_same","male":"We might need a Plan B...","female":"We might need a Plan B...","variant_male_record_index":"68138","variant_female_record_index":"68139","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:瓦丽卡":{"text":"Valka","source":"瓦丽卡","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":3}}