{"asset_key":"ep3/quest_story_13212190","episode":"ep3","category":"quest_story","story_id":"13212190","schema_version":1,"lang":"en","texts":{"say:1:1321219001:1":{"text":"Not even a shadow here. It seems... We were too late...","source_cn":"完全没有看到人影……也许，还是晚了一步吧。","status":"matched","hash_xxh64":"0xB7C23B570357E6E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1321219002:1":{"text":"Stop with the negativity! We haven't even gone all the way yet!","source_cn":"不许说丧气话！还没走到头呢！","status":"matched","hash_xxh64":"0x2C012DCCC36C6749","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321219003:1":{"text":"Hmm, the footprints point that way.","source_cn":"唔，鞋印往那边去了。","status":"matched","hash_xxh64":"0x1F9AE6C53C15726E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321219004:1":{"text":"Let's go in that direction.","source_cn":"沿着这个方向再走走吧。","status":"matched","hash_xxh64":"0x01D58B7178FC0E4B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321219005:1":{"text":"You guys are so slow! Hurry the heck up!","source_cn":"你们慢吞吞地，怎么来得及！","status":"matched","hash_xxh64":"0xB5F35EF46E6EF20A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1321219006:1":{"text":"Hand me the painting and I'll go up ahead!","source_cn":"把画给我，我帮你们先去看看！","status":"matched","hash_xxh64":"0x797D82682F938091","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1321219007:1":{"text":"My painting... That little snowman is strong for his size!","source_cn":"我的画——这小雪人力气还真不小！","status":"matched","hash_xxh64":"0x8D09BC07FAADF9CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1321219008:1":{"text":"Hey! I take my eyes off him for a second and he's gone!","source_cn":"哎！一不留神就让它给跑了。","status":"matched","hash_xxh64":"0x5BA0CF1242684ADE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:画家派特":{"text":"Patric","source":"画家派特","status":"matched_dialogue_flow"},"speaker:雪人":{"text":"Snowman","source":"雪人","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":4}}