{"asset_key":"ep3/quest_story_13216080","episode":"ep3","category":"quest_story","story_id":"13216080","schema_version":1,"lang":"en","texts":{"say:1:1321608001:1":{"text":"These ruins... and... yellow fruits...","source_cn":"这片废墟……还有……黄色的野果……？！","status":"matched","hash_xxh64":"0x1D95ED0FCAE915FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1321608002:1":{"text":"Dominique, are you remembering something?","source_cn":"德米，你是想起点什么了吗？","status":"matched","hash_xxh64":"0x3987EA48E08D2FED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:4::0":{"text":"Nostalgic Amberfruit","source_cn":"回忆的雾澄果","status":"matched","hash_xxh64":"0xC51952853B38C947","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321608003:1":{"text":"These are <style=\"highlight\">amberfruits</style>... They're my mother's favorite.","source_cn":"黄色的果子……<style=highlight>雾澄果...","status":"matched","hash_xxh64":"0x55DD809BEE5B7783","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321608004:1":{"text":"My sister found them here... and we gave them to Mother.","source_cn":"我的妹妹，在这里……找到了它……送给母亲……","status":"matched","hash_xxh64":"0xDB855E1D9925C5DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321608005:1":{"text":"I knew she loved them, but she never admitted it because she was worried about the dangers of us coming here...","source_cn":"母亲喜欢……但是担心我们，这里很危险……所以，她一直说...","status":"matched","hash_xxh64":"0xA90CCBBEB2167C7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1321608006:1":{"text":"There are many undead here...","source_cn":"这里……有很多的，活死人……","status":"matched","hash_xxh64":"0x5A000E1E9B490F59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1321608007:1":{"text":"That's why this place was so special to you... You and your sister must have visited here often.","source_cn":"原来是这样啊。你和你妹妹以前应该经常过来，所以才会一直...","status":"matched","hash_xxh64":"0x1FEB896FD4699FAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1321608008:1":{"text":"Well if that's the case, your home likely isn't nearby.","source_cn":"不过这样说来，你家也不可能在这附近了。","status":"matched","hash_xxh64":"0xF06747CEB39604D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:幽灵德米":{"text":"Spirit Dominique","source":"幽灵德米","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"spea