{"asset_key":"ep3/quest_story_13212280","episode":"ep3","category":"quest_story","story_id":"13212280","schema_version":1,"lang":"en","texts":{"say:1:1321228001:1":{"text":"Snowman?","source_cn":"小雪人？","status":"matched","hash_xxh64":"0x100B00A4C74E7414","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1321228002:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1321228002":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321228003:1":{"text":"What do you mean?","source_cn":"什么？<key:dialog4>","status":"matched","hash_xxh64":"0x47B48577F27EA3C9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321228004:1":{"text":"He... He changed back into a normal snowman?","source_cn":"它……这是变回普通的雪人了？","status":"matched","hash_xxh64":"0x2989C74EB8D26C45","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321228005:1":{"text":"I'm afraid so.","source_cn":"恐怕是的。","status":"matched","hash_xxh64":"0xD37C3FD319F3822F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1321228009:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1321228010:1":{"text":"I... I'd like to do a quick sketch for him.","source_cn":"我……我想为它画张速写。","status":"matched","hash_xxh64":"0xD306471F5041AC1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1321228011:1":{"text":"Consider this... A farewell and a thank-you gift.","source_cn":"就当是……告别和谢礼吧。","status":"matched","hash_xxh64":"0xD5FC5E6C101E41CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1321228012:1":{"text":"He will stand forever in the sea of wildflowers, never melting.","source_cn":"它会一直在画里，在花海里……永远不化。","status":"matched","hash_xxh64":"0xDCDD3AE7A62728D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:1321228013:1":{"text":"The painter did two sketches of the snowman.","source_cn":"","status":"matched","hash_xxh64":"0x03220BB8A1265385","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1321228014:1":{"text":"This one... is for you guys.","source_cn":"这张……送给你们。","status":"matched","hash_xxh64":"0xBF7FDB535AEF280D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:16::0":{"text":"Snowman's Sketch","source_cn":"小雪人速写","status":"matched","hash_xxh64":"0xEFFB7A406423B18B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1321228015:1":{"text":"To remember him by.","source_cn":"权作纪念吧。","status":"matched","hash_xxh64":"0xED7C2381D5D461CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1321228016:1":{"text":"His encouragement meant the world to me... And I'll never forget his lesson.","source_cn":"它的鼓励对我很有意义……我会贯彻它的意志的。","status":"matched","hash_xxh64":"0x8E28BFB87998829B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"The magic has faded.","source_cn":"魔力消退了。","status":"matched_runtime_gender","hash_xxh64":"0x4E8D3D06BCCE8582","variant_status":"runtime_gender_keys_target_same","male":"The magic has faded.","female":"The magic has faded.","variant_male_record_index":"69084","variant_female_record_index":"69085","document_title":"","docu