{"asset_key":"ep3/quest_story_13110180","episode":"ep3","category":"quest_story","story_id":"13110180","schema_version":1,"lang":"en","texts":{"say:1:1311018001:1":{"text":"Go down from this tomb, follow the main passage, and you'll reach the interior of the temple.","source_cn":"从这座墓穴下去，沿着主墓道一直向前，就可以通往大教堂内部。","status":"matched","hash_xxh64":"0x1745FCC9ACFEB2CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1311018002:1":{"text":"The inscription here says, \"Here lies Carolina Radinov. A maiden with a soul as pure as snow. May she forever sleep in divine light.\"","source_cn":"这墓志铭，“卡列琳娜·拉季诺夫——她安眠于圣光之下，灵...","status":"matched","hash_xxh64":"0xAB3EE65893B74382","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1311018003:1":{"text":"Is this your grave?","source_cn":"咦，卡列琳娜，这、这是你的墓穴？","status":"matched","hash_xxh64":"0xC316EB6D2DD555B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1311018004:1":{"text":"It is, so you don't need to worry about disturbing the dead here. I'll allow it.","source_cn":"没错，所以你们毋需担心惊扰亡者的灵魂，我并不在意这些。","status":"matched","hash_xxh64":"0xD7F39EDFB3212DCC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1311018005:1":{"text":"Thank you, Carolina.","source_cn":"谢谢你，卡列琳娜。","status":"matched","hash_xxh64":"0xD8441BACE7DE4828","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1311018006:1":{"text":"The temple used to be my safe haven, my home. I don't want anything to happen to it...","source_cn":"修道院曾是我的避风港，我的心灵家园。我不希望这里出事……","status":"matched","hash_xxh64":"0x8A8C846599FC441F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1311018007:1":{"text":"Lady Valka, you are a hero who fought alongside my grandfather. I implore you to protect this temple and all those who need defending.","source_cn":"瓦丽卡姐姐，你是和我的祖父并肩作战的英雄。我请求你，保...","status":"matched","hash_xxh64":"0xE2DAE8BB7FE7F059","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1311018008:1":{"text":"I am no hero, but I vow to do all that I can.","source_cn":"卡列琳娜，我不是什么英雄……但我保证，我会尽全力去做。","status":"matched","hash_xxh64":"0xAE5761018CE7CD99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1311018009:1":{"text":"May Dura bless you all.","source_cn":"愿女神保佑你们。","status":"matched","hash_xxh64":"0x1581BC0906FB5DC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卡列琳娜":{"text":"Carolina","source":"卡列琳娜","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:瓦丽卡":{"text":"Valka","source":"瓦丽卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":3}}