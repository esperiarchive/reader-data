{"asset_key":"ep3/quest_story_13220800","episode":"ep3","category":"quest_story","story_id":"13220800","schema_version":1,"lang":"en","texts":{"say:1:1322080001:1":{"text":"Hello... where did you get this wreath from?","source_cn":"这花环……这花环是你们从哪里拿到的？","status":"matched","hash_xxh64":"0x5E4B8B6A7CADFB8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:1::2":{"text":"Flower Crown","source_cn":"花环","status":"matched","hash_xxh64":"0x4914AF0F181E0860","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322080002:0":{"text":"Y-you're Graveborn... Dura above, Elena, come here. Stay behind me.","source_cn":"你……你们是亡灵……？艾雅在上……艾琳娜，快过来站在我...","status":"matched","hash_xxh64":"0xAD710C0B6D3C3111","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1322080002":{"text":"Y-you're Graveborn... Dura above, Elena, come here. Stay behind me.","source_cn":"你……你们是亡灵……？艾雅在上……艾琳娜，快过来站在我身后……别离她太近。","status":"matched","hash_xxh64":"0xAD710C0B6D3C3111","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322080003:0":{"text":"That's what the acolytes said too. My husband agrees, but I've never dealt with any Graveborn in real life before... My Elena is still young. Please don't scare her.","source_cn":"修士宣传过这件事，我丈夫也这么说，可我还从没和亡灵打过...","status":"matched","hash_xxh64":"0xEBD2FF0FE8D9D728","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322080004:0":{"text":"No, I won't do anything. I understand... For a mother, her children are everything.","source_cn":"不，我不会做任何事，我明白……对母亲来说，孩子就是一切。","status":"matched","hash_xxh64":"0xC59B7351A9118BCD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1322080005:0":{"text":"My son Daimon... I don't know where he went. I just want to find him!","source_cn":"我的儿子戴蒙……他不知道跑哪儿去了……我只想找到他！","status":"matched","hash_xxh64":"0xA73879DE51384C61","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1322080006:1":{"text":"Your son is missing? No wonder you look so worried. You asked about this wreath, right? Here, you can have it...","source_cn":"哎呀，你儿子走丢了？怪不得看着脸色不好。你问这花环，是...","status":"matched","hash_xxh64":"0xBAF6E63D1AAC1BD4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:7::2":{"text":"Flower Crown","source_cn":"花环","status":"matched","hash_xxh64":"0x4914AF0F181E0860","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1322080007:0":{"text":"No, I just want to know who made the wreath.","source_cn":"我……我只想知道这花环是谁编织的？","status":"matched","hash_xxh64":"0xB665C112944367EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1322080008:1":{"text":"A boy made it for me. Even my mother can't make a pretty one like this. He was amazing. He finished it in one go!","source_cn":"——是一个小哥哥给我做的！妈妈都不会编这么漂亮的花环呢...","status":"matched","hash_xxh64":"0xA3EA65166F2948F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1322080009:0":{"text":"The child was thin with pale skin and wrapped in bandages...","source_cn":"那孩子瘦瘦的，肤色看着惨白，还裹着一身绷带……","status":"matched","hash_xxh64":"0xFC3B8B78E55B52B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1322080010:0":{"text":"I've never seen him before in town. Could that boy have been your son?","source_cn":"哎呀！莫非那男孩是你儿子？我就说怎么从没在镇子里见过他呢！","status":"matched","hash_xxh64":"0x7C114345DA95CBD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1322080011:1":{"text":"Yes, it has to be Daimon!","source_cn":"裹着绷带，瘦瘦的……没错，那是戴蒙，就是他！","status":"matched","hash_xxh64":"0x0D469B930F1398EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1322080011":{"text":"Yes, it has to be Daimon!","source_cn":"裹着绷带，瘦瘦的……没错，那是戴蒙，就是他！","status":"matched","hash_xxh64":"0x0D469B930F1398EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1322080012:1":{"text":"A long time ago, I relied on sewing and knitting to make ends meet. The lighting in our home was terrible, and my eyesight kept getting worse.","source_cn":"那是很久以前的事情了。那时候我靠着做编织补贴家用，家里...","status":"matched","hash_xxh64":"0x204FF13372F83047","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1322080013:1":{"text":"Daimon wanted to help out and learn sewing and knitting, even as he lay sick in bed...","source_cn":"戴蒙心疼我，自己躺在病床上也要跟我学这种编织手法，想多...","status":"matched","hash_xxh64":"0x8B305F5288FB2AE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1322080014:0":{"text":"What a loving child...","source_cn":"多体贴、多懂事的孩子呀！","status":"matched","hash_xxh64":"0x2D337C7D0B3D3651","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1322080015:0":{"text":"So Graveborn are much like humans—children worry for their parents, and parents fear for their children's safety. You're not as frightening as I thought.","source_cn":"原来你们亡灵和人一样，孩子会心疼母亲，母亲也会担心孩子...","status":"matched","hash_xxh64":"0x8BFBB15BC97EA3E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1322080016:1":{"text":"Did Daimon do anything or say anything besides making the wreath? Did he say where he was going?","source_cn":"戴蒙他除了编花环还做了什么、说了什么吗？他有没有说他要...","status":"matched","hash_xxh64":"0x1C24C944B7FB1E2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1322080017:0":{"text":"Let me think...","source_cn":"让我想想啊……","status":"matched","hash_xxh64":"0xA74190A9F469D6A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1322080018:0":{"text":"*Cry*... I want a flower wreath...","source_cn":"呜呜呜……我想要一个花环，能戴在头上的那种。","status":"matched","hash_xxh64":"0xF5BDC23A1834620B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1322080019:0":{"text":"Oh, honey, just you wait. When your father gets back, we'll have him make one for you, alright?","source_cn":"乖孩子，妈妈手笨，等你爸爸回来，让他给你编一个好不好？","status":"matched","hash_xxh64":"0xDD22E32D81CF1191","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1322080020:1":{"text":"I want one now... *Cry*...","source_cn":"我现在就想要嘛……呜呜……","status":"matched","hash_xxh64":"0x1450BE40A98BA1A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1322080021:0":{"text":"You only need to wait one more day. He'll be home tomorrow. Then, we can make one together. ","source_cn":"唉，这可难住我了。就再等一天，你爸爸明天就回来了，咱们...","status":"matched","hash_xxh64":"0x1C6E6EEC3E87B24B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1322080022:1":{"text":"Everyone else has one. I want one, too. *Cry*... Please make one for me.","source_cn":"别人都有，我也想要一个……呜呜……妈妈，就给我做一个嘛……","status":"matched","hash_xxh64":"0x3D94C7DF54465EBD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1322080023:1":{"text":"This is for you...","source_cn":"这个，给你……","status":"matched","hash_xxh64":"0x9BB0B66664925B4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:28::2":{"text":"Flower Crown","source_cn":"花环","status":"matched","hash_xxh64":"0x4914AF0F181E0860","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1322080024:1":{"text":"Really? Are you really giving this to me?","source_cn":"咦……真的、真的给我吗？","status":"matched","hash_xxh64":"0xAFD8AAB4EDD5C3DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1322080025:1":{"text":"Yes, this is for you. Don't cry, okay? My mother told me that crying makes children sick, and if they're sick, they can't play with their friends. Bye, I have to go find friends now.","source_cn":"嗯，我要去找朋友了。这个送给你，不要哭了。我妈妈说小孩...","status":"matched","hash_xxh64":"0xB834F742AA89DEEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1322080026:1":{"text":"I won't cry anymore. Thank you!","source_cn":"我、我不哭了，谢谢小哥哥！","status":"matched","hash_xxh64":"0x6A31FCBBD1EEFEC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1322080027:0":{"text":"He made us a wreath and left. He said he was going to find friends. He was heading toward Sorrowfall Lake. Maybe if you go in that direction, you'll find him.","source_cn":"他给我们做好花环就往那边路上去了。好像是要去找朋友呢。...","status":"matched","hash_xxh64":"0x4EE1E4740FFFA3D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1322080028:1":{"text":"Thank you so much. Daimon's not as healthy as most children, but he's always running around. I get so worried for him...","source_cn":"谢谢你。戴蒙他身体弱，可总是喜欢乱跑，我很担心他……","status":"matched","hash_xxh64":"0xBFB28D20F223C6BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1322080029:0":{"text":"Although he's young, your son is smart and capable. He's a very considerate child.","source_cn":"你的儿子虽然年纪不大，但又聪明又能干，还很体贴人，是个...","status":"matched","hash_xxh64":"0x5F0C9391C24C7A1A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1322080030:0":{"text":"Don't worry, he'll be fine. Dura will protect him.","source_cn":"别担心，他不会出事的，艾雅一定会保佑他。","status":"matched","hash_xxh64":"0x00E322DF21E4796C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1322080031:0":{"text":"Thank you...","source_cn":"谢谢……","status":"matched","hash_xxh64":"0xDB731659D9FF672C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1322080032:0":{"text":"Daimon must be exhausted from walking so much. Maybe he's not that far ahead...","source_cn":"戴蒙身体弱，走了这么远他一定累坏了，也许他就在前面不远...","status":"matched","hash_xxh64":"0xDA162EDF2A086445","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:0:1":{"text":"Is Daimon good at making things?","source_cn":"戴蒙很擅长编织？","status":"matched_runtime_gender","hash_xxh64":"0xFC411E4BE38CF069","variant_status":"runtime_gender_keys_target_same","male":"Is Daimon good at making things?","female":"Is Daimon good at making things?","variant_male_record_index":"70960","variant_female_record_index":"70961","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:1:2":{"text":"He sure has a lot of hobbies.","source_cn":"戴蒙的爱好还挺广泛","status":"matched_runtime_gender","hash_xxh64":"0xAA3B5598CBD0F312","variant_status":"runtime_gender_keys_target_same","male":"He sure has a lot of hobbies.","female":"He sure has a lot of hobbies.","variant_male_record_index":"70962","variant_female_record_index":"70963","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"They won't hurt you.","source_cn":"他们不会伤害人","status":"matched_runtime_gender","hash_xxh64":"0xF3317C32848C8BDD","variant_status":"runtime_gender_keys_target_same","male":"They won't hurt you.","female":"They won't hurt you.","variant_male_record_index":"70956","variant_female_record_index":"70957","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"She's trying to find her son.","source_cn":"她只是想找她的儿子","status":"matched_runtime_gender","hash_xxh64":"0xAF26D34BAE2D8981","variant_status":"runtime_gender_keys_target_same","male":"She's trying to find her son.","female":"She's trying to find her son.","variant_male_record_index":"70958","variant_female_record_index":"70959","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:雪米拉":{"text":"Shemira","source":"雪米拉","status":"matched_dialogue_flow"},"speaker:艾琳娜的母亲":{"text":"Elena's Mother","source":"艾琳娜的母亲","status":"matched_dialogue_flow"},"speaker:小艾琳娜":{"text":"Elena","source":"小艾琳娜","status":"matched_dialogue_flow"},"speaker:戴蒙":{"text":"Daimon","source":"戴蒙","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":42,"localized_text_count":41,"speaker_count":4}}