{"asset_key":"ep3/quest_story_13220400","episode":"ep3","category":"quest_story","story_id":"13220400","schema_version":1,"lang":"en","texts":{"say:2:1322040001:1":{"text":"D-Daimon?!","source_cn":"戴、戴蒙？！","status":"matched","hash_xxh64":"0x1C3A25AAC9F7E79C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322040002:1":{"text":"You're actually here in Cedartown. Did your mother let you come play?","source_cn":"你居然来雪松镇了！你妈妈让你出来玩了吗？","status":"matched","hash_xxh64":"0x2B632D97A72F5856","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322040003:1":{"text":"I-I'm here looking for a friend...","source_cn":"我……呃，我是来找朋友……","status":"matched","hash_xxh64":"0xE531824BAF2831E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1322040003":{"text":"I-I'm here looking for a friend...","source_cn":"我……呃，我是来找朋友……","status":"matched","hash_xxh64":"0xE531824BAF2831E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1322040005:1":{"text":"I-I didn't want to be alone...","source_cn":"我……我不想总是一个人……","status":"matched","hash_xxh64":"0x0D8C4971E0D12E1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1322040006:0":{"text":"And my mother said that I couldn't bring them outside of town again. She never said I couldn't go look for them.","source_cn":"而且……妈妈上次说不准我把他们带出来，咳，但没说不让我...","status":"matched","hash_xxh64":"0x4C91E1A3CFA74A0B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1322040006":{"text":"And my mother said that I couldn't bring them outside of town again. She never said I couldn't go look for them.","source_cn":"而且……妈妈上次说不准我把他们带出来，咳，但没说不让我来找他们……","status":"matched","hash_xxh64":"0x4C91E1A3CFA74A0B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1322040007:1":{"text":"*Cough*... At home, I only have Stitchy to play with me, but I want to play with more people.","source_cn":"总之，咳咳……家里只有奇奇当我的玩伴，我想和朋友们一起...","status":"matched","hash_xxh64":"0x57034B276173A5E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1322040008:1":{"text":"Hahaha! Yes, let's play together! The more, the merrier!","source_cn":"哈哈哈哈哈，对，来一起玩！人多才最有意思！","status":"matched","hash_xxh64":"0xC0084FC2DE666C5B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1322040009:1":{"text":"Playing alone is sad! Playing with others is fun!","source_cn":"一个人玩耍，不好。好多人玩耍，好！","status":"matched","hash_xxh64":"0xE20A040DE1FC3F8F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1322040010:1":{"text":"Yes! You see! Even Mr. Igor thinks the same way!","source_cn":"对吧对吧！你看，伊戈尔哥哥也这么觉得呢！","status":"matched","hash_xxh64":"0x4752152306254BB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1322040011:1":{"text":"Magister, do you want to have a snowball fight with us too? Mr. Igor is amazing. We can't beat him!","source_cn":"<male>大哥哥</male><female>大姐姐...","status":"matched_runtime_gender","hash_xxh64":"0xEFE09157E5E341A7","variant_status":"runtime_gender_keys_target_same","male":"Magister, do you want to have a snowball fight with us too? Mr. Igor is amazing. We can't beat him!","female":"Magister, do you want to have a snowball fight with us too? Mr. Igor is amazing. We can't beat him!","variant_male_record_index":"152957","variant_female_record_index":"152958","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1322040011":{"text":"Magister, do you want to have a snowball fight with us too? Mr. Igor is amazing. We can't beat him!","source_cn":"<male>大哥哥</male><female>大姐姐</female>，你要不要也和我们一起打雪仗？伊戈尔哥哥可厉害了，咳咳，我们都赢不了他！","status":"matched_runtime_gender","hash_xxh64":"0xEFE09157E5E341A7","variant_status":"runtime_gender_keys_target_same","male":"Magister, do you want to have a snowball fight with us too? Mr. Igor is amazing. We can't beat him!","female":"Magister, do you want to have a snowball fight with us too? Mr. Igor is amazing. We can't beat him!","variant_male_record_index":"152957","variant_female_record_index":"152958","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"Yes, let's do it!","source_cn":"毫不犹豫地答应！","status":"matched_runtime_gender","hash_xxh64":"0xA8245B0A95C5BA9F","variant_status":"runtime_gender_keys_target_same","male":"Yes, let's do it!","female":"Yes, let's do it!","variant_male_record_index":"70376","variant_female_record_index":"70377","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"I'll pass...","source_cn":"……还是算了吧！","status":"matched_runtime_gender","hash_xxh64":"0x17E49241C0C9A8F4","variant_status":"runtime_gender_keys_target_same","male":"I'll pass...","female":"I'll pass...","variant_male_record_index":"70378","variant_female_record_index":"70379","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"Ha! I'm sure your mother meant exactly that!","source_cn":"妙啊，灵活的规则解读！","status":"matched_runtime_gender","hash_xxh64":"0x7AAB27286544C977","variant_status":"runtime_gender_keys_target_same","male":"Ha! I'm sure your mother meant exactly that!","female":"Ha! I'm sure your mother meant exactly that!","variant_male_record_index":"70372","variant_female_record_index":"70373","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"Flawless reasoning...","source_cn":"逻辑出色，令人佩服……","status":"matched_runtime_gender","hash_xxh64":"0x2E7B271216269DC7","variant_status":"runtime_gender_keys_target_same","male":"Flawless reasoning...","female":"Flawless reasoning...","variant_male_record_index":"70374","variant_female_record_index":"70375","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"You snuck out,