{"asset_key":"ep3/quest_story_13217770","episode":"ep3","category":"quest_story","story_id":"13217770","schema_version":1,"lang":"en","texts":{"say:2:1321777001:0":{"text":"Miss Lydia, where is Her Highness?","source_cn":"莉娅女士，公主殿下在哪？","status":"matched","hash_xxh64":"0x6E68B8D24FE6B713","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1321777002:0":{"text":"You're delirious again, Captain Rodrigo.","source_cn":"你的神志又不清醒了，罗德里戈。","status":"matched","hash_xxh64":"0x9DFF542A0C59F40D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321777003:0":{"text":"Why are you not bowing to Her Highness? She's just offered up a sapphirine blossom to Dura.","source_cn":"为什么不向公主殿下行礼？她刚刚向艾雅献上了蓝绒花！","status":"matched","hash_xxh64":"0xF44BE9A3E6F126BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321777004:0":{"text":"Chippy doesn't get it... Is there supposed to be someone next to Miss Lydia?","source_cn":"是、是满满出现幻觉了吗……莉娅女士身边有人吗……？","status":"matched_runtime_gender","hash_xxh64":"0xFD8D855518290932","variant_status":"runtime_gender_keys_target_same","male":"Chippy doesn't get it... Is there supposed to be someone next to Miss Lydia?","female":"Chippy doesn't get it... Is there supposed to be someone next to Miss Lydia?","variant_male_record_index":"153905","variant_female_record_index":"153906","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1321777004":{"text":"Chippy doesn't get it... Is there supposed to be someone next to Miss Lydia?","source_cn":"是、是满满出现幻觉了吗……莉娅女士身边有人吗……？","status":"matched_runtime_gender","hash_xxh64":"0xFD8D855518290932","variant_status":"runtime_gender_keys_target_same","male":"Chippy doesn't get it... Is there supposed to be someone next to Miss Lydia?","female":"Chippy doesn't get it... Is there supposed to be someone next to Miss Lydia?","variant_male_record_index":"153905","variant_female_record_index":"153906","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1321777005:0":{"text":"Do you know what you're saying, Miss Lydia?","source_cn":"……莉娅女士，你知道自己在说什么吗？","status":"matched","hash_xxh64":"0x0421E4CDF03B57A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1321777006:0":{"text":"Dura is protecting Her Highness, is she not?","source_cn":"圣骑士大人……艾雅正在庇佑公主殿下，对吧？","status":"matched","hash_xxh64":"0x9C7E2922307EEAE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1321777007:0":{"text":"Look! Look closely! By Dura's grace, Her Highness' color has returned! Her cheeks—see how they bloom with life!","source_cn":"看，蒙艾雅垂怜，公主殿下的气色已经恢复了这么多！","status":"matched","hash_xxh64":"0xC6BD4605DF020AE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1321777008:0":{"text":"...That's enough.","source_cn":"……够了。","status":"matched","hash_xxh64":"0x14C3BD59D34666AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1321777009:1":{"text":"Wake up, Miss Lydia. Please.","source_cn":"快点清醒过来，莉娅女士。","status":"matched","hash_xxh64":"0x0A9D88D1B2A8423B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1321777010:0":{"text":"What are you talking about? Oh, Captain Rodrigo, are you still trapped in your nightmare?","source_cn":"你在说什么？我一直很清醒！","status":"matched","hash_xxh64":"0x04B2745BABC313A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1321777011:0":{"text":"Calm your heart, I beg you. Look around! I arranged all this for her. And see? The princess is so pleased, so full of life, happier than I've seen her in years!","source_cn":"之前公主殿下病得那么厉害，要是我再不清醒一点的话，殿下...","status":"matched","hash_xxh64":"0xF9DDF15C6107F6B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1321777012:1":{"text":"Her Highness is dead!","source_cn":"——公主殿下已经去世了！","status":"matched","hash_xxh64":"0x4B7F02D19427E581","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1321777013:1":{"text":"Open your eyes! Her Highness isn't standing next to you! There's nothing but cold air beside you!","source_cn":"睁开眼睛，看清楚！公主殿下根本不在你身边！你身边只有一...","status":"matched","hash_xxh64":"0xF79D28C7FF0B8E1F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1321777014:1":{"text":"The real princess… she's gone. She's been gone for so long, Lydia.","source_cn":"真正的公主殿下，早就已经去世了！","status":"matched","hash_xxh64":"0xC123FF3B23264A29","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1321777015:0":{"text":"Captain Rodrigo! H-how dare you speak such lies about Her Highness?!","source_cn":"罗德里戈……你……你竟敢诅咒公主殿下？！","status":"matched","hash_xxh64":"0x502A20F8F5C8771B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1321777016:0":{"text":"She isn't dead! She can't be dead! I've watched over her every moment! With my prayers, with the prayers of the entire duchy, she will never fall to death's embrace!","source_cn":"殿下没死……殿下怎么可能死？！在我和医生的悉心呵护下，...","status":"matched","hash_xxh64":"0xEDF214872547E05C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"There's no one there.","source_cn":"这里没有别人","status":"matched_runtime_gender","hash_xxh64":"0xCBF3499CE3613B37","variant_status":"runtime_gender_keys_target_same","male":"There's no one there.","female":"There's no one there.","variant_male_record_index":"274135","variant_female_record_index":"274137","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"It's not just you.","source_cn":"出现幻觉的不是你","status":"matched_runtime_gender","hash_xxh64":"0xF0353251698A3210","variant_status":"runtime_gender_keys_target_same","male":"It's not just you.","female":"It's not just you.","variant_male_record_index":"70636","variant_female_record_index":"70637","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:2:3":{"text":"The issue is with Lydia.","source_cn":"有问题的是莉娅女士","status":"matched_runtime_gender","hash_xxh64":"0x06C898E9FEDEA7CC","variant_status":"runtime_gender_keys_target_same","male":"The issue is with Lydia.","female":"The issue is with Lydia.","variant_male_record_index":"70638","variant_female_record_index":"70639","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:侍卫长罗德里戈":{"text":"Captain Rodrigo","source":"侍卫长罗德里戈","status":"matched_dialogue_flow"},"speaker:莉娅女士":{"text":"Lydia","source":"莉娅女士","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:特弥希娅":{"text":"Temesia","source":"特弥希娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":21,"localized_text_count":20,"speaker_count":4}}