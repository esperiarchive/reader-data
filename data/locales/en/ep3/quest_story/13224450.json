{"asset_key":"ep3/quest_story_13224450","episode":"ep3","category":"quest_story","story_id":"13224450","schema_version":1,"lang":"en","texts":{"say:1:1322445001:1":{"text":"Who the hell... are you? G-Get lost!","source_cn":"你们……是谁？走、走开！","status":"matched","hash_xxh64":"0x034F5190D0E13A46","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322445002:1":{"text":"We need to talk to Irina. It's important!","source_cn":"我们找伊琳娜，有重要的事要和她说！","status":"matched","hash_xxh64":"0x004E0330BB32EC6E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322445003:1":{"text":"O-Outta my way. I'm heading o-out for a drink.","source_cn":"别……挡路，我正要出门、出门喝一杯。","status":"matched","hash_xxh64":"0x6D37E0C86E0F3746","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322445004:1":{"text":"This is really important!","source_cn":"我们有非常重要的事！","status":"matched","hash_xxh64":"0x40CBAAD188187D2B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322445005:1":{"text":"Tch. Who the hell are you...? Why do you... keep swaying around?","source_cn":"啧，你们是谁啊……怎么……一个劲在、在晃？","status":"matched","hash_xxh64":"0x251F877C04C35CCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"",