{"asset_key":"ep3/quest_story_13220870","episode":"ep3","category":"quest_story","story_id":"13220870","schema_version":1,"lang":"en","texts":{"say:1:1322087001:0":{"text":"Look! This is a mark of his power.","source_cn":"你们看，就是这里。","status":"matched","hash_xxh64":"0x8261B54759A45FB1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1322087002:0":{"text":"Daimon did this? That's impossible...","source_cn":"这不可能……","status":"matched","hash_xxh64":"0x6279ABF976ABA841","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1322087003:0":{"text":"This was indeed caused by gravecalling magic... Did my son develop a talent for it after his death?","source_cn":"这的确是亡灵法术所造成的……我的儿子竟然在死后才涌现了...","status":"matched","hash_xxh64":"0xDCBDE3DAC73A588B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322087004:0":{"text":"I don't believe it... He's been coughing so much lately. How could he have such strength?","source_cn":"我不相信……他一直在虚弱地咳嗽，怎么会有这种力量？","status":"matched","hash_xxh64":"0xC877DA6CDB4A9E4F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322087005:0":{"text":"Niru... We must find him quickly!","source_cn":"尼汝……快，我们得赶紧找到他！","status":"matched","hash_xxh64":"0xBA67CE4838F43855","variant_status":"","male":"","female":"","variant_male_record_i