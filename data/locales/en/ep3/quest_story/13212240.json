{"asset_key":"ep3/quest_story_13212240","episode":"ep3","category":"quest_story","story_id":"13212240","schema_version":1,"lang":"en","texts":{"say:1:1321224001:1":{"text":"Master Arteka...","source_cn":"阿托卡大师……","status":"matched","hash_xxh64":"0xF55D04E58FEAA5F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1321224002:1":{"text":"Oh, did you paint this?","source_cn":"呀！这是你画的吗？","status":"matched","hash_xxh64":"0x14B18C038EBE5B37","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1321224003:1":{"text":"Ah, you'd better not pollute your eyes with such a stain...","source_cn":"啊，这种粗制滥造的东西，还是不要污染了您的眼睛……","status":"matched","hash_xxh64":"0x983450D70A273A72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321224004:1":{"text":"It was him! He's been painting this a whole month for you!","source_cn":"就是他！他为了见您画了一个月！","status":"matched","hash_xxh64":"0xD244E5087245C445","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321224005:1":{"text":"Hey! You weren't supposed to tell him!","source_cn":"啊啊啊——不要说出来啊！","status":"matched","hash_xxh64":"0x50F8E9502BD5AADB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321224006:1":{"text":"Ah, well the composition and framing are quite good.","source_cn":"唔，构思和取景挺不错的。","status":"matched","hash_xxh64":"0x374BAA79BAC0BFCB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321224007:1":{"text":"Uh... Oh? Real— Really?!","source_cn":"啊……啊？真、真的吗！","status":"matched","hash_xxh64":"0x55E80E1B10F71DAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1321224008:1":{"text":"Although... The colors could use some tweaking.","source_cn":"不过……色彩还可以再调整一下。","status":"matched","hash_xxh64":"0xD80F68BE8A9A7A5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1321224009:1":{"text":"Right, there, I...","source_cn":"这里我实在是……","status":"matched","hash_xxh64":"0x535D5D054959BD30","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1321224010:1":{"text":"You couldn't find the right colors?","source_cn":"觉得找不准颜色？","status":"matched","hash_xxh64":"0x4EF55B0E3AC4B8DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1321224011:1":{"text":"You— How'd you know?!","source_cn":"您、您怎么知道！","status":"matched","hash_xxh64":"0x778B65D36E283036","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1321224012:1":{"text":"Ah, it's only natural! Just look how these two colors blend.","source_cn":"正常！你看把这俩颜色混一下。","status":"matched","hash_xxh64":"0x1E6E188088DC9FD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1321224013:1":{"text":"And the handling of these ambient colorations...","source_cn":"这里的环境色这样处理……","status":"matched","hash_xxh64":"0xDA147B66AC1D20EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1321224014:1":{"text":"I see... That problem had been bothering me for a long time!","source_cn":"原来如此……这个问题困扰我好久了！","status":"matched","hash_xxh64":"0xD5D21442013A103E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1321224015:1":{"text":"See? It's a good thing we showed up in time. Otherwise, we would have missed it!","source_cn":"嘿！幸好咱出现得及时，这要再晚点就真错过了！","status":"matched","hash_xxh64":"0x0C180DB29A42D3FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1321224016:1":{"text":"This little snowman is so... spirited! And you've painted him in very well!","source_cn":"这小雪人好精神！唔……把它画进去就不错！","status":"matched","hash_xxh64":"0xDF53FCB30056A2F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1321224017:1":{"text":"A brighter color was needed right there and he fit the bill just right.","source_cn":"刚好，这里需要亮一点的颜色，它就很合适。","status":"matched","hash_xxh64":"0x80A7E32E808E6B53","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:画家派特":{"text":"Patric","source":"画家派特","status":"matched_dialogue_flow"},"speaker:大师阿托卡":{"text":"Arteka","source":"大师阿托卡","status":"matched_dialogue_flow"},"speaker:雪人":{"text":"Snowman","source":"雪人","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":18,"localized_text_count":17,"speaker_count":3}}