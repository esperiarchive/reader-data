{"asset_key":"ep3/quest_story_13111350","episode":"ep3","category":"quest_story","story_id":"13111350","schema_version":1,"lang":"en","texts":{"say:3:1311135001:1":{"text":"Thank you, Your Lordship. Now that we know the truth, it's time for us to get going.","source_cn":"谢谢你，柳博米尔先生。既然已经知道了亚莲娜公主的情况，...","status":"matched","hash_xxh64":"0x5FE1902A3B7E6E1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1311135002:1":{"text":"The time loop hasn't ended and the \"princess\" may cause serious trouble... We must head back and put an end to everything!","source_cn":"时间循环没有结束，公主可能有大问题……情况越来越严重了...","status":"matched","hash_xxh64":"0xABEF486FDC32EDD6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1311135003:1":{"text":"Valka, are you going with them too?","source_cn":"瓦丽卡，你也要和他们一起去吗？","status":"matched","hash_xxh64":"0xAE8A076D7754C39F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1311135004:1":{"text":"Yes...","source_cn":"……是的。","status":"matched","hash_xxh64":"0xFC54966B7C3DA2BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1311135005:1":{"text":"You haven't changed... always trapped in self-doubt and torment, yet unable to let go of your responsibilities...","source_cn":"你还是那样，始终在自我怀疑和折磨，却放不下责任……","status":"matched","hash_xxh64":"0xD1A47FD4432DB7C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1311135006:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1311135007:1":{"text":"The one who resembles Yolena has tainted our family's name.","source_cn":"那个顶着亚莲娜面容的人，玷污了我们家族的荣誉。","status":"matched","hash_xxh64":"0xF893D6AE13B4C695","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1311135008:1":{"text":"Whatever the truth may be, I genuinely hope for your success.","source_cn":"无论真相如何，我衷心希望你们一切顺利。","status":"matched","hash_xxh64":"0xF7AC083D1D687E59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1311135009:1":{"text":"Let me walk you to the entrance.","source_cn":"走吧，我送你们出去。","status":"matched","hash_xxh64":"0x9C07596B150E0B63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:柳博米尔":{"text":"Ludovic","source":"柳博米尔","status":"matched_dialogue_flow"},"speaker:瓦丽卡":{"text":"Valka","source":"瓦丽卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":4}}