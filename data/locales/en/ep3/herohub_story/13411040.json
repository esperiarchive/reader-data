{"asset_key":"ep3/herohub_story_13411040","episode":"ep3","category":"herohub_story","story_id":"13411040","schema_version":1,"lang":"en","texts":{"say:2:1341104001:1":{"text":"This book of ancient spells is written in the language of the old gods' era. There are some characters I can't recognize.","source_cn":"这本书里记录了一些古老的咒语，使用了诸神时代的圣书文字...","status":"matched","hash_xxh64":"0xEE174077FBB399AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1341104002:1":{"text":"Can you read them?","source_cn":"不知道你们是否认识这些圣书文字呢？","status":"matched","hash_xxh64":"0xCCE135293C85475C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1341104003:1":{"text":"Let me take a look... This eye-shaped symbol means \"looking down.\" The scepter, crown, and this twisted symbol together mean \"the king's warrior\"...","source_cn":"我看看……这个像眼睛一样的文字意思是“俯视”；权杖、头...","status":"matched","hash_xxh64":"0x8A843A4F4705B56F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1341104004:1":{"text":"What about this symbol that combines a diamond shape with a line?","source_cn":"那这个菱形和线条组合起来的符号呢？","status":"matched","hash_xxh64":"0xB47BE59EA39BD2C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1341104005:1":{"text":"...It's a page break!","source_cn":"……这是分页符！","status":"matched","hash_xxh64":"0xA422742F5F37DC01","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:法拉莫尔":{"text":"Faramor","source":"法拉莫尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}}