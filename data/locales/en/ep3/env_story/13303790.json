{"asset_key":"ep3/env_story_13303790","episode":"ep3","category":"env_story","story_id":"13303790","schema_version":1,"lang":"en","texts":{"say:2:1330379001:1":{"text":"But every time you say something with such certainty, it ends up being hogwash!","source_cn":"你每次都这么肯定，每次说的都不是真的，就是危言耸听！","status":"matched","hash_xxh64":"0x2D3BF3E29A388FF9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1330379002:1":{"text":"You had me terrified of snowmen last time! I'm not buying your story again!","source_cn":"上次害我一见到雪人就害怕，这次我绝对绝对不会再相信你了！","status":"matched","hash_xxh64":"0xE8797905C726C4DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1330379003:1":{"text":"This time it's real, I swear! Everyone says so, even the grownups!","source_cn":"求你相信我！这次是真的！大家都这么说，不信你回家问爸爸妈妈！","status":"matched","hash_xxh64":"0xDCAF4E7531C7DCB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:小孩拉里莎":{"text":"Larisa","source":"小孩拉里莎","status":"matched_dialogue_flow"},"speaker:小孩尤金":{"text":"Eugene","source":"小孩尤金","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}