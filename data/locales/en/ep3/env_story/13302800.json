{"asset_key":"ep3/env_story_13302800","episode":"ep3","category":"env_story","story_id":"13302800","schema_version":1,"lang":"en","texts":{"say:1:1330280001:1":{"text":"Let's begin...","source_cn":"好，那我们开始吧……","status":"matched_runtime_gender","hash_xxh64":"0x74000CDCC3A0F105","variant_status":"runtime_gender_keys_target_same","male":"Let's begin...","female":"Let's begin...","variant_male_record_index":"156684","variant_female_record_index":"156685","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1330280002:1":{"text":"Princess Yolena, your presence warmed us like the winter sun.","source_cn":"亚莲娜公主，对于镇民们来说，你的存在就像是冬日里的太阳。","status":"matched","hash_xxh64":"0x994F7D8F79DCE930","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1330280003:1":{"text":"You brought us immense joy and happiness.","source_cn":"你曾带给我们很多温馨和欢乐。","status":"matched","hash_xxh64":"0x47B2BA13BD60A477","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1330280004:1":{"text":"We're grateful for everything you've done for Cedartown. May the warmth you gave us never fade.","source_cn":"感恩你为雪松镇所带来的一切，愿你为我们带来的暖光，永不消逝。","status":"matched","hash_xxh64":"0xECDA8AB2C802C33A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:镇民阿尔比娜":{"text":"Villager Albina","source":"镇民阿尔比娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"spe