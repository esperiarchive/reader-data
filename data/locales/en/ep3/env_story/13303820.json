{"asset_key":"ep3/env_story_13303820","episode":"ep3","category":"env_story","story_id":"13303820","schema_version":1,"lang":"en","texts":{"say:2:1330382001:1":{"text":"Now that a new group of acolytes has arrived, maybe the new Archduke isn't far behind.","source_cn":"既然新派的修士来了，新的大公应该也快了吧。","status":"matched","hash_xxh64":"0x0B46C0A360CC17E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1330382002:1":{"text":"I'm not sure about politics, but trust me, if you're faithful to the Divine Light, Dura's blessings will come.","source_cn":"政治上的事我不清楚，但请放心，只要向圣光祈祷，女神一定...","status":"matched","hash_xxh64":"0x9422385ADF29C404","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1330382003:1":{"text":"You acolytes all sound the same to me.","source_cn":"……你们修士都一个样。","status":"matched","hash_xxh64":"0x4478DF32DE41A40E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:矮人拜格":{"text":"Worker Borin","source":"矮人拜格","status":"matched_dialogue_flow"},"speaker:修女斯涅日娜":{"text":"Acolyte Sienna","source":"修女斯涅日娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}