{"asset_key":"ep5/quest_story_15212110","episode":"ep5","category":"quest_story","story_id":"15212110","schema_version":1,"lang":"en","texts":{"say:2:1521211001:0":{"text":"Quick...","source_cn":"快……","status":"matched","hash_xxh64":"0x3E311C43B9BCC294","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521211002:0":{"text":"Are you... alright? Was that you scratching at the door?","source_cn":"你……你还好吗？刚才是你在挠门吗？","status":"matched","hash_xxh64":"0x41A0189F91F70F39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521211003:0":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xBB59AB6D9B6EDB32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521211004:0":{"text":"No... it wasn't me...","source_cn":"不……不是我……","status":"matched","hash_xxh64":"0xB766EB256A70813E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521211005:0":{"text":"Did you find the key? Please, get me out...","source_cn":"你们，你们有没有找到钥匙？快救我出去吧……","status":"matched","hash_xxh64":"0x05833B7D56667478","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521211006:0":{"text":"There's no key. Just a note. It says \"Run.\"","source_cn":"周围没有钥匙。只有一张纸条，上面写着“快逃”。","status":"matched","hash_xxh64":"0x3BF2728E1C0B4DEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521211007:0":{"text":"Do you know who wrote it?","source_cn":"你知道这张纸条是谁写的吗？","status":"matched","hash_xxh64":"0x88E7B9596EB49BEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521211008:0":{"text":"Run...","source_cn":"快逃……","status":"matched","hash_xxh64":"0x1202CDF2367C7769","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521211009:0":{"text":"I... I'm not sure. Maybe the captain... or someone else.","source_cn":"我，我不知道。是队长写的……还是谁？","status":"matched","hash_xxh64":"0x20177E2177F3A63B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1521211009":{"text":"I... I'm not sure. Maybe the captain... or someone else.","source_cn":"我，我不知道。是队长写的……还是谁？","status":"matched","hash_xxh64":"0x20177E2177F3A63B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1521211010:0":{"text":"No. He didn't...","source_cn":"不，不。他身上没有……","status":"matched","hash_xxh64":"0x6BE4BA7AD038BED6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1521211011:0":{"text":"He doesn't even... have a body anymore...","source_cn":"队长……已经没有身体了……","status":"matched","hash_xxh64":"0xDA4BFDF0039F4F3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:15:1521211011":{"text":"He doesn't even... have a body anymore...","source_cn":"队长……已经没有身体了……","status":"matched","hash_xxh64":"0xDA4BFDF0039F4F3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1521211012:0":{"text":"It was the captain... he brought the key with him.","source_cn":"是队长……队长带来的钥匙。","status":"matched","hash_xxh64":"0xC528D0C1B658391A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1521211013:0":{"text":"He carried spares—<style=\"highlight\">the guards always keeps extras</style>, just in case. He never let them out of his sight...","source_cn":"为了保护大家……<style=highlight>护卫...","status":"matched","hash_xxh64":"0x5AD0880866D7AA74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:18:1521211013":{"text":"He carried spares—<style=\"highlight\">the guards always keeps extras</style>, just in case. He never let them out of his sight...","source_cn":"为了保护大家……<style=highlight>护卫队有很多备用钥匙</style>。一直是队长拿着……","status":"matched","hash_xxh64":"0x5AD0880866D7AA74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1521211014:0":{"text":"In the... <style=\"highlight\">guards' break room</style>.","source_cn":"在……在<style=highlight>护卫队休息室...","status":"matched","hash_xxh64":"0x7C5B25C58A30E265","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1521211015:0":{"text":"That's just <style=\"highlight\">east of the outpost's wooden lift</style>. There's a <style=\"highlight\">crate</style> outside...","source_cn":"休息室就在<style=highlight>哨站木巨梯...","status":"matched","hash_xxh64":"0xA46DAF31EEDD2104","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1521211016:0":{"text":"<style=\"highlight\">The spare key's hidden deep inside that crate</style>. Hard to spot, but... you'll find it.","source_cn":"<style=highlight>备用钥匙就藏在木箱里...","status":"matched","hash_xxh64":"0xABC566988F257007","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:22:1521211016":{"text":"<style=\"highlight\">The spare key's hidden deep inside that crate</style>. Hard to spot, but... you'll find it.","source_cn":"<style=highlight>备用钥匙就藏在木箱里</style>，藏得很深……但是，但是你们可以找到。","status":"matched","hash_xxh64":"0xABC566988F257007","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1521211017:0":{"text":"Thank you... thank you so much.","source_cn":"谢谢……谢谢你们。","status":"matched","hash_xxh64":"0xAA278F1AC7810685","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1521211018:0":{"text":"I'll be waiting... please get me out.","source_cn":"我等你们……救我出来。","status":"matched","hash_xxh64":"0x5257C935CC95C529","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:0:1":{"text":"Understood.","source_cn":"知道了","status":"matched_runtime_gender","hash_xxh64":"0x4D8FBC499E5B0D2E","variant_status":"runtime_gender_keys_target_same","male":"Understood.","female":"Understood.","variant_male_record_index":"78263","variant_female_record_index":"78264","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:1:2":{"text":"We'll give it a try.","source_cn":"我们尽力吧","status":"matched_runtime_gender","hash_xxh64":"0x8907D1713B3743DE","variant_status":"runtime_gender_keys_target_same","male":"We'll give it a try.","female":"We'll give it a try.","variant_male_record_index":"78265","variant_female_record_index":"78266","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:0:1":{"text":"So the guards have spares?","source_cn":"这么说，护卫队还有钥匙？",