{"asset_key":"ep5/quest_story_15212190","episode":"ep5","category":"quest_story","story_id":"15212190","schema_version":1,"lang":"en","texts":{"say:1:1521219001:0":{"text":"Master <style=\"stress\"><player_name></style>, is he dead?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x8B3BB7939ABCCD45","variant_status":"runtime_gender_keys_target_same","male":"Master <style=\"stress\"><player_name></style>, is he dead?","female":"Master <style=\"stress\"><player_name></style>, is he dead?","variant_male_record_index":"184189","variant_female_record_index":"184190","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1521219001":{"text":"Master <style=\"stress\"><player_name></style>, is he dead?","source_cn":"<style=stress><player_name></style>大人，他死了吗？","status":"matched_runtime_gender","hash_xxh64":"0x8B3BB7939ABCCD45","variant_status":"runtime_gender_keys_target_same","male":"Master <style=\"stress\"><player_name></style>, is he dead?","female":"Master <style=\"stress\"><player_name></style>, is he dead?","variant_male_record_index":"184189","variant_female_record_index":"184190","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521219002:0":{"text":"... Thank you...","source_cn":"……谢谢……你们……","status":"matched","hash_xxh64":"0xCCC7E78A06337AA0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521219003:0":{"text":"He's thanking us? Why?","source_cn":"他在向我们道谢……？为什么？","status":"matched_runtime_gender","hash_xxh64":"0x21C63EE189438EAB","variant_status":"runtime_gender_keys_target_same","male":"He's thanking us? Why?","female":"He's thanking us? Why?","variant_male_record_inde