{"asset_key":"ep5/quest_story_15205100","episode":"ep5","category":"quest_story","story_id":"15205100","schema_version":1,"lang":"en","texts":{"say:2:1520510001:0":{"text":"Abundius.","source_cn":"阿邦德。","status":"matched","hash_xxh64":"0x67621C205D197B64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1520510002:1":{"text":"... Oh, didn't see you there!","source_cn":"……是你们啊！吓我一跳。","status":"matched","hash_xxh64":"0x3B4D7716EC618440","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1520510002":{"text":"... Oh, didn't see you there!","source_cn":"……是你们啊！吓我一跳。","status":"matched","hash_xxh64":"0x3B4D7716EC618440","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1520510003:0":{"text":"I'm putting the guards to work on rebuilding the city, which is our top priority right now.","source_cn":"我在指挥卫队重建城邦，这是现在最要紧的事。","status":"matched_runtime_gender","hash_xxh64":"0x38BE785C610855B7","variant_status":"runtime_gender_keys_target_same","male":"I'm putting the guards to work on rebuilding the city, which is our top priority right now.","female":"I'm putting the guards to work on rebuilding the city, which is our top priority right now.","variant_male_record_index":"184931","variant_female_record_index":"184932","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1520510004:1":{"text":"What brings you here?","source_cn":"你们为什么来呼临城？","status":"matched","hash_xxh64":"0xAE366BE719BA4051","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:7:1520510005:0":{"text":"You inform Abundius of the Halian casualties and Morgan's proposed solution to deal with the bodies...","source_cn":"将安葬呼临死者的事宜，以及摩根的解决方案告诉了阿邦德……","status":"matched","hash_xxh64":"0x6130897486C55F50","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1520510006:0":{"text":"C-Cremation? No way!","source_cn":"火、火葬……？不行！","status":"matched","hash_xxh64":"0x84E597A03DEB1807","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1520510007:1":{"text":"I have to stand my ground on this... All Halians must be laid to rest according to our burial customs!","source_cn":"别的都可以，但这件事绝对不行……死去的呼临人，需要按照...","status":"matched","hash_xxh64":"0x831AB4110DFD2065","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1520510008:1":{"text":"Even though we lost the war, our soldiers must receive a proper burial!","source_cn":"即使我们是战败的一方……呼临城的子民也不能在死后连安身...","status":"matched","hash_xxh64":"0xE8B87AAEDE48B1B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1520510009:1":{"text":"My people would never agree to that!","source_cn":"不止是我，民众也不会同意的！","status":"matched","hash_xxh64":"0x1E27F6C35C93191C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1520510010:1":{"text":"I hate to burst your bubble, but how are you supposed to prepare the coffins and the graveyard?","source_cn":"现实一点，棺材和墓地从哪来？","status":"matched","hash_xxh64":"0x79C206B44CA13B03","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1520510011:1":{"text":"Well...","source_cn":"这，这个……","status":"matched","hash_xxh64":"0x8095D28BEBA93A51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1520510011":{"text":"Well...","source_cn":"这，这个……","status":"matched","hash_xxh64":"0x8095D28BEBA93A51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1520510012:0":{"text":"Actually... our craftsmen are all busy repairing the waterworks and rebuilding the city...","source_cn":"这个……工匠现在都在忙着修建水道、重建城邦……","status":"matched","hash_xxh64":"0x25851497A924C883","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1520510014:0":{"text":"In other words, you can't spare anyone to handle the burials.","source_cn":"也就是说，抽不出人手来帮忙下葬？","status":"matched","hash_xxh64":"0xC38123558DC1B50E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1520510015:0":{"text":"Why not just set everything on fire...","source_cn":"那么，不如一把火——","status":"matched","hash_xxh64":"0x0BAED88C401EDBA0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1520510016:0":{"text":"N-No! Surely there are other options! We can talk... discuss... um, work something out!","source_cn":"不、不行！一定有别的办法！我们可以聊聊……讨论……呃，...","status":"matched","hash_xxh64":"0x99F08E94C226F351","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1520510017:1":{"text":"Do you realize how devastating a plague can be? It can reduce a prosperous city to near emptiness, stinking of rot, with the dying lying everywhere.","source_cn":"你知不知道，一场瘟疫会让昔日繁华的城市变得十室九空，街...","status":"matched","hash_xxh64":"0xD29BB39E256986DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1520510018:0":{"text":"Have you ever seen healers trying to cure a plague? Their hope gradually turns into despair, and in the end, they take their own lives.","source_cn":"你是否见过尝试治愈瘟疫的医生，从一开始满腔热血，到发现...","status":"matched","hash_xxh64":"0x5E1645BF46C5AE64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1520510019:0":{"text":"If you'd experienced this, you'd see why we need to take swift action instead of getting bogged down by the details.","source_cn":"如果你也经历过这些，就会同意速战速决，而不是在这里坚持...","status":"matched","hash_xxh64":"0x7C6C90470A0A2CCC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1520510020:0":{"text":"I-I have to ruminate on this... It's a serious matter, and I have to convince the council members.","source_cn":"我、我得再想想……事关重大，还得争取议事官同意……","status":"matched","hash_xxh64":"0xE15060BCE749E39A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1520510021:1":{"text":"... Good grief, all this time wasted on a clueless boy. It's all Merlin's fault.","source_cn":"……天，我竟然在一个什么都不懂的小孩身上浪费这么多时间...","status":"matched_runtime_gender","hash_xxh64":"0x0B6ABDB9717EF40D","variant_status":"runtime_gender_keys_target_same","male":"... Good grief, all this time wasted on a clueless boy. It's all Merlin's fault.","female":"... Good grief, all this time wasted on a clueless boy. It's all Merlin's fault.","variant_male_record_index":"184950","variant_female_record_index":"184951","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"Can the craftsmen make coffins?","source_cn":"让工匠去制作棺材？","status":"matched_runtime_gender","hash_xxh64":"0x383EC93139641FDB","variant_status":"runtime_gender_keys_target_same","male":"Can the craftsmen make coffins?","female":"Can the craftsmen make coffins?","variant_male_record_index":"78509","variant_female_record_index":"78510","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1520510013:0":{"text":"We're short on guards, with most of them injured...","source_cn":"卫队人手紧缺，而且大多数人都受了伤，现在……","status":"matched","hash_xxh64":"0x056B8B1CDB9F1D98","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"Can the guards dig the graves?","source_cn":"让卫队去挖掘墓地？","status":"matched_runtime_gender","hash_xxh64":"0x1A2A8DCB61C467E9","variant_status":"runtime_gender_keys_target_same","male":"Can the guards dig the graves?","female":"Can the guards dig the graves?","variant_male_record_index":"78511","variant_female_record_index":"78512","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"What are you doing?","source_cn":"你在做什么？","status":"matched_runtime_gender","hash_xxh64":"0x42D13A2E06413432","variant_status":"runtime_gender_keys_target_same","male":"What are you doing?","female":"What are you doing?","variant_male_record_index":"272880","variant_female_record_index":"272881","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"},"speaker:领主阿邦德":{"text":"Abundius","source":"领主阿邦德","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":27,"localized_text_count":26,"speaker_count":4}}