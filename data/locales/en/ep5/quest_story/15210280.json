{"asset_key":"ep5/quest_story_15210280","episode":"ep5","category":"quest_story","story_id":"15210280","schema_version":1,"lang":"en","texts":{"say:1:1521028001:0":{"text":"Don't... Don't hurt my father! *Sobbing*","source_cn":"不要，不要……你们不要伤害我爸爸！呜呜……","status":"matched","hash_xxh64":"0x85516FF6DD7A826E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521028002:0":{"text":"Cato! How did you get out? I told you to stay with your aunt!","source_cn":"卡托！你怎么跑出来了？爸爸明明让你和姑姑待在一起！","status":"matched","hash_xxh64":"0x0BFE80B6D56CB14B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521028003:0":{"text":"*Sobbing* Father, please stop this... I'm not hungry anymore. Just... don't do this...","source_cn":"呜呜呜……爸爸，你不要抢别人的东西……卡托不饿，一点都...","status":"matched","hash_xxh64":"0x3061DED8CE474581","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521028004:1":{"text":"So you were doing this for your child.","source_cn":"原来你是为了孩子。","status":"matched","hash_xxh64":"0x62953F18A334234B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1521028005:0":{"text":"A father... and his son...","source_cn":"一个父亲，还有一个儿子……","status":"matched","hash_xxh64":"0x90355A8A21E9B551","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521028006:0":{"text":"Alright... I forgive you.\nGuard, give them some food.","source_cn":"好吧……我原谅你了。\\n护卫长官，把包里的食物分给他们一些。","status":"matched_runtime_gender","hash_xxh64":"0xA6ADDDDEE113DAD6","variant_status":"runtime_gender_keys_target_same","male":"Alright... I forgive you.\nGuard, give them some food.","female":"Alright... I forgive you.\nGuard, give them some food.","variant_male_record_index":"181761","variant_female_record_index":"181762","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1521028006":{"text":"Alright... I forgive you.\nGuard, give them some food.","source_cn":"好吧……我原谅你了。\\n护卫长官，把包里的食物分给他们一些。","status":"matched_runtime_gender","hash_xxh64":"0xA6ADDDDEE113DAD6","variant_status":"runtime_gender_keys_target_same","male":"Alright... I forgive you.\nGuard, give them some food.","female":"Alright... I forgive you.\nGuard, give them some food.","variant_male_record_index":"181761","variant_female_record_index":"181762","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1521028007:0":{"text":"Whoa, bread! I haven't had bread in forever!","source_cn":"哇——是面包！我好久都没吃到面包了！","status":"matched","hash_xxh64":"0x57DEF1F23B24E19F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1521028008:1":{"text":"Father, you can have mine!","source_cn":"爸爸，你也一起吃——！","status":"matched","hash_xxh64":"0x594D893708163A9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1521028009:1":{"text":"That's alright... I'll just take a small bite.","source_cn":"好孩子……爸爸只吃一口就够了。","status":"matched","hash_xxh64":"0x5CF8ABB5A5024B3E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1521028010:0":{"text":"No need to split it. Take more. Eat until you are full.","source_cn":"这怎么行？你们多拿几个面包，把肚子填饱吧。","status":"matched","hash_xxh64":"0x6693CD76B62D2F68","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1521028011:0":{"text":"Can we really?","source_cn":"哇——真的可以吗？！","status":"matched","hash_xxh64":"0x70C48EA1EF63CAC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1521028012:0":{"text":"Cato, quick, say thank you to this kind young master!","source_cn":"卡托，快说谢谢！谢谢这位好心的小公子！","status":"matched","hash_xxh64":"0x23859A9444872C07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1521028013:0":{"text":"Wait... Do you know who I am?","source_cn":"等、等一下！你认识我？！","status":"matched","hash_xxh64":"0x66FD878E36368154","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1521028014:0":{"text":"No, never seen you before.","source_cn":"不，我从未见过您。","status":"matched","hash_xxh64":"0xE623CD53A47B7C4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1521028015:0":{"text":"Then why call me Young Master?","source_cn":"那你为什么叫我“小公子”？","status":"matched","hash_xxh64":"0x5E32E4666BA59212","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1521028016:1":{"text":"Anyone who can spare food these days must be well-off. And with two servants at your side, it just felt right to call you that way.","source_cn":"现在这种时候，能从家里拿出余粮分给我们的人肯定非富即贵...","status":"matched","hash_xxh64":"0xF4EFB551BC9D7380","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:24:1521028016":{"text":"Anyone who can spare food these days must be well-off. And with two servants at your side, it just felt right to call you that way.","source_cn":"现在这种时候，能从家里拿出余粮分给我们的人肯定非富即贵，更何况您身边还跟着两位仆人。只有这样称呼您才不会失礼。","status":"matched","hash_xxh64":"0xF4EFB551BC9D7380","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1521028017:0":{"text":"We're not his servants...","source_cn":"……我们不是他的仆人。","status":"matched","hash_xxh64":"0x4F39AEA12B38CA99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1521028019:0":{"text":"Umm...","source_cn":"这……<key:dialog52>","status":"matched","hash_xxh64":"0xA71C5CD171988A5B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1521028020:0":{"text":"They... are my guards, not my servants.","source_cn":"他们是我的护卫，不是仆人。","status":"matched","hash_xxh64":"0x2CC1C7D6FE4618D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1521028021:0":{"text":"Oh, I see... You really are a kind young master.","source_cn":"哦哦，我果然没看错……您果然是位好心的公子。","status":"matched","hash_xxh64":"0x75D59D8654E40A1F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1521028022:0":{"text":"Um... Master? Can I ask you something?","source_cn":"小公子……我可以问你一个问题吗？","status":"matched","hash_xxh64":"0x7922886FF44AD2AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1521028023:0":{"text":"Sure, what is it?","source_cn":"可以啊，你问吧。","status":"matched","hash_xxh64":"0x39B317B0A8EA3738","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1521028024:0":{"text":"Have you ever seen the Regulus?","source_cn":"那个……你有没有见过领主殿下？","status":"matched","hash_xxh64":"0x299BCF841CDEB298","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1521028025:0":{"text":"—Cato!\nWhat did I say about talking to strangers about that?","source_cn":"——卡托！\\n爸爸和你说过，不许在外面议论领主的事……！","status":"matched","hash_xxh64":"0x21D564BCFAAA947F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1521028026:1":{"text":"Sorry, young master. Don't mind him. He's just curious.","source_cn":"抱歉……小公子，您别在意卡托说的话，他只是好奇而已。","status":"matched","hash_xxh64":"0x6BB45984EF9E07F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1521028027:1":{"text":"We know nothing about those rumors... My son was just too hungry and talking nonsense.","source_cn":"城里那些关于领主殿下的流言我们也没听说过……我会好好教...","status":"matched","hash_xxh64":"0x6C3F8E4D4A838950","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1521028028:0":{"text":"Regas quickly pulled Cato away, scolding him under his breath as they left.","source_cn":"雷古斯说完后，就匆匆拉着卡托走远，看起来像是在教训他。","status":"matched","hash_xxh64":"0x867C5D35771E138C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1521028029:0":{"text":"Did they recognize me...","source_cn":"他们是不是认出我了……？","status":"matched","hash_xxh64":"0x2BCC9BD60EA43AF2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:41:1521028029":{"text":"Did they recognize me...","source_cn":"他们是不是认出我了……？","status":"matched","hash_xxh64":"0x2BCC9BD60EA43AF2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1521028030:0":{"text":"Then why did they leave?","source_cn":"不是的话，他们为什么要避开？","status":"matched","hash_xxh64":"0x329B6D8ECC8B6121","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1521028031:0":{"text":"Might be because of the rumors he mentioned.","source_cn":"可能和他说的流言有关。","status":"matched","hash_xxh64":"0x96DD6BFD37B75B25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1521028032:1":{"text":"He's probably scared you will tell the Regulus, and they will get punished.","source_cn":"他害怕你会把这些事告诉领主，让他们受到惩罚。","status":"matched","hash_xxh64":"0x467D4516E2D7510B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1521028033:1":{"text":"But I've never punished anyone over rumors...","source_cn":"可是我不会因为流言就惩罚别人。","status":"matched","hash_xxh64":"0xE59703C36780C9F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:48:1521028033":{"text":"But I've never punished anyone over rumors...","source_cn":"可是我不会因为流言就惩罚别人。","status":"matched","hash_xxh64":"0xE59703C36780C9F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:49:1521028035:0":{"text":"Good idea...","source_cn":"……要。","status":"matched","hash_xxh64":"0xFDC81B117E31F479","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1521028036:0":{"text":"I want to know how Halians see me. Good or bad, I need to hear it.","source_cn":"我想知道呼临人都是怎么看我的……就算是不好的看法也没关系。","status":"matched","hash_xxh64":"0x701238834D22B6BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:48:0:1":{"text":"Maybe we should go ask him?","source_cn":"你要去问问看吗？","status":"matched_runtime_gender","hash_xxh64":"0x92425BB0FE6BF94E","variant_status":"runtime_gender_keys_target_same","male":"Maybe we should go ask him?","female":"Maybe we should go ask him?","variant_male_record_index":"77472","variant_female_record_index":"77473","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:41:0:1":{"text":"I don't think so.","source_cn":"应该不是","status":"matched_runtime_gender","hash_xxh64":"0x61F9AB419DA698A2","variant_status":"runtime_gender_keys_target_same","male":"I don't think so.","female":"I don't think so.","variant_male_record_index":"77468","variant_female_record_index":"77469","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:52:1521028034:0":{"text":"Yes... I'm curious too.","source_cn":"我也有点在意……","status":"matched","hash_xxh64":"0xA3B91C5543F98600","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:41:1:2":{"text":"I'm more interested in those rumors.","source_cn":"我比较想知道他说的流言是什么","status":"matched_runtime_gender","hash_xxh64":"0x169EC22B6E32BB60","variant_status":"runtime_gender_keys_target_same","male":"I'm more interested in those rumors.","female":"I'm more interested in those rumors.","variant_male_record_index":"77470","variant_female_record_index":"77471","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:0:1":{"text":"I'm a what now?","source_cn":"仆人？我？","status":"matched_runtime_gender","hash_xxh64":"0x799B9986443C22E1","variant_status":"runtime_gender_keys_target_same","male":"I'm a what now?","female":"I'm a what now?","variant_male_record_index":"77464","variant_female_record_index":"77465","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:54:1521028018:0":{"text":"And neither am I.","source_cn":"我也不是他的仆人。","status":"matched","hash_xxh64":"0x00405224327C34C9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:1:2":{"text":"I am not his servant!","source_cn":"我可不是他的仆人！","status":"matched_runtime_gender","hash_xxh64":"0xC393ED6960F15F9F","variant_status":"runtime_gender_keys_target_same","male":"I am not his servant!","female":"I am not his servant!","variant_male_record_index":"77466","variant_female_record_index":"77467","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:0:1":{"text":"As you wish...","source_cn":"是是是<key:dialog2>","status":"matched_runtime_gender","hash_xxh64":"0xAF24CB70F6173FFF","variant_status":"runtime_gender_keys_target_same","male":"As you wish...","female":"As you wish...","variant_male_record_index":"77460","variant_female_record_index":"77461","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:1:2":{"text":"Don't get used to me as your guard...","source_cn":"你还真把我当护卫了……","status":"matched_runtime_gender","hash_xxh64":"0xB53BBBFC330ACF3A","variant_status":"runtime_gender_keys_target_same","male":"Don't get used to me as your guard...","female":"Don't get used to me as your guard...","variant_male_record_index":"77462","variant_female_record_index":"77463","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卡托":{"text":"Cato","source":"卡托","status":"matched_dialogue_flow"},"speaker:雷古斯":{"text":"Regas","source":"雷古斯","status":"matched_dialogue_flow"},"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"},"speaker:领主阿邦德":{"text":"Abundius","source":"领主阿邦德","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":48,"localized_text_count":47,"speaker_count":5}}