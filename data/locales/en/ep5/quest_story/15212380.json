{"asset_key":"ep5/quest_story_15212380","episode":"ep5","category":"quest_story","story_id":"15212380","schema_version":1,"lang":"en","texts":{"say:3:1521238001:0":{"text":"Yeah, that's bad. Can you stand at all?","source_cn":"伤得不轻。还能站起来吗？","status":"matched","hash_xxh64":"0xA9ACFCEA3BF5F16F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521238002:0":{"text":"If... if we stop the bleeding and wrap it tight... I think I can manage!","source_cn":"只……只要止住血，包扎好伤口……应该就没问题！","status":"matched","hash_xxh64":"0x94C4CCEFDE645A0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521238003:0":{"text":"Let's be honest. That gash isn't something you can power through.","source_cn":"你这伤口的大小，恐怕不能这么乐观。","status":"matched","hash_xxh64":"0xEC753B655345E3EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521238004:0":{"text":"I agree. You should drop out for now. There will be more tryouts. No need to cripple yourself over this one.","source_cn":"没错，我建议你先退出选拔养伤吧。狩猎队的选拔不止一次，...","status":"matched","hash_xxh64":"0x90B0AEEE49A9E162","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521238005:0":{"text":"Yeah, someone as weak as you—","source_cn":"是啊，像你这样的弱者……","status":"matched","hash_xxh64":"0x10AB24077F69367D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1521238006:0":{"text":"—I'm not weak!","source_cn":"——我才不是弱者！","status":"matched","hash_xxh64":"0x6128672826AD08FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521238007:0":{"text":"Tuft, Solt, I can keep going... I'm not quitting. Not like this!","source_cn":"森绒，索斯，我没事，我还能坚持……我不要退出！","status":"matched","hash_xxh64":"0xCFE43600CD5EB615","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1521238008:0":{"text":"It's my first time joining the tryout... No matter what, I want to see it through!","source_cn":"而且这是我第一次参加选拔……无论如何我都要坚持到最后！","status":"matched","hash_xxh64":"0x1A53D014F6057E15","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1521238009:1":{"text":"... That kind of stubbornness can be dangerous.","source_cn":"……太固执也不是什么好事。","status":"matched","hash_xxh64":"0xDFEA7AA4BDDE17ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1521238010:1":{"text":"It's not stubbornness. It's discipline. My old man always said, \"Finish what you started.\"","source_cn":"不是固执……这是坚持！我老爹一直教训我要有坚持的毅力。","status":"matched","hash_xxh64":"0x9D30115C3FCCF474","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1521238010":{"text":"It's not stubbornness. It's discipline. My old man always said, \"Finish what you started.\"","source_cn":"不是固执……这是坚持！我老爹一直教训我要有坚持的毅力。","status":"matched","hash_xxh64":"0x9D30115C3FCCF474","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1521238012:1":{"text":"Really?! I... I'm honored! Thank you!","source_cn":"真的吗？！我……我实在太荣幸了！","status":"matched_runtime_gender","hash_xxh64":"0xBE7790B9C5E45D97","variant_status":"runtime_gender_keys_target_same","male":"Really?! I... I'm honored! Thank you!","female":"Really?! I... I'm honored! Thank you!","variant_male_record_index":"184362","variant_female_record_index":"184363","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"I can heal you.","source_cn":"我可以帮你治好你的伤","status":"matched_runtime_gender","hash_xxh64":"0x944CAA70E52CD457","variant_status":"runtime_gender_keys_target_same","male":"I can heal you.","female":"I can heal you.","variant_male_record_index":"78329","variant_female_record_index":"78330","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1521238011:1":{"text":"Master <style=\"stress\"><player_name></style>, are you sure about that?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x759A01C5A2DDA816","variant_status":"runtime_gender_keys_target_same","male":"Master <style=\"stress\"><player_name></style>, are you sure about that?","female":"Master <style=\"stress\"><player_name></style>, are you sure about that?","variant_male_record_index":"184360","variant_female_record_index":"184361","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"More contestants, more fun.","source_cn":"多一个人也多点意思","status":"matched_runtime_gender","hash_xxh64":"0xEE34D00E85C6C0F7","variant_status":"runtime_gender_keys_target_same","male":"More contestants, more fun.","female":"More contestants, more fun.","variant_male_record_index":"78331","variant_female_record_index":"78332","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:狩猎队长森绒":{"text":"Captain Tuft","source":"狩猎队长森绒","status":"matched_dialogue_flow"},"speaker:鲁":{"text":"Ruu","source":"鲁","status":"matched_dialogue_flow"},"speaker:索斯":{"text":"Solt","source":"索斯","status":"matched_dialogue_flow"},"speaker:巴":{"text":"Bel","source":"巴","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":16,"localized_text_count":15,"speaker_count":4}}