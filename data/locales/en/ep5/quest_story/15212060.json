{"asset_key":"ep5/quest_story_15212060","episode":"ep5","category":"quest_story","story_id":"15212060","schema_version":1,"lang":"en","texts":{"say:1:1521206001:0":{"text":"It's locked. I can't open it.","source_cn":"这扇门锁住了，加拉打不开。","status":"matched_runtime_gender","hash_xxh64":"0xFC72776BD32AEF4C","variant_status":"runtime_gender_keys_target_same","male":"It's locked. I can't open it.","female":"It's locked. I can't open it.","variant_male_record_index":"182534","variant_female_record_index":"182535","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1521206001":{"text":"It's locked. I can't open it.","source_cn":"这扇门锁住了，加拉打不开。","status":"matched_runtime_gender","hash_xxh64":"0xFC72776BD32AEF4C","variant_status":"runtime_gender_keys_target_same","male":"It's locked. I can't open it.","female":"It's locked. I can't open it.","variant_male_record_index":"182534","variant_female_record_index":"182535","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521206002:1":{"text":"Run! It's the locusts again!","source_cn":"快——快跑！是针蝗——！","status":"matched","hash_xxh64":"0xD194F0A3A9FA14AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521206003:0":{"text":"It's alright now. The locusts are gone. Master <style=\"stress\"><player_name></style> handled them.","source_cn":"针蝗已经被<style=stress><player_...","status":"matched_runtime_gender","hash_xxh64":"0xE407466189AD2592","variant_status":"runtime_gender_keys_target_same","male":"It's alright now. The locusts are gone. Master <style=\"stress\"><player_name></style> handled them.","female":"It's alright now. The locusts are gone. Master <style=\"stress\"><player_name></style> handled them.","variant_male_record_index":"182537","variant_female_record_index":"182538","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521206004:0":{"text":"They're... gone?","source_cn":"消灭……消灭……","status":"matched","hash_xxh64":"0xC9EC18504EDC6191","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521206005:0":{"text":"Yes. We're trying to get you out, but the door's locked.","source_cn":"是的。我们要救你出来，但是门被锁住了。","status":"matched","hash_xxh64":"0x7FDE7B8BAD0220A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521206006:0":{"text":"Can you open it?","source_cn":"你有办法打开它吗？","status":"matched","hash_xxh64":"0x7FF77347C7D1BE99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521206007:0":{"text":"...","source_cn":"……<key:dialog107>","status":"matched","hash_xxh64":"0x2A02CBBA31401134","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1521206008:0":{"text":"Are you... alright?","source_cn":"你……你还好吗？","status":"matched","hash_xxh64":"0x98BEA5E40B81E9EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521206009:0":{"text":"... I'm here.","source_cn":"……我在。<key:dialog1>","status":"matched","hash_xxh64":"0xA16AD98C035E301F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521206010:0":{"text":"The door... it's locked. We had to hide, so we locked it. To keep the needle locusts from finding us.","source_cn":"门……门上锁了。我们要躲起来，避免被针蝗发现，所以锁住了门。","status":"matched","hash_xxh64":"0x63EAAC24B6861A6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1521206011:1":{"text":"And then... the key... <style=\"highlight\">it went missing</style>.","source_cn":"那之后，钥匙……<style=highlight>钥匙...","status":"matched","hash_xxh64":"0x5EF15AB3AA4736FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1521206011":{"text":"And then... the key... <style=\"highlight\">it went missing</style>.","source_cn":"那之后，钥匙……<style=highlight>钥匙不见了</style>。","status":"matched","hash_xxh64":"0x5EF15AB3AA4736FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1521206012:0":{"text":"Not anymore. Just me...","source_cn":"他们不在了。只有我……","status":"matched","hash_xxh64":"0x1D1FA1208543010A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1521206013:0":{"text":"They didn't make it. I'm the only one left...","source_cn":"他们坚持不下去，只有我……","status":"matched","hash_xxh64":"0x290EF0105285958D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"\"We\"? There were others with you?","source_cn":"“你们”？屋里还有其他人？","status":"matched_runtime_gender","hash_xxh64":"0xF979B2598C94B046","variant_status":"runtime_gender_keys_target_same","male":"\"We\"? There were others with you?","female":"\"We\"? There were others with you?","variant_male_record_index":"77765","variant_female_record_index":"77766","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1521206014:0":{"text":"I tried. I can't find it. I don't know where they put it.","source_cn":"不，我找不到。我不知道他们放在哪。","status":"matched","hash_xxh64":"0xE62BDE96DAA058DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1521206015:0":{"text":"No... I used to know. <style=\"highlight\">I just can't remember anymore</style>...","source_cn":"不……我原本知道，<style=highlight>是...","status":"matched","hash_xxh64":"0x08398C39E49D1F6A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1521206016:0":{"text":"... He's not making much sense.","source_cn":"……他说话好奇怪。","status":"matched_runtime_gender","hash_xxh64":"0xC91FC3BCACFE37FA","variant_status":"runtime_gender_keys_target_same","male":"... He's not making much sense.","female":"... He's not making much sense.","variant_male_record_index":"182551","variant_female_record_index":"182552","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:1:2":{"text":"The key's in there. Check again.","source_cn":"钥匙肯定还在屋里，快找找","status":"matched_runtime_gender","hash_xxh64":"0x847307776DA92242","variant_status":"runtime_gender_keys_target_same","male":"The key's in there. Check again.","female":"The key's in there. Check again.","variant_male_record_index":"77767","variant_female_record_index":"77768","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1521206017:2":{"text":"No... I don't live here.","source_cn":"不……我不是这个村子的人。","status":"matched","hash_xxh64":"0xCCC48A168602C35E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1521206018:0":{"text":"My name... is <style=\"highlight\">Anton</style>. A Halian soldier. I was with the <style=\"highlight\">city guards</style>.","source_cn":"我叫……叫<style=highlight>安东</s...","status":"matched","hash_xxh64":"0x8983173EE479578B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1521206019:0":{"text":"When the locusts showed up... my unit was sent here to handle it.","source_cn":"针蝗刚出现时，我们小队被派到这里……处理它们。","status":"matched","hash_xxh64":"0x5DCBDD64E476BD97","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1521206020:0":{"text":"But there were too many. And other monsters too. We shut ourselves in... No one made it out.","source_cn":"可是针蝗数量太多，还有怪物……我们躲在屋子里，没人逃得出去。","status":"matched","hash_xxh64":"0x4B9F54DD41A3C181","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1521206021:0":{"text":"<sad>I'm the last one left...</sad>","source_cn":"<sad>到现在，只剩下我了……</sad>","status":"matched","hash_xxh64":"0x7B810F46F1D0C5C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:25:1521206021":{"text":"<sad>I'm the last one left...</sad>","source_cn":"<sad>到现在，只剩下我了……</sad>","status":"matched","hash_xxh64":"0x7B810F46F1D0C5C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1521206022:0":{"text":"Yeah, and the Halians have been attacking the Wildborn for just as long...","source_cn":"是的。呼临人进攻雅库伯尔也很久了……","status":"matched","hash_xxh64":"0xFB1B5A820D2F08A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1521206023:1":{"text":"And you've been stuck here all this time? What did you even eat?","source_cn":"你从那时候，坚持到了现在……吃什么？","status":"matched","hash_xxh64":"0x5897AC7E53676011","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1521206024:0":{"text":"I-I'm not sure...","source_cn":"我……我不知道……<key:dialog1>","status":"matched","hash_xxh64":"0x5D752C9D8C20752C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1521206025:1":{"text":"... Needle locusts?\nYes. All of them... needle locusts!","source_cn":"……针蝗？\\n对，针蝗……全都是针蝗！！","status":"matched","hash_xxh64":"0xFA32E2443EA1C3D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1521206026:0":{"text":"I didn't have a choice! I was starving!","source_cn":"我没有办法……我没有办法！我好饿，我真的好饿！！","status":"matched","hash_xxh64":"0x4B2DE8BB27093EB1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1521206027:0":{"text":"No food. No water. Just locusts... We ate them. We had to!","source_cn":"没有肉，没有水，只有针蝗……我们只能吃针蝗！！","status":"matched","hash_xxh64":"0x19D03712F4CE2D36","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1521206028:0":{"text":"But after eating those things, everyone just kept getting weaker. We couldn't even hold our swords!","source_cn":"可是吃了针蝗以后，所有人的身体都越来越差，拔剑的力气也...","status":"matched","hash_xxh64":"0x92D7D7D5A1A8C608","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1521206029:1":{"text":"They're not food. They're poison! Run!\nRun before they come back!","source_cn":"——那东西不是人吃的！快逃，快逃！！\\n趁着针蝗还没来...","status":"matched","hash_xxh64":"0xCEB9EC017EDE36D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:35:1521206029":{"text":"They're not food. They're poison! Run!\nRun before they come back!","source_cn":"——那东西不是人吃的！快逃，快逃！！\\n趁着蝗虫还没来！快逃！！","status":"matched","hash_xxh64":"0xCEB9EC017EDE36D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1521206033:0":{"text":"Help... me?","source_cn":"救我……？","status":"matched","hash_xxh64":"0xCAC7E058445E5435","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1521206034:0":{"text":"Yeah... yes. Please. I don't want to stay here anymore.","source_cn":"对，对……救我。我不想待在这里。","status":"matched","hash_xxh64":"0x201439A033C9AC19","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1521206035:0":{"text":"Please, kind strangers, <style=\"highlight\">check nearby for a spare key</style>.\nIt has to be nearby. I just forgot where...","source_cn":"好心人，求你们<style=highlight>在附近...","status":"matched","hash_xxh64":"0xC7C15D63E3ED8A91","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:35:0:1":{"text":"Didn't you ask us to help you?","source_cn":"不是要我们救你吗？","status":"matched_runtime_gender","hash_xxh64":"0x767F25C71D8418D9","variant_status":"runtime_gender_keys_target_same","male":"Didn't you ask us to help you?","female":"Didn't you ask us to help you?","variant_male_record_index":"77775","variant_female_record_index":"77776","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1521206030:0":{"text":"No... you don't understand...","source_cn":"不……你不明白……<key:dialog2>","status":"matched","hash_xxh64":"0xFB93D14634B032C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1521206031:0":{"text":"You have no idea how strong Master <style=\"stress\"><player_name></style> is.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x200E4EC6BAED1AE0","variant_status":"runtime_gender_keys_target_same","male":"You have no idea how strong Master <style=\"stress\"><player_name></style> is.","female":"You have no idea how strong Master <style=\"stress\"><player_name></style> is.","variant_male_record_index":"182568","variant_female_record_index":"182569","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1521206032:0":{"text":"You asked us to help you, didn't you?","source_cn":"你不是要我们救你吗？","status":"matched","hash_xxh64":"0xAC812FAA6991DF25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:35:1:2":{"text":"Don't worry. I can handle bugs.","source_cn":"放心吧，蝗虫不是我的对手","status":"matched_runtime_gender","hash_xxh64":"0x875FB7D80A75A44F","variant_status":"runtime_gender_keys_target_same","male":"Don't worry. I can handle bugs.","female":"Don't worry. I can handle bugs.","variant_male_record_index":"77777","variant_female_record_index":"77778","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:0:1":{"text":"These bugs have been here a while.","source_cn":"蝗灾出现很久了……","status":"matched_runtime_gender","hash_xxh64":"0x82B75B73BCB790CB","variant_status":"runtime_gender_keys_target_same","male":"These bugs have been here a while.","female":"These bugs have been here a while.","variant_male_record_index":"77771","variant_female_record_index":"77772","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:1:2":{"text":"How have you survived this long?","source_cn":"你怎么坚持到现在的？","status":"matched_runtime_gender","hash_xxh64":"0xFCF5F49D46FF315A","variant_status":"runtime_gender_keys_target_same","male":"How have you survived this long?","female":"How have you survived this long?","variant_male_record_index":"77773","variant_female_record_index":"77774","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:2:3":{"text":"Isn't this your house?","source_cn":"这里不是你家吗？","status":"matched_runtime_gender","hash_xxh64":"0xEB1ADF7340E1E128","variant_status":"runtime_gender_keys_target_same","male":"Isn't this your house?","female":"Isn't this your house?","variant_male_record_index":"77769","variant_female_record_index":"77770","document_title":"","document_title_male":"","