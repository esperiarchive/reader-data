nt_title_status":""},"say:18:1521354016:1":{"text":"Treat her right. Or I'll skin you myself!","source_cn":"对芙好一点，否则我就扒了你的皮！","status":"matched","hash_xxh64":"0xCF5CB83C68C46A49","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1521354017:0":{"text":"Thank you... Father...","source_cn":"谢谢你……阿爹……","status":"matched","hash_xxh64":"0xFFE408DE910502EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1521354018:0":{"text":"Thank you...","source_cn":"谢谢……<key:dialog52>","status":"matched","hash_xxh64":"0xCD971F6AC3B2E4F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:颚":{"text":"Sharpjaw","source":"颚","status":"matched_dialogue_flow"},"speaker:马尔科":{"text":"Marco","source":"马尔科","status":"matched_dialogue_flow"},"speaker:芙":{"text":"Fufu","source":"芙","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":19,"localized_text_count":18,"speaker_count":3}}