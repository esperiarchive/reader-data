{"asset_key":"ep5/quest_story_15213540","episode":"ep5","category":"quest_story","story_id":"15213540","schema_version":1,"lang":"en","texts":{"say:1:1521354001:0":{"text":"Hah. Just as I thought. Halians can't take a hit.","source_cn":"哼，果然是呼临人，根本扛不住几下。","status":"matched","hash_xxh64":"0x99E913C09171E570","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1521354002:0":{"text":"Still not gonna surrender, human boy?","source_cn":"还不认输吗？人类小子。","status":"matched","hash_xxh64":"0x90696CB2E4A652BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521354003:0":{"text":"No...! I—I haven't lost yet... I can still... keep going...!","source_cn":"不……！我、我还没有输……我还能……再战！","status":"matched","hash_xxh64":"0x61A5F70D43E357CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521354004:0":{"text":"Keep going? You'll die if you take one more hit!","source_cn":"再战？再战你就必死无疑了！","status":"matched","hash_xxh64":"0x3162A8281BECCF9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521354005:0":{"text":"For Fufu... I won't lose. I can't lose!","source_cn":"为了芙……我不可能……不可能输！","status":"matched","hash_xxh64":"0x888BD32FE1E23723","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521354006:0":{"text":"...","source_cn":"……<key:dialog112>","status":"matched","hash_xxh64":"0x8269301135897598","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521354007:0":{"text":"Father!","source_cn":"阿爹——！","status":"matched","hash_xxh64":"0xF1E292E441E318E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1521354008:0":{"text":"Hmph...","source_cn":"哼……<key:dialog9>","status":"matched","hash_xxh64":"0xA3DB48CF10BD9B99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521354009:0":{"text":"So, you're Marco, huh?","source_cn":"你叫马尔科，是吧？","status":"matched","hash_xxh64":"0x87914D146DD16EA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521354010:0":{"text":"Yes...","source_cn":"对……","status":"matched","hash_xxh64":"0x1E2B22E29E3F8BCB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1521354011:1":{"text":"You've got some fire in you. Fine. For Fufu's sake... take her. Leave Wrathwood Grove and start a new life somewhere else!","so