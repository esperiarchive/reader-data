{"asset_key":"ep5/quest_story_15205440","episode":"ep5","category":"quest_story","story_id":"15205440","schema_version":1,"lang":"en","texts":{"say:2:1520544001:1":{"text":"Can't believe you're really here. I thought it was just a trick by that mage.","source_cn":"老师，你真的……真的回来了。我原本以为那个魔法师是在故...","status":"matched","hash_xxh64":"0xE5D3B3B5E4FF4518","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1520544002:1":{"text":"What makes you think that, Sharpeye?","source_cn":"你为什么会这么认为，锐眼？","status":"matched","hash_xxh64":"0x61DD8BA3CB92A42B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1520544003:1":{"text":"He's from Halia, after all! All Halians are sneaky and cunning! They're our enemies...","source_cn":"因为他从呼临来！他们阴毒、狡诈，呼临是雅库伯尔的敌人——","status":"matched","hash_xxh64":"0x5F037C468D65340D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1520544004:1":{"text":"I'm afraid you're mistaken, my dear...","source_cn":"我的孩子，你错了……","status":"matched","hash_xxh64":"0x9CE17DF8262650C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1520544005:1":{"text":"I'm not! It was the Halians who killed you!","source_cn":"我没错，是呼临人杀了你！","status":"matched","hash_xxh64":"0x14E4D25F8E2380E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1520544006:1":{"text":"You'd still be alive if you hadn't blocked that strike for me! When the time comes, I'll avenge your death!","source_cn":"你本不该死的，如果不是要为我挡下攻击，你就还会活着！我...","status":"matched","hash_xxh64":"0x81B69C0A4C1A3280","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1520544007:1":{"text":"My dear, that spear didn't take my life. I was slain by the beasts summoned by Wild Moon.","source_cn":"孩子……呼临人那一枪并没有杀死我，我是被雅库伯尔之月召...","status":"matched","hash_xxh64":"0x4B6ECE543CC7F61C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1520544008:1":{"text":"... I know, but...","source_cn":"……我知道，可是……","status":"matched","hash_xxh64":"0x5366C50ED98FC368","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1520544009:1":{"text":"I really miss you.","source_cn":"老师……我想念你。","status":"matched","hash_xxh64":"0xEAF846726C66D00B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1520544010:1":{"text":"Me too...","source_cn":"我们都是。","status":"matched","hash_xxh64":"0x16D0AC26E1CCC028","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:战士锐眼":{"text":"Warrior Sharpeye","source":"战士锐眼","status":"matched_dialogue_flow"},"speaker:巫祭溪的灵魂":{"text":"Stram's Spirit","source":"巫祭溪的灵魂","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":2}}