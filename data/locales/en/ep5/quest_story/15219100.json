e_prompt:14:1521910009":{"text":"It's gone now, destroyed in the disaster... But I still want to go back one last time. I have precious memories there.","source_cn":"虽然它也已经在灾难中毁灭……但我想再回去看看。那里有宝贵的回忆……","status":"matched","hash_xxh64":"0x4A81641B6964F287","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1521910010:1":{"text":"Yes, <style=\"highlight\">Tuttleton</style>.","source_cn":"是<style=highlight>图塔镇</style>。","status":"matched","hash_xxh64":"0x55AE4C75DE535DFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1521910011:1":{"text":"I know it's gone. The God of Harvest destroyed it... Only Marc and I escaped...","source_cn":"我知道，图塔镇被丰饶神毁灭了……只有我和马可侥幸逃出来……","status":"matched","hash_xxh64":"0x6922B9B46FEDBAE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1521910012:1":{"text":"They say it's shrouded in darkness now, crawling with monsters. Anyone who enters disappears... There's no way I could make it back alone.","source_cn":"那里已经被黑暗笼罩了……我听说，到处都是怪物，进入黑暗...","status":"matched","hash_xxh64":"0x70052A1236FD90FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1521910013:1":{"text":"Please, I'm begging you, take me there...","source_cn":"所以我想求你们，求你们带我回去……","status":"matched","hash_xxh64":"0xF54F605BA5448521","variant_status":"