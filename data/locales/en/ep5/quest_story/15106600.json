{"asset_key":"ep5/quest_story_15106600","episode":"ep5","category":"quest_story","story_id":"15106600","schema_version":1,"lang":"en","texts":{"say:1:1510660001:0":{"text":"Master, Master!","source_cn":"主人，主人！","status":"matched","hash_xxh64":"0x40B718C2FC104B27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510660002:0":{"text":"...","source_cn":"……","status":"matched_runtime_gender","hash_xxh64":"0x238D2CA81E00BC30","variant_status":"runtime_gender_keys_target_same","male":"...","female":"...","variant_male_record_index":"174765","variant_female_record_index":"174766","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510660003:0":{"text":"Master... Master... Why... won't you answer...?","source_cn":"主人……主人……为什么，不回应……十六？","status":"matched","hash_xxh64":"0x89B37E4A7389AE11","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510660004:0":{"text":"It's no use. There's more than one soul bound in there, and they've all been crudely stitched together.","source_cn":"没用，被束缚的不止一个人的灵魂，都被暴力缝合到一起了。","status":"matched","hash_xxh64":"0x800446C9FC0557B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510660005:0":{"text":"It'll be nearly impossible to wake your master, even just a part of him.","source_cn":"想唤醒你的主人，哪怕只是其中一部分，都很难。","status":"matched","hash_xxh64":"0xD0B5FB8734325A07","variant_status":"","male":"","female":"","variant_male_reco