{"asset_key":"ep5/quest_story_15205350","episode":"ep5","category":"quest_story","story_id":"15205350","schema_version":1,"lang":"en","texts":{"say:3:1520535001:1":{"text":"<style=\"stress\"><player_name></style> and Gala, how are things on your side?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xFE652E96DFAC8E08","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style> and Gala, how are things on your side?","female":"<style=\"stress\"><player_name></style> and Gala, how are things on your side?","variant_male_record_index":"186722","variant_female_record_index":"186723","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1520535002:0":{"text":"It's all set. We can start the ritual anytime.","source_cn":"准备完毕。随时可以开始仪式。","status":"matched","hash_xxh64":"0x7C0442E9EDF2F41F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1520535003:0":{"text":"What became of the dead Halians?","source_cn":"……死去的呼临人，怎样了？","status":"matched","hash_xxh64":"0x0C65B6EDB962D671","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1520535004:0":{"text":"Lying quietly in the graves they had dug for themselves. No one saw it, no one panicked.","source_cn":"在他们自己掘好的坟墓里老老实实躺着。无人目击，没有恐慌。","status":"matched","hash_xxh64":"0x0BDFB460C395FF28","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1520535005:0":{"text":"Still don't trust me, little one?","source_cn":"小家伙，你还在怀疑我？","status":"matched","hash_xxh64":"0x461C3CC09050740D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1520535006:0":{"text":"It's not that...","source_cn":"没有。但是……","status":"matched","hash_xxh64":"0x06BCD31F74677FA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1520535007:1":{"text":"Relax, Gala. Morgan's magic worked out fine. The fallen soldiers and the flood victims have all been properly buried, everyone except General Perseus and Lieutenant Lygos.","source_cn":"不必紧张，加拉。摩根的魔法成功了，战死的士兵，以及洪灾...","status":"matched","hash_xxh64":"0x96B64C73BA61A776","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1520535008:0":{"text":"The Regulus insists on preparing their funerals. They'll be buried afterward.","source_cn":"呼临城的领主坚持要亲自为这两位战士准备葬礼，等他筹备完...","status":"matched","hash_xxh64":"0x6E3E74D01E23C3C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1520535009:1":{"text":"Morgan has preserved their remains with magic to make sure they can last until the funeral.","source_cn":"摩根用魔法为他们的遗骸做了一些处理，能平稳等到下葬日来...","status":"matched","hash_xxh64":"0x2F52B8EC92C8F2D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1520535009":{"text":"Morgan has preserved their remains with magic to make sure they can last until the funeral.","source_cn":"摩根用魔法为他们的遗骸做了一些处理，能平稳等到下葬日来临。","status":"matched","hash_xxh64":"0x2F52B8EC92C8F2D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1520535010:0":{"text":"The fact that I'm standing here in one piece speaks for itself.","source_cn":"我能完好无损站在这里，已经说明问题了。","status":"matched_runtime_gender","hash_xxh64":"0xC2B8D62DD5248B7B","variant_status":"runtime_gender_keys_target_same","male":"The fact that I'm standing here in one piece speaks for itself.","female":"The fact that I'm standing here in one piece speaks for itself.","variant_male_record_index":"186732","variant_female_record_index":"186733","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1520535013:0":{"text":"I wish you two were there when the skeletons struggled to their feet. It was really... *Cough*","source_cn":"你们该看看那些遗骸挣扎着爬起来的样子，那真是……咳……","status":"matched","hash_xxh64":"0xDE9D8479D1E6184C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1520535014:0":{"text":"*Cough*","source_cn":"咳咳咳……<key:dialog2>","status":"matched","hash_xxh64":"0x9954B5CBAB24F33D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1520535015:0":{"text":"Are you okay...","source_cn":"你……怎么了？","status":"matched","hash_xxh64":"0x13B347C396E4221C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1520535016:1":{"text":"I've never controlled so many bodies before... It's really draining...","source_cn":"第一次操纵那么多尸体，魔力消耗太大。","status":"matched","hash_xxh64":"0x2412F0E7BADB93A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1520535017:1":{"text":"Stop looking at me with those pitying eyes! It's way too soon for me to meet the God of Death!","source_cn":"……你们那是什么眼神？我讨厌神，尤其是死神，现在也没准...","status":"matched","hash_xxh64":"0x71E5ABA0746B2E11","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1520535018:1":{"text":"*Cough*","source_cn":"咳咳……<key:dialog3>","status":"matched","hash_xxh64":"0x01447EBED7A381CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1520535019:1":{"text":"Morgan, you need to rest. If you keep using necromancy on this scale, it could backfire.","source_cn":"摩根，不要勉强自己，你需要休息。现在再大范围使用亡灵魔...","status":"matched","hash_xxh64":"0xF1F8889AB37B1A85","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1520535020:1":{"text":"I can't stop now, not when the ritual is still unfinished.","source_cn":"我人都来了，现在说不要施法，那祭祀仪式怎么办？","status":"matched","hash_xxh64":"0x4B23E61A382E42ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1520535021:1":{"text":"But it's too dangerous for you to keep going.","source_cn":"但是，你这样不行。你有危险。","status":"matched","hash_xxh64":"0xE1C3FD2A6BACF78A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1520535022:1":{"text":"Never doubt me, little one.","source_cn":"小家伙，记住，不许说我不行。","status":"matched","hash_xxh64":"0xB2392C0F9F771F6E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1520535023:1":{"text":"<style=\"stress\"><player_name></style>... what do you say we lend Morgan some of our magic? From what I know of him, he won't listen to reason now.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xC4AEC5BA0688182E","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>... what do you say we lend Morgan some of our magic? From what I know of him, he won't listen to reason now.","female":"<style=\"stress\"><player_name></style>... what do you say we lend Morgan some of our magic? From what I know of him, he won't listen to reason now.","variant_male_record_index":"186746","variant_female_record_index":"186747","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1520535024:0":{"text":"Sharing a small amount of magic won't cause us any real harm. Those low on magic might feel a bit lightheaded, but that's all.","source_cn":"分出少许魔力不会对你我造成任何实质性损害，对于魔力不足...","status":"matched_runtime_gender","hash_xxh64":"0x75C5555CBAA95199","variant_status":"runtime_gender_keys_target_same","male":"Sharing a small amount of magic won't cause us any real harm. Those low on magic might feel a bit lightheaded, but that's all.","female":"Sharing a small amount of magic won't cause us any real harm. Those low on magic might feel a bit lightheaded, but that's all.","variant_male_record_index":"186748","variant_female_record_index":"186749","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:26:1520535024":{"text":"Sharing a small amount of magic won't cause us any real harm. Those low on magic might feel a bit lightheaded, but that's all.","source_cn":"分出少许魔力不会对你我造成任何实质性损害，对于魔力不足的人而言，可能会有轻微晕眩，但也仅此而已。","status":"matched_runtime_gender","hash_xxh64":"0x75C5555CBAA95199","variant_status":"runtime_gender_keys_target_same","male":"Sharing a small amount of magic won't cause us any real harm. Those low on magic might feel a bit lightheaded, but that's all.","female":"Sharing a small amount of magic won't cause us any real harm. Those low on magic might feel a bit lightheaded, but that's all.","variant_male_record_index":"186748","variant_female_record_index":"186749","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1520535025:1":{"text":"Thank you, <style=\"stress\"><player_name></style>.","source_cn":"谢谢你，<style=stress><player_n...","status":"matched_runtime_gender","hash_xxh64":"0x9CCBE5074F399D00","variant_status":"runtime_gender_keys_target_same","male":"Thank you, <style=\"stress\"><player_name></style>.","female":"Thank you, <style=\"stress\"><player_name></style>.","variant_male_record_index":"186750","variant_female_record_index":"186751","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1520535027:0":{"text":"I can help Morgan, too.","source_cn":"帮摩根，我也一起。","status":"matched_runtime_gender","hash_xxh64":"0x5C06AF568A347B61","variant_status":"runtime_gender_keys_target_same","male":"I can help Morgan, too.","female":"I can help Morgan, too.","variant_male_record_index":"186754","variant_female_record_index":"186755","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1520535028:0":{"text":"... Do you even have enough magic to spare? Merlin and the rookie are enough.","source_cn":"……你那点魔力能做什么？有梅林和新人足够了。","status":"matched_runtime_gender","hash_xxh64":"0xEA3332DBF1D92F55","variant_status":"runtime_gender_keys_target_same","male":"... Do you even have enough magic to spare? Merlin and the rookie are enough.","female":"... Do you even have enough magic to spare? Merlin and the rookie are enough.","variant_male_record_index":"186756","variant_female_record_index":"186757","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1520535029:0":{"text":"I don't like you—not even one bit—but I know you're doing the right thing.","source_cn":"我不喜欢你。从头到脚都不喜欢，但是你在做好事。","status":"matched","hash_xxh64":"0x7358A3925DA16260","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1520535030:0":{"text":"So, I'll help.","source_cn":"所以，我应该出力。","status":"matched","hash_xxh64":"0x4FE41BC56F6F624C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1520535031:0":{"text":"Thanks, but I honestly don't care whether you like me or not.","source_cn":"谢了，我也一点都不想讨孩子喜欢。","status":"matched","hash_xxh64":"0x5F6B2CBBE850ACED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1520535032:0":{"text":"Is everyone ready?","source_cn":"大家都准备好了吗？","status":"matched","hash_xxh64":"0x7690BD5E9BBAC3B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1520535033:1":{"text":"Let's get it done...","source_cn":"那么，来吧……","status":"matched","hash_xxh64":"0x39C113895B59588D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:0:1":{"text":"No problem.","source_cn":"可以","status":"matched_runtime_gender","hash_xxh64":"0x29FC2493CCE59C80","variant_status":"runtime_gender_keys_target_same","male":"No problem.","female":"No problem.","variant_male_record_index":"79051","variant_female_record_index":"79052","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1520535026:1":{"text":"*Cough* You're doing this for the Wildborn, not for me. Take it up with the little one next to you.","source_cn":"咳……错了，是雅库伯尔欠你的。找你旁边那个小家伙去要。","status":"matched_runtime_gender","hash_xxh64":"0x4CBA3ED5BAD5C9B6","variant_status":"runtime_gender_keys_target_same","male":"*Cough* You're doing this for the Wildborn, not for me. Take it up with the little one next to you.","female":"*Cough* You're doing this for the Wildborn, not for me. Take it up with the little one next to you.","variant_male_record_index":"186752","variant_female_record_index":"186753","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:1:2":{"text":"Morgan, you owe me one.","source_cn":"摩根，你欠我一份人情","status":"matched_runtime_gender","hash_xxh64":"0x5508D480999D8258","variant_status":"runtime_gender_keys_target_same","male":"Morgan, you owe me one.","female":"Morgan, you owe me one.","variant_male_record_index":"79053","variant_female_record_index":"79054","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:0:1":{"text":"Did the necromancy work?","source_cn":"亡灵魔法顺利吗？","status":"matched_runtime_gender","hash_xxh64":"0x94AF6977EA521CC2","variant_status":"runtime_gender_keys_target_same","male":"Did the necromancy work?","female":"Did the necromancy work?","variant_male_record_index":"79047","variant_female_record_index":"79048","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1520535011:1":{"text":"Morgan, you look pale.","source_cn":"摩根，脸色很差。","status":"matched","hash_xxh64":"0x4038F1094429F982","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1520535012:1":{"text":"I've always looked like this... *Cough*","source_cn":"我脸色什么时候好过……咳。","status":"matched","hash_xxh64":"0xF7C09FAC5B45A53A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:1:2":{"text":"You look tired...","source_cn":"摩根看上去很疲惫……","status":"matched_runtime_gender","hash_xxh64":"0x8AF129EC46E26C3D","variant_status":"runtime_gender_keys_target_same","male":"You look tired...","female":"You look tired...","variant_male_record_index":"79049","variant_female_record_index":"79050","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"},"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":40,"localized_text_count":39,"speaker_count":3}}