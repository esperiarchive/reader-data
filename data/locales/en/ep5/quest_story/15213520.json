{"asset_key":"ep5/quest_story_15213520","episode":"ep5","category":"quest_story","story_id":"15213520","schema_version":1,"lang":"en","texts":{"say:3:1521352001:0":{"text":"You filthy Halian! How dare you trick Fufu into running away with you?!","source_cn":"该死的呼临人！你竟敢蛊惑芙跟你私奔！","status":"matched","hash_xxh64":"0x0147190D6A83A6F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521352002:0":{"text":"Run away? What? No, I never!","source_cn":"私奔……？我、我没有啊！","status":"matched","hash_xxh64":"0xC67C34161AB5906C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521352003:0":{"text":"Father, Marco didn't do anything like that!","source_cn":"阿爹，马尔科没做那样的事！","status":"matched","hash_xxh64":"0x885F049DE1D48BC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521352004:0":{"text":"I... I won't let you hurt him! I love him, and he loves me!","source_cn":"我……我不许你伤害他！我和他是真心相爱的！","status":"matched","hash_xxh64":"0x282D21DC9701CA21","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521352005:0":{"text":"Fufu, move aside!","source_cn":"芙，你让开！","status":"matched","hash_xxh64":"0x6160589139A5F3D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521352006:1":{"text":"No! I won't!","source_cn":"——不！不可能！","status":"matched","hash_xxh64":"0xAF31AB5493B0A0D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521352007:0":{"text":"When Mirehold was attacked, some Halians tried to hurt Twitch. It was Marco who protected him!","source_cn":"水泽营地被占领的时候，有几个呼临人想欺负扭耳，是马尔科...","status":"matched","hash_xxh64":"0x8B26687938CE29A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1521352008:0":{"text":"Twitch and I were bad at hunting... When we had nothing to eat, Marco gave us his food.","source_cn":"我和扭耳都不擅长打猎……没有猎物的时候，也是马尔科把他...","status":"matched","hash_xxh64":"0x363DE5A2D4ECE7B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521352009:1":{"text":"He helped us find out where you and Mother were... And he risked his life bringing Master <style=\"stress\"><player_name></style> here. Without him, Twitch and I never would've made it out of Mirehold!","source_cn":"是马尔科帮我们向外界打探你和阿娘的消息……也是马尔科冒...","status":"matched_runtime_gender","hash_xxh64":"0xB25750441ABF18F2","variant_status":"runtime_gender_keys_target_same","male":"He helped us find out where you and Mother were... And he risked his life bringing Master <style=\"stress\"><player_name></style> here. Without him, Twitch and I never would've made it out of Mirehold!","female":"He helped us find out where you and Mother were... And he risked his life bringing Master <style=\"stress\"><player_name></style> here. Without him, Twitch and I never would've made it out of Mirehold!","variant_male_record_index":"185114","variant_female_record_index":"185115","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521352010:0":{"text":"Through all those days together, we fell in love...","source_cn":"那些日子的陪伴，我与他早已彼此相爱……","status":"matched","hash_xxh64":"0x8E8F050A47227287","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1521352011:0":{"text":"It had nothing to do with strength. Or race... I love him for who he is!","source_cn":"与力量无关，与种族无关……我爱的就是他这个人！","status":"matched","hash_xxh64":"0xC7DB81D192705135","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1521352012:0":{"text":"Fufu...","source_cn":"芙……<key:dialog2>","status":"matched","hash_xxh64":"0x3449032AE68582B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1521352013:0":{"text":"... I'll face this with you.","source_cn":"……我会和你一起承担。","status":"matched","hash_xxh64":"0x41DE761A82E1A0B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1521352014:0":{"text":"Please believe me. My feelings for Fufu are real! Even if you hate me, even if you stand in our way... I'll fight with everything I have to be with her.","source_cn":"请你们相信我，我对芙的爱是真的！即使你们不同意……我也...","status":"matched","hash_xxh64":"0xEEC5C2BC4A719D76","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1521352015:0":{"text":"Even if it means getting beaten bloody, even if it costs me my life... I won't regret it!","source_cn":"即使被你们教训，即使付出生命……我也绝不后悔！","status":"matched","hash_xxh64":"0x056C8131778C8796","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1521352016:0":{"text":"Hmph...","source_cn":"哼……<key:dialog8>","status":"matched","hash_xxh64":"0x0C15E068BAA1CCCA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1521352017:0":{"text":"If Fufu is so sure about you, then fine. I'll give you one chance. <style=\"highlight\">Beat me in a fight</style>.","source_cn":"既然芙这么坚持，那我就给你一次机会——<style=h...","status":"matched","hash_xxh64":"0xB455F38C4E84BCBC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1521352018:1":{"text":"If you can do that, her mother and I won't stand in your way!","source_cn":"只要你能打败我，我和她阿娘就不再反对！","status":"matched","hash_xxh64":"0x39798559FA6C083E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1521352019:0":{"text":"... You mean it?","source_cn":"……真的？","status":"matched","hash_xxh64":"0x2EF8FE8071126D83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1521352020:0":{"text":"No! Marco, you're still injured!","source_cn":"不行！马尔科，你头上还有伤！","status":"matched","hash_xxh64":"0x42204D3E0FB16E63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1521352021:0":{"text":"It's alright...","source_cn":"不……没关系。","status":"matched","hash_xxh64":"0x8DE36DFFE4DF9E4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1521352022:0":{"text":"Like I said, even if it costs me my life.","source_cn":"我说了，为了你，付出生命也没关系。","status":"matched","hash_xxh64":"0xC55B7E3D66DD43A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1521352023:0":{"text":"Come on. I WILL defeat you!","source_cn":"来吧。我一定会打败你的……！","status":"matched","hash_xxh64":"0x72B8582AB050CDDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1521352024:0":{"text":"Hmph. We'll see about that!","source_cn":"哼，那可说不准！","status":"matched","hash_xxh64":"0x739D87A3FC25F1E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:颚":{"text":"Sharpjaw","source":"颚","status":"matched_dialogue_flow"},"speaker:马尔科":{"text":"Marco","source":"马尔科","status":"matched_dialogue_flow"},"speaker:芙":{"text":"Fufu","source":"芙","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":25,"localized_text_count":24,"speaker_count":3}}