{"asset_key":"ep5/quest_story_15205420","episode":"ep5","category":"quest_story","story_id":"15205420","schema_version":1,"lang":"en","texts":{"say:2:1520542001:1":{"text":"Mother...","source_cn":"……阿娘……啊啊……","status":"matched","hash_xxh64":"0xC1B73B96987A2D10","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1520542002:0":{"text":"I'm right here, my darling! It's all over now... You'll be fine...","source_cn":"孩子，我的孩子……！阿娘在呢，就在这……已经没事了，一...","status":"matched","hash_xxh64":"0x7A3349494997A3E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1520542003:1":{"text":"You fought until the very end, and that makes you the bravest warrior I've ever known. Soon, you'll return to the embrace of the gods...","source_cn":"你是最勇敢的战士，你战斗到了最后一刻，你马上就能回归众...","status":"matched","hash_xxh64":"0x68F8F997CF6FE3F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1520542004:1":{"text":"Really? Is the Wild Moon... no longer red...","source_cn":"是吗，雅库伯尔之月……不再鲜红了……","status":"matched","hash_xxh64":"0x67E1A543EA8CCBAA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1520542005:1":{"text":"But it'll still shine upon our lands, right? The silvery moonlight... flows like a river...","source_cn":"但是，月亮还会照耀雅库伯尔，对吗？淡淡的，银色的月光…...","status":"matched","hash_xxh64":"0xEDCED49190BE4EED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1520542006:1":{"text":"Mother... please look up at the moon every night. If you hear rustling leaves, it could be me...","source_cn":"阿妈……到了晚上，看看月亮。月光和落叶，就是迅掌……","status":"matched","hash_xxh64":"0x02E7EA7B8FB4C6CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1520542007:1":{"text":"... Oh, my dearest daughter!","source_cn":"……孩子，我的孩子……！","status":"matched","hash_xxh64":"0xFEE1AB2088561518","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:战士迅掌的灵魂":{"text":"Quickpaw's Spirit","source":"战士迅掌的灵魂","status":"matched_dialogue_flow"},"speaker:兽人狸牙":{"text":"Tusk","source":"兽人狸牙","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}}