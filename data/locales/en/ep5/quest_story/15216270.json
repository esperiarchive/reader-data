{"asset_key":"ep5/quest_story_15216270","episode":"ep5","category":"quest_story","story_id":"15216270","schema_version":1,"lang":"en","texts":{"say:1:1521627001:0":{"text":"War...ner...","source_cn":"维尔……纳。","status":"matched","hash_xxh64":"0x4D7C816751EF780A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521627002:0":{"text":"Yes, it's me, Father.","source_cn":"……是我。老爹。","status":"matched","hash_xxh64":"0x63089C81A57F59AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521627003:0":{"text":"Don't worry... the pain will be over soon.","source_cn":"你不用担心了，马上就不会再痛苦了……","status":"matched","hash_xxh64":"0x7F8EE339E794FCC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521627004:0":{"text":"Can you two please help my father...? Let him <style=\"highlight\">rest in peace</style>...","source_cn":"两位魔法师，请你们帮帮我老爹……<style=high...","status":"matched","hash_xxh64":"0x324B5A43BB2031E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1521627004":{"text":"Can you two please help my father...? Let him <style=\"highlight\">rest in peace</style>...","source_cn":"两位魔法师，请你们帮帮我老爹……<style=highlight>让他安息</style>吧。","status":"matched","hash_xxh64":"0x324B5A43BB2031E1","variant_status":"","male":"","female":"","variant_male_record_inde