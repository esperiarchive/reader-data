{"asset_key":"ep5/quest_story_15213140","episode":"ep5","category":"quest_story","story_id":"15213140","schema_version":1,"lang":"en","texts":{"say:2:1521314001:0":{"text":"Marco, you're back! Are you hurt?","source_cn":"马尔科，你回来了！有没有哪里受伤？","status":"matched","hash_xxh64":"0x7F357877D0FCAEED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521314002:0":{"text":"I'm fine. Don't worry.","source_cn":"我好着呢。没事的，芙，不用担心。","status":"matched","hash_xxh64":"0xAAD7D8C8DA04048F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521314003:0":{"text":"Why do you have so much blood on your hand?","source_cn":"那你的手掌怎么蹭破了？还流了这么多血？","status":"matched","hash_xxh64":"0x00F05BCEA06970E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521314004:0":{"text":"Oh, that... It's just a scratch I got from climbing over the barricades. It's not serious.","source_cn":"啊，那个……那是翻越拒马时一不小心蹭到的，不碍事。","status":"matched","hash_xxh64":"0x2DDC254D4142FACF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521314005:0":{"text":"It doesn't hurt at all. I didn't even notice until you said something.","source_cn":"你看，一点都不疼！你不说我都没感觉到。","status":"matched","hash_xxh64":"0x246CE1613EC14665","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521314006:0":{"text":"Come inside later. I'll apply a salve.","source_cn":"待会到屋里来，我为你敷药。","status":"matched","hash_xxh64":"0x76D61FDA88B225A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521314007:1":{"text":"There's really no need...","source_cn":"真的不用，芙……","status":"matched","hash_xxh64":"0x8B417552D424E550","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1521314007":{"text":"There's really no need...","source_cn":"真的不用，芙……","status":"matched","hash_xxh64":"0x8B417552D424E550","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521314008:0":{"text":"Love...? What's that?","source_cn":"恋爱……？那是什么？","status":"matched_runtime_gender","hash_xxh64":"0xB5C7589480894E5F","variant_status":"runtime_gender_keys_target_same","male":"Love...? What's that?","female":"Love...? What's that?","variant_male_record_index":"184793","variant_female_record_index":"184794","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1521314008":{"text":"Love...? What's that?","source_cn":"恋爱……？那是什么？","status":"matched_runtime_gender","hash_xxh64":"0xB5C7589480894E5F","variant_status":"runtime_gender_keys_target_same","male":"Love...? What's that?","female":"Love...? What's that?","variant_male_record_index":"184793","variant_female_record_index":"184794","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1521314010:0":{"text":"Hmph!","source_cn":"——哼！","status":"matched","hash_xxh64":"0x51CBB9575597C537","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1521314011:0":{"text":"Fufu, we still haven't decided on how we're going to leave.","source_cn":"姐姐，我们还没定好要怎么离开呢！","status":"matched","hash_xxh64":"0xB719E062276CEC65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1521314012:0":{"text":"Ah, yes, sorry...","source_cn":"啊，不好意思……","status":"matched","hash_xxh64":"0xF463E4382C976C61","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1521314013:0":{"text":"Twitch is right. Let's talk about our plan first.","source_cn":"扭、扭耳说的没错。还是先商讨一下送你们离开的计划吧。","status":"matched","hash_xxh64":"0xDDFEED2078919B57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1521314014:0":{"text":"<style=\"highlight\">Tomorrow evening</style> will be my turn to guard the main gate. I can find a way to get rid of the other guards. Then, Master <style=\"stress\"><player_name></style> can lead everyone out.","source_cn":"正好<style=highlight>明天晚上</st...","status":"matched_runtime_gender","hash_xxh64":"0x0EA13874E8AD342A","variant_status":"runtime_gender_keys_target_same","male":"<style=\"highlight\">Tomorrow evening</style> will be my turn to guard the main gate. I can find a way to get rid of the other guards. Then, Master <style=\"stress\"><player_name></style> can lead everyone out.","female":"<style=\"highlight\">Tomorrow evening</style> will be my turn to guard the main gate. I can find a way to get rid of the other guards. Then, Master <style=\"stress\"><player_name></style> can lead everyone out.","variant_male_record_index":"184801","variant_female_record_index":"184802","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1521314015:0":{"text":"What do you think? The plan is okay, right?","source_cn":"怎么样，这个计划可行吗？","status":"matched_runtime_gender","hash_xxh64":"0x31602AFF8C4DE047","variant_status":"runtime_gender_keys_target_same","male":"What do you think? The plan is okay, right?","female":"What do you think? The plan is okay, right?","variant_male_record_index":"184803","variant_female_record_index":"184804","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:22:1521314015":{"text":"What do you think? The plan is okay, right?","source_cn":"怎么样，这个计划可行吗？","status":"matched_runtime_gender","hash_xxh64":"0x31602AFF8C4DE047","variant_status":"runtime_gender_keys_target_same","male":"What do you think? The plan is okay, right?","female":"What do you think? The plan is okay, right?","variant_male_record_index":"184803","variant_female_record_index":"184804","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1521314016:0":{"text":"Okay, let's do it this way then. Thanks for your help.","source_cn":"好，那就这样办。谢谢您的帮助。","status":"matched_runtime_gender","hash_xxh64":"0x1C8F65B7576697D5","variant_status":"runtime_gender_keys_target_same","male":"Okay, let's do it this way then. Thanks for your help.","female":"Okay, let's do it this way then. Thanks for your help.","variant_male_record_index":"184805","variant_female_record_index":"184806","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1521314017:0":{"text":"Fufu, Twitch... Please be extra careful when the time comes.","source_cn":"芙，扭耳……到时你们一定要多加小心。","status":"matched","hash_xxh64":"0x93297DB715D313AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1521314018:0":{"text":"We will. You take care of yourself too.","source_cn":"我知道，你保护好自己。","status":"matched","hash_xxh64":"0xA2445060DB366AA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1521314019:0":{"text":"You don't need to worry about me.","source_cn":"哼……才不用你担心呢！","status":"matched","hash_xxh64":"0x17A9BE6696B61800","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:28:1521314020:0":{"text":"The following evening, you and Gala arrive at the meeting spot.","source_cn":"第二天晚上，你和加拉来到了约定好的地点","status":"matched","hash_xxh64":"0x390DBA1236798EAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:0:1":{"text":"No problem for me.","source_cn":"我没问题","status":"matched_runtime_gender","hash_xxh64":"0xE43DF123A4E3F97E","variant_status":"runtime_gender_keys_target_same","male":"No problem for me.","female":"No problem for me.","variant_male_record_index":"78451","variant_female_record_index":"78452","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:1:2":{"text":"You know the guards. You decide.","source_cn":"你了解守卫的情况，你说了算","status":"matched_runtime_gender","hash_xxh64":"0x2E817D74C535D2F9","variant_status":"runtime_gender_keys_target_same","male":"You know the guards. You decide.","female":"You know the guards. You decide.","variant_male_record_index":"78453","variant_female_record_index":"78454","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:0:1":{"text":"You don't need to know right now.","source_cn":"这不是小孩子该问的","status":"matched_runtime_gender","hash_xxh64":"0xBB9EAB20E4F719DE","variant_status":"runtime_gender_keys_target_same","male":"You don't need to know right now.","female":"You don't need to know right now.","variant_male_record_index":"78447","variant_female_record_index":"78448","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:1:2":{"text":"You'll understand when you're older.","source_cn":"等你长大就懂了","status":"matched_runtime_gender","hash_xxh64":"0x42A3E860568A43D9","variant_status":"runtime_gender_keys_target_same","male":"You'll understand when you're older.","female":"You'll understand when you're older.","variant_male_record_index":"78449","variant_female_record_index":"78450","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"Love is in the air.","source_cn":"我闻到了恋爱的气味……","status":"matched_runtime_gender","hash_xxh64":"0x28FCAF79661B3B10","var