{"asset_key":"ep5/quest_story_15210160","episode":"ep5","category":"quest_story","story_id":"15210160","schema_version":1,"lang":"en","texts":{"say:1:1521016001:0":{"text":"Thank you... for not leaving me behind. I really thought I was going to drown...*Cough*","source_cn":"谢谢……谢谢你们没有抛下我……我还以为自己会被淹死……...","status":"matched","hash_xxh64":"0xF231E6F76D012730","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1521016002:0":{"text":"Save your breath. Spit out that water first... Achoo!","source_cn":"别说这些了，先把嗓子里的水吐出来……阿嚏！","status":"matched","hash_xxh64":"0x9A587D4D570A7E8F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521016003:0":{"text":"It's freezing...","source_cn":"好冷啊……","status":"matched","hash_xxh64":"0x4C010A55CB2FC907","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521016004:0":{"text":"If my clothes weren't soaked, I'd wrap you in them...","source_cn":"我的衣服全湿了，不然还能脱下来给你取暖……","status":"matched","hash_xxh64":"0xB446E9040F00CC6E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521016005:0":{"text":"It's okay. We're lucky to even have somewhere dry to sit.","source_cn":"别抱怨了，现在能有个落脚的地方就不错了……","status":"matched","hash_xxh64":"0x1A469117E722732C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521016006:0":{"text":"Halia is full of people like them...","source_cn":"城里到处都是这样受灾的人……","status":"matched","hash_xxh64":"0x5D737B301CB5499F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521016007:0":{"text":"Floods, rain... When will it end?","source_cn":"暴雨和洪水，什么时候才能结束？","status":"matched","hash_xxh64":"0xAB9B38A304DD5060","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1521016007":{"text":"Floods, rain... When will it end?","source_cn":"暴雨和洪水，什么时候才能结束？","status":"matched","hash_xxh64":"0xAB9B38A304DD5060","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521016008:0":{"text":"Right... The living come first.","source_cn":"对……活着的人更重要。","status":"matched","hash_xxh64":"0x75EC114E577DEA50","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521016011:0":{"text":"Hand me some of the clothes we brought. These should <style=\"highlight\">help them stay warm</style>.","source_cn":"护卫长官，快把准备的<style=highlight>...","status":"matched_runtime_gender","hash_xxh64":"0x87982223B2A10EA0","variant_status":"runtime_gender_keys_target_same","male":"Hand me some of the clothes