{"asset_key":"ep5/quest_story_15219080","episode":"ep5","category":"quest_story","story_id":"15219080","schema_version":1,"lang":"en","texts":{"cinematic_dialogue:2:1521907001:":{"text":"Please, just look one more time...","source_cn":"求你们再去找找……","status":"matched","hash_xxh64":"0xDE6FFBA4A8E98984","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1521907002:":{"text":"No! Don't even think about it!","source_cn":"不可能！别想了！","status":"matched","hash_xxh64":"0x4D0768E9121F03EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521908001:0":{"text":"Stop asking! What's the point?!","source_cn":"别再问我了！问那么多有什么用？！","status":"matched","hash_xxh64":"0xAF3659DDA4F5118C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521908002:0":{"text":"You know what happened! That flood wiped out everything! A child that young, there's no way he survived!","source_cn":"你心里难道不清楚吗？洪灾那么严重，被洪水卷走的人根本没...","status":"matched","hash_xxh64":"0x3E80467E1D9E0B8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521908003:1":{"text":"If you can't face reality, that's your problem. Asking me over and over won't help.","source_cn":"你自己接受不了现实，就算一天问我上百遍也没用！","status":"matched","hash_xxh64":"0x0A9E1A7CAA405B37","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521908004:1":{"text":"Besides, it was the <style=\"highlight\">God of Harvest who sent the flood</style>. It was divine wrath!","source_cn":"再说了，带走你儿子的是暴雨，是洪水！那是<style=...","status":"matched","hash_xxh64":"0xE35AD3F241E42DB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521908005:0":{"text":"You want to find your son? Then go ask the God of Harvest yourself! Stop tormenting us!","source_cn":"你要找你儿子，那就去找丰饶神！不要天天跑来这里折磨我们！","status":"matched","hash_xxh64":"0xF18EDA9F4BC4D329","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521908006:0":{"text":"... No... I...","source_cn":"……不，不……我……","status":"matched","hash_xxh64":"0xDA2768C5AD155EBE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521908007:0":{"text":"Vale, that's enough!","source_cn":"瓦勒！别再说了！","status":"matched","hash_xxh64":"0xD552BB2C3D86EC6D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521908008:0":{"text":"I... I've just had enough of this!","source_cn":"我……我实在是被烦得不行了！","status":"matched","hash_xxh64":"0xD188F303991A6535","variant_status":"","male":"","female":"","varian