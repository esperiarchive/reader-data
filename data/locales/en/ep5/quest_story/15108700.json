{"asset_key":"ep5/quest_story_15108700","episode":"ep5","category":"quest_story","story_id":"15108700","schema_version":1,"lang":"en","texts":{"say:3:1510870001:1":{"text":"No! Lygos... my men... What is this?!","source_cn":"不！隆尔……士兵们……怎么会这样？！","status":"matched","hash_xxh64":"0x9ADC5842534DA6D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510870002:0":{"text":"The Hunting Goddess didn't keep her word. She's been lying to you from the very start.","source_cn":"狩猎神没有遵守诺言。从一开始，她就是在骗你。","status":"matched","hash_xxh64":"0x10FDE14856BC11EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510870003:0":{"text":"The soldiers need their general. With you there, they'll still have hope.","source_cn":"你必须回去指挥战局。有你在，呼临士兵才有存活的希望。","status":"matched","hash_xxh64":"0x8F5EAC5572808400","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510870004:0":{"text":"How do I know everything you showed me isn't just a magical illusion?","source_cn":"你……怎么证明刚才的一切不是用魔法构建的幻术？","status":"matched","hash_xxh64":"0x8F86952682B20B48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510870005:0":{"text":"I don't need to prove anything. If you doubt my magic, then go to the battlefield yourself.","source_cn":"我不必证明。如果你不愿意相信我的魔法，更应该去风沼战场...","status":"matched","hash_xxh64":"0x0D8A1314483D4E6E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510870006:0":{"text":"Even if it's just for the comrades who entrusted you with their lives—what's so wrong about leaving this shrine for a while?","source_cn":"哪怕是为了那些愿意把生命托付给你的战友，暂时离开这座神...","status":"matched","hash_xxh64":"0x22623F0AC768FEB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510870007:0":{"text":"If we've lied to you, you're free to return here anytime.","source_cn":"如果我们欺骗了你，你随时都可以回来。","status":"matched","hash_xxh64":"0x2E158731B55D0312","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510870008:0":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xF9E83B2F94B153A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1510870008":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xF9E83B2F94B153A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510870009:0":{"text":"... You're right.","source_cn":"……我知道。","status":"matched_runtime_gender","hash_xxh64":"0x8B85954A00D571EF","variant_status":"runtime_gender_keys_target_same","male":"... You're right.","female":"... You're right.","variant_male_record_index":"174185","variant_female_record_index":"174186","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510870011:1":{"text":"Show me the way.","source_cn":"带路吧。","status":"matched","hash_xxh64":"0x83A2C697932B979F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510870012:1":{"text":"Take me <style=\"highlight\">to the battlefield</style>.","source_cn":"带我离开这里，<style=highlight>回到战...","status":"matched","hash_xxh64":"0x18BF4EF12FFA6AA4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510870013:0":{"text":"I'm glad you've come to your senses, Perseus.","source_cn":"很高兴你想通了，珀尔修斯。","status":"matched","hash_xxh64":"0xA7984D0737790BB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"Halia needs you more than Gorgonna does.","source_cn":"呼临人比露更需要你","status":"matched_runtime_gender","hash_xxh64":"0xDD0CEF08B3EA5B38","variant_status":"runtime_gender_keys_target_same","male":"Halia needs you more than Gorgonna does.","female":"Halia needs you more than Gorgonna does.","variant_male_record_index":"74842","variant_female_record_index":"74843","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510870010:1":{"text":"Don't say that. I'm not that kind of man!","source_cn":"你把我当什么人了？","status":"matched_runtime_gender","hash_xxh64":"0x0459B28AD7F1145C","variant_status":"runtime_gender_keys_target_same","male":"Don't say that. I'm not that kind of man!","female":"Don't say that. I'm not that kind of man!","variant_male_record_index":"174187","variant_female_record_index":"174188","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"You're abandoning your comrades?","source_cn":"你根本不在乎战友！","status":"matched_runtime_gender","hash_xxh64":"0x72020FCAD8E8D295","variant_status":"runtime_gender_keys_target_same","male":"You're abandoning your comrades?","female":"You're abandoning your comrades?","variant_male_record_index":"74844","variant_female_record_index":"74845","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:珀尔修斯":{"text":"Perseus","source":"珀尔修斯","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":17,"localized_text_count":16,"speaker_count":2}}