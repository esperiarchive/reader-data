{"asset_key":"ep5/quest_story_15219280","episode":"ep5","category":"quest_story","story_id":"15219280","schema_version":1,"lang":"en","texts":{"say:1:1521928001:1":{"text":"Try to stay strong.\nThis place isn't safe. We need to leave quickly.","source_cn":"请振作一点，别再哭了。\\n这里不是很安全，要尽快离开才行。","status":"matched","hash_xxh64":"0xE107A0996A4D7F10","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1521928002:1":{"text":"You're right...","source_cn":"对……你说得对。","status":"matched","hash_xxh64":"0x1D4F6F9DF4B366FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521928003:1":{"text":"Renee, would you like to come to Halia?\n... And stay with Aunt Nanri?","source_cn":"蕾妮，你想不想去呼临城？\\n……和南茜阿姨一起生活。","status":"matched","hash_xxh64":"0x6D4D1AC97A27A8FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521928004:1":{"text":"Huh...","source_cn":"咦……","status":"matched","hash_xxh64":"0xCDD605D1B2399700","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521928005:1":{"text":"Halia... Is it safe there? Is it nice, like Tuttleton was?","source_cn":"呼临城……那里安全吗？像图塔镇一样好吗……？","status":"matched","hash_xxh64":"0x3BE128A20EF138CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521928006:1":{"text":"Maybe not like Tuttleton... but you'll be with me. You won't have to run or hide anymore.","source_cn":"可能没有图塔镇那么好……但是你可以和我在一起，不用再颠...","status":"matched","hash_xxh64":"0xCE1FFF112180C244","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521928007:1":{"text":"The war is over. The famine too. We'll have a roof over our heads, warm meals...You'll grow up safe...","source_cn":"战争和饥荒都结束了……我们会有房子，会有食物，你可以平...","status":"matched","hash_xxh64":"0x215120C25A7B78F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521928008:1":{"text":"And when you're older... maybe we can return to Tuttleton.","source_cn":"等你长大以后……或许我们就可以再回到图塔镇了。","status":"matched","hash_xxh64":"0x16BA04A951CB2990","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1521928009:1":{"text":"You won't leave me, will you? Not like Mom and Dad?","source_cn":"南茜阿姨，你不会离开我的，不会像爸爸妈妈那样……对吗？","status":"matched","hash_xxh64":"0x3DF8E3C0462EAA17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521928010:1":{"text":"Of course not... I promise.","source_cn":"当然……当然，绝对不会。","status":"matched","hash_xxh64":"0xF8439C9AD5EFC785","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521928011:1":{"text":"Then... then I want to go to Halia! I want to stay with you, Aunt Nanri!","source_cn":"那……那我愿意去呼临城！和南茜阿姨一起！","status":"matched","hash_xxh64":"0xDF3E52A4E2B711F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1521928012:1":{"text":"Alright, alright...","source_cn":"好，好……","status":"matched","hash_xxh64":"0x18C26779FD01D97C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1521928013:1":{"text":"Then I'll take you to <style=\"highlight\">Halia</style>... To our future home.","source_cn":"那我带你<style=highlight>回呼临城</...","status":"matched","hash_xxh64":"0x3460F16C7DFD9962","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1521928014:1":{"text":"Master <style=\"stress\"><player_name></style>, Nanri won't try to end her life again, will she?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x3660A7B15848DE24","variant_status":"runtime_gender_keys_target_same","male":"Master <style=\"stress\"><player_name></style>, Nanri won't try to end her life again, will she?","female":"Master <style=\"stress\"><player_name></style>, Nanri won't try to end her life again, will she?","variant_male_record_index":"185433","variant_female_record_index":"185434","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:18:1521928014":{"text":"Master <style=\"stress\"><player_name></style>, Nanri won't try to end her life again, will she?","source_cn":"<style=stress><player_name></style>大人，南茜应该不会再寻死了，对吗？","status":"matched_runtime_gender","hash_xxh64":"0x3660A7B15848DE24","variant_status":"runtime_gender_keys_target_same","male":"Master <style=\"stress\"><player_name></style>, Nanri won't try to end her life again, will she?","female":"Master <style=\"stress\"><player_name></style>, Nanri won't try to end her life again, will she?","variant_male_record_index":"185433","variant_female_record_index":"185434","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1521928015:1":{"text":"That's good to hear...","source_cn":"那真是太好了……","status":"matched_runtime_gender","hash_xxh64":"0xEAD9560035169BCE","variant_status":"runtime_gender_keys_target_same","male":"That's good to hear...","female":"That's good to hear...","variant_male_record_index":"185435","variant_female_record_index":"185436","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1521928016:0":{"text":"It started out so tragic... but I'm glad it ended this way.","source_cn":"虽然是由一个悲伤的故事开头……但我喜欢这个结尾。","status":"matched_runtime_gender","hash_xxh64":"0xBD86029260E67DBC","variant_status":"runtime_gender_keys_target_same","male":"It started out so tragic... but I'm glad it ended this way.","female":"It started out so tragic... but I'm glad it ended this way.","variant_male_record_index":"185437","variant_female_record_index":"185438","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:0:1":{"text":"You can see it, can't you?","source_cn":"显而易见","status":"matched_runtime_ge