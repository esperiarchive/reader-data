{"asset_key":"ep5/quest_story_15213340","episode":"ep5","category":"quest_story","story_id":"15213340","schema_version":1,"lang":"en","texts":{"say:1:1521334001:0":{"text":"It's you...","source_cn":"是你……","status":"matched_runtime_gender","hash_xxh64":"0xEAD6CFC96E34C0A2","variant_status":"runtime_gender_keys_target_same","male":"It's you...","female":"It's you...","variant_male_record_index":"273970","variant_female_record_index":"273971","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1521334002:0":{"text":"Did you... come here on your own... or is this Fufu's idea?","source_cn":"你……你是来看我的……还是芙……她让你来的？","status":"matched_runtime_gender","hash_xxh64":"0xCCB35266E943AF98","variant_status":"runtime_gender_keys_target_same","male":"Did you... come here on your own... or is this Fufu's idea?","female":"Did you... come here on your own... or is this Fufu's idea?","variant_male_record_index":"184961","variant_female_record_index":"184962","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1521334002":{"text":"Did you... come here on your own... or is this Fufu's idea?","source_cn":"你……你是来看我的……还是芙……她让你来的？","status":"matched_runtime_gender","hash_xxh64":"0xCCB35266E943AF98","variant_status":"runtime_gender_keys_target_same","male":"Did you... come here on your own... or is this Fufu's idea?","female":"Did you... come here on your own... or is this Fufu's idea?","variant_male_record_index":"184961","variant_female_record_index":"184962","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521334003:0":{"text":"Of... course... She means everything to me...","source_cn":"当……当然，她是我最重要的人……","status":"matched_runtime_gender","hash_xxh64":"0xAA456798C96975B6","variant_status":"runtime_gender_keys_target_same","male":"Of... course... She means everything to me...","female":"Of... course... She means everything to me...","variant_male_record_index":"184963","variant_female_record_index":"184964","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521334004:0":{"text":"Fufu... she joined the war too, didn't she? Is she... hurt?","source_cn":"芙……她参加战争了吗？有没有……受伤？","status":"matched_runtime_gender","hash_xxh64":"0xB54B876A2F846529","variant_status":"runtime_gender_keys_target_same","male":"Fufu... she joined the war too, didn't she? Is she... hurt?","female":"Fufu... she joined the war too, didn't she? Is she... hurt?","variant_male_record_index":"184965","variant_female_record_index":"184966","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521334005:0":{"text":"She's safe.","source_cn":"她一切都很好。","status":"matched","hash_xxh64":"0xCEDE731E7098FFCC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521334006:0":{"text":"That's... good. Just hearing that makes me feel a little better...","source_cn":"是吗……听你们这么说，我都感觉好多了……","status":"matched","hash_xxh64":"0xE5C886445837D0F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1521334006":{"text":"That's... good. Just hearing that makes me feel a little better...","source_cn":"是吗……听你们这么说，我都感觉好多了……","status":"matched","hash_xxh64":"0xE5C886445837D0F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1521334007:1":{"text":"I want to... but I doubt medical treatment would do any good...","source_cn":"我也想……可是治疗也……也不一定能好起来……","status":"matched","hash_xxh64":"0x8D1BE2B53AFDB9CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521334008:0":{"text":"And the hatred between Halia and the Wildborn... I can't do anything about that...","source_cn":"而且呼临人和雅库伯尔人的……仇恨……不是我能抵抗的……","status":"matched","hash_xxh64":"0x434477FCE89720CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521334009:0":{"text":"Not even the goddess could... right?","source_cn":"连……连神明都无法违抗，不是吗……","status":"matched","hash_xxh64":"0xB4E7C1FA930C42F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1521334009":{"text":"Not even the goddess could... right?","source_cn":"连……连神明都无法违抗，不是吗……","status":"matched","hash_xxh64":"0xB4E7C1FA930C42F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1521334010:0":{"text":"Fufu is worried about you. She wants to come see you herself.","source_cn":"芙很担心你，还想亲自过来见你。","status":"matched","hash_xxh64":"0x7D03D80FC77AA6AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1521334011:0":{"text":"She doesn't care if her father cuts her off. She just wants to know you're okay.","source_cn":"就算她阿爹要和她断绝关系，她也想知道你的消息。","status":"matched","hash_xxh64":"0x2B2BDC023EF553BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1521334012:0":{"text":"So come on. Try for her.","source_cn":"你应该也为她努力一次。","status":"matched","hash_xxh64":"0x2054918EDE41397B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1521334013:0":{"text":"Fufu...","source_cn":"芙……<key:dialog1>","status":"matched","hash_xxh64":"0xA6BA6C977D997FE4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1521334014:0":{"text":"I... I understand...","source_cn":"我……我知道了……<key:dialog3>","status":"matched","hash_xxh64":"0xB1D84626E962FD3B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1521334015:1":{"text":"I want to get better... I want to see her again.","source_cn":"我一定要好起来……去见她。","status":"matched","hash_xxh64":"0x667CB8727A1CABC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1521334016:0":{"text":"Thank goodness, Marco. You've finally come around.","source_cn":"太好了，马尔科，你总算想通了。","status":"matched","hash_xxh64":"0x3D96D9552762ACB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1521334017:0":{"text":"I'll get everything ready for your treatment.","source_cn":"我立刻着手为你准备治疗需要的东西。","status":"matched","hash_xxh64":"0x6AD622A044E1BCA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1521334018:0":{"text":"Oh right, could you help gather some <style=\"highlight\">phantoleaves</style> and <style=\"highlight\">swamp frog</style> to make <style=\"highlight\">anesthetics</style>? We're short on those.","source_cn":"对了，能否请你们帮忙采集一些<style=highli...","status":"matched","hash_xxh64":"0x9AE90A3CC64FC4AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1521334019:0":{"text":"Got it.","source_cn":"好。<key:dialog13>","status":"matched","hash_xxh64":"0x617DB6D04D87898E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:0:1":{"text":"But Fufu's trying, for your sake.","source_cn":"但是芙愿意为你抗住压力","status":"matched_runtime_gender","hash_xxh64":"0x131CE5C0BB1DD17C","variant_status":"runtime_gender_keys_target_same","male":"But Fufu's trying, for your sake.","female":"But Fufu's trying, for your sake.","variant_male_record_index":"78525","variant_female_record_index":"78526","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:1:2":{"text":"You worry too much.","source_cn":"神明才顾虑那么多，你不用","status":"matched_runtime_gender","hash_xxh64":"0xC4C8DDA1735072B1","variant_status":"runtime_gender_keys_target_same","male":"You worry too much.","female":"You worry too much.","variant_male_record_index":"78527","variant_female_record_index":"78528","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:2:3":{"text":"War's over. What's to fear?","source_cn":"战争都结束了，怕什么？","status":"matched_runtime_gender","hash_xxh64":"0xE19C6C801CE0DBDB","variant_status":"runtime_gender_keys_target_same","male":"War's over. What's to fear?","female":"War's over. What's to fear?","variant_male_record_index":"78529","variant_female_record_index":"78530","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"She'd hate to see you like this.","source_cn":"她肯定不想看到你现在这样","status":"matched_runtime_gender","hash_xxh64":"0xC196A2F84C0C7BE3","variant_status":"runtime_gender_keys_target_same","male":"She'd hate to see you like this.","female":"She'd hate to see you like this.","variant_male_record_index":"78521","variant_female_record_index":"78522","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"Let us help you, for her sake.","source_cn":"为了她，接受治疗吧","status":"matched_runtime_gender","hash_xxh64":"0x6F257BBC1DE74E83","variant_status":"runtime_gender_keys_target_same","male":"Let us help you, for her sake.","female":"Let us help you, for her sake.","variant_male_record_index":"78523","variant_female_record_index":"78524","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"Do you still want to see her?","source_cn":"你还想再见她吗？","status":"matched_runtime_gender","hash_xxh64":"0x558565FB164AE27D","variant_status":"runtime_gender_keys_target_same","male":"Do you still want to see her?","female":"Do you still want to see her?","variant_male_record_index":"78517","variant_female_record_index":"78518","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"She's worried about you.","source_cn":"她很担心你","status":"matched_runtime_gender","hash_xxh64":"0xF22CC029AA5A9B0B","variant_status":"runtime_gender_keys_target_same","male":"She's worried about you.","female":"She's worried about you.","variant_male_record_index":"78519","variant_female_record_index":"78520","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:马尔科":{"text":"Marco","source":"马尔科","status":"matched_dialogue_flow"},"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"},"speaker:军医":{"text":"Healer","source":"军医","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":30,"localized_text_count":29,"speaker_count":3}}