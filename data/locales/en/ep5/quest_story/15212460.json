{"asset_key":"ep5/quest_story_15212460","episode":"ep5","category":"quest_story","story_id":"15212460","schema_version":1,"lang":"en","texts":{"say:2:1521246001:0":{"text":"Not bad, Bel.","source_cn":"看来你的战利品不少，巴。","status":"matched","hash_xxh64":"0xEEFAE54552AC03D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521246002:0":{"text":"Of course. Just look behind me. Mountains of beast carcasses. No one even comes close.","source_cn":"当然。看看我身后堆成山的野兽尸体，谁能比我更多？","status":"matched","hash_xxh64":"0x1E8F983E99D8D0DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521246003:0":{"text":"Pretty sure I'm today's top hunter!","source_cn":"不用想，今天的胜者肯定是我！","status":"matched","hash_xxh64":"0x9DBF4F0356B9BD74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521246004:0":{"text":"Hold your horses. The winner hasn't been named yet.","source_cn":"结果还没宣布，你高兴得太早了。","status":"matched","hash_xxh64":"0x6E6944BD8CC7164E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521246005:0":{"text":"Why don't you take a good look around? Solt's haul is just as big as yours—and unlike you, he didn't sabotage his teammates. You'll be penalized for that.","source_cn":"也好好看看别人的成果，索斯的猎物堆得和你一样高。再想想...","status":"matched","hash_xxh64":"0x4A4BD42FD1C5A257","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521246006:1":{"text":"Tch. Fine, do what you want. It won't change anything.","source_cn":"哼，你要算就算吧，算了又能怎么样？","status":"matched","hash_xxh64":"0xE3D300A5D7234C70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521246007:1":{"text":"Just wait. The win is still mine!","source_cn":"等着瞧吧，我肯定会赢的！","status":"matched","hash_xxh64":"0x0AEAAE0EA01AE7EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:狩猎队长森绒":{"text":"Captain Tuft","source":"狩猎队长森绒","status":"matched_dialogue_flow"},"speaker:巴":{"text":"Bel","source":"巴","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}}