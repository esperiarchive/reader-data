{"asset_key":"ep5/quest_story_15107240","episode":"ep5","category":"quest_story","story_id":"15107240","schema_version":1,"lang":"en","texts":{"say:2:1510724001:0":{"text":"Please, I'm begging you, spare me! My... my little brother is waiting for me to come home!","source_cn":"求求你们放过我！我、我弟弟还在等我回家！","status":"matched","hash_xxh64":"0x127F056D94FBBD5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510724002:0":{"text":"I see. So start talking.","source_cn":"我知道，所以老实交代。","status":"matched","hash_xxh64":"0x87FA4BA13BB3B0B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510724003:0":{"text":"Where is Perseus' army? Tell me everything you know.","source_cn":"珀尔修斯率领的军队呢？把你知道的情报说出来。","status":"matched","hash_xxh64":"0x08B11E8A9F2AFCB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510724004:0":{"text":"I don't know where they are! But I swear, I'm not... not here to ambush anyone.","source_cn":"——我不知道！但是我保证，没有……没有埋伏！","status":"matched","hash_xxh64":"0xC3C4D68EBB8A143D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510724005:0":{"text":"I rushed all the way here... only to find the general and everyone else had already left. No one waited for me.","source_cn":"我好不容易赶到这……发现统帅和其他人都走了，根本没人等我。","status":"matched","hash_xxh64":"0xD18AA7D6A3CDBB58","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510724006:0":{"text":"Why did you split from them? What's the plan?","source_cn":"为什么和他们分头行动？这是什么计谋？","status":"matched","hash_xxh64":"0xBE344C02F96A3D8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510724007:0":{"text":"...","source_cn":"…………<key:dialog22>","status":"matched","hash_xxh64":"0xB3935669DF8D8741","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510724008:1":{"text":"Then get ready to sleep at the bottom of the rift.","source_cn":"准备去塔欧妥斯深壑下长眠吧。","status":"matched","hash_xxh64":"0x67F886A830324A7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510724009:0":{"text":"Wait, wait! I'll talk! I'll talk!","source_cn":"——等，等等！我说！我说！","status":"matched","hash_xxh64":"0xDCC07AE6DBE8DA27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510724010:0":{"text":"I...","source_cn":"我……<key:dialog53>","status":"matched","hash_xxh64":"0x6301062770487383","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510724011:0":{"text":"... I'm afraid of heights...","source_cn":"……我恐高……","status":"matched","hash_xxh64":"0x7D5CA370BAB9638A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510724012:0":{"text":"A member of Perseus' elite squad is afraid of heights? Who do you think you're fooling?!","source_cn":"珀尔修斯率领精锐士兵居然恐高——你想骗谁？！","status":"matched","hash_xxh64":"0x2F1EE81804AA93F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510724013:0":{"text":"I... I'm not lying!","source_cn":"我、我没撒谎！","status":"matched","hash_xxh64":"0x363ED46C97308986","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510724014:1":{"text":"General Perseus didn't tell us we had to <style=\"highlight\">cross the Taothos Rift</style> until the very last minute... This is the Taothos Rift we are talking about! One wrong move and you fall to the bottom and get smashed to pieces!","source_cn":"珀尔修斯统帅直到临行前最后一刻才通知要<style=h...","status":"matched","hash_xxh64":"0xCCC5C9011ED75A4B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1510724015:0":{"text":"I didn't want my little brother to think I was a coward, so I had to follow them...","source_cn":"我不想让弟弟觉得自己是懦夫，只能跟过来……","status":"matched","hash_xxh64":"0xC874022AC27D56EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:17:1510724017":{"text":"Talk.","source_cn":"说。","status":"matched","hash_xxh64":"0x0CFAD8E36A99947C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510724016:0":{"text":"Uhh...","source_cn":"这……<key:dialog51>","status":"matched_runtime_gender","hash_xxh64":"0x71D71FA9AC0FBE91","variant_status":"runtime_gender_keys_target_same","male":"Uhh...","female":"Uhh...","variant_male_record_index":"181586","variant_female_record_index":"181587","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510724017:0":{"text":"Talk.","source_cn":"说。","status":"matched","hash_xxh64":"0x0CFAD8E36A99947C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1510724018:0":{"text":"Wait... I'll talk, don't kill me! They used a <style=\"highlight\">rope</style> to slide across! I don't remember the specifics. General Perseus explained it to us, but I was too zoned out!","source_cn":"——我说、我说！他们是用<style=highligh...","status":"matched","hash_xxh64":"0x9DF1A1EAD8012A2C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1510724019:0":{"text":"My mind went completely blank the moment I heard the word \"rift\"!","source_cn":"光是听到深壑两个字，大脑就一片空白了！","status":"matched","hash_xxh64":"0xBEF8C721F685B9E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1510724020:0":{"text":"That doesn't make sense. He's clearly trying to trick us!","source_cn":"这不合理。这懦夫分明是想欺骗我们！","status":"matched_runtime_gender","hash_xxh64":"0xBBDB13A1E3B6AB86","variant_status":"runtime_gender_keys_target_same","male":"That doesn't make sense. He's clearly trying to trick us!","female":"That doesn't make sense. He's clearly trying to trick us!","variant_male_record_index":"181591","variant_female_record_index":"181592","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:23:1510724021":{"text":"How should we deal with this one?","source_cn":"……这个人，怎么处置？","status":"matched_runtime_gender","hash_xxh64":"0x4F8FAB959F5FA1B5","variant_status":"runtime_gender_keys_target_same","male":"How should we deal with this one?","female":"How should we deal with this one?","variant_male_record_index":"181593","variant_female_record_index":"181594","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1510724021:0":{"text":"How should we deal with this one?","source_cn":"……这个人，怎么处置？","status":"matched_runtime_gender","hash_xxh64":"0x4F8FAB959F5FA1B5","variant_status":"runtime_gender_keys_target_same","male":"How should we deal with this one?","female":"How should we deal with this one?","variant_male_record_index":"181593","variant_female_record_index":"181594","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:25:1510724022":{"text":"Too bad.","source_cn":"可惜。","status":"matched_runtime_gender","hash_xxh64":"0x39B544585965FB9C","variant_status":"runtime_gender_keys_target_same","male":"Too bad.","female":"Too bad.","variant_male_record_index":"181595","variant_female_record_index":"181596","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1510724022:1":{"text":"Too bad.","source_cn":"可惜。","status":"matched_runtime_gender","hash_xxh64":"0x39B544585965FB9C","variant_status":"runtime_gender_keys_target_same","male":"Too bad.","female":"Too bad.","variant_male_record_index":"181595","variant_female_record_index":"181596","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1510724025:0":{"text":"Thank you... Thank you for sparing my life! I... I won't tell anyone I saw you here.","source_cn":"谢谢……谢谢你们饶我一命！我……我不会把见到你们的事透...","status":"matched","hash_xxh64":"0xC96B6C4D184E4D9F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:0:1":{"text":"Free him if he shuts his trap.","source_cn":"留着他也没用","status":"matched_runtime_gender","hash_xxh64":"0x0B5C095F75A2AE50","variant_status":"runtime_gender_keys_target_same","male":"Free him if he shuts his trap.","female":"Free him if he shuts his trap.","variant_male_record_index":"77178","variant_female_record_index":"77179","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1510724023:0":{"text":"Fine.","source_cn":"行。","status":"matched_runtime_gender","hash_xxh64":"0xF83EBFF8BCB2C947","variant_status":"runtime_gender_keys_target_same","male":"Fine.","female":"Fine.","variant_male_record_index":"181597","variant_female_record_index":"181598","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:1:2":{"text":"Let him go.","source_cn":"放了吧","status":"matched_runtime_gender","hash_xxh64":"0x9BB7751748412159","variant_status":"runtime_gender_keys_target_same","male":"Let him go.","female":"Let him go.","variant_male_record_index":"77180","variant_female_record_index":"77181","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1510724024:0":{"text":"... Good point.","source_cn":"……不错。","status":"matched_runtime_gender","hash_xxh64":"0x9711244386A480A9","variant_status":"runtime_gender_keys_target_same","male":"... Good point.","female":"... Good point.","variant_male_record_index":"181599","variant_female_record_index":"181600","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:2:3":{"text":"No need to turn a coward into a martyr.","source_cn":"没必要让懦夫变成烈士","status":"matched_runtime_gender","hash_xxh64":"0x923EE412DAD06654","variant_status":"runtime_gender_keys_target_same","male":"No need to turn a coward into a martyr.","female":"No need to turn a coward into a martyr.","variant_male_record_index":"77182","variant_female_record_index":"77183","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:23:0:1":{"text":"There are no other clues besides the rope.","source_cn":"除了绳索，这里没有其他线索","status":"matched_runtime_gender","hash_xxh64":"0x85CF6CB4F01AF506","variant_status":"runtime_gender_keys_target_same","male":"There are no other clues besides the rope.","female":"There are no other clues besides the rope.","variant_male_record_index":"77174","variant_female_record_index":"77175","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cho