{"asset_key":"ep5/quest_story_15216220","episode":"ep5","category":"quest_story","story_id":"15216220","schema_version":1,"lang":"en","texts":{"say:1:1521622001:0":{"text":"We're here.","source_cn":"我们到了。图塔镇。","status":"matched","hash_xxh64":"0xAEC21E3F1F8B9F94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521622002:0":{"text":"I can't believe Tuttleton's become like this...","source_cn":"图塔镇……居然变成了这样……","status":"matched","hash_xxh64":"0x8073811C191D39B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521622003:0":{"text":"Why...?\nGod... why would you do this to your own people?!","source_cn":"为什么……为什么……\\n神啊，您为什么要这样对待您的信...","status":"matched","hash_xxh64":"0x87D1CB554B43EF79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521622004:0":{"text":"My parents, my home... all I knew... gone...","source_cn":"我老爹老娘……我的家……我的朋友们……全都没了！！","status":"matched","hash_xxh64":"0xA16FED1A0792D7CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521622005:0":{"text":"Warner stares at the ruins of Tuttleton, his face buried in his hands as he sobs.","source_cn":"维尔纳面对着图塔镇的废墟，掩面痛哭起来。","status":"matched","hash_xxh64":"0x859AB3248700804A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index