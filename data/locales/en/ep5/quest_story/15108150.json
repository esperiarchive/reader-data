{"asset_key":"ep5/quest_story_15108150","episode":"ep5","category":"quest_story","story_id":"15108150","schema_version":1,"lang":"en","texts":{"say:2:1510815001:0":{"text":"Those Wildborn... they've been <style=\"highlight\">blessed by the Hunting Goddess</style>! They've got unimaginable power!","source_cn":"那、那些兽人……他们得到了<style=highlig...","status":"matched","hash_xxh64":"0xB3C723065A1642D1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510815002:0":{"text":"Esteemed mages... Lady Merlin, please help us!","source_cn":"几位魔法师大人……梅林女士！求你们救救我们！","status":"matched","hash_xxh64":"0xA68857A8B9256DFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1510815002":{"text":"Esteemed mages... Lady Merlin, please help us!","source_cn":"几位魔法师大人……梅林女士！求你们救救我们！","status":"matched","hash_xxh64":"0xA68857A8B9256DFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510815003:0":{"text":"What are you standing around for?! Grab your weapon and fight! Those savage Wildborn are tearing through the front!","source_cn":"你在这里做什么？！快拿起武器去战斗！那群野蛮的兽人要冲...","status":"matched","hash_xxh64":"0x9CBCE8E85664B41D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510815004:0":{"text":"Lieutenant, wait! These mages might be able to save our comrades!","source_cn":"副将大人，这些人是魔法师，或许有办法救咱们的战友！","status":"matched","hash_xxh64":"0x1605A4D3655950A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510815005:0":{"text":"Mages? Don't make me laugh. They're the ones who brought the flood!","source_cn":"——狗屁魔法师！他们是引发洪水的罪魁祸首！","status":"matched","hash_xxh64":"0x57BCB425D7513235","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1510815005":{"text":"Mages? Don't make me laugh. They're the ones who brought the flood!","source_cn":"——狗屁魔法师！他们是引发洪水的罪魁祸首！","status":"matched","hash_xxh64":"0x57BCB425D7513235","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510815007:0":{"text":"Soldiers, listen well! These spell-slingers are in league with the Wildborn!","source_cn":"士兵，听令！这些人是雅库伯尔的走狗，呼临的敌人！","status":"matched","hash_xxh64":"0x62C59D490109C743","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510815008:0":{"text":"Surround them! Cut off their heads! Let them taste—","source_cn":"包围他们，割下他们的头！叫他们也尝尝——","status":"matched","hash_xxh64":"0x7EF235665F468F72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510815009:0":{"text":"Watch out!","source_cn":"——小心！","status":"matched","hash_xxh64":"0x150F39BFE98D0367","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:16:1510815010:0":{"text":"An arrow flies at you—Morgan swings his scythe and splits it in two.","source_cn":"一支利箭朝你们飞来，摩根挥动镰刀，将其劈成两截","status":"matched","hash_xxh64":"0x7FA5AB907977E8A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510815011:0":{"text":"Tch. It missed?","source_cn":"居然没射中？哼！","status":"matched","hash_xxh64":"0x306C9AAB8985E5AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510815012:0":{"text":"You're cornered now. Offer your blood to the Wild Moon!","source_cn":"你们无处可逃，将鲜血献给雅库伯尔之月吧！！","status":"matched","hash_xxh64":"0x0BD09F62B9198A9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"We didn't cause the flood!","source_cn":"洪水不是我们引来的！","status":"matched_runtime_gender","hash_xxh64":"0xD36028D79D89F2CD","variant_status":"runtime_gender_keys_target_same","male":"We didn't cause the flood!","female":"We didn't cause the flood!","variant_male_record_index":"75150","variant_female_record_index":"75151","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9