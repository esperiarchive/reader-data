{"asset_key":"ep5/quest_story_15108600","episode":"ep5","category":"quest_story","story_id":"15108600","schema_version":1,"lang":"en","texts":{"say:1:1510860001:1":{"text":"Gorgonna... I feel like I've forgotten something. Something important.","source_cn":"露，我好像忘记了什么事……是一件很重要的事。","status":"matched","hash_xxh64":"0x1FB6A99355DF4A59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1510860002:1":{"text":"More important than us, together at last?","source_cn":"还有什么事比我们在一起更重要呢？","status":"matched","hash_xxh64":"0x9E7D992EC24AA758","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510860003:1":{"text":"No... it's there, just at the edge of—","source_cn":"不……我明明记得……","status":"matched","hash_xxh64":"0x72EF0067748539A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510860004:1":{"text":"The battlefield! That's right! The war between the Halians and the Wildborn isn't over. And... the Hunting Goddess, she—","source_cn":"啊，战场！对了！呼临和雅库伯尔的战争还没结束，狩猎神也...","status":"matched","hash_xxh64":"0x39C196B75363331B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510860005:1":{"text":"You're overthinking again. Perseus, you're drunk. Those matters were settled long ago.","source_cn":"珀尔修斯，你喝醉了。那些事情早都已经解决了。","status":"matched","hash_xxh64":"0xD543B8D5292BEF25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510860006:1":{"text":"Settled?","source_cn":"解决了？","status":"matched","hash_xxh64":"0x4DFA617E4201DB14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510860007:1":{"text":"Yes. Lady Azora gave her word. <style=\"highlight\">No troops will march on Halia.</style> In fact, she's ordered the Wildborn to share their food to help Halians survive the famine.","source_cn":"是啊。奥法迦大人已经答应<style=highligh...","status":"matched","hash_xxh64":"0x1FDC2A0A5112E5BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510860008:1":{"text":"It's done. The war is over. You've earned your peace, with me.","source_cn":"一切都过去了，现在，你只需要留在这里陪我。","status":"matched","hash_xxh64":"0x5E8EE1F6015C7773","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510860009:1":{"text":"How is that possible? Since when has the Hunting Goddess been so kind?","source_cn":"怎么可能……狩猎神会这么好心？","status":"matched","hash_xxh64":"0xD39255DD55FB7E3E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510860010:1":{"text":"I offered my life to serve her. This is my reward.","source_cn":"为了侍奉狩猎神，我献出了自己的生命，这是她对我的奖赏。","status":"matched","hash_xxh64":"0x31D63441DC6CD5DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510860011:1":{"text":"Gorgonna, you...","source_cn":"露，你……","status":"matched","hash_xxh64":"0xE295B18E9DC65856","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510860012:1":{"text":"You don't believe me?","source_cn":"你不信我的话？","status":"matched","hash_xxh64":"0x142C97CB83BBDF9A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510860013:1":{"text":"Here, drink. You're too tense. <style=\"highlight\">I swear to you</style>, Lady Azora would never harm humans.","source_cn":"再喝一杯吧，你太紧张了。狩猎神绝对不会伤害人类，<st...","status":"matched","hash_xxh64":"0x59D99CE06FE5A709","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510860014:1":{"text":"Gorgonna...\nAlright. I trust you.","source_cn":"露……\\n好……我相信你。","status":"matched","hash_xxh64":"0x8FAB93A12E3739E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510860015:1":{"text":"There. That's better. Just trust me.","source_cn":"没错，相信我。","status":"matched","hash_xxh64":"0x586B03D6C6AFC418","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1510860016:1":{"text":"Oh, brilliant. He believed her just like that? Is this love or lunacy?","source_cn":"可笑。这么两句话就相信了，这就是爱情？","status":"matched","hash_xxh64":"0x8CD7214B454F7738","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:18:1510860016":{"text":"Oh, brilliant. He believed her just like that? Is this love or lunacy?","source_cn":"可笑。这么两句话就相信了，这就是爱情？","status":"matched","hash_xxh64":"0x8CD7214B454F7738","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510860017:0":{"text":"He's about one sip away from getting completely wasted. We need to fix that.","source_cn":"他快要喝断片了，我们得让他清醒过来。","status":"matched","hash_xxh64":"0xDC12690465F65F8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:0:1":{"text":"Something's off with Perseus.","source_cn":"珀尔修斯不太对劲","status":"matched_runtime_gender","hash_xxh64":"0x6892FF1A3213271B","variant_status":"runtime_gender_keys_target_same","male":"Something's off with Perseus.","female":"Something's off with Perseus.","variant_male_record_index":"74798","variant_female_record_index":"74799","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1510860018:0":{"text":"Even from here, I can sense magical interference...","source_cn":"虽然离得比较远，但我能感觉到珀尔修斯受到了魔法的影响。","status":"matched","hash_xxh64":"0x90595CA984DA4F86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1510860019:0":{"text":"What if Gorgonna laced the wine with enchantments? We need to stop him from drinking more.","source_cn":"露可能在通过那些酒控制珀尔修斯的神智，他不能再喝了。","status":"matched","hash_xxh64":"0xD9040BF27650B748","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:1:2":{"text":"That wine doesn't sit right.","source_cn":"那些酒有问题","status":"matched_runtime_gender","hash_xxh64":"0x2DC7B2931C8A87B5","variant_status":"runtime_gender_keys_target_same","male":"That wine doesn't sit right.","female":"That wine doesn't sit right.","variant_male_record_index":"74800","variant_female_record_index":"74801","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1510860020:0":{"text":"Even the Hunting Goddess can't bring back the dead. That's the domain of the God of Death.","source_cn":"就算是狩猎神也没法让死人复活，那是死神的权柄。","status":"matched_runtime_gender","hash_xxh64":"0x3F6E0E85E304DB12","variant_status":"runtime_gender_keys_target_same","male":"Even the Hunting Goddess can't bring back the dead. That's the domain of the God of Death.","female":"Even the Hunting Goddess can't bring back the dead. That's the domain of the God of Death.","variant_male_record_index":"174083","variant_female_record_index":"174084","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1510860021:0":{"text":"Merlin's right... Gorgonna never actually died.","source_cn":"梅林说得没错……露根本就没有死。","status":"matched","hash_xxh64":"0x6C6AF4E53D2E4964","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:2:3":{"text":"That Gorgonna... she's the real thing.","source_cn":"那里的露是实体","status":"matched_runtime_gender","hash_xxh64":"0x186C5DA53AA1006F","variant_status":"runtime_gender_keys_target_same","male":"That Gorgonna... she's the real thing.","female":"That Gorgonna... she's the real thing.","variant_male_record_index":"74802","variant_female_record_index":"74803","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1510860022:0":{"text":"<style=\"stress\"><player_name></style>, you once said the Hunting Goddess appears in different forms, even different genders. That's why the Wildborn thought you were their deity when they met you.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x6EE913DA3742AC67","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, you once said the Hunting Goddess appears in different forms, even different genders. That's why the Wildborn thought you were their deity when they met you.","female":"<style=\"stress\"><player_name></style>, you once said the Hunting Goddess appears in different forms, even different genders. That's why the Wildborn thought you were their deity when they met you.","variant_male_record_index":"174086","variant_female_record_index":"174087","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1510860023:0":{"text":"I believe Gorgonna is another <style=\"highlight\">manifestation</style> of the Hunting Goddess.","source_cn":"我想，露就是狩猎神的<style=highlight>...","status":"matched","hash_xxh64":"0x0798A292ED3865D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1510860024:0":{"text":"Hmm. Well, that's easy enough to prove.","source_cn":"眼下想要印证这个猜测也不难。","status":"matched","hash_xxh64":"0xFD35F53E4A4C0A6D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1510860025:0":{"text":"Morgan, return to the shrine entrance. Dispel the invisibility magic. If Gorgonna really is the Hunting Goddess, she'll sense your presence immediately.","source_cn":"摩根，麻烦你回到神殿门口，解除身上的隐匿魔法。如果露真...","status":"matched","hash_xxh64":"0x5FEAC0A605D95C6A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1510860026:0":{"text":"A mere divine emissary, even with all her magical talent, could never detect you from such a distance. Only a true deity would.","source_cn":"区区神使，纵使她再有魔法天赋，也不足以感应到那么远的距...","status":"matched","hash_xxh64":"0x369D2682083E4322","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1510860027:0":{"text":"<style=\"stress\"><player_name></style> and I will remain hidden and observe whether she reacts.","source_cn":"我和<style=stress><player_nam...","status":"matched_runtime_gender","hash_xxh64":"0x51CD9A5FCCB36D3D","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style> and I will remain hidden and observe whether she reacts.","female":"<style=\"stress\"><player_name></style> and I will remain hidden and observe whether she reacts.","variant_male_record_index":"174092","variant_female_record_index":"174093","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1510860028:1":{"text":"... You want me to be bait?","source_cn":"……你让我当诱饵？","status":"matched","hash_xxh64":"0xF6AF6D3864D2303F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1510860029:0":{"text":"I have faith in you.","source_cn":"我相信你的实力。","status":"matched","hash_xxh64":"0x7C90581F75B91E16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1510860030:0":{"text":"The target might be a goddess. You know that, right?","source_cn":"对面可能是神哦？","status":"matched","hash_xxh64":"0x6F1231382EE8EEE8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1510860031:0":{"text":"Certainly.","source_cn":"没错。<key:dialog51>","status":"matched","hash_xxh64":"0x27B69C51DA44DE9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1510860032:1":{"text":"Ha! Well, bring it on. I'll be your dazzling distraction.","source_cn":"好，正合我意。","status":"matched","hash_xxh64":"0x8EB730C0470FEAE1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1510860033:0":{"text":"But you'd better move fast—I'm not in the mood for a heroic last stand today.","source_cn":"尽快把珀尔修斯救出来啊，别让我撑太久。","status":"matched","hash_xxh64":"0xD9F595296F951A37","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:36:1510860034:0":{"text":"Once Morgan departs, you and Merlin hide in a secluded corner.","source_cn":"摩根离开后，你和初代梅林躲在一处隐蔽的角落里，耐心等待着……","status":"matched_runtime_gender","hash_xxh64":"0xA2CD410971BFBCF3","variant_status":"runtime_gender_keys_target_same","male":"Once Morgan departs, you and Merlin hide in a secluded corner.","female":"Once Morgan departs, you and Merlin hide in a secluded corner.","variant_male_record_index":"174100","variant_female_record_index":"174101","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:37:1510860035:0":{"text":"Moments later, a loud crash is heard outside the shrine.","source_cn":"片刻之后，神殿外忽然传来一声巨响","status":"matched","hash_xxh64":"0xD48D4C43AFCA5D06","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1510860036:1":{"text":"... Hm?!","source_cn":"……嗯？<key:dialog2>","status":"matched","hash_xxh64":"0xFEF954671D990439","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1510860037:1":{"text":"Who...?","source_cn":"是谁……","status":"matched","hash_xxh64":"0x95F381FEAF65E158","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1510860038:1":{"text":"Your expression changed, Gorgonna.","source_cn":"你的表情变了，露。","status":"matched","hash_xxh64":"0x1A3C31F6F7038CD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1510860039:1":{"text":"What happened?","source_cn":"出了什么事？","status":"matched","hash_xxh64":"0xBB0CE95626D39DF5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1510860040:1":{"text":"It's nothing. Just a... a pest outside.","source_cn":"没什么。有只虫子在外面扰人。","status":"matched","hash_xxh64":"0x89DC1F8B4022B2C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1510860041:1":{"text":"Wait here for me, Perseus.","source_cn":"在这里等我，珀尔修斯。","status":"matched","hash_xxh64":"0x7EFA4815EFAE3067","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:3:4":{"text":"It's all starting to make sense...","source_cn":"真相逐渐明晰了……","status":"matched_runtime_gender","hash_xxh64":"0x59CAA0CAF9CCE77A","variant_status":"runtime_gender_keys_target_same","male":"It's all starting to make sense...","female":"It's all starting to make sense...","variant_male_record_index":"74804","variant_female_record_index":"74805","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:珀尔修斯":{"text":"Perseus","source":"珀尔修斯","status":"matched_dialogue_flow"},"speaker:露":{"text":"Gorgonna","source":"露","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":47,"localized_text_count":46,"speaker_count":5}}