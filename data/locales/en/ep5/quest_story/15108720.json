{"asset_key":"ep5/quest_story_15108720","episode":"ep5","category":"quest_story","story_id":"15108720","schema_version":1,"lang":"en","texts":{"say:1:1510872001:0":{"text":"Perseus... You promised. You said you'd stay in the shrine. Why did you leave... Why?!","source_cn":"珀尔修斯……你不是答应我会留在神殿里吗？为什么跑出来…...","status":"matched","hash_xxh64":"0x00DED16118CC4F95","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510872002:0":{"text":"I made that promise to Gorgonna. Not you, Azora!","source_cn":"……我答应的是露，不是你，奥法伽！","status":"matched","hash_xxh64":"0xB6BA521A4C88FF3A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510872003:0":{"text":"Gorgonna is my emissary. Her words are mine. When you agreed to her, you agreed to me.","source_cn":"露是我的神使，她的要求即为我的要求！你答应了她，等于答...","status":"matched","hash_xxh64":"0x0AC88806943174AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510872004:0":{"text":"Then you betrayed your emissary! You swore not to wage war, but you went back on that promise. You ordered the Wildborn to attack, and even used divine power to interfere in the war!","source_cn":"但你欺骗了你的神使！你曾许诺过不会出兵，却又违背承诺，...","status":"matched","hash_xxh64":"0xF497181075DA6736","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510872005:0":{"text":"H-how... How do you know that?","source_cn":"你……你怎么知道……！","status":"matched","hash_xxh64":"0x122C499948BCF302","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510872006:0":{"text":"I told him.","source_cn":"我说的。","status":"matched","hash_xxh64":"0x003A0B27D4FC8330","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510872007:0":{"text":"I showed him what's really happening beyond the walls of your shrine. The battlefield is drenched in blood; your blessing made sure of that. He won't just stand by and watch.","source_cn":"奥法迦，我让珀尔修斯见到了真实的战况，在你的神力下，战...","status":"matched","hash_xxh64":"0xB4F59D06E5E50539","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510872008:0":{"text":"Perseus...","source_cn":"珀尔修斯……珀尔修斯！","status":"matched","hash_xxh64":"0xB1EB3A94FB2E143B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510872009:0":{"text":"You actually believe her over me? How could you?!","source_cn":"你居然相信她……你怎么可以相信她！你宁可相信她！也不肯...","status":"matched","hash_xxh64":"0x5325750F3BCB7879","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510872010:1":{"text":"Why should I believe you? You're the goddess of the Wildborn, and I'm a Halian.","source_cn":"我为什么要相信你？你是雅库伯尔信奉的狩猎神，而我是呼临人！","status":"matched","hash_xxh64":"0x79DA6F9598E0040C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510872011:0":{"text":"Besides Gorgonna, there's nothing linking us at all!","source_cn":"除了露，我和你之间没有任何交集！","status":"matched","hash_xxh64":"0xABDBAE7761870DC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510872012:1":{"text":"Nothing... besides Gorgonna...","source_cn":"除了……露……","status":"matched","hash_xxh64":"0xF1F6BB3EE00D2C9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1510872013:0":{"text":"You said <style=\"highlight\">you wouldn't hurt me</style>, but you destroyed my shrine and disturbed my slumber!","source_cn":"……你保证过<style=highlight>不会伤害...","status":"matched","hash_xxh64":"0xDBEC52DD194761FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1510872014:0":{"text":"You said to <style=\"highlight\">cherish the gift I gave you</style>, but you won't even show it to others!","source_cn":"你保证过<style=highlight>会珍惜我送的...","status":"matched","hash_xxh64":"0x6A0159A3CDA382D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510872015:0":{"text":"You promised you'd <style=\"highlight\">recognize me the next time we met</style>...","source_cn":"你保证过<style=highlight>再见面时一定...","status":"matched","hash_xxh64":"0x8474084E1AEF9F2F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510872016:0":{"text":"Perseus, I'm right here. Why won't you recognize me?! <shk>You promised!</shk>","source_cn":"珀尔修斯，我就在你眼前……你为什么认不出我？<shk>...","status":"matched","hash_xxh64":"0x65B1D541925026A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1510872017:1":{"text":"Ah... no...","source_cn":"啊……啊啊啊……","status":"matched","hash_xxh64":"0xA1AF62A63FD8872F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1510872018:1":{"text":"Gorgonna... You really are her!","source_cn":"露……你真的是她！","status":"matched","hash_xxh64":"0x8FC687C3F908A28C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1510872019:1":{"text":"<shk>You've been lying to me all along!</shk>","source_cn":"<shk>你一直在骗我！</shk>","status":"matched","hash_xxh64":"0xAEAEA7CD84ACD7E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1510872020:1":{"text":"So what if I have?! You're mine—my prey alone! <shk>No one's taking you away from me!</shk>","source_cn":"那又怎样！我不在乎！你是我一人的猎物……<shk>谁也...","status":"matched","hash_xxh64":"0x8BB7B8EAB92DD800","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:狩猎神奥法迦":{"text":"Goddess Azora","source":"狩猎神奥法迦","status":"matched_dialogue_flow"},"speaker:珀尔修斯":{"text":"Perseus","source":"珀尔修斯","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":21,"localized_text_count":20,"speaker_count":3}}