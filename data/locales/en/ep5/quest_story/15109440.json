{"asset_key":"ep5/quest_story_15109440","episode":"ep5","category":"quest_story","story_id":"15109440","schema_version":1,"lang":"en","texts":{"say:2:1510944001:0":{"text":"Oboe... my daughter...","source_cn":"……欧布，我的孩子……","status":"matched","hash_xxh64":"0x4D78EB3DD06058DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510944002:0":{"text":"My condolences, Chieftain.","source_cn":"节哀，首领阁下。","status":"matched","hash_xxh64":"0x34856C3F50B39B5B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510944003:1":{"text":"Get out of my sight. The Wildborn's war is no business of yours!","source_cn":"滚远一点。雅库伯尔的战事轮不到你们插手！","status":"matched","hash_xxh64":"0x863F9DB1FBB45C8F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510944004:0":{"text":"This isn't the time for pride.","source_cn":"首领阁下，现在不是逞英雄的时候。","status":"matched","hash_xxh64":"0x7FC569BE12522EC8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510944005:1":{"text":"If you wish to save what's left of the Wildborn, then stop clinging to battle. Lead them away from this slaughter.","source_cn":"若你想保住雅库伯尔，就请不要恋战，带着幸存的战士们撤退吧。","status":"matched","hash_xxh64":"0x341BED2D33268AFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510944006:1":{"text":"The Hunting Goddess has already <style=\"highlight\">fallen</style>. Her power is unraveling and twisting the beasts she summoned. They can no longer tell ally from enemy.","source_cn":"狩猎神已经<style=highlight>神堕</s...","status":"matched","hash_xxh64":"0xC43867DC43AD0292","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510944007:0":{"text":"A god's power... is not something mortals can resist.","source_cn":"神的力量……不是凡人可以抗衡的。","status":"matched","hash_xxh64":"0x337D8CBBA9B8F878","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510944008:1":{"text":"Hmph... mortals...","source_cn":"哼，所有凡人……","status":"matched","hash_xxh64":"0xD083B7F8BE59D4F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510944009:0":{"text":"She took Halia's general! The Herdmaster is our goddess—why... why would she side with them?!","source_cn":"她分明带走了呼临的统帅！兽群之主是雅库伯尔的神明，她为...","status":"matched","hash_xxh64":"0xCBA7413DFA5419E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:12:1510944010:1":{"text":"You explain to Kordan the history between the Hunting Goddess and Perseus.","source_cn":"你与初代梅林解释了狩猎神与珀尔修斯的种种过往","status":"matched_runtime_gender","hash_xxh64":"0x4F2EE3536DD45BAB","variant_status":"runtime_gender_keys_target_same","male":"You explain to Kordan the history between the Hunting Goddess and Perseus.","female":"You explain to Kordan the history between the Hunting Goddess and Perseus.","variant_male_record_index":"175502","variant_female_record_index":"175503","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:1510944011:0":{"text":"And then, you reveal your own identity.","source_cn":"以及，你的真实身份","status":"matched_runtime_gender","hash_xxh64":"0x5C5AB8C3647B6FF4","variant_status":"runtime_gender_keys_target_same","male":"And then, you reveal your own identity.","female":"And then, you reveal your own identity.","variant_male_record_index":"175504","variant_female_record_index":"175505","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:14:1510944012:0":{"text":"Kordan breathes heavily.","source_cn":"戈丹呼吸凝重","status":"matched","hash_xxh64":"0x1B5A7418BE48AB0B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510944013:0":{"text":"How could she turn her back on the faithful Wildborn?! For a Halian...","source_cn":"狩猎神为了呼临人，背弃了忠诚于她的雅库伯尔……","status":"matched","hash_xxh64":"0x1DD4A1C55BF92639","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1510944014:0":{"text":"... Will the Herdmaster never bless the Wildborn again?","source_cn":"兽群之主将不会再庇佑雅库伯尔。是这样吗？","status":"matched","hash_xxh64":"0x93B9ABEA1121DA8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510944015:0":{"text":"That bloodthirsty goddess has fallen. The fact that Wrathwood Grove is spared is already a miracle.","source_cn":"那嗜血的神已经神堕。树怒山谷没有受到波及，已经是万幸。","status":"matched","hash_xxh64":"0x18B7F3B594418E63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510944016:0":{"text":"A fallen goddess...","source_cn":"神堕……","status":"matched","hash_xxh64":"0xE212894F68D60069","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1510944017:0":{"text":"And on a <style=\"highlight\">Blood Moon</style>, no less. A sign of divine descent. We were abandoned by our own deity... and saved by a false god.","source_cn":"雅库伯尔居然会在一个象征神降的<style=highl...","status":"matched_runtime_gender","hash_xxh64":"0x6200FD93BA972D32","variant_status":"runtime_gender_keys_target_differs","male":"And on a <style=\"highlight\">Blood Moon</style>, no less. A sign of divine descent. We were abandoned by our own deity... and saved by a false god.","female":"And on a <style=\"highlight\">Blood Moon</style>, no less. A sign of divine descent. We were abandoned by our own deity... and saved by a false goddess.","variant_male_record_index":"175511","variant_female_record_index":"175512","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1510944018:1":{"text":"... A <style=\"highlight\">disaster</style>.","source_cn":"……<style=highlight>灾难</style>。","status":"matched","hash_xxh64":"0xC82811F173243128","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1510944019:0":{"text":"Chieftain, call for a truce. For your people's sake. Halia's forces are in no shape to fight either.","source_cn":"停战吧，首领阁下。为了你的族人。呼临也已无力再战。","status":"matched","hash_xxh64":"0x9E44117DCFFA6E17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1510944020:0":{"text":"Peace cannot bring back the dead, nor can it erase the scars left by bloodshed. But at the very least... it offers the living a chance to breathe. A glimmer of hope for the Wildborn's future.","source_cn":"和平无法唤回死者的灵魂，无法抚平鲜血酿就的创伤，但至少...","status":"matched","hash_xxh64":"0x3E4B33EDE51A20E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1510944021:0":{"text":"As for the goddess... don't fear her return. The Arcane Council will not let her bring further ruin.","source_cn":"无需担忧堕神重返雅库伯尔，魔法师协会绝不会坐视堕神为世...","status":"matched","hash_xxh64":"0xB91B470A82BCCF60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1510944022:0":{"text":"For the sake of lasting peace... we will eliminate her.","source_cn":"为了更长久的和平，我们必将清除堕神。","status":"matched","hash_xxh64":"0x59F66DB7B1DE0254","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1510944023:0":{"text":"...","source_cn":"……<key:dialog72>","status":"matched","hash_xxh64":"0x64384B0D4CAA194A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1510944024:0":{"text":"You know what to do. Don't send more of our kin to die for nothing.","source_cn":"撤退吧。别让更多族人有来无回。","status":"matched","hash_xxh64":"0xC48B89F52E1C50FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1510944025:0":{"text":"Nazrik... you traitor...","source_cn":"那非……你这叛徒……","status":"matched","hash_xxh64":"0xBF82F408987B8D99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1510944026:0":{"text":"Stick to your pride if you like. I'm sure Death will be thrilled. So many souls walking straight into his arms... where else can he find such a deal?","source_cn":"你可以固执己见，死神一定很高兴。这么多愚蠢的灵魂自己送...","status":"matched","hash_xxh64":"0xECC7D5A1D3BE9EAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1510944027:0":{"text":"Go on, might as well become his follower. He'll greet you with open arms.","source_cn":"干脆去当死神的信徒吧，他保准让你们死得其所。","status":"matched","hash_xxh64":"0x3B2C0B513A39FB46","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1510944028:0":{"text":"Or maybe ask yourself—didn't you lose someone, too?","source_cn":"这场战争里，你没有失去任何人吗？","status":"matched","hash_xxh64":"0x114ABA37FF1B5B6A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1510944029:1":{"text":"... Oboe...","source_cn":"……欧布……","status":"matched","hash_xxh64":"0xFE52EADEFEAC0A8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1510944030:1":{"text":"...","source_cn":"……<key:dialog73>","status":"matched","hash_xxh64":"0xC53B862C884DB593","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1510944031:2":{"text":"Wildborn! Hear my command!","source_cn":"雅库伯尔，听令！","status":"matched","hash_xxh64":"0x3FA38898C4ADF749","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1510944032:1":{"text":"Fall back!","source_cn":"——撤退！","status":"matched","hash_xxh64":"0xC55202D476AD6803","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:戈丹":{"text":"Kordan","source":"戈丹","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"},"speaker:那非":{"text":"Nazrik","source":"那非","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":33,"localized_text_count":32,"speaker_count":5}}