{"asset_key":"ep5/quest_story_15108190","episode":"ep5","category":"quest_story","story_id":"15108190","schema_version":1,"lang":"en","texts":{"say:1:1510819001:0":{"text":"Why did you divide the battlefield?!","source_cn":"你们做了什么？为什么要分割战场？！","status":"matched","hash_xxh64":"0xF87E5D8B0DCE7B7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1510819002:0":{"text":"Withdraw your sorcery, or I'll have you executed!","source_cn":"撤回你们的巫术，否则我以军令处决你们！","status":"matched","hash_xxh64":"0xF9854CB8EE2D4615","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1510819002":{"text":"Withdraw your sorcery, or I'll have you executed!","source_cn":"撤回你们的巫术，否则我以军令处决你们！","status":"matched","hash_xxh64":"0xF9854CB8EE2D4615","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510819003:0":{"text":"Stop acting all righteous! What are you scheming now?!","source_cn":"少装出一副大义凛然的样子！你们又有什么阴谋诡计？！","status":"matched_runtime_gender","hash_xxh64":"0xEE3136B3106233D2","variant_status":"runtime_gender_keys_target_same","male":"Stop acting all righteous! What are you scheming now?!","female":"Stop acting all righteous! What are you scheming now?!","variant_male_record_index":"175231","variant_female_record_index":"175232","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510819004:0":{"text":"Oh, please. Before you go frothing at the mouth again, maybe glance behind you? At the bleeding soldiers your bravado couldn't save?","source_cn":"啊，说这话之前，不如先看看你背后流血的士兵，再看看光墙...","status":"matched","hash_xxh64":"0x0EAFAC9510C9BAE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510819005:1":{"text":"If Merlin hadn't acted, you'd be counting bodies, not barking orders.","source_cn":"要不是梅林，谁能保你手下士兵的命？","status":"matched","hash_xxh64":"0xA020DE5D4AD1A6FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510819006:0":{"text":"You dare—blaspheme the dead—","source_cn":"你这亵渎死者的——","status":"matched","hash_xxh64":"0x190B56B91B30080F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510819007:0":{"text":"Long time no see... <style=\"highlight\">false god</style>.","source_cn":"好久不见……<style=highlight>伪神</...","status":"matched_runtime_gender","hash_xxh64":"0x04467FB78F27EAF1","variant_status":"runtime_gender_keys_target_differs","male":"Long time no see... <style=\"highlight\">false god</style>.","female":"Long time no see... <style=\"highlight\">false goddess</style>.","variant_male_record_index":"175236","variant_female_record_index":"175237","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510819008:0":{"text":"You should have died with the Halians—gutted, fed to wolves. But the Wildborn will praise you for one thing.","source_cn":"你本该被木桩穿刺，万兽噬咬，流尽鲜血而死。但雅库伯尔会...","status":"matched_runtime_gender","hash_xxh64":"0x62AB2E5F2420FBDE","variant_status":"runtime_gender_keys_target_same","male":"You should have died with the Halians—gutted, fed to wolves. But the Wildborn will praise you for one thing.","female":"You should have died with the Halians—gutted, fed to wolves. But the Wildborn will praise you for one thing.","variant_male_record_index":"175238","variant_female_record_index":"175239","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510819009:1":{"text":"—The flood that destroyed Halia!","source_cn":"——毁灭呼临的洪灾！","status":"matched_runtime_gender","hash_xxh64":"0x039BC5B43C9DBB2F","variant_status":"runtime_gender_keys_target_same","male":"—The flood that destroyed Halia!","female":"—The flood that destroyed Halia!","variant_male_record_index":"175240","variant_female_record_index":"175241","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510819010:1":{"text":"Filth, all of you! I should put every last one of you down to bring peace to the countless Halian souls above!","source_cn":"哼，一丘之貉！我该把你们全部杀光，慰藉万千呼临的在天之灵！","status":"matched","hash_xxh64":"0x1DE24C30FC04F97B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1510819011:1":{"text":"Pathetic. You talk like a rusty sword, and you're about as sharp as one too.","source_cn":"可笑，你的脑子还没有骷髅灵光。骷髅甚至没有大脑。","status":"matched","hash_xxh64":"0x75BC40DBA5D46FAA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510819012:1":{"text":"Enough. This isn't the time. We need to move.","source_cn":"……不是谈话的时机，我们先离开。","status":"matched","hash_xxh64":"0x1AA7B82A6EC70E8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1510819013:0":{"text":"I'm not letting you get away!","source_cn":"——你们别想逃！","status":"matched","hash_xxh64":"0xF648EA7562E4BB35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"You're not giving the orders here.","source_cn":"闭嘴，没你说话的份！","status":"matched_runtime_gender","hash_xxh64":"0xB023414DB8C3D378","variant_status":"runtime_gender_keys_target_same","male":"You're not giving the orders here.","female":"You're not giving the orders here.","variant_male_record_index":"75156","variant_female_record_index":"75157","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"That wall's the only thing keeping you alive!","source_cn":"这是为了救你们！","status":"matched_runtime_gender","hash_xxh64":"0xBF70B5ADB6A98D40","variant_status":"runtime_gender_keys_target_same","male":"That wall's the only thing keeping you alive!","female":"That wall's the only thing keeping you alive!","variant_male_record_index":"75158","variant_female_record_index":"75159","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:副将隆尔":{"text":"Lieutenant Lygos","source":"副将隆尔","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:戈丹":{"text":"Kordan","source":"戈丹","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林",