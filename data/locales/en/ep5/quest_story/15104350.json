{"asset_key":"ep5/quest_story_15104350","episode":"ep5","category":"quest_story","story_id":"15104350","schema_version":1,"lang":"en","texts":{"say:2:1510435001:1":{"text":"Lieutenant Lygos, where is Gala? ","source_cn":"隆尔先生，和我们同行的加拉呢？","status":"matched","hash_xxh64":"0x0B099F5202B696F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510435002:1":{"text":"Why are you asking me?","source_cn":"不知道。<key:dialog2>","status":"matched","hash_xxh64":"0x22900BBD0647E29A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510435003:1":{"text":"She should be standing here with you.","source_cn":"但是她应该和你在一起——","status":"matched","hash_xxh64":"0x55BCA474311123E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510435004:1":{"text":"My job is to protect Halia, not babysit some furspawn! Wherever that thing ran off to is not my problem.","source_cn":"我的职责是守护呼临城，不是看管那头外来的野兽！她跑去哪...","status":"matched","hash_xxh64":"0x60BB1A350821FEA1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1510435004":{"text":"My job is to protect Halia, not babysit some furspawn! Wherever that thing ran off to is not my problem.","source_cn":"我的职责是守护呼临城，不是看管那头外来的野兽！她跑去哪里都与我无关。","status":"matched","hash_xxh64":"0x60BB1A350821FEA1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510435005:1":{"text":"Hmph!","source_cn":"哼。<key:dialog1>","status":"matched_runtime_gender","hash_xxh64":"0x714B40E8FD4D74D5","variant_status":"runtime_gender_keys_target_same","male":"Hmph!","female":"Hmph!","variant_male_record_index":"178885","variant_female_record_index":"178886","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510435008:1":{"text":"Enough, Lygos! She's a servant of the Arcane Council. This is a diplomatic matter. Don't let emotions cloud your judgment.","source_cn":"隆尔，够了！她是魔法师协会的仆人，这是外交事件，不可意...","status":"matched","hash_xxh64":"0x2867678FABA5AB55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510435009:1":{"text":"You know where she is. Tell us now.","source_cn":"你知道她的去向，快说。","status":"matched","hash_xxh64":"0x3E67CBF5DC08B5FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510435010:1":{"text":"... No!","source_cn":"……不。<key:dialog2>","status":"matched","hash_xxh64":"0xF9CCC4A6529A9688","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510435011:1":{"text":"I'm not asking. That was an order.","source_cn":"这是命令！","status":"matched","hash_xxh64":"0xBE8A60E1A08BB1C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510435012:1":{"text":"Don't pull rank on me! I know all about your past!","source_cn":"——别用命令压我！我知道你做了什么！","status":"matched","hash_xxh64":"0x3E88EE673272CF42","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510435013:0":{"text":"How long are you gonna keep pitying the Wildborn? They're nothing but stupid savages! How can you stand them?","source_cn":"你要怜悯兽人到什么时候？他们是一群愚蠢的、野蛮的杂种！...","status":"matched","hash_xxh64":"0x337E308100514900","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1510435014:1":{"text":"Shall I let everyone hear your filthy little secret, Perseus? That you, the great general of Halia, <style=\"highlight\">once fell for a female Wildborn</style>?!","source_cn":"你想让我把那么肮脏丑陋的事实说给所有人听吗？你，珀尔修...","status":"matched","hash_xxh64":"0xF4B178205882E177","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:17:1510435014":{"text":"Shall I let everyone hear your filthy little secret, Perseus? That you, the great general of Halia, <style=\"highlight\">once fell for a female Wildborn</style>?!","source_cn":"你想让我把那么肮脏丑陋的事实说给所有人听吗？你，珀尔修斯，我们呼临城的统帅，<style=highlight>曾经和一个女兽人坠入爱河</style>？！","status":"matched","hash_xxh64":"0xF4B178205882E177","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510435015:1":{"text":"See how he hesitates! <style=\"highlight\">That Wildborn trinket still hangs around his neck!</style> Pathetic!","source_cn":"哼，看看他的表情，他甚至到现在都<style=high...","status":"matched","hash_xxh64":"0x8AD9C1489ECF3474","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510435016:0":{"text":"If it weren't for that woman, the Perseus I know would've declared war on the Wildborn by now! Their rich lands would be ours, and Halia wouldn't be in this sorry state!","source_cn":"如果不是因为那个女的，我认识的珀尔修斯早就正式向兽人宣...","status":"matched","hash_xxh64":"0x14DF7912D3FB43DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1510435017:0":{"text":"<style=\"highlight\">Gorgonna</style> did not interfere with my judgment.","source_cn":"<style=highlight>露</style>不...","status":"matched","hash_xxh64":"0x49FBCC48972E95D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1510435018:0":{"text":"Then, why aren't we hitting the Wildborn with everything we've got?! Why constrain our forces to border camps when they're vulnerable right now?!","source_cn":"那为什么不全军出击雅库伯尔？为什么要装模作样，只进攻交...","status":"matched","hash_xxh64":"0x78A1B139209BB623","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1510435019:0":{"text":"Our army could crush the Wildborn tomorrow! The only reason you're stalling is because you can't bear to burn that woman's homeland to the ground!","source_cn":"一旦呼临大军出征，雅库伯尔唾手可得！你拖延踌躇，只是因...","status":"matched","hash_xxh64":"0x2C9A27AB0B6E4C9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1510435020:0":{"text":"You're scared that if we march, that Wildborn wench will never forgive you.","source_cn":"你怕出征之后，那个女兽人再也不会原谅你——","status":"matched","hash_xxh64":"0x55EE93CBBA47BC91","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1510435021:1":{"text":"Lygos! Are you done?! You don't understand the strength of the Wildborn!","source_cn":"隆尔！你不了解雅库伯尔的实力！","status":"matched","hash_xxh64":"0xFCAAC0F8A252EE48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1510435022:1":{"text":"The moment war breaks out, blood will stain the earth from both armies. I don't want to lose a single one of you to a pointless death.","source_cn":"战争一旦全面爆发，双方都会血流成河，我不想看到你们任何...","status":"matched","hash_xxh64":"0xFCCC96CADBA75C95","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1510435023:1":{"text":"We're ready to die for Halia! What about you?!","source_cn":"我们已经准备好为呼临的未来去死了！你呢？！","status":"matched","hash_xxh64":"0x89667364A97DA8DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1510435024:1":{"text":"You won't even sacrifice some woman's feelings for our future!","source_cn":"你连一个女人的感情都不愿意牺牲！","status":"matched","hash_xxh64":"0x1A4CA9E844C020F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1510435025:0":{"text":"She's been sacrificed...","source_cn":"……已经牺牲了。","status":"matched","hash_xxh64":"0xAFDD531C31BABA4A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1510435026:1":{"text":"What?","source_cn":"什么？<key:dialog51>","status":"matched","hash_xxh64":"0x4D7A4211BCD49E8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1510435027:1":{"text":"Gorgonna... She's dead.","source_cn":"露。她死了。","status":"matched","hash_xxh64":"0x1E770F7D5A2C532B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1510435028:1":{"text":"<style=\"highlight\">Her tribe sacrificed her alive to the Hunting God during the last Blood Moon.</style>","source_cn":"<style=highlight>上一个血月时，她已经...","status":"matched_runtime_gender","hash_xxh64":"0xC5850AEFC4EF96C4","variant_status":"runtime_gender_keys_target_differs","male":"<style=\"highlight\">Her tribe sacrificed her alive to the Hunting God during the last Blood Moon.</style>","female":"<style=\"highlight\">Her tribe sacrificed her alive to the Hunting Goddess during the last Blood Moon.</style>","variant_male_record_index":"178911","variant_female_record_index":"178912","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1510435029:0":{"text":"I-I didn't know... You never said anything...","source_cn":"……什么，她、她死了？那你……","status":"matched","hash_xxh64":"0xC0A2DCD470972565","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1510435030:1":{"text":"Remember my words. My hatred for the Wildborn and their Hunting God burns as fierce as yours.","source_cn":"记清楚这点：我对雅库伯尔和狩猎神的恨，不逊于你！","status":"matched_runtime_gender","hash_xxh64":"0xF0AE67BC231FA5F9","variant_status":"runtime_gender_keys_target_differs","male":"Remember my words. My hatred for the Wildborn and their Hunting God burns as fierce as yours.","female":"Remember my words. My hatred for the Wildborn and their Hunting Goddess burns as fierce as yours.","variant_male_record_index":"178914","variant_female_record_index":"178915","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1510435031:0":{"text":"Now, tell me, where is the Wildborn girl?","source_cn":"现在，告诉我，魔法师协会带来的兽人女孩在哪里。","status":"matched","hash_xxh64":"0x6E04C90059F46AA0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1510435032:1":{"text":"Answer me!","source_cn":"——回答！","status":"matched","hash_xxh64":"0xF9901D0F0D7EE955","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1510435033:0":{"text":"She was taken away by a mob of locals...","source_cn":"她……她被一群愤怒的居民带走了……","status":"matched","hash_xxh64":"0xA8D4BA527E296104","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1510435034:0":{"text":"And you just stood by?","source_cn":"而你袖手旁观？","status":"matched","hash_xxh64":"0x39DD89002932BAE8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1510435035:0":{"text":"I...","source_cn":"我……<key:dialog52>","status":"matched","hash_xxh64":"0x48156EE632520323","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1510435036:0":{"text":"We need to go find her right now.","source_cn":"魔法师协会，走。去找人。","status":"matched","hash_xxh64":"0x8B0A1B265349795E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:41:1510435036":{"text":"We need to go find her right now.","source_cn":"魔法师协会，走。去找人。","status":"matched","hash_xxh64":"0x8B0A1B265349795E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1510435037:0":{"text":"We don't have time to talk about this.","source_cn":"我不想谈这个。","status":"matched_runtime_gender","hash_xxh64":"0xAF91F9F6C83F2C79","variant_status":"runtime_gender_keys_target_same","male":"We don't have time to talk about this.","female":"We don't have time to talk about this.","variant_male_record_index":"178922","variant_female_record_index":"178923","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1510435038:0":{"text":"<style=\"highlight\">Let's split up. I'll lead a team to search the east side of the city. You all go to the west side.</style>","source_cn":"<style=highlight>分头行动，我带人去城...","status":"matched","hash_xxh64":"0x9DB49DAC050C4D34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1510435039:0":{"text":"Make haste if you want that girl to live!","source_cn":"要快，如果你们还想让那个女孩活着！","status":"matched","hash_xxh64":"0x50AD131C4DD27A20","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:41:0:1":{"text":"About Gorgonna...","source_cn":"露的事……","status":"matched_runtime_gender","hash_xxh64":"0xEA62CD6C6F80B44B","variant_status":"runtime_gender_keys_target_same","male":"About Gorgonna...","female":"About Gorgonna...","variant_male_record_index":"76326","variant_female_record_index":"76327","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:41:1:2":{"text":"She was sacrificed to me?","source_cn":"露被献祭给了狩猎神？","status":"matched_runtime_gender","hash_xxh64":"0xAE6C936F914575C3","variant_status":"runtime_gender_keys_target_same","male":"She was sacrificed to me?","female":"She was sacrificed to me?","variant_male_record_index":"76328","variant_female_record_index":"76329","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:41:2:3":{"text":"No wonder you hate me.","source_cn":"怪不得你这么恨我","status":"matched_runtime_gender","hash_xxh64":"0x8BBD035A5D68D4FC","variant_status":"runtime_gender_keys_target_same","male":"No wonder you hate me.","female":"No wonder you hate me.","variant_male_record_index":"76330","variant_female_record_index":"76331","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:0:1":{"text":"Perseus was in love with a Wildborn?!","source_cn":"珀尔修斯和雅库伯尔人……坠入爱河？！","status":"matched_runtime_gender","hash_xxh64":"0x45BF0D472233BBA5","variant_status":"runtime_gender_keys_target_same","male":"Perseus was in love with a Wildborn?!","female":"Perseus was in love with a Wildborn?!","variant_male_record_index":"76320","variant_female_record_index":"76321","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:1:2":{"text":"Really?! Tell us more!","source_cn":"哇！太劲爆了，继续说！","status":"matched_runtime_gender","hash_xxh64":"0x2FB8CC62000C2510","variant_status":"runtime_gender_keys_target_same","male":"Really?! Tell us more!","female":"Really?! Tell us more!","variant_male_record_index":"76322","variant_female_record_index":"76323","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:2:3":{"text":"No, this can't be true...","source_cn":"等等，这是什么不得了的八卦？！","status":"matched_runtime_gender","hash_xxh64":"0x41761B63B1051822","variant_status":"runtime_gender_keys_target_same","male":"No, this can't be true...","female":"No, this can't be true...","variant_male_record_index":"76324","variant_female_record_index":"76325","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"Gala wouldn't run off like this.","source_cn":"加拉不会乱跑","status":"matched_runtime_gender","hash_xxh64":"0xB9CB3270733AC0C9","variant_status":"runtime_gender_keys_target_same","male":"Gala wouldn't run off like this.","female":"Gala wouldn't run off like this.","variant_male_record_index":"76314","variant_female_record_index":"76315","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1510435006:1":{"text":"Hmph!","source_cn":"哼。<key:dialog2>","status":"matched_runtime_gender","hash_xxh64":"0x308AC302B9C85E66","variant_status":"runtime_gender_keys_target_same","male":"Hmph!","female":"Hmph!","variant_male_record_index":"178887","variant_female_record_index":"178888","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"You did something, didn't you?!","source_cn":"你一直对她有成见，有你的份","status":"matched_runtime_gender","hash_xxh64":"0x670BD2085E6ABFD4","variant_status":"runtime_gender_keys_target_same","male":"You did something, didn't you?!","female":"You did something, didn't you?!","variant_male_record_index":"76316","variant_female_record_index":"76317","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1510435007:1":{"text":"Go ahead! Try me! My men'll drop you before you even blink!","source_cn":"有本事就来。在你耍花招之前，呼临士兵就会把你按倒！","status":"matched_runtime_gender","hash_xxh64":"0x86F4AA7E37590E46","variant_status":"runtime_gender_keys_target_same","male":"Go ahead! Try me! My men'll drop you before you even blink!","female":"Go ahead! Try me! My men'll drop you before you even blink!","variant_male_record_index":"178889","variant_female_record_index":"178890","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:2:3":{"text":"You want to see how I make people talk?","source_cn":"你想试试我的逼供手段？","status":"matched_runtime_gender","hash_xxh64":"0xD0148C1678CD37E2","variant_status":"runtime_gender_keys_target_same","male":"You want to see how I make people talk?","female":"You want to see how I make people talk?","variant_male_record_index":"76318","variant_female_record_index":"76319","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"},"speaker:副将隆尔":{"text":"Lieutenant Lygos","source":"副将隆尔","status":"matched_dialogue_flow"},"speaker:珀尔修斯":{"text":"Perseus","source":"珀尔修斯","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":52,"localized_text_count":51,"speaker_count":3}}