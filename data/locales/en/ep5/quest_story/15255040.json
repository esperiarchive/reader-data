{"asset_key":"ep5/quest_story_15255040","episode":"ep5","category":"quest_story","story_id":"15255040","schema_version":1,"lang":"en","texts":{"say:1:1525504001:1":{"text":"Mages! Please, tell me you've found a way to help Halia.","source_cn":"两位魔法师，你们找到帮助呼临的方法了吗？","status":"matched","hash_xxh64":"0x9DBAA175F47CA46E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:3::1":{"text":"Magic Circle","source_cn":"魔法阵","status":"matched","hash_xxh64":"0xF64232D463D99007","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1525504002:2":{"text":"This magic circle will stop the rain. Pick a spot and set it up.","source_cn":"这个魔法阵可以驱散呼临城的降雨。找个地方布置吧。","status":"matched","hash_xxh64":"0x4F1F7ABE8FBF06C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1525504003:0":{"text":"You... made this?","source_cn":"这是你研究的？","status":"matched","hash_xxh64":"0xE8624ED12648CC75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1525504004:1":{"text":"Yep. Problem with that?","source_cn":"是我。不满意？","status":"matched","hash_xxh64":"0x8696F8353C64ECB8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1525504005:1":{"text":"Last time you people cast a circle, we got a flood! How do we know this won't be worse?!","source_cn":"你们协会上次用魔法阵引来了洪水！谁知道这次会发生什么？","status":"matched","hash_xxh64":"0xB94AEF7D762DB401","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1525504006:0":{"text":"Stubborn old man. <style=\"stress\"><player_name></style>, you explain it.","source_cn":"顽固的老头。<style=stress><player...","status":"matched_runtime_gender","hash_xxh64":"0xD020FA6B0C5724E3","variant_status":"runtime_gender_keys_target_same","male":"Stubborn old man. <style=\"stress\"><player_name></style>, you explain it.","female":"Stubborn old man. <style=\"stress\"><player_name></style>, you explain it.","variant_male_record_index":"194902","variant_female_record_index":"194903","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1525504006":{"text":"Stubborn old man. <style=\"stress\"><player_name></style>, you explain it.","source_cn":"顽固的老头。<style=stress><player_name></style>，你来解释。","status":"matched_runtime_gender","hash_xxh64":"0xD020FA6B0C5724E3","variant_status":"runtime_gender_keys_target_same","male":"Stubborn old man. <style=\"stress\"><player_name></style>, you explain it.","female":"Stubborn old man. <style=\"stress\"><player_name></style>, you explain it.","variant_male_record_index":"194902","variant_female_record_index":"194903","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1525504007:1":{"text":"But you did cause a flood, which shows just how reckless you were.","source_cn":"但你确实引来了洪水，这已经足够说明你们过于冒进。","status":"matched_runtime_gender","hash_xxh64":"0x71D6C52C156D8837","variant_status":"runtime_gender_keys_target_same","male":"But you did cause a flood, which shows just how reckless you were.","female":"But you did cause a flood, which shows just how reckless you were.","variant_male_record_index":"194904","variant_female_record_index":"194905","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1525504010:1":{"text":"Master Bakis, <style=\"stress\"><player_name></style> would never do anything to hurt us!","source_cn":"比博老师，<style=stress><player_...","status":"matched_runtime_gender","hash_xxh64":"0xD8A617B6835368AC","variant_status":"runtime_gender_keys_target_same","male":"Master Bakis, <style=\"stress\"><player_name></style> would never do anything to hurt us!","female":"Master Bakis, <style=\"stress\"><player_name></style> would never do anything to hurt us!","variant_male_record_index":"194910","variant_female_record_index":"194911","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1525504011:1":{"text":"You've seen him running all over the place trying to help us.","source_cn":"您亲眼见过<male>他</male><female>...","status":"matched_runtime_gender","hash_xxh64":"0x7ECF1B953F486AF2","variant_status":"runtime_gender_keys_target_differs","male":"You've seen him running all over the place trying to help us.","female":"You've seen her running all over the place trying to help us.","variant_male_record_index":"194912","variant_female_record_index":"194913","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1525504012:1":{"text":"But her fellow mage is an evil criminal!","source_cn":"但<male>他</male><female>她</f...","status":"matched_runtime_gender","hash_xxh64":"0x3DBDA871E031F778","variant_status":"runtime_gender_keys_target_same","male":"But her fellow mage is an evil criminal!","female":"But her fellow mage is an evil criminal!","variant_male_record_index":"194914","variant_female_record_index":"194915","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1525504013:1":{"text":"My lord, please! Don't stake Halia's future on someone like Morgan!","source_cn":"殿下，请慎重考虑！呼临城绝不能将未来押在摩根这种人手上！","status":"matched","hash_xxh64":"0xAEAFAF093FE96DA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1525504014:1":{"text":"With scholars like you, it's a miracle Halia has a future at all.","source_cn":"有你这样的学者，呼临城才是真的没有未来。","status":"matched","hash_xxh64":"0x5AD9CEBF4C50A23F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1525504015:1":{"text":"You...!","source_cn":"你……！","status":"matched","hash_xxh64":"0x3160C4971E28D228","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1525504015":{"text":"You...!","source_cn":"你……！","status":"matched","hash_xxh64":"0x3160C4971E28D228","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1525504016:0":{"text":"That's right. I trust <style=\"stress\"><player_name></style>... and Morgan.","source_cn":"没错，我相信<style=stress><player...","status":"matched_runtime_gender","hash_xxh64":"0x4F7FA9B79D7BB919","variant_status":"runtime_gender_keys_target_same","male":"That's right. I trust <style=\"stress\"><player_name></style>... and Morgan.","female":"That's right. I trust <style=\"stress\"><player_name></style>... and Morgan.","variant_male_record_index":"194919","variant_female_record_index":"194920","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1525504018:0":{"text":"Master Bakis... if there's even a chance this stops people from dying, then I have to try it.","source_cn":"比博老师，无论用什么样的方式，只要能够阻止死伤，我……...","status":"matched","hash_xxh64":"0xCC4E4F735A78CF63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1525504019:0":{"text":"It's my responsibility as the Regulus of Halia. If anything goes wrong, I'll take full responsibility.","source_cn":"这是我身为呼临城领主的职责。如果有意外，我来承担一切责任。","status":"matched","hash_xxh64":"0x2EFFDF9066179672","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1525504020:1":{"text":"But my lord... Halia won't survive another disaster.","source_cn":"可是殿下，呼临城已经没有余力再承受一次失败了。","status":"matched","hash_xxh64":"0x7F4281DFD8E8848B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:25:1525504020":{"text":"But my lord... Halia won't survive another disaster.","source_cn":"可是殿下，呼临城已经没有余力再承受一次失败了。","status":"matched","hash_xxh64":"0x7F4281DFD8E8848B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1525504021:1":{"text":"... Fine. Then you will cast it, <style=\"stress\"><player_name></style>.","source_cn":"……那就由你来施法，<style=stress><pl...","status":"matched_runtime_gender","hash_xxh64":"0x7ABC66C8EC9E7092","variant_status":"runtime_gender_keys_target_same","male":"... Fine. Then you will cast it, <style=\"stress\"><player_name></style>.","female":"... Fine. Then you will cast it, <style=\"stress\"><player_name></style>.","variant_male_record_index":"194926","variant_female_record_index":"194927","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1525504022:1":{"text":"And Morgan stays out of every step. I'll be right there watching to make sure of it.","source_cn":"流程中任何一道步骤都禁止摩根插手。我会在一旁监督你。","status":"matched_runtime_gender","hash_xxh64":"0xDEB707F56498A592","variant_status":"runtime_gender_keys_target_same","male":"And Morgan stays out of every step. I'll be right there watching to make sure of it.","female":"And Morgan stays out of every step. I'll be right there watching to make sure of it.","variant_male_record_index":"194928","variant_female_record_index":"194929","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1525504023:1":{"text":"Brilliant. In that case, I'm taking a nap.","source_cn":"完美的提议。我去休息。","status":"matched","hash_xxh64":"0x26CC7976C87B8DBB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:30:1525504023":{"text":"Brilliant. In that case, I'm taking a nap.","source_cn":"完美的提议。我去休息。","status":"matched","hash_xxh64":"0x26CC7976C87B8DBB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1525504025:0":{"text":"Please, <style=\"stress\"><player_name></style>. Halia's counting on you.","source_cn":"请救救呼临吧，<style=stress><playe...","status":"matched_runtime_gender","hash_xxh64":"0xC01B3CBD8145C317","variant_status":"runtime_gender_keys_target_same","male":"Please, <style=\"stress\"><player_name></style>. Halia's counting on you.","female":"Please, <style=\"stress\"><player_name></style>. Halia's counting on you.","variant_male_record_index":"194933","variant_female_record_index":"194934","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:33:1525504026:0":{"text":"With Abundius and Bakis watching closely, you draw the magic circle that should end the rain.","source_cn":"在阿邦德和比博的注视下，你描绘出了驱雨魔法阵","status":"matched_runtime_gender","hash_xxh64":"0x15291D0484928E42","variant_status":"runtime_gender_keys_target_same","male":"With Abundius and Bakis watching closely, you draw the magic circle that should end the rain.","female":"With Abundius and Bakis watching closely, you draw the magic circle that should end the rain.","variant_male_record_index":"194935","variant_female_record_index":"194936","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:30:0:1":{"text":"Alright then...","source_cn":"没问题","status":"matched_runtime_gender","hash_xxh64":"0x88E1DE7A15AB30C8","variant_status":"runtime_gender_keys_target_same","male":"Alright then...","female":"Alright then...","variant_male_record_index":"80861","variant_female_record_index":"80862","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1525504024:1":{"text":"What do you think?","source_cn":"你猜。","status":"matched_runtime_gender","hash_xxh64":"0x445D8A9556BDA080","variant_status":"runtime_gender_keys_target_same","male":"What do you think?","female":"What do you think?","variant_male_record_index":"194931","variant_female_record_index":"194932","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:30:1:2":{"text":"This was your plan, Morgan?","source_cn":"这是你早就算好的吧，摩根","status":"matched_runtime_gender","hash_xxh64":"0xFD001D1BBC128B2B","variant_status":"runtime_gender_keys_target_same","male":"This was your plan, Morgan?","female":"This was your plan, Morgan?","variant_male_record_index":"80863","variant_female_record_index":"80864","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:0:1":{"text":"There won't be!","source_cn":"这次绝不会失败！","status":"matched_runtime_gender","hash_xxh64":"0xAD447DF0EE448F7B","variant_status":"runtime_gender_keys_target_same","male":"There won't be!","female":"There won't be!","variant_male_record_index":"80857","variant_female_record_index":"80858","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:1:2":{"text":"The circle will work, I promise!","source_cn":"这次的法阵绝不会出错！","status":"matched_runtime_gender","hash_xxh64":"0xF60B6DAFCB61725A","variant_status":"runtime_gender_keys_target_same","male":"The circle will work, I promise!","female":"The circle will work, I promise!","variant_male_record_index":"80859","variant_female_record_index":"80860","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:0:1":{"text":"Abundius asked us to handle this.","source_cn":"这是阿邦德拜托我们的事","status":"matched_runtime_gender","hash_xxh64":"0x71BE44973313423C","variant_status":"runtime_gender_keys_target_same","male":"Abundius asked us to handle this.","female":"Abundius asked us to handle this.","variant_male_record_index":"80853","variant_female_record_index":"80854","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1525504017:1":{"text":"Nonsense!","source_cn":"——一派胡言！","status":"matched_runtime_gender","hash_xxh64":"0x27439320CC729AAD","variant_status":"runtime_gender_keys_target_same","male":"Nonsense!","female":"Nonsense!","variant_male_record_index":"194921","variant_female_record_index":"194922","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:1:2":{"text":"Are you questioning the Regulus?","source_cn":"你该不会是想质疑领主的决策吧？","status":"matched_runtime_gender","hash_xxh64":"0x9F67C44422AB64AB","variant_status":"runtime_gender_keys_target_same","male":"Are you questioning the Regulus?","female":"Are you questioning the Regulus?","variant_male_record_index":"80855","variant_female_record_index":"80856","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"The circle wasn't the issue.","source_cn":"上次魔法阵没问题","status":"matched_runtime_gender","hash_xxh64":"0xFB413B1AD9FBCA22","variant_status":"runtime_gender_keys_target_same","male":"The circle wasn't the issue.","female":"The circle wasn't the issue.","variant_male_record_index":"80847","variant_female_record_index":"80848","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1525504008:1":{"text":"And that magically fixes everything?","source_cn":"担保就有用吗？","status":"matched_runtime_gender","hash_xxh64":"0x78F54C99687E1372","variant_status":"runtime_gender_keys_target_same","male":"And that magically fixes everything?","female":"And that magically fixes everything?","variant_male_record_index":"194906","variant_female_record_index":"194907","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"I'll vouch for Morgan's circle.","source_cn":"我来为摩根的魔法阵做担保","status":"matched_runtime_gender","hash_xxh64":"0x54E111D135596D33","variant_status":"runtime_gender_keys_target_same","male":"I'll vouch for Morgan's circle.","female":"I'll vouch for Morgan's circle.","variant_male_record_index":"80849","variant_female_record_index":"80850","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1525504009:1":{"text":"He's the one I don't trust—Morgan!","source_cn":"我不放心的是他——摩根！","status":"matched_runtime_gender","hash_xxh64":"0x022F528F6AA24E7C","variant_status":"runtime_gender_keys_target_same","male":"He's the one I don't trust—Morgan!","female":"He's the one I don't trust—Morgan!","variant_male_record_index":"194908","variant_female_record_index":"194909","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:2:3":{"text":"You don't trust me?","source_cn":"有我在，你还不放心？","status":"matched_runtime_gender","hash_xxh64":"0x25769AB2418F4E89","variant_status":"runtime_gender_keys_target_same","male":"You don't trust me?","female":"You don't trust me?","variant_male_record_index":"80851","variant_female_record_index":"80852","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:领主阿邦德":{"text":"Abundius","source":"领主阿邦德","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:学者比博":{"text":"Scholar Bakis","source":"学者比博","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":41,"localized_text_count":4