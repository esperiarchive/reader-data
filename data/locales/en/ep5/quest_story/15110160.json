{"asset_key":"ep5/quest_story_15110160","episode":"ep5","category":"quest_story","story_id":"15110160","schema_version":1,"lang":"en","texts":{"say:1:1511016001:0":{"text":"Dura... cursed Dura...","source_cn":"艾雅，可恨的艾雅……","status":"matched","hash_xxh64":"0x80A629499583FF23","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1511016002:1":{"text":"Why do you intrude upon my sanctuary? Why must you interfere with what's between me and Perseus?!","source_cn":"为什么要踏足我的神域，为什么要来干涉我与珀尔修斯的命运？！","status":"matched","hash_xxh64":"0x7EB02054CE0A02ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1511016003:1":{"text":"The Tree doesn't belong to you alone! You have the divine authority—use it! Use it to bring him back to me!","source_cn":"生命树不是你一个人的所有物！行使你的神权，让珀尔修斯回...","status":"matched","hash_xxh64":"0xDC9B74C1FA8BEED6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1511016004:0":{"text":"... The rules of life must be obeyed. They are not mine to change.","source_cn":"……生命的规则，只能遵守，那也并非我能撼动之物。","status":"matched","hash_xxh64":"0x259299E6845591F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1511016005:0":{"text":"Divine authority...? Rules of life?","source_cn":"神权……？生命的规则？","status":"matched","hash_xxh64":"0x17819FC0A78C08B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1511016006:0":{"text":"Merlin, what have you been hiding from me?","source_cn":"梅林，你瞒了我什么？","status":"matched","hash_xxh64":"0x0240E37C8BE9AE03","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1511016007:0":{"text":"Still in the dark, are you? You've followed her all this way and still don't know who she is.","source_cn":"你们与她同行一路，竟然不知她是谁。","status":"matched","hash_xxh64":"0x86300F841BB01FAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1511016008:1":{"text":"The great and exalted <style=\"highlight\">Goddess of Life</style>. How many lies have you told mortals? Lies should be your domain!","source_cn":"伟大的——崇高的<style=highlight>生命...","status":"matched","hash_xxh64":"0x238B0F66E6C5D5AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1511016009:0":{"text":"And look at the Wildborn child beside you. She was once mine, and now she stares at me with eyes full of hatred!","source_cn":"看看你身边那个兽人孩子——她明明是我的信徒，却用仇视的...","status":"matched","hash_xxh64":"0xD4913F277EDAA1FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1511016010:1":{"text":"My land, my people, my creations... my love... You will take nothing else from me!","source_cn":"我的疆土，我的信徒，我的造物，我的爱……你再也不能夺走了！","status":"matched","hash_xxh64":"0xEDD2F2AE9DE69DD2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1511016011:1":{"text":"Merlin... is a goddess?","source_cn":"梅林……是神？","status":"matched","hash_xxh64":"0x1C2FAEEADA93F7F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1511016012:1":{"text":"Silence, traitor! You are my creation. You were meant to revere me!","source_cn":"闭嘴，叛徒，你是我的造物，本应崇敬我！","status":"matched","hash_xxh64":"0xFF8F92229CD39494","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1511016013:0":{"text":"... I no longer worship any god.","source_cn":"……我已经不崇敬任何神。","status":"matched","hash_xxh64":"0x9DC49CFDA33F61EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1511016014:0":{"text":"I follow <style=\"stress\"><player_name></style>!","source_cn":"我信仰，<style=stress><player_n...","status":"matched_runtime_gender","hash_xxh64":"0x1C64126687A1A3E0","variant_status":"runtime_gender_keys_target_same","male":"I follow <style=\"stress\"><player_name></style>!","female":"I follow <style=\"stress\"><player_name></style>!","variant_male_record_index":"177420","variant_female_record_index":"177421","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1511016015:0":{"text":"Enough! Once I bring Perseus back, I'll cast you all back into the Tree of Life!","source_cn":"——够了！等我唤回珀尔修斯，就让你回归生命树！","status":"matched","hash_xxh64":"0xC7C0BC43FBDFC9C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1511016016:0":{"text":"You can't save him, Azora.","source_cn":"你救不了珀尔修斯，奥法迦。","status":"matched","hash_xxh64":"0xE28CA5BD2C87BCBE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1511016017:0":{"text":"Mortals are like leaves on the Tree of Life. When they fall, their time is over.","source_cn":"凡人皆是生命树上的一枚叶片。当叶片凋落，凡人也迎来生命...","status":"matched","hash_xxh64":"0xCCC7715296A79024","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1511016018:0":{"text":"Perseus has returned to the roots. His soul has already returned to the Tree. Even if a new leaf grows in the same place, it will no longer be the one you loved.","source_cn":"认清现实吧，奥法迦。属于珀尔修斯的那一片叶已经凋落，他...","status":"matched","hash_xxh64":"0x190A915D491AE0B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1511016019:0":{"text":"Unless you pray to the God of Death... But would a god ever pray to another god?","source_cn":"除非你向死神祈求……但一位神，会向另一位神祈求吗？","status":"matched","hash_xxh64":"0x31F95036A2C7EF77","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1511016020:0":{"text":"And who even knows where the God of Death is now?","source_cn":"谁又知道死神现在何方呢？","status":"matched","hash_xxh64":"0xFFF4A49BBF595A38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1511016021:1":{"text":"No... I won't let him have Perseus! I forbid his death!","source_cn":"不……死神休想染指珀尔修斯的灵魂，我禁止他的死亡！","status":"matched","hash_xxh64":"0xED0F3D29F180C15E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1511016022:0":{"text":"You and I are both gods! If you can give life, why can't I do the same?!","source_cn":"你我皆是神！你能赐予生命，我为何不能——？！","status":"matched","hash_xxh64":"0x446826B08CA483E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1511016023:0":{"text":"She's still draining power from the Tree!","source_cn":"她还在抽取生命树的力量！","status":"matched","hash_xxh64":"0x224B612681F1DD6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1511016024:0":{"text":"Azora...","source_cn":"奥法迦……<key:dialog2>","status":"matched","hash_xxh64":"0xD1625AA20721FFC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1511016025:1":{"text":"You will not take him from me again!","source_cn":"——休想再阻止我！","status":"matched","hash_xxh64":"0xA5B8A867E13B07F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1511016026:0":{"text":"I will succeed! <style=\"highlight\">He's about to wake up!</style>","source_cn":"我会成功的……<style=highlight>他马上...","status":"matched","hash_xxh64":"0xE76DF4E8C2DC4EAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1511016027:0":{"text":"Perseus... We'll be together... forever and ever...","source_cn":"珀尔修斯……我们将永远永远……永远地在一起！","status":"matched","hash_xxh64":"0x2FE2C19844DDAAF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:狩猎神奥法迦":{"text":"Goddess Azora","source":"狩猎神奥法迦","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":28,"localized_text_count":27,"speaker_count":4}}