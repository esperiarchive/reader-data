{"asset_key":"ep5/quest_story_15114050","episode":"ep5","category":"quest_story","story_id":"15114050","schema_version":1,"lang":"en","texts":{"say:1:1511405001:0":{"text":"The forest seems calm; there's no obvious sign of a Hypogean.","source_cn":"薄暮丛林一切正常，似乎没有受到恶魔的侵扰。","status":"matched","hash_xxh64":"0x4BAAC7DC27335C60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1511405002:0":{"text":"<style=\"stress\"><player_name></style>, can you sense it?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x9D58BBC3776EA4DF","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, can you sense it?","female":"<style=\"stress\"><player_name></style>, can you sense it?","variant_male_record_index":"192365","variant_female_record_index":"192366","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1511405002":{"text":"<style=\"stress\"><player_name></style>, can you sense it?","source_cn":"<style=stress><player_name></style>，你有察觉到恶魔的气息吗？","status":"matched_runtime_gender","hash_xxh64":"0x9D58BBC3776EA4DF","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, can you sense it?","female":"<style=\"stress\"><player_name></style>, can you sense it?","variant_male_record_index":"192365","variant_female_record_index":"192366","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1511405003:1":{"text":"Then let's ask around!","source_cn":"那我们就找人问问吧！","status":"matched","hash_xxh64":"0x86F689E3DAE6C942","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1511405004:0":{"text":"Ask around? About what? Hey, maybe I can help!","source_cn":"找人？问什么？说不定我可以回答你们！","status":"matched","hash_xxh64":"0xF0C86DFCF77529AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1511405005:0":{"text":"Damian! What a coincidence!","source_cn":"哇！达米安！好巧啊！","status":"matched","hash_xxh64":"0xD9935FCF2801D12A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1511405006:1":{"text":"Not really. You'll almost always find me tinkering around Lunadorf.","source_cn":"你们来月湖村，碰到我是很正常的事啊。","status":"matched","hash_xxh64":"0x07C6329B52952339","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1511405007:0":{"text":"So, what's the question?","source_cn":"对了，你们要找人问什么？","status":"matched","hash_xxh64":"0xC3F216A9FC95F017","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1511405007":{"text":"So, what's the question?","source_cn":"对了，你们要找人问什么？","status":"matched","hash_xxh64":"0xC3F216A9FC95F017","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1511405008:0":{"text":"A Hypogean?! No way!","source_cn":"恶、恶魔？！怎么可能！","status":"matched","hash_xxh64":"0x53A647290E1E0562","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1511405009:0":{"text":"The forest has been quiet! Sure, maybe a few of my inventions exploded—but a Hypogean? Absolutely not!","source_cn":"薄暮丛林最近很平静，顶多就是我的几个失败发明闹出了一点...","status":"matched","hash_xxh64":"0xD7333FE4F34D85B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1511405010:1":{"text":"The message Magister Merlin received is clear: the Hypogean is hiding in the dream of a child who cannot wake.","source_cn":"梅林收到的消息是：恶魔藏在一个长睡不醒的小孩的梦里。","status":"matched_runtime_gender","hash_xxh64":"0x052376012B75364D","variant_status":"runtime_gender_keys_target_same","male":"The message Magister Merlin received is clear: the Hypogean is hiding in the dream of a child who cannot wake.","female":"The message Magister Merlin received is clear: the Hypogean is hiding in the dream of a child who cannot wake.","variant_male_record_index":"192374","variant_female_record_index":"192375","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1511405011:1":{"text":"We need to find that child. Do you know anyone like that?","source_cn":"所以，我们必须要找到那个孩子。你认识这样的人吗？","status":"matched","hash_xxh64":"0x9BB0D8EB8A0F66E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1511405012:0":{"text":"Hmm... I don't recall anyone like that.","source_cn":"长睡不醒……嗯，我好像没听说这样的事。","status":"matched","hash_xxh64":"0xBA531E5BCD7E7694","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1511405013:0":{"text":"I've been too busy testing my glimmerbloom-shaped tracking irrigator, so maybe I missed something. But <style=\"highlight\">Granny Dahnie</style> would know! Nothing escapes her notice.","source_cn":"我最近一直在研究荧荧花形追踪浇灌器，没怎么注意村里的事...","status":"matched","hash_xxh64":"0xF8E19667527CEF81","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1511405014:0":{"text":"Then please take us to her.","source_cn":"那就麻烦你带路啦。","status":"matched","hash_xxh64":"0x48F5D44341117B9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"We heard a Hypogean is hiding here.","source_cn":"有人告诉我，薄暮丛林出现了恶魔","status":"matched_runtime_gender","hash_xxh64":"0x060882C6CAE777DE","variant_status":"runtime_gender_keys_target_same","male":"We heard a Hypogean is hiding here.","female":"We heard a Hypogean is hiding here.","variant_male_record_index":"80263","variant_female_record_index":"80264","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"We need to find a child who can't wake up.","source_cn":"我们要找一个长睡不醒的小孩","status":"matched_runtime_gender","hash_xxh64":"0x9C4DD80613F04DB1","variant_status":"runtime_gender_keys_target_same","male":"We need to find a child who can't wake up.","female":"We need to find a child who can't wake up.","variant_male_record_index":"80265","variant_female_record_index":"80266","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"No.","source_cn":"没有","status":"matched_runtime_gender","hash_xxh64":"0x42F2DF311BB1AA57","variant_status":"runtime_gender_keys_target_same","male":"No.","female":"No.","variant_male_record_index":"80259","variant_female_record_index":"80260","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"Maybe it's still hiding within the dream.","source_cn":"恶魔或许还在梦里","status":"matched_runtime_gender","hash_xxh64":"0x2E3C421BB592466C","variant_status":"runtime_gender_keys_target_same","male":"Maybe it's still hiding within the dream.","female":"Maybe it's still hiding within the dream.","variant_male_record_index":"80261","variant_female_record_index":"80262","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:达米安":{"text":"Damian","source":"达米安","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":21,"localized_text_count":20,"speaker_count":3}}