{"asset_key":"ep5/quest_story_15107080","episode":"ep5","category":"quest_story","story_id":"15107080","schema_version":1,"lang":"en","texts":{"say:2:1510708001:0":{"text":"Excuse me. Can I ask why the army is suddenly mobilizing?","source_cn":"冒昧打扰。请问军队为何突然要出征？","status":"matched","hash_xxh64":"0xA1D7948F3217A20C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510708002:0":{"text":"Oh, what else could it be for? To crush those damn fleabags in the forest, of course!","source_cn":"噢，还能为什么？当然是为了讨伐那些可恶的兽人！","status":"matched","hash_xxh64":"0x669518E13DE97BE4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510708004:0":{"text":"Did the Regulus order this attack?","source_cn":"开战是你们领主下的令？","status":"matched","hash_xxh64":"0x23D0640D49B32441","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510708005:0":{"text":"Abundius is just a kid. He's got no say in this. Our god gave a divine order for the attack!","source_cn":"领主还是个小孩，哪管得了这些。下令开战的可是神啊！","status":"matched","hash_xxh64":"0xB165FE9D8A2C6F48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510708006:0":{"text":"What?!","source_cn":"什么？！<key:dialog51>","status":"matched","hash_xxh64":"0x2F746462637D753B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510708007:0":{"text":"Too bad you weren't here to see it. Just a while ago, the God of Harvest descended upon Halia!","source_cn":"你们没有亲眼目睹真是太可惜了。就在刚才，丰饶神降临在呼...","status":"matched","hash_xxh64":"0x7CB6B7D357159684","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510708008:0":{"text":"His Bountiful Grace proclaimed that <style=\"highlight\">a rival god</style> is now our sworn enemy, and ordered us to attack those savage Wildborn and take their souls!","source_cn":"神说，有<style=highlight>其他神明</...","status":"matched_runtime_gender","hash_xxh64":"0x97D7FE7FE9521350","variant_status":"runtime_gender_keys_target_differs","male":"His Bountiful Grace proclaimed that <style=\"highlight\">a rival god</style> is now our sworn enemy, and ordered us to attack those savage Wildborn and take their souls!","female":"His Bountiful Grace proclaimed that <style=\"highlight\">a rival goddess</style> is now our sworn enemy, and ordered us to attack those savage Wildborn and take their souls!","variant_male_record_index":"181464","variant_female_record_index":"181465","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510708009:0":{"text":"And after he uses their souls to regain his divine powers, Halia will have bountiful harvests, and no one will ever go hungry again!","source_cn":"等他的神力恢复，呼临城就能迎来丰收，再也不会有人饿肚子了！","status":"matched","hash_xxh64":"0x8C13A92A0F46F517","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1510708010:0":{"text":"What about general Perseus? He's supposed to be leading the army, but he doesn't seem to be with them.","source_cn":"那么呼临的统帅，珀尔修斯呢？出征的队伍应当由他带领，但...","status":"matched","hash_xxh64":"0x4B09FB1D4B91E389","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1510708011:0":{"text":"Oh, the general? He left with <style=\"highlight\">an elite squad through the north gate</style>!","source_cn":"噢，统帅啊，他带着一支<style=highlight...","status":"matched","hash_xxh64":"0x30D06311ACBCACD0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1510708012:0":{"text":"Where does that path lead?","source_cn":"那条路通往哪里？","status":"matched","hash_xxh64":"0x804530D19EDFA09E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1510708013:0":{"text":"I don't know. You have to pass through the Regulus Palace to get to that road. It's not a path just anyone can take.","source_cn":"不知道。想走那条路得穿过领主的宫殿，一般人想走都走不了。","status":"matched","hash_xxh64":"0x5AD354A9104D1301","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1510708014:0":{"text":"... Tch!","source_cn":"……啧！<key:dialog2>","status":"matched","hash_xxh64":"0xAC5F033FBA0B3360","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:25:1510708015:0":{"text":"Feeling a sense of urgency, your group quickly retreats to a more private place to discuss what you learned.","source_cn":"情况紧急，你们迅速远撤，在没人能听到的地方商讨","status":"matched","hash_xxh64":"0xC382E6EE567D78E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1510708016:0":{"text":"Cunning Halians... They've split their forces to try and ambush Wrathwood Grove!","source_cn":"狡诈的呼临人……他们竟兵分两路，妄图袭击树怒山谷！","status":"matched","hash_xxh64":"0x2988AA4AF0EFC5F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:27:1510708010":{"text":"What about general Perseus? He's supposed to be leading the army, but he doesn't seem to be with them.","source_cn":"那么呼临的统帅，珀尔修斯呢？出征的队伍应当由他带领，但他似乎不在队伍中。","status":"matched","hash_xxh64":"0x4B09FB1D4B91E389","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1510708017:0":{"text":"I can't. I've never seen him before, only heard of him.","source_cn":"不行。我没见过他。只有所耳闻。","status":"matched_runtime_gender","hash_xxh64":"0x28C306FE4E017478","variant_status":"runtime_gender_keys_target_same","male":"I can't. I've never seen him before, only heard of him.","female":"I can't. I've never seen him before, only heard of him.","variant_male_record_index":"181474","variant_female_record_index":"181475","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1510708018:0":{"text":"You have to have seen him in person?","source_cn":"还要亲眼见过才行？","status":"matched","hash_xxh64":"0x283BD5E064C5E223","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1510708019:0":{"text":"The Divine One should know this better than anyone...","source_cn":"……这点神明大人应当再清楚不过。","status":"matched_runtime_gender","hash_xxh64":"0x57D4DF7B3DACE306","variant_status":"runtime_gender_keys_target_same","male":"The Divine One should know this better than anyone...","female":"The Divine One should know this better than anyone...","variant_male_record_index":"181477","variant_female_record_index":"181478","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1510708020:0":{"text":"I saw a few Halian soldiers lagging behind earlier. They might know something...","source_cn":"之前，我看到几个落单的呼临士兵。也许他们那边……","status":"matched","hash_xxh64":"0x39C4B683AF0023B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:32:0:1":{"text":"Alright, let's try something else!","source_cn":"……好吧，换个方法！","status":"matched_runtime_gender","hash_xxh64":"0x83CA5414D88642EC","variant_status":"runtime_gender_keys_target_same","male":"Alright, let's try something else!","female":"Alright, let's try something else!","variant_male_record_index":"77146","variant_female_record_index":"77147","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:32:1:2":{"text":"Do you guys have any ideas?","source_cn":"你们还有什么主意？","status":"matched_runtime_gender","hash_xxh64":"0x0427F023BA49C5CB","variant_status":"runtime_gender_keys_target_same","male":"Do you guys have any ideas?","female":"Do you guys have any ideas?","variant_male_record_index":"77148","variant_female_record_index":"77149","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:27:0:1":{"text":"Nazrik, track Perseus.","source_cn":"那非，追踪珀尔修斯","status":"matched_runtime_gender","hash_xxh64":"0xBB1CA14851934EB2","variant_status":"runtime_gender_keys_target_same","male":"Nazrik, track Perseus.","female":"Nazrik, track Perseus.","variant_male_record_index":"77144","variant_female_record_index":"77145","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:0:1":{"text":"The north gate?","source_cn":"城北？","status":"matched_runtime_gender","hash_xxh64":"0xB1B60E2BBD7B8A68","variant_status":"runtime_gender_keys_target_same","male":"The north gate?","female":"The north gate?","variant_male_record_index":"77140","variant_female_record_index":"77141","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:1:2":{"text":"The army is splitting up?","source_cn":"呼临军队要兵分两路？","status":"matched_runtime_gender","hash_xxh64":"0xA54CC24780405F83","variant_status":"runtime_gender_keys_target_same","male":"The army is splitting up?","female":"The army is splitting up?","variant_male_record_index":"77142","variant_female_record_index":"77143","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"},"speaker:马塞":{"text":"Masai","source":"马塞","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根",