{"asset_key":"ep5/quest_story_15235060","episode":"ep5","category":"quest_story","story_id":"15235060","schema_version":1,"lang":"en","texts":{"narration:0:1523506001:0":{"text":"You cast bind magic on Aurelin.","source_cn":"你用束缚魔法困住了奥勒留","status":"matched_runtime_gender","hash_xxh64":"0xB01945C5D0B1AC1F","variant_status":"runtime_gender_keys_target_same","male":"You cast bind magic on Aurelin.","female":"You cast bind magic on Aurelin.","variant_male_record_index":"188867","variant_female_record_index":"188868","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:1:1523506002:0":{"text":"The herbalist seizes the opportunity to escape, and the guards swiftly move in to protect her.","source_cn":"被挟持的学者趁机逃脱，被护卫们保护起来","status":"matched","hash_xxh64":"0x688F15D1EB5E239E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1523506003:0":{"text":"What's happening?!","source_cn":"该死……该死！","status":"matched_runtime_gender","hash_xxh64":"0xE4872E0451D591AB","variant_status":"runtime_gender_keys_target_same","male":"What's happening?!","female":"What's happening?!","variant_male_record_index":"188870","variant_female_record_index":"188871","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1523506004:0":{"text":"You despicable mage... How dare you sneak up on me!","source_cn":"卑鄙的魔法师……你竟敢偷袭！","status":"matched_runtime_gender","hash_xxh64":"0xA487815DA6ED5E44","variant_status":"runtime_gender_keys_target_same","male":"You despicable mage... How dare you sneak up on me!","female":"You despicable mage... How dare you sneak up on me!","variant_male_record_index":"188872","variant_female_record_index":"188873","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1523506004":{"text":"You despicable mage... How dare you sneak up on me!","source_cn":"卑鄙的魔法师……你竟敢偷袭！","status":"matched_runtime_gender","hash_xxh64":"0xA487815DA6ED5E44","variant_status":"runtime_gender_keys_target_same","male":"You despicable mage... How dare you sneak up on me!","female":"You despicable mage... How dare you sneak up on me!","variant_male_record_index":"188872","variant_female_record_index":"188873","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1523506005:0":{"text":"Abundius... Abundius!","source_cn":"阿邦德……阿邦德！！！","status":"matched","hash_xxh64":"0xA32F58E43CE583DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1523506006:0":{"text":"You think no one else will oppose you once I'm gone?","source_cn":"你以为没有我，就不会有其他人反抗你，你就能安安稳稳地坐...","status":"matched","hash_xxh64":"0x677D9F3887FF5FB8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1523506007:0":{"text":"Can you lead an army? Have you ever killed a Wildborn? No! You're just a clueless child! You don't deserve to be the Regulus!","source_cn":"你懂怎么带领军队吗？你知道怎么杀死兽人吗？不！你只是一...","status":"matched","hash_xxh64":"0xCDA56D81CE5716BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1523506008:1":{"text":"You—!","source_cn":"你——！","status":"matched","hash_xxh64":"0x189960D882409492","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1523506009:1":{"text":"There will be no more traitors like you.","source_cn":"不会有那一天的。","status":"matched","hash_xxh64":"0xB27BC14ED2ED9AC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1523506010:1":{"text":"You don't know what the people truly want, but I do.","source_cn":"你不知道呼临城的大家想要什么，但我知道。","status":"matched","hash_xxh64":"0x81DDFB7240FDCA2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1523506011:1":{"text":"I'll give my all to make sure they live well.","source_cn":"我会尽我所能，给大家想要的，让呼临的民众都过上好日子。","status":"matched","hash_xxh64":"0xB62EDDB6CE14820E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1523506012:1":{"text":"So, you'll be the last traitor I ever face.","source_cn":"所以，不会有你说的那一天。","status":"matched","hash_xxh64":"0xDCB42D1752F07CB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1523506013:1":{"text":"Regulus...","source_cn":"阿邦德殿下……","status":"matched","hash_xxh64":"0x5E941957DA9432DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1523506014:1":{"text":"Aurelin! You have lied, incited rebellion, injured the herbalist, and deliberately obstructed our search for new crops.","source_cn":"——奥勒留！你说谎，让军队反叛；又伤害无辜的学者，妨碍...","status":"matched","hash_xxh64":"0xB621E92D9FB820DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1523506015:1":{"text":"I hereby sentence you for treason and order your immediate imprisonment!","source_cn":"因此——我判你犯谋逆罪，立刻投牢！","status":"matched","hash_xxh64":"0x04039225F9B47A3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1523506016:1":{"text":"Your fate will be decided later! For now, we must focus on the bitter corn research.","source_cn":"至于怎么处理……呃，之后再说！现在苦苞穗的事最重要。","status":"matched","hash_xxh64":"0x951E640F36528084","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1523506017:1":{"text":"Guards, lock him in a cell. Make sure he gets no food for three days, so he knows what hunger feels like.","source_cn":"护卫，把他关进牢里。三天不许给他吃的，让他也尝尝饥荒时...","status":"matched","hash_xxh64":"0xF3C2B1CC99346D35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1523506018:1":{"text":"Yes!","source_cn":"是！","status":"matched","hash_xxh64":"0x214B58C9911E5151","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1523506019:0":{"text":"I sounded commanding just now, wouldn't you say?","source_cn":"怎么样，我是不是很有魄力？","status":"matched","hash_xxh64":"0x297B5E0E93913BC5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1523506020:0":{"text":"Regulus... you've finally grown up.","source_cn":"殿下……您终于长大了。","status":"matched","hash_xxh64":"0xAEFAC94BE991145F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1523506021:1":{"text":"Well, I've gained some experience after all this time.","source_cn":"当然，我都当领主这么久了，总该有点长进嘛。","status":"matched","hash_xxh64":"0x5ED52CED9F30D936","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1523506022:1":{"text":"Oh, we should <style=\"highlight\">check on that herbalist</style>. She must be terrified!","source_cn":"哦对了，我们先去<style=highlight>安抚...","status":"matched","hash_xxh64":"0xA391E727D7EEF6B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1523506023:1":{"text":"We owe her an apology for the distress she's endured.","source_cn":"嗯，这的确是我们的过失，理应向她赔礼道歉。","status":"matched","hash_xxh64":"0x9E615140325F53E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"Right back at you.","source_cn":"彼此彼此","status":"matched_runtime_gender","hash_xxh64":"0x85A6757DC2BAB001","variant_status":"runtime_gender_keys_target_same","male":"Right back at you.","female":"Right back at you.","variant_male_record_index":"79147","variant_female_record_index":"79148","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"Despicable? Coming from a traitor like you?","source_cn":"谋逆的人还说我卑鄙？","status":"matched_runtime_gender","hash_xxh64":"0x22E37E0527EF6F60","variant_status":"runtime_gender_keys_target_same","male":"Despicable? Coming from a traitor like you?","female":"Despicable? Coming from a traitor like you?","variant_male_record_index":"79149","variant_female_record_index":"79150","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:2:3":{"text":"You should have watched your back.","source_cn":"是你太大意了","status":"matched_runtime_gender","hash_xxh64":"0x3FA5EEA771F12CB1","variant_status":"runtime_gender_keys_target_same","male":"You should have watched your back.","female":"You should have watched your back.","variant_male_record_index":"79151","variant_female_record_index":"79152","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"},"speaker:奥勒留":{"text":"Aurelin","source":"奥勒留","status":"matched_dialogue_flow"},"speaker:学者比博":{"text":"Scholar Bakis","source":"学