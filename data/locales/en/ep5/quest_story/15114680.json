_runtime_gender","hash_xxh64":"0x7E5CDB94BBC2AAE2","variant_status":"runtime_gender_keys_target_same","male":"Dunn would want you to go.","female":"Dunn would want you to go.","variant_male_record_index":"79989","variant_female_record_index":"79990","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"His death wasn't your fault.","source_cn":"顿的死也不是你的错","status":"matched_runtime_gender","hash_xxh64":"0xC25E28ED63DCAA08","variant_status":"runtime_gender_keys_target_same","male":"His death wasn't your fault.","female":"His death wasn't your fault.","variant_male_record_index":"79991","variant_female_record_index":"79992","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:2:3":{"text":"His family will be safe with you.","source_cn":"有你的照顾，他们才能过得好","status":"matched_runtime_gender","hash_xxh64":"0xA5421E223D77234B","variant_status":"runtime_gender_keys_target_same","male":"His family will be safe with you.","female":"His family will be safe with you.","variant_male_record_index":"79993","variant_female_record_index":"79994","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"Are you feeling better?","source_cn":"现在好点了吗？","status":"matched_runtime_gender","hash_xxh64":"0x6D64FAE7A21D6B17","variant_status":"runtime_gender_keys_target_same","male":"Are you feeling better?","female":"Are you feeling better?","variant_male_record_index":"79985","variant_female_record_index":"79986","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1511468003:0":{"text":"... I'm thinking about Dunn.","source_cn":"……有关顿的事。","status":"matched_runtime_gender","hash_xxh64":"0x48D75AF1B816CD6E","variant_status":"runtime_gender_keys_target_same","male"