cument_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1511468012:0":{"text":"Tomorrow, I'll <style=\"highlight\">visit them</style>. For Dunn.","source_cn":"明天，我会去<style=highlight>看看他们...","status":"matched_runtime_gender","hash_xxh64":"0x70D1CCA5CAABFB1C","variant_status":"runtime_gender_keys_target_same","male":"Tomorrow, I'll <style=\"highlight\">visit them</style>. For Dunn.","female":"Tomorrow, I'll <style=\"highlight\">visit them</style>. For Dunn.","variant_male_record_index":"191566","variant_female_record_index":"191567","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:1511468013:1":{"text":"Nazrik doesn't say anything else.","source_cn":"","status":"matched","hash_xxh64":"0x26A699CC8797A1D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:14:1511468014:1":{"text":"When morning comes...","source_cn":"","status":"matched","hash_xxh64":"0x4FF6F80678EE254A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"You won't know unless you go.","source_cn":"总要去看看才知道","status":"matched_runtime_gender","hash_xxh64":"0x2B446F1BF52AC77A","variant_status":"runtime_gender_keys_target_same","male":"You won't know unless you go.","female":"You won't know unless you go.","variant_male_record_index":"79995","variant_female_record_index":"79996","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1511468010:1":{"text":"... Mhm.","source_cn":"……嗯。","statu