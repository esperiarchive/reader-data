{"asset_key":"ep5/quest_story_15111090","episode":"ep5","category":"quest_story","story_id":"15111090","schema_version":1,"lang":"en","texts":{"say:3:1511109001:1":{"text":"So. You're the ruler of Halia?","source_cn":"你就是呼临城的领主？","status":"matched","hash_xxh64":"0xD14F9A5919BAA096","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1511109002:1":{"text":"I expected someone older. You're barely grown.","source_cn":"真没想到，居然还是个孩子。","status":"matched","hash_xxh64":"0xFC75053BD62F72A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1511109003:0":{"text":"... I'm here to <style=\"highlight\">negotiate</style>. No ill will intended.","source_cn":"……我是来<style=highlight>谈判</s...","status":"matched","hash_xxh64":"0x4BC109F8B813A64A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1511109011:0":{"text":"Age doesn't matter. I... I represent Halia!","source_cn":"这和年龄无关，我……我代表呼临城，雅库伯尔的首领！","status":"matched","hash_xxh64":"0xB3132CE10E176D44","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1511109004:1":{"text":"Negotiation means peace. Lower your posture. It does no harm, only good.","source_cn":"谈判就是求和。把姿态放低点，这对你只有好处，没有坏处。","status":"matched","hash_xxh64":"0x1E72974FCB4EB67E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1511109005:1":{"text":"Speak with me in the <style=\"highlight\">Great Treehouse</style>. Your guards may enter, but they leave their weapons behind.","source_cn":"跟我去<style=highlight>主树厅</st...","status":"matched","hash_xxh64":"0x76F5198817841FA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1511109006:1":{"text":"Outrageous! Why not talk here? You think we'll hand over the Regulus—","source_cn":"放肆！为什么不在这里谈？如果你们把领主——","status":"matched","hash_xxh64":"0xAC84EBE48EF0DD5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1511109007:1":{"text":"You have no leverage here. This is not a request.","source_cn":"你们没有谈判的筹码。","status":"matched","hash_xxh64":"0x7FA2CB7D06F19E1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1511109008:1":{"text":"Refuse, and you leave. Simple as that.","source_cn":"如果不接受，那就滚回去！","status":"matched","hash_xxh64":"0x683BD091AE1739D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1511109009:0":{"text":"Do as he says.","source_cn":"……按他说的做。","status":"matched","hash_xxh64":"0x3B8148EB8D238E59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1511109010:1":{"text":"Yes, Regulus.","source_cn":"……是，领主。","status":"matched","hash_xxh64":"0xCB85E0AD6BDC40AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:戈丹":{"text":"Kordan","source":"戈丹","status":"matched_dialogue_flow"},"speaker:领主阿邦德":{"text":"Abundius","source":"领主阿邦德","status":"matched_dialogue_flow"},"speaker:领主护卫":{"text":"Palace Guard","source":"领主护卫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":12,"localized_text_count":11,"speaker_count":3}}