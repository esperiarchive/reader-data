{"asset_key":"ep5/quest_story_15218030","episode":"ep5","category":"quest_story","story_id":"15218030","schema_version":1,"lang":"en","texts":{"say:2:1521803001:0":{"text":"The Halians have held this place long enough! Go back to where you came from!","source_cn":"呼临人在这占得够久了！滚回你们的城邦！","status":"matched","hash_xxh64":"0xB6830C08FA38C315","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521803002:1":{"text":"We'll protect the Regulus at all costs! Who knows what you furspawn are capable of?","source_cn":"我们必须保护领主殿下！谁知道你们这些野蛮人会做出什么？","status":"matched","hash_xxh64":"0x25C77A7BBD31A9CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521803003:1":{"text":"Ha! Just as I thought, your words are as hollow as your honor! Sneaky pinkskins!","source_cn":"哈！果然说话不算话，狡猾的猿人！","status":"matched","hash_xxh64":"0x29E1EC4D68CE63FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521803004:0":{"text":"Maybe I should drag you all out myself—","source_cn":"既然你不识好歹，那我就送你走——","status":"matched","hash_xxh64":"0xF6D2B3051E151C9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:6:1521803005:0":{"text":"You raise a hand to stop them... but then Kordan's voice slices through the air, sharp and unexpected, coming from behind you.","source_cn":"你正准备制止，戈丹的声音忽然从身后传来","status":"matched_runtime_gender","hash_xxh64":"0xF5C7B94CC8F2C1D8","variant_status":"runtime_gender_keys_target_same","male":"You raise a hand to stop them... but then Kordan's voice slices through the air, sharp and unexpected, coming from behind you.","female":"You raise a hand to stop them... but then Kordan's voice slices through the air, sharp and unexpected, coming from behind you.","variant_male_record_index":"187085","variant_female_record_index":"187086","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521803006:1":{"text":"Enough!","source_cn":"——住手！","status":"matched","hash_xxh64":"0xA024E3E58B7D6EDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1521803007:0":{"text":"Kordan, we've gotta drive these Halians out of Mirehold!","source_cn":"戈丹，我们得把这些呼临人赶出水泽营地！","status":"matched","hash_xxh64":"0x5F32FB528B6C5677","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521803008:0":{"text":"They'll leave after the truce is signed. Don't cause any problems, got it?","source_cn":"停战合约签署后，他们就会离开。不要惹事。","status":"matched","hash_xxh64":"0x4D77782952B03076","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521803009:0":{"text":"Got it...","source_cn":"……是。","status":"matched","hash_xxh64":"0x888A6F0FA49F3832","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1521803010:0":{"text":"<style=\"stress\"><player_name></style>, come with me.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x1220306F984A7DFA","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, come with me.","female":"<style=\"stress\"><player_name></style>, come with me.","variant_male_record_index":"187091","variant_female_record_index":"187092","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:15:1521803010":{"text":"<style=\"stress\"><player_name></style>, come with me.","source_cn":"<style=stress><player_name></style>。你跟我来。","status":"matched_runtime_gender","hash_xxh64":"0x1220306F984A7DFA","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, come with me.","female":"<style=\"stress\"><player_name></style>, come with me.","variant_male_record_index":"187091","variant_female_record_index":"187092","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1521803012:0":{"text":"The Wildborn and the Halians are about to sign the truce. Your presence as a mage is required.","source_cn":"雅库伯尔要和呼临签署停战合约，魔法师必须出席。","status":"matched_runtime_gender","hash_xxh64":"0x18796CC36BB4156D","variant_status":"runtime_gender_keys_target_same","male":"The Wildborn and the Halians are about to sign the truce. Your presence as a mage is required.","female":"The Wildborn and the Halians are about to sign the truce. Your presence as a mage is required.","variant_male_record_index":"187094","variant_female_record_index":"187095","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1