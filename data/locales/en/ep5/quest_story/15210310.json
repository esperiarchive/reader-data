{"asset_key":"ep5/quest_story_15210310","episode":"ep5","category":"quest_story","story_id":"15210310","schema_version":1,"lang":"en","texts":{"say:1:1521031001:0":{"text":"Young master, is something wrong?","source_cn":"小公子，您怎么……","status":"matched","hash_xxh64":"0xA0464710B01D34CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1521031002:0":{"text":"I just want to know what Cato was about to ask... and about those rumors you mentioned.","source_cn":"我想知道卡托刚刚想问什么。唔……还有你说的那些流言。","status":"matched","hash_xxh64":"0x80924A95CA75963C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521031003:0":{"text":"No matter what you say, I won't get angry... I mean I won't tell anyone.","source_cn":"不管你们说什么，我都不会生气——呃，也不会告诉其他人。","status":"matched","hash_xxh64":"0x16D5937E5F5CD163","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521031004:0":{"text":"...Really?","source_cn":"……真的吗？","status":"matched","hash_xxh64":"0xD7634858F19B91C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1521031005:1":{"text":"Cato...","source_cn":"卡托……","status":"matched","hash_xxh64":"0xC8B9463FA02EEDCD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1521031006:1":{"text":"Then... you must have met the Regulus, right?","source_cn":"你这样说，肯定是见过领主殿下，对不对？","status":"matched","hash_xxh64":"0xC40C97D9809FCCC4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521031007:0":{"text":"I have. Do you want to meet him?","source_cn":"嗯，见过。你想认识他吗？","status":"matched","hash_xxh64":"0xDA84C2083662A3FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521031008:0":{"text":"I just want to know... is the Regulus really like the rumors say? A boy about my age?","source_cn":"我、我只是想问……领主殿下是不是真像传闻中说的那样，是...","status":"matched","hash_xxh64":"0xEFDA65496C8DAA38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521031009:0":{"text":"Oh, I'm seven!","source_cn":"——对了，我今年七岁！","status":"matched","hash_xxh64":"0xBF725FC66B6E8A1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1521031010:0":{"text":"Haven't you seen him? He's often played... Uh, checking on the people at the plaza.","source_cn":"你没见过领主吗？领主经常在广场上玩……呃，体察民情！对...","status":"matched","hash_xxh64":"0x22F0EC278E0E38D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521031011:0":{"text":"No, never.","source_cn":"没有，我从来没见过领主殿下……","status":"matched","hash_xxh64":"0x01A82B8FE848426B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521031012:0":{"text":"Please understand, young master... people like us barely had a roof over our heads even before the famine. How could we have a chance to meet the Regulus?","source_cn":"请见谅……像我们这样的底层人，就算是在饥荒之前，也只是...","status":"matched","hash_xxh64":"0x196E9E1E4E74CF30","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1521031013:0":{"text":"Is it true he lives in that big palace, with endless food every day?","source_cn":"小公子，领主殿下真的住在那座高大的宫殿里，每天都有吃不...","status":"matched","hash_xxh64":"0x67E91F302AD85693","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1521031014:1":{"text":"And his bed—soft white blankets, so warm you'd never feel cold?","source_cn":"他的床铺是不是真的铺满了毛毯，就像天上的云彩一样，睡觉...","status":"matched","hash_xxh64":"0x7BD0551B322F4EB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1521031015:1":{"text":"...\n...I guess you could say that.","source_cn":"………………\\n……嗯……","status":"matched","hash_xxh64":"0x462F869F173FCD4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1521031016:1":{"text":"Wow... I'd love to sleep on a bed like that, even just once... or even for half a night!","source_cn":"哇……那一定很舒服！卡托也想睡在那样的床铺上，哪怕只有...","status":"matched","hash_xxh64":"0xA649FF858546C45B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1521031017:0":{"text":"But the Regulus has plenty of worries too.","source_cn":"但是……但是领主也有很多烦恼。","status":"matched","hash_xxh64":"0x764C1733BEC078A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1521031018:1":{"text":"He has no freedom, can't do what he wants... People around him keep saying he's too young, so they won't listen to him.","source_cn":"他一点自由都没有，想做什么都不行……周围的人总是说他年...","status":"matched","hash_xxh64":"0x078E852C706C5583","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1521031019:0":{"text":"He has to obey his teacher, Mr. Bakis, study politics and history, hear General Perseus' reports, get up early, and even when he's in the plaza, he can't stay long.","source_cn":"他要听比博老师的话，学习政治和历史，听珀尔修斯汇报战况...","status":"matched","hash_xxh64":"0x3F4AE6F7577B23E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1521031020:0":{"text":"Still... he can eat whatever he wants. Never has to go hungry.","source_cn":"但他想吃什么就能吃什么，不用每天饿着肚子。","status":"matched","hash_xxh64":"0xC92E2E14B251859F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1521031021:1":{"text":"If I could eat bread every day, I'd be willing to never see the plaza again...","source_cn":"要是能每天都吃到面包……我愿意永远都不到广场上玩……","status":"matched","hash_xxh64":"0x5AEF63B1AA548887","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1521031022:1":{"text":"Cato! Don't compare yourself to the Regulus.","source_cn":"——卡托！你怎么能拿自己和领主殿下比？","status":"matched","hash_xxh64":"0x826B35DFA1DD0ED0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1521031023:1":{"text":"Young master, forgive him. He talks nonsense sometimes.","source_cn":"小公子，我儿子经常胡言乱语，请您别见怪。","status":"matched","hash_xxh64":"0x53621A11D9DC806C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1521031024:0":{"text":"But... if you ever see the Regulus, please don't mention today. If he knew, Cato could be punished.","source_cn":"如果……如果您真的认识领主殿下，请千万不要在他面前提起...","status":"matched","hash_xxh64":"0x4A122916C44557C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:26:1521031024":{"text":"But... if you ever see the Regulus, please don't mention today. If he knew, Cato could be punished.","source_cn":"如果……如果您真的认识领主殿下，请千万不要在他面前提起今天的事。否则卡托一定会受罚的……","status":"matched","hash_xxh64":"0x4A122916C44557C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1521031025:0":{"text":"*Sigh*... Who can say...","source_cn":"唉，谁知道呢……","status":"matched","hash_xxh64":"0x56255FFAAA634B9D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1521031027:0":{"text":"The Regulus is just too young to rule Halia. Mistakes are bound to happen.","source_cn":"领主殿下毕竟还是个孩子，呼临城的统治……难免会出差错。","status":"matched","hash_xxh64":"0x870B948A65963D0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1521031028:0":{"text":"But that's not his fault...\nHalia's just unlucky.","source_cn":"当然，这不是领主殿下的问题。\\n是呼临城……呼临城太倒...","status":"matched","hash_xxh64":"0xC09BA6E09E925591","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1521031029:0":{"text":"...Unlucky? How so?","source_cn":"……倒霉？为什么这么说？","status":"matched","hash_xxh64":"0xE78B6716DDA58B00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1521031030:0":{"text":"Since the famine hit, we've barely received any food.","source_cn":"自从饥荒以来，城里就没怎么发放过食物。","status":"matched","hash_xxh64":"0x2E774E2A56B5C49B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1521031031:1":{"text":"The soldiers cut each loaf so small, and the soup is nothing but warm water. I had more bread today than the city's given me in weeks.","source_cn":"为了让大家都能拿到，那些士兵把每份面包都分得很小，菜汤...","status":"matched","hash_xxh64":"0xD1AB5C8B113B473B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1521031032:0":{"text":"With only that, even Cato couldn't survive.","source_cn":"只靠那些食物，别说我了，就连卡托也活不下来……","status":"matched","hash_xxh64":"0x01835B2956452888","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1521031033:0":{"text":"If we hadn't gone to war with the Wildborn, I'd never have joined the patrol. The rations from this job kept us from starving, though hunger still follows us every day.","source_cn":"要不是呼临和兽人开战了，我也没机会机会加入巡逻队。靠着...","status":"matched","hash_xxh64":"0xBC2557C466AEC9FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1521031034:0":{"text":"...","source_cn":"……<key:dialog103>","status":"matched","hash_xxh64":"0x38A5C31625B1F247","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1521031035:0":{"text":"That's why we're truly grateful for the food you shared, young master.","source_cn":"真的非常感谢您，小公子。","status":"matched","hash_xxh64":"0xDF7D9BA3CBD6EDFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:37:1521031036:0":{"text":"After Regas and Cato left, Abundius pressed his lips into a thin line, silent the entire walk.","source_cn":"雷古斯和卡托离开后，阿邦德一直沉默","status":"matched","hash_xxh64":"0x89BD6945FF819003","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:38:1521031037:0":{"text":"Before you knew it, you had reached Asteria Rise.","source_cn":"不知不觉间，你们走到了至高天际","status":"matched","hash_xxh64":"0xBE24DA9ADE2E62F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:0:1":{"text":"The Regulus isn't that scary.","source_cn":"领主没那么吓人","status":"matched_runtime_gender","hash_xxh64":"0xA2AF58EE083AEB3D","variant_status":"runtime_gender_keys_target_same","male":"The Regulus isn't that scary.","female":"The Regulus isn't that scary.","variant_male_record_index":"77474","variant_female_record_index":"77475","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1521031026:0":{"text":"That's a relief...","source_cn":"这样的话就太好了……","status":"matched","hash_xxh64":"0x43D7571BFAE47961","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:1:2":{"text":"Don't worry. We don't really know the Regulus.","source_cn":"我们真不认识领主","status":"matched_runtime_gender","hash_xxh64":"0x8D998841A64F6F6F","variant_status":"runtime_gender_keys_target_same","male":"Don't worry. We don't really know the Regulus.","female":"Don't worry. We don't really know the Regulus.","variant_male_record_index":"77476","variant_female_record_index":"77477","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:雷古斯":{"text":"Regas","source":"雷古斯","status":"matched_dialogue_flow"},"speaker:领主阿邦德":{"text":"Abundius","source":"领主阿邦德","status":"matched_dialogue_flow"},"speaker:卡托":{"text":"Cato","source":"卡托","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":41,"localized_text_count":40,"speaker_count":4}}