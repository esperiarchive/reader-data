{"asset_key":"ep5/quest_story_15108260","episode":"ep5","category":"quest_story","story_id":"15108260","schema_version":1,"lang":"en","texts":{"say:1:1510826001:0":{"text":"A Halian? You're on Wildborn land. Who are you, and what are you doing here?","source_cn":"呼临人，此处是雅库伯尔的领地，你是谁？来做什么？","status":"matched","hash_xxh64":"0x6F7BD95B75D624A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1510826002:0":{"text":"Do the Wildborn not have a word for \"thank you\"?","source_cn":"在兽人的语言里，是不是没有“谢谢”这个词？","status":"matched","hash_xxh64":"0x91A54A5E712AC88F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510826003:0":{"text":"I never say thank you.","source_cn":"我从不言谢。","status":"matched","hash_xxh64":"0x2D2CA2CAEC62CDC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510826004:1":{"text":"Fine. Since you're unhurt, be careful heading back.","source_cn":"既然你没受伤，自己回去的时候多加小心。","status":"matched","hash_xxh64":"0xE1CA62E957855D93","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510826005:0":{"text":"Wait. You haven't answered me.","source_cn":"等等，你还没有回答我的问题。","status":"matched","hash_xxh64":"0xB21D68AC751477E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510826006:0":{"text":"And if I don't? You're going to stab me with that spear?","source_cn":"如果我拒绝回答，你打算用手中的枪刺向我吗？","status":"matched","hash_xxh64":"0xAF17270DDF433B2C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510826007:0":{"text":"That depends. On my mood, not your answer.","source_cn":"这和你的回答无关，要看我的心情。","status":"matched","hash_xxh64":"0x95FD9A71259B7291","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510826008:0":{"text":"What's your name?","source_cn":"你叫什么名字？","status":"matched","hash_xxh64":"0x48CEF557C0011344","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510826009:0":{"text":"Gorgonna.","source_cn":"露。","status":"matched","hash_xxh64":"0xE5C3FAAA47976F4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510826010:0":{"text":"Gorgonna...?","source_cn":"露？","status":"matched","hash_xxh64":"0xC3944212F9BC8049","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510826011:0":{"text":"Mhm. I permit you to call me that.","source_cn":"嗯，我允许你这样呼唤我。","status":"matched","hash_xxh64":"0x4A7A0BE7A4962BD2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510826012:0":{"text":"I'm Perseus.","source_cn":"我是珀尔修斯。","status":"matched","hash_xxh64":"0xA5413E9D7C707134","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510826013:0":{"text":"Perseus... Do you regret saving me?","source_cn":"珀尔修斯，你在后悔，你后悔救了我。","status":"matched","hash_xxh64":"0x387954BA067AEB8F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510826014:0":{"text":"Maybe I will, someday. But not today.","source_cn":"也许以后会，至少现在不。","status":"matched","hash_xxh64":"0x5B9A063C7B69FF30","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510826015:0":{"text":"I'm going to <style=\"highlight\">search for my spear</style> now.","source_cn":"我要去<style=highlight>寻找我的枪</...","status":"matched","hash_xxh64":"0xC510F5E9FF2BD75C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1510826016:0":{"text":"...","source_cn":"…………<key:dialog18>","status":"matched","hash_xxh64":"0xCAFB5D40901D5B0D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510826017:0":{"text":"Tsk. What's this little scene?","source_cn":"啧啧啧……这是什么？","status":"matched","hash_xxh64":"0xD5E5DEC4047E8467","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510826018:0":{"text":"That woman, Gorgonna, that's the one Perseus loved. The one who died.","source_cn":"那位雅库伯尔女性，就是珀尔修斯死去的恋人，露。","status":"matched","hash_xxh64":"0x5B405D985DC7E8DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1510826022":{"text":"We're in the Hunting Goddess' shrine. Under divine power, nothing behaves as it should...","source_cn":"这里是狩猎神的神殿，神力之下，一切都不能用常理推断……","status":"matched","hash_xxh64":"0xDF4ECD068F8D1C47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1510826019:0":{"text":"That was just illusion magic, dunce.","source_cn":"怎么可能，那是幻象。","status":"matched_runtime_gender","hash_xxh64":"0x234BB7438A3430DE","variant_status":"runtime_gender_keys_target_same","male":"That was just illusion magic, dunce.","female":"That was just illusion magic, dunce.","variant_male_record_index":"173833","variant_female_record_index":"173834","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1510826020:0":{"text":"It was an <style=\"highlight\">illusion built from memory</style>.","source_cn":"嗯，是<style=highlight>根据记忆构建的...","status":"matched","hash_xxh64":"0xFE86954D5320DAB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:23:1510826024":{"text":"Merlin, be honest—are you just dying to pluck my memories out and stash them in your room like souvenirs?","source_cn":"嗯，是<style=highlight>根据记忆构建的幻象</style>。","status":"matched","hash_xxh64":"0x3B3158706C8CA8D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1510826021:0":{"text":"Gorgonna was a living sacrifice to the Hunting Goddess. If there's a spell that can preserve the memories of the dead, I'd love to study it.","source_cn":"露是献给狩猎神的活祭祭品，如果有什么魔法能保存死人的记...","status":"matched_runtime_gender","hash_xxh64":"0xC5CDE94AE3AE59AA","variant_status":"runtime_gender_keys_target_same","male":"Gorgonna was a living sacrifice to the Hunting Goddess. If there's a spell that can preserve the memories of the dead, I'd love to study it.","female":"Gorgonna was a living sacrifice to the Hunting Goddess. If there's a spell that can preserve the memories of the dead, I'd love to study it.","variant_male_record_index":"173836","variant_female_record_index":"173837","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1510826022:0":{"text":"We're in the Hunting Goddess' shrine. Under divine power, nothing behaves as it should...","source_cn":"这里是狩猎神的神殿，神力之下，一切都不能用常理推断……","status":"matched","hash_xxh64":"0xDF4ECD068F8D1C47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1510826023:0":{"text":"So the goddess likes watching tragic love stories play out in memory? Bit of a twisted hobby, if you ask me.","source_cn":"哼，狩猎神喜欢观看祭品的爱情回忆？这是什么奇怪癖好？","status":"matched","hash_xxh64":"0x08D66197BACEA7DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1510826024:0":{"text":"Merlin, be honest—are you just dying to pluck my memories out and stash them in your room like souvenirs?","source_cn":"梅林，你会把我的记忆从脑子里抽出来放在卧室里观赏吗？","status":"matched","hash_xxh64":"0x3B3158706C8CA8D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1510826025:0":{"text":"Could be interesting. I might.","source_cn":"也许会很有趣呢，有机会我试一试。","status":"matched","hash_xxh64":"0x8AFD27175BCA5C66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:29:1510826029":{"text":"Could be interesting. I might.","source_cn":"也许会很有趣呢，有机会我试一试。","status":"matched","hash_xxh64":"0x8AFD27175BCA5C66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1510826026:0":{"text":"Sure. I'll invite you when the time comes.","source_cn":"好啊，到时候邀请你。","status":"matched_runtime_gender","hash_xxh64":"0xE71D6B02B9459E86","variant_status":"runtime_gender_keys_target_same","male":"Sure. I'll invite you when the time comes.","female":"Sure. I'll invite you when the time comes.","variant_male_record_index":"173842","variant_female_record_index":"173843","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1510826027:0":{"text":"You two... never mind. I brought this on myself.","source_cn":"你们两个……算了，是我自找的。","status":"matched_runtime_gender","hash_xxh64":"0x1ED9EDA2425E97CA","variant_status":"runtime_gender_keys_target_same","male":"You two... never mind. I brought this on myself.","female":"You two... never mind. I brought this on myself.","variant_male_record_index":"173844","variant_female_record_index":"173845","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1510826028:0":{"text":"Let's keep moving. I'm curious what scene comes next.","source_cn":"继续往前走吧，我很好奇他们的下一场戏会演什么。","status":"matched","hash_xxh64":"0xBD42F18AC6D4D8E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:29:0:1":{"text":"If you do, I want to see them too.","source_cn":"我也想看","status":"matched_runtime_gender","hash_xxh64":"0x5C9B5420420D61D8","variant_status":"runtime_gender_keys_target_same","male":"If you do, I want to see them too.","female":"If you do, I want to see them too.","variant_male_record_index":"74750","variant_female_record_index":"74751","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:23:0:1":{"text":"It must be hers.","source_cn":"珀尔修斯的记忆？","status":"matched_runtime_gender","hash_xxh64":"0x35FF45B34F3C4731","variant_status":"runtime_gender_keys_target_same","male":"It must be hers.","female":"It must be hers.","variant_male_record_index":"74746","variant_female_record_index":"74747","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:23:1:2":{"text":"Gorgonna's memory?","source_cn":"露的记忆？","status":"matched_runtime_gender","hash_xxh64":"0x8BBAF86BB256A9AE","variant_status":"runtime_gender_keys_target_same","male":"Gorgonna's memory?","female":"Gorgonna's memory?","variant_male_record_index":"74748","variant_female_record_index":"74749","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:0:1":{"text":"We saw her soul.","source_cn":"我们看到了灵魂","status":"matched_runtime_gender","hash_xxh64":"0xC909DF8059725FEB","variant_status":"runtime_gender_keys_target_same","male":"We saw her soul.","female":"We saw her soul.","variant_male_record_index":"74742","variant_female_record_index":"74743","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:1:2":{"text":"It felt like an illusion.","source_cn":"我们看到了幻象","status":"matched_runtime_gender","hash_xxh64":"0xF81E370B453ED9E6","variant_status":"runtime_gender_keys_target_same","male":"It felt like an illusion.","female":"It felt like an illusion.","variant_male_record_index":"74744","variant_female_record_index":"74745","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:兽人女子":{"text":"Wildborn Woman","source":"兽人女子","status":"matched_dialogue_flow"},"speaker:珀尔修斯":{"text":"Perseus","source":"珀尔修斯","status":"matched_dialogue_flow"},"speaker:露":{"text":"Gorgonna","source":"露","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"}},"stats":