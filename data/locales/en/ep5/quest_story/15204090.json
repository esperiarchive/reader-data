{"asset_key":"ep5/quest_story_15204090","episode":"ep5","category":"quest_story","story_id":"15204090","schema_version":1,"lang":"en","texts":{"say:1:1520409001:1":{"text":"Whatever you swiped, hand it over.","source_cn":"不管你拿了什么，都赶快交出来。","status":"matched","hash_xxh64":"0x2EE34E915C974A4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1520409002:1":{"text":"...","source_cn":"……<key:dialog121>","status":"matched","hash_xxh64":"0xBB7F3A1FDAC0C660","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1520409003:1":{"text":"Halia forbids locust meat. If the soldiers see you with that, what do you think will happen?","source_cn":"呼临城已经下令禁食针蝗了。如果把你手上的东西交给士兵，...","status":"matched","hash_xxh64":"0x31C8ABD67C95EC12","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1520409004:1":{"text":"N-no! Don't turn me in!","source_cn":"不要……不要把我交给士兵！","status":"matched","hash_xxh64":"0xD6DD9D3849EBC396","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1520409005:1":{"text":"I'm just... too hungry! And the <style=\"highlight\">camp</style>... so many kids haven't eaten in days!","source_cn":"我……我只是太饿了！而且<style=highligh...","status":"matched","hash_xxh64":"0x386CB42CAC77B990","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1520409005":{"text":"I'm just... too hungry! And the <style=\"highlight\">camp</style>... so many kids haven't eaten in days!","source_cn":"我……我只是太饿了！而且<style=highlight>营地里</style>还有很多比我更小的小孩……他们已经好几天没吃饭了！","status":"matched","hash_xxh64":"0x386CB42CAC77B990","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1520409006:1":{"text":"To the south.","source_cn":"就在南边。","status":"matched_runtime_gender","hash_xxh64":"0x4296D2C3CA3EC7F2","variant_status":"runtime_gender_keys_target_same","male":"To the south.","female":"To the south.","variant_male_record_index":"185897","variant_female_record_index":"185898","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1520409008:1":{"text":"We heard your camp could still hunt to fill your bellies.","source_cn":"我们曾听说，你所在的那个营地可以捕猎到尚存的野兽，从而果腹。","status":"matched","hash_xxh64":"0x057B1AB7B285B043","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1520409009:1":{"text":"If that's true... why steal locust meat?","source_cn":"如果真是如此……你为何要偷割针蝗的肉？","status":"matched","hash_xxh64":"0x240560879E76CA68","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1520409010:1":{"text":"There are fewer and fewer beasts... We can't find food anymore.","source_cn":"野兽……野兽越来越少了。我们找不到食物来源……","status":"matched","hash_xxh64":"0xFB60C188837A6245","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1520409011:1":{"text":"But everyone's starving, so I...","source_cn":"可是其他人都饿得不得了，我只能……","status":"matched","hash_xxh64":"0x978B370A03FB7CE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1520409012:1":{"text":"Hey. Are you kidding me? You're just a kid, and they sent you out to find food?","source_cn":"喂，别说笑了。你才多大？居然要你出来找食物？","status":"matched","hash_xxh64":"0xEA8931FABBC47CA0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1520409013:1":{"text":"I'm fifteen! And I'm <style=\"highlight\">Tolo</style>, not \"hey\"!","source_cn":"我已经十五岁了！而且我不叫喂，我有名字，我叫<styl...","status":"matched","hash_xxh64":"0x1871B5E77886FE03","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1520409014:1":{"text":"Don't care what you're called. Where are the adults?","source_cn":"不管你叫什么，都轮不到你。大人呢？","status":"matched","hash_xxh64":"0x1BE5AE4E46821492","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1520409015:1":{"text":"They... they...","source_cn":"他们……他们……","status":"matched","hash_xxh64":"0x4572A7DED770CFDF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1520409016:1":{"text":"...","source_cn":"………………","status":"matched","hash_xxh64":"0x197F0BE8A09E0D34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1520409017:1":{"text":"What happened to them?","source_cn":"他们怎么了？","status":"matched","hash_xxh64":"0xB14203D8A4351128","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1520409018:1":{"text":"Forget it.\nI can already guess.","source_cn":"……行了，别问了。\\n我大概能猜到是怎么回事。","status":"matched","hash_xxh64":"0x5B1893ACA73D9630","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:22:1520409018":{"text":"Forget it.\nI can already guess.","source_cn":"……行了，别问了。\\n我大概能猜到是怎么回事。","status":"matched","hash_xxh64":"0x5B1893ACA73D9630","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1520409019:1":{"text":"Aw, look at that. Newbie's trying to keep up with me.","source_cn":"喔，那你真不错，快和我一样了。","status":"matched_runtime_gender","hash_xxh64":"0x598A046FD642BEE8","variant_status":"runtime_gender_keys_target_same","male":"Aw, look at that. Newbie's trying to keep up with me.","female":"Aw, look at that. Newbie's trying to keep up with me.","variant_male_record_index":"185911","variant_female_record_index":"185912","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1520409022:1":{"text":"Tolo, another group just went to your camp.","source_cn":"托洛，刚才又有一批人去投奔你们的营地。","status":"matched","hash_xxh64":"0x77294FE8747CEBD5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1520409023:0":{"text":"You didn't see them?","source_cn":"你没看到他们经过？","status":"matched","hash_xxh64":"0x17013E029894062F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1520409024:1":{"text":"M-more people?!\nBut the camp...","source_cn":"又……又有人来了？！\\n可是现在营地里……","status":"matched","hash_xxh64":"0x63814B2477FBB82C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1520409025:0":{"text":"I need to go back now!","source_cn":"不，不行……我要赶紧回去！","status":"matched","hash_xxh64":"0x281B31FAF1EE3205","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1520409026:0":{"text":"Wait. Don't rush.","source_cn":"等等，请先别急。","status":"matched","hash_xxh64":"0x6A356D40B0D43E9D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1520409027:0":{"text":"As you said, you and the others are still young. You can't starve forever. How about we give you some locust meat to take back for now?","source_cn":"诚如你所说，你和你的同伴年龄尚小，不能一直挨饿。不如就...","status":"matched","hash_xxh64":"0xC52D2A16D1034A65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1520409028:0":{"text":"As for the curse on the needle locusts... don't worry. We're mages, we can <style=\"highlight\">purge the curse</style>. But it's only a temporary measure.","source_cn":"针蝗身上的诅咒也无需担心。我等是魔法师，可以用魔法<s...","status":"matched","hash_xxh64":"0x88791F586093BF81","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1520409029:0":{"text":"R-really?! We can finally eat?","source_cn":"真、真的吗？！大家终于能吃上东西了！","status":"matched","hash_xxh64":"0x7EFEA3A741F41691","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1520409030:0":{"text":"But promise me this—tell no one what the meat is. If Halia's soldiers find out, they'll punish you all.","source_cn":"但为避免意外，你要答应我，不可将这些肉是什么告诉其他人...","status":"matched","hash_xxh64":"0x9D8D22A9B5A075BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1520409031:1":{"text":"I-I understand!","source_cn":"当然……我明白！","status":"matched","hash_xxh64":"0xCA57140907FF06F5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1520409032:1":{"text":"Thank you!","source_cn":"谢谢！谢谢你们！<key:dialog2>","status":"matched","hash_xxh64":"0x8064727287F4539B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:0:1":{"text":"Yeah... I can guess too.","source_cn":"我也猜到了","status":"matched_runtime_gender","hash_xxh64":"0x0FBA458E539F4A99","variant_status":"runtime_gender_keys_target_same","male":"Yeah... I can guess too.","female":"Yeah... I can guess too.","variant_male_record_index":"78783","variant_female_record_index":"78784","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1520409020:1":{"text":"Nah. I enjoy my aura of mystery. Makes me more handsome.","source_cn":"我乐意。<key:dialog1>","status":"matched_runtime_gender","hash_xxh64":"0xFEC41A18C1F5D0B7","variant_status":"runtime_gender_keys_target_same","male":"Nah. I enjoy my aura of mystery. Makes me more handsome.","female":"Nah. I enjoy my aura of mystery. Makes me more handsome.","variant_male_record_index":"185913","variant_female_record_index":"185914","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:1:2":{"text":"Then say it.","source_cn":"那你怎么不说？","status":"matched_runtime_gender","hash_xxh64":"0xDF05F73C80D4A3C3","variant_status":"runtime_gender_keys_target_same","male":"Then say it.","female":"Then say it.","variant_male_record_index":"78785","variant_female_record_index":"78786","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1520409021:1":{"text":"And ruin my air of mystery? Never.","source_cn":"我乐意。<key:dialog2>","status":"matched_runtime_gender","hash_xxh64":"0xF1DB9127151B6BCF","variant_status":"runtime_gender_keys_target_same","male":"And ruin my air of mystery? Never.","female":"And ruin my air of mystery? Never.","variant_male_record_index":"185915","variant_female_record_index":"185916","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:2:3":{"text":"Stop talking in riddles.","source_cn":"不要当谜语人！","status":"matched_runtime_gender","hash_xxh64":"0xD1142D7C295F1324","variant_status":"runtime_gender_keys_target_same","male":"Stop talking in riddles.","female":"Stop talking in riddles.","variant_male_record_index":"78787","variant_female_record_index":"78788","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"A camp? Where?","source_cn":"营地？在哪？","status":"matched_runtime_gender","hash_xxh64":"0x1DAB5541025E02EF","variant_status":"runtime_gender_keys_target_same","male":"A camp? Where?","female":"A camp? Where?","variant_male_record_index":"78779","variant_female_record_index":"78780","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1520409007:1":{"text":"Yeah... the adults used to hunt beasts there...","source_cn":"我们的确在南边，之前大人们也会出去抓野兽……","status":"matched_runtime_gender","hash_xxh64":"0xC100A46F97EA1AA2","variant_status":"runtime_gender_keys_target_same","male":"Yeah... the adults used to hunt beasts there...","female":"Yeah... the adults used to hunt beasts there...","variant_male_record_index":"185899","variant_