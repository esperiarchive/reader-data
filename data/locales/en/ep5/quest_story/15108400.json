{"asset_key":"ep5/quest_story_15108400","episode":"ep5","category":"quest_story","story_id":"15108400","schema_version":1,"lang":"en","texts":{"say:2:1510840001:0":{"text":"That necklace healed his injuries instantly... I've got to figure out how the spellwork operates.","source_cn":"那条项链竟然能在一瞬间治愈珀尔修斯的伤势，我得想个办法...","status":"matched","hash_xxh64":"0xE995CA53BD8512AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510840002:0":{"text":"Even the Wildborn's high priestesses couldn't pull off something like that, right, Merlin?","source_cn":"梅林，那种魔法，连雅库伯尔的巫祭都做不到吧？","status":"matched","hash_xxh64":"0x12055B9E1AC4E85E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510840003:0":{"text":"I have a troubling suspicion.","source_cn":"我脑海里有个可怕的猜想……","status":"matched","hash_xxh64":"0x8F7BB91AFD3C5F8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1510840003":{"text":"I have a troubling suspicion.","source_cn":"我脑海里有个可怕的猜想……","status":"matched","hash_xxh64":"0x8F7BB91AFD3C5F8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510840004:0":{"text":"I'm not sure yet. I need more evidence. But tell me, <style=\"stress\"><player_name></style>, based on your judgment—do you believe Gorgonna truly loved Perseus?","source_cn":"还不能完全确定，我需要再观察观察。不过，<style=...","status":"matched_runtime_gender","hash_xxh64":"0x190720630B8B5E52","variant_status":"runtime_gender_keys_target_same","male":"I'm not sure yet. I need more evidence. But tell me, <style=\"stress\"><player_name></style>, based on your judgment—do you believe Gorgonna truly loved Perseus?","female":"I'm not sure yet. I need more evidence. But tell me, <style=\"stress\"><player_name></style>, based on your judgment—do you believe Gorgonna truly loved Perseus?","variant_male_record_index":"173930","variant_female_record_index":"173931","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1510840004":{"text":"I'm not sure yet. I need more evidence. But tell me, <style=\"stress\"><player_name></style>, based on your judgment—do you believe Gorgonna truly loved Perseus?","source_cn":"还不能完全确定，我需要再观察观察。不过，<style=stress><player_name></style>，以你的判断，你认为露真的爱着珀尔修斯吗？","status":"matched_runtime_gender","hash_xxh64":"0x190720630B8B5E52","variant_status":"runtime_gender_keys_target_same","male":"I'm not sure yet. I need more evidence. But tell me, <style=\"stress\"><player_name></style>, based on your judgment—do you believe Gorgonna truly loved Perseus?","female":"I'm not sure yet. I need more evidence. But tell me, <style=\"stress\"><player_name></style>, based on your judgment—do you believe Gorgonna truly loved Perseus?","variant_male_record_index":"173930","variant_female_record_index":"173931","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510840006:0":{"text":"It's impossible to know for certain how she felt.","source_cn":"我看不透露的真正想法。","status":"matched","hash_xxh64":"0xB743109D83073485","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510840007:0":{"text":"Come on. It's obvious. She loved him more than anything.","source_cn":"这有什么好怀疑的？明显是露的爱更多。","status":"matched","hash_xxh64":"0x0D5C20B7A80ECE7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510840008:0":{"text":"Was that sarcasm?","source_cn":"你在反讽？","status":"matched","hash_xxh64":"0x27E49E673F80767B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510840009:0":{"text":"Not this time.","source_cn":"我说的是真心话。","status":"matched","hash_xxh64":"0x23A1D432CAFCEA79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510840010:0":{"text":"And your reasoning?","source_cn":"原因？","status":"matched","hash_xxh64":"0x80BADF62EBB6537C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510840011:0":{"text":"It's not something I can explain like a research paper... Just a gut feeling.","source_cn":"这也没法像搞研究那样分析个所以然……就当是我的直觉吧。","status":"matched","hash_xxh64":"0x0248495818F07D31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510840012:0":{"text":"I don't put much stock in a man's gut feeling, but I trust yours.","source_cn":"虽然我不怎么相信男人的直觉，但我相信你的直觉。","status":"matched","hash_xxh64":"0xABD9CEC0AE15738C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510840013:0":{"text":"... Well, thank you. I think.","source_cn":"哦，那真是谢谢你的信任。","status":"matched","hash_xxh64":"0x64306AB46EDA5EB1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1510840014:0":{"text":"In any case, we need to focus. There's a mechanism to solve.","source_cn":"总之，先着眼破解眼前的机关吧……","status":"matched","hash_xxh64":"0x1A9633618E21B95F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"She loved him deeply.","source_cn":"很爱","status":"matched_runtime_gender","hash_xxh64":"0xDE83BACE34F22646","variant_status":"runtime_gender_keys_target_same","male":"She loved him deeply.","female":"She loved him deeply.","variant_male_record_index":"74760","variant_female_record_index":"74761","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"No. It wasn't love.","source_cn":"不爱","status":"matched_runtime_gender","hash_xxh64":"0xB48D4CA93D34A022","variant_status":"runtime_gender_keys_target_same","male":"No. It wasn't love.","female":"No. It wasn't love.","variant_male_record_index":"74762","variant_female_record_index":"74763","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510840005:0":{"text":"I feel the same.","source_cn":"我和你想的一样。","status":"matched_runtime_gender","hash_xxh64":"0x4BCDA0BFBCFA3EEA","variant_status":"runtime_gender_keys_target_same","male":"I feel the same.","female":"I feel the same.","variant_male_record_index":"173932","variant_female_record_index":"173933","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:2:3":{"text":"Hard to say...","source_cn":"看不懂","status":"matched_runtime_gender","hash_xxh64":"0x11B7433197A27FD5","variant_status":"runtime_gender_keys_target_same","male":"Hard to say...","female":"Hard to say...","variant_male_record_index":"74764","variant_female_record_index":"74765","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"What is it?","source_cn":"什么猜想？","status":"matched_runtime_gender","hash_xxh64":"0x3D79AC8BC1CB3A35","variant_status":"runtime_gender_keys_target_same","male":"What is it?","female":"What is it?","variant_male_record_index":"74758","variant_female_record_index":"74759","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":21,"localized_text_count":20,"speaker_count":2}}