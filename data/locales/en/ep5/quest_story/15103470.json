{"asset_key":"ep5/quest_story_15103470","episode":"ep5","category":"quest_story","story_id":"15103470","schema_version":1,"lang":"en","texts":{"say:2:1510347001:0":{"text":"How come you're here...?","source_cn":"是你们？你们怎么……","status":"matched","hash_xxh64":"0x00070040B977F6CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510347002:0":{"text":"We know something happened in the camp. What's going on?","source_cn":"珀尔修斯，我们知道营地出事了，这是怎么了？","status":"matched","hash_xxh64":"0x8DD57C139C3ECC89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510347003:1":{"text":"The healer is checking on the ill soldiers. It may be food poisoning.","source_cn":"军医正在检查，可能是食物中毒。","status":"matched","hash_xxh64":"0x272CE2C8F53EF23D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510347004:0":{"text":"General, that's not it! I've never seen symptoms like this!","source_cn":"珀尔修斯统帅，不是中毒！我从来没见过这种症状！","status":"matched","hash_xxh64":"0x18B883DF08B36A5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510347005:0":{"text":"They're so thin... like they haven't eaten for months. Blood and fire! Even while checking their heartbeat, I can feel their chests collapsing like punctured waterskins!","source_cn":"他们就像饿了几个月的人那么消瘦，甚至就在我检查心跳的时...","status":"matched","hash_xxh64":"0xA8C6786650B3EBCF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510347006:0":{"text":"This is not a sickness... <style=\"highlight\">This can only be a curse!</style>","source_cn":"诅咒……<style=highlight>这只可能是诅...","status":"matched","hash_xxh64":"0x1D3A1838C46373CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510347007:1":{"text":"What? What did they do to deserve this curse?","source_cn":"什么？他们做了什么，会招致诅咒？","status":"matched","hash_xxh64":"0x5BAB42A65B66FC50","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1510347007":{"text":"What? What did they do to deserve this curse?","source_cn":"什么？他们做了什么，会招致诅咒？","status":"matched","hash_xxh64":"0x5BAB42A65B66FC50","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510347008:1":{"text":"You're saying that the locust meat is causing this?","source_cn":"你是说，因为食用了针蝗的肉。","status":"matched_runtime_gender","hash_xxh64":"0x2EE4FFF91E89B09F","variant_status":"runtime_gender_keys_target_same","male":"You're saying that the locust meat is causing this?","female":"You're saying that the locust meat is causing this?","variant_male_record_index":"179936","variant_female_record_index":"179937","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510347009:0":{"text":"Ioxus, are there any soldiers who didn't eat the locust meat?","source_cn":"佐索，今晚有没有没分到针蝗肉的士兵？","status":"matched","hash_xxh64":"0x0233D209D7CB31A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510347010:0":{"text":"I didn't, and a few soldiers who just returned from patrol didn't either.","source_cn":"我和其他几个弟兄巡逻才回来，还没来得及吃。","status":"matched","hash_xxh64":"0xA7DD1832327431A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510347011:0":{"text":"You didn't either.","source_cn":"你也好好的。","status":"matched","hash_xxh64":"0x405FCD8782C71A1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510347012:0":{"text":"I didn't need to eat.","source_cn":"我不需要。<key:dialog2>","status":"matched","hash_xxh64":"0x94504DCA99062380","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1510347013:0":{"text":"Your portion was given to other soldiers on duty...","source_cn":"统帅让给了其他轮值的弟兄……","status":"matched","hash_xxh64":"0xA58C9AC81481BC31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:21:1510347013":{"text":"Your portion was given to other soldiers on duty...","source_cn":"统帅让给了其他轮值的弟兄……","status":"matched","hash_xxh64":"0xA58C9AC81481BC31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1510347014:0":{"text":"Perseus, I know you still don't trust us, but lives are at stake. Magic might be able to dispel this curse. Let us try.","source_cn":"珀尔修斯，我知道你仍未信任我们，但此刻人命关天，魔法或...","status":"matched","hash_xxh64":"0xF50CFA1BCF0EA555","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1510347015:0":{"text":"... Come with us.","source_cn":"……跟我来。","status":"matched","hash_xxh64":"0x77A597EEDA174080","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:21:0:1":{"text":"The truth is in front of you.","source_cn":"看来真相已经很明显了","status":"matched_runtime_gender","hash_xxh64":"0x337DBE33A6ED4E8F","variant_status":"runtime_gender_keys_target_same","male":"The truth is in front of you.","female":"The truth is in front of you.","variant_male_record_index":"76614","variant_female_record_index":"76615","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:21:1:2":{"text":"Admit it. Face the facts.","source_cn":"快承认吧！别犹豫了！","status":"matched_runtime_gender","hash_xxh64":"0x36326371B13FF4B2","variant_status":"runtime_gender_keys_target_same","male":"Admit it. Face the facts.","female":"Admit it. Face the facts.","variant_male_record_index":"76616","variant_female_record_index":"76617","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"Hardly surprising for people who've eaten insects.","source_cn":"连虫子都吃的人，怎样都不奇怪","status":"matched_runtime_gender","hash_xxh64":"0x61D574CF6CEEF9F9","variant_status":"runtime_gender_keys_target_same","male":"Hardly surprising for people who've eaten insects.","female":"Hardly surprising for people who've eaten insects.","variant_male_record_index":"76608","variant_female_record_index":"76609","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"Think about what they ate last night.","source_cn":"你们不如反思反思晚上吃了什么","status":"matched_runtime_gender","hash_xxh64":"0xBD31D83F20DBA0FA","variant_status":"runtime_gender_keys_target_same","male":"Think about what they ate last night.","female":"Think about what they ate last night.","variant_male_record_index":"76610","variant_female_record_index":"76611","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:2:3":{"text":"Are you stupid? The answer is obvious!","source_cn":"愚蠢，当然是他们吃错东西了！","status":"matched_runtime_gender","hash_xxh64":"0x5C691F7D754908E2","variant_status":"runtime_gender_keys_target_same","male":"Are you stupid? The answer is obvious!","female":"Are you stupid? The answer is obvious!","variant_male_record_index":"76612","variant_female_record_index":"76613","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:珀尔修斯":{"text":"Perseus","source":"珀尔修斯","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"},"speaker:军医桑罗斯":{"text":"Healer Xanthus","source":"军医桑罗斯","status":"matched_dia