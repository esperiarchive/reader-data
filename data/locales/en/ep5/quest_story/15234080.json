{"asset_key":"ep5/quest_story_15234080","episode":"ep5","category":"quest_story","story_id":"15234080","schema_version":1,"lang":"en","texts":{"say:2:1523408001:0":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1523408002:1":{"text":"Regulus, don't let Aurelin's nonsense get to you.","source_cn":"殿下，您不必忧愁，更不必听信奥勒留的胡言。","status":"matched","hash_xxh64":"0x29CEDF1A10C7EA14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1523408003:1":{"text":"The guards should have stopped this. I'll make sure they're punished for their negligence.","source_cn":"这次想必是护卫失责，才让他找到机会来您面前说三道四，我...","status":"matched","hash_xxh64":"0xD53433BDBA7A3289","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1523408004:1":{"text":"No, please don't punish the guards. They aren't at fault.","source_cn":"不，不要责罚他们。护卫没有错。","status":"matched","hash_xxh64":"0x5A3546A023B880BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1523408005:1":{"text":"... I ordered them to let Aurelin in.","source_cn":"……是我下令，让他们不要阻拦奥勒留的。","status":"matched","hash_xxh64":"0x50A72D5D830E44B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1523408006:1":{"text":"Regulus?!","source_cn":"殿下？！","status":"matched","hash_xxh64":"0x0FB113AFD4B9077C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1523408007:1":{"text":"I can't just rely on your account to understand their demands.","source_cn":"他们抗议了这么久，我不能只通过老师您的转述来了解他们的主张。","status":"matched","hash_xxh64":"0x369EC65869DE87EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1523408008:1":{"text":"I need to know... whether my decision to sign the agreement is really so dishonorable.","source_cn":"我想知道，我签署的停战合约真的有那么不堪吗……","status":"matched","hash_xxh64":"0xAA0F4E47D7B73A96","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1523408009:1":{"text":"Is it wrong to compromise temporarily for the sake of peace and survival?","source_cn":"为了和平和生存，暂时妥协，难道是错的吗？","status":"matched","hash_xxh64":"0x517431C09D058D8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1523408010:1":{"text":"I'm not sure... Could my father have chosen the wrong person to be his successor...","source_cn":"我不知道……就像我也不知道，父亲要我继承领主之位，是不...","status":"matched","hash_xxh64":"0xBE8536FC366A48C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1523408011:1":{"text":"<shk>Regulus!</shk>","source_cn":"<shk>——殿下！</shk>","status":"matched","hash_xxh64":"0xA9A0DFBD48BE5096","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1523408012:1":{"text":"... Whatever the circumstances, please never doubt your father and lose faith in yourself.","source_cn":"……无论如何，请您不要说这样的话。不要质疑赫伦尼殿下，...","status":"matched","hash_xxh64":"0x7D01673AAEC4C854","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1523408013:1":{"text":"You have my support, and that of many fellow councilmen. Contrary to Aurelin's assertion, our backing is not merely out of loyalty to your family.","source_cn":"我，还有更多议事官，我们支持您，并不像奥勒留口中所说那...","status":"matched","hash_xxh64":"0xA97D7AD02B538995","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1523408014:1":{"text":"You used your own personal wealth to aid the flood victims, let the homeless shelter and rest inside the palace, and met the Wildborn alone to end the war...","source_cn":"您用自己的私产赈灾，允许无家可归的人们进入宫殿内避雨休...","status":"matched","hash_xxh64":"0xD988EB8994C2AC8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1523408015:1":{"text":"We remember everything you've done.","source_cn":"您所做过的每一件事，我们都看在眼里。","status":"matched","hash_xxh64":"0xAE30B284978B32AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1523408016:1":{"text":"Your strategies and plans may not yet be mature, but every time you introduce a policy, you put the people's interests first—and that's commendable.","source_cn":"固然，您的思维仍稍显稚嫩，策略与计划确实有许多不足。但...","status":"matched","hash_xxh64":"0x0D1EA3B4E1E2D2C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1523408017:1":{"text":"Halia now needs a ruler who can truly empathize with the people's sufferings.","source_cn":"如今的呼临城需要一位能真正体察民众苦难的领主，才能从伤...","status":"matched","hash_xxh64":"0x1E5B5D564775009A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1523408018:1":{"text":"That person can only be you.","source_cn":"这个人，只能是您。","status":"matched","hash_xxh64":"0x527A27D741264A19","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1523408019:1":{"text":"R-Really?\nBut Aurelin said...","source_cn":"真……真的吗？\\n可是奥勒留他们都说……","status":"matched","hash_xxh64":"0x610CFC0701236600","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1523408020:1":{"text":"Aurelin's protests have thrown the city into disarray, but you managed to restore order by deploying your personal guards.","source_cn":"奥勒留为了抗议，集结士兵终日游行，导致呼临城内秩序不稳...","status":"matched","hash_xxh64":"0x27D2428CF1746A32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1523408021:1":{"text":"This alone proves he doesn't truly care for the people. As a leader, he's far inferior to you.","source_cn":"仅凭这一点就能看出，他并不能做到真正为民众考虑，远不如您。","status":"matched","hash_xxh64":"0xB0BA96DE36C21ACC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1523408022:1":{"text":"This isn't just my opinion. Your guards, the people you have helped, and those who haven't been swayed by Aurelin think so too.","source_cn":"这不止是我一人的观点。所有您的护卫，所有受过您恩典的民...","status":"matched","hash_xxh64":"0x84A030BEE26C6A68","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:24:1523408022":{"text":"This isn't just my opinion. Your guards, the people you have helped, and those who haven't been swayed by Aurelin think so too.","source_cn":"这不止是我一人的观点。所有您的护卫，所有受过您恩典的民众，所有还未被奥勒留蛊惑的人们，都是这样想的。","status":"matched","hash_xxh64":"0x84A030BEE26C6A68","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1523408023:1":{"text":"... I think I get it now.","source_cn":"……嗯，我明白了。","status":"matched","hash_xxh64":"0xB0832F13642A91DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1523408024:1":{"text":"I can't throw in the towel now; that would just play right into Aurelin's hands.","source_cn":"我不能再垂头丧气的了，否则只会让奥勒留的计谋得逞，引得...","status":"matched","hash_xxh64":"0x68AFDCDB35E05E44","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1523408025:0":{"text":"Master Bakis, how are the bitter corn crops coming along? Are they fit to be eaten?","source_cn":"比博老师，苦苞穗的种植情况怎么样？能不能直接作为食物？","status":"matched","hash_xxh64":"0xCBD23375D841C7CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1523408026:1":{"text":"We were just about to brief you on this matter...","source_cn":"我正要向您汇报这件事……","status":"matched","hash_xxh64":"0x258B58F51E74CE6E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:29:1523408027:1":{"text":"Bakis explains the problems related to the bitter corns to Abundius.","source_cn":"","status":"matched","hash_xxh64":"0x55002DA7DC07C9AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:30:1523408028:1":{"text":"And proposes to <style=\"highlight\">recruit scholars to continue Paeon's work</style>.","source_cn":"","status":"matched","hash_xxh64":"0x5E058DD426A98C16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1523408029:1":{"text":"I see.","source_cn":"好，我知道了。","status":"matched","hash_xxh64":"0x3FEF6278E82A4F44","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1523408030:1":{"text":"I'll issue a decree right away for the recruitment.","source_cn":"我这就颁布命令，在城内寻找研究植物的学者。","status":"matched","hash_xxh64":"0xDE50499093DCB88A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1523408031:1":{"text":"We can also dispatch teams to seek help from nearby towns.","source_cn":"也可以派人向周围的城邦寻求帮助。","status":"matched","hash_xxh64":"0xDAE61405FED5731A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1523408032:1":{"text":"Great, let's do that.","source_cn":"嗯，就这么办。","status":"matched","hash_xxh64":"0xCFC1747B892F7B64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1523408033:1":{"text":"<style=\"stress\"><player_name></style>, I'll get in touch once we find scholars who fit the bill.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x83EA75B8DBFAE4DE","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, I'll get in touch once we find scholars who fit the bill.","female":"<style=\"stress\"><player_name></style>, I'll get in touch once we find scholars who fit the bill.","variant_male_record_index":"188766","variant_female_record_index":"188767","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1523408034:1":{"text":"Thank you for everything you've done for Halia.","source_cn":"感谢你为呼临城所做的一切。","status":"matched_runtime_gender","hash_xxh64":"0x465F063A19F7BAA3","variant_status":"runtime_gender_keys_target_same","male":"Thank you for everything you've done for Halia.","female":"Thank you for everything you've done for Halia.","variant_male_record_index":"188768","variant_female_record_index":"188769","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:0:1":{"text":"Buck up, Abundius.","source_cn":"打起精神来，阿邦德","status":"matched_runtime_gender","hash_xxh64":"0xA2BA8ECB7EBED005","variant_status":"runtime_gender_keys_target_same","male":"Buck up, Abundius.","female":"Buck up, Abundius.","variant_male_record_index":"79111","variant_female_record_index":"79112","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:1:2":{"text":"Don't let them down.","source_cn":"别让支持你的人失望","status":"matched_runtime_gender","hash_xxh64":"0xE24E8DB6F584C13F","variant_status":"runtime_gender_keys_target_same","male":"Don't let them down.","female":"Don't let them down.","variant_male_record_index":"79113","variant_female_record_index":"79114","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:领主阿邦德":{"text":"Abundius","source":"领主阿邦德","status":"matched_dialogue_flow"},"speaker:学者比博":{"text":"Scholar Bakis","source":"学者比博","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":38,"localized_text_count":37,"speaker_count":3}}