{"asset_key":"ep5/quest_story_15108100","episode":"ep5","category":"quest_story","story_id":"15108100","schema_version":1,"lang":"en","texts":{"say:1:1510810001:0":{"text":"... There's a sound outside.","source_cn":"……外面有声音。","status":"matched","hash_xxh64":"0xE714B1548D5E4D6A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1510810002:0":{"text":"Probably just activity from the outpost. You're not going to get silence this close to the lines.","source_cn":"很正常，这里离哨卡太近，晚上睡觉都睡不安稳。","status":"matched","hash_xxh64":"0x8A606CDF98EAC5D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510810003:0":{"text":"No. It's not an ordinary sound.","source_cn":"不，不是寻常的声音。","status":"matched","hash_xxh64":"0x2B2A2436DB3614CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510810004:0":{"text":"Those Halians... they're <style=\"highlight\">forming ranks</style>!","source_cn":"那些呼临人……<style=highlight>在列队...","status":"matched","hash_xxh64":"0xA2E74252A5D21D82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1510810004":{"text":"Those Halians... they're <style=\"highlight\">forming ranks</style>!","source_cn":"那些呼临人……<style=highlight>在列队</style>！","status":"matched","hash_xxh64":"0xA2E74252A5D21D82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510810005:1":{"text":"... We should head to <style=\"highlight\">Windchoke Fen</style>. That's where the terrain evens out. If a large-scale conflict breaks out, that's where it'll happen.","source_cn":"……我们该去<style=highlight>风沼战场...","status":"matched","hash_xxh64":"0x182D697125B0DD7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510810006:0":{"text":"Just as I warned—the Hunting Goddess' presence was bound to accelerate things.","source_cn":"如我所言，狩猎神现世……必定会为战争带来极为可怕的变数。","status":"matched","hash_xxh64":"0xB16CC79F2184E593","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510810007:0":{"text":"As for you, long-horns, you'd better sit this one out. If you charge in now, you'll be surrounded, with no allies on either side.","source_cn":"长角的雅库伯尔人就别去了，免得被围攻。现在你可是两方的公敌。","status":"matched","hash_xxh64":"0xE992F9332DBFAD9E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510810008:0":{"text":"You—!","source_cn":"你……！<key:dialog2>","status":"matched","hash_xxh64":"0x108BAE6D781DEAA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510810009:1":{"text":"Gala still needs care. Nazrik, please look after her.","source_cn":"加拉尚需看护，那非，请照看好你的同族。","status":"matched","hash_xxh64":"0xFD98BA5D261805D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:13::0":{"text":"Echo Stone","source_cn":"传讯石","status":"matched","hash_xxh64":"0x81B8E337414F1DAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510810010:0":{"text":"Take this <style=\"highlight\">echo stone</style>. It'll help us stay in contact.","source_cn":"请收下这块<style=highlight>传讯石</...","status":"matched","hash_xxh64":"0x52996572748FF8CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510810011:0":{"text":"Also, keep an eye on the <style=\"highlight\">crystal on the table</style>. If it reacts, contact me immediately.","source_cn":"以及，麻烦你多加留意<style=highlight>...","status":"matched","hash_xxh64":"0xAF3E9B60C0BF2D3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1510810012:0":{"text":"Reacts to what?","source_cn":"会有什么变化？","status":"matched","hash_xxh64":"0x3D053256499E41F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1510810013:1":{"text":"It's attuned to detect high-level magical surges. When something happens... you'll know.","source_cn":"它能识别大范围的魔力流动，若变化之刻来临，你必会知晓。","status":"matched","hash_xxh64":"0xAAFA3E6ECEEC7EEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510810014:0":{"text":"Hmph. Fine.","source_cn":"啧……知道了。","status":"matched","hash_xxh64":"0x42ACA3B3F6F2FF75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"Are they launching an assault?!","source_cn":"他们要总攻？！","status":"matched_runtime_gender","hash_xxh64":"0x20F0E6761A02D1FF","variant_status":"runtime_gender_keys_target_same","male":"Are they launching an assault?!","female":"Are they launching an assault?!","variant_male_record_index":"75142","variant_female_record_index":"75143","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:1:2":{"text":"Is Lieutenant Lygos leading them?!","source_cn":"副将隆尔要出兵了？！","status":"matched_runtime_gender","hash_xxh64":"0xB28D30BD134A8868","variant_status":"runtime_gender_keys_target_same","male":"Is Lieutenant Lygos leading them?!","female":"Is Lieutenant Lygos leading them?!","variant_male_record_index":"75144","variant_female_record_index":"75145","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:那非":{"text":"Nazrik","source":"那非","status":"matched_dialogue_flow"},"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"m