{"asset_key":"ep5/quest_story_15106310","episode":"ep5","category":"quest_story","story_id":"15106310","schema_version":1,"lang":"en","texts":{"say:1:1510631001:0":{"text":"People. Two of them.","source_cn":"人。两个人。","status":"matched","hash_xxh64":"0x244806AEC9D26ACF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1510631002:1":{"text":"You're... a puppet? But you can talk.","source_cn":"你是……木偶？但可以发声。","status":"matched","hash_xxh64":"0x3909B53A10F5DB26","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510631003:0":{"text":"How fascinating. Looks like somebody has imbued you with magic well.","source_cn":"真奇妙，你身上仿佛也被施加了魔法。","status":"matched","hash_xxh64":"0xE8EDC03156EF65CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510631004:1":{"text":"People... can help Sedecim. <style=\"highlight\">Save Master</style>.","source_cn":"人，可以帮十六，<style=highlight>救主...","status":"matched","hash_xxh64":"0xE1347ADFB7F85161","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1510631004":{"text":"People... can help Sedecim. <style=\"highlight\">Save Master</style>.","source_cn":"人，可以帮十六，<style=highlight>救主人</style>。","status":"matched","hash_xxh64":"0xE1347ADFB7F85161","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510631005:0":{"text":"I am Sedecim.","source_cn":"十六是十六。","status":"matched_runtime_gender","hash_xxh64":"0xDD534817A2B1191A","variant_status":"runtime_gender_keys_target_same","male":"I am Sedecim.","female":"I am Sedecim.","variant_male_record_index":"176043","variant_female_record_index":"176044","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"Sedecim? Is that your name?","source_cn":"十六？这是你的名字吗？","status":"matched_runtime_gender","hash_xxh64":"0xCDE4DF8B5ABC97BC","variant_status":"runtime_gender_keys_target_same","male":"Sedecim? Is that your name?","female":"Sedecim? Is that your name?","variant_male_record_index":"75404","variant_female_record_index":"75405","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1510631006:0":{"text":"Master. <style=\"highlight\">Tully</style>.","source_cn":"主人。<style=highlight>塔利</sty...","status":"matched_runtime_gender","hash_xxh64":"0xF8C3B18F6D23E056","variant_status":"runtime_gender_keys_target_same","male":"Master. <style=\"highlight\">Tully</style>.","female":"Master. <style=\"highlight\">Tully</style>.","variant_male_record_index":"176045","variant_female_record_index":"176046","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:1:2":{"text":"And who is your master?","source_cn":"你的主人是谁？","status":"matched_runtime_gender","hash_xxh64":"0xD87F52D72DBEADF0","variant_status":"runtime_gender_keys_target_same","male":"And who is your master?","female":"And who is your master?","variant_male_record_index":"75406","variant_female_record_index":"75407","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510631007:0":{"text":"Living? I... don't understand.","source_cn":"活？十六，不明白。","status":"matched_runtime_gender","hash_xxh64":"0xE9B938C44D72241C","variant_status":"runtime_gender_keys_target_same","male":"Living? I... don't understand.","female":"Living? I... don't understand.","variant_male_record_index":"176047","variant_female_record_index":"176048","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:2:3":{"text":"Are there other living people here?","source_cn":"这里还有活人吗？","status":"matched_runtime_gender","hash_xxh64":"0x57CA87C7A4551C66","variant_status":"runtime_gender_keys_target_same","male":"Are there other living people here?","female":"Are there other living people here?","variant_male_record_index":"75408","variant_female_record_index":"75409","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510631008:0":{"text":"Hold on, before we help the puppet, we need to figure out what just happened.","source_cn":"先别急着答应它。我们必须弄清刚才的事。","status":"matched_runtime_gender","hash_xxh64":"0xFAFE41D80E475A1E","variant_status":"runtime_gender_keys_target_same","male":"Hold on, before we help the puppet, we need to figure out what just happened.","female":"Hold on, before we help the puppet, we need to figure out what just happened.","variant_male_record_index":"176049","variant_female_record_index":"176050","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1510631009:1":{"text":"Sedecim, what were those creatures just now? Why did they run away?","source_cn":"十六，方才的生物是什么？它们为何会逃跑？","status":"matched","hash_xxh64":"0xF48B19FB3AFCD9C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510631010:0":{"text":"I don't know.","source_cn":"不知道。<key:dialog1>","status":"matched","hash_xxh64":"0xC744A7EDAF2D5C16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510631011:0":{"text":"But. They are <style=\"highlight\">afraid of light</style>.","source_cn":"但是，它们，<style=highlight>怕光</...","status":"matched","hash_xxh64":"0xCAFD75077BC97823","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510631012:0":{"text":"You... make light. They... run away.","source_cn":"你们，点亮。它们……逃跑。","status":"matched","hash_xxh64":"0xB50AF91E0FAF333D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1510631013:1":{"text":"Creatures that live in darkness and fear the light...","source_cn":"生活在黑暗中，畏光的生物……","status":"matched","hash_xxh64":"0x331E8E7AFA897E3F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1510631014:1":{"text":"They might be creations of the fallen god Sarethiel, or some of his kin. If even his creations fear the light, then the God of Harvest himself must, too.","source_cn":"它们可能是赛图恩神堕后的造物，或是类似的眷属。如果连造...","status":"matched_runtime_gender","hash_xxh64":"0xA9C0B9FD2B606CE6","variant_status":"runtime_gender_keys_target_same","male":"They might be creations of the fallen god Sarethiel, or some of his kin. If even his creations fear the light, then the God of Harvest himself must, too.","female":"They might be creations of the fallen god Sarethiel, or some of his kin. If even his creations fear the light, then the God of Harvest himself must, too.","variant_male_record_index":"176056","variant_female_record_index":"176057","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1510631015:1":{"text":"That would also explain why he brought about this endless darkness. He needs to wrap himself in it, to hide from the sting of the light.","source_cn":"这也能解释他为何降下了无尽的黑暗。因为他需要用黑暗裹紧...","status":"matched_runtime_gender","hash_xxh64":"0x66FA3EAC75A24A8A","variant_status":"runtime_gender_keys_target_same","male":"That would also explain why he brought about this endless darkness. He needs to wrap himself in it, to hide from the sting of the light.","female":"That would also explain why he brought about this endless darkness. He needs to wrap himself in it, to hide from the sting of the light.","variant_male_record_index":"176058","variant_female_record_index":"176059","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:18:1510631015":{"text":"That would also explain why he brought about this endless darkness. He needs to wrap himself in it, to hide from the sting of the light.","source_cn":"这也能解释他为何降下了无尽的黑暗。因为他需要用黑暗裹紧自己，藏身其中，以免被阳光刺痛。","status":"matched_runtime_gender","hash_xxh64":"0x66FA3EAC75A24A8A","variant_status":"runtime_gender_keys_target_same","male":"That would also explain why he brought about this endless darkness. He needs to wrap himself in it, to hide from the sting of the light.","female":"That would also explain why he brought about this endless darkness. He needs to wrap himself in it, to hide from the sting of the light.","variant_male_record_index":"176058","variant_female_record_index":"176059","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510631016:1":{"text":"Exactly. If we don't find a way to get to him, he'll hide in this darkness forever.","source_cn":"没错。倘若我们不设法找到他，他将永远藏身在黑暗中。","status":"matched_runtime_gender","hash_xxh64":"0xB2F0794C17EF743D","variant_status":"runtime_gender_keys_target_same","male":"Exactly. If we don't find a way to get to him, he'll hide in this darkness forever.","female":"Exactly. If we don't find a way to get to him, he'll hide in this darkness forever.","variant_male_record_index":"176060","variant_female_record_index":"176061","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1510631017:1":{"text":"The only way to force him out is to <style=\"highlight\">drive out the darkness with light</style>.","source_cn":"唯有<style=highlight>用光明驱逐黑暗<...","status":"matched_runtime_gender","hash_xxh64":"0x364226EC4B1AFDA9","variant_status":"runtime_gender_keys_target_same","male":"The only way to force him out is to <style=\"highlight\">drive out the darkness with light</style>.","female":"The only way to force him out is to <style=\"highlight\">drive out the darkness with light</style>.","variant_male_record_index":"176062","variant_female_record_index":"176063","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1510631019:1":{"text":"The sun, or the light, on this stone tablet... it might have something to do with the God of Harvest's fall from grace.","source_cn":"这幅石板画上的太阳，或是光芒，或许与丰饶神之堕落有关。","status":"matched_runtime_gender","hash_xxh64":"0x367CD9AC21522853","variant_status":"runtime_gender_keys_target_same","male":"The sun, or the light, on this stone tablet... it might have something to do with the God of Harvest's fall from grace.","female":"The sun, or the light, on this stone tablet... it might have something to do with the God of Harvest's fall from grace.","variant_male_record_index":"176066","variant_female_record_index":"176067","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:21::2":{"text":"Stone Tablet","source_cn":"石板画","status":"matched","hash_xxh64":"0x251F89BFC76F9351","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1510631020:1":{"text":"But... it doesn't look complete.","source_cn":"只是，看起来它还并不完全。","status":"matched_runtime_gender","hash_xxh64":"0x54550629F66DC18F","variant_status":"runtime_gender_keys_target_same","male":"But... it doesn't look complete.","female":"But... it doesn't look complete.","variant_male_record_index":"176068","variant_female_record_index":"176069","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1510631021:1":{"text":"Light... I have seen it before.","source_cn":"光……十六见过。","status":"matched","hash_xxh64":"0xFDA57315E08B7881","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1510631022:1":{"text":"Where... I know where.","source_cn":"在哪……十六知道。","status":"matched","hash_xxh64":"0xA701C8618D47A440","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:26:1510631022":{"text":"Where... I know where.","source_cn":"在哪……十六知道。","status":"matched","hash_xxh64":"0xA701C8618D47A440","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1510631023:0":{"text":"Two people, save Master. I... will take you.","source_cn":"两个人，救主人。十六……带人去。","status":"matched","hash_xxh64":"0x3ED221245C360BCF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1510631024:0":{"text":"If you help us get rid of this darkness, we'll do everything we can to help you.","source_cn":"如果帮助我们驱散黑暗，我们必当尽力帮你。","status":"matched","hash_xxh64":"0xA1E50F4543E3C99F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1510631025:1":{"text":"Saving Master... is good.","source_cn":"救主人……是好的。","status":"matched","hash_xxh64":"0x2155F79D0D200AD2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1510631026:0":{"text":"I will take you there.","source_cn":"十六，带人去。","status":"matched","hash_xxh64":"0x4719EB11B48FE8FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:0:1":{"text":"You know?","source_cn":"你知道？","status":"matched_runtime_gender","hash_xxh64":"0x4C433636527AC8F9","variant_status":"runtime_gender_keys_target_sa