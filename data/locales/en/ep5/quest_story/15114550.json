{"asset_key":"ep5/quest_story_15114550","episode":"ep5","category":"quest_story","story_id":"15114550","schema_version":1,"lang":"en","texts":{"say:2:1511455001:1":{"text":"What did you do to Dunn?! He was your faithful devotee!","source_cn":"你……你对顿做了什么？！他是你的信徒！","status":"matched","hash_xxh64":"0x0C0AE8A4443007C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1511455002:1":{"text":"A true hunter knows the measure of their prey.","source_cn":"真正的猎手，要会正确评估猎物的力量。","status":"matched","hash_xxh64":"0x86B6D40FD5BFD4AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1511455003:1":{"text":"To fall by my hand, that is his honor.","source_cn":"能死在我手中，是他的荣幸。","status":"matched","hash_xxh64":"0xC2897853F4B5963B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1511455004:1":{"text":"Better that than wallowing in the filth of slaughtering each other like frightened animals. At least I saw his courage before he died. You should be happy for him.","source_cn":"比起那些死于自相残杀的战士，至少我见证了他的勇气。你该...","status":"matched","hash_xxh64":"0x1DCE9D3C6272F4D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1511455005:1":{"text":"You knew they were killing each other... and you didn't stop it?!","source_cn":"你知道其他人在互相残杀……为什么不阻止他们？！","status":"matched","hash_xxh64":"0x59736582FF7BAFC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1511455006:1":{"text":"And that Hypogean! She ruined everything!","source_cn":"还有那个恶魔！她搅乱了整个猎血节！","status":"matched","hash_xxh64":"0x2D9020E0EC5E58C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1511455007:1":{"text":"Ruined? Hah. You Wildborn are my creations. Like the beasts of the jungle, your only purpose is to amuse me.","source_cn":"你们——雅库伯尔人，是我的造物。你们和丛林里的野兽一样...","status":"matched","hash_xxh64":"0x0FF935B932400A2C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1511455008:1":{"text":"Your blood, your screams, your deaths—these are the offerings I demand.","source_cn":"你们应当将一切都敬献给我！鲜血、惨叫——还有生命！","status":"matched","hash_xxh64":"0x862BD2C9A4072695","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1511455009:1":{"text":"As for that Hypogean? A scrap of shadow, nothing more. Yet her little trick delighted me.","source_cn":"那个恶魔？她做了些有意思的事，让战士互相猎杀，才能决出...","status":"matched","hash_xxh64":"0xC6670B21D0492DE8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1511455010:1":{"text":"She turned you on each other and stripped away the weak. That alone was worth my laughter.","source_cn":"她的存在不值一提，但她所做的事可博我一笑，不枉来这世间一回。","status":"matched","hash_xxh64":"0xAD4F7D437FBAA7A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1511455011:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1511455012:1":{"text":"So to you... our lives mean nothing? That's all we are to you?","source_cn":"在你看来，这就是我们存在的意义……？！","status":"matched","hash_xxh64":"0xF0CFDA3890BFEB3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1511455012":{"text":"So to you... our lives mean nothing? That's all we are to you?","source_cn":"在你看来，这就是我们存在的意义……？！","status":"matched","hash_xxh64":"0xF0CFDA3890BFEB3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1511455013:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1511455014:1":{"text":"Heh. At last, you hold back. You did not strike at your exalted goddess.","source_cn":"呵，你居然忍住了，没有挑战崇高的神。","status":"matched","hash_xxh64":"0x6C839A313B778238","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1511455015:1":{"text":"It seems you've learned when to bide your fangs. Good.","source_cn":"看来你已经懂得如何评判狩猎的时机了，很好。","status":"matched","hash_xxh64":"0x557D57F62FD9CC48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1511455016:1":{"text":"Then I grant you the final, true trial—<style=\"highlight\">to face my avatar</style>.","source_cn":"我允许你接受最后的，真正的考验——<style=hig...","status":"matched","hash_xxh64":"0x37F21760DF92F69F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1511455017:1":{"text":"Defeat it, and I grant you the <style=\"highlight\">Power of Tracking</style>, and the right to revel in blood as a true warrior.","source_cn":"若你能战胜分身，<style=highlight>追踪...","status":"matched","hash_xxh64":"0x6F67E6813DF85EEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1511455018:1":{"text":"But fail... and the Wildborn will have no champion. The festival ends with no victor... and no survivors.","source_cn":"若你失败，那么雅库伯尔便没有令我满意的勇士，猎血节没有...","status":"matched","hash_xxh64":"0xFCF120C1ABE46987","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1511455019:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"She's a goddess! You can't fight her!","source_cn":"她是神！你不打过她！","status":"matched_runtime_gender","hash_xxh64":"0x1E24FC812F706330","variant_status":"runtime_gender_keys_target_same","male":"She's a goddess! You can't fight her!","female":"She's a goddess! You can't fight her!","variant_male_record_index":"79933","variant_female_record_index":"79934","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:1:2":{"text":"Nazrik! Don't be reckless!","source_cn":"那非！不能轻举妄动！","status":"matched_runtime_gender","hash_xxh64":"0x741FA90D9122249E","variant_status":"runtime_gender_keys_target_same","male":"Nazrik! Don't be reckless!","female":"Nazrik! Don't be reckless!","variant_male_record_index":"79935","variant_female_record_index":"79936","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:2:3":{"text":"You can't die here!","source_cn":"你不能死在这里！","status":"matched_runtime_gender","hash_xxh64":"0x1CC677B669FA7FEC","variant_status":"runtime_gender_keys_target_same","male":"You can't die here!","female":"You can't die here!","variant_male_record_index":"79937","variant_female_record_index":"79938","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:那非":{"text":"Nazrik","source":"那非","status":"matched_dialogue_flow"}