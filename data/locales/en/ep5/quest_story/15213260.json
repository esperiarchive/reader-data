{"asset_key":"ep5/quest_story_15213260","episode":"ep5","category":"quest_story","story_id":"15213260","schema_version":1,"lang":"en","texts":{"say:2:1521326001:0":{"text":"It's good to see you. Did Fufu and Twitch make it back safely?","source_cn":"你们能再次出现真是太好了。芙和扭耳是不是已经安全到家了？","status":"matched","hash_xxh64":"0x167B0C7733DE165F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1521326002:0":{"text":"Yes, they've returned to Wrathwood Grove.","source_cn":"嗯，他们已经回到了树怒山谷。","status":"matched","hash_xxh64":"0xB5646BC6FA446FE6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1521326003:0":{"text":"Great... as long as they're safe...","source_cn":"太好了……只要平安就好……","status":"matched","hash_xxh64":"0x1307BF4D4E3503B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1521326003":{"text":"Great... as long as they're safe...","source_cn":"太好了……只要平安就好……","status":"matched","hash_xxh64":"0x1307BF4D4E3503B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1521326004:0":{"text":"I-I don't know... Maybe I...","source_cn":"我……我不知道，可能是有吧……","status":"matched_runtime_gender","hash_xxh64":"0xD807DA64F9FDEB26","variant_status":"runtime_gender_keys_target_same","male":"I-I don't know... Maybe I...","female":"I-I don't know... Maybe I...","variant_male_record_index":"183344","variant_female_record_index":"183345","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1521326005:0":{"text":"As long as she can reunite with her parents... as long as she's happy, I don't care what happens to me.","source_cn":"但只要她能和父母团聚，只要她幸福……我怎么样都行。","status":"matched","hash_xxh64":"0xBDC167AF3735A995","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521326008:0":{"text":"Compared to her happiness, my feelings are irrelevant.","source_cn":"和她的幸福相比，我的感受没那么重要。","status":"matched","hash_xxh64":"0x900EA697135151F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1521326009:0":{"text":"I'm a common Halian soldier... There is nothing else I can do.","source_cn":"我只是个最普通的士兵，还是呼临人……没办法的。","status":"matched","hash_xxh64":"0xB6D417DC763999EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521326010:0":{"text":"All that matters is that she will be safe from now on.","source_cn":"就这样吧……只要她过得好就好。","status":"matched","hash_xxh64":"0x575D8A0D80CEAA28","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521326011:0":{"text":"You have my gratitude.","source_cn":"不管怎么样，谢谢你们的帮助。","status":"matched","hash_xxh64":"0x395C8F50F5EBC853","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"I know it was hard to part with her.","source_cn":"你一定很舍不得","status":"matched_runtime_gender","hash_xxh64":"0x9415456771AF52AF","variant_status":"runtime_gender_keys_target_same","male":"I know it was hard to part with her.","female":"I know it was hard to part with her.","variant_male_record_index":"78029","variant_female_record_index":"78030","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1521326006:0":{"text":"Of course, I'm happy for her.","source_cn":"当然，我当然为她高兴。","status":"matched","hash_xxh64":"0x13BCDED85089398C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1521326007:0":{"text":"She's important to me...","source_cn":"她对我而言是很重要的人……","status":"matched","hash_xxh64":"0x2E99D124BC2000EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"Aren't you happy for her?","source_cn":"你在为她高兴吗？","status":"matched_runtime_gender","hash_xxh64":"0x33D8A46E491275FD","variant_status":"runtime_gender_keys_target_same","male":"Aren't you happy for her?","female":"Aren't you happy for her?","variant_male_record_index":"78031","variant_female_record_index":"78032","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:马尔科":{"text":"Marco","source":"马尔科","status":"matched