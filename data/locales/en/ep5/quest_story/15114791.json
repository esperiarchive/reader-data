{"asset_key":"ep5/quest_story_15114791","episode":"ep5","category":"quest_story","story_id":"15114791","schema_version":1,"lang":"en","texts":{"say:2:1511479101:1":{"text":"Nazrik! You really did win!","source_cn":"那非！你果然赢下了猎血节！","status":"matched","hash_xxh64":"0xFDD72F2F343A440D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1511479102:1":{"text":"I told you, the prophecy of your two tails was true. You were destined to be the chosen warrior!","source_cn":"我早就说了，关于你双尾的预言是真的，你肯定能成为神选的勇士！","status":"matched","hash_xxh64":"0x1172A478903107E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1511479103:1":{"text":"Hau? You didn't compete in the festival?","source_cn":"……豪特？你没参加猎血节？","status":"matched","hash_xxh64":"0x120B637555585A90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1511479104:1":{"text":"No. You know my strength. I'd never last in something like that.","source_cn":"没有。你也知道我的实力，哪有可能参加猎血节。","status":"matched","hash_xxh64":"0x5D2E153C5C8231C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1511479105:1":{"text":"I'm so jealous of you! With the Herdmaster's blessing, you'll win every fight from now on!","source_cn":"真羡慕你啊！有了兽群之主的庇佑，往后你肯定百战百胜！","status":"matched","hash_xxh64":"0x49A19675A00A577B","variant_status":"",