{"asset_key":"ep5/quest_story_15109020","episode":"ep5","category":"quest_story","story_id":"15109020","schema_version":1,"lang":"en","texts":{"say:2:1510902001:0":{"text":"You're Perseus, commander of the Halians.","source_cn":"你就是珀尔修斯，呼临的统帅。","status":"matched","hash_xxh64":"0x6807241E5E986BEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1510902002:0":{"text":"...","source_cn":"……<key:dialog68>","status":"matched","hash_xxh64":"0x22918752BFBA4C6C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510902003:0":{"text":"You're one of the Wildborn. I've never seen you on the battlefield.","source_cn":"雅库伯尔人，我没在战场上见过你的面孔。","status":"matched","hash_xxh64":"0x7A5301B6FECA6C6B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1510902004:0":{"text":"If we'd met on the battlefield, we might've both died there.","source_cn":"要是在战场上相遇，你我不会都活着。","status":"matched","hash_xxh64":"0xD504A15D74BBF040","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510902005:0":{"text":"But right now... I have no intention of being your enemy.","source_cn":"至少现在，我不准备与你为敌。","status":"matched","hash_xxh64":"0x173869779AA5DE78","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510902006:1":{"text":"Perseus, this is Glowhaven, under the Arcane Council's protection. You're safe here. Rest, and when the time's right, we'll escort you back to Windchoke Fen.","source_cn":"珀尔修斯，这里是魔法师协会的微光憩居，请你先休息片刻，...","status":"matched","hash_xxh64":"0xE1C97F509CD47453","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1510902007:1":{"text":"No need to worry about the front line. The barrier will hold for a while longer.","source_cn":"无需担忧战场上的局势。阻断光墙尚能坚持一段时间。","status":"matched","hash_xxh64":"0x1C634584F51906EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1510902008:1":{"text":"Mage, check the crystal again.","source_cn":"魔法师，看一下桌上的水晶。","status":"matched","hash_xxh64":"0xA55ADAC53F82A99B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1510902009:1":{"text":"It <style=\"highlight\">turned red just now</style>. The whole room was drenched in it, but it vanished.","source_cn":"刚刚它<style=highlight>冒出了一阵红光...","status":"matched","hash_xxh64":"0x3ED3766F91FB011D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1510902010:1":{"text":"I know what you saw. It's a warning signal, but not an urgent one. Everyone, rest for now.","source_cn":"我知道你描述的场景。那是一种警告，但不急于一时。大家都...","status":"matched","hash_xxh64":"0x3C35B41EA35485C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1510902011:1":{"text":"Especially you, Perseus.","source_cn":"尤其是你，珀尔修斯。","status":"matched","hash_xxh64":"0xE3981F962F4ECB6C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1510902012:0":{"text":"...","source_cn":"……<key:dialog69>","status":"matched","hash_xxh64":"0x42527A16008D3B7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:17:1510902012":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0x42527A16008D3B7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1510902013:0":{"text":"Gorgonna... she wasn't some divine emissary. And there was no living sacrifice.","source_cn":"露……她不是神使，更没有活祭。","status":"matched","hash_xxh64":"0xCE68C42799E0339F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1510902014:0":{"text":"Azora—the Hunting Goddess—everything she told me, everything she did... was any of it real?","source_cn":"狩猎神奥法迦，她说的那些话，做的那些事……到底哪些才是真的？","status":"matched","hash_xxh64":"0x538F83CD4F4D51BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1510902015:1":{"text":"I thought I'd found love. But now... the truth feels like a blade through the ribs.","source_cn":"我以为我得到了爱……可真相为何如此丑陋？","status":"matched","hash_xxh64":"0x2B3AACD7F805F4AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1510902016:1":{"text":"Was it love, or just the thrill of the hunt?","source_cn":"那是爱吗，抑或只是一场捕猎的游戏？","status":"matched","hash_xxh64":"0xF3B340112A8B2037","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:23:1510902016":{"text":"Was it love, or just the thrill of the hunt?","source_cn":"那是爱吗，抑或只是一场捕猎的游戏？","status":"matched","hash_xxh64":"0xF3B340112A8B2037","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1510902017:1":{"text":"Real, huh...","source_cn":"真心……","status":"matched_runtime_gender","hash_xxh64":"0x81708E2EAA02128D","variant_status":"runtime_gender_keys_target_same","male":"Real, huh...","female":"Real, huh...","variant_male_record_index":"176708","variant_female_record_index":"176709","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:25::1":{"text":"Necklace","source_cn":"项链","status":"matched","hash_xxh64":"0xC3A7FD86DE281FA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1510902020:2":{"text":"This <style=\"highlight\">necklace</style> she gave me...","source_cn":"这条<style=highlight>项链</styl...","status":"matched","hash_xxh64":"0xC6376D8550332459","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1510902021:1":{"text":"I guarded it like a relic. I only ever wore it when meeting her. I was afraid even the slightest scratch would ruin the sentiment behind it.","source_cn":"我有多么珍惜它……除了见她，从来都不敢戴在身上，只怕一...","status":"matched","hash_xxh64":"0x61C63FF16C127F36","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1510902022:1":{"text":"But now...","source_cn":"可是……<key:dialog52>","status":"matched","hash_xxh64":"0x8492F0BC5DB9C245","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:23:0:1":{"text":"Maybe her feelings were real.","source_cn":"也许她的真心是真的","status":"matched_runtime_gender","hash_xxh64":"0xB02BBA14B8EFF5C6","variant_status":"runtime_gender_keys_target_same","male":"Maybe her feelings were real.","female":"Maybe her feelings were real.","variant_male_record_index":"75568","variant_female_record_index":"75569","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1510902018:1":{"text":"Is it, though?","source_cn":"是吗……<key:dialog2>","status":"matched_runtime_gender","hash_xxh64":"0x406294E257374C04","variant_status":"runtime_gender_keys_target_same","male":"Is it, though?","female":"Is it, though?","variant_male_record_index":"176710","variant_female_record_index":"176711","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:23:1:2":{"text":"It's better to know the truth.","source_cn":"总比一直蒙在鼓里要好","status":"matched_runtime_gender","hash_xxh64":"0xBF90E719B3857CD3","variant_status":"runtime_gender_keys_target_same","male":"It's better to know the truth.","female":"It's better to know the truth.","variant_male_record_index":"75570","variant_female_record_index":"75571","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1510902019:1":{"text":"... No. It was her, all along, who lied to me.","source_cn":"……是她一直在骗我。","status":"matched_runtime_gender","hash_xxh64":"0xC58AA17D6E829F66","variant_status":"runtime_gender_keys_target_same","male":"... No. It was her, all along, who lied to me.","female":"... No. It was her, all along, who lied to me.","variant_male_record_index":"176712","variant_female_record_index":"176713","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:23:2:3":{"text":"I told you I never lied to you.","source_cn":"我就说我没骗你吧","status":"matched_runtime_gender","hash_xxh64":"0x552A2A62BDABF41E","variant_status":"runtime_gender_keys_target_same","male":"I told you I never lied to you.","female":"I told you I never lied to you.","variant_male_record_index":"75572","variant_female_record_index":"75573","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:0:1":{"text":"You've gone quiet.","source_cn":"你怎么一声不吭？","status":"matched_runtime_gender","hash_xxh64":"0x9FEE6AB7B3AC80EE","variant_status":"runtime_gender_keys_target_same","male":"You've gone quiet.","female":"You've gone quiet.","variant_male_record_index":"75564","variant_female_record_index":"75565","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:1:2":{"text":"... Are you alright?","source_cn":"你还好吗？","status":"matched_runtime_gender","hash_xxh64":"0x299AC79065F78EB3","variant_status":"runtime_gender_keys_target_same","male":"... Are you alright?","female":"... Are you alright?","variant_male_record_index":"75566","variant_female_record_index":"75567","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:那非":{"text":"Nazrik","source":"那非","status":"matched_dialogue_flow"},"speaker:珀尔修斯":{"text":"Perseus","source":"珀尔修斯","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":31,"localized_text_count":30,"speaker_count":3}}