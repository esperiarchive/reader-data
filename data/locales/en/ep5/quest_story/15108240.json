{"asset_key":"ep5/quest_story_15108240","episode":"ep5","category":"quest_story","story_id":"15108240","schema_version":1,"lang":"en","texts":{"say:1:1510824001:1":{"text":"No reaction.","source_cn":"毫无反应。","status":"matched","hash_xxh64":"0x6BD157355EF3A9D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1510824002:1":{"text":"There's a groove on the surface. Like the altar for Sarethiel, it probably requires <style=\"highlight\">something specific</style> to be placed in it.","source_cn":"顶部有一个凹槽，可能和丰饶神那时候一样，需要将styl...","status":"matched","hash_xxh64":"0x3516F0C6BEBE1D86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1510824003:1":{"text":"In a shrine surrounded by water and wilderness... what kind of offering would it accept?","source_cn":"狩猎神殿内，四面环水的荒岛……此地会有什么样的信物？","status":"matched","hash_xxh64":"0x291504E90079EB55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1510824004:0":{"text":"Is someone there? Help me!","source_cn":"——有人吗？救命！","status":"matched","hash_xxh64":"0x0E5B9F9C55EB1417","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1510824005:0":{"text":"... A hallucination?","source_cn":"……幻听？","status":"matched","hash_xxh64":"0x9DEEF44A12CEA46B","variant_status":"","male":"","female":"","variant_male_record_index"