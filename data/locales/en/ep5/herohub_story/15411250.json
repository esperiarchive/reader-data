{"asset_key":"ep5/herohub_story_15411250","episode":"ep5","category":"herohub_story","story_id":"15411250","schema_version":1,"lang":"en","texts":{"say:2:1541125001:1":{"text":"How old is Toro, the elder of Veilwatch Camp?","source_cn":"逐影营地的长老，都罗，他多大了？","status":"matched","hash_xxh64":"0x899DDEE8D178310E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1541125002:1":{"text":"He's past sixty. That's already considered long-lived in the Wildborn tribe.","source_cn":"年逾六十。在雅库伯尔，已经算是长寿。","status":"matched","hash_xxh64":"0x8C5C00D1375CCFCC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1541125003:1":{"text":"Around the same age as Modra, huh...","source_cn":"和蒙多差不多……","status":"matched","hash_xxh64":"0x1413E90D00CDCBB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1541125004:1":{"text":"You think Modra will end up old and frail like him one day?","source_cn":"是不是，蒙多总有一天，也会像他一样虚弱？","status":"matched","hash_xxh64":"0x66A8BF8FF19DB69F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1541125005:1":{"text":"We all get there eventually. We grow old, we die.","source_cn":"生老病死是自然规律，所有人都要面对。","status":"matched","hash_xxh64":"0x18AC478F7F037258","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1541125006:1":{"text":"Toro will. Modra will. You will. I will.","source_cn":"都罗、蒙多是这样。你，我，也是这样。","status":"matched","hash_xxh64":"0xBB7E7E20B651C1B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"},"speaker:那非":{"text":"Nazrik","source":"那非","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":2}}