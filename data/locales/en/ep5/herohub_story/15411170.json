{"asset_key":"ep5/herohub_story_15411170","episode":"ep5","category":"herohub_story","story_id":"15411170","schema_version":1,"lang":"en","texts":{"say:2:1541117001:1":{"text":"This plateau is bone dry.","source_cn":"这片高原的土地好干涸。","status":"matched","hash_xxh64":"0x51589DF947C32E66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1541117002:1":{"text":"But the people of Halia still need water. Where do they get it?","source_cn":"呼临人不能不喝水。水从哪里来？","status":"matched","hash_xxh64":"0x081999E80C06EEFF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1541117003:1":{"text":"There are a few lakes nearby that haven't dried up yet. Some are underground, hidden beneath the surface.","source_cn":"附近存有几处尚未枯竭的湖泊，其中一些深藏于地表之下的地下水。","status":"matched","hash_xxh64":"0xAA014E95106F0262","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1541117004:1":{"text":"They're far from the city, but for now, they're the only clean water source they've got.","source_cn":"尽管它们大多远离城邦，但已是呼临人不可多得的洁净水源。","status":"matched","hash_xxh64":"0x6C6B34BBD5330B2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1541117005:1":{"text":"All this misery started with the fall of the once-benevolent God of Harvest...","source_cn":"目之所及的灾难，全部源自曾经慈爱的丰饶堕神……","status":"matched","hash_xxh64":"0x7D45B1AA759793D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"},"speaker:初代梅林":{"text":"Merlin the First","source":"初代梅林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":2}}