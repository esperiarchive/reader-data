{"asset_key":"ep5/herohub_story_15411150","episode":"ep5","category":"herohub_story","story_id":"15411150","schema_version":1,"lang":"en","texts":{"say:2:1541115001:1":{"text":"Hey, kid. Quit staring. There's nothing special about my face, trust me.","source_cn":"小家伙，别这样直勾勾地盯着别人。我不觉得我脸上有什么值...","status":"matched","hash_xxh64":"0x0DC800E6853B6E68","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1541115002:1":{"text":"Your hair's a mess.","source_cn":"你的头发，乱糟糟的。","status":"matched","hash_xxh64":"0xD36278AA9E75E234","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1541115003:1":{"text":"Looks like seaweed.","source_cn":"像水草。","status":"matched","hash_xxh64":"0x6C2B15F804AE91BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1541115004:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1541115005:1":{"text":"So that's what it feels like to be roasted. Terrible.","source_cn":"……这就是被吐槽的感觉？真差劲啊。","status":"matched","hash_xxh64":"0xA10A3BB4909BA1DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1541115006:1":{"text":"I might not care about looks, but calling my hair seaweed—that's crossing a line.","source_cn":"小家伙，虽然我不在意外貌，但也不代表你可以用水草来形容我。","status":"matched","hash_xxh64":"0x192769606031BF80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1541115007:1":{"text":"Remember, I do the teasing around here.","source_cn":"记住，只有我吐槽别人的份。","status":"matched","hash_xxh64":"0x8DAA19692B9D2562","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1541115008:1":{"text":"Why?","source_cn":"为什么？","status":"matched","hash_xxh64":"0x7849A3DBDD6D3755","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1541115009:1":{"text":"Because I'm good at it.","source_cn":"因为我厉害。","status":"matched","hash_xxh64":"0xBFF204D353058750","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1541115010:1":{"text":"<style=\"stress\"><player_name></style>'s even better than you.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xA989CAB6BDDC1DDD","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>'s even better than you.","female":"<style=\"stress\"><player_name></style>'s even better than you.","variant_male_record_index":"188217","variant_female_record_index":"188218","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1541115010":{"text":"<style=\"stress\"><player_name></style>'s even better than you.","source_cn":"<style=stress><player_name></style>比你更厉害。","status":"matched_runtime_gender","hash_xxh64":"0xA989CAB6BDDC1DDD","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>'s even better than you.","female":"<style=\"stress\"><player_name></style>'s even better than you.","variant_male_record_index":"188217","variant_female_record_index":"188218","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1541115011:1":{"text":"Quiet.","source_cn":"安静。","status":"matched","hash_xxh64":"0xE616B628176F782F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1541115012:1":{"text":"Ugh, too many people. Too much noise.","source_cn":"唉，这么多人，就是聒噪。","status":"matched","hash_xxh64":"0x7189F3BB5038083A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1541115013:1":{"text":"Morgan's clothes are a mess too.","source_cn":"摩根的衣服，也不整齐。","status":"matched","hash_xxh64":"0xA933349DE462E17F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1541115014:1":{"text":"Why not change? Don't the Halians have spare clothes?","source_cn":"为什么不换一件？呼临人，没有新衣服吗？","status":"matched","hash_xxh64":"0x8BB25B28C124FFCF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1541115015:1":{"text":"I'm not a Halian. And no, I don't need to.","source_cn":"我不是呼临人，而且没必要。","status":"matched","hash_xxh64":"0xFEFF4D9DF6EB2308","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1541115016:1":{"text":"New doesn't always mean better. I stick with what I'm used to—this robe, this staff. They do the job.","source_cn":"新东西不一定是好东西。我更喜欢用我用惯了的，比如这件长...","status":"matched","hash_xxh64":"0x930684D80651A166","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1541115017:1":{"text":"This robe's loaded with tools, and I keep everything exactly where it needs to be. Move them around, and I'll waste precious time digging for them when I need them most.","source_cn":"长袍里装着很多实用的东西，每个都有固定的位置，随意调整...","status":"matched","hash_xxh64":"0x4901D996D2C7F1B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1541115018:1":{"text":"Or to put it simply, I can't be bothered to reorganize.","source_cn":"换句话说——我懒得整理。","status":"matched","hash_xxh64":"0x6275F5E22B3F9ECD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:22:1541115018":{"text":"Or to put it simply, I can't be bothered to reorganize.","source_cn":"换句话说——我懒得整理。","status":"matched","hash_xxh64":"0x6275F5E22B3F9ECD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1541115019:0":{"text":"If you were juggling a dozen magic projects like I do, you'd probably be even \"lazier\" than I am.","source_cn":"如果你肩上也背负着十几个，甚至几十个魔法研究课题，恐怕...","status":"matched_runtime_gender","hash_xxh64":"0xDA2030D456A445ED","variant_status":"runtime_gender_keys_target_same","male":"If you were juggling a dozen magic projects like I do, you'd probably be even \"lazier\" than I am.","female":"If you were juggling a dozen magic projects like I do, you'd probably be even \"lazier\" than I am.","variant_male_record_index":"188227","variant_female_record_index":"188228","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:24:1541115019":{"text":"If you were juggling a dozen magic projects like I do, you'd probably be even \"lazier\" than I am.","source_cn":"如果你肩上也背负着十几个，甚至几十个魔法研究课题，恐怕你会比我更“放松”。","status":"matched_runtime_gender","hash_xxh64":"0xDA2030D456A445ED","variant_status":"runtime_gender_keys_target_same","male":"If you were juggling a dozen magic projects like I do, you'd probably be even \"lazier\" than I am.","female":"If you were juggling a dozen magic projects like I do, you'd probably be even \"lazier\" than I am.","variant_male_record_index":"188227","variant_female_record_index":"188228","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1541115020:1":{"text":"You already know I study corpses and the curse of the fallen god. The rest is just complicated magic you wouldn't get, and I'm not in the mood to explain.","source_cn":"如你所知，我在研究尸体，研究堕神的诅咒，还有一些你听不...","status":"matched_runtime_gender","hash_xxh64":"0x4EC96CCFB47CEBDF","variant_status":"runtime_gender_keys_target_same","male":"You already know I study corpses and the curse of the fallen god. The rest is just complicated magic you wouldn't get, and I'm not in the mood to explain.","female":"You already know I study corpses and the curse of the fallen god. The rest is just complicated magic you wouldn't get, and I'm not in the mood to explain.","variant_male_record_index":"188229","variant_female_record_index":"188230","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1541115021:1":{"text":"Why so many? Ask Merlin.","source_cn":"至于数量为什么这么多……那你只能问梅林。","status":"matched_runtime_gender","hash_xxh64":"0x2085B58B21A849C4","variant_status":"runtime_gender_keys_target_same","male":"Why so many? Ask Merlin.","female":"Why so many? Ask Merlin.","variant_male_record_index":"188231","variant_female_record_index":"188232","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1541115022:1":{"text":"If you can convince her to cut a few of the less urgent ones, I'd be grateful. Just don't expect a thank-you gift.","source_cn":"要是你能劝她帮我砍掉一些没那么重要的魔法研究，我会很感...","status":"matched_runtime_gender","hash_xxh64":"0x38FB708B3EAD64FB","variant_status":"runtime_gender_keys_target_same","male":"If you can convince her to cut a few of the less urgent ones, I'd be grateful. Just don't expect a thank-you gift.","female":"If you can convince her to cut a few of the less urgent ones, I'd be grateful. Just don't expect a thank-you gift.","variant_male_record_index":"188233","variant_female_record_index":"188234","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:0:1":{"text":"What are you working on?","source_cn":"你都在研究什么？","status":"matched_runtime_gender","hash_xxh64":"0x0A8815A4949D8A54","variant_status":"runtime_gender_keys_target_same","male":"What are you working on?","female":"What are you working on?","variant_male_record_index":"79213","variant_female_record_index":"79214","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:1:2":{"text":"So many projects? Why?","source_cn":"怎么有那么多要研究的事？","status":"matched_runtime_gender","hash_xxh64":"0x00FD354636C06A8B","variant_status":"runtime_gender_keys_target_same","male":"So many projects? Why?","female":"So many projects? Why?","variant_male_record_index":"79215","variant_female_record_index":"79216","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:0:1":{"text":"You've got a lot of excuses.","source_cn":"理由还真多","status":"matched_runtime_gender","hash_xxh64":"0x51D429287F981D31","variant_status":"runtime_gender_keys_target_same","male":"You've got a lot of excuses.","female":"You've got a lot of excuses.","variant_male_record_index":"79209","variant_female_record_index":"79210","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:22:1:2":{"text":"Knew it. You're just lazy.","source_cn":"果然，就是因为懒","status":"matched_runtime_gender","hash_xxh64":"0xD3DC92406EB82B75","variant_status":"runtime_gender_keys_target_same","male":"Knew it. You're just lazy.","female":"Knew it. You're just lazy.","variant_male_record_index":"79211","variant_female_record_index":"79212","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:0:1":{"text":"Exactly!","source_cn":"没错！","status":"matched_runtime_gender","hash_xxh64":"0x0A5151FE70F2D31E","variant_status":"runtime_gender_keys_target_same","male":"Exactly!","female":"Exactly!","variant_male_record_index":"79205","variant_female_record_index":"79206","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:1:2":{"text":"Which means it's my turn now!","source_cn":"所以轮到我吐槽了！","status":"matched_runtime_gender","hash_xxh64":"0x914D72A08CE504AE","variant_status":"runtime_gender_keys_target_same","male":"Which means it's my turn now!","female":"Which means it's my turn now!","variant_male_record_index":"79207","variant_female_record_index":"79208","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:摩根":{"text":"Morgan","source":"摩根","status":"matched_dialogue_flow"},"speaker:加拉":{"text":"Gala","source":"加拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":32,"localized_text_count":31,"speaker_count":2}}