{"asset_key":"ep5/env_story_15304350","episode":"ep5","category":"env_story","story_id":"15304350","schema_version":1,"lang":"en","texts":{"say:3:1530435001:1":{"text":"Yeah, he's been like that ever since we came back from the battlefield.","source_cn":"自从我们从战场回来，他就这样。","status":"matched","hash_xxh64":"0xF39F09869DC0B645","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1530435002:1":{"text":"Bet it was a Halian ambush. Messed up his head pretty bad...","source_cn":"我猜他是被偷袭的呼临人吓出了心理阴影……","status":"matched","hash_xxh64":"0x1AD5B5C6EFC4BFB6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1530435003:1":{"text":"That's nonsense! I'm just more careful now, that's all!","source_cn":"你胡说！我我我只是养成了谨慎小心的习惯！","status":"matched","hash_xxh64":"0xE717C5BC9CCB058D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1530435004:1":{"text":"And that \"carefulness\" is what kept me alive!","source_cn":"这可是能帮助我们从战场活下来的好习惯！","status":"matched","hash_xxh64":"0xE6822C260FCBCD7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:战士吞":{"text":"Gulper","source":"战士吞","status":"matched_dialogue_flow"},"speaker:战士强腕":{"text":"Tough Grip","source":"战士强腕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"spea