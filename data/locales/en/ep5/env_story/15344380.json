{"asset_key":"ep5/env_story_15344380","episode":"ep5","category":"env_story","story_id":"15344380","schema_version":1,"lang":"en","texts":{"say:3:1534438001:1":{"text":"Who remembers how to say \"come here\"?","source_cn":"你们谁还记得，“快过来”的发声是什么样的？","status":"matched","hash_xxh64":"0x94E7FACF57D923B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1534438002:1":{"text":"It's \"wa-ah, wa-ah\"!","source_cn":"是“哇啊哇啊”！","status":"matched","hash_xxh64":"0x093AAED3D29C3C55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1534438003:1":{"text":"No! You're wrong! It's \"woo-wa, ah-woo\"!","source_cn":"不对不对，明明是“呜哇啊呜”。","status":"matched","hash_xxh64":"0xABACFDDD0FBE2A94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1534438003":{"text":"No! You're wrong! It's \"woo-wa, ah-woo\"!","source_cn":"不对不对，明明是“呜哇啊呜”。","status":"matched","hash_xxh64":"0xABACFDDD0FBE2A94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1534438004:1":{"text":"Practicing the Old Tongue! Our teacher says our ancestors spoke in a language that sounded more like animal calls.","source_cn":"我们在练习古语言！老师说过，其实最开始雅库伯尔用的语言...","status":"matched_runtime_gender","hash_xxh64":"0x2B90525CC5236FFE","variant_status":"runtime_gender_keys_target_same","male":"Practicing the 