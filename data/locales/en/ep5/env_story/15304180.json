{"asset_key":"ep5/env_story_15304180","episode":"ep5","category":"env_story","story_id":"15304180","schema_version":1,"lang":"en","texts":{"say:3:1530418001:1":{"text":"Roasted?","source_cn":"吃烤肉吧？","status":"matched","hash_xxh64":"0x80A5B7A1BC743158","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1530418002:1":{"text":"No, we just had roast yesterday. Let's make a meat soup today—something to eat and drink at once!","source_cn":"不行，我们昨天才吃过烤肉。今天做肉汤吧，边吃边喝！","status":"matched","hash_xxh64":"0x35B6FF3215BD81FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1530418003:1":{"text":"We only roasted the front legs yesterday! Today we can roast the chest, or the back! That's different!","source_cn":"我们昨天吃的是烤前蹄，今天可以吃烤前胸、后背啊！这完全...","status":"matched","hash_xxh64":"0x14A1D20D21C52B50","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1530418004:1":{"text":"By that logic we'll be roasting tails, heads, and ears next!","source_cn":"照你这么说，还有烤尾巴，烤猪头，烤猪耳呢！","status":"matched","hash_xxh64":"0x656215FA0F2D130B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:战士浩":{"text":"Grande","source":"战士浩","status":"matched_dialogue_flow"},"speaker:战士豹尾":{"text":"Cat Tail","source":"战士豹尾","status":"matched_dialogue_flow"},"speaker:战士阿憨":{"tex