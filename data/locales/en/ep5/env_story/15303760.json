{"asset_key":"ep5/env_story_15303760","episode":"ep5","category":"env_story","story_id":"15303760","schema_version":1,"lang":"en","texts":{"say:2:1530376001:1":{"text":"The flood took everyone in my family. I'm the only one left.","source_cn":"我家里除了我，全被洪水冲走了！","status":"matched","hash_xxh64":"0xC46A38DBBB50A339","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1530376002:1":{"text":"Same here. You're the only friend I have in Halia now.","source_cn":"我也一样，现在的呼临城，我只有你一个朋友了。","status":"matched","hash_xxh64":"0x5CD1864724FDA427","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1530376003:1":{"text":"If I'd known the flood was coming, I'd have stayed behind. At least I'd be with my family...","source_cn":"早知道城里会发洪水，我就应该留在城里，和家人们一起……","status":"matched","hash_xxh64":"0x63D4743DD88862DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1530376004:1":{"text":"D-don't talk like that. At least we're still alive.","source_cn":"别，别这样想，我的朋友，起码我们还活着。","status":"matched","hash_xxh64":"0x690935A5C2D16752","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修昔底德":{"text":"Thucydides","source":"修昔底德","status":"matched_dialogue_flow"},"speaker:雷尔":{"text":"Lyle","source":"雷尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,