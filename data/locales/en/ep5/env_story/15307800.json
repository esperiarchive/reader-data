{"asset_key":"ep5/env_story_15307800","episode":"ep5","category":"env_story","story_id":"15307800","schema_version":1,"lang":"en","texts":{"say:1:1530780001:1":{"text":"How's the catch? It doesn't matter now; we've got plenty of food now.","source_cn":"渔获？现在又不是饿肚子的时候，谁还关心这个。","status":"matched","hash_xxh64":"0x947687BAF0E5C67F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1530780002:1":{"text":"I fish every day just to pass the time.","source_cn":"我现在每天钓鱼，只是用来打发时间。","status":"matched","hash_xxh64":"0x5EE15170D1007CE2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1530780003:1":{"text":"Besides, I only catch what I need. I'm an old man, not a glutton.","source_cn":"钓的太多也没用，我一个老头子，又能吃多少呢？","status":"matched","hash_xxh64":"0xE4921B570155A45A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修昔底德":{"text":"Thucydides","source":"修昔底德","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}