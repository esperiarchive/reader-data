{"asset_key":"ep5/env_story_15301254","episode":"ep5","category":"env_story","story_id":"15301254","schema_version":1,"lang":"en","texts":{"say:2:1530125401:0":{"text":"Listen to me, Ramble. The Hunting Goddess needs warriors. She needs me!","source_cn":"听话，敖。狩猎神需要战士，需要我！","status":"matched","hash_xxh64":"0xE35325F58757E4F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1530125402:0":{"text":"Once we drive out the Halians, I'll come home.","source_cn":"等赶跑了呼临人，阿娘就回来了。","status":"matched","hash_xxh64":"0x7C4E7861B047644F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1530125403:0":{"text":"But Father died on the battlefield! Mother... can't you stay?","source_cn":"可是阿爹就死在战场上！阿娘……你不能不去吗？","status":"matched","hash_xxh64":"0x7909324009CDB96C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1530125404:0":{"text":"Of course not. It's the Wild Moon's will! She commands us to drive out the Halians!","source_cn":"当然不能，赶跑呼临人可是雅库伯尔之月下的令！","status":"matched","hash_xxh64":"0xF6F4505AEC872A46","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1530125405:0":{"text":"Don't worry, Ramble. I'm protected by the Herdmaster's blessing. I'll return alive.","source_cn":"放心吧，敖。阿娘有兽群之主的加护，怎么可能有去无回？","status":"matched","hash_xxh64":"0xAFD031A6C5846419","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1530125406:0":{"text":"R-really? Then I'll believe you...","source_cn":"真、真的？那好吧……","status":"matched","hash_xxh64":"0xE09799E90575CCB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:大爪":{"text":"Big Claw","source":"大爪","status":"matched_dialogue_flow"},"speaker:敖":{"text":"Ramble","source":"敖","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":2}}