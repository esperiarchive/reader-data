{"asset_key":"ep5/env_story_15303660","episode":"ep5","category":"env_story","story_id":"15303660","schema_version":1,"lang":"en","texts":{"say:2:1530366001:1":{"text":"The three of us made it this far together. How can we abandon her now?","source_cn":"我们三个一起逃路到现在，难道就放她到这里？","status":"matched","hash_xxh64":"0xCE15366D8F2E9E08","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1530366002:1":{"text":"She only fainted from hunger. If she eats, she'll recover...","source_cn":"她只是饿晕过去，只要给她喂点吃的……","status":"matched","hash_xxh64":"0x103EA966A0F5E407","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1530366003:1":{"text":"But we already gave her our last scrap of food!","source_cn":"我们最后的食物已经喂给她了！","status":"matched","hash_xxh64":"0x41A5155C7151888B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1530366004:1":{"text":"And look at us now! We can barely stand, let alone carry her!","source_cn":"而且现在的我们，可没有搬动她的力气！","status":"matched","hash_xxh64":"0x477FD9F29009BFFF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:久特":{"text":"Judd","source":"久特","status":"matched_dialogue_flow"},"speaker:斯梅尔莉亚":{"text":"Seraphina","source":"斯梅尔莉亚","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speak