{"asset_key":"ep5/env_story_15304270","episode":"ep5","category":"env_story","story_id":"15304270","schema_version":1,"lang":"en","texts":{"say:2:1530427001:1":{"text":"That's right. The real Hunting Goddess showed up and exposed the lie.","source_cn":"是的，据说真正的狩猎神现身了，揭穿了那个伪神的阴谋。","status":"matched","hash_xxh64":"0x89E61200A1AB712A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1530427002:0":{"text":"Still don't get why the false goddess helped us punish Halia with a flood, though.","source_cn":"不过我还是有点想不通，那个伪神为什么要替雅库伯尔用洪水...","status":"matched","hash_xxh64":"0x886EB8D134A84743","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1530427003:1":{"text":"Stop it already! If the Hunting Goddess hears you, she won't be pleased!","source_cn":"别说了！万一被狩猎神知道，肯定会惩罚你的！","status":"matched","hash_xxh64":"0x218D12477F4B2433","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:玲":{"text":"Ryn","source":"玲","status":"matched_dialogue_flow"},"speaker:探毛":{"text":"Scouthide","source":"探毛","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}