{"asset_key":"ep5/env_story_15361155","episode":"ep5","category":"env_story","story_id":"15361155","schema_version":1,"lang":"en","texts":{"say:2:1536115501:1":{"text":"Hey, if the Hunting Goddess picked him, he can use anything—spear, sword, soup ladle!","source_cn":"不不不，能被狩猎神选中的勇士，肯定是什么武器都会用啊！","status":"matched","hash_xxh64":"0xC22C0945B6B7C70B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1536115502:1":{"text":"Still, I heard he only uses the spear.","source_cn":"我听说那非只用长矛啊？","status":"matched","hash_xxh64":"0xFF07F9C2112F4068","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1536115503:1":{"text":"Come on! You think he survived that nightmare sticking to one weapon? He used whatever worked!","source_cn":"那他怎么会赢？猎血节那么凶险，肯定是有什么就用什么！","status":"matched","hash_xxh64":"0x18A83C7C61268217","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1536115504:1":{"text":"Huh... fair point, I guess.","source_cn":"嘶，这也确实……","status":"matched","hash_xxh64":"0xDCAF7C1CC6720894","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1536115505:1":{"text":"Right? To celebrate Nazrik's win, I'll cut you a deal—only five boars!","source_cn":"对吧对吧？为了庆祝那非获胜，我破例只要你五只野猪！","status":"matched","hash_xxh64":"0x03E4EE1A20FBFB48","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1536115506:1":{"text":"You drive a hard bargain. Alright, I'll take it, for the celebration!","source_cn":"这么贵？！算了，就当是庆祝吧，我要了！","status":"matched","hash_xxh64":"0x928BDDB749D40192","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:商人鸮":{"text":"Trader Owl","source":"商人鸮","status":"matched_dialogue_flow"},"speaker:锻尾":{"text":"Irontail","source":"锻尾","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":2}}