{"asset_key":"ep5/env_story_15301690","episode":"ep5","category":"env_story","story_id":"15301690","schema_version":1,"lang":"en","texts":{"say:2:1530169001:1":{"text":"The melody!","source_cn":"音调不对！","status":"matched","hash_xxh64":"0xBE4FCC5625F2983B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1530169002:1":{"text":"The Hunting Goddess has arrived, and we need a new hymn worthy of her.","source_cn":"狩猎神大人降临，我们必须为神献上新的赞美歌。","status":"matched","hash_xxh64":"0xBF643B7FB2540B9E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1530169003:1":{"text":"But this sounds far too plain. It cannot possibly do justice to the Herdmaster's glory!","source_cn":"但这些音调……都太普通了！完全不能表现出兽群之主的伟大！","status":"matched","hash_xxh64":"0x2D843E6D6717C272","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1530169004:1":{"text":"Don't stand up like that! You nearly smashed the clay pot!","source_cn":"不要突然站起来啊！陶罐都差点被你碰碎了！","status":"matched","hash_xxh64":"0x8827BD92947F99C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:巫祭长须":{"text":"Priest Longbeard","source":"巫祭长须","status":"matched_dialogue_flow"},"speaker:巫祭喉":{"text":"Priestess Maw","source":"巫祭喉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":