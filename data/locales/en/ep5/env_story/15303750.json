{"asset_key":"ep5/env_story_15303750","episode":"ep5","category":"env_story","story_id":"15303750","schema_version":1,"lang":"en","texts":{"say:2:1530375001:1":{"text":"Of course. No one wants to be defeated.","source_cn":"当然，战败可不是什么好事。","status":"matched","hash_xxh64":"0x961D8384CDA35A2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1530375002:1":{"text":"And I heard the Wildborn grew wheat from their spoils. If we had won, that would've been ours.","source_cn":"而且我还听说，兽人拿到的小麦能种出麦穗。要是我们打赢了...","status":"matched","hash_xxh64":"0x143159518F8E8C90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1530375003:1":{"text":"Don't think too much on it. At least the Wildborn agreed to share their harvest.","source_cn":"唉，别太在意，至少现在兽人答应会给我们分粮食。","status":"matched","hash_xxh64":"0x0842A17D404C7274","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1530375004:1":{"text":"As long as I can eat, and there's no more fighting, that's good enough for me.","source_cn":"只要能吃饱，别再打仗，我就心满意足了。","status":"matched","hash_xxh64":"0xDF72A0AC74864B52","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:乔治":{"text":"George","source":"乔治","status":"matched_dialogue_flow"},"speaker:席博尔":{"text":"Silvan","source":"席博尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}