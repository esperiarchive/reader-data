{"asset_key":"ep5/env_story_15331030","episode":"ep5","category":"env_story","story_id":"15331030","schema_version":1,"lang":"en","texts":{"say:1:1533103001:1":{"text":"Hmph! At least you have some sense...","source_cn":"……哼，还算有点礼貌。","status":"matched_runtime_gender","hash_xxh64":"0xE4115D213E0A59F3","variant_status":"runtime_gender_keys_target_same","male":"Hmph! At least you have some sense...","female":"Hmph! At least you have some sense...","variant_male_record_index":"187462","variant_female_record_index":"187463","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1533103002:1":{"text":"Alright, my set menu comes in three courses: an appetizer, a main course, and a dessert at the end. Pick what you want.","source_cn":"我的套餐分三道菜，前菜、主菜和小吃。自己看菜单选。","status":"matched_runtime_gender","hash_xxh64":"0xF09B52B247587CF9","variant_status":"runtime_gender_keys_target_same","male":"Alright, my set menu comes in three courses: an appetizer, a main course, and a dessert at the end. Pick what you want.","female":"Alright, my set menu comes in three courses: an appetizer, a main course, and a dessert at the end. Pick what you want.","variant_male_record_index":"187464","variant_female_record_index":"187465","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:3:1533103003:0":{"text":"She hands you a literal slab of rock for a menu. You read the names of the dishes carefully.","source_cn":"你接过了刻有菜名的泥石板，仔细阅读……","status":"matched_runtime_gender","hash_xxh64":"0x129608C8A668F184","variant_status":"runtime_gender_keys_target_same","male":"She hands you a literal slab of rock for a menu. You read the names of the dishes carefully.","female":"She hands you a literal slab of rock for a menu. You read the names of the dishes carefully.","variant_male_record_index":"187466","variant_female_record_index":"187467","document_title":"