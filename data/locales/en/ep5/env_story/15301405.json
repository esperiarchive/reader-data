{"asset_key":"ep5/env_story_15301405","episode":"ep5","category":"env_story","story_id":"15301405","schema_version":1,"lang":"en","texts":{"say:3:1530140501:1":{"text":"Mother told me that the Hunting Goddess has abandoned us.","source_cn":"我听阿娘说了，狩猎神不要我们了，她背弃了我们！","status":"matched","hash_xxh64":"0x789939017EBF7A2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1530140502:0":{"text":"We don't need the blessing of a goddess who betrayed us!","source_cn":"背弃我们的神的恩赐，我们不要！","status":"matched","hash_xxh64":"0xB0A5ECACBAE47663","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1530140503:0":{"text":"Come on, don't be like that. Maybe the rumors are wrong...","source_cn":"不要这样，或许事情不是传的那样……","status":"matched","hash_xxh64":"0x4ADDFBF56857A819","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1530140504:0":{"text":"The Herdmaster... she was a goddess. How could a goddess die?","source_cn":"兽群之主……那可是神啊！神怎么会死呢……","status":"matched","hash_xxh64":"0x4333AE31E5485532","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:模翅":{"text":"Mold Wing","source":"模翅","status":"matched_dialogue_flow"},"speaker:钩":{"text":"Hooks","source":"钩","status":"matched_dialogue_flow"},"speaker:巫祭挂角":{"text":"Priestess Uphorn","source":"巫祭挂角","status":"m