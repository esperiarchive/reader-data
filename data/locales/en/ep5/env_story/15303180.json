{"asset_key":"ep5/env_story_15303180","episode":"ep5","category":"env_story","story_id":"15303180","schema_version":1,"lang":"en","texts":{"say:2:1530318001:0":{"text":"Oh ho! Look at this one, my friend. What a beauty!","source_cn":"哦哦，我的朋友，这鱼真不错！","status":"matched","hash_xxh64":"0x8B6E97F109A4D556","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1530318002:0":{"text":"Let's take it back and make some fish soup...","source_cn":"走吧，我们这就回去拿它炖汤……","status":"matched","hash_xxh64":"0xC016D825098165B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1530318003:1":{"text":"Fish soup? That'd be a waste. Better to dry it into jerky. At least it'll last.","source_cn":"鱼汤？那太奢侈了，我想把它晒成鱼干，这样还能吃的久些。","status":"matched","hash_xxh64":"0x4044D555065EF20B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1530318004:1":{"text":"With so many fishing these waters, who knows when we'll catch another...","source_cn":"现在钓鱼的人这么多，谁知道下次还能不能钓到鱼……","status":"matched","hash_xxh64":"0xE5B42EF1251CE3F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修昔底德":{"text":"Thucydides","source":"修昔底德","status":"matched_dialogue_flow"},"speaker:雷尔":{"text":"Lyle","source":"雷尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text