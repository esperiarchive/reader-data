{"asset_key":"ep1/env_story_11202090","episode":"ep1","category":"env_story","story_id":"11202090","schema_version":1,"lang":"en","texts":{"say:1:1120209001:1":{"text":"Welcome, Brutus.","source_cn":"布鲁特斯大人，欢迎你的前来。","status":"matched","hash_xxh64":"0xCE4CA3F0034DAF21","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1120209002:1":{"text":"A young Mauler? Who might you be?","source_cn":"这位年轻的蛮血？你……是？","status":"matched","hash_xxh64":"0xEF7D478E02E7E4DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1120209003:1":{"text":"I am Kojin, son of Orson.","source_cn":"我是库金，奥格之子。","status":"matched","hash_xxh64":"0xCA919C9EB2731CB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120209004:1":{"text":"Your father... He was a great Mauler warrior. My condolences.","source_cn":"你的父亲，是一名伟大且强大的蛮血战士……节哀。","status":"matched","hash_xxh64":"0x3C7A0D47ACF24EE4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120209005:1":{"text":"He met his end in battle, so the Dusk Lord will permit him to enter the resting place of warriors.","source_cn":"他在战斗中逝去，残阳神会允许他走向战士的归宿。","status":"matched","hash_xxh64":"0x9EE87AA15B98A156","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","do