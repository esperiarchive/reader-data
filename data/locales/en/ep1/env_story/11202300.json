{"asset_key":"ep1/env_story_11202300","episode":"ep1","category":"env_story","story_id":"11202300","schema_version":1,"lang":"en","texts":{"say:1:1120230001:1":{"text":"I didn't think you'd actually do it...","source_cn":"我没想到……你竟然真的做到了……","status":"matched","hash_xxh64":"0x133BC74643D69D90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1120230002:1":{"text":"Don't get ahead of yourself. I just want to make a clean break. The offering... You take it.","source_cn":"别误会，我只是想做个了断。这个护途之链……你收着吧。","status":"matched","hash_xxh64":"0x0B37FA46E708E200","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1120230003:1":{"text":"... What's next for you, then?","source_cn":"……你之后打算做什么？","status":"matched","hash_xxh64":"0x923E85981833AF43","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120230004:1":{"text":"Next? I'm getting the hell out of Grimmaw turf, of course. Heading back to the Uru Clan.","source_cn":"之后？当然是离开你们黑嚎的地盘，回到乌尔氏族。","status":"matched","hash_xxh64":"0x88B08C1CA34785D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120230005:1":{"text":"I can't accept this burial offering.","source_cn":"我不会收下这个陪葬品的。","status":"matched","hash_xxh64":"0x294717D34DF351D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120230006:1":{"text":"... Why not?","source_cn":"……为什么？","status":"matched","hash_xxh64":"0x1F024CEEC0B3A1CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120230007:1":{"text":"This is between you and father, it has nothing to do with me. The funeral will be held the day after tomorrow.","source_cn":"这是你和父亲的了断，和我无关。后天举办葬礼——","status":"matched","hash_xxh64":"0xE7A093EFC524B97F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120230008:1":{"text":"If you really want to say goodbye, bring the offering.","source_cn":"如果想说再见的话，就在葬礼当天带着它一起出席吧。","status":"matched","hash_xxh64":"0xCFDDF637EA01D3E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120230009:1":{"text":"... You're a crafty one, aren't you?","source_cn":"……你还真是狡猾啊。","status":"matched","hash_xxh64":"0x19BA1612610F7A2A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1120230010:1":{"text":"See you at the funeral, then.","source_cn":"葬礼当天，再说吧。","status":"matched","hash_xxh64":"0x7A089FAD6868825B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:库金":{"text":"Kojin","source":"库金","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":2}}