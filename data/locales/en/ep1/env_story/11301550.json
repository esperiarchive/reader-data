{"asset_key":"ep1/env_story_11301550","episode":"ep1","category":"env_story","story_id":"11301550","schema_version":1,"lang":"en","texts":{"say:1:1130155001:1":{"text":"It's hard to imagine how much danger Soren and Alsa took on for this.","source_cn":"难以想象索恩和阿尔萨为此经历了多少危险。","status":"matched","hash_xxh64":"0x756961D3B080B9D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1130155002:1":{"text":"But it's good to know they're both safe. I'm going to pay my respects to Pops in a few minutes and fill him in on everything.","source_cn":"不过好在一切平安。我一会儿要去祭拜老爹，将最近发生的事...","status":"matched","hash_xxh64":"0x3C8F84F88C1EAEE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1130155003:1":{"text":"I'm sure he'll also be relieved.","source_cn":"他应该也会放下心来吧……","status":"matched","hash_xxh64":"0xA5E9DB046AC84C70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:小蛮血瑟拉芬":{"text":"Seraphina","source":"小蛮血瑟拉芬","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}