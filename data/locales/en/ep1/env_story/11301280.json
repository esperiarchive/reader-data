{"asset_key":"ep1/env_story_11301280","episode":"ep1","category":"env_story","story_id":"11301280","schema_version":1,"lang":"en","texts":{"say:1:1130128001:1":{"text":"That's right! There are some little fish around here!","source_cn":"没错！这里有一些小鱼！","status":"matched","hash_xxh64":"0xDF9A3566AC522B79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1130128002:1":{"text":"These ones don't even need to be gutted, just mashed into a fish sauce! Really tasty!","source_cn":"这些小鱼不需要去除内脏，直接捣碎做成鱼酱，可香了！","status":"matched","hash_xxh64":"0xA6E342DC070C2496","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1130128003:1":{"text":"We aren't the only ones who think so, either. Everyone loves it!","source_cn":"不止是我们，大家都可喜欢吃了！","status":"matched","hash_xxh64":"0x778A55C73E608B00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1130128004:1":{"text":"But I don't have enough at the moment, so I'll have to fish for more.","source_cn":"目前这些不太够，我还要再钓些。","status":"matched","hash_xxh64":"0x2FF53B85FC3203B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:小蛮血赞多尔":{"text":"Zamdo","source":"小蛮血赞多尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}