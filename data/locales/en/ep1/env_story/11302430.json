{"asset_key":"ep1/env_story_11302430","episode":"ep1","category":"env_story","story_id":"11302430","schema_version":1,"lang":"en","texts":{"say:1:1130243001:1":{"text":"Haha, it is! My roasted meat is prepared in a special way.","source_cn":"哈哈，我的烤野猪肉可是用独特的方法烤制。","status":"matched","hash_xxh64":"0x218745B9C5120CF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1130243002:1":{"text":"The meat is first cut into similar-sized pieces and skewered rotisserie style. I then use a sharp knife to trim the juicy outer layers.","source_cn":"先将野猪肉切成大小相近的肉片，再串在烤肉叉上旋转烤制。...","status":"matched","hash_xxh64":"0x6E0713B5CCEF7EB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1130243003:1":{"text":"It's a hit with everyone who tries it! So good a few young maulers even snuck off with a few pieces just now...","source_cn":"吃过的客人都赞不绝口！刚刚有几个小蛮血还来偷吃了几块……","status":"matched","hash_xxh64":"0x416C68C50C7CD0DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1130243003":{"text":"It's a hit with everyone who tries it! So good a few young maulers even snuck off with a few pieces just now...","source_cn":"吃过的客人都赞不绝口！刚刚有几个小蛮血还来偷吃了几块……","status":"matched","hash_xxh64":"0x416C68C50C7CD0DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1130243004:1":{"text":"I was just slicing the roast onto a platter when a few younglings popped up out of nowhere.","source_cn":"我刚将烤好的肉切到盘子，结果突然蹿出了两个小孩……","status":"matched","hash_xxh64":"0x028E63D6F5C4B365","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1130243005:1":{"text":"They were just hungry. Can't blame kids for being kids.","source_cn":"他们只是不得已，要不是因为饥饿……我小时候也是这样的——","status":"matched","hash_xxh64":"0x02508279FA41BE0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1130243006:1":{"text":"It's not a big deal.","source_cn":"算了，不提了。","status":"matched","hash_xxh64":"0x7DAA7E8A8AB6ADA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:4:0:1":{"text":"Stole food?","source_cn":"偷吃？","status":"matched_runtime_gender","hash_xxh64":"0xEEB1A1FBD2316F24","variant_status":"runtime_gender_keys_target_same","male":"Stole food?","female":"Stole food?","variant_male_record_index":"62920","variant_female_record_index":"62921","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:蛮血古普塔":{"text":"Gupto","source":"蛮血古普塔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":1}}