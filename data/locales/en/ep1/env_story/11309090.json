{"asset_key":"ep1/env_story_11309090","episode":"ep1","category":"env_story","story_id":"11309090","schema_version":1,"lang":"en","texts":{"say:2:1130909001:1":{"text":"Oh, yeah, we're fine. A couple of pecks and scratches from the terrabirds, but nothing too serious.","source_cn":"我们啊，还好。被陆行鸟踢了几脚，没受大伤。","status":"matched","hash_xxh64":"0x88A67DFF3D8FE003","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1130909002:1":{"text":"There must be a reason for their behavior. Plague? Disease? Who knows... but how am I supposed to earn any coin with this mess...?","source_cn":"这背后一定有什么原因。瘟疫？疾病？或者其他未知的灾难。...","status":"matched","hash_xxh64":"0x70856D5DAAB5A1C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1130909003:1":{"text":"Regardless, we should be extra cautious.","source_cn":"说是这么说，但我们还是小心点比较好。","status":"matched","hash_xxh64":"0x6F367CB4A560F430","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1130909004:0":{"text":"And not because I'm scared or anything!","source_cn":"我可不是畏手畏脚的人！","status":"matched","hash_xxh64":"0x0D73FF139A9CFC9A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:行商德博拉":{"text":"Trader Debor","source":"行商德博拉","status":"matched_dialogue_flow"},"speaker:行商乔瑟夫":{"text":"Hawker Joseph","source":"行商乔瑟