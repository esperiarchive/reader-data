{"asset_key":"ep1/env_story_11307120","episode":"ep1","category":"env_story","story_id":"11307120","schema_version":1,"lang":"en","texts":{"say:1:1130712001:1":{"text":"I know, but... I can't tell her the truth.","source_cn":"我知道，可是……可是我不能告诉她真相。","status":"matched","hash_xxh64":"0x6CEC1EE6B241BF07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1130712002:1":{"text":"Many of her friends have been taken... How can I tell a child that her friends are gone forever?","source_cn":"她的朋友很多都被掳走了。该怎么跟一个孩子说，你的朋友不...","status":"matched","hash_xxh64":"0xB02181BAA807B28A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1130712003:1":{"text":"Tara doesn't know anything. She just thinks I don't want her to play outside.","source_cn":"塔拉，她以为我只是不允许她出去玩，并不知道实情。","status":"matched","hash_xxh64":"0xD5D3C6FE386D51BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1130712004:1":{"text":"I just want to keep my baby safe.","source_cn":"我只想保护我的小姑娘。","status":"matched","hash_xxh64":"0x65EE024028DA4D01","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:部落成员登利":{"text":"Denly","source":"部落成员登利","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}