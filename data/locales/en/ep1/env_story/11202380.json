{"asset_key":"ep1/env_story_11202380","episode":"ep1","category":"env_story","story_id":"11202380","schema_version":1,"lang":"en","texts":{"say:1:1120238001:1":{"text":"I, Kojin—son of Orson—on behalf of the entire Grimmaw Clan, invite you to return home and lead our clan back to prosperity.","source_cn":"我，奥格之子库金，代表整个黑嚎氏族邀请索恩回归。希望您...","status":"matched","hash_xxh64":"0xCCE92EE7F0527B60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1120238002:1":{"text":"You're... inviting Soren back to the Grimmaw Clan? So suddenly...","source_cn":"邀、邀请索恩回黑嚎？这么突然的吗……","status":"matched","hash_xxh64":"0xD4F1313F44BEF93A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120238003:1":{"text":"... I refuse. I belong to the Uru Clan.","source_cn":"……我拒绝。我永远属于乌尔氏族。","status":"matched","hash_xxh64":"0x6B8B08D4087B4B04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120238004:1":{"text":"Haven't you realized the problem yet?!","source_cn":"你还没意识到问题吗！","status":"matched","hash_xxh64":"0x7F17E63E54B9DB29","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120238005:1":{"text":"If you don't come back, the position of chief will be passed to Kruger!","source_cn":"如果你不回来，那黑嚎族长的位置就是克鲁格的了。","status":"matched","hash_xxh64":"0xB453D671C6B47F7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120238006:1":{"text":"The position our father worked so hard to gain will be taken away!","source_cn":"我们的父亲好不容易才获得的位置，会被他们那一支的人彻底夺走！","status":"matched","hash_xxh64":"0xC7D0B2E8C7F820CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120238007:1":{"text":"And what's that got to do with me?","source_cn":"这和我又有什么关系？","status":"matched","hash_xxh64":"0xAC6147499F172802","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1120238008:1":{"text":"I already told you: Orson was never a father to me. The only father I ever had was Pops.","source_cn":"我说过的吧，奥格从来就不是我的“父亲”。我的父亲，从来...","status":"matched","hash_xxh64":"0x3ADC612523D2F130","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1120238009:1":{"text":"You stubborn fool! Do you care nothing for your father's blood—","source_cn":"你这冥顽不灵的蠢货！根本不在乎父亲的心血……","status":"matched","hash_xxh64":"0x86892491EA622C05","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1120238010:1":{"text":"He has absolutely nothing to do with me.","source_cn":"他的一切与我无关。","status":"matched","hash_xxh64":"0x455B8351094EA899","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:库金":{"text":"Kojin","source":"库金","status":"matched_dialogue_flow"},"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":3}}