{"asset_key":"ep1/env_story_11202265","episode":"ep1","category":"env_story","story_id":"11202265","schema_version":1,"lang":"en","texts":{"say:1:1120226501:1":{"text":"I've already harvested most of the ones here. You guys really desperate for some?","source_cn":"这里的库姆草被我采集得差不多，你们很需要吗？","status":"matched","hash_xxh64":"0xD844E3160F83F4CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1120226502:1":{"text":"Yes, we'd appreciate it if you could spare just a bit.","source_cn":"是的，我们……需要制作一个项链……","status":"matched","hash_xxh64":"0xCA271548F68C05F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1120226503:1":{"text":"Hm... In that case, help me organize my pack and I'll give you some. Deal?","source_cn":"唔……既然这样的话，你们帮我整理背包，我就送你们几株如何？","status":"matched","hash_xxh64":"0x78F24587751C3D3F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120226504:1":{"text":"I've already gathered more than enough for today, anyway.","source_cn":"反正我今天采集的数量已经超过了需求。","status":"matched","hash_xxh64":"0x6C6FFB469AE09D6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120226505:1":{"text":"Really? That's great, thank you!","source_cn":"真的吗？太好了！感谢你！","status":"matched","hash_xxh64":"0xA7397537A12B56BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120226506:1":{"text":"Us Maulers gotta help each other out when we can!","source_cn":"我们蛮血之间，就是要互帮互助！而且你们也付出了报酬呢！","status":"matched","hash_xxh64":"0x46102AFCCB8CF820","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:采集的蛮血":{"text":"Mauler","source":"采集的蛮血","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"},"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":3}}