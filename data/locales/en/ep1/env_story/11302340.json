{"asset_key":"ep1/env_story_11302340","episode":"ep1","category":"env_story","story_id":"11302340","schema_version":1,"lang":"en","texts":{"say:1:1130234001:1":{"text":"It's a clay pot with a tall lid.","source_cn":"就是这种拥有高盖帽的陶土锅。","status":"matched","hash_xxh64":"0x3C7DAC65EE3E458C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1130234002:1":{"text":"When you get tired of desert barbecue, consider using one for a rich stew.","source_cn":"当你吃腻了荒漠的烤肉时，就可以考虑使用它做些富含汤汁的炖菜。","status":"matched","hash_xxh64":"0x9F052899D521C590","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1130234003:1":{"text":"But remember to oil the bottom, or else you'll be left with a black, mushy mess.","source_cn":"但是使用前记得给锅刷油，不然锅底很容易变得黑糊。","status":"matched","hash_xxh64":"0x7B9512ED0F9AE0B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:商人狄美尔":{"text":"Trader Dimara","source":"商人狄美尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}