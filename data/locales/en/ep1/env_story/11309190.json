{"asset_key":"ep1/env_story_11309190","episode":"ep1","category":"env_story","story_id":"11309190","schema_version":1,"lang":"en","texts":{"say:1:1130919001:1":{"text":"I thought the same thing, too.","source_cn":"是啊，我也这么觉得。","status":"matched","hash_xxh64":"0xC1027E82FE61DBB1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1130919002:1":{"text":"But if that Mauler's willing to put up the coin, what does it matter? As long as we get paid, it doesn't make a difference to us.","source_cn":"不过出钱的人说了算，那蛮血女孩愿意多雇人，多出钱，我们...","status":"matched","hash_xxh64":"0x9906EF3DCEEF2EDD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1130919003:1":{"text":"I just wish it wasn't literally the most boring job ever... I just wanna roam around Alkali with my gun!","source_cn":"……唉，可惜这是最没劲的活儿，我还想带着枪去咸水镇上逛逛呢。","status":"matched","hash_xxh64":"0x9182B7CB11D74EDD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1130919004:1":{"text":"These kids better not get on my bad side!","source_cn":"希望这群小孩别惹我生气！","status":"matched","hash_xxh64":"0x628C0731A39E5001","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:赏金猎人索普莉":{"text":"Hunter Sapari","source":"赏金猎人索普莉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count"