{"asset_key":"ep1/env_story_11301390","episode":"ep1","category":"env_story","story_id":"11301390","schema_version":1,"lang":"en","texts":{"say:1:1130139001:1":{"text":"Yes... I heard that the Warsong Festival is very dangerous.","source_cn":"是的……我听说战歌节的试炼就已经很危险。","status":"matched","hash_xxh64":"0xEEA2EF2C36C06B8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1130139002:1":{"text":"These trials always eliminate most of a clan's warriors and those who make it are very few.","source_cn":"这些试炼总能淘汰大部分部落的勇士，通过者从来都是少数。","status":"matched","hash_xxh64":"0xF3D2152E77387147","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1130139003:1":{"text":"I just hope they stay safe.","source_cn":"希望他们在试炼里能够平安。","status":"matched","hash_xxh64":"0xA9C85A61F127ECD9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:小蛮血瑟拉芬":{"text":"Seraphina","source":"小蛮血瑟拉芬","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}