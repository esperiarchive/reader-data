{"asset_key":"ep1/herohub_story_11412150","episode":"ep1","category":"herohub_story","story_id":"11412150","schema_version":1,"lang":"en","texts":{"say:2:1141215001:1":{"text":"Wait! Don't take my bottle. I got this delicious water from the market. It doesn't have a single grain of sand.","source_cn":"等一下，你不能拿走我的水壶，那里面可是我从集市淘换来的...","status":"matched","hash_xxh64":"0x2B24C694B06BE738","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1141215002:1":{"text":"... Really? No wonder it tastes so good!","source_cn":"……真的吗！怪不得喝起来特别好喝！","status":"matched","hash_xxh64":"0xBD68A6FACF6E8253","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1141215003:1":{"text":"Don't reckon you should put much stock in him. Alkali'd turn into an oasis before he spills any truth.","source_cn":"别什么都信，信他的嘴还不如信咸水镇会变成绿洲。","status":"matched","hash_xxh64":"0x696C8889749946B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1141215004:1":{"text":"According to my divination, Alkali will be an oasis in 372 years!","source_cn":"咸水镇真的会变成绿洲，我占卜过了，大约在372年之后！","status":"matched","hash_xxh64":"0x88296955147D5AD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:阿德":{"text":"Odie","source":"阿德","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","so