{"asset_key":"ep1/herohub_story_11411020","episode":"ep1","category":"herohub_story","story_id":"11411020","schema_version":1,"lang":"en","texts":{"say:3:1141102001:1":{"text":"How's the meat coming along? Is it ready yet?","source_cn":"好了吗？烤肉好了吗？","status":"matched","hash_xxh64":"0xB90B9FC5A9F70177","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1141102002:1":{"text":"Getting there.","source_cn":"还要一会儿。","status":"matched","hash_xxh64":"0xA103A48F8868F52C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1141102003:1":{"text":"It already smells amazing! Hey, Chippy doesn't think the Magister can wait much longer!","source_cn":"已经很香了！主人都快等不及了，我觉得已经可以吃了！","status":"matched_runtime_gender","hash_xxh64":"0xB98B8A4C481271E2","variant_status":"runtime_gender_keys_target_same","male":"It already smells amazing! Hey, Chippy doesn't think the Magister can wait much longer!","female":"It already smells amazing! Hey, Chippy doesn't think the Magister can wait much longer!","variant_male_record_index":"125172","variant_female_record_index":"125173","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1141102003":{"text":"It already smells amazing! Hey, Chippy doesn't think the Magister can wait much longer!","source_cn":"已经很香了！主人都快等不及了，我觉得已经可以吃了！","status":"matched_runtime_gender","hash_xxh64":"0xB98B8A4C481271E2","variant_status":"runtime_gender_keys_target_same","male":"It already smells amazing! Hey, Chippy doesn't think the Magister can wait much longer!","female":"It already smells amazing! Hey, Chippy doesn't think t