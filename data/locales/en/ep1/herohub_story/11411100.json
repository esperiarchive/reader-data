{"asset_key":"ep1/herohub_story_11411100","episode":"ep1","category":"herohub_story","story_id":"11411100","schema_version":1,"lang":"en","texts":{"say:2:1141110001:1":{"text":"Did you feel it? A refreshing breeze.","source_cn":"你们感受到了吗？刚才刮过来一阵清凉的风。","status":"matched","hash_xxh64":"0x8BC8D6127C303318","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1141110002:1":{"text":"Not until you asked. It did feel quite refreshing for a moment.","source_cn":"哈，不仔细还真没觉得，的确刚才有那么一瞬间蛮清爽的。","status":"matched","hash_xxh64":"0xC2663A5744235C8F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1141110003:1":{"text":"Being able to sense those subtle shifts is a sign you're adapting well to the desert.","source_cn":"感受到微弱的变化，说明你开始适应这片沙漠了。","status":"matched","hash_xxh64":"0x1A1E8B46B948FFB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1141110004:1":{"text":"I wish there was something to take the edge off this heat...","source_cn":"呼……如果适应之后能不怕热就好了……","status":"matched","hash_xxh64":"0x0AC417663B12D424","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":3}}