{"asset_key":"ep1/herohub_story_11412090","episode":"ep1","category":"herohub_story","story_id":"11412090","schema_version":1,"lang":"en","texts":{"say:2:1141209001:1":{"text":"Hey! What's for dinner? It smells so good!","source_cn":"嘿，你们在炖什么！好香啊！","status":"matched","hash_xxh64":"0xDE8BAE904A398E2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1141209002:1":{"text":"Hands off.","source_cn":"把手拿开。","status":"matched","hash_xxh64":"0xFD3C4776F4FFC874","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1141209003:1":{"text":"It's not ready yet?","source_cn":"怎么，还没做好？","status":"matched","hash_xxh64":"0x8B46FE821C7D8091","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1141209004:1":{"text":"Everyone must earn their meal.","source_cn":"不出力的人，没资格吃饭。","status":"matched","hash_xxh64":"0xD66B1D106007672F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1141209005:1":{"text":"Did you just call me a freeloader? Check this out!","source_cn":"竟敢说我不出力？！瞧着！","status":"matched","hash_xxh64":"0x55E501B90F4DAF8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1141209006:1":{"text":"Look closely! A REAL terrabird egg!","source_cn":"看好了，这可是真正的——陆行鸟蛋！","status":"matched","hash_xxh64":"0x20D795F673B3850B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1141209006":{"text":"Look closely! A REAL terrabird egg!","source_cn":"看好了，这可是真正的——陆行鸟蛋！","status":"matched","hash_xxh64":"0x20D795F673B3850B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1141209007:1":{"text":"Who said it's for eating? I'm just showing it off!","source_cn":"就是让你们看看，谁说让你们吃了？！","status":"matched","hash_xxh64":"0x8A6F7CD047D72502","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1141209008:1":{"text":"Pretty cool, right? I bet you've never seen a terrabird egg this close!","source_cn":"怎么样？没这么近距离见过陆行鸟的蛋吧！","status":"matched","hash_xxh64":"0xF4E7E30272C2ACF2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1141209009:1":{"text":"Press your ear against it, and you can actually hear it!","source_cn":"你们可以把耳朵贴上去，那小家伙甚至会在里面发出声音！","status":"matched","hash_xxh64":"0x510A2DB4205CF57E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1