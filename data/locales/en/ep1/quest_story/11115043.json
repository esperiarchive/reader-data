{"asset_key":"ep1/quest_story_11115043","episode":"ep1","category":"quest_story","story_id":"11115043","schema_version":1,"lang":"en","texts":{"say:0:1111504301:0":{"text":"You are finally here... Come and find me! I'm waiting for you at the deepest level.","source_cn":"你们终于来了……来吧……快来寻找我！我在最深处等着你们。","status":"matched","hash_xxh64":"0x09B1E367AAB1849F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1111504302:0":{"text":"In the deepest part? Wow! Will we see the Dusk Lord?","source_cn":"在最深处等待？哇！我们是不是会见到残阳神？","status":"matched","hash_xxh64":"0x836E5DAD4B067CDC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1111504303:0":{"text":"The Dusk Lord has fallen. This is his tomb. It's definitely not him talking.","source_cn":"残阳神已经陨落了，否则哪来的这座墓穴？肯定不是祂在说话。","status":"matched","hash_xxh64":"0xAB44B234EBFCB265","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:神秘的呼唤":{"text":"Mysterious Call","source":"神秘的呼唤","status":"matched_dialogue_flow"},"speaker:卡卡":{"text":"Koko","source":"卡卡","status":"matched_dialogue_flow"},"speaker:萨忒娜":{"text":"Satrana","source":"萨忒娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":3}}