{"asset_key":"ep1/quest_story_11233020","episode":"ep1","category":"quest_story","story_id":"11233020","schema_version":1,"lang":"en","texts":{"say:1:1123302001:1":{"text":"Are you alright? What happened?","source_cn":"您还好吗？出什么事了？","status":"matched","hash_xxh64":"0x5FAF1A447B5C21F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123302002:1":{"text":"How could I be alright? When I was young, my enemies stood before me. Now that I'm old, the enemy is my own body!","source_cn":"怎么会好？年轻的时候敌人都实实在在站在面前，上了年纪敌...","status":"matched","hash_xxh64":"0x341A2EA64ACFB088","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123302003:1":{"text":"Hashir is going to fall! Hurry, Chippy!","source_cn":"哈什尔要摔倒了！满满快！","status":"matched","hash_xxh64":"0xD32FD985A8639A7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123302004:1":{"text":"I've got you! Are you okay?","source_cn":"扶住了！您没事吧？","status":"matched","hash_xxh64":"0x9247FBB0E11D0EA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123302005:1":{"text":"Oh, it's nothing. I just lost my footing and... Ah...","source_cn":"别大惊小怪的，我只是一步没站稳而已，呼……呼。","status":"matched","hash_xxh64":"0xFC5925C4D3A8BDC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123302006:1":{"text":"You know... for a little furball, you've got some power in your legs.","source_cn":"没想到……你这小毛团劲儿还挺大的。","status":"matched","hash_xxh64":"0xAF108720745143B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123302007:1":{"text":"Ha! Chippy is an acorn knight! All knights have to be strong and fit!","source_cn":"嘿嘿，满满是骑士！骑士就要有大力气！","status":"matched","hash_xxh64":"0x6FB609B5A210806E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1123302007":{"text":"Ha! Chippy is an acorn knight! All knights have to be strong and fit!","source_cn":"嘿嘿，满满是骑士！骑士就要有大力气！","status":"matched","hash_xxh64":"0x6FB609B5A210806E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123302008:1":{"text":"Snakebone grass.","source_cn":"蛇骨草。","status":"matched","hash_xxh64":"0xCFF463F4B0607E4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123302009:1":{"text":"I'm no expert botanist, but isn't snakebone grass growing all around us?","source_cn":"虽然不太确定，您身边种植的不就是蛇骨草吗？","status":"matched","hash_xxh64":"0xD87377677CE62CA7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1123302010:1":{"text":"The samples nearby aren't mature enough.","source_cn":"这些还未成熟，并且数量也远远不够。","status":"matched","hash_xxh64":"0x3A0264170DA42F94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1123302011:1":{"text":"Since you're here anyway, take this pouch and pick some mature snakebone grass for me.","source_cn":"既然你们来了，袋子拿去，给我取一些成熟的蛇骨草来。","status":"matched","hash_xxh64":"0xE05A9BB19BC94CB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1123302012:1":{"text":"Does Chippy hear gold coins in this pouch?","source_cn":"这袋子里的……是金币？","status":"matched","hash_xxh64":"0x70EA441960BFD2C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1123302012":{"text":"Does Chippy hear gold coins in this pouch?","source_cn":"这袋子里的……是金币？","status":"matched","hash_xxh64":"0x70EA441960BFD2C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1123302013:1":{"text":"You're a weird one. First time I've met someone who didn't like money...","source_cn":"头一次见到你这种怪人。","status":"matched_runtime_gender","hash_xxh64":"0x23FE78223A9FABF9","variant_status":"runtime_gender_keys_target_same","male":"You're a weird one. First time I've met someone who didn't like money...","female":"You're a weird one. First time I've met someone who didn't like money...","variant_male_record_index":"127619","variant_female_record_index":"127620","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1123302014:1":{"text":"Yeah, well, money is useless to an old hermit like me.","source_cn":"好吧，反正这些对于我这个野外求生的老人来说，已经没什么...","status":"matched","hash_xxh64":"0xE9E2D4EED71BB744","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1123302015:1":{"text":"Just remember, I need mature snakebone grass.","source_cn":"不过记住，我需要成熟的蛇骨草。","status":"matched","hash_xxh64":"0xDECDF101F8CE8849","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"Agree but refuse the money.","source_cn":"答应，并拒绝钱袋","status":"matched_runtime_gender","hash_xxh64":"0x8A05E04CD83E21C5","variant_status":"runtime_gender_keys_target_same","male":"Agree but refuse the money.","female":"Agree but refuse the money.","variant_male_record_index":"64892","variant_female_record_index":"64893","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"I'll accept it after the job is done.","source_cn":"告知采完蛇骨草才来领","status":"matched_runtime_gender","hash_xxh64":"0x716C3E9934FD8E9F","variant_status":"runtime_gender_keys_target_same","male":"I'll accept it after the job is done.","female":"I'll accept it after the job is done.","variant_male_record_index":"64894","vari