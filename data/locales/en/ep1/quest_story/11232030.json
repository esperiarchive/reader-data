{"asset_key":"ep1/quest_story_11232030","episode":"ep1","category":"quest_story","story_id":"11232030","schema_version":1,"lang":"en","texts":{"say:2:1123203001:1":{"text":"What should I do? He ran away!","source_cn":"我、我该怎么做，它跑掉了！","status":"matched","hash_xxh64":"0x87CC1EC470994210","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123203002:1":{"text":"I'd run away too if I were in his place!","source_cn":"换做我也会想跑开的！","status":"matched","hash_xxh64":"0x90F2C5EBAF8C0113","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1123203002":{"text":"I'd run away too if I were in his place!","source_cn":"换做我也会想跑开的！","status":"matched","hash_xxh64":"0x90F2C5EBAF8C0113","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123203003:1":{"text":"My lizard got startled for some reason and crashed into this elder's tent... I didn't know how to make him stop!","source_cn":"我的蜥蜴不知道因为什么受惊了，还撞破了这位老人的帐篷，...","status":"matched","hash_xxh64":"0x7F1C65A40BF22960","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123203004:1":{"text":"He was only curious. Your actions just now are what startled him. Do you understand?","source_cn":"它并不是受惊，而是看到什么好奇的东西，是你刚才的动作让...","status":"matched","hash_xxh64":"0x7B20118F976965D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123203005:1":{"text":"I cannot fathom how someone as clumsy as you became a beast tamer.","source_cn":"真搞不懂你这种笨熊是怎么当上驯兽师的？","status":"matched","hash_xxh64":"0xED964B96F981003B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123203006:1":{"text":"I-I'm sorry. What should I do now?","source_cn":"对……对不起，我该怎么做？","status":"matched","hash_xxh64":"0x91239B9EF386C268","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123203007:1":{"text":"Go bother someone else. I don't have the patience to teach you.","source_cn":"问问别人吧，我可没闲心教你。","status":"matched","hash_xxh64":"0x65F3AD2BA3DF20F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1123203007":{"text":"Go bother someone else. I don't have the patience to teach you.","source_cn":"问问别人吧，我可没闲心教你。","status":"matched","hash_xxh64":"0x65F3AD2BA3DF20F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123203008:1":{"text":"Hmph! I just wanted to yell at him a bit.","source_cn":"哼，我只是想骂他几句而已。","status":"matched","hash_xxh64":"0xF68B11639892E117","variant_status":"","male":"","female":