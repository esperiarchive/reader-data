{"asset_key":"ep1/quest_story_11206030","episode":"ep1","category":"quest_story","story_id":"11206030","schema_version":1,"lang":"en","texts":{"say:1:1120603001:0":{"text":"Tell me, where is Lester's treasure hidden?!","source_cn":"说，英灵卡斯特的宝藏在哪？","status":"matched","hash_xxh64":"0x8031B5DC35DA2F7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1120603002:0":{"text":"You're not leaving anytime soon, so start talking!","source_cn":"快说，别想着逃跑！","status":"matched","hash_xxh64":"0x3DE76C6B73FD25EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120603003:1":{"text":"Please just listen to me! There is no treasure... I swear! I... I just made it all up...","source_cn":"不，你们听、听我说……真的没有什么宝藏……我发誓！那…...","status":"matched","hash_xxh64":"0xC8922266346CD9C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120603004:1":{"text":"\"Made it all up\", you say? Looks like you're still holding out on us.","source_cn":"编的故事？嘿，你倒是挺嘴硬的。","status":"matched","hash_xxh64":"0xBC3CD6719E4A2A93","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120603005:1":{"text":"This is your brother, right? Tell me what I want to know right now... Or I'll tie him up and ditch him in the desert.","source_cn":"这是你兄弟吧？你要是不说实话……我就把他捆起来丢进荒漠里。","status":"matched","hash_xxh64":"0x137560F31584DD2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120603006:1":{"text":"Between the heat, the scorpions, and the lack of food and water... I wonder how long he'll last out there?","source_cn":"荒漠、风沙、毒虫、烈日……你猜猜他能活多久？","status":"matched","hash_xxh64":"0x5BB03D391D8AA731","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1120603007:1":{"text":"No... Please! I'm telling you, I really don't know anything about the treasure...!","source_cn":"不……不要！求你们，求求你了，我……我真的不知道什么宝...","status":"matched","hash_xxh64":"0xB980254F4E8D1C7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1120603008:1":{"text":"He ain't talking, Boss! Quit wasting your time!","source_cn":"老大，他还嘴硬！别跟他废话了！","status":"matched","hash_xxh64":"0x333C85AA9893AD4F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1120603009:1":{"text":"S-Someone! Help...!","source_cn":"……别……别动手！我……救命！","status":"matched","hash_xxh64":"0x7BFBE61D2DD0A7EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1120603009":{"text":"S-Someone! Help...!","source_cn":"……别……别动手！我……救命！","status":"matched","hash_xxh64":"0x7BFBE61D2DD0A7EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1120603010:1":{"text":"Who are you?!","source_cn":"什么人？！","status":"matched","hash_xxh64":"0x920EB13E68F3414E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1120603011:1":{"text":"Hey, I recognize those two furballs! They're treasure-hunting hamsters!","source_cn":"嗯？我认得那两只仓鼠！那是可以勘探宝藏所在地的寻宝仓鼠！","status":"matched","hash_xxh64":"0x965AB4419C5999E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1120603012:1":{"text":"Not bad! Didn't think these treasure hunters had such tough friends!","source_cn":"嘿嘿，不错，没想到这俩宝藏猎人的同伙自己凑上来了！","status":"matched","hash_xxh64":"0xA19503D979F5E5FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:17:1120603012":{"text":"Not bad! Didn't think these treasure hunters had such tough friends!","source_cn":"嘿嘿，不错，没想到这俩宝藏猎人的同伙自己凑上来了！","status":"matched","hash_xxh64":"0xA19503D979F5E5FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1120603013:1":{"text":"First, this tight-lipped jerk, and now some meddling idiot! I just need one of you alive to tell me what I want to know!","source_cn":"嘴硬又喜欢多管闲事的家伙最可恨——既然这样，那就干掉你...","status":"matched","hash_xxh64":"0x800AF5B53E4A5C1B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:0:1":{"text":"Chippy and Hammie aren't treasure hunters.","source_cn":"满满和漫漫不是寻宝仓鼠","status":"matched_runtime_gender","hash_xxh64":"0x9DC0D7197D4A5948","variant_status":"runtime_gender_keys_target_same","male":"Chippy and Hammie aren't treasure hunters.","female":"Chippy and Hammie aren't treasure hunters.","variant_male_record_index":"63918","variant_female_record_index":"63919","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:1:2":{"text":"You might want to get your eyes checked.","source_cn":"看得出你视力不太好","status":"matched_runtime_gender","hash_xxh64":"0x698EEF089DCECFAF","variant_status":"runtime_gender_keys_target_same","male":"You might want to get your eyes checked.","female":"You might want to get your eyes checked.","variant_male_record_index":"63920","variant_female_record_index":"63921","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:2:3":{"text":"Come on, do something stupid.","source_cn":"你要是动手，我不会袖手旁观","status":"matched_runtime_gender","hash_xxh64":"0x2DCBDDF0D91F14F2","variant_status":"runtime_gender_keys_target_same","male":"Come on, do something stupid.","female":"Come on, do something stupid.","variant_male_record_index":"63922","variant_female_record_index":"63923","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:0:1":{"text":"What's this I hear about a treasure?","source_cn":"什么宝藏？我也想知道","status":"matc