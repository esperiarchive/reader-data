{"asset_key":"ep1/quest_story_11105300","episode":"ep1","category":"quest_story","story_id":"11105300","schema_version":1,"lang":"en","texts":{"say:1:1110530001:1":{"text":"Everyone...","source_cn":"我……大家……","status":"matched","hash_xxh64":"0x13B74CF4E524DC7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110530002:1":{"text":"Don't get up yet!","source_cn":"……太好了。先别动！","status":"matched","hash_xxh64":"0x2F88B60AD1A9A125","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110530003:1":{"text":"Soren, what...","source_cn":"索恩，之前……","status":"matched","hash_xxh64":"0x39A13838E40AC756","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1110530004:1":{"text":"I said hold still!","source_cn":"我说了，先别动！","status":"matched","hash_xxh64":"0x757B395315EBEF98","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1110530005:1":{"text":"Someone used a poisoned dagger on you. Smokey made an antidote, but it'll take some time to fully take effect.","source_cn":"有个小蛮血用涂毒的匕首刺伤了你。阿熏配出了解药，不过完...","status":"matched","hash_xxh64":"0x37BC5D96917F957D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1110530006:1":{"text":"How long was I out...?","source_cn":"是吗……需要多久？","status":"matched","hash_xxh64":"0xC652EBAE876AA18D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110530007:1":{"text":"Don't you worry about that! Your only job now is to rest properly!","source_cn":"别管这些！你现在的任务就是好好休息！","status":"matched","hash_xxh64":"0xB1151B4DCF7EA8A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1110530008:1":{"text":"It won't delay the preliminaries of the Warsong Festival, right?","source_cn":"不会耽误……战歌节初赛吧？","status":"matched","hash_xxh64":"0xFF819B3031E170D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1110530008":{"text":"It won't delay the preliminaries of the Warsong Festival, right?","source_cn":"不会耽误……战歌节初赛吧？","status":"matched","hash_xxh64":"0xFF819B3031E170D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1110530009:1":{"text":"Alsa...","source_cn":"阿尔萨……","status":"matched","hash_xxh64":"0x14CDB5A59F5D6830","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1110530010:1":{"text":"After all, Soren and I can't afford to give up at a time like this, right?","source_cn":"毕竟我和索恩——可不能在这个关头提前认输啊！对吧？","status":"matched","hash_xxh64":"0xA3745BA523CED5FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1110530011:1":{"text":"Of course. On the day of the preliminaries, I'll carry you to the arena myself if I have to.","source_cn":"呵……当然。初赛那天，我拎也要把你拎到赛场。","status":"matched","hash_xxh64":"0xCBD048E7960E259E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1110530012:1":{"text":"Jeez, Soren! Spare me the theatrics!","source_cn":"啊——不要不要！索恩大人饶命啊！","status":"matched","hash_xxh64":"0x383988BC595B4C9A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1110530013:1":{"text":"Um, Lady Mikola, about the potions I had earlier...","source_cn":"那个，曼卡拉大人，关于我之前那些个小饮料的小小问题……","status":"matched","hash_xxh64":"0x901D172ECA0053E1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1110530014:1":{"text":"If you promise not to do it again, I'll let it slide this time. But if I hear of any future digressions... there will be consequences!","source_cn":"你保证不再犯，我这次就放过你。若敢再犯，数罪并罚！","status":"matched","hash_xxh64":"0xD538A963584C6286","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1110530015:1":{"text":"Really? You're letting me off?","source_cn":"真、真的？真的放过我？","status":"matched","hash_xxh64":"0xD1F96F7A1732E1DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1110530016:1":{"text":"Consider it a small act of leniency. After all, you did save an important participant of the Warsong Festival!","source_cn":"就当是曼卡拉的小小宽宥吧。你可是救了战歌节重要的参赛者！","status":"matched","hash_xxh64":"0x1247890AC9A9C63D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1110530017:1":{"text":"Lady Mikola is so wise!","source_cn":"曼卡拉大人英明！","status":"matched","hash_xxh64":"0x6A6E84579396BF60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"You're worried about that?!","source_cn":"还在想战歌节的事？","status":"matched_runtime_gender","hash_xxh64":"0x29D7B988D856B31F","variant_status":"runtime_gender_keys_target_same","male":"You're worried about that?!","female":"You're worried about that?!","variant_male_record_index":"63134","variant_female_record_index":"63135","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"Your health comes first.","source_cn":"阿尔萨，身体要紧","status":"matched_runtime_gender","hash_xxh64":"0x84F5256855E1ACA4","variant_status":"runtime_gender_keys_target_same","male":"Your health comes first.