{"asset_key":"ep1/quest_story_11207740","episode":"ep1","category":"quest_story","story_id":"11207740","schema_version":1,"lang":"en","texts":{"say:2:1120774001:0":{"text":"Magister <style=\"stress\"><player_name></style>... we did it.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x1CF4CE23A15BB9D3","variant_status":"runtime_gender_keys_target_same","male":"Magister <style=\"stress\"><player_name></style>... we did it.","female":"Magister <style=\"stress\"><player_name></style>... we did it.","variant_male_record_index":"124917","variant_female_record_index":"124918","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1120774001":{"text":"Magister <style=\"stress\"><player_name></style>... we did it.","source_cn":"<style=stress><player_name></style>，我们……成功了。","status":"matched_runtime_gender","hash_xxh64":"0x1CF4CE23A15BB9D3","variant_status":"runtime_gender_keys_target_same","male":"Magister <style=\"stress\"><player_name></style>... we did it.","female":"Magister <style=\"stress\"><player_name></style>... we did it.","variant_male_record_index":"124917","variant_female_record_index":"124918","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120774002:0":{"text":"But I still have worries about the Claws.","source_cn":"只不过我还有一些忧虑……是关于流沙之爪的。","status":"matched_runtime_gender","hash_xxh64":"0xEDADD76C0865F874","variant_status":"runtime_gender_keys_target_same","male":"But I still have worries about the Claws.","female":"But I still have worries about the Claws.","variant_male_record_index":"124919","variant_female_record_index":"124920","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120774003:0":{"text":"I still have some friends from the Claws. They're not evil, either!"