{"asset_key":"ep1/quest_story_11102200","episode":"ep1","category":"quest_story","story_id":"11102200","schema_version":1,"lang":"en","texts":{"say:1:1110220001:1":{"text":"Friends of Mikola! Tonight, the new moon will hang high over the sand spiders' lair. Our warriors are ready to face the Trial of Blood!","source_cn":"曼卡拉的老朋友们——今夜，新月将高悬赤沙蛛域上空！而我...","status":"matched","hash_xxh64":"0x5F51CB21833878B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110220002:1":{"text":"They will need to find the Sand Spider Nest and bring back a spider egg to immortalize their victory at the Sunseek Arena!","source_cn":"他们将勇闯赤沙蛛域，将象征胜利的蜘蛛蛋带回残阳武斗场！","status":"matched","hash_xxh64":"0xF16E08B6CF35E3D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110220003:1":{"text":"Let glory shine upon the first trial of the Warsong Festival! Let us look forward to their triumph!","source_cn":"战歌节前的试炼荣耀开场！让我们期待他们的凯旋！","status":"matched","hash_xxh64":"0xF6D16F3A089FAC6A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1110220004:2":{"text":"Let's go, Magister.","source_cn":"我们出发吧，阿尔萨。","status":"matched","hash_xxh64":"0x4B66EDC2FBD5FE81","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1110220005:1":{"text":"You're holding my arm a little tight, Soren! Are you nervous?","source_cn":"好紧！索恩，干嘛紧紧抓着我的胳膊？难道你……紧张了？","status":"matched","hash_xxh64":"0x312914668792D641","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110220006:1":{"text":"You're the one who's nervous... I'm holding on to you so that you don't bury yourself in the sand.","source_cn":"是你在紧张……我抓住你，为了免得你把自己埋进沙子里。","status":"matched","hash_xxh64":"0x6DD48542F45CA0AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1110220006":{"text":"You're the one who's nervous... I'm holding on to you so that you don't bury yourself in the sand.","source_cn":"是你在紧张……我抓住你，为了免得你把自己埋进沙子里。","status":"matched","hash_xxh64":"0x6DD48542F45CA0AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1110220007:1":{"text":"I wouldn't do something that embarrassing in front of Magister <style=\"stress\"><player_name></style>...","source_cn":"当着<style=stress><player_nam...","status":"matched_runtime_gender","hash_xxh64":"0x95A8CA8F0B48A42B","variant_status":"runtime_gender_keys_target_same","male":"I wouldn't do something that embarrassing in front of Magister <style=\"stress\"><player_name></style>...","female":"I wouldn't do something that embarrassing in front of Magister <style=\"stress\"><player_name></style>...","variant_male_record_index":"117699","variant_female_record_index":"117700","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:111022