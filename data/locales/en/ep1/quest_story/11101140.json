{"asset_key":"ep1/quest_story_11101140","episode":"ep1","category":"quest_story","story_id":"11101140","schema_version":1,"lang":"en","texts":{"say:0:1110114001:0":{"text":"What is it like where the Uru Clan lives?","source_cn":"乌尔氏族生活的地方是什么样呢？","status":"matched","hash_xxh64":"0x065EC8384930D55A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1110114002:0":{"text":"There's an oasis with enough water for everyone, and there's good hunting nearby. We're surviving.","source_cn":"我们的绿洲有水源，附近还能打猎。大家互帮互助，都能勉强...","status":"matched","hash_xxh64":"0x5D42D5EDC1AB71E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110114003:0":{"text":"There's no point in raiding us since we don't have a lot, but we do enough to get by. It's enough for a home.","source_cn":"没有富足到让别人来抢，也没有贫瘠到让我们活不下去。那就...","status":"matched","hash_xxh64":"0x04A33545F5AECD4B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}