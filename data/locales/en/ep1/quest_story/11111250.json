{"asset_key":"ep1/quest_story_11111250","episode":"ep1","category":"quest_story","story_id":"11111250","schema_version":1,"lang":"en","texts":{"say:3:1111125001:1":{"text":"...It's over.","source_cn":"……结束了。","status":"matched","hash_xxh64":"0xF46D6F6DEB478B7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1111125001":{"text":"...It's over.","source_cn":"……结束了。","status":"matched","hash_xxh64":"0xF46D6F6DEB478B7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111125002:1":{"text":"It's... hard to say. I think I did what I needed to do.","source_cn":"或许吧……我不知道。我自认做了应做的事。","status":"matched","hash_xxh64":"0xDCEE2BF9FC3BB9E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111125003:1":{"text":"When it all went down, Ferranc set up an ambush for me and Wyatt and told him to put a bullet in me to save his own hide.","source_cn":"当年行动时，弗兰克设下埋伏，把我和怀亚特包围起来，命令...","status":"matched","hash_xxh64":"0xBE0100FA479C0B49","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111125004:1":{"text":"Wyatt didn't budge an inch.","source_cn":"但是，最后怀亚特没对我下手。","status":"matched","hash_xxh64":"0x0D179086FB888DF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1111125005:1":{"text":"Just tossed me his gun and said, \"Run, big guy!\"","source_cn":"他把自己的枪抛给我，对我说，“快跑，大块头！”。","status":"matched","hash_xxh64":"0x7832AB8F7378EC26","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1111125005":{"text":"Just tossed me his gun and said, \"Run, big guy!\"","source_cn":"他把自己的枪抛给我，对我说，“快跑，大块头！”。","status":"matched","hash_xxh64":"0x7832AB8F7378EC26","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111125006:1":{"text":"...Hm.","source_cn":"……嗯。","status":"matched","hash_xxh64":"0x48F4849C75055E3A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1111125008:1":{"text":"How are you feeling?","source_cn":"你现在感觉怎么样？","status":"matched","hash_xxh64":"0x6391321BFD7B22DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111125009:1":{"text":"Sort of heavy...","source_cn":"像负重训练。","status":"matched","hash_xxh64":"0x7EED441BCE2C65E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111125010:1":{"text":"It 