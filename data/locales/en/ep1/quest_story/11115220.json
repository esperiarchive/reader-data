{"asset_key":"ep1/quest_story_11115220","episode":"ep1","category":"quest_story","story_id":"11115220","schema_version":1,"lang":"en","texts":{"say:1:1111522001:0":{"text":"Is it... over?","source_cn":"结束了……？","status":"matched","hash_xxh64":"0x3E6F795EB2F850AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1111522002:0":{"text":"I'm alive... I can't believe it.","source_cn":"我还活着……真不敢相信。","status":"matched","hash_xxh64":"0x1467C1643563BEF5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1111522003:0":{"text":"See, Antandra? I've learned much in your absence.","source_cn":"安丹，看到了吗？你不在的这段时间，我也成长为可靠的战斗...","status":"matched","hash_xxh64":"0x5698976C81CFC6DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111522004:0":{"text":"Satrana! *Sob*","source_cn":"萨忒娜姐姐！呜呜呜……萨忒娜姐姐！","status":"matched","hash_xxh64":"0x8BE4870CDBD7255E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111522005:0":{"text":"Hey, hey, easy kid! You're all over me!","source_cn":"哎哎哎？你这小孩，不要突然扑过来啊！","status":"matched","hash_xxh64":"0x99A805E134F843FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111522006:0":{"text":"If not for your help in the battle, I don't think I ever would have seen Antandra again!","source_cn":"要不是你在战斗中干扰敌人！我肯定再也见不到安丹姐姐了！","status":"matched","hash_xxh64":"0x36513226450EE65F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1111522007:0":{"text":"I thought you just wanted to steal her away, and so I've been so cruel to you... and you still saved me! You're the best...","source_cn":"我以为你会抢走安丹姐，所以一直对你很凶，你却依然愿意救...","status":"matched","hash_xxh64":"0xB82DCA2F6290F929","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111522008:0":{"text":"From now on, you and Antandra are both my favorite people!","source_cn":"从现在起，你和安丹姐姐都是我最喜欢的人了！","status":"matched","hash_xxh64":"0x6425C06F794E6B0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111522009:0":{"text":"Hey, there can only be room for one favorite, so don't get greedy.","source_cn":"哼，留着你的好意吧， 最喜欢的人只能有一个，你可不要太贪心。","status":"matched","hash_xxh64":"0xC2712D801225B47C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111522010:0":{"text":"And who is Satrana's favorite person?","source_cn":"谁又是萨忒娜心中最喜欢的人呢？","status":"matched","hash_xxh64":"0x1EB0FD09535FD0D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111522011:0":{"text":"Think it over slowly. With that thick skull of yours, it might be a while before you figure it out!","source_cn":"你慢慢想吧，以你的死脑筋，我看你多久才能想出来！","status":"matched","hash_xxh64":"0x7E7DF5F6D77094B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1111522012:0":{"text":"It's finally over...","source_cn":"总算结束了……","status":"matched","hash_xxh64":"0x660252414BF40547","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1111522013:0":{"text":"Will the Crimson Highlands return to normal now?","source_cn":"将他封印后，深红高原就会恢复正常吗？","status":"matched","hash_xxh64":"0x95091FF6A8A33BF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1111522014:0":{"text":"Based on our previous experiences, it will take some time.","source_cn":"以我们之前的经验，恢复需要时间。","status":"matched","hash_xxh64":"0x665E64F504B2D588","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1111522015:0":{"text":"At the very least, they won't deteriorate any further. Things can only improve from here.","source_cn":"起码，事态不会进一步恶化了，只会渐渐好转。","status":"matched","hash_xxh64":"0x0B6626C7F008234C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1111522016:0":{"text":"Magister, we thwarted a Hypogean once again! Let's go back to Alkali to celebrate!","source_cn":"主人，我们又一次解决了恶魔引发的危机，应该回咸水镇好好...","status":"matched_runtime_gender","hash_xxh64":"0xC8877724BC239EBF","variant_status":"runtime_gender_keys_target_same","male":"Magister, we thwarted a Hypogean once again! Let's go back to Alkali to celebrate!","female":"Magister, we thwarted a Hypogean once again! Let's go back to Alkali to celebrate!","variant_male_record_index":"124949","variant_female_record_index":"124950","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1111522017:0":{"text":"We both know you only want to \"celebrate\" so you can go stuff your cheeks with food!","source_cn":"说什么想庆祝，其实你是嘴馋了，想吃点好的吧？","status":"matched","hash_xxh64":"0x5BC42A29AE01C151","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1111522018:0":{"text":"Chippy, as a familiar, you only need magic for nourishment but you're still so greedy!","source_cn":"满满，你明明是一只只需要补给魔力就能生存的使魔，却那么贪吃。","status":"matched","hash_xxh64":"0x7C6BE2B874E56191","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1111522019:0":{"text":"Magister... Hammie is bullying Chippy!","source_cn":"主人……漫漫欺负我！","status":"matched_runtime_gender","hash_xxh64":"0x6AD61F2AA51F6095","variant_status":"runtime_gender_keys_target_same","male":"Magister... Hammie is bullying Chippy!","female":"Magister... Hammie is bullying Chippy!","variant_male_record_index":"124953","variant_female_record_index":"124954","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1111522020:0":{"text":"Chippy! You've even learned how to tattle!","source_cn":"满满！你还学会告状了！","status":"matched","hash_xxh64":"0x03E9C66179CD18E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1111522021:0":{"text":"Help, Magister! Hammie must be stopped!","source_cn":"救命啊主人！您快管管漫漫啊！","status":"matched_runtime_gender","hash_xxh64":"0xDB027DCAA92A4D5A","variant_status":"runtime_gender_keys_target_same","male":"Help, Magister! Hammie must be stopped!","female":"Help, Magister! Hammie must be stopped!","variant_male_record_index":"124956","variant_female_record_index":"124957","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1111522022:0":{"text":"This sort of bickering sounds familiar.","source_cn":"久违了，这种吵吵闹闹的感觉。","status":"matched","hash_xxh64":"0x52577C7E7391A39E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1111522023:0":{"text":"Reminds me of Alsa always buzzing in my ear.","source_cn":"在阿尔萨边上，耳旁总是这种声音。","status":"matched","hash_xxh64":"0x5446581517FD4C0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:31:1111522023":{"text":"Reminds me of Alsa always buzzing in my ear.","source_cn":"在阿尔萨边上，耳旁总是这种声音。","status":"matched","hash_xxh64":"0x5446581517FD4C0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1111522024:0":{"text":"I didn't say that.","source_cn":"我可没说。","status":"matched_runtime_gender","hash_xxh64":"0x38FA7FE44BCEF60E","variant_status":"runtime_gender_keys_target_same","male":"I didn't say that.","female":"I didn't say that.","variant_male_record_index":"124960","variant_female_record_index":"124961","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1111522025:0":{"text":"But I don't wish to remain here any longer.","source_cn":"但是，我也不想在这里继续待下去。","status":"matched_runtime_gender","hash_xxh64":"0xB1AB531257195901","variant_status":"runtime_gender_keys_target_same","male":"But I don't wish to remain here any longer.","female":"But I don't wish to remain here any longer.","variant_male_record_index":"124962","variant_female_record_index":"124963","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1111522026:0":{"text":"Let's head back to Alkali. I'm sure everyone there could use good news.","source_cn":"走吧，回咸水镇。有很多人在等我们带回喜讯。","status":"matched_runtime_gender","hash_xxh64":"0xAA8CBD40CAFEDD7E","variant_status":"runtime_gender_keys_target_same","male":"Let's head back to Alkali. I'm sure everyone there could use good news.","female":"Let's head back to Alkali. I'm sure everyone there could use good news.","variant_male_record_index":"124964","variant_female_record_index":"124965","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:31:0:1":{"text":"You miss Alsa?","source_cn":"想阿尔萨了？","status":"matched_runtime_gender","hash_xxh64":"0xA536193054CC9C04","variant_status":"runtime_gender_keys_target_same","male":"You miss Alsa?","female":"You miss Alsa?","variant_male_record_index":"64206","variant_female_record_index":"64207","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:31:1:2":{"text":"Homesick?","source_cn":"想家了？","status":"matched_runtime_gender","hash_xxh64":"0x49BF984468B6586F","variant_status":"runtime_gender_keys_target_same","male":"Homesick?","female":"Homesick?","variant_male_record_index":"64208","variant_female_record_index":"64209","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:萨忒娜":{"text":"Satrana","source":"萨忒娜","status":"matched_dialogue_flow"},"speaker:卡卡":{"text":"Koko","source":"卡卡","status":"matched_dialogue_flow"},"speaker:安丹德拉":{"text":"Antandra","source":"安丹德拉","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":30,"localized_text_count":29,"speaker_count":6}}