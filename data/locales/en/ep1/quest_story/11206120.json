{"asset_key":"ep1/quest_story_11206120","episode":"ep1","category":"quest_story","story_id":"11206120","schema_version":1,"lang":"en","texts":{"say:3:1120612001:1":{"text":"Is this really one of the marked locations? It doesn't seem like there's anything here...","source_cn":"这就是手稿里标记的地方吗？可这里什么也没有……","status":"matched","hash_xxh64":"0x515AE689388C24A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120612002:1":{"text":"Just sand and more sand.","source_cn":"除了沙子，还是沙子。","status":"matched","hash_xxh64":"0x595949EACC813411","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120612003:1":{"text":"Hey, you remember what those bandits said about our hamster friends? Why were they so certain about them being treasure hunters?","source_cn":"还记得那些匪徒提到寻宝仓鼠的事吗？他们为什么会笃定咱们...","status":"matched","hash_xxh64":"0x7EAA9B53B29A12F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120612004:1":{"text":"Well, obviously, it's because all hamsters... Never mind... Do you think the treasure might be buried underground?","source_cn":"当然是因为……你是说，宝藏可能藏在地下？","status":"matched","hash_xxh64":"0x5FA379195DBD4A62","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120612005:1":{"text":"I'm not sure, but we could always try digging around the area?","source_cn":"虽然不能确定，但我们可以在这附近挖挖看。","status":"matched","hash_xxh64":"0xEE7D3634C50A2335","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120612006:1":{"text":"Then let's get to work! You guys can just leave it to us and look around elsewhere!","source_cn":"那我们赶快动工吧！这里我们来，你们去其他地方看看！","status":"matched","hash_xxh64":"0xAD8AC94D30C63A44","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120612007:1":{"text":"And don't worry, you'll get your share of whatever we find!","source_cn":"放心，不管找到什么，一定都有你们一份！","status":"matched","hash_xxh64":"0x476FA5A672C1B2BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:宝藏猎人欧迪尔":{"text":"Hunter Oldiler","source":"宝藏猎人欧迪尔","status":"matched_dialogue_flow"},"speaker:宝藏猎人艾文":{"text":"Hunter Evan","source":"宝藏猎人艾文","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":3}}