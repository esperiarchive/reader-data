{"asset_key":"ep1/quest_story_11108060","episode":"ep1","category":"quest_story","story_id":"11108060","schema_version":1,"lang":"en","texts":{"say:2:1110806001:0":{"text":"Look! The Maulers here have blocked the road with a barricade, so no one can get through!","source_cn":"你们看！这里的蛮血用拒马把路拦住了，这样就过不去了！","status":"matched","hash_xxh64":"0x868146DB88CFBE6C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110806002:0":{"text":"Why would they block the one and only road?","source_cn":"好端端的，为什么要把唯一的道路封住呢？","status":"matched","hash_xxh64":"0xA55A0019B4E7C3A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1110806003:0":{"text":"Halt! State your business! Are you here for trade or treasure hunting?","source_cn":"留步！你们来做什么？寻宝？还是经商？","status":"matched","hash_xxh64":"0x63DDE93720B30509","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1110806004:0":{"text":"We're here to find my little siblings.","source_cn":"……找人。","status":"matched","hash_xxh64":"0x45EC2740D5C8D369","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1110806005:0":{"text":"Have your folks gone missing as well?","source_cn":"找人？你们的族人也失踪了？","status":"matched","hash_xxh64":"0xAD84C0E45DE1FA0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant