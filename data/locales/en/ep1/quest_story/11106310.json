{"asset_key":"ep1/quest_story_11106310","episode":"ep1","category":"quest_story","story_id":"11106310","schema_version":1,"lang":"en","texts":{"say:1:1110631001:1":{"text":"It's an honor to meet the finalists of the Warsong Festival.","source_cn":"能见到本届战歌节挺进决赛的勇士们，是我们的荣幸。","status":"matched","hash_xxh64":"0xF0AEF2C22D651638","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110631002:1":{"text":"At this moment, you are undoubtedly among the strongest in the desert.","source_cn":"此时此刻，你们无疑是这片沙漠上的最强者。","status":"matched","hash_xxh64":"0x5DC4308A742837C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110631003:1":{"text":"Please allow me to confirm your identity before you head to <style=\"highlight\">Mars Peak</style>.","source_cn":"请容我在查验诸位身份后，放行诸位通往<style=hi...","status":"matched","hash_xxh64":"0xBC74530F116764AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1110631004:1":{"text":"How thorough...","source_cn":"真是铁面无私啊。","status":"matched","hash_xxh64":"0x74611C2D224A7D01","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1110631005:1":{"text":"Let me see... Brutus, Kruger, Alsa, and Soren—all are in attendance.","source_cn":"让我看看——布鲁特斯大人，克鲁格大人，阿尔萨大人，索恩...","status":"matched","hash_xxh64":"0xA3B07DE42393ABB6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110631006:1":{"text":"And Orson? Has he not traveled with you all?","source_cn":"还有，奥格大人？他没有和诸位一起行动吗？","status":"matched","hash_xxh64":"0xEDD0497930F302E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1110631006":{"text":"And Orson? Has he not traveled with you all?","source_cn":"还有，奥格大人？他没有和诸位一起行动吗？","status":"matched","hash_xxh64":"0xEDD0497930F302E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1110631007:1":{"text":"As I recall, he was quite injured from the last match. Kruger, do you know where he is?","source_cn":"我记得那场比赛中他并没有受重伤。克鲁格，你知道奥格现在...","status":"matched","hash_xxh64":"0x9B86011C0974FA5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1110631008:1":{"text":"Sorry, no. I'm a bit worried about him... he's been keeping to himself lately.","source_cn":"抱歉。我也很担心奥格，但他最近有些独来独往。我也没怎么...","status":"matched","hash_xxh64":"0x0620128BB440433C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1110631009:1":{"text":"Strange... A Mauler would never shy away from the Warsong Festival.","source_cn":"唔……真奇怪，没有蛮血会愿意放弃战歌节的荣耀，奥格那样...","status":"matched","hash_xxh64":"0x794E30CEF55C981F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1110631010:1":{"text":"Time is of the essence, so you all go on ahead. After all, the ascent demands great strength and stamina.","source_cn":"时间有限，你们先出发吧。毕竟登顶本身也需要足够的时间和体力。","status":"matched","hash_xxh64":"0x81A12B1CD2BFE057","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1110631011:1":{"text":"I'll wait here and make the climb with him!","source_cn":"我等在这里，跟他一起上去！","status":"matched","hash_xxh64":"0xB49E6CF5E699D69C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1110631012:1":{"text":"Let's go, we can't let this throw us off...","source_cn":"走吧，别被那家伙影响我们的比赛……","status":"matched","hash_xxh64":"0x61C5B8056F62F816","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"Where is Orson?","source_cn":"奥格不在？","status":"matched_runtime_gender","hash_xxh64":"0x952654ADD429DDA5","variant_status":"runtime_gender_keys_target_same","male":"Where is Orson?","female":"Where is Orson?","variant_male_record_index":"63636","variant_female_record_index":"63637","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"He doesn't seem to be here...","source_cn":"奥格不在……","status":"matched_runtime_gender","hash_xxh64":"0xFDE1A0FD4FB5CC69","variant_status":"runtime_gender_keys_target_same","male":"He doesn't seem to be here...","female":"He doesn't seem to be here...","variant_male_record_index":"63638","variant_female_record_index":"63639","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:守卫安塞尔":{"text":"Guard Ansiel","source":"守卫安塞尔","status":"matched_dialogue_flow"},"speaker:守卫安玛":{"text":"Guard Emma","source":"守卫安玛","status":"matched_dialogue_flow"},"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"},"speaker:布鲁特斯":{"text":"Brutus","source":"布鲁特斯","status":"matched_dialogue_flow"},"speaker:克鲁格":{"text":"Kruger","source":"克鲁格","status":"matched_dialogue_flow"},"speaker:曼卡拉":{"text":"Mikola","source":"曼卡拉","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":16,"localized_text_count":15,"speaker_count":7}}