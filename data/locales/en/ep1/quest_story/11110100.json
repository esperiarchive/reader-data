{"asset_key":"ep1/quest_story_11110100","episode":"ep1","category":"quest_story","story_id":"11110100","schema_version":1,"lang":"en","texts":{"say:2:1111010001:0":{"text":"Long time no see, Walker. You finally found some new partners?","source_cn":"稀客啊。瓦尔克，这次带着新搭档来了？","status":"matched","hash_xxh64":"0x444B3E5D7D2C011A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1111010002:0":{"text":"Come on, do I really need one?","source_cn":"唉，一个两个都是这样。我看起来很需要一个新搭档吗？","status":"matched","hash_xxh64":"0x88DCA39AA7503A85","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111010003:0":{"text":"Ahh... I miss those old times.","source_cn":"只是看到你，就会想起之前的日子。","status":"matched","hash_xxh64":"0x61D4FBF56AE02DF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111010004:0":{"text":"If you guys had made it back then, those crazy Quicksand Claws wouldn't be causing so much trouble now!","source_cn":"要是你们当时成功了，流沙之爪，那群鸟背上的疯子，也不会...","status":"matched","hash_xxh64":"0xEBD747FA35829884","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111010005:0":{"text":"Excuse me, I don't usually talk this much. The person you're looking for is outside.","source_cn":"算了，多嘴不是我的风格。你之前要找的人我带来了，在卸鞍...","status":"matched","hash_xxh64":"0x79B7EBB16DC4D4D1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111010006:0":{"text":"Thank you.","source_cn":"谢了。","status":"matched","hash_xxh64":"0xE6FE2A4DA303A36F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111010007:0":{"text":"Soren, please, keep your cool when we meet him. Don't mess this up.","source_cn":"顺便，索恩小兄弟，待会见了面别太冲动。太年轻气盛容易把...","status":"matched","hash_xxh64":"0x38DAC7E99396F352","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1111010008:0":{"text":"What...?","source_cn":"……什么？","status":"matched","hash_xxh64":"0x0F8E24FF28861CCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111010009:0":{"text":"Let's go see our informant.","source_cn":"走吧，去见见能给咱们情报的人。","status":"matched","hash_xxh64":"0xBC8059F8FDAAC4B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:“铁玫瑰”桑蒂":{"text":"\"Iron Rose\" Cindy","source":"“铁玫瑰”桑蒂","status":"matched_dialogue_flow"},"speaker:瓦尔克":{"text":"Walker","source":"瓦尔克","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10