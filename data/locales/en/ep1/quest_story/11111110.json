{"asset_key":"ep1/quest_story_11111110","episode":"ep1","category":"quest_story","story_id":"11111110","schema_version":1,"lang":"en","texts":{"say:1:1111111001:0":{"text":"You'll all be alright.","source_cn":"你们没事吧。","status":"matched_runtime_gender","hash_xxh64":"0x7AD0C9F0149E13CB","variant_status":"runtime_gender_keys_target_same","male":"You'll all be alright.","female":"You'll all be alright.","variant_male_record_index":"121771","variant_female_record_index":"121772","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1111111002:0":{"text":"Yeah! We all knew that when you and Alsa found out, you'd come and save us!","source_cn":"嗯！我们一直相信，要是你和阿尔萨姐姐知道了，一定会来找我们！","status":"matched","hash_xxh64":"0x738A1F1E5EEF29A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1111111003:0":{"text":"We never stopped hoping, no matter how bad it got!","source_cn":"所以不管那些坏家伙怎么欺负人，我们都要坚持下去！","status":"matched","hash_xxh64":"0x15D72346BD6E721D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111111004:0":{"text":"But... where is Alsa?","source_cn":"咦……阿尔萨姐姐呢？","status":"matched","hash_xxh64":"0xB0630C49569DCA04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1111111004":{"text":"But... where is Alsa?","source_cn":"咦……阿尔萨姐姐呢？","status":"matched","hash_xxh64":"0xB0630C49569DCA04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111111005:0":{"text":"Sorry, we never should've gone out looking for the treasure...","source_cn":"对不起，<style=stress><player_n...","status":"matched_runtime_gender","hash_xxh64":"0x13BD6EE14F0D9B49","variant_status":"runtime_gender_keys_target_same","male":"Sorry, we never should've gone out looking for the treasure...","female":"Sorry, we never should've gone out looking for the treasure...","variant_male_record_index":"121776","variant_female_record_index":"121777","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111111006:0":{"text":"We really wanted to help Soren and Alsa.","source_cn":"我、我们真的很想给索恩和阿尔萨帮忙……","status":"matched","hash_xxh64":"0xA60232406C0366D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111111007:0":{"text":"You're the most helpful while looking after yourselves... Alsa is worried sick!","source_cn":"你们能照顾好自己，就是给阿尔萨和我分忧了。那个笨蛋担心...","status":"matched","hash_xxh64":"0xA7C6642FF4484973","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111111008:1":{"text":"Are these pups your kin? Not bad, they've got the eyes of future hunters.","source_cn":"这些娃娃就是你的族人？不错，眼神很棒，像是能成为猎人的...","status":"matched","hash_xxh64":"0x8C7676A6CBC6CD60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111111009:1":{"text":"But we shouldn't linger here.","source_cn":"但这地方实在不宜久留。先把他们送走？","status":"matched","hash_xxh64":"0x17D656826EA94082","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1111111010:1":{"text":"Another member of my clan, Simba, is waiting for them in the Thundra Settlement.","source_cn":"我的另一个族人，小瑟巴，现在正在雷矛聚落等他们。","status":"matched","hash_xxh64":"0xF182ED4826C30047","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1111111011:1":{"text":"But that mongrel Ferranc...","source_cn":"不过，弗兰克那混蛋……","status":"matched","hash_xxh64":"0x207BEC434D05794F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1111111012:1":{"text":"Thundra... Are you talking about my settlement? Do you know our leader, Ulma?","source_cn":"雷矛——你们在说我的聚落？难道你们认识我们的领袖，尤玛？","status":"matched","hash_xxh64":"0xA5D67AB1417FB9EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:19:1111111012":{"text":"Thundra... Are you talking about my settlement? Do you know our leader, Ulma?","source_cn":"雷矛——你们在说我的聚落？难道你们认识我们的领袖，尤玛？","status":"matched","hash_xxh64":"0xA5D67AB1417FB9EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1111111013:1":{"text":"I remember! Ulma is the graceful and stunning leader of the leopard tribe!","source_cn":"我有印象，尤玛是那位矫健美丽的豹女领袖！","status":"matched","hash_xxh64":"0xE4FB2C1D6DF104A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1111111015:1":{"text":"Ulma! Ulma! She hasn't abandoned her kin!","source_cn":"尤玛！尤玛！她没有放弃她的同胞！","status":"matched","hash_xxh64":"0x689002F146B97182","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1111111016:1":{"text":"I, Ugar of the Thundra Clan, am too injured to work, so the Quicksand Claws threw me in here with the little ones.","source_cn":"我，雷矛的乌格尔，受了伤，干不动重活，所以和这些孩子们...","status":"matched","hash_xxh64":"0x4D8D128929ACBBC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1111111017:1":{"text":"If you lend me your trust, I'll guide them back to my home!","source_cn":"要是你们信任我，我可以带这几个孩子回雷矛聚落！","status":"matched_runtime_gender","hash_xxh64":"0x19C1D1BDD4C66A62","variant_status":"runtime_gender_keys_target_same","male":"If you lend me your trust, I'll guide them back to my home!","female":"If you lend me your trust, I'll guide them back to my home!","variant_male_record_index":"121790","variant_female_record_index":"121791","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1111111018:1":{"text":"You... the Quicksand Claws enslaved you?","source_cn":"你……那些流沙之爪，在奴役你们？","status":"matched","hash_xxh64":"0x4E4AD352121C4AF2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1111111019:1":{"text":"Curse them! If I get the chance, they won't be spared!","source_cn":"可恶，可恶可恶可恶！！要是有机会，我绝对不会放过他们！","status":"matched","hash_xxh64":"0xA385A6437CAADABE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1111111020:1":{"text":"Soren, aren't you coming back with us?","source_cn":"索恩，你不和我们一起回去吗……？","status":"matched_runtime_gender","hash_xxh64":"0x071FB5EFB09DB41B","variant_status":"runtime_gender_keys_target_same","male":"Soren, aren't you coming back with us?","female":"Soren, aren't you coming back with us?","variant_male_record_index":"121794","variant_female_record_index":"121795","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1111111021:1":{"text":"We're going to challenge the leader of the Quicksand Claws—Ferranc.","source_cn":"我们要去挑战流沙之爪的首领，弗兰克。","status":"matched_runtime_gender","hash_xxh64":"0xFDDB01C1A67C9409","variant_status":"runtime_gender_keys_target_same","male":"We're going to challenge the leader of the Quicksand Claws—Ferranc.","female":"We're going to challenge the leader of the Quicksand Claws—Ferranc.","variant_male_record_index":"121796","variant_female_record_index":"121797","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1111111022:1":{"text":"I will personally make him pay for the pain he inflicted on you all. The Quicksand Claws will learn they never should have preyed upon the Uru Clan.","source_cn":"他在你们身上施加的恐惧和痛苦，我要让他亲自尝尝。让流沙...","status":"matched","hash_xxh64":"0x84AE5DFD0D57219E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1111111023:1":{"text":"Do you know where we can find him?","source_cn":"你们知道他在哪里吗？","status":"matched","hash_xxh64":"0xF7CB6888908DE4EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1111111024:1":{"text":"I heard those bad guys say he's in the <style=\"highlight\">big tent to the north</style>, and that he's really mad and grumpy!","source_cn":"我听那些坏家伙说，他们的老大总是在<style=hig...","status":"matched","hash_xxh64":"0xBEF5EFA25EC71357","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1111111025:1":{"text":"Soren, please be careful...","source_cn":"索恩，你要小心……","status":"matched","hash_xxh64":"0x50253BAC42567166","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1111111026:1":{"text":"It's you who needs to be careful. Stay close to Ugar and he'll watch over you.","source_cn":"要小心的是你们。去雷矛聚落的路上，多留心身边的情况，跟...","status":"matched","hash_xxh64":"0xF895C47AEF2D58A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1111111027:1":{"text":"Ugh... Alsa is better at this.","source_cn":"啧……这话，该让阿尔萨来说。","status":"matched","hash_xxh64":"0x262E988EFEA51FFF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1111111028:1":{"text":"<style=\"stress\"><player_name></style>, let's move. It's time for Ferranc to pay.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xF46BB431096E71F9","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, let's move. It's time for Ferranc to pay.","female":"<style=\"stress\"><player_name></style>, let's move. It's time for Ferranc to pay.","variant_male_record_index":"121804","variant_female_record_index":"121805","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:0:1":{"text":"I think so...","source_cn":"印象不深了","status":"matched_runtime_gender","hash_xxh64":"0x9334BBA0BD7F62A4","variant_status":"runtime_gender_keys_target_same","male":"I think so...","female":"I think so...","variant_male_record_index":"63438","variant_female_record_index":"63439","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1111111014:1":{"text":"That's it! I remember it being called Thundra!","source_cn":"就是那里，我记得那个聚落好像是叫雷矛！","status":"matched","hash_xxh64":"0x28C44AD17C7EACD4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:1:2":{"text":"Where the caravan stopped?","source_cn":"是那个遭劫商队停靠的聚落？","status