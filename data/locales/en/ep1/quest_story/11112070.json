{"asset_key":"ep1/quest_story_11112070","episode":"ep1","category":"quest_story","story_id":"11112070","schema_version":1,"lang":"en","texts":{"say:1:1111207001:2":{"text":"Wow! Your tail is so fluffy! I wish I had a tail like yours!","source_cn":"哇……姐姐，你的尾巴真蓬松啊，我也想要你这样蓬松的尾巴！","status":"matched","hash_xxh64":"0x92CB6F43CFA48C16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1111207002:2":{"text":"Stop pulling on it! It's not something you can take off and wear!","source_cn":"别揪了！我的尾巴不可能切下来装在你身上！","status":"matched","hash_xxh64":"0x105D227EEE2175F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111207003:2":{"text":"Where are you from? I've never seen you before. How old are you? Can I play with that thing in your hand?","source_cn":"姐姐，你是哪来的？从来没见过你呢。你多大了？你手里的东...","status":"matched","hash_xxh64":"0xAE82726A684E2271","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111207004:2":{"text":"No!","source_cn":"——不可以！","status":"matched","hash_xxh64":"0xDD8B0733F744F6CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1111207005:4":{"text":"What are you all doing? Stop it right now!","source_cn":"你们在干什么？都给我住手！","status":"matched","hash_xxh64":"0xB7962F7BDACED65D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111207006:1":{"text":"I can't take it anymore! Look at this crazy place... bounty hunters, grubby little children... I'm leaving!","source_cn":"受不了了！看看这个奇怪的地方……一群孩子，还有一群赏金...","status":"matched","hash_xxh64":"0xBEF6780DE050CA25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111207007:1":{"text":"Satrana, wait!","source_cn":"等等！萨忒娜——","status":"matched","hash_xxh64":"0xAABBFAC867DB6D96","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1111207008:1":{"text":"And you! Antandra, you have to leave with me!","source_cn":"至于你！安丹德拉，你必须和我一起走！","status":"matched","hash_xxh64":"0x74F243EB56C136CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111207009:1":{"text":"What? Just calm down for a moment...","source_cn":"什么？你先冷静点……","status":"matched","hash_xxh64":"0x8DDA810882297797","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111207010:1":{"text":"I am calm! I traveled all this way just to get you out of the desert!","source_cn":"我很冷静！实话告诉你吧，我千辛万苦来找你，就是为了带你...","status":"matched","hash_xxh64":"0x3B710872615F4450","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1111207011:1":{"text":"You want to take Antandra away from us? No! You can't!","source_cn":"你要带走安丹姐？不许！","status":"matched","hash_xxh64":"0x76A64577B22CB535","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1111207012:1":{"text":"I saw the future! I saw everything...","source_cn":"因为我看到了——我预见了未来！","status":"matched","hash_xxh64":"0x0832514EE9B8381C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1111207013:1":{"text":"If she stays here, only death awaits her!","source_cn":"如果她留在这里，等待她的只有死亡！","status":"matched","hash_xxh64":"0x597CD73E64991295","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:18:1111207013":{"text":"If she stays here, only death awaits her!","source_cn":"如果她留在这里，等待她的只有死亡！","status":"matched","hash_xxh64":"0x597CD73E64991295","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1111207014:1":{"text":"Revealing the future is not something I take lightly.","source_cn":"不轻易泄露命运，这是我的准则。","status":"matched","hash_xxh64":"0xA02909CDE0CE9D09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1111207016:1":{"text":"You're a liar!","source_cn":"骗子！","status":"matched","hash_xxh64":"0x7AA49E581F72D1A5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1111207017:1":{"text":"I wish I was. Unfortunately, my prophecies never lie.","source_cn":"我也希望自己是在骗你。很可惜……我的预言，从不撒谎。","status":"matched","hash_xxh64":"0x952DC9841FA3A53D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1111207018:1":{"text":"No! Don't leave us, Antandra! You can't go!","source_cn":"不……安丹姐你别走！你别离开我们！","status":"matched","hash_xxh64":"0xCD5822232AD5B53F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1111207019:1":{"text":"It's alright, Koko. I'm not going anywhere.","source_cn":"没事的卡卡，我不会走。","status":"matched","hash_xxh64":"0x611472284647FB63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1111207020:1":{"text":"How could I possibly leave, Satrana? Who would protect them?","source_cn":"我现在不可能离开……萨忒娜。我走了，谁来保护这些孩子？","status":"matched","hash_xxh64":"0x9A2BE20A9F5D5D30","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1111207021:1":{"text":"You're always protecting other people! As long as I've known you, you've never thought about yourself!","source_cn":"你总是在保护别人！每一次我见到你，你都在保护别人！丝毫...","status":"matched","hash_xxh64":"0x264A253420DC95E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1111207022:1":{"text":"Who's going to protect you when the time comes?","source_cn":"你保护了别人，谁又能保护你？","status":"matched","hash_xxh64":"0xD93D69E58C8DEE42","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1111207023:1":{"text":"Me! I'll protect her!","source_cn":"我！我来保护！","status":"matched","hash_xxh64":"0x385183B1E26F614E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1111207024:1":{"text":"Are you listening to what I'm saying? No one has ever been able to alter my prophecies, let alone some child!","source_cn":"你一个小屁孩，少在那自不量力！从来没有人能打破我的预言...","status":"matched","hash_xxh64":"0x9746E5BA742DA9B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1111207025:1":{"text":"I don't believe you! You're just trying to take away Antandra! I hate you!","source_cn":"我不信！你抢走安丹姐姐……是坏人！","status":"matched","hash_xxh64":"0x391A792620D78FD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:0:1":{"text":"You never told us that!","source_cn":"你的口风可真紧啊！","status":"matched_runtime_gender","hash_xxh64":"0xBA2F3526A02EBA32","variant_status":"runtime_gender_keys_target_same","male":"You never told us that!","female":"You never told us that!","variant_male_record_index":"63696","variant_female_record_index":"63697","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1111207015:1":{"text":"Because I didn't want to believe it...","source_cn":"因为我也不愿意相信这则预言……","status":"matched","hash_xxh64":"0xBAC1A9B3B0D6A9B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:1:2":{"text":"Why didn't you say this sooner?","source_cn":"这种事怎么不早说？","status":"matched_runtime_gender","hash_xxh64":"0xAC18F62477FD09F5","variant_status":"runtime_gender_keys_target_same","male":"Why didn't you say this sooner?","female":"Why didn't you say this sooner?","variant_male_record_index":"63698","variant_female_record_index":"63699","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:一脸羡慕的小孩":{"text":"Envious Kid","source":"一脸羡慕的小孩","status":"matched_dialogue_flow"},"speaker:萨忒娜":{"text":"Satrana","source":"萨忒娜","status":"matched_dialogue_flow"},"speaker:好奇心重的小孩":{"text":"Curious Kid","source":"好奇心重的小孩","status":"matched_dialogue_flow"},"speaker:安丹德拉":{"text":"Antandra","source":"安丹德拉","status":"matched_dialogue_flow"},"speaker:卡卡":{"text":"Koko","source":"卡卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":29,"localized_text_count":28,"speaker_count":5}}