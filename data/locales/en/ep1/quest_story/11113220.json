{"asset_key":"ep1/quest_story_11113220","episode":"ep1","category":"quest_story","story_id":"11113220","schema_version":1,"lang":"en","texts":{"say:1:1111322001:0":{"text":"Now, tell me about this so-called treasure that everyone's talking about.","source_cn":"说说看，你们所谓的宝藏，究竟是什么？","status":"matched","hash_xxh64":"0xECDC4D6E8135A0D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1111322002:0":{"text":"Bah! You think I'd tell you just because you asked? Keep dreaming!","source_cn":"呸！你想知道我就告诉你啊？哪有这种好事！","status":"matched","hash_xxh64":"0x19694993501A6E63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111322003:0":{"text":"If the next words out of your mouth aren't something I want to hear...","source_cn":"如果你的下一句话，不能给出我想听到的答案。","status":"matched","hash_xxh64":"0xC18FE9F42F669991","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111322004:0":{"text":"...then consider them your last.","source_cn":"那么，这就是你的最后一句话了。","status":"matched","hash_xxh64":"0x157D08F4B62723FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111322005:0":{"text":"N-No, please. I'll talk! Just don't hurt me!","source_cn":"别、别这样，小哥，我说！我说还不行吗！","status":"matched","hash_xxh64":"0x8D0435557EACEF74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111322006:1":{"text":"My patience is running out, so make it quick.","source_cn":"我的耐心有限。","status":"matched","hash_xxh64":"0x9886BF4C6D96E420","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1111322007:0":{"text":"The truth is... <style=\"highlight\">there is no treasure</style>!","source_cn":"宝藏……<style=highlight>根本不存在！...","status":"matched","hash_xxh64":"0xC8F386312A046342","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111322008:1":{"text":"Then what exactly is the Adamant Syndicate doing here?","source_cn":"那么，黑金商会的目的是什么？","status":"matched","hash_xxh64":"0x3FB8F7684729B0B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111322009:0":{"text":"We want to open the Dusk Lord's tomb.","source_cn":"打开残阳神的墓穴！","status":"matched","hash_xxh64":"0x851A6AEEC0E70DA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1111322010:0":{"text":"We're trying to fool people into opening the tomb for us.","source_cn":"我们希望那些上当的人过来，打开残阳神的墓穴！","status":"matched","hash_xxh64":"0xA30774E5C0F62103","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111322011:0":{"text":"The tomb... What are you planning to do with it?","source_cn":"盗墓……你们想得到什么？","status":"matched","hash_xxh64":"0x4D4C9F02CB5F848D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111322012:0":{"text":"I-I don't know. Please just let me go...","source_cn":"我、我不知道！放过我吧……","status":"matched","hash_xxh64":"0x83F6D884192C8440","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1111322013:2":{"text":"Ugh!","source_cn":"哎呦！","status":"matched","hash_xxh64":"0xD4D6BDA69109991D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1111322014:0":{"text":"*Sigh*... Soren's as ruthless as ever.","source_cn":"唔……索恩，丝毫没有手下留情呢。","status":"matched","hash_xxh64":"0x01AFDB8523108C83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1111322015:0":{"text":"He passed out from the pain. Should we be worried?","source_cn":"那家伙直接痛得晕过去了，不要紧吗？","status":"matched","hash_xxh64":"0xD6D75B6695DA786E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1111322016:0":{"text":"Leave him. He'll manage on his own.","source_cn":"不管，让他自生自灭。","status":"matched","hash_xxh64":"0xFE2F2FD7EDDA2F36","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"},"speaker:黑金商会成员":{"text":"Syndicate Member","source":"黑金商会成员","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":17,"localized_text_count":16,"speaker_count":3}}