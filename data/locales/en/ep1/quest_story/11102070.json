{"asset_key":"ep1/quest_story_11102070","episode":"ep1","category":"quest_story","story_id":"11102070","schema_version":1,"lang":"en","texts":{"say:0:1110207001:0":{"text":"Does no one want to get this \"ancient weapon\"?","source_cn":"就没有人想要拿到初代战神的武器吗？","status":"matched","hash_xxh64":"0xF0753BAA8BE3DD0D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1110207002:0":{"text":"It doesn't matter. A true warrior doesn't need outside help. Brutus didn't need it.","source_cn":"这不重要。真正的战士，无需外力辅助。布鲁特斯大人就没有...","status":"matched","hash_xxh64":"0x2AE1E84424C6DD9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110207003:0":{"text":"And he's the strongest warrior among the Mauler clans. Everyone aspires to be like him.","source_cn":"但他仍然是蛮血最强的男人，没有人不想成为他那样的强者。","status":"matched","hash_xxh64":"0xEE08707292C8974E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}