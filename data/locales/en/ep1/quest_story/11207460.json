{"asset_key":"ep1/quest_story_11207460","episode":"ep1","category":"quest_story","story_id":"11207460","schema_version":1,"lang":"en","texts":{"say:3:1120746001:0":{"text":"Here, drink this down. It should help you.","source_cn":"给你，把这瓶药喝下去，应该能改善一些身体的状况。","status":"matched","hash_xxh64":"0xCA82CC8255F660DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120746002:0":{"text":"... I'm sorry.","source_cn":"……对不起。","status":"matched","hash_xxh64":"0x97EBC1A01925ACCA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120746003:0":{"text":"You'll feel better soon!","source_cn":"你们会很快好起来！","status":"matched","hash_xxh64":"0x5E345E652D861ECF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120746004:0":{"text":"... I-I can lift my arm again!","source_cn":"唔……好像，胳膊能抬起来了！","status":"matched","hash_xxh64":"0x54B6D7D6E349C120","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120746005:0":{"text":"I can see again! It's not blurry anymore.","source_cn":"我也是……渐渐能看清东西了。","status":"matched","hash_xxh64":"0x9CE40C26B9FFB670","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1120746006:0":{"text":"Y-You're a couple of Quicksand Claws! How did you get here?!","source_cn":"你——你们是流沙之爪？！怎么会进到部落来？！","status":"matched","hash_xxh64":"0xA8447971B0F99BEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1120746007:0":{"text":"Enfa! Run! Don't let them catch us!","source_cn":"恩法，跑……跑！不能再被他们抓走了！","status":"matched","hash_xxh64":"0xF4F6D39E6D439DEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1120746007":{"text":"Enfa! Run! Don't let them catch us!","source_cn":"恩法，跑……跑！不能再被他们抓走了！","status":"matched","hash_xxh64":"0xF4F6D39E6D439DEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1120746009:0":{"text":"I'm sorry, but medicine...? Can the scars we've endured be cured with medicine?","source_cn":"道歉、治疗……流沙之爪留在大家身上的伤痕，难道靠道歉就...","status":"matched","hash_xxh64":"0x17A127FBF4290B85","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1120746010:0":{"text":"No, they can't. But that doesn't mean we don't regret all that's happened. We really are sorry.","source_cn":"我知道，所以只是来说声对不起。","status":"matched","hash_xxh64":"0xFDA10C74387A87F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1120746011:0":{"text":"Very sorry, yes! Chak and I know it was wrong to follow those bad guys.","source_cn":"对、对不起……卢玛和奇克，知道错了。我们不该和坏人一起。","status":"matched","hash_xxh64":"0xCA13EB9160DF440E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1120746012:0":{"text":"And now, we can't just sit around and do nothing.","source_cn":"也不该什么都不做。","status":"matched","hash_xxh64":"0xF586B22490FEF7AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1120746013:0":{"text":"... In any case, the medicine worked. Atillia, do not put your body under further stress.","source_cn":"……不管怎么说，他们的药确实很有用。阿蒂拉，别和自己的...","status":"matched","hash_xxh64":"0x624F09D158C7E5F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1120746014:0":{"text":"Hmph...","source_cn":"哼……","status":"matched","hash_xxh64":"0x1E432E9A1B981E50","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1120746015:0":{"text":"If you two truly want to make amends, you better not have any more dealings with the Quicksand Claws.","source_cn":"你们如果真的想做好人，记住，不要再和流沙之爪扯上任何关系。","status":"matched","hash_xxh64":"0x9EF5C25666CA343A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1120746016:0":{"text":"Let's go. I won't direct my anger toward a child.","source_cn":"走吧，我不想把仇恨指向孩子。","status":"matched","hash_xxh64":"0xAF605C16ABF6D18E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1120746017:0":{"text":"Know anyone else we can help?","source_cn":"那、那你们知道还有谁需要帮助吗？","status":"matched","hash_xxh64":"0x2A0B40E2A5A8D7A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1120746018:0":{"text":"We just want to help people.","source_cn":"我们，想帮忙！不是捣乱！","status":"matched","hash_xxh64":"0xB1AE124372D3259A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1120746019:0":{"text":"The clan is rebuilding. Skinny younglings like you won't be of much use.","source_cn":"……部族正在重建，像你们这么瘦弱的小孩，做不来苦力活。","status":"matched","hash_xxh64":"0xF4F4AED1A213FFEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1120746020:0":{"text":"If you really wish to help, go to the <style=\"highlight\">plains east of the clan</style>. Jotas traveled there to tame terrabirds but hasn't returned for a long time.","source_cn":"你们要是真想帮忙，就去<style=highlight...","status":"matched","hash_xxh64":"0xAC6A7197E350A95C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1120746021:0":{"text":"Whether he'll accept your aid or not remains to be seen.","source_cn":"至于他让不让你们帮，就看你们自己了。","status":"matched","hash_xxh64":"0x8ACC3A6D5E049CF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1120746022:0":{"text":"Eastern plains, terrabirds... Got it! Thank you!","source_cn":"东边，陆行鸟……我知道了，谢谢！","status":"matched","hash_xxh64":"0x25B6E186F4B1A8E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:0:1":{"text":"These two wish to make amends.","source_cn":"奇克和卢玛是来道歉的","status":"matched_runtime_gender","hash_xxh64":"0x3590C113A0BF6A47","variant_status":"runtime_gender_keys_target_same","male":"These two wish to make amends.","female":"These two wish to make amends.","variant_male_record_index":"64544","variant_female_record_index":"64545","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:1:2":{"text":"They made this medicine for you.","source_cn":"治疗你们的药，是他们做的","status":"matched_runtime_gender","hash_xxh64":"0x7E4042C82CBE1FAC","variant_status":"runtime_gender_keys_target_same","male":"They made this medicine for you.","female":"They made this medicine for you.","variant_male_record_index":"64546","variant_female_record_index":"64547","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1120746008:0":{"text":"Just because you say that doesn't make it true!","source_cn":"一句没有作恶，就想撇清关系？怎么可能！","status":"matched_runtime_gender","hash_xxh64":"0x275C1E7FE895E6AE","variant_status":"runtime_gender_keys_target_same","male":"Just because you say that doesn't make it true!","female":"Just because you say that doesn't make it true!","variant_male_record_index":"126313","variant_female_record_index":"126314","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:2:3":{"text":"Not all Claws are evil.","source_cn":"他们是流沙之爪，但没有行恶","status":"matched_runtime_gender","hash_xxh64":"0x8B0ADC77A18FB1B7","variant_status":"runtime_gender_keys_target_same","male":"Not all Claws are evil.","female":"Not all Claws are evil.","variant_male_record_index":"64548","variant_female_record_index":"64549","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:奇克":{"text":"Chak","source":"奇克","status":"matched_dialogue_flow"},"speaker:卢玛":{"text":"Rumon","source":"卢玛","status":"matched_dialogue_flow"},"speaker:蛮血恩法":{"text":"Enfa","source":"蛮血恩法","status":"matched_dialogue_flow"},"speaker:蛮血阿蒂拉":{"text":"Atillia","source":"蛮血阿蒂拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":27,"localized_text_count":26,"speaker_count":4}}