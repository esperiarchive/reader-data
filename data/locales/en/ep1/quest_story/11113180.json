{"asset_key":"ep1/quest_story_11113180","episode":"ep1","category":"quest_story","story_id":"11113180","schema_version":1,"lang":"en","texts":{"say:2:1111318001:0":{"text":"That flute is dangerous! Get rid of it!","source_cn":"扔掉那个笛子！很危险！","status":"matched","hash_xxh64":"0x10E48717A6F0A541","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1111318002:0":{"text":"No way! I love this flute! I won't be able to talk to my parents without it!","source_cn":"不能扔！这是我的宝物！没了它，我再也不能和爸爸妈妈说话了！","status":"matched","hash_xxh64":"0x135E4B3DB12C027B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111318003:1":{"text":"It's just a flute! How could you talk to them with an instrument?!","source_cn":"那是个笛子，你要怎么用它和去世的人说话呀！","status":"matched","hash_xxh64":"0x8155DD8E95F45056","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111318004:0":{"text":"All I have to do is play this flute, and I can hear their voices again!","source_cn":"怎么不能！只要用它吹响旋律，就能听见爸爸妈妈的声音！","status":"matched","hash_xxh64":"0x5FCAD6A62D67FEA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111318005:0":{"text":"I knew you were a bad person! First, you took Antandra away from me, and now you're trying to take my flute!","source_cn":"你果然很坏！你抢我的安丹姐姐，还要抢我的笛子！","status":"matched","hash_xxh64":"0x70FD4E8277893B7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111318006:0":{"text":"Why are you being so stubborn?! I'm trying to help you!","source_cn":"你这小孩讲不讲理？我是为你好！","status":"matched","hash_xxh64":"0x51C6387B8E5612AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111318007:0":{"text":"Calm down, Satrana. Now that the Hypofiend is gone, I sense that it's become an ordinary flute again.","source_cn":"萨忒娜，冷静。那个藏在笛子中的魔物被消灭后，这笛子已经...","status":"matched","hash_xxh64":"0xFF9F71BBB976B034","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111318008:0":{"text":"Did your parents leave you this flute, Koko?","source_cn":"卡卡，这笛子是你父母留给你的遗物吗？","status":"matched","hash_xxh64":"0xF6B1E892AFDEC77A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111318009:0":{"text":"No... I found it myself.","source_cn":"不……是我捡的。","status":"matched","hash_xxh64":"0xB9CE9721EFADD7D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1111318010:0":{"text":"Where?","source_cn":"在哪捡的？","status":"matched","hash_xxh64":"0x40FA8F075BE0FED3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1111318011:0":{"text":"Far away from here, deep in the Crimson Highlands.","source_cn":"在深红高原深处，离这里很远。","status":"matched","hash_xxh64":"0xCFEF9B86826BD879","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1111318012:0":{"text":"I found it while I was playing out there one day. The Dusk Lord left it for me.","source_cn":"前阵子我跑去那边玩，捡到了这个，这一定是残阳神送给我的。","status":"matched","hash_xxh64":"0xD694CC6BA919A65A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1111318013:0":{"text":"It was left near where the Dusk Lord sleeps. He must've known that I missed my parents and gave me this flute.","source_cn":"因为，那边距离残阳神睡觉的地方不远。残阳神知道，我想爸...","status":"matched","hash_xxh64":"0x488F13F857155BF4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1111318014:0":{"text":"You were out there by yourself? That's pretty brave.","source_cn":"你一个人去那？胆子不小。","status":"matched","hash_xxh64":"0x3B86D346BE8FB61E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1111318015:0":{"text":"Koko must be talking about the Dusk Lord's final resting place.","source_cn":"卡卡说的，应该是残阳神的长眠之地。","status":"matched","hash_xxh64":"0xA3F811779F5C3744","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1111318016:0":{"text":"The sacred grounds where the Dusk Lord fell.","source_cn":"那是残阳神的陨落之处，是圣地。","status":"matched","hash_xxh64":"0x359E0E609B332A51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1111318017:0":{"text":"It's strange that Koko would find an evil flute in a place like that...","source_cn":"卡卡怎么会在那捡到这样邪恶的笛子？太蹊跷了……","status":"matched","hash_xxh64":"0x7525F00F8EEA4AB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1111318018:2":{"text":"Uh...","source_cn":"呃……","status":"matched","hash_xxh64":"0xC9731CDFA32A1DD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1111318019:0":{"text":"Are you okay, Satrana?","source_cn":"萨忒娜，你还好吗？","status":"matched","hash_xxh64":"0xA2387876E97EF648","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1111318020:2":{"text":"<sad>Crimson... darkness...</sad>","source_cn":"<sad>深……红……幽……暗……</sad>","status":"matched","hash_xxh64":"0xD98FD177EBBEC4DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1111318021:0":{"text":"Satrana's making a prophecy!","source_cn":"萨忒娜在预言！","status":"matched","hash_xxh64":"0x4BAC51D00892903A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1111318022:2":{"text":"In a crimson land most high... to the shadowy depths...","source_cn":"……于……至高深红之所……去……至暗幽深之处……","status":"matched","hash_xxh64":"0x09D3A653432FE142","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1111318023:0":{"text":"Darkness... surrounds the tomb...","source_cn":"黑暗……即将笼罩墓穴……","status":"matched","hash_xxh64":"0x6FE3B0F3FAD7029A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1111318024:0":{"text":"A figure stands... in the shadow...","source_cn":"而那身影……属于……","status":"matched","hash_xxh64":"0x0A93102BFE0A11AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1111318025:1":{"text":"Hypogean!","source_cn":"恶魔！","status":"matched","hash_xxh64":"0x95961EFA8BE2CE70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1111318026:0":{"text":"!","source_cn":"！","status":"matched","hash_xxh64":"0x4E87F6ABB60A7CEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1111318027:0":{"text":"Ugh... My head... Did I have one of my visions?","source_cn":"呜……头好晕……我刚刚……肯定又说了什么吧。","status":"matched","hash_xxh64":"0x55B938E1C71792D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1111318028:0":{"text":"Yes... It sounds like you were telling us that a Hypogean is hiding in a tomb somewhere in the Crimson Highlands.","source_cn":"嗯……我想，你的预言应该是指深红高原的墓穴中，藏着恶魔。","status":"matched","hash_xxh64":"0xC8DE7405D799C18A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1111318029:0":{"text":"Yes, it was much clearer than last time.","source_cn":"我赞同。比上次清晰很多。","status":"matched","hash_xxh64":"0xA7280282C51301E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1111318030:0":{"text":"A Hypogean? Did I really say that?","source_cn":"恶魔？不敢相信我竟然说出了这个词！","status":"matched","hash_xxh64":"0x20FF0C635AA49859","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1111318031:0":{"text":"Could it be... <style=\"highlight\">Berial</style>?","source_cn":"是你们提过的那个？<style=highlight>贝...","status":"matched","hash_xxh64":"0x5021A3BBBA09249E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1111318032:0":{"text":"We'd be in trouble if another Hypogean appeared. No, it must be Berial.","source_cn":"要是再冒出来一个新的恶魔可麻烦了，一定是贝利尔。","status":"matched","hash_xxh64":"0xABA64B77F1C4E1E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1111318033:0":{"text":"Berial... It looks like we know exactly who we're fighting.","source_cn":"贝利尔吗……看来，我们的敌人已经明确了。","status":"matched","hash_xxh64":"0x8E3B896F2427DF1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1111318034:0":{"text":"Be it a monster or Hypogean, no one is a match for us. Come on, our next stop is the Dusk Lord's resting place.","source_cn":"走吧，去残阳神的长眠之地。不管是怪物还是恶魔，都放马过来吧！","status":"matched","hash_xxh64":"0x9316050817D74955","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:萨忒娜":{"text":"Satrana","source":"萨忒娜","status":"matched_dialogue_flow"},"speaker:卡卡":{"text":"Koko","source":"卡卡","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:安丹德拉":{"text":"Antandra","source":"安丹德拉","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":35,"localized_text_count":34,"speaker_count":6}}