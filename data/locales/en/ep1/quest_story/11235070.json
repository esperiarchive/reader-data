{"asset_key":"ep1/quest_story_11235070","episode":"ep1","category":"quest_story","story_id":"11235070","schema_version":1,"lang":"en","texts":{"say:3:1123507001:1":{"text":"What are you all doing here?","source_cn":"你们怎么会来这里？","status":"matched","hash_xxh64":"0x5226A9E1E63A63F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123507002:1":{"text":"Uh... I'm just... passing through.","source_cn":"哼，我只是……嗯，路过！","status":"matched","hash_xxh64":"0x0C885B94B78D3752","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1123507003:1":{"text":"Actually, we're here to help you, Elder.","source_cn":"其实，我们是来帮助老师的。","status":"matched","hash_xxh64":"0xBD9495B346E4DF41","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123507004:1":{"text":"Don't call me \"elder\". I'm not part of the clan anymore.","source_cn":"什么老师，你在胡言乱语什么。","status":"matched","hash_xxh64":"0x801428C060A7EA13","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123507005:1":{"text":"When we were talking back at the camp, we realized that both of us were once your students.","source_cn":"我们在营地里聊天的时候，发现对方都受到过老师的教导。","status":"matched","hash_xxh64":"0x3CC0E16362D95712","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123507006:1":{"text":"We decided to come check on you after learning about your situation. Turns out we came at the perfect time.","source_cn":"得知老师的情况后，决定过来看看，没想到来得刚刚好。","status":"matched","hash_xxh64":"0x26B84D84C9A0EAEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123507007:1":{"text":"Still... we only managed to calm that ironjaw down thanks to your instructions.","source_cn":"不过……面对那只钢颚兽，也多亏了老……你的智慧，我们才...","status":"matched","hash_xxh64":"0x99852B93F091B7A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1123507008:1":{"text":"We sincerely hope that you'll consider returning to the clan, Elder. Your knowledge should be passed on to the next batch of young warriors.","source_cn":"我们两个由衷的希望你能考虑回到氏族，老师。你的知识应该...","status":"matched","hash_xxh64":"0x54CC1696982E7FCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1123507009:1":{"text":"Hold on! Listen... Something's coming...","source_cn":"等一下，竖起你们的耳朵，有什么在过来了。","status":"matched","hash_xxh64":"0xB07A86A269902032","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1123507010:1":{"text":"That sound...","source_cn":"这个声音是……！","status":"matched","hash_xxh64":"0x3F09B769EB2F9D7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈什尔":{"text":"Hashir","source":"哈什尔","status":"matched_dialogue_flow"},"speaker:黑嚎熊人乌泰":{"text":"Utai","source":"黑嚎熊人乌泰","status":"matched_dialogue_flow"},"speaker:驯兽师萨克":{"text":"Tamer Zac","source":"驯兽师萨克","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":3}}