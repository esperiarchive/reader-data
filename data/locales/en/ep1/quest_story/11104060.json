{"asset_key":"ep1/quest_story_11104060","episode":"ep1","category":"quest_story","story_id":"11104060","schema_version":1,"lang":"en","texts":{"say:1:1110406001:1":{"text":"Keep your guard up. This is their territory.","source_cn":"小心点。这里就是他们的老巢。","status":"matched","hash_xxh64":"0x9A0F55A5A18F8CDA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110406002:1":{"text":"Alsa, if things turn sour, stay behind me—","source_cn":"阿尔萨，如果他们发难，就躲进我身后——","status":"matched","hash_xxh64":"0x80B55ABB7B3ADC4A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1110406003:1":{"text":"Soren, welcome back! And Alsa! The tales of you two Mauler warriors have traveled far and wide across the desert!","source_cn":"索恩，欢迎回归！还有阿尔萨！两位蛮血勇士的英名已经传遍...","status":"matched","hash_xxh64":"0x71A5476B5E30D7A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1110406003":{"text":"Soren, welcome back! And Alsa! The tales of you two Mauler warriors have traveled far and wide across the desert!","source_cn":"索恩，欢迎回归！还有阿尔萨！两位蛮血勇士的英名已经传遍了沙漠！","status":"matched","hash_xxh64":"0x71A5476B5E30D7A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110406004:1":{"text":"What's happening? We didn't expect such a warm reception after being dragged here by force...","source_cn":"怎么回事？我们被押送过来，实在没想到还能享受这种待遇……","status":"matched","hash_xxh64":"0x6C3BA194A68D17B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1110406005:1":{"text":"What? Dragged here?","source_cn":"什么？押送？","status":"matched","hash_xxh64":"0x3E192DAD5B69DBEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1110406006:1":{"text":"Idiots! What did I tell you? I said to INVITE them!","source_cn":"——你们这两个笨蛋，完全搞错了！我说的是“请”！","status":"matched","hash_xxh64":"0x04418DDDAF4FF89D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1110406007:1":{"text":"How dare you lay a hand on two promising young warriors, especially Soren?","source_cn":"对这样两位年少有为的著名勇者——尤其是索恩，怎能如此粗暴？","status":"matched","hash_xxh64":"0xD91007F7AEA60EF5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1110406008:0":{"text":"I apologize, chief! It was a misunderstanding... I'm prepared to accept my punishment!","source_cn":"对不起，大哥，我们错了。我下去自己领罚！","status":"matched","hash_xxh64":"0xE60F96BE7B3BAB73","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1110406009:1":{"text":"Soren, please forgive us. The entire clan is thrilled about your return.","source_cn":"索恩，真抱歉！其实你回到家来，整个氏族都很高兴。","status":"matched","hash_xxh64":"0x88A72DE99D2EA489","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1110406010:1":{"text":"Return? What are you talking about?","source_cn":"回家？这是什么意思？","status":"matched","hash_xxh64":"0x2CE99084D3A5D6EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1110406011:1":{"text":"Um... Orson is waiting for you. He'll explain everything.","source_cn":"这……奥格老大要亲自见你，到时候你们可以细说。","status":"matched","hash_xxh64":"0x108771F49957BE0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"He sounds sincere.","source_cn":"突然好热情","status":"matched_runtime_gender","hash_xxh64":"0x00F118B2E21C3DE9","variant_status":"runtime_gender_keys_target_same","male":"He sounds sincere.","female":"He sounds sincere.","variant_male_record_index":"63208","variant_female_record_index":"63209","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"How unexpected...","source_cn":"好厉害的前倨后恭","status":"matched_runtime_gender","hash_xxh64":"0x6167F8B66B3F8E7B","variant_status":"runtime_gender_keys_target_same","male":"How unexpected...","female":"How unexpected...","variant_male_record_index":"63210","variant_female_record_index":"63211","document_title":"","document_title_male":"","document_title_female":"","document_titl