{"asset_key":"ep1/quest_story_11108120","episode":"ep1","category":"quest_story","story_id":"11108120","schema_version":1,"lang":"en","texts":{"say:2:1110812001:0":{"text":"It's a sizable camp with many caravans, but there aren't many people around...","source_cn":"营地很大，有运货马车，但人很少……","status":"matched","hash_xxh64":"0x5C78399C915905E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1110812001":{"text":"It's a sizable camp with many caravans, but there aren't many people around...","source_cn":"营地很大，有运货马车，但人很少……","status":"matched","hash_xxh64":"0x5C78399C915905E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1110812002:0":{"text":"But I don't see any Maulers from the Uru Clan around, there should be quite a few of them.","source_cn":"但是我没看乌尔氏族的小蛮血呀，按说应该人数不少才对。","status":"matched","hash_xxh64":"0x7F4B92626A19138B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1110812003:0":{"text":"Look! Over there!","source_cn":"咦，你们看，那边——","status":"matched","hash_xxh64":"0xF8889AB29A62C24F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1110812004:0":{"text":"Soren!!!","source_cn":"——索恩哥哥！","status":"matched","hash_xxh64":"0x86998CA13D2F6CB5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1110812005:0":{"text":"Simba?!","source_cn":"小瑟巴？！","status":"matched","hash_xxh64":"0x85C9AB56E2CCF6B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1110812006:0":{"text":"S-Soren!!! You finally came for us!!! *Sob*","source_cn":"索、索恩哥哥！你终于来找我们了！！！呜、呜呜呜！","status":"matched","hash_xxh64":"0xC02B00E13F9ACF29","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1110812007:0":{"text":"You... uh...","source_cn":"你，呃……","status":"matched","hash_xxh64":"0xD45CC95AFF75D5BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1110812008:0":{"text":"Don't cry...","source_cn":"……别哭。","status":"matched","hash_xxh64":"0xCD09891A98359A6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1110812008":{"text":"Don't cry...","source_cn":"……别哭。","status":"matched","hash_xxh64":"0xCD09891A98359A6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1110812009:0":{"text":"I'm not as good at comforting people as Alsa...","source_cn":"……我不是阿尔萨，不擅长这些。","status":"matched","hash_xxh64":"0x1BEF02F57C8058B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1110812010:1":{"text":"Simba, you...","source_cn":"小瑟巴，你……","status":"matched","hash_xxh64":"0x4D2978976690F74A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1110812011:1":{"text":"It's ok, Soren... I... I will stay strong...","source_cn":"没关系，索恩哥哥，瑟巴不哭……瑟巴会坚强……","status":"matched","hash_xxh64":"0x6C2EFDE672B918F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1110812012:1":{"text":"Are you here to save everyone? If you beat up all the bad guys, then the people who disappeared will come back, right?","source_cn":"你是来救大家的吗？你去把坏人全打倒，被抓走的人是不是就...","status":"matched","hash_xxh64":"0x8EC842FA76758A57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:18:1110812012":{"text":"Are you here to save everyone? If you beat up all the bad guys, then the people who disappeared will come back, right?","source_cn":"你是来救大家的吗？你去把坏人全打倒，被抓走的人是不是就能回来了！","status":"matched","hash_xxh64":"0x8EC842FA76758A57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1110812013:0":{"text":"Umm... I heard it from those people who sell things, they called them... Quickhand Paws?","source_cn":"嗯……我是听卖东西的那些叔叔姐姐们说的，好像是叫……流...","status":"matched","hash_xxh64":"0xFB83101EB6491E72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1110812013":{"text":"Umm... I heard it from those people who sell things, they called them... Quickhand Paws?","source_cn":"嗯……我是听卖东西的那些叔叔姐姐们说的，好像是叫……流沙之牙！","status":"matched","hash_xxh64":"0xFB83101EB6491E72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1110812014:0":{"text":"Oh, yes! The Quicksand Claws! They rode these really big birds as tall as three grown-ups! They just showed up on the road! It was so scary, I hid under the carriage and didn't dare to move...","source_cn":"啊，对！是流沙之爪！他们骑着三个人那么高的大鸟，突然出...","status":"matched","hash_xxh64":"0x363DB0E1E8E54F17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1110812015:1":{"text":"When I finally peeked out, Kaleb, Jerry, and Carley were all gone! The merchants said the Quickhand Paws took them...","source_cn":"等出来一看，库布、扎拉和卡阿他们，都不见了！卖东西的那...","status":"matched","hash_xxh64":"0x12DF7B5EC07242D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1110812016:1":{"text":"It's the Quicksand Claws again.","source_cn":"流沙之爪。又是他们。","status":"matched","hash_xxh64":"0x2F05D76C028CB3E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1110812017:1":{"text":"Those merchants probably witnessed everything. Let's go and ask them for details.","source_cn":"那些商人目击了劫人的过程……问问他们。","status":"matched","hash_xxh64":"0x2CAE603026DEEE3F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:0:1":{"text":"It's the Quicksand Claws.","source_cn":"是流沙之爪","status":"matched_runtime_gender","hash_xxh64":"0x50926BFAF709338D","variant_status":"runtime_gender_keys_target_same","male":"It's the Quicksand Claws.","female":"It's the Quicksand Claws.","variant_male_record_index":"64104","variant_female_record_index":"64105","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:0:1":{"text":"Who are the bad guys?","source_cn":"坏人？","status":"matched_runtime_gender","hash_xxh64":"0xFE713E7E3FC28008","variant_status":"runtime_gender_keys_target_same","male":"Who are the bad guys?","female":"Who are the bad guys?","variant_male_record_index":"64100","variant_female_record_index":"64101","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:1:2":{"text":"People here were taken too?","source_cn":"这里也有人被抓走了？","status":"matched_runtime_gender","hash_xxh64":"0x85EB7219CCD7B326","variant_status":"runtime_gender_keys_target_same","male":"People here were taken too?","female":"People here were taken too?","variant_male_record_index":"64102","variant_femal