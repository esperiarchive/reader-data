{"asset_key":"ep1/quest_story_11109260","episode":"ep1","category":"quest_story","story_id":"11109260","schema_version":1,"lang":"en","texts":{"say:2:1110926001:0":{"text":"...Let go.","source_cn":"……放手。","status":"matched","hash_xxh64":"0xF1F7393E9FADB1F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110926002:1":{"text":"Hey, we grabbed it at the same time. Why should I let go?","source_cn":"话不能这么说，小兄弟。项链是咱俩同时抢到的，分不出先来后到。","status":"matched","hash_xxh64":"0x44F5570AEDBE158E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1110926003:1":{"text":"I was faster than you.","source_cn":"我不可能比你慢。","status":"matched","hash_xxh64":"0x262DCC5A3F8A7E79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1110926004:1":{"text":"Ha! You've got a temper.","source_cn":"嗬，真有脾气。","status":"matched","hash_xxh64":"0xB10881ACA8639781","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1110926005:1":{"text":"Odie would have gotten away if it not for me. You couldn't have stopped him, even if you had 20 hamsters.","source_cn":"要不是我拦住阿德那小子，他早就跑了。就算你们再有二十只...","status":"matched","hash_xxh64":"0x5475698F98FD9831","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110926006:1":{"text":"That many hamsters would just slow me down.","source_cn":"那么多人只会拖累我。","status":"matched","hash_xxh64":"0x073D7DFC67B8855F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1110926007:1":{"text":"...Ha! Young man, I like you!","source_cn":"……哈，哈哈哈。小兄弟，你可真有意思！","status":"matched","hash_xxh64":"0xB74DACF3050B8D28","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1110926008:1":{"text":"But unfortunately, I'm not letting go of this necklace.","source_cn":"但只有这件事，我不能放手。","status":"matched","hash_xxh64":"0xB79D530F9F883CE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1110926008":{"text":"But unfortunately, I'm not letting go of this necklace.","source_cn":"但只有这件事，我不能放手。","status":"matched","hash_xxh64":"0xB79D530F9F883CE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1110926011:0":{"text":"...Fine. Let's leave it to Satrana.","source_cn":"……行吧。交给萨忒娜。","status":"matched","hash_xxh64":"0xE428742C2B54A082","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1110926012:0":{"text":"I'm sure fate will help her make the right decision.","source_cn":"我相信“命运”会让她做出正确决定。","status":"matched","hash_xxh64":"0xA313139CACEBA849","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1110926013:0":{"text":"Hey! Has anyone confirmed if I'm okay with this?","source_cn":"喂，我还没说同意呢。","status":"matched","hash_xxh64":"0x0AC3EC0B398E6F39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1110926014:0":{"text":"You'd rather fight?","source_cn":"你真想打一架？","status":"matched","hash_xxh64":"0x633931721C90C938","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1110926015:0":{"text":"However fast you are, you can't dodge a bullet.","source_cn":"哈哈哈，不管你身手多矫健，也比不过枪。","status":"matched","hash_xxh64":"0xC8187AED1C6B517B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1110926016:0":{"text":"Forget it. That fox girl is quite special. She has more faith in fate than in anything else.","source_cn":"算了，那狐狸女孩的思维不同常人，比起个人，她更相信运势。","status":"matched","hash_xxh64":"0xE13F590DD873F242","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1110926017:0":{"text":"I'm still alive after all those adventures and bounty hunts. Fate is probably on my side.","source_cn":"比起能在无数悬赏和冒险中活下来的我，你们未必有胜算。","status":"matched","hash_xxh64":"0xF8637FEAC115A631","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"We should let Satrana decide.","source_cn":"要不还是让萨忒娜做决定吧","status":"matched_runtime_gender","hash_xxh64":"0xE5BAED88D29D0A90","variant_status":"runtime_gender_keys_target_same","male":"We should let Satrana decide.","female":"We should let Satrana decide.","variant_male_record_index":"63564","variant_female_record_index":"63565","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"Arguing won't solve this.","source_cn":"这么争下去不是办法","status":"matched_runtime_gender","hash_xxh64":"0x5EB394C54504AFDC","variant_status":"runtime_gender_keys_target_same","male":"Arguing won't solve this.","female":"Arguing won't solve this.","variant_male_record_index":"63566","variant_female_record_index":"63567","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1110926009:0":{"text":"Works for me.","source_cn":"我同意。","status":"matched","hash_xxh64":"0x0BFAD65DF2C5A9CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1110926010:0":{"text":"Soren, calm down! Let's leave this to Satrana. She's our friend after all.","source_cn":"索恩，你冷静一些！让萨忒娜做评判吧，毕竟她是咱们的熟人呢。","status":"matched","hash_xxh64":"0x44778E3304819BE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:2:3":{"text":"How about you two duke it out?","source_cn":"要不你们干脆打一架？","status":"matched_runtime_gender","hash_xxh64":"0xF93E5014AA900A15","variant_status":"runtime_gender_keys_target_differs","male":"How about you two duke it out?","female":"How about you two fight it out?","variant_male_record_index":"63568","variant_female_record_index":"63569","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"},"speaker:瓦尔克":{"text":"Walker","source":"瓦尔克","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":22,"localized_text_count":21,"speaker_count":3}}