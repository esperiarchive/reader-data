{"asset_key":"ep1/quest_story_11113120","episode":"ep1","category":"quest_story","story_id":"11113120","schema_version":1,"lang":"en","texts":{"say:1:1111312001:0":{"text":"Where are we? Antandra told me I passed out...","source_cn":"这是哪里？这么热闹……安丹说我晕过去了。","status":"matched_runtime_gender","hash_xxh64":"0x6656BA21599D28CF","variant_status":"runtime_gender_keys_target_same","male":"Where are we? Antandra told me I passed out...","female":"Where are we? Antandra told me I passed out...","variant_male_record_index":"123972","variant_female_record_index":"123973","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1111312001":{"text":"Where are we? Antandra told me I passed out...","source_cn":"这是哪里？这么热闹……安丹说我晕过去了。","status":"matched_runtime_gender","hash_xxh64":"0x6656BA21599D28CF","variant_status":"runtime_gender_keys_target_same","male":"Where are we? Antandra told me I passed out...","female":"Where are we? Antandra told me I passed out...","variant_male_record_index":"123972","variant_female_record_index":"123973","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1111312002:0":{"text":"Much better, thanks for asking.","source_cn":"好多了，谢谢你关心我。","status":"matched_runtime_gender","hash_xxh64":"0x7C94D964C39FAC3B","variant_status":"runtime_gender_keys_target_same","male":"Much better, thanks for asking.","female":"Much better, thanks for asking.","variant_male_record_index":"123974","variant_female_record_index":"123975","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111312004:0":{"text":"The feast is about to begin! Come on, let's go!","source_cn":"宴会要开始了！正好，一起！","status":"matched","hash_xxh64":"0xF2D9C84291F58ED8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111312005:1":{"text":"You better not steal my meat, though!","source_cn":"但是，你不能和我抢肉吃！","status":"matched","hash_xxh64":"0xB117691FFA1EFAB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111312006:1":{"text":"Like I would do something like that! By the way, what exactly is going on here?","source_cn":"我才没那么无聊！再说……怎么莫名其妙来了一场宴会啊？","status":"matched","hash_xxh64":"0xF9412DF6229FDDF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1111312007:1":{"text":"Don't you like feasts? Antandra and I love feasts!","source_cn":"你不喜欢宴会？但是安丹姐姐喜欢宴会，我也喜欢！","status":"matched","hash_xxh64":"0x0CC75571E6E1DD39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111312008:1":{"text":"Let me play you a song on my flute, Antandra! It's a good one!","source_cn":"安丹姐姐，我给你吹笛子听！我会一首热闹的曲子！","status":"matched","hash_xxh64":"0x9251D4B3C7BD880E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111312009:1":{"text":"My parents taught it to me before they passed away...","source_cn":"这首曲子，是爸爸妈妈去世前教我的！","status":"matched","hash_xxh64":"0x3E26ADC650731A22","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1111312010:1":{"text":"Oh...","source_cn":"去世前……","status":"matched","hash_xxh64":"0xD8AE90665333BAEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111312011:1":{"text":"You lost your parents too...","source_cn":"原来你的父母也去世了啊……","status":"matched","hash_xxh64":"0x955BEF7C79D32D7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111312012:1":{"text":"Yeah, but I know we'll see each other again someday. They're definitely waiting for me on the other side.","source_cn":"嗯，他们去那边等我了。我知道，总有一天会和他们再见。","status":"matched","hash_xxh64":"0xBE49C64C949473A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1111312013:0":{"text":"Besides, I still have my clansmen and Antandra, so I'm never alone.","source_cn":"而且，卡卡还有族人，还有安丹姐姐！所以，不寂寞！","status":"matched","hash_xxh64":"0x6C79F7AEFFBEFCE8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1111312014:0":{"text":"That's right. The desert provides...","source_cn":"这么想没错。","status":"matched","hash_xxh64":"0xAF82A6FAEF945809","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1111312015:0":{"text":"Yes! Now, sit back and enjoy my song!","source_cn":"嗯！那么卡卡要吹笛子啦！","status":"matched","hash_xxh64":"0x0391475FE80BE800","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1111312016:0":{"text":"Oh, a dinner and a show. Now, this is a real feast! C'mon everyone, a round of applause!","source_cn":"哦？有人要开始表演才艺啦。来来来！大家都给点掌声！","status":"matched","hash_xxh64":"0x34D93D236C3B5989","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"Feeling better?","source_cn":"你好点了吗？","status":"matched_runtime_gender","hash_xxh64":"0xDE36E89C8C76A17D","variant_status":"runtime_gender_keys_target_same","male":"Feeling better?","female":"Feeling better?","variant_male_record_index":"63962","variant_female_record_index":"63963","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1111312003:0":{"text":"I'm fine, but I can't remember why I passed out.","source_cn":"我没事，我都不记得自己是怎么晕倒的了。","status":"matched_runtime_gender","hash_xxh64":"0x517FDC5A59E306AA","variant_status":"runtime_gender_keys_target_same","male":"I'm fine, but I can't remember why I passed out.","female":"I'm fine, but I can't remember why I passed out.","variant_male_record_index":"123976","variant_female_record_index":"123977","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:1:2":{"text":"I'm glad you're alright.","source_cn":"你没事就好","status":"mat