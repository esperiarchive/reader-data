{"asset_key":"ep1/quest_story_11115240","episode":"ep1","category":"quest_story","story_id":"11115240","schema_version":1,"lang":"en","texts":{"say:1:1111524001:0":{"text":"Why have only a few of you returned? Did you find the treasure?","source_cn":"为什么只有你们几个回来了？你们找到宝藏了？","status":"matched","hash_xxh64":"0xD46C851DD5485E2B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111524002:0":{"text":"Papa? He's not here... Excuse me, have you seen my papa?","source_cn":"阿爸呢……没有阿爸。请问，你们有没有见过我的阿爸？","status":"matched","hash_xxh64":"0x15339F13AFD3FE20","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111524003:0":{"text":"His name is Ames! He loves telling stories and keeping a journal.","source_cn":"他叫阿米！他很喜欢讲故事，也很喜欢写日记。","status":"matched","hash_xxh64":"0x1B5DCC2EF22F256C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111524004:0":{"text":"He said he would write down all the amazing things that happened during the treasure hunt and tell me when he got back.","source_cn":"他说他会把寻宝途中各种有趣的事情都记下来，回来后讲给我听……","status":"matched","hash_xxh64":"0x1C1E390C1F9D1A5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111524005:0":{"text":"Has anyone seen him? Anyone? Please... he's my papa...","source_cn":"有谁见过吗？有谁……见过他吗？他是我的阿爸……","status":"matched","hash_xxh64":"0x1829874E04E44862","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111524006:0":{"text":"Ames... isn't this person already...","source_cn":"阿米……这个人不是已经——","status":"matched","hash_xxh64":"0x414CB7A07569A85D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1111524007:0":{"text":"We haven't met your father, but we found some journals along the way that may belong to him. Take a look...","source_cn":"小姑娘……我们没有见过你阿爸，但我们在途中捡到了一些日...","status":"matched","hash_xxh64":"0x09A547DAB6184A33","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111524008:0":{"text":"This is Papa's handwriting!","source_cn":"没、没错！这是阿爸的字！","status":"matched","hash_xxh64":"0x97E99EDC57647639","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111524009:0":{"text":"Is he... okay?","source_cn":"阿爸他……还好吗？","status":"matched","hash_xxh64":"0x9E1C30635EA0BCCB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1111524009":{"text":"Is he... okay?","source_cn":"阿爸他……还好吗？","status":"matched","hash_xxh64":"0x9E1C30635EA0BCCB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1111524010:0":{"text":"I knew it... every time I have a bad feeling, I'm never wrong!","source_cn":"我就知道……每次遇到坏事，我的预感总是很灵！","status":"matched_runtime_gender","hash_xxh64":"0xC304AD501D386F16","variant_status":"runtime_gender_keys_target_same","male":"I knew it... every time I have a bad feeling, I'm never wrong!","female":"I knew it... every time I have a bad feeling, I'm never wrong!","variant_male_record_index":"124988","variant_female_record_index":"124989","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1111524011:0":{"text":"When Papa was leaving, I begged him not to go! Why didn't he listen to me? Why?","source_cn":"阿爸走的时候我就让他不要去，可他不信！为什么呢……为什...","status":"matched_runtime_gender","hash_xxh64":"0x4DADB3FE5EB4929A","variant_status":"runtime_gender_keys_target_same","male":"When Papa was leaving, I begged him not to go! Why didn't he listen to me? Why?","female":"When Papa was leaving, I begged him not to go! Why didn't he listen to me? Why?","variant_male_record_index":"124990","variant_female_record_index":"124991","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1111524014:0":{"text":"I have to tell everyone the truth.","source_cn":"我得把真相告诉所有人。","status":"matched","hash_xxh64":"0x1B662ECFF5022B82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1111524015:0":{"text":"Otherwise, those souls will not rest in the Crimson Highlands, with none aware of the evil deeds of the Hypogean and the Adamant Syndicate.","source_cn":"否则那些生命只能白白沉眠于深红高地，没人知道恶魔与黑金...","status":"matched","hash_xxh64":"0xB0F690F5361581F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1111524016:0":{"text":"As Phraesto said, others must know of his crimes; we must empower the world to judge him.","source_cn":"正如普鲁斯托所言，必须有人知道他的罪行，我们要让世人获...","status":"matched","hash_xxh64":"0x7DC9CED8998F727B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1111524017:0":{"text":"I will assist Satrana and try to find the rightful owners of the recovered relics.","source_cn":"我会帮助萨忒娜，试着为带回的遗物寻找失主。","status":"matched","hash_xxh64":"0x966B845C28293134","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1111524018:0":{"text":"Upon seeing the relics, the families should know we speak the truth.","source_cn":"看到那些遗物，家属应该会知道我们所言非虚。","status":"matched","hash_xxh64":"0x2CA77DC35CD33D53","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1111524019:0":{"text":"I'm going to help too! It can't just be Satrana and Antandra doing all the work!","source_cn":"我也要帮忙。不能只让萨忒娜姐姐和安丹姐姐出力！","status":"matched","hash_xxh64":"0x98A5F8491645639F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1111524020:0":{"text":"I'll stay awhile, too.","source_cn":"我也暂时留下来好了。","status":"matched","hash_xxh64":"0xF89A3A297F56AE27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1111524021:0":{"text":"Thank you for the kind gesture, but you'd better return to your clan.","source_cn":"谢谢你的好意，但你还是赶紧回到族人身边吧。","status":"matched","hash_xxh64":"0xECDEA7946D4EB40F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1111524022:0":{"text":"Soren, look at the worried faces of those around you.","source_cn":"索恩，你看周围这些人脸上担忧的面容。","status":"matched","hash_xxh64":"0x1BD928439976C3A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1111524023:0":{"text":"At this moment, your loved ones probably look the exact same way. Go home and put their worries to rest.","source_cn":"此时此刻，你的亲人们可能也是同样的表情。快回去吧，别让...","status":"matched","hash_xxh64":"0x035B07BA6A454C28","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1111524024:0":{"text":"And <style=\"stress\"><player_name></style>, it's been a pleasure to have you with us. Without you, I might never have found Antandra.","source_cn":"还有<style=stress><player_nam...","status":"matched_runtime_gender","hash_xxh64":"0xE5DDFB61B55383E3","variant_status":"runtime_gender_keys_target_same","male":"And <style=\"stress\"><player_name></style>, it's been a pleasure to have you with us. Without you, I might never have found Antandra.","female":"And <style=\"stress\"><player_name></style>, it's been a pleasure to have you with us. Without you, I might never have found Antandra.","variant_male_record_index":"125006","variant_female_record_index":"125007","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1111524025:0":{"text":"Please accept my deepest thanks.","source_cn":"请让我郑重地说一声谢谢。","status":"matched_runtime_gender","hash_xxh64":"0x8720A8EBF3BFDE75","variant_status":"runtime_gender_keys_target_same","male":"Please accept my deepest thanks.","female":"Please accept my deepest thanks.","variant_male_record_index":"125008","variant_female_record_index":"125009","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1111524026:0":{"text":"It's time to say goodbye again...","source_cn":"又到了分别的时候呢……","status":"matched","hash_xxh64":"0xBDFAC7C5E394D23F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1111524027:0":{"text":"Do not be sad about our parting.","source_cn":"不必为分别而悲伤。","status":"matched","hash_xxh64":"0x1A7D7BF144877E7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1111524028:0":{"text":"Your destinies, though ripe with challenges, shine brighter than the stars.","source_cn":"诸位的命运虽然注定坎坷，但一定闪耀着比星辰更璀璨的光芒。","status":"matched","hash_xxh64":"0x782756FB092FBE3F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1111524029:0":{"text":"Someday, somewhere, we will meet again!","source_cn":"有朝一日，我们一定会在世界的某处再次重逢！","status":"matched","hash_xxh64":"0x4A1D59A1B647768A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"(Tell her the truth)","source_cn":"（告诉女孩真相）","status":"matched_runtime_gender","hash_xxh64":"0x153F190F8295716C","variant_status":"runtime_gender_keys_target_same","male":"(Tell her the truth)","female":"(Tell her the truth)","variant_male_record_index":"64210","variant_female_record_index":"64211","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1111524012:0":{"text":"Is this true?","source_cn":"这是真的吗……？","status":"matched_runtime_gender","hash_xxh64":"0xB0876D93AD074E07","variant_status":"runtime_gender_keys_target_same","male":"Is this true?","female":"Is this true?","variant_male_record_index":"124992","variant_female_record_index":"124993","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1111524013:0":{"text":"If you're telling the truth... why do you look so sad, like you're lying? *Sob*","source_cn":"如果是真的……你的眼神……为什么像是在撒谎？呜呜呜——","status":"matched_runtime_gender","hash_xxh64":"0x56F0110F2E85A76A","variant_status":"runtime_gender_keys_target_same","male":"If you're telling the truth... why do you look so sad, like you're lying? *Sob*","female":"If you're telling the truth... why do you look so sad, like you're lying? *Sob*","variant_male_record_index":"124994","variant_female_record_index":"124995","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:1:2":{"text":"(Lie to her)","source_cn":"（对女孩撒谎）","status":"matched_runtime_gender","hash_xxh64":"0x7EB66FB3E30EF70A","variant_status":"runtime_gender_keys_target_same","male":"(Lie to her)","female":"(Lie to her)","variant_male_record_index":"64212","variant_female_record_index":"64213","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:看热闹的女人":{"text":"Onlooker","source":"看热闹的女人","status":"matched_dialogue_flow"},"speaker:面色慌张的女孩":{"text":"Anxious Girl","source":"面色慌张的女孩","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:萨忒娜":{"text":"Satrana","source":"萨忒娜","status":"matched_dialogue_flow"},"speaker:安丹德拉":{"text":"Antandra","source":"安丹德拉","status":"matched_dialogue_flow"},"speaker:卡卡":{"text":"Koko","source":"卡卡","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":33,"localized_text_count":32,"speaker_count":7}}