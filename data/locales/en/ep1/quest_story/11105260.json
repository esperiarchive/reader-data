{"asset_key":"ep1/quest_story_11105260","episode":"ep1","category":"quest_story","story_id":"11105260","schema_version":1,"lang":"en","texts":{"say:1:1110526001:1":{"text":"Hey there! Lookin' for some herbs?","source_cn":"客人们，有什么药材需求吗？","status":"matched","hash_xxh64":"0x42F96783644E36F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110526002:1":{"text":"Smokey told us that you have luminous sandweed in stock.","source_cn":"阿熏让我们来的，说你有曜砂草。","status":"matched","hash_xxh64":"0x08F2984853AD09F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1110526003:1":{"text":"Huh? He's asking for that herb again?","source_cn":"咦？他又想要这种草药？","status":"matched","hash_xxh64":"0xB640FD5711C25175","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1110526004:1":{"text":"No way! This is the last of my stock. I won't part with it until a new shipment comes in!","source_cn":"绝对不行！这是我压箱底的库存，在有新货进来之前，绝不会脱手！","status":"matched","hash_xxh64":"0x6499D5A0408DBDC5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1110526005:1":{"text":"Please sell it to us! Someone's life is at stake!","source_cn":"请务必让给我们，现在人命关天。","status":"matched","hash_xxh64":"0xD892EB5652169FC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110526006:1":{"text":"So what? People die every day in the Ashen Wastes. If you want the herb, you better give me a better reason!","source_cn":"所以呢？荒角沙漠每天都在出人命。想要草药，你得给我更好...","status":"matched","hash_xxh64":"0x61BEE18ED294F05A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1110526007:1":{"text":"<style=\"stress\"><player_name></style>, what should we do now?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x7B0178422F59F565","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, what should we do now?","female":"<style=\"stress\"><player_name></style>, what should we do now?","variant_male_record_index":"120408","variant_female_record_index":"120409","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1110526007":{"text":"<style=\"stress\"><player_name></style>, what should we do now?","source_cn":"<style=stress><player_name></style>，现在怎么办？","status":"matched_runtime_gender","hash_xxh64":"0x7B0178422F59F565","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, what should we do now?","female":"<style=\"stress\"><player_name></style>, what should we do now?","variant_male_record_index":"120408","variant_female_record_index":"120409","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1110526008:1":{"text":"My dear sister Alsa has been poisoned. She won't live another day without an antidote made with the herb.","source_cn":"……我的妹妹阿尔萨中毒了，她急需曜砂草救命。","status":"matched","hash_xxh64":"0x29E4391C8CAA9E63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1110526009:1":{"text":"I'm begging you, I just need a bit...","source_cn":"求求你，卖给我吧……","status":"matched","hash_xxh64":"0x30DB10A14F356C89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1110526012:1":{"text":"If that's the case... Take this. May the gods bless her with a speedy recovery.","source_cn":"既然这样……这些曜砂草，你拿走吧。残阳神保佑，祝她早日康复。","status":"matched","hash_xxh64":"0xFF4F0E9E4F9D431C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"Appeal to his emotions.","source_cn":"动之以情","status":"matched_runtime_gender","hash_xxh64":"0x6C1FFD0B0398E957","variant_status":"runtime_gender_keys_target_same","male":"Appeal to his emotions.","female":"Appeal to his emotions.","variant_male_record_index":"63130","variant_female_record_index":"63131","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1110526010:1":{"text":"I am Soren from the Uru Clan, a participant in the Warsong Festival.","source_cn":"我是乌尔氏族的索恩，本次战歌节的参赛者。我保证——","status":"matched","hash_xxh64":"0xEFD7D285F84C568A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:11105260