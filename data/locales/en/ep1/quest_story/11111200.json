{"asset_key":"ep1/quest_story_11111200","episode":"ep1","category":"quest_story","story_id":"11111200","schema_version":1,"lang":"en","texts":{"say:3:1111120001:1":{"text":"... Ferranc.","source_cn":"弗兰克，我来了。","status":"matched","hash_xxh64":"0xFB6919B4E4C452D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111120002:1":{"text":"Get lost! No one interrupts me from sharpening my claws with the bones of my prey!","source_cn":"滚开，用猎物骨头磨爪子的享乐时间，谁都不许打扰我！","status":"matched","hash_xxh64":"0xBEEFC6F3C5F1CECF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111120003:1":{"text":"Lift that chin and meet your maker with some dignity, you varmint.","source_cn":"抬起头，堂堂正正地面对你的命运，恶棍！","status":"matched","hash_xxh64":"0x93AF8D86F4D53786","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111120004:1":{"text":"Ah! Walker, my old friend!","source_cn":"啊，瓦尔克，我的老朋友！","status":"matched","hash_xxh64":"0x6FB3F47C3296357B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111120005:1":{"text":"What's got you feeling all blue? Me taking care of your partner?","source_cn":"为什么拿枪指着我？就因为我料理了你的搭档？","status":"matched","hash_xxh64":"0x37E2BC6538CF58C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1111120006:1":{"text":"That miserable, wretched <style=\"highlight\">traitor</style>! I should have snuffed him out long ago!","source_cn":"那个可憎的、羸弱的<style=highlight>叛...","status":"matched","hash_xxh64":"0x3F6CE5454E2981B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1111120006":{"text":"That miserable, wretched <style=\"highlight\">traitor</style>! I should have snuffed him out long ago!","source_cn":"那个可憎的、羸弱的<style=highlight>叛徒</style>，我早就应该下令处决他！","status":"matched","hash_xxh64":"0x3F6CE5454E2981B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111120007:1":{"text":"Ha! You've come to join this guy in death and he hasn't even told you the truth!","source_cn":"哈哈哈，你们来陪他送命，这家伙竟然还没告诉你们过去的真相？","status":"matched_runtime_gender","hash_xxh64":"0xA81A9EDF21356EC3","variant_status":"runtime_gender_keys_target_same","male":"Ha! You've come to join this guy in death and he hasn't even told you the truth!","female":"Ha! You've come to join this guy in death and he hasn't even told you the truth!","variant_male_record_index":"121843","variant_female_record_index":"121844","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1111120008:1":{"text":"Heh, well listen up—","source_cn":"嘻嘻，听好了——","status":"matched","hash_xxh64":"0xE5C650AC49889E00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111120009:1":{"text":"Shut your mouth!","source_cn":"——住口！","status":"matched","hash_xxh64":"0x68603F22DE9B7073","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111120010:1":{"text":"Wyatt used to be one of us! A Quicksand Claw!","source_cn":"怀亚特，以前是我们流沙之爪的人！","status":"matched","hash_xxh64":"0x4758CF4690252EAE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1111120011:1":{"text":"...What was that?","source_cn":"……你说什么？","status":"matched","hash_xxh64":"0xC93BB026C519FDD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1111120012:1":{"text":"Dealing with traitors has always been so... pleasurable. I could reminisce about it for days on end!","source_cn":"哈哈哈哈，清理叛徒实在是一件乐事！我愿意讲上三天三夜！","status":"matched","hash_xxh64":"0xE25BCF2042C9BA66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1111120013:1":{"text":"Before we made this camp, Wyatt was under my command. Then this guy comes along and they buddy up as partners... boring!","source_cn":"在找到这个好地方做大本营之前，怀亚特是任老子差使的手下...","status":"matched","hash_xxh64":"0xAF72299DC149449D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1111120014:1":{"text":"And now you dare to bring outsiders before me?!","source_cn":"最后竟然还敢领着外人到我面前？！棺材才是最适合他的地方！","status":"matched","hash_xxh64":"0x81EDAB63C5AF4713","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1111120015:1":{"text":"Sure you want to harp on the past while starin' down the barrel of my gun?","source_cn":"……看着我的枪口，你还有闲心回忆过去吗？","status":"matched","hash_xxh64":"0x6A51124FD2F8AB7B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1111120016:1":{"text":"Aww, look, I hit a nerve! Our friend here seems not to want to reminisce any longer.","source_cn":"瞧瞧，戳到他的痛处了，咱们共同的老朋友，好像很不想追忆...","status":"matched","hash_xxh64":"0x7E64E1770D3C1194","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1111120017:1":{"text":"Alright then, if you're in such a rush to die, who am I to stand in your way?","source_cn":"好啊，急着送命的话，我不介意让人和你们玩玩！","status":"matched_runtime_gender","hash_xxh64":"0xDF08104D558A6410","variant_status":"runtime_gender_keys_target_same","male":"Alright then, if you're in such a rush to die, who am I to stand in your way?","female":"Alright then, if you're in such a rush to die, who am I to stand in your way?","variant_male_record_index":"121854","variant_female_record_index":"121855","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"Traitor?","source_cn":"……什么，叛徒？","status":"matched_runtime_gender","hash_xxh64":"0x55AE0F235A17325B","variant_status":"runtime_gender_keys_target_same","male":"Traitor?","female":"Traitor?","variant_male_record_index":"63442","variant_female_record_index":"63443","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"What happened?","source_cn":"怀亚特的牺牲究竟是怎么回事？","status":"matched_runtime_gender","hash_xxh64":"0xC4EABD6F1CCB6921","variant_status":"runtime_gender_keys_target_same","male":"What happened?","female":"What happened?","variant_male_record_index":"63444","variant_female_record_index":"63445","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:瓦尔克":{"text":"Walker","source":"瓦尔克","status":"matched_dialogue_flow"},"speaker:弗兰克":{"text":"Ferranc","source":"弗兰克","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":21,"localized_text_count":20,"speaker_count":3}}