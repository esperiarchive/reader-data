{"asset_key":"ep1/quest_story_11204050","episode":"ep1","category":"quest_story","story_id":"11204050","schema_version":1,"lang":"en","texts":{"say:2:1120405001:0":{"text":"*Cough*... Thanks. I nearly suffocated in there.","source_cn":"咳、咳咳……谢谢，我差点就在茧里窒息了……","status":"matched","hash_xxh64":"0x0A7D735B42BA7814","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1120405002:0":{"text":"Oh, Magister, it's you! You all came to the Crimson Highlands as well.","source_cn":"咦，是你们！魔法师<male>先生</male><fe...","status":"matched_runtime_gender","hash_xxh64":"0x013D531948A863AF","variant_status":"runtime_gender_keys_target_same","male":"Oh, Magister, it's you! You all came to the Crimson Highlands as well.","female":"Oh, Magister, it's you! You all came to the Crimson Highlands as well.","variant_male_record_index":"126502","variant_female_record_index":"126503","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120405003:0":{"text":"Melissa! It's really you! If you're here, then Gali must be...","source_cn":"梅丽莎！竟然真的是你？！你在这里的话，那伽利岂不是……","status":"matched","hash_xxh64":"0xBE831505B9A614CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120405004:0":{"text":"Gali? He and I got separated in a sandstorm on the way. Have you found him?","source_cn":"伽利？我和他在路上因为沙暴走散了，你们找到他了？","status":"matched","hash_xxh64":"0x4EE559026CAD3C61","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1120405004":{"text":"Gali? He and I got separated in a sandstorm on the way. Have you found him?","source_cn":"伽利？我和他在路上因为沙暴走散了，你们找到他了？","status":"matched","hash_xxh64":"0x4EE559026CAD3C61","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120405005:0":{"text":"A letter with his name on it? Let me see it.","source_cn":"……信？他写了信？能让我看看吗？","status":"matched_runtime_gender","hash_xxh64":"0x06072F4CA5DB8C1E","variant_status":"runtime_gender_keys_target_same","male":"A letter with his name on it? Let me see it.","female":"A letter with his name on it? Let me see it.","variant_male_record_index":"126506","variant_female_record_index":"126507","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120405006:0":{"text":"\"As one reaches the end of one's life, one becomes more sentimental...\"","source_cn":"“是不是人越到生命的尽头，就越变得脆弱和多情善感”……","status":"matched","hash_xxh64":"0x75EBA9D1F7853FC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120405007:1":{"text":"No... Gali... no...!","source_cn":"这、这是遗书……不……伽利，不……！！","status":"matched","hash_xxh64":"0xA5BFA8CBC881E498","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1120405008:0":{"text":"M-Melissa fainted!","source_cn":"梅、梅丽莎！她晕过去了！","status":"matched","hash_xxh64":"0x8ECA5B4279B6FFDF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:12:1120405009:0":{"text":"After being attended to, Melissa wakes up and bursts into tears.","source_cn":"照看后，梅丽莎终于呜咽着醒来","status":"matched","hash_xxh64":"0x596E1F2178BC7979","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1120405010:0":{"text":"Gali... This is Gali's handwriting... I always read his excavation reports...","source_cn":"伽利……这是伽利的字迹……他每次写完勘探报告都会给我看……","status":"matched","hash_xxh64":"0xBF220F0DB54454D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1120405011:0":{"text":"Gali! Why...?! *Sobs*","source_cn":"伽利，为什么……！呜呜呜呜……！","status":"matched","hash_xxh64":"0x78F4938B8A8AE22F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1120405012:0":{"text":"Melissa...","source_cn":"梅丽莎……","status":"matched","hash_xxh64":"0x577D4C0E822EE553","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:18:1120405012":{"text":"Melissa...","source_cn":"梅丽莎……","status":"matched","hash_xxh64":"0x577D4C0E822EE553","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1120405013:0":{"text":"I-I'm okay... There are more important things to do than cry...","source_cn":"……我，没事……我不能只流眼泪……","status":"matched","hash_xxh64":"0xABE41FF459F66BAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1120405014:0":{"text":"This is the last thing Gali left in this world. I have to give the letter to the person who needs it. That's all I can do for him...","source_cn":"这是伽利最后留在这世上的东西，我得把信交给需要它的人，...","status":"matched","hash_xxh64":"0x6B3833E21B097701","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1120405015:0":{"text":"The letter says that Gali wished he'd have listened to his mother and stayed with everyone in Alkali...","source_cn":"信上说，伽利希望能听母亲的话，和大家一起待在咸水镇……","status":"matched","hash_xxh64":"0x14D621B3B77A0C51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1120405016:0":{"text":"Mother? B-But Gali told me his mother passed away a long time ago.","source_cn":"……母亲？但、但伽利和我说过，他的母亲早就过世了。","status":"matched","hash_xxh64":"0x2BA001B5E3FAFB9A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1120405017:0":{"text":"But the letter says: \"I hope to deliver this letter to my mother. She's in Alkali...\"","source_cn":"可信上确实是这么写的：“希望能将这封信交给我的母亲，她...","status":"matched","hash_xxh64":"0x6E196C0B13536D81","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1120405018:0":{"text":"Gali sounded depressed when he talked about his mother's death, and you know how cheerful he usually is... I wouldn't misremember something like that...","source_cn":"伽利说起母亲过世时，情绪非常低沉，你们知道他平时神采飞...","status":"matched","hash_xxh64":"0x3487345D6FF15972","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1120405019:0":{"text":"So the letter is really in Gali's handwriting, but the words are wrong. What the heck is going on?","source_cn":"这么看来，这封信确实是伽利的笔迹没错，但内容不对。究竟...","status":"matched","hash_xxh64":"0x98051F736A8755C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:26:1120405019":{"text":"So the letter is really in Gali's handwriting, but the words are wrong. What the heck is going on?","source_cn":"这么看来，这封信确实是伽利的笔迹没错，但内容不对。究竟是怎么回事？","status":"matched","hash_xxh64":"0x98051F736A8755C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1120405020:0":{"text":"Gali was impulsive and reckless, but his luck was always good! He managed to escape from the gruglins, and he woke up from that sleeping potion. He's got to be alright...","source_cn":"伽利他……他冲动又鲁莽，但运气一向很好！他能从咕布林手...","status":"matched","hash_xxh64":"0xDBD0BD38BB5C3140","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1120405021:0":{"text":"We got separated somewhere around here. He couldn't have gone far unless... Maybe spiders dragged him away!","source_cn":"我们就是在这附近走散的，他应该不会走远，也许……也许他...","status":"matched","hash_xxh64":"0xCD0DA4F630ED2B70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1120405022:0":{"text":"Hey! Melissa! Wait for us! This place is dangerous!","source_cn":"诶——梅丽莎，等等我们！这附近不安全！","status":"matched","hash_xxh64":"0xF757376996178778","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:0:1":{"text":"Perhaps he meant something else.","source_cn":"也许另有缘由","status":"matched_runtime_gender","hash_xxh64":"0x6FE5E1E5DC3CEA29","variant_status":"runtime_gender_keys_target_same","male":"Perhaps he meant something else.","female":"Perhaps he meant something else.","variant_male_record_index":"64626","variant_female_record_index":"64627","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:1:2":{"text":"Maybe... Gali is still alive?","source_cn":"也许，伽利还活着？","status":"matched_runtime_gender","hash_xxh64":"0xC9FB070558DC5E24","variant_status":"runtime_gender_keys_target_same","male":"Maybe... Gali is still alive?","female":"Maybe... Gali is still alive?","variant_male_record_index":"64628","variant_female_record_index":"64629","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:0:1":{"text":"(Hand her a handkerchief)","source_cn":"（递出手帕）","status":"matched_runtime_gender","hash_xxh64":"0x9537D32A149C20CF","variant_status":"runtime_gender_keys_target_same","male":"(Hand her a handkerchief)","female":"(Hand her a handkerchief)","variant_male_record_index":"64620","variant_female_record_index":"64621","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:1:2":{"text":"You'll feel better after you cry.","source_cn":"哭过后会舒服些","status":"matched_runtime_gender","hash_xxh64":"0x68495FC2F16D282F","variant_status":"runtime_gender_keys_target_same","male":"You'll feel better after you cry.","female":"You'll feel better after you cry.","variant_male_record_index":"64622","variant_female_record_index":"64623","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:18:2:3":{"text":"We're here for you.","source_cn":"我们会陪着你","status":"matched_runtime_gender","hash_xxh64":"0xBB25745C1E35A8C0","variant_status":"runtime_gender_keys_target_same","male":"We're here for you.","female":"We're here for you.","variant_male_record_index":"64624","variant_female_record_index":"64625","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"Found a letter with Gali's name...","source_cn":"我们发现了署名伽利的信……","status":"matched_runtime_gender","hash_xxh64":"0x0F83ACDD747AB24C","variant_status":"runtime_gender_keys_target_same","male":"Found a letter with Gali's name...","female":"Found a letter with Gali's name...","variant_male_record_index":"64616","variant_female_record_index":"64617","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"Not sure if