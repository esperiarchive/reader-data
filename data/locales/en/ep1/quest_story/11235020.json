{"asset_key":"ep1/quest_story_11235020","episode":"ep1","category":"quest_story","story_id":"11235020","schema_version":1,"lang":"en","texts":{"say:1:1123502001:1":{"text":"Magister Merlin, I've got some good news here!","source_cn":"梅林大人，我这里有个好消息！","status":"matched_runtime_gender","hash_xxh64":"0x4FEE3EC4D4970FCC","variant_status":"runtime_gender_keys_target_same","male":"Magister Merlin, I've got some good news here!","female":"Magister Merlin, I've got some good news here!","variant_male_record_index":"127723","variant_female_record_index":"127724","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1123502002:1":{"text":"I found Hashir's new place. I want to go talk to him.","source_cn":"我找到了哈什尔的新住处，并且已经决定要去和他谈谈。","status":"matched","hash_xxh64":"0x04426A8EB5766DFE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123502003:1":{"text":"Would you all go with me?","source_cn":"你们能陪同我一起过去看看吗？","status":"matched","hash_xxh64":"0xB7B1827749CBF311","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123502004:1":{"text":"You all have been taking care of him for a while. Perhaps things won't be so tense with you around.","source_cn":"一直以来都是你们在照顾他，也许你们在场的话，能缓和我和...","status":"matched","hash_xxh64":"0xBC7CBB539F162788","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1123502004":{"text":"You all have been taking care of him for a while. Perhaps things won't be so tense with you around.","source_cn":"一直以来都是你们在照顾他，也许你们在场的话，能缓和我和他之间的矛盾。","status":"matched","hash_xxh64":"0xBC7CBB539F162788","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1123502005:1":{"text":"Thank you. You've been a great help.","source_cn":"谢谢，你帮我太多了。","status":"matched_runtime_gender","hash_xxh64":"0xF929E9E6464D2879","variant_status":"runtime_gender_keys_target_same","male":"Thank you. You've been a great help.","female":"Thank you. You've been a great help.","variant_male_record_index":"127728","variant_female_record_index":"127729","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123502007:1":{"text":"I'll remember your contribution to the Grimmaw Clan, my honored friends!","source_cn":"我会记得，尊贵朋友们为黑嚎氏族带来的贡献！","status":"matched","hash_xxh64":"0x607673DB4275A5B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"Of course.","source_cn":"（欣然答应）","status":"matched_runtime_gender","hash_xxh64":"0x5B0A1235C472D241","variant_status":"runtime_gender_keys_target_same","male":"Of course.","female":"Of course.","variant_male_record_index":"64932","variant_female_record_index":"64933","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123502006:1":{"text":"I know this goes against his wishes, but I can't just give up like this.","source_cn":"我知道这违背他的意愿，但我不能就这样放弃了。","status":"matched","hash_xxh64":"0x9D3B6B2C3F1A2AC0","variant_status":"","male":"","female":"","variant_male_record_index":"","varia