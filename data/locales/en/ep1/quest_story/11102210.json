{"asset_key":"ep1/quest_story_11102210","episode":"ep1","category":"quest_story","story_id":"11102210","schema_version":1,"lang":"en","texts":{"say:0:1110221001:0":{"text":"As we get closer, the sand will get redder. There'll also be a lot of skeletons...","source_cn":"这条路上，离赤沙蛛域越近，沙子就越红。沿途还有不少骸骨……","status":"matched","hash_xxh64":"0xF24DEA27392E8D4B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1110221002:0":{"text":"We'll also need to be careful of sandstorms, Alsa.","source_cn":"从附近地貌的痕迹判断——阿尔萨，小心沙暴。","status":"matched","hash_xxh64":"0x729724191EFA6BE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110221003:0":{"text":"Don't worry. I'm the best at finding shelter when there's a sandstorm!","source_cn":"放心吧，我可是最擅长带着大家找地方躲避沙暴了！","status":"matched","hash_xxh64":"0xD245CFB8CDC45A65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}