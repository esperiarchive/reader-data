{"asset_key":"ep1/quest_story_11112060","episode":"ep1","category":"quest_story","story_id":"11112060","schema_version":1,"lang":"en","texts":{"say:1:1111206001:1":{"text":"I've finally found you at last... Antandra!","source_cn":"终于找到你了……安丹德拉！","status":"matched","hash_xxh64":"0x9C3E72C0375279D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1111206002:1":{"text":"Satrana?! What are you doing here?","source_cn":"萨忒娜？你怎么会在这里？","status":"matched","hash_xxh64":"0x6329626A15CFB75D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111206003:1":{"text":"Antandra, are these your friends?","source_cn":"安丹姐姐，这些是你的朋友吗？","status":"matched","hash_xxh64":"0x9DA5371CF6F1E549","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111206004:1":{"text":"That's right. This is an acquaintance of mine.","source_cn":"没错，是姐姐的熟人。","status":"matched","hash_xxh64":"0x94F3E97D8650BBA5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111206005:1":{"text":"Acquaintance? Is that what I am to you?!","source_cn":"熟人？那是什么名不正言不顺的说辞！","status":"matched","hash_xxh64":"0xB8F5A6F8CA4B0E7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111206006:1":{"text":"I've spent half my life trying to find you!","source_cn":"你知不知道为了找到你，我差点丢掉了半条命！","status":"matched","hash_xxh64":"0x9BB1605839024FEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1111206007:1":{"text":"And you call me an acquaintance?!","source_cn":"结果你竟然说我是你的……熟人？！","status":"matched","hash_xxh64":"0xAAD89117B86F43B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111206008:1":{"text":"She's a little scary, Antandra.","source_cn":"安丹姐姐，这个人……可怕。","status":"matched","hash_xxh64":"0x3F6175BBC349AA05","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111206009:1":{"text":"I am NOT scary!","source_cn":"不许说我可怕！","status":"matched","hash_xxh64":"0xA92973F567104ED8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1111206010:1":{"text":"Sorry, Satrana. The last time we met, you said you didn't want to be friends, so I thought...","source_cn":"抱歉，萨忒娜，最后一次见面时你曾说，不希望我们再以朋友...","status":"matched","hash_xxh64":"0x797B2C033526C205","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:12:1111206010":{"text":"Sorry, Satrana. The last time we met, you said you didn't want to be friends, so I thought...","source_cn":"抱歉，萨忒娜，最后一次见面时你曾说，不希望我们再以朋友相称。所以，我以为……","status":"matched","hash_xxh64":"0x797B2C033526C205","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111206011:1":{"text":"She just didn't understand my meaning!","source_cn":"是她没有理解我的用意！","status":"matched_runtime_gender","hash_xxh64":"0x2E5D9ECC3BE6475A","variant_status":"runtime_gender_keys_target_same","male":"She just didn't understand my meaning!","female":"She just didn't understand my meaning!","variant_male_record_index":"122792","variant_female_record_index":"122793","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1111206012:1":{"text":"Enough... I guess it was wishful thinking on my part.","source_cn":"够了……简直是我一厢情愿！","status":"matched","hash_xxh64":"0xC332E79825FE8DCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1111206013:1":{"text":"She's leaving, Antandra... Should I go call her back?","source_cn":"……她走了，安丹姐姐，我去安慰？","status":"matched","hash_xxh64":"0x2FDED611DE672B38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1111206014:1":{"text":"Leave it to me, Koko.","source_cn":"还是交给我吧，卡卡。","status":"matched","hash_xxh64":"0x8ABC5C7815F2DF2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1111206015:1":{"text":"Are you all friends of Satrana? I'm sorry you had to sit through that.","source_cn":"诸位，你们是萨忒娜新结识的伙伴吗？真抱歉让你们看见了这...","status":"matched","hash_xxh64":"0x65308C9FF5983E5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1111206016:1":{"text":"Please allow me to formally introduce myself. My name is Antandra, and this is Koko.","source_cn":"请容我做个正式的自我介绍，我是安丹德拉。这孩子，她叫卡卡。","status":"matched","hash_xxh64":"0x05F31DA7C5999C0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1111206017:1":{"text":"Judging from your appearance, you must be Soren of the Uru Clan. Tales of your feats at the Warsong Festival have spread far.","source_cn":"看这位的模样，你一定是乌尔氏族的索恩。你在战歌节的故事...","status":"matched","hash_xxh64":"0x87E17218D0B2B0D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1111206018:1":{"text":"Wow, Soren is famous!","source_cn":"哇哦，索恩现在也是名人了呢。","status":"matched","hash_xxh64":"0x529642F09CE532D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1111206019:1":{"text":"That makes you even more qualified to be our magister's friend.","source_cn":"很好，这样一来，你更有资格与我伟大的主人一同行动了。","status":"matched_runtime_gender","hash_xxh64":"0x47A03014839BADF3","variant_status":"runtime_gender_keys_target_same","male":"That makes you even more qualified to be our magister's friend.","female":"That makes you even more qualified to be our magister's friend.","variant_male_record_index":"122802","variant_female_record_index":"122803","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1111206020:1":{"text":"You talk too much.","source_cn":"……啰嗦。","status":"matched","hash_xxh64":"0xFD6DD0E685C2583B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1111206021:1":{"text":"What I want to know is why there are so many bounty hunters in this camp.","source_cn":"我想知道这里是怎么回事？营地里为什么还有一大群赏金猎人？","status":"matched","hash_xxh64":"0xA8C2878B18ED8999","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1111206022:1":{"text":"That's quite a long story. These young ones have lost their families, and so I've built this place as a haven for them.","source_cn":"说来话长。这些孩子们失去了家人，这个地方算是我为他们搭...","status":"matched","hash_xxh64":"0xBDB002AE1C1524E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1111206023:1":{"text":"As for the bounty hunters, I've employed them to assist in protecting the young ones.","source_cn":"至于这些赏金猎人，他们受我所雇，和我一起保护着这些孩子们。","status":"matched","hash_xxh64":"0xABB0E7675BBAA85E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1111206024:1":{"text":"A job well-suited to them.","source_cn":"对他们来说，这倒是个好差事。","status":"matched","hash_xxh64":"0x3D6BE314C74BC3FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1111206025:0":{"text":"Hey! Stop it!","source_cn":"啊——住手！","status":"matched","hash_xxh64":"0x8EB6333F37963769","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1111206026:1":{"text":"Ah, seems the little ones are acting up again. Excuse me while I deal with this.","source_cn":"糟糕，小孩子们又在捣乱了。失陪，我先去处理一下！","status":"matched","hash_xxh64":"0x26CAD0DDCF53B6E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:12:0:1":{"text":"What's going on?","source_cn":"这是怎么回事？","status":"matched_runtime_gender","hash_xxh64":"0x86E8134285BE2366","variant_status":"runtime_gender_keys_target_same","male":"What's going on?","female":"What's going on?","variant_male_record_index":"63694","variant_female_record_index":"63695","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:萨忒娜":{"text":"Satrana","source":"萨忒娜","status":"matched_dialogue_flow"},"speaker:安丹德拉":{"text":"Antandra","source":"安丹德拉","status":"matched_dialogue_flow"},"speaker:眼神净澈的小孩":{"text":"Innocent Kid","source":"眼神净澈的小孩","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":29,"localized_text_count":28,"speaker_count":5}}