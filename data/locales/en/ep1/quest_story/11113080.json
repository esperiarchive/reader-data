{"asset_key":"ep1/quest_story_11113080","episode":"ep1","category":"quest_story","story_id":"11113080","schema_version":1,"lang":"en","texts":{"say:2:1111308001:1":{"text":"Get to the good part, Rhys! Tell us how you defeated the Quicksand Claws!","source_cn":"诡草大哥，你说重点嘛！仔细说说你是怎么打败流沙之爪的！","status":"matched","hash_xxh64":"0xF5AB0DEAF2F40415","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1111308002:1":{"text":"Well, as you all know, I'm a professional terrabird trainer! So, while I was taking care of their terrabirds, I was secretly raising my own terrabird army!","source_cn":"你们也知道，我可是驯养陆行鸟的专家！我一面给他们养鸟，...","status":"matched","hash_xxh64":"0xAD06EC1D60EAF9A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111308003:1":{"text":"Wow! A whole army of terrabirds!","source_cn":"哇！陆行鸟军团！","status":"matched","hash_xxh64":"0xE6BAA7ABB887A70F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111308004:0":{"text":"That's right, and my beloved <style=\"highlight\">Plumecharger</style> here was their fearless commander!","source_cn":"没错，我的爱鸟<style=highlight>炽翼冲...","status":"matched","hash_xxh64":"0xF5B68EE4B3ECA3FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111308005:0":{"text":"Tell us more! What happened next?","source_cn":"然后呢然后呢！","status":"matched","hash_xxh64":"0xDFF00D2F7B8BED81","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111308006:1":{"text":"Well, on the night of the blood moon... I led my legion of feathered warriors straight into Ferranc's camp!","source_cn":"然后啊……在那红月高升的夜晚……我率领陆行鸟军团冲进了...","status":"matched","hash_xxh64":"0xD1067EA54A21C65A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1111308007:1":{"text":"Boom! Bang! I fired off six rounds, one after the other!","source_cn":"嘭！我开了一枪、两枪、三枪、四枪、五枪、六枪！总共六发子弹！","status":"matched","hash_xxh64":"0xBE59174E761CFBC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111308008:0":{"text":"After the shooting stopped, the only ones left standing were me and my terrabird army!","source_cn":"这时候，整个大本营内，只剩下我和陆行鸟军团还站着不倒！","status":"matched","hash_xxh64":"0xED916D49745B91A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1111308009:0":{"text":"Wow... That's amazing!","source_cn":"哇……听上去好厉害。","status":"matched","hash_xxh64":"0xAA2269650009E0A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1111308010:0":{"text":"He's lying.","source_cn":"他撒谎。","status":"matched","hash_xxh64":"0x9E13884672993938","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1111308011:0":{"text":"He's lying?","source_cn":"咦！是骗人的？","status":"matched","hash_xxh64":"0x0597296F7484A76A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1111308012:0":{"text":"Hello again, Rhys. Your tall tales have only gotten taller lately, haven't they?","source_cn":"喂，那个叫诡草的。你的肺不错啊，很擅长吹牛。","status":"matched","hash_xxh64":"0x3E9F817920753EEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1111308013:0":{"text":"Who's callin' me a liar?! I'm gonna... Oh, hey... What are you guys doing here?","source_cn":"谁说我吹牛——怎、怎么是你们几个？！","status":"matched","hash_xxh64":"0x2FF9224799AD2B44","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1111308014:1":{"text":"We didn't expect to run into the birdkeeper of the Quicksand Claws here.","source_cn":"我也没想到会和你再见，流沙之爪的养鸟人。","status":"matched","hash_xxh64":"0xE1930F81A7E8BBCF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1111308015:1":{"text":"Who are you calling a birdkeeper?! Show some respect! Terrabirds are the pride of the desert! They're not just ordinary birds!","source_cn":"什么养鸟人啊！不准用那种称呼叫我！\\n陆行鸟可不是普通...","status":"matched","hash_xxh64":"0x8E34D542B5B175EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1111308016:1":{"text":"Wait, that's not the point...! You guys shouldn't be here. Get out of here!","source_cn":"不对……重点不是这个！\\n你们怎么会在这？快给我滚蛋！","status":"matched","hash_xxh64":"0x84902F9104D554C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1111308017:0":{"text":"Who are these people, Rhys?","source_cn":"诡草大哥，他们是什么人呀！","status":"matched","hash_xxh64":"0x1C739B0E141B3A80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1111308018:1":{"text":"They're just... a bunch of lucky prisoners who managed to escape from the Quicksand Claws!","source_cn":"这个……那个……他、他们是侥幸从流沙之爪手底下逃出来的俘虏！","status":"matched","hash_xxh64":"0x6E3D769A60FD7219","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1111308019:1":{"text":"If it wasn't for me, they would've been vulture meat.","source_cn":"要是没有我，估计早被老鹰吃掉了！","status":"matched","hash_xxh64":"0x42E09BBB23CCEEE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1111308020:0":{"text":"More lies...","source_cn":"你再编？","status":"matched","hash_xxh64":"0x8B83381853196F2C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1111308021:0":{"text":"B-But that's history... There's no point digging up the past.","source_cn":"都、都过去了……大家好不容易离开那个地方，这些破事就别...","status":"matched","hash_xxh64":"0x2C1BB306A0E22F72","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1111308022:0":{"text":"I'm not the one who brought up the past.","source_cn":"可不是我主动提的。","status":"matched","hash_xxh64":"0x9A836F80ACDE49D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1111308023:0":{"text":"You all look like heroes, too. Just like our Rhys!","source_cn":"大哥哥，你们也很棒！也是凯旋的英雄呢！","status":"matched","hash_xxh64":"0x2885365DBAFCE115","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1111308024:0":{"text":"We were just about to throw a big party in his honor. Why don't you join us? Stop looking so angry, Rhys. They're guests.","source_cn":"我们正准备给诡草大哥举行庆功宴会！你们也一起庆祝吧！不...","status":"matched","hash_xxh64":"0x215611A6BCEDC707","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1111308025:0":{"text":"...Alright, a party sounds nice. I'll leave him alone.","source_cn":"……好吧，看在你们的面子上，不跟那家伙计较了。","status":"matched","hash_xxh64":"0xA9F102DA2FAE158C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:34:1111308023":{"text":"You all look like heroes, too. Just like our Rhys!","source_cn":"哇！大哥哥，你们也很棒！也是凯旋的英雄呢！","status":"matched","hash_xxh64":"0x2885365DBAFCE115","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1111308026:0":{"text":"If they cry, it gets troublesome.","source_cn":"万一哭了，很麻烦。","status":"matched_runtime_gender","hash_xxh64":"0x3138DE0306DA2BFD","variant_status":"runtime_gender_keys_target_same","male":"If they cry, it gets troublesome.","female":"If they cry, it gets troublesome.","variant_male_record_index":"123942","variant_female_record_index":"123943","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1111308028:0":{"text":"I didn't agree to them joining my party! Why do they get to come?!","source_cn":"谁要和他们一起庆祝！我不同意！","status":"matched","hash_xxh64":"0x2EE2F21B39616E28","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1111308029:0":{"text":"Rhys! Rhys! Listen to me!","source_cn":"糟了糟了！诡草大哥不好啦！","status":"matched","hash_xxh64":"0x25825B15802FF2E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1111308030:0":{"text":"Can't you see I'm in the middle of something? What is it now?","source_cn":"怎么了……别大惊小怪，没看见我正忙着吵架吗！","status":"matched","hash_xxh64":"0x0435E6D6F5043E47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1111308031:0":{"text":"The little terrabirds you saved all ran away!","source_cn":"诡草大哥，你救回来的小陆行鸟都跑了！","status":"matched","hash_xxh64":"0x182F2E8A70AD55EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1111308032:0":{"text":"What?! Didn't I tell you guys to keep an eye on them?!","source_cn":"什么？说了一百次让你们看好！","status":"matched","hash_xxh64":"0x9C59DF65285E0A4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1111308033:0":{"text":"I'll deal with you later, bear breath! I got bigger business to attend to!","source_cn":"哼！熊耳朵！回头再跟你算账，我有事先忙！","status":"matched","hash_xxh64":"0x57FC34E41B4351E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:34:0:1":{"text":"You're not good with kids, huh?","source_cn":"你拿小孩子没办法啊","status":"matched_runtime_gender","hash_xxh64":"0x09B6300D41280D65","variant_status":"runtime_gender_keys_target_same","male":"You're not good with kids, huh?","female":"You're not good with kids, huh?","variant_male_record_index":"63958","variant_female_record_index":"63959","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1111308027:0":{"text":"I don't really care.","source_cn":"才不是，谁稀罕。","status":"matched_runtime_gender","hash_xxh64":"0x8FB24933A6A14820","variant_status":"runtime_gender_keys_target_same","male":"I don't really care.","female":"I don't really care.","variant_male_record_index":"123944","variant_female_record_index":"123945","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:34:1:2":{"text":"Did you like being called a hero?","source_cn":"你喜欢被叫大英雄？","status":"matched_runtime_gender","hash_xxh64":"0x2EC9325CA7826DE8","variant_status":"runtime_gender_keys_target_same","male":"Did you like being called a hero?","female":"Did you like being called a hero?","variant_male_record_index":"63960","variant_female_record_index":"63961","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:激动的小孩":{"text":"Excited Kid","source":"激动的小孩","status":"matched_dialogue_flow"},"speaker:诡草":{"text":"Rhys","source":"诡草","status":"matched_dialogue_flow"},"speaker:卡卡":{"text":"Koko","source":"卡卡","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"},"speaker:焦急的小孩":{"text":"Anxious Kid","source":"焦急的小孩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":37,"localized_text_count":36,"speaker_count":5}}