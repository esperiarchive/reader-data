{"asset_key":"ep1/quest_story_11236290","episode":"ep1","category":"quest_story","story_id":"11236290","schema_version":1,"lang":"en","texts":{"say:2:1123629001:1":{"text":"Zane! Are you alright?","source_cn":"萨恩！你没事吧？","status":"matched","hash_xxh64":"0xAA12210D62A18B4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1123629002:1":{"text":"I'm fine! It's just that those annoying bugs are crawling all over my fur and refuse to come out!","source_cn":"已经没事了！都怪那群讨厌的小虫子，爬进毛里就不肯出来了！","status":"matched","hash_xxh64":"0x67AA9C58B4894177","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1123629003:1":{"text":"That's good. Let's take a break and then carry on with the trial.","source_cn":"那就好。我们休息一阵，再继续完成试炼吧。","status":"matched","hash_xxh64":"0x5C607AE7618F10D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1123629004:1":{"text":"What?! Do you all still want to continue even though you're injured?","source_cn":"哎？！你们都受伤了，还要继续试炼吗？","status":"matched","hash_xxh64":"0x61FB24D31A4A550C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1123629005:1":{"text":"We expected to gain wounds and scars during the trial. It's a test to see how far we can go!","source_cn":"在试炼中受伤不是常事吗！否则怎么考验我们的实力！","status":"matched","hash_xxh64":"0x9F00265B51747F15","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1123629006:1":{"text":"We're ready to face anything that happens! Even death! This is what the trial means!","source_cn":"就算是死于试炼之中，我们也绝无怨言！这就是试炼的意义！","status":"matched","hash_xxh64":"0xB283D119C5DF7B53","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:战士扎尔坦":{"text":"Warrior Zoltan","source":"战士扎尔坦","status":"matched_dialogue_flow"},"speaker:战士萨恩":{"text":"Warrior Zane","source":"战士萨恩","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":3}}