{"asset_key":"ep1/quest_story_11207530","episode":"ep1","category":"quest_story","story_id":"11207530","schema_version":1,"lang":"en","texts":{"say:3:1120753001:0":{"text":"H-hello, Chief...","source_cn":"族、族长……","status":"matched","hash_xxh64":"0xC803E498AF77B3E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120753002:0":{"text":"Word of your deeds has already reached my ears.","source_cn":"你们做的事情，已经传到我耳朵里了。","status":"matched","hash_xxh64":"0xB8CE9B79A909F386","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120753003:0":{"text":"Rumon and I will continue helping as many of your clan as we need to.","source_cn":"无论需要我们获得多少人的认可，我和卢玛都会尽力去做。","status":"matched","hash_xxh64":"0x9749EF46416DB293","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120753004:0":{"text":"I'm not the kind of stubborn old-timer who enjoys making life difficult for anyone. I know what members of the clan are thinking, and some have come to accept you. This could mark a new beginning.","source_cn":"我可不是那种喜欢刁难人的老顽固。我知道部落的大家在想什...","status":"matched","hash_xxh64":"0x0C7E883201CCC684","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120753005:0":{"text":"Prepare yourself to bleed alongside the others in the Bestial Brawl.","source_cn":"做好受伤和流血的准备，去和我们部族的成员一起参加斗兽演...","status":"matched","hash_xxh64":"0x2BD0255A112D32C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120753006:0":{"text":"Really?! We have your blessing?!","source_cn":"真、真的吗？！你同意了？！","status":"matched","hash_xxh64":"0xCC22271946156816","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120753007:0":{"text":"T-thank you!","source_cn":"谢、谢谢……！","status":"matched","hash_xxh64":"0xC9EA8495C1ED9523","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1120753007":{"text":"T-thank you!","source_cn":"谢、谢谢……！","status":"matched","hash_xxh64":"0xC9EA8495C1ED9523","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1120753008:0":{"text":"Magister, thank you for trusting Rumon and me. You gave us the chance to do the right thing.","source_cn":"魔法师<male>哥哥</male><female>姐...","status":"matched_runtime_gender","hash_xxh64":"0x42DEB375F7A629D8","variant_status":"runtime_gender_keys_target_same","male":"Magister, thank you for trusting Rumon and me. You gave us the chance to do the right thing.","female":"Magister, thank you for trusting Rumon and me. You gave us the chance to do the right thing.","variant_male_record_index":"126365","variant_female_record_index":"126366","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1120753009:0":{"text":"Well, the closest ironjaw grounds of the clan are to the south.","source_cn":"嗯……训练场就在南边，那是离部落最近的钢颚兽栖息地。","status":"matched","hash_xxh64":"0x61911F1D55FC5EE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1120753010:0":{"text":"The participating warriors are all training there, so make haste. I would not have you go unprepared into battle, even if you were once our enemy.","source_cn":"现有部族的勇士正在那里训练，你们自行去吧。我不会让没有...","status":"matched","hash_xxh64":"0xA8629532E30B6EB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1120753011:0":{"text":"Thank you! We'll head there straight away!","source_cn":"谢谢您！我们现在就去训练场！","status":"matched","hash_xxh64":"0xAFA3E0699607D7BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"You've earned your acceptance.","source_cn":"恭喜你们获得了认可！","status":"matched_runtime_gender","hash_xxh64":"0x2F8F97A172BEA5F8","variant_status":"runtime_gender_keys_target_same","male":"You've earned your acceptance.","female":"You've earned your acceptance.","variant_male_record_index":"64558","variant_female_record_index":"64559","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"All thanks to my help.","source_cn":"多亏有我帮忙啊","status":"matched_runtime_gender","hash_xxh64":"0xB6C852C2663D5764","variant_status":"runtime_gender_keys_target_same","male":"All thanks to my help.","female":"All thanks to my help.","variant_male_record_index":"64560","variant_female_record_index":"64561","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢玛":{"text":"Rumon","source":"卢玛","status":"matched_dialogue_flow"},"speaker:老族长库胡林":{"text":"Chief Chulain","source":"老族长库胡林","status":"matched_dialogue_flow"},"speaker:奇克":{"text":"Chak","source":"奇克","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":15,"localized_text_count":14,"speaker_count":3}}