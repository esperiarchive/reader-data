d_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1111020015:1":{"text":"That Quicksand Claw we just took out? That was Lionheart, Ferranc's right-hand man.","source_cn":"刚才被咱们干掉的那个流沙之爪，叫鬣心。算是弗兰克的副手。","status":"matched","hash_xxh64":"0xACA36C68F3A44DE6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1111020016:1":{"text":"We've gotta be closing in on their main camp.","source_cn":"这样看来，流沙之爪的大本营，不远了。","status":"matched","hash_xxh64":"0x8B3CAEA399371D30","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1111020017:1":{"text":"It's... almost go time.","source_cn":"结账时间……就要到了。","status":"matched","hash_xxh64":"0xBEF08C35BC4A8D5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:0:1":{"text":"It's time to make some noise!","source_cn":"是时候大闹一场了","status":"matched_runtime_gender","hash_xxh64":"0x4D2E72B8BEEAE4D2","variant_status":"runtime_gender_keys_target_same","male":"It's time to make some noise!","female":"It's time to make some noise!","variant_male_record_index":"63900","variant_female_record_index":"63901","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:1:2":{"text":"Come on! Let's kick some ass!","source_cn":"走吧，去找流沙之爪算账！","status":"matched_runtime_gender","hash_xxh64":"0xB5AED07C48B1C986","variant_status":"runtime_gender_keys_tar