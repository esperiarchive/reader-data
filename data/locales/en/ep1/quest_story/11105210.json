{"asset_key":"ep1/quest_story_11105210","episode":"ep1","category":"quest_story","story_id":"11105210","schema_version":1,"lang":"en","texts":{"say:1:1110521001:0":{"text":"I...","source_cn":"你、你们想干什么？","status":"matched","hash_xxh64":"0xC4C08E3F17331FE1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1110521002:0":{"text":"Please don't hurt me!","source_cn":"你、抓得我好痛！","status":"matched","hash_xxh64":"0xEC3209F801D15EC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1110521003:1":{"text":"Alsa! No!","source_cn":"阿尔萨……可恶！","status":"matched","hash_xxh64":"0x57CEE0CDE94ACDE4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110521004:1":{"text":"There's something off about this dagger. Alsa's burning up...","source_cn":"这把匕首可能有问题，阿尔萨的身体好烫……","status":"matched","hash_xxh64":"0xF3800047D06F548D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1110521005:1":{"text":"Could there be poison on it? What do we do?! Alsa!!","source_cn":"匕首上淬了毒？","status":"matched","hash_xxh64":"0xFA001AE1BCC734F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1110521006:1":{"text":"Soren, calm down! Keep your wits about you.","source_cn":"索恩，你冷静点！现在最要紧的是救阿尔萨！","status":"matched","hash_xxh64":"0xDF08FFEBB40774FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1110521007:1":{"text":"Little one, do you know what's on this dagger?","source_cn":"那个小蛮血，你知道这把匕首上涂的是什么毒药吗？","status":"matched","hash_xxh64":"0x35BDB4CE183BC147","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1110521008:1":{"text":"I'm so sorry... I had no choice! I had to do this for my sister! That merchant guy told me to and...","source_cn":"毒药？我不知道……只、只是有个商人叔叔找到我，给我食物...","status":"matched","hash_xxh64":"0x35573616DDFE0B02","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1110521009:1":{"text":"Merchant? Where is he now?","source_cn":"那商人，现在在哪里？","status":"matched","hash_xxh64":"0x0344071E5CCB5C4B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1110521010:1":{"text":"I don't know, he wasn't a Mauler. Maybe he was just visiting?","source_cn":"我不知道……那个商人叔叔不是蛮血，可能走掉了吧？","status":"matched","hash_xxh64":"0x615B528308A41811","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1110521010":{"text":"I don't know, he wasn't a Mauler. Maybe he was just visiting?","source_cn":"我不知道……那个商人叔叔不是蛮血，可能走掉了吧？","status":"matched","hash_xxh64":"0x615B528308A41811","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1110521011:1":{"text":"Perhaps... a merchant from the Adamant Syndicate? This kind of foul thing definitely seems like something they'd do!","source_cn":"主人是想起了……黑金商会？这种暗中搞事的感觉，确实很像！","status":"matched_runtime_gender","hash_xxh64":"0x2F5CA1BFBD511269","variant_status":"runtime_gender_keys_target_same","male":"Perhaps... a merchant from the Adamant Syndicate? This kind of foul thing definitely seems like something they'd do!","female":"Perhaps... a merchant from the Adamant Syndicate? This kind of foul thing definitely seems like something they'd do!","variant_male_record_index":"120357","variant_female_record_index":"120358","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1110521013:1":{"text":"But if it was them, why would they target Alsa? It doesn't make sense...","source_cn":"不过如果真的是黑金商会，他们为什么会盯上阿尔萨？好奇怪啊……","status":"matched","hash_xxh64":"0x730147BAB0BE7C38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1110521014:1":{"text":"Adamant Syndicate? What's that?","source_cn":"你们说的黑金商会，是什么意思？","status":"matched","hash_xxh64":"0x1987337F44D9DEAE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1110521015:1":{"text":"A group full of evil people! They're all a bunch of bad eggs! And if it really is them behind this... Finding the antidote won't be easy...","source_cn":"就是一个坏蛋组织！如果真的是黑金商会，那么解药肯定很难...","status":"matched","hash_xxh64":"0xF62DC008DE92E8B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1110521016:1":{"text":"I understand... But what do we do about this kid?","source_cn":"我明白了。看来你也没有解药，对吗？","status":"matched","hash_xxh64":"0x46F5BA4CD4C5642D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1110521017:1":{"text":"I'm sorry... I just wanted to help my sister. Please forgive me!","source_cn":"对不起，大哥哥，我太饿了……","status":"matched","hash_xxh64":"0xB3376FE151F1CFF9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1110521018:1":{"text":"Scram!","source_cn":"闭嘴。快滚……","status":"matched","hash_xxh64":"0x8C0750EEADE02C17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1110521019:1":{"text":"Never show your face here again!","source_cn":"我不是阿尔萨。不想吃苦头的话，之后就别出现在我面前！","status":"matched","hash_xxh64":"0xB32BF9AAFC4BB3FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1110521020:1":{"text":"By the setting sun! Alsa's injured? Take her to that tent to rest...","source_cn":"残阳神啊！阿尔萨这是受伤了吗？快带她去那顶帐篷里休息……","status":"matched","hash_xxh64":"0x52094FF5EA20AF16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1110521021:1":{"text":"Thank you, Mikola.","source_cn":"谢谢你……曼卡拉……","status":"matched","hash_xxh64":"0x0AE2C1A191F64A88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:32:1110521021":{"text":"Thank you, Mikola.","source_cn":"谢谢你……曼卡拉……","status":"matched","hash_xxh64":"0x0AE2C1A191F64A88","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1110521022:1":{"text":"It's all my fault...","source_cn":"都怪我……阿尔萨，真的不会出事吗？","status":"matched","hash_xxh64":"0x4C12125AAF88EC09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1110521023:1":{"text":"Poisoned? Maybe we can find a cure... Ah! Wait a second!","source_cn":"中毒吗？或许能找到办法……等我！","status":"matched","hash_xxh64":"0x3E3D596823BDD075","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:32:0:1":{"text":"I think A