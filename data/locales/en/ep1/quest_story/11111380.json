{"asset_key":"ep1/quest_story_11111380","episode":"ep1","category":"quest_story","story_id":"11111380","schema_version":1,"lang":"en","texts":{"say:3:1111138001:0":{"text":"Time flies when you're on the trail, folks. And it's time for me to mosey on.","source_cn":"时间总是转瞬即逝，各位，该说再见了。","status":"matched_runtime_gender","hash_xxh64":"0x3142A1AB6A446BA3","variant_status":"runtime_gender_keys_target_same","male":"Time flies when you're on the trail, folks. And it's time for me to mosey on.","female":"Time flies when you're on the trail, folks. And it's time for me to mosey on.","variant_male_record_index":"123510","variant_female_record_index":"123511","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111138002:0":{"text":"You're leaving? You won't come to the Crimson Highlands with us?","source_cn":"你要走了？不一起去深红高原吗？","status":"matched","hash_xxh64":"0x23B40CC88771AFBE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111138003:1":{"text":"Treasure huntin's for the young 'uns. I'll leave that to you lot.","source_cn":"寻宝是年轻人的浪漫，大叔就不参与了。","status":"matched","hash_xxh64":"0x44B147770049FFAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111138004:1":{"text":"But listen up and consider this my last bit of advice: the Crimson Highlands ain't short on surprises. Even if you're capable, you best keep your wits about you.","source_cn":"另外……算是我最后的忠告吧：深红高原危机四伏，就算你们...","status":"matched_runtime_gender","hash_xxh64":"0xE627CF47089383FA","variant_status":"runtime_gender_keys_target_same","male":"But listen up and consider this my last bit of advice: the Crimson Highlands ain't short on surprises. Even if you're capable, you best keep your wits about you.","female":"But listen up and consider this my last bit of advice: the Crimson Highlands ain't short on surprises. Even if you're capable, you best keep your wits about you.","variant_male_record_index":"123514","variant_female_record_index":"123515","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111138005:0":{"text":"Don't worry, we'll be fine.","source_cn":"放心，我们搞得定。","status":"matched","hash_xxh64":"0x6076177C0A649AE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1111138006:1":{"text":"Still sounding smug, little one.","source_cn":"口气还是这么狂妄啊，小兄弟。","status":"matched","hash_xxh64":"0x3A93D5B02774E0E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111138007:0":{"text":"You should expect that by now.","source_cn":"你也不是第一天认识他了。","status":"matched","hash_xxh64":"0x7AFC523F9C021AC5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111138008:0":{"text":"Well, you've got a long road ahead. I won't hold you up any longer.","source_cn":"好吧，你们还有事要忙，我就不留你们了。","status":"matched_runtime_gender","hash_xxh64":"0x4BFA09CC17EE30F0","variant_status":"runtime_gender_keys_target_same","male":"Well, you've got a long road ahead. I won't hold you up any longer.","female":"Well, you've got a long road ahead. I won't hold you up any longer.","variant_male_record_index":"123519","variant_female_record_index":"123520","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1111138009:0":{"text":"Look me up when you get back from the Crimson Highlands. We'll find a spot and swap tales.","source_cn":"等你们从深红高原回来，我们找个地方聚一聚，我很乐意听你...","status":"matched_runtime_gender","hash_xxh64":"0x64DC1615A9C220DB","variant_status":"runtime_gender_keys_target_same","male":"Look me up when you get back from the Crimson Highlands. We'll find a spot and swap tales.","female":"Look me up when you get back from the Crimson Highlands. We'll find a spot and swap tales.","variant_male_record_index":"123521","variant_female_record_index":"123522","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1111138010:0":{"text":"Your treat?","source_cn":"你请客？","status":"matched","hash_xxh64":"0x440EC9CF07CC7D1B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111138011:0":{"text":"Of course! Do I look stingy to you?","source_cn":"当然！我像是那种小气的男人吗？","status":"matched","hash_xxh64":"0x73E6139E031CD931","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1111138012:0":{"text":"Speaking of which, since you all lent me a hand back there—","source_cn":"说起来，这次复仇还是你们帮了我一把。","status":"matched","hash_xxh64":"0x4CF05F25F833A9A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1111138013:0":{"text":"<style=\"stress\"><player_name></style>, hang onto this for me.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x3693FD6E0F818F70","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, hang onto this for me.","female":"<style=\"stress\"><player_name></style>, hang onto this for me.","variant_male_record_index":"123526","variant_female_record_index":"123527","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1111138013":{"text":"<style=\"stress\"><player_name></style>, hang onto this for me.","source_cn":"<style=stress><player_name></style>，你拿着这个，或许有点用。","status":"matched_runtime_gender","hash_xxh64":"0x3693FD6E0F818F70","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, hang onto this for me.","female":"<style=\"stress\"><player_name></style>, hang onto this for me.","variant_male_record_index":"123526","variant_female_record_index":"123527","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1111138014:0":{"text":"Don't need to be so polite. Consider it a token of appreciation.","source_cn":"客气什么，你应得的。","status":"matched_runtime_gender","hash_xxh64":"0x1C04B0BE3A49F0A0","variant_status":"runtime_gender_keys_target_same","male":"Don't need to be so polite. Consider it a token of appreciation.","female":"Don't need to be so polite. Consider it a token of appreciation.","variant_male_record_index":"123528","variant_female_record_index":"123529","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1111138016:0":{"text":"Well, that's all she wrote. Try not to miss me too much.","source_cn":"行啦，就在这里分别吧，你们可不要太想我。","status":"matched_runtime_gender","hash_xxh64":"0xBDAEADE81A72F170","variant_status":"runtime_gender_keys_target_same","male":"Well, that's all she wrote. Try not to miss me too much.","female":"Well, that's all she wrote. Try not to miss me too much.","variant_male_record_index":"123532","variant_female_record_index":"123533","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1111138017:1":{"text":"So much talk. If you're going, go.","source_cn":"话真多，要走就走。","status":"matched","hash_xxh64":"0xF5821D9FD411B6F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1111138018:1":{"text":"Ha! Better mind that tongue!","source_cn":"哈哈哈哈，不愧是你！","status":"matched","hash_xxh64":"0x7C9BC65D4814DF36","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1111138019:1":{"text":"So long, everyone!","source_cn":"各位，再见了！","status":"matched","hash_xxh64":"0x384F6B9CFB2E2DB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1111138020:0":{"text":"...Goodbye, my friend.","source_cn":"……再见。","status":"matched","hash_xxh64":"0xA90552F8015A2BC4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1111138021:1":{"text":"Now that he's gone, who's going to banter with Soren now?","source_cn":"哎呀……大叔走了，都没人跟索恩抬杠了。","status":"matched","hash_xxh64":"0xE2B7EB17261C1BFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:26:1111138021":{"text":"Now that he's gone, who's going to banter with Soren now?","source_cn":"哎呀……大叔走了，都没人跟索恩抬杠了。","status":"matched","hash_xxh64":"0xE2B7EB17261C1BFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1111138022:1":{"text":"That's right! I think we'll have plenty of fun!","source_cn":"说得对！我想，这一路依旧会很热闹的。","status":"matched","hash_xxh64":"0x74A2D1656185CB80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:0:1":{"text":"But you're still here, yes?","source_cn":"这不是还有你吗？","status":"matched_runtime_gender","hash_xxh64":"0x63A18F1031049B97","variant_status":"runtime_gender_keys_target_same","male":"But you're still here, yes?","female":"But you're still here, yes?","variant_male_record_index":"63952","variant_female_record_index":"63953","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"Thank you very much.","source_cn":"谢谢","status":"matched_runtime_gender","hash_xxh64":"0x0CBD5AFCD8099572","variant_status":"runtime_gender_keys_target_same","male":"Thank you very much.","female":"Thank you very much.","variant_male_record_index":"63948","variant_female_record_index":"63949","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1111138015:0":{"text":"It's a dime a dozen for the locals. Take it as a keepsake.","source_cn":"这东西对本地人而言太常见了，还是你留着做个纪念吧。","status":"matched_runtime_gender","hash_xxh64":"0x9A42CC36663BE7A1","variant_status":"runtime_gender_keys_target_same","male":"It's a dime a dozen for the locals. Take it as a keepsake.","female":"It's a dime a dozen for the locals. Take it as a keepsake.","variant_male_record_index":"123530","variant_female_record_index":"123531","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"Really? Is this for me?","source_cn":"只给我一个人？","status":"matched_runtime_gender","hash_xxh64":"0xED2E1670A3E4E7C4","variant_status":"runtime_gender_keys_target_same","male":"Really? Is this for me?","female":"Really? Is this for me?","variant_male_record_index":"63950","variant_female_record_index":"63951","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:瓦尔克":{"text":"Walker","source":"瓦尔克","status":"matched_dialogue_flow"},"speaker:萨忒娜":{"text":"Satrana","source":"萨忒娜","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":28,"localized_text_count":27,"speaker_count":4}}