{"asset_key":"ep1/quest_story_11110060","episode":"ep1","category":"quest_story","story_id":"11110060","schema_version":1,"lang":"en","texts":{"say:3:1111006001:0":{"text":"Phew! Karma will get those Quicksand Claws one day!","source_cn":"啐！这群该死的流沙之爪，早晚会遭报应！","status":"matched","hash_xxh64":"0x6281B82C47D55A4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111006002:0":{"text":"That's right, karma's sent us to dish out their punishment.","source_cn":"说对了，我们就是流沙之爪的报应。","status":"matched","hash_xxh64":"0x3DD7C4C44FE12323","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111006003:0":{"text":"How did you get captured?","source_cn":"你是怎么被抓的？","status":"matched","hash_xxh64":"0xCE32D41000C55209","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111006004:0":{"text":"...I left Alkali with a caravan. Our guide lost his bearings when we got caught in a big sandstorm and took the wrong way at a fork...","source_cn":"……我跟着商队离开咸水镇，结果路上遇到一场大沙暴。向导...","status":"matched","hash_xxh64":"0xC22F212EE1A8D060","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111006005:0":{"text":"The group broke apart, with some leaving and some others missing. I stumbled upon this camp hoping for shelter from the storm, and the next thing I know...","source_cn":"商队的人走的走、散的散，我发现这处营地，想借个地方避避...","status":"matched","hash_xxh64":"0x23E1875B2C447BAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1111006006:0":{"text":"You basically walked right into the Quicksand Claws.","source_cn":"正中流沙之爪下怀。","status":"matched","hash_xxh64":"0x825F489962235643","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111006007:0":{"text":"You're free to go.","source_cn":"你走吧。","status":"matched","hash_xxh64":"0xDDCD395CC9C254D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111006008:0":{"text":"Thank you! And please, if you come across any others from the caravan, help them too...","source_cn":"谢、谢谢！要是你们在路上遇到商队的其他人，也请帮帮他们……","status":"matched","hash_xxh64":"0x7FA0E90CB5EACD10","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:旅商乔瓦尼":{"text":"Trader Johnny","source":"旅商乔瓦尼","status":"matched_dialogue_flow"},"speaker:瓦尔克":{"text":"Walker","source":"瓦尔克","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":3}}