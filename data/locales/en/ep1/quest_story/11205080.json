_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:19:1120508012":{"text":"Well... who would have thought? You stumbled upon Alkali by sheer luck, even with the map flipped!","source_cn":"我看看……唔，确实是拿颠倒了。倒着看地图也能走到咸水镇，真是奇迹呀！","status":"matched","hash_xxh64":"0x4EF26DFF8A0F8D5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1120508013:1":{"text":"Hides! I need lots and lots of hides, and jars too! I need to bring these back to the clan, everyone's been waiting for them!","source_cn":"毛皮！很多很多毛皮，还有陶罐！更多陶罐！要给部落，大家...","status":"matched","hash_xxh64":"0x8355D7DCCF6AAE21","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1120508014:1":{"text":"Many people are injured! Hunting's off the table!","source_cn":"很多人，受伤了！没办法捕猎。","status":"matched","hash_xxh64":"0x29F08E31760EFA7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1120508015:1":{"text":"So, I'm here because Satrana told me to buy things! I can't let her and Antandra down!","source_cn":"所以，萨忒娜告诉我来买东西！我不能让她和安丹姐失望！","status":"matched","hash_xxh64":"0xA2F0899C54C5EE20","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1120508016:1":{"text":"*Roar*","source_cn":"吼——！","status":"matched","hash_xxh64":"0x3CD4E6534C7DB2ED","variant_status":"","male":"","femal