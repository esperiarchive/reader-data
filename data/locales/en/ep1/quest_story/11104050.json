{"asset_key":"ep1/quest_story_11104050","episode":"ep1","category":"quest_story","story_id":"11104050","schema_version":1,"lang":"en","texts":{"say:1:1110405001:0":{"text":"Who are you? Where do you come from, and where are you headed?","source_cn":"站住。你们是谁？哪儿来的？要去哪儿？","status":"matched","hash_xxh64":"0x5636648B508421D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1110405001":{"text":"Who are you? Where do you come from, and where are you headed?","source_cn":"站住。你们是谁？哪儿来的？要去哪儿？","status":"matched","hash_xxh64":"0x5636648B508421D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110405002:0":{"text":"Sunseek Arena? It's nearly time for the Warsong Festival. Are you competitors this year?","source_cn":"残阳武斗场？战歌节要开始了，你们难道是参赛的勇士？","status":"matched","hash_xxh64":"0x4E185F591B089E75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1110405003:0":{"text":"Yes, we're taking part in this year's Warsong Festival.","source_cn":"……是的，我们是战歌节的参赛者。","status":"matched","hash_xxh64":"0x8D19923E1C0070D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1110405006:1":{"text":"Interesting. But word has it you two still have challenges to complete?","source_cn":"我怎么听说你们还在试炼，没有获得承认呢？","status":"matched","hash_xxh64":"0xB7B6A258FEF1E030","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110405007:0":{"text":"And we will.","source_cn":"我们一定会获得参赛资格。","status":"matched","hash_xxh64":"0x06027A3879962C9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1110405008:0":{"text":"That's very bold of you! Wait a second. You look familiar... You remind me of that worthless Mauler we cast out...","source_cn":"好大的口气！不过，你小子好像有点眼熟。和我们族内被抛弃...","status":"matched","hash_xxh64":"0xACB377441FE585E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1110405009:0":{"text":"That's right! The weakling born with barely any fur...","source_cn":"没错，生下来光秃秃的，浑身没几根熊毛——","status":"matched","hash_xxh64":"0x71ED44C655DC83C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1110405010:0":{"text":"You...","source_cn":"你——","status":"matched","hash_xxh64":"0x3870CC3BBD1E5162","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1110405011:0":{"text":"Soren, calm yourself!","source_cn":"索恩，冷静！","status":"matched","hash_xxh64":"0xFC0F7DB7ADC0B84F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1110405012:1":{"text":"We're not here to reminisce. Just passing through.","source_cn":"……呼，你们没必要跟我叙旧。我们只想借个路，仅此而已。","status":"matched","hash_xxh64":"0xFE77AE91E61BEE3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1110405013:0":{"text":"Not happening. That weakling's grown into a little fibber. Claiming to be participants in this year's Warsong Festival?","source_cn":"不，不行。你不老实。生下来就是弱者，长到现在块头也不大...","status":"matched","hash_xxh64":"0xFA658ADEBD0552A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1110405014:0":{"text":"Yeah, a suspicious character like you needs a thorough interrogation. Come with us!","source_cn":"没错，对撒谎的可疑人士，必须带走好好盘查。跟我们走！","status":"matched","hash_xxh64":"0x9477BEED2B82B8C9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1110405015:0":{"text":"Enough nonsense. You know I'm speaking the truth. Why else would your rude buddies harass our clan?","source_cn":"别开玩笑了，你们明明什么都知道！不然，怎么会派人去骚扰...","status":"matched","hash_xxh64":"0x7623D415AD937179","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1110405016:0":{"text":"You'll need a better excuse to hold us here. Do you think we're afraid of you?","source_cn":"现在竟然想用这种差劲借口扣下我们——是觉得我们会怕吗？","status":"matched","hash_xxh64":"0x285ADB5E0002F888","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1110405017:0":{"text":"Soren, calm down! We don't want to fight them on their territory!","source_cn":"索恩，别冲动！这里是他们的领地，我们不能轻举妄动！","status":"matched","hash_xxh64":"0x2582AE0813C75735","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1110405018:0":{"text":"We can't afford to miss the trial! Remember your promise to Pops?","source_cn":"现在把事情闹大，我们可能会错过试炼的！想想和老爹的约定吧！","status":"matched","hash_xxh64":"0x740ED34D4DA0AB41","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1110405019:0":{"text":"...You're right, Alsa.","source_cn":"……我明白了，阿尔萨。","status":"matched","hash_xxh64":"0xA58968B56CC47DB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1110405020:0":{"text":"Good pups! Time to pay a visit to our main camp.","source_cn":"乖乖得多好啊，省了我们多少事！走，带这些人去主营！","status":"matched","hash_xxh64":"0x8E1E220112FA72B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"We're from the Sunseek Arena.","source_cn":"残阳武斗场来的","status":"matched_runtime_gender","hash_xxh64":"0xD0801229DD2D2AAD","variant_status":"runtime_gender_keys_target_same","male":"We're from the Sunseek Arena.","female":"We're from the Sunseek Arena.","variant_male_record_index":"63674","variant_female_record_index":"63675","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1110405004:0":{"text":"Mars Peak? That's reserved for Warsong Festival warriors only.","source_cn":"战神峰？除了战歌节的勇士们，没人能去战神峰。","status":"matched_runtime_gender","hash_xxh64":"0x3628F86751EAE578","variant_status":"runtime_gender_keys_target_same","male":"Mars Peak? That's reserved for Warsong Festival warriors only.","female":"Mars Peak? That's reserved for Warsong Festival warriors only.","variant_male_record_index":"122487","variant_female_record_index":"122488","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1110405005:0":{"text":"Alsa and I are competing in the Warsong Festival.","source_cn":"……就像你说的，我和阿尔萨是战歌节的参赛者。","status":"matched","hash_xxh64":"0xD0583C35BC373446","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:1:2":{"text":"We need to head to Mars Peak.","source_cn":"要去战神峰山脚","status":"matched_runtime_gender","hash_xxh64":"0xAA85AD8041E784A9","variant_status":"runtime_gender_keys_target_same","male":"We need to head to Mars Peak.","female":"We need to head to Mars Peak.","variant_male_record_index":"63676","variant_female_record_index":"63677","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:蛮横的黑嚎守卫":{"text":"Grimmaw Guard","source":"蛮横的黑嚎守卫","status":"matched_dialogue_flow"},"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"},"speaker:挑衅的黑嚎守卫":{"text":"Grimmaw Guard","source":"挑衅的黑嚎守卫","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":24,"localized_text_count":23,"speaker_count":4}}