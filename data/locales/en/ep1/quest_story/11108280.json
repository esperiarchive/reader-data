{"asset_key":"ep1/quest_story_11108280","episode":"ep1","category":"quest_story","story_id":"11108280","schema_version":1,"lang":"en","texts":{"say:2:1110828001:1":{"text":"So, what are your plans?","source_cn":"你们接下来有什么计划？","status":"matched","hash_xxh64":"0xD64A45C3E37A0637","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1110828002:1":{"text":"Keep looking.","source_cn":"继续，找人。","status":"matched","hash_xxh64":"0x7B2383D20D64CA0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1110828003:1":{"text":"Uh-huh, how?","source_cn":"嗯哼。你们准备怎么找？","status":"matched","hash_xxh64":"0x652F2E5A6C45351E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1110828003":{"text":"Uh-huh, how?","source_cn":"嗯哼。你们准备怎么找？","status":"matched","hash_xxh64":"0x652F2E5A6C45351E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1110828004:1":{"text":"Huh? Soren's rubbing off on you too?","source_cn":"哈，索恩小哥的直脑筋也影响你了？","status":"matched","hash_xxh64":"0x33B81031F7D05C47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1110828006:1":{"text":"I'm not one to stick m