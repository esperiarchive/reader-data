{"asset_key":"ep1/quest_story_11206380","episode":"ep1","category":"quest_story","story_id":"11206380","schema_version":1,"lang":"en","texts":{"say:0:1120638001:0":{"text":"Chippy knows we're supposed to offer fresh flowers at a grave, but where do you find flowers in a desert?","source_cn":"按照常理，该在墓前献上鲜花的，可这样的砂地，不会有鲜花……","status":"matched","hash_xxh64":"0x0A8B8F0611D31FBD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1120638002:0":{"text":"Maybe a desert plant will do? Like a blazing orchid!","source_cn":"或许，当地的植物也可以吧，比如炽焰兰。","status":"matched","hash_xxh64":"0x22908790386EAC60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1120638003:0":{"text":"A flower as beautiful as the desert sunset... I'm sure your father would like that.","source_cn":"和落日一样美丽的炽焰兰，他们的父亲也会喜欢的吧……","status":"matched","hash_xxh64":"0x79482C505EECB5B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}