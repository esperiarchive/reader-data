{"asset_key":"ep1/quest_story_11110080","episode":"ep1","category":"quest_story","story_id":"11110080","schema_version":1,"lang":"en","texts":{"say:3:1111008001:1":{"text":"Nope, dead end. Definitely not Ferranc's hideout.","source_cn":"好吧，这里没什么线索，而且一看就不是弗兰克所在的大本营。","status":"matched","hash_xxh64":"0xD6982904748F0BDC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1111008002:1":{"text":"How did the prophecy go? Crimson rocky land...","source_cn":"预言是怎么说来着？红色的岩地……","status":"matched","hash_xxh64":"0x67BC32ED2CECDD7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1111008003:1":{"text":"Ahem. Let me describe again what I saw in my vision: You must traverse a valley and some crimson-rocky land. The man you're looking for is hidden deep in there.","source_cn":"咳嗯，我再描述一下预言中的情景：要穿过一片山谷和赭红色...","status":"matched","hash_xxh64":"0x1B3DE397A65FABB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1111008004:1":{"text":"This must be the wrong place, then.","source_cn":"那就不在这附近。","status":"matched","hash_xxh64":"0x5A29737D7C661B89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1111008005:1":{"text":"This is the right way. We've already run into a bunch of Quicksand Claws. My prophecies are never wrong.","source_cn":"但遇到了流沙之爪，说明方向没走错。我的预言果然十分准确！","status":"matched","hash_xxh64":"0x8F4C3439C079848E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1111008005":{"text":"This is the right way. We've already run into a bunch of Quicksand Claws. My prophecies are never wrong.","source_cn":"但遇到了流沙之爪，说明方向没走错。我的预言果然十分准确！","status":"matched","hash_xxh64":"0x8F4C3439C079848E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1111008006:1":{"text":"As I said, it's your fortune to have me!","source_cn":"我就说，有我和你们同路，是你们的好运！","status":"matched","hash_xxh64":"0x63AB9FB51DC77C2F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1111008008:1":{"text":"Hmm... We're quite close to the <style=\"highlight\">Sandar Wayrest</style>.","source_cn":"嗯……这附近离<style=highlight>飞莎驿...","status":"matched","hash_xxh64":"0xF06CC2779AAC923C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1111008009:1":{"text":"Let's get some rest. If the gold I forked out earlier landed in the right pocket, there might be some intel waiting for us.","source_cn":"先去那里歇歇脚，如果我之前付出的金币落进了正确的口袋，...","status":"matched","hash_xxh64":"0x6DE984CA39D36804","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"You're amazing.","source_cn":"是，你好厉害！","status":"matched_runtime_gender","hash_xxh64":"0xA5C219C1B68CD059","variant_status":"runtime_gender_keys_target_same","male":"You're amazing.","female":"You're amazing.","variant_male_record_index":"63878","variant_female_record_index":"63879","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1111008007:1":{"text":"You must have faith in fate, or you will be doomed to misfortune!","source_cn":"不能不相信命运哦，不然会遭厄运反噬的！","status":"matched","hash_xxh64":"0x28A6CDB91F3AD76A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"You could be more modest...","source_cn":"狐狸尾巴都翘到天上去了……","status":"matched_runtime_gender","hash_xxh64":"0x3A8F589A2F42010F","variant_status":"runtime_gender_keys_target_same","male":"You could be more modest...","female":"You could be more modest...","variant_male_record_index":"63880","variant_female_record_index":"63881","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:2:3":{"text":"Whatever...","source_cn":"勉勉强强吧","status":"matched_runtime_gender","hash_xxh64":"0x2D73B933CEFCC008","variant_status":"runtime_gender_keys_target_same","male":"Whatever...","female":"Whatever...","variant_male_record_index":"63882","variant_female_record_index":"63883","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:瓦尔克":{"text":"Walker","source":"瓦尔克","status":"matched_dialogue_flow"},"speaker:萨忒娜":{"text":"Satrana","source":"萨忒娜","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14,"localized_text_count":13,"speaker_count":3}}