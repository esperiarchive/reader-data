{"asset_key":"ep1/quest_story_11203190","episode":"ep1","category":"quest_story","story_id":"11203190","schema_version":1,"lang":"en","texts":{"say:3:1120319001:0":{"text":"*Cough* Soren... and Magister... You're all back!","source_cn":"咳，咳咳……索恩哥哥，还有魔法师大人……你们回来啦！","status":"matched_runtime_gender","hash_xxh64":"0x944A830456D3EFCD","variant_status":"runtime_gender_keys_target_same","male":"*Cough* Soren... and Magister... You're all back!","female":"*Cough* Soren... and Magister... You're all back!","variant_male_record_index":"124679","variant_female_record_index":"124680","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120319002:0":{"text":"Huh...? Who's that... erratic meerkat?","source_cn":"诶，怎么还多了一只……奇怪的狐獴？","status":"matched","hash_xxh64":"0xBBB07E581D06E5B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1120319003:1":{"text":"I am not any \"erratic meerkat\", little one. My name is Smokey who is a genius apothecary. I'm here to help you.","source_cn":"小蛮血，我可不是什么奇怪的狐獴。我是专门来帮你的天才药...","status":"matched","hash_xxh64":"0x25A9C28C0D862AB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120319004:0":{"text":"Apothecary...?","source_cn":"药剂师……？","status":"matched","hash_xxh64":"0xB92F779FBFFA824D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120319005:1":{"text":"He's telling the truth, Karun. Here, take this potion.","source_cn":"他说的没错。我们弄到药了，你快把这个喝下去试试。","status":"matched","hash_xxh64":"0x9A347621D70A923C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120319006:0":{"text":"Ugh... This smells awful...","source_cn":"呜……这个味道好难闻……","status":"matched","hash_xxh64":"0xC91FB677A3647E8F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120319007:1":{"text":"Trust me, you'll feel much better after you take it.","source_cn":"乖，相信我，只要喝下这个，你就能好起来了！","status":"matched","hash_xxh64":"0xF5212A0ABAAAEDBE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1120319008:0":{"text":"*Cough* O-Okay...! Gulp...","source_cn":"咳……好！我听阿尔萨姐姐的话……唔……","status":"matched","hash_xxh64":"0xD35AAF73A8D755B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1120319009:0":{"text":"This potion... tastes even worse than the last medicine you gave me.","source_cn":"这个药剂……好难喝，比之前的还要难喝，有种怪怪的味道……","status":"matched","hash_xxh64":"0xA505F53DE79D8139","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1120319010:0":{"text":"How do you feel now? Any better?","source_cn":"你现在感觉怎么样？有哪里不舒服吗？","status":"matched","hash_xxh64":"0xE5296867192FFBF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1120319011:0":{"text":"I... don't feel any different?","source_cn":"好像……没什么感觉？","status":"matched","hash_xxh64":"0xA1B0DE8DB40EC4F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1120319012:1":{"text":"Rest assured, the medicine will take effect in just a few minutes. Smokey's potions always work!","source_cn":"安心安心，这药剂起效还是需要一点时间的。阿熏出品，绝对精品！","status":"matched","hash_xxh64":"0x5BA6A6AB29D9E1C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:15:1120319013:0":{"text":"A short while later...","source_cn":"一段时间后……","status":"matched","hash_xxh64":"0x9FE836DB92391A38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:小蛮血卡鲁恩":{"text":"Karun","source":"小蛮血卡鲁恩","status":"matched_dialogue_flow"},"speaker:阿熏":{"text":"Smokey","source":"阿熏","status":"matched_dialogue_flow"},"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14,"localized_text_count":13,"speaker_count":3}}