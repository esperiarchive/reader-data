{"asset_key":"ep1/quest_story_11206220","episode":"ep1","category":"quest_story","story_id":"11206220","schema_version":1,"lang":"en","texts":{"say:3:1120622001:1":{"text":"Ugh... My head...","source_cn":"唔……头好痛。","status":"matched","hash_xxh64":"0x9E27276165FFC2AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1120622002:1":{"text":"Did you folks save me just now? Thanks...","source_cn":"是你们救了我吗，谢谢你们……","status":"matched","hash_xxh64":"0x99ACE0195E2582E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1120622002":{"text":"Did you folks save me just now? Thanks...","source_cn":"是你们救了我吗，谢谢你们……","status":"matched","hash_xxh64":"0x99ACE0195E2582E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1120622003:1":{"text":"I heard there was plenty of money to be made out here, so I came to stay with some friends to find work. The name's Chezzig, by the way.","source_cn":"我……我叫切西格，听说在这里无论做什么都很赚钱，就从家...","status":"matched","hash_xxh64":"0xEB7F278896489B26","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1120622004:1":{"text":"Damn those bandits! They jumped me before I had taken two steps out of Alkali!","source_cn":"可那群天杀的劫匪！出了咸水镇没多久，我就被他们给劫啦！","status":"matched","hash_xxh64":"0x8480DB8165C8C787","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1120622005:1":{"text":"They took my valuables before knocking me out and leaving me here to die!","source_cn":"他们抢了我的财物，还把我打晕，丢在这里自生自灭！","status":"matched","hash_xxh64":"0x5BD0DA225D9440DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1120622006:1":{"text":"Bandits again?! I remember people saying that Alkali's supposed to be a simple, peaceful town...","source_cn":"又是匪徒！唉，我记得还有人说咸水镇是个民风淳朴的地方呢……","status":"matched","hash_xxh64":"0x32819C4F7E826179","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1120622007:1":{"text":"I'm supposed to meet my friends up ahead, but now that I'm broke, bruised, and on the brink of starvation...","source_cn":"我和朋友本来约好在前面碰面，可现在我身无分文，浑身又疼...","status":"matched","hash_xxh64":"0xBAE1DF2941FF1554","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1120622008:1":{"text":"You shouldn't be traveling if you're hurt. You need to find a safe place to rest.","source_cn":"你受了伤，最好不要急着赶路，我们找个地方先休息一下吧。","status":"matched","hash_xxh64":"0x1111005A4DF8F817","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1120622009:1":{"text":"There should be a safe place just up the road, but there's no food or water out here. I'd do anything for a cup of blazing orchid right now...","source_cn":"前面不远应该有可以休息的地方。可惜啊，这地方太荒芜了，...","status":"matched","hash_xxh64":"0x145B47F4D8118233","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1120622010:0":{"text":"You ran into bandits out here, huh...?","source_cn":"路上遇到匪徒了吗……","status":"matched","hash_xxh64":"0xDF10BC8BAC4A0771","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"Why were you lying on the ground?","source_cn":"你怎么晕倒了？","status":"matched_runtime_gender","hash_xxh64":"0xF8192DDDEFE0C856","variant_status":"runtime_gender_keys_target_same","male":"Why were you lying on the ground?","female":"Why were you lying on the ground?","variant_male_record_index":"63958","variant_female_record_index":"63959","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:1:2":{"text":"What happened to you?","source_cn":"发生什么事情了？","status":"matched_runtime_gender","hash_xxh64":"0xA1081AF44A79C7C5","variant_status":"runtime_gender_keys_target_same","male":"What happened to you?","female":"What happened to you?","variant_male_record_index":"63960","variant_female_record_index":"63961","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:切西格":{"text":"Chezzig","source":"切西格","status":"matched_dialogue_flow"},"speaker:宝藏猎人艾文":{"text":"Hunter Evan","source":"宝藏猎人艾文","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:宝藏猎人欧迪尔":{"text":"Hunter Oldiler","source":"宝藏猎人欧迪尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14,"localized_text_count":13,"speaker_count":4}}