{"asset_key":"ep8/env_story_18304130","episode":"ep8","category":"env_story","story_id":"18304130","schema_version":1,"lang":"en","texts":{"say:2:1830413001:1":{"text":"You know the story! Carve the name of someone you hate into a stone, throw it into Mistbane Lake, and that person will be cursed.","source_cn":"就是那个，雾咒湖的诅咒传说啊！传说只要将所恨之人的名字...","status":"matched","hash_xxh64":"0x04BF64DB78F86DC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1830413002:0":{"text":"That's a story for frightening children. Aren't you a little old to believe it?","source_cn":"那都是骗小孩的把戏，你都多大了，还信这个？","status":"matched","hash_xxh64":"0x86BB92BBE8B7C697","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1830413003:1":{"text":"I didn't believe it either! That's why I carved my own name into a stone and threw it in...","source_cn":"不是啊！我真的遇到了！我之前也不信邪，就在石头上刻上了...","status":"matched","hash_xxh64":"0x96225691568F6118","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1830413004:1":{"text":"Last night, something kept tapping on my window. But when I went outside, no one was there—not even a ghost!","source_cn":"结果昨晚我就听到自己的窗户一直被什么东西拍！出去看又没有鬼！","status":"matched","hash_xxh64":"0xAA41231B4342AA74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1830413005:1":{"text":"Tell me that isn't terrifying! I must be cursed!","source_cn":"这很恐怖不是吗？我一定是被诅咒了！","status":"matched","hash_xxh64":"0xC311FF2B6C95284A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1830413006:1":{"text":"Darko, grow up!","source_cn":"暗迪，你太幼稚了！","status":"matched","hash_xxh64":"0x4150CE74B4201C26","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1830413007:1":{"text":"But it's true! I swear!","source_cn":"我说的都是真的啊！真的！","status":"matched","hash_xxh64":"0x8FB107B48D30E285","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:暗迪":{"text":"Darko","source":"暗迪","status":"matched_dialogue_flow"},"speaker:普里西拉":{"text":"Priscilla","source":"普里西拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}}