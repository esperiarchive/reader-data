{"asset_key":"ep8/quest_story_18104400","episode":"ep8","category":"quest_story","story_id":"18104400","schema_version":1,"lang":"en","texts":{"say:2:1810440001:0":{"text":"Don't play dead on me, Radu! What's the situation?","source_cn":"别装死，垃杜。汇报情况！","status":"matched","hash_xxh64":"0x9B09A1E82E1C96BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1810440002:0":{"text":"Krrk... Intruders... detected...","source_cn":"喀喀……有入侵……入侵者……","status":"matched","hash_xxh64":"0x51617514F0ACEF10","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1810440003:1":{"text":"I failed... to stop them...","source_cn":"没有……没有拦住……","status":"matched","hash_xxh64":"0xBD93A2E77999AD83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1810440004:0":{"text":"<shk>Useless!!!</shk>\nKing Thoran granted you a second chance at life. Is this how you repay His Majesty?","source_cn":"<shk>——废物！</shk>\\n陛下赐予你重生的机...","status":"matched","hash_xxh64":"0x86188490A84086B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1810440005:0":{"text":"Who were the intruders? Lightbearer spies? Some rebellious Graveborn? Or agents of that turncoat Tephesia?","source_cn":"袭击炼化间的是什么人？是耀光探子、不服管教的亡灵，还是...","status":"matched","hash_xxh64":"0xB8936D639625497E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1810440006:0":{"text":"<style=\"highlight\">One... Lightbearer... and one Graveborn...</style>","source_cn":"<style=highlight>有一个……耀光人……...","status":"matched","hash_xxh64":"0x18BF8BC99B1D7EE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1810440007:0":{"text":"Not sure... about their relationship... with Tephesia...","source_cn":"和苔佩希的关系……不知道……","status":"matched","hash_xxh64":"0xFDC1C3357AF10B11","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1810440008:0":{"text":"Novaris is her territory! There's no way she isn't involved!","source_cn":"诺珐斯是她的地盘，怎么可能和她没关系！","status":"matched","hash_xxh64":"0x1B1E3C750467E2AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1810440009:0":{"text":"People like her, who know nothing of Bantus' history, can never be fully trusted... I won't let her jeopardize our efforts to reclaim our ancestral lands!","source_cn":"非帝国正统出身的家伙，其心必异……班题斯的复国大业绝不...","status":"matched","hash_xxh64":"0x9A8C1024AD77D7D8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1810440010:0":{"text":"Continue your watch here. I'll send someone to stitch up your wounds. If stronger limbs are available, I'll have them attached to your body as well.","source_cn":"你——继续看守炼化间。我会派人给你缝合伤口，如果有更牢...","status":"matched","hash_xxh64":"0xDC6D46A6CCF35BBD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1810440011:0":{"text":"Let me be clear—this is not a favor for you. You're receiving these repairs only because <style=\"highlight\">the Refinery is extremely important to His Majesty</style>, and I cannot allow anything to go wrong here.","source_cn":"但你记住：这不是给你的恩赐，只是因为<style=hi...","status":"matched","hash_xxh64":"0x9D7DDA6E99EEF937","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1810440012:0":{"text":"One more blunder, I'll drag you to the execution grounds myself and condemn your soul to eternal torment.","source_cn":"要是再有一次疏忽，用不着陛下发话，我就会把你拖到刑场，...","status":"matched","hash_xxh64":"0x7C5ED869045187D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1810440013:0":{"text":"Y-Yes...","source_cn":"是……是……","status":"matched","hash_xxh64":"0x08A34A0EBB678178","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:格瑞泽尔勒":{"text":"Grezhul","source":"格瑞泽尔勒","status":"matched_dialogue_flow"},"speaker:守亡塔·垃杜":{"text":"Radu","source":"守亡塔·垃杜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":14,"localized_text_count":13,"speaker_count":2}}