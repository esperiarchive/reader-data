{"asset_key":"ep8/quest_story_18107060","episode":"ep8","category":"quest_story","story_id":"18107060","schema_version":1,"lang":"en","texts":{"say:2:1810706001:0":{"text":"It was you all along.","source_cn":"你……你才是破坏炼化间的人……","status":"matched","hash_xxh64":"0x2BAEF584A9C6C1F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1810706002:1":{"text":"... Tephesia lied to us.","source_cn":"……苔佩希，骗了我们。","status":"matched","hash_xxh64":"0xC02082673AFE4229","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1810706003:1":{"text":"What? Isn't the Syndicate working with Bantus?!","source_cn":"什么？苔佩希——还有黑金，不是和你们班题斯一伙吗？！","status":"matched","hash_xxh64":"0x7FD95EBE68795707","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1810706004:1":{"text":"There were two culprits who sabotaged the Refinery. One living, and one Graveborn.","source_cn":"破坏炼化间的人，一个生者，一个亡灵……","status":"matched","hash_xxh64":"0x58E9F6BAD4B3F0A5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1810706005:1":{"text":"Tephesia said it was the owner of the Repair House and her apprentice.","source_cn":"苔佩希说，是修缮屋的医师和她的员工。","status":"matched","hash_xxh64":"0x36051E97E6970BED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1810706005":{"text":"Tephesia said it was the owner of the Repair House and her apprentice.","source_cn":"苔佩希说，是修缮屋的医师和她的员工。","status":"matched","hash_xxh64":"0x36051E97E6970BED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1810706006:1":{"text":"... She did it on purpose.","source_cn":"……她是故意的。<key:dialog1>","status":"matched","hash_xxh64":"0xC2104B77FE66A51D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1810706009:0":{"text":"Sil... Silvina... Stop them...","source_cn":"西……西尔维娜……阻止他们……","status":"matched","hash_xxh64":"0x7D208F7058271D45","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1810706010:0":{"text":"Shut it, you heap of scrap metal. Your friend is already at her limit.","source_cn":"闭嘴吧，你这堆废铁。你的同伴已经力竭了。","status":"matched","hash_xxh64":"0x57E61173E551D30C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1810706011:1":{"text":"...","source_cn":"………………","status":"matched","hash_xxh64":"0x197F0BE8A09E0D34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female