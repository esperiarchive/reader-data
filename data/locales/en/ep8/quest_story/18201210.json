{"asset_key":"ep8/quest_story_18201210","episode":"ep8","category":"quest_story","story_id":"18201210","schema_version":1,"lang":"en","texts":{"say:2:1820121001:1":{"text":"Looking for a potion? A fresh shipment just came in today!","source_cn":"客人，要不要来点药水？今天刚到的货，可新鲜了！","status":"matched","hash_xxh64":"0xCF97D5F6CEEFA1B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1820121002:1":{"text":"Give me ten!","source_cn":"给我来十瓶！","status":"matched","hash_xxh64":"0xBB18F12B144A60F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1820121003:1":{"text":"No problem, here you go!","source_cn":"好嘞，这就给您包起来！","status":"matched","hash_xxh64":"0x88581B98FD8F8850","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1820121004:0":{"text":"Aunt Sabrine, what kind of potions are these? They seem to be flying off the shelves!","source_cn":"姨妈，这里卖的是什么药水啊，生意这么好？","status":"matched","hash_xxh64":"0x2EC17C37CC318F8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1820121005:1":{"text":"It's a potion that keeps our skin looking flawless.","source_cn":"是一种能保持皮肤肤色的药水。","status":"matched","hash_xxh64":"0x4E16C926387E72EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1820121006:1":{"text":"Even though we Graveborn won't die, our bodies still wear down over time.","source_cn":"变成亡灵后，我们虽然不会再次死亡，但躯体仍然会随着时间...","status":"matched","hash_xxh64":"0x45C0931E0B8E8A37","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1820121007:1":{"text":"The potion helps us look a little less dead.","source_cn":"每天涂抹这种药水，能让自己看起来不那么像一具尸体。","status":"matched","hash_xxh64":"0xA8C3DAFFFA2F67B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1820121008:1":{"text":"Tsk... I thought I could finally stop buying skincare products for good...","source_cn":"唉，当时我刚知道亡灵不会长大时，还以为不用再花钱护肤品...","status":"matched","hash_xxh64":"0x4D70A49DB89660AD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:摊主伊西多":{"text":"Owner Esdor","source":"摊主伊西多","status":"matched_dialogue_flow"},"speaker:豪爽的顾客":{"text":"Big Spender","source":"豪爽的顾客","status":"matched_dialogue_flow"},"speaker:薇薇娅":{"text":"Vivi","source":"薇薇娅","status":"matched_dialogue_flow"},"speaker:莎柏琳":{"text":"Sabrine","source":"莎柏琳","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":4}}