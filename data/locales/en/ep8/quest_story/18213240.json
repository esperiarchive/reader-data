{"asset_key":"ep8/quest_story_18213240","episode":"ep8","category":"quest_story","story_id":"18213240","schema_version":1,"lang":"en","texts":{"say:1:1821324001:0":{"text":"It's so nice to see you again, Senea! Wow, you brought \"Rande\" with you this time!","source_cn":"你来啦，塞涅小姐——咦，这次竟然是和“兰利”一起！","status":"matched","hash_xxh64":"0x854AE1196E17688B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1821324002:0":{"text":"I love your performance, \"Rande\"!","source_cn":"你好，“兰利”<male>先生</male><fema...","status":"matched_runtime_gender","hash_xxh64":"0x922967A6C8087469","variant_status":"runtime_gender_keys_target_same","male":"I love your performance, \"Rande\"!","female":"I love your performance, \"Rande\"!","variant_male_record_index":"247649","variant_female_record_index":"247650","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1821324002":{"text":"I love your performance, \"Rande\"!","source_cn":"你好，“兰利”<male>先生</male><female>小姐</female>！你的表演很不错呢！","status":"matched_runtime_gender","hash_xxh64":"0x922967A6C8087469","variant_status":"runtime_gender_keys_target_same","male":"I love your performance, \"Rande\"!","female":"I love your performance, \"Rande\"!","variant_male_record_index":"247649","variant_female_record_index":"247650","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1821324003:1":{"text":"We all went to see Lost Voice's premiere! Senea made sure we all had tickets!","source_cn":"当然啦，塞涅特地给我们留了她忌辰纪念演出的门票呢！","status":"matched_runtime_gender","hash_xxh64":"0x0EE38F70E30BF71E","variant_status":"runtime_gender_keys_target_same","male":"We all went to see Lost Voice's premiere! Senea made sure we all had tickets!","female":"We all went to see Lost Voice's premiere! Senea made sure we all had tickets!","variant_male_record_index":"247651","variant_female_record_index":"247652","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1821324004:1":{"text":"You've been taking such good care of the children, Lilli. How are they doing?","source_cn":"辛苦了，莉栗。孩子们都还好吗？","status":"matched","hash_xxh64":"0x0DC2E2BC4F69C140","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1821324005:1":{"text":"Everyone's doing great! They look forward to your visits every day, and you never let them down.","source_cn":"别担心，好着呢！他们每天数着日子等你来，你也从没让他们...","status":"matched","hash_xxh64":"0x2465839613F52130","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1821324006:1":{"text":"It's Senea! She's here!","source_cn":"是塞涅！塞涅来了！","status":"matched","hash_xxh64":"0x9E5D0ACDC1C4FB6A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1821324007:1":{"text":"Who's with her? Her co-star?","source_cn":"她旁边的人是谁？也是个演员吗？","status":"matched_runtime_gender","hash_xxh64":"0xFA1A21F200345BCF","variant_status":"runtime_gender_keys_target_same","male":"Who's with her? Her co-star?","female":"Who's with her? Her co-star?","variant_male_record_index":"247656","variant_female_record_index":"247657","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1821324008:1":{"text":"Senea! Senea! Let's play together!","source_cn":"塞涅！塞涅！陪我玩！","status":"matched","hash_xxh64":"0x0476DA9323F796B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1821324009:1":{"text":"Senea, can you read me a poem today? Oh, and I finally learned that song you taught me last time!","source_cn":"塞涅！我想听你念诗！对了，你上次教我的曲子，我已经会唱了！","status":"matched","hash_xxh64":"0xDDF6C6E0E32524E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1821324010:1":{"text":"Me too! Can I sing it for you, Senea?","source_cn":"我也会！塞涅！你来听！","status":"matched","hash_xxh64":"0x7717268640915F8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1821324011:1":{"text":"Come on, give Senea some room! She can't do anything with you all crowding around her.","source_cn":"好啦！你们这样围着塞涅小姐，她什么也做不了。","status":"matched","hash_xxh64":"0x4158AE22BD9FA485","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1821324012:1":{"text":"It's fine. It's good to see everyone so full of energy.","source_cn":"没关系，大家都这样有精神，我也就放心了。","status":"matched","hash_xxh64":"0x54FD7553B8794199","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1821324013:1":{"text":"Here are some toys, books, and theater merchandise. Would you help me hand them out to the children, <style=\"stress\"><player_name></style>?","source_cn":"我带了一些玩具、书籍和剧团周边，请和我一起发给孩子们吧...","status":"matched_runtime_gender","hash_xxh64":"0x6C677CC6CC31B303","variant_status":"runtime_gender_keys_target_same","male":"Here are some toys, books, and theater merchandise. Would you help me hand them out to the children, <style=\"stress\"><player_name></style>?","female":"Here are some toys, books, and theater merchandise. Would you help me hand them out to the children, <style=\"stress\"><player_name></style>?","variant_male_record_index":"247663","variant_female_record_index":"247664","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1821324014:1":{"text":"Yay! We've got new toys!","source_cn":"哦哦哦！玩具，有新玩具了——！","status":"matched","hash_xxh64":"0x4AEE89C414086B6E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"You've seen me perform?","source_cn":"你看过我演戏？","status":"matched_runtime_gender","hash_xxh64":"0x07F12AFD9ACE1F92","variant_status":"runtime_gender_keys_target_same","male":"You've seen me perform?","female":"You've seen me perform?","variant_male_record_index":"94165","variant_female_record_index":"94166","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莉栗":{"text":"Lilli","source":"莉栗","status":"matched_dialogue_flow"},"speaker:塞涅":{"text":"Senea","source":"塞涅","status":"matched_dialogue_flow"},"speaker:赫尔嘉":{"text":"Helgan","source":"赫尔嘉","status":"matched_dialogue_flow"},"speaker:斑柯":{"t