{"asset_key":"ep8/quest_story_18104250","episode":"ep8","category":"quest_story","story_id":"18104250","schema_version":1,"lang":"en","texts":{"say:1:1810425001:1":{"text":"Reynald?!","source_cn":"里面的人是……雷诺尔？！","status":"matched","hash_xxh64":"0xFA6A03A39B22CC98","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1810425002:0":{"text":"I never thought I'd find his body here...","source_cn":"他的尸体竟然在这里……","status":"matched","hash_xxh64":"0x2ACA0826E5E7B486","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1810425002":{"text":"I never thought I'd find his body here...","source_cn":"他的尸体竟然在这里……","status":"matched","hash_xxh64":"0x2ACA0826E5E7B486","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1810425003:1":{"text":"... What?!","source_cn":"……什么？!","status":"matched","hash_xxh64":"0xE85CAF8A3F8CE8D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1810425003":{"text":"... What?!","source_cn":"……什么？!","status":"matched","hash_xxh64":"0xE85CAF8A3F8CE8D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1810425004:0":{"text":"He's my friend, but he's not the one I'm here for.","source_cn":"他是我的朋友。但我此行来找的人并不是他。","status":"matched","hash_xxh64":"0x181A66E3476CD17C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1810425006:0":{"text":"He disappeared five years ago. I thought he was dead.","source_cn":"他在五年前失踪了，我一直以为他已经死亡。","status":"matched_runtime_gender","hash_xxh64":"0x8951B7210948DAC4","variant_status":"runtime_gender_keys_target_same","male":"He disappeared five years ago. I thought he was dead.","female":"He disappeared five years ago. I thought he was dead.","variant_male_record_index":"241452","variant_female_record_index":"241453","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1810425006":{"text":"He disappeared five years ago. I thought he was dead.","source_cn":"他在五年前失踪了，我一直以为他已经死亡。","status":"matched_runtime_gender","hash_xxh64":"0x8951B7210948DAC4","variant_status":"runtime_gender_keys_target_same","male":"He disappeared five years ago. I thought he was dead.","female":"He disappeared five years ago. I thought he was dead.","variant_male_record_index":"241452","variant_female_record_index":"241453","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1810425007:1":{"text":"... Yes, he served on the front lines for years.","source_cn":"……是的，他一直奋战在前线。","status":"matched_runtime_gender","hash_xxh64":"0x054484D9C570BF98","variant_status":"runtime_gender_keys_target_same","male":"... Yes, he served on the front lines for years.","female":"... Yes, he served on the front lines for years.","variant_male_record_index":"241454","variant_female_record_index":"241455","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1810425009:0":{"text":"What else do you know? If we destroy this thing, will it harm him?","source_cn":"你还知道什么？打破这装置，会对雷诺尔有影响吗？","status":"matched_runtime_gender","hash_xxh64":"0x3042126E9091DF8A","variant_status":"runtime_gender_keys_target_same","male":"What else do you know? If we destroy this thing, will it harm him?","female":"What else do you know? If we destroy this thing, will it harm him?","variant_male_record_index":"241458","variant_female_record_index":"241459","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1810425010:1":{"text":"You examine the device and realize it is supplying him with only the bare minimum energy to sustain his life.","source_cn":"你仔细检查装置，发现它在向雷诺尔输送着生命能量——当然...","status":"matched_runtime_gender","hash_xxh64":"0xBE3FCA320CF439B6","variant_status":"runtime_gender_keys_target_same","male":"You examine the device and realize it is supplying him with only the bare minimum energy to sustain his life.","female":"You examine the device and realize it is supplying him with only the bare minimum energy to sustain his life.","variant_male_record_index":"241460","variant_female_record_index":"241461","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1810425011:1":{"text":"Any slight disturbance in his environment could cost him his life.","source_cn":"任何轻微的刺激或是环境改变，都有可能夺去他的性命。","status":"matched","hash_xxh64":"0xA5B77ECCB5E4FDDE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1810425011":{"text":"Any slight disturbance in his environment could cost him his life.","source_cn":"任何轻微的刺激或是环境改变，都有可能夺去他的性命。","status":"matched","hash_xxh64":"