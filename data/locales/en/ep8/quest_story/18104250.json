 is my friend as well.","female":"No, but Reynald is my friend as well.","variant_male_record_index":"241450","variant_female_record_index":"241451","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:1:2":{"text":"Are you here for him?","source_cn":"你就是来找他的？","status":"matched_runtime_gender","hash_xxh64":"0x8B546C377BDBA37A","variant_status":"runtime_gender_keys_target_same","male":"Are you here for him?","female":"Are you here for him?","variant_male_record_index":"92329","variant_female_record_index":"92330","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"He's still alive.","source_cn":"他还活着","status":"matched_runtime_gender","hash_xxh64":"0x296A8918FAED4535","variant_status":"runtime_gender_keys_target_same","male":"He's still alive.","female":"He's still alive.","variant_male_record_index":"92323","variant_female_record_index":"92324","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"Don't write him off just yet!","source_cn":"别咒人家死啊","status":"matched_runtime_gender","hash_xxh64":"0x5E27DF287E7637E6","variant_status":"runtime_gender_keys_target_same","male":"Don't write him off just yet!","female":"Don't write him off just yet!","variant_male_record_index":"92325","variant_female_record_index":"92326","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:瑟恩":{"text":"Thane","source":"瑟恩","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":25,"localized_text_count":24,"speaker_count":2}}