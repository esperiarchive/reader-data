{"asset_key":"ep8/quest_story_18106110","episode":"ep8","category":"quest_story","story_id":"18106110","schema_version":1,"lang":"en","texts":{"say:1:1810611001:0":{"text":"Greetings.","source_cn":"您好。","status":"matched","hash_xxh64":"0x2B3ECBE7428AD980","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1810611001":{"text":"Greetings.","source_cn":"您好。","status":"matched","hash_xxh64":"0x2B3ECBE7428AD980","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1810611002:1":{"text":"No. She's not talking to us.","source_cn":"……不对，她不是在跟我们说话。","status":"matched","hash_xxh64":"0xD57E54CDDF658620","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1810611003:0":{"text":"Estrilda's right. The maid's hollow gaze isn't on you. She's just another illusion.","source_cn":"爱丝说的没错，鬼影女仆虚无的目光显然没有落在你们身上。...","status":"matched_runtime_gender","hash_xxh64":"0x54E09A19401B2F71","variant_status":"runtime_gender_keys_target_same","male":"Estrilda's right. The maid's hollow gaze isn't on you. She's just another illusion.","female":"Estrilda's right. The maid's hollow gaze isn't on you. She's just another illusion.","variant_male_record_index":"242444","variant_female_record_index":"242445","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1810611004:1":{"text":"Placing a hand over her chest, she performs an elegant curtsy.","source_cn":"她以手掩胸，微微弯腰，端庄地行了一礼。","status":"matched","hash_xxh64":"0xCF63F929F33F1415","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1810611005:0":{"text":"\"Greetings.\"","source_cn":"“您好”。","status":"matched","hash_xxh64":"0x55EBCA9C80051B56","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1810611006:0":{"text":"When you meet Her Ladyship, you must bow with as much grace as possible. Just as I have demonstrated.","source_cn":"——面见领主时，应当尽可能稳重地行礼。就像我方才所示范...","status":"matched","hash_xxh64":"0x12A8AE0F1B2574D1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1810611007:0":{"text":"Please <style=\"highlight\">practice in front of the mirror</style>.","source_cn":"请<style=highlight>对着镜子练习</s...","status":"matched","hash_xxh64":"0x7FDC2842A48FF907","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1810611008:0":{"text":"You don't think we're actually supposed to bow to a mirror, do you?","source_cn":"我们是不是应该对着镜子行礼？","status":"matched","hash_xxh64":"0x73812F0A720C6058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1810611009:0":{"text":"The illusion downstairs said <style=\"highlight\">only those who master proper etiquette</style> may enter the hall.","source_cn":"楼下的幻象说过，<style=highlight>必须...","status":"matched","hash_xxh64":"0x0313C5A5AC8E0F07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1810611010:0":{"text":"We don't have any other options. Let's give it a shot.","source_cn":"现在也没有其他办法，姑且尝试一下吧。","status":"matched","hash_xxh64":"0xD41511FBC8CC72CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"You can see us?!","source_cn":"你看得到我们？！","status":"matched_runtime_gender","hash_xxh64":"0x94DF44F129FA802F","variant_status":"runtime_gender_keys_target_same","male":"You can see us?!","female":"You can see us?!","variant_male_record_index":"92633","variant_female_record_index":"92634","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:奇怪的女仆幻象":{"text":"Odd Maid","source":"奇怪的女仆幻象","status":"matched_dialogue_flow"},"speaker:爱丝特瑞达":{"text":"Estrilda","source":"爱丝特瑞达","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"},"speaker:瑟恩":{"text":"Thane","source":"瑟恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":4}}