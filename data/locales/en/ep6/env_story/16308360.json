{"asset_key":"ep6/env_story_16308360","episode":"ep6","category":"env_story","story_id":"16308360","schema_version":1,"lang":"en","texts":{"say:1:1630836001:1":{"text":"I... I'm just looking for a home!","source_cn":"我……我想给自己找个家！","status":"matched_runtime_gender","hash_xxh64":"0xA5BB765C05A90168","variant_status":"runtime_gender_keys_target_same","male":"I... I'm just looking for a home!","female":"I... I'm just looking for a home!","variant_male_record_index":"210635","variant_female_record_index":"210636","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1630836002:1":{"text":"This student's a saint! Comes by every day to feed strays like us.","source_cn":"这位学生，他可好了，每天都会去喂我们这些流浪的动物！","status":"matched","hash_xxh64":"0x50952030F4AC4372","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1630836003:1":{"text":"I want him to be my human... My forever friend.","source_cn":"我想……我想让他收养我，当我的主人。","status":"matched","hash_xxh64":"0x97833EB6A705A4CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1630836004:1":{"text":"I promise I won't bark too loud, I'll eat whatever's in the bowl, and I won't wander off!","source_cn":"我一定不吵闹、不挑食、不乱跑！","status":"matched","hash_xxh64":"0x6C7271512103D494","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1630836005:1":{"text":"I'll even learn new tricks! I'll guard him from bullies!","source_cn":"我会做很多事情，也会好好保护