{"asset_key":"ep6/env_story_16304240","episode":"ep6","category":"env_story","story_id":"16304240","schema_version":1,"lang":"en","texts":{"say:2:1630424001:1":{"text":"Hey, cool off...","source_cn":"哎哟，那么凶干嘛……","status":"matched","hash_xxh64":"0x4C8CF177341D1192","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1630424002:1":{"text":"I'll cool off when you start moving along!","source_cn":"你倒是挪个地方啊！","status":"matched","hash_xxh64":"0x573DC4FBE9805ACD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1630424003:1":{"text":"I'm not bothering anyone. But you, you're definitely bothering me.","source_cn":"我又不打扰你们。反倒是你，真的很打扰我。","status":"matched","hash_xxh64":"0xDC60135D4DA0A578","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1630424004:1":{"text":"NO FISHING!","source_cn":"这里不允许钓鱼！","status":"matched","hash_xxh64":"0x9F03214AEB3A9B62","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1630424005:1":{"text":"This area's off-limits! Dangerous cargo coming through—civilians, clear out!","source_cn":"这里非常危险！我们商队要在这里卸货，无关人等都离开！","status":"matched","hash_xxh64":"0xEF839887F440EB49","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1630424006:1":{"text":"I'm just sitting here. Not touching anything.","source_cn":"我就坐在这里，不打扰你们。","status":"matched","hash_xxh64":"0x7E5CA0FBA666449B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1630424007:1":{"text":"... Fine. But if you fall into the water, don't expect me to fish you out!","source_cn":"……好吧。听着，如果你掉进海里，我是不会把你钓上来的！","status":"matched","hash_xxh64":"0xEB9E3D184368C06F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:凯兰":{"text":"Kaylan","source":"凯兰","status":"matched_dialogue_flow"},"speaker:西顿":{"text":"Seaton","source":"西顿","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}}