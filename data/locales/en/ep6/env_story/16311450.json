{"asset_key":"ep6/env_story_16311450","episode":"ep6","category":"env_story","story_id":"16311450","schema_version":1,"lang":"en","texts":{"say:1:1631145001:1":{"text":"Did you see a mouse run past just now?","source_cn":"你刚才有没有见到一只跑来的老鼠？","status":"matched","hash_xxh64":"0xCBDC5ABF9B3FC20C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1631145001":{"text":"Did you see a mouse run past just now?","source_cn":"你刚才有没有见到一只跑来的老鼠？","status":"matched","hash_xxh64":"0xCBDC5ABF9B3FC20C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1631145002:1":{"text":"Hmph! It dove into this hole! It mocked me while it ran, tail flicking like it owned the place!","source_cn":"哼！它肯定是钻进这个洞里了！我追它一路，它倒好，一路回...","status":"matched","hash_xxh64":"0x64DE80DFF4073736","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1631145003:1":{"text":"That shameless thief steals from humans and animals' winter stores! Today, it pays!","source_cn":"那个无耻的小偷！偷人类的东西也就算了，连其他动物过冬的...","status":"matched","hash_xxh64":"0x152D2D647D07238A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1631145004:1":{"text":"You look like you know magic. Can you go in there? It's too small for me.","source_cn":"我看你好像会点魔法……你能帮我进去看看吗？这个洞对我来...","status":"matched","hash_xxh64":"0xCE2C48