{"asset_key":"ep6/quest_story_16224343","episode":"ep6","category":"quest_story","story_id":"16224343","schema_version":1,"lang":"en","texts":{"say:1:1622434301:1":{"text":"Chirp chirp! More are coming! Take whoever can still move and go, Serka! I'll cover you!","source_cn":"啾啾！这些家伙越来越多了！瑟卡！你带着能飞的先走！我留...","status":"matched","hash_xxh64":"0xB77DE5C384488758","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1622434302:1":{"text":"No! We leave together, or we stay together. We're a flock!","source_cn":"不行！要么一起飞走，要么一起留下！鸟群是一个整体！","status":"matched","hash_xxh64":"0xAD20D1D6EB69FD12","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1622434303:1":{"text":"Chirp... One of us takes the cost. That's what being one flock means. Go!","source_cn":"啾……正因为是一个整体，才需要有鸟承担错误！快走！","status":"matched","hash_xxh64":"0xE930F8AE0AAF0AC8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:布尔":{"text":"Bur","source":"布尔","status":"matched_dialogue_flow"},"speaker:瑟卡":{"text":"Serka","source":"瑟卡","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}