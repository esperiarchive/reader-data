{"asset_key":"ep6/quest_story_16232600","episode":"ep6","category":"quest_story","story_id":"16232600","schema_version":1,"lang":"en","texts":{"say:1:1623260001:0":{"text":"Maybe... you could tell me how to become livestock?","source_cn":"也许……你可以告诉我，怎样才能成为家畜？","status":"matched","hash_xxh64":"0x10736A4C8057A8F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1623260002:0":{"text":"It sounds like a great job. Food, drink... and an owner who takes care of you.","source_cn":"我觉得家畜这份工作很不错，有吃有喝，还可以被主人一直照...","status":"matched","hash_xxh64":"0xBE9908464791D38D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1623260003:0":{"text":"Baa... What's so great about it...? Everyone ends up the same way. Run while you can...","source_cn":"咩……家畜有什么好，大家最后只有那个结局，快逃……","status":"matched","hash_xxh64":"0x544E8505AA24D7F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1623260004:1":{"text":"What way...? What do you mean?","source_cn":"是什么结局……？完全不懂。","status":"matched","hash_xxh64":"0x7701C22E59CBB2A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1623260005:1":{"text":"Phew, I wish Candel were here. He's way sharper than I am. He'd know what Mr. Sheep meant.","source_cn":"呼，要是坎德尔在就好了，他比我聪明多，一定可以理解羊先...","status":"matched","hash_xxh64":"0xC1AC7E67E7E6C5EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1623260006:1":{"text":"I hope he's landed a job. When will I get to see him again? I miss our talks.","source_cn":"不知道他找到工作了没有，好想和他聊聊天啊……","status":"matched","hash_xxh64":"0xA18E1882D8CE8D33","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1623260007:1":{"text":"Hey, buddy!","source_cn":"嘿！伙计！","status":"matched","hash_xxh64":"0xF6BACA19058D7B40","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1623260008:0":{"text":"Candel! It's you! And Magister!","source_cn":"是坎德尔！还有魔法师大人！","status":"matched","hash_xxh64":"0x3A9017DD924D40C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1623260009:0":{"text":"Look at you! It's been a while—uh... is it just me, or is your flame looking a little dimmer?","source_cn":"怎么样啊？有阵子没见了——是我的错觉吗，怎么觉得你的烛...","status":"matched","hash_xxh64":"0x484DF9262C79D9F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1623260010:0":{"text":"I-Is it? Could be the job-hunting... No one wants a lighting candle, and nobody thinks I can handle night watch, either...","source_cn":"有、有吗？可能是因为找工作太累了，毕竟既没有人愿意让我...","status":"matched","hash_xxh64":"0x9F6EB0A335B143E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1623260010":{"text":"I-Is it? Could be the job-hunting... No one wants a lighting candle, and nobody thinks I can handle night watch, either...","source_cn":"有、有吗？可能是因为找工作太累了，毕竟既没有人愿意让我当照明蜡烛，也没有人觉得我能做夜班守卫……","status":"matched","hash_xxh64":"0x9F6EB0A335B143E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1623260011:0":{"text":"Offer... for me? Someone's offering me a job and they had you deliver it?","source_cn":"邀请？是给我的吗？居然有人邀请我工作，还能请到魔法师大...","status":"matched_runtime_gender","hash_xxh64":"0xDC13A912472DA254","variant_status":"runtime_gender_keys_target_same","male":"Offer... for me? Someone's offering me a job and they had you deliver it?","female":"Offer... for me? Someone's offering me a job and they had you deliver it?","variant_male_record_index":"219037","variant_female_record_index":"219038","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:15:1623260011":{"text":"Offer... for me? Someone's offering me a job and they had you deliver it?","source_cn":"邀请？是给我的吗？居然有人邀请我工作，还能请到魔法师大人来送这份邀请书？","status":"matched_runtime_gender","hash_xxh64":"0xDC13A912472DA254","variant_status":"runtime_gender_keys_target_same","male":"Offer... for me? Someone's offering me a job and they had you deliver it?","female":"Offer... for me? Someone's offering me a job and they had you deliver it?","variant_male_record_index":"219037","variant_female_record_index":"219038","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1623260012:0":{"text":"For real? Th-They mean it? They want to take us in?!","source_cn":"真的吗？他们……真是那么说的？他们真的愿意试着接纳我们？！","status":"matched_runtime_gender","hash_xxh64":"0x9A1B986680E276F6","variant_status":"runtime_gender_keys_target_same","male":"For real? Th-They mean it? They want to take us in?!","female":"For real? Th-They mean it? They want to take us in?!","variant_male_record_index":"219039","variant_female_record_index":"219040","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:17:1623260012":{"text":"For real? Th-They mean it? They want to take us in?!","source_cn":"真的吗？他们……真是那么说的？他们真的愿意试着接纳我们？！","status":"matched_runtime_gender","hash_xxh64":"0x9A1B986680E276F6","variant_status":"runtime_gender_keys_target_same","male":"For real? Th-They mean it? They want to take us in?!","female":"For real? Th-They mean it? They want to take us in?!","variant_male_record_index":"219039","variant_female_record_index":"219040","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1623260013:1":{"text":"I can't believe it! Candel, what do you think? Should we say yes?","source_cn":"简直难以置信！坎德尔，我们该怎么办，要不要……回去？","status":"matched","hash_xxh64":"0x780A3B9E1FA902EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1623260014:1":{"text":"Honestly... I've missed the forest. I can't shake off the awful parts, of course, but every time I close my eyes and imagine the smell of green and the rustling of leaves... I just feel safe again.","source_cn":"其实……我这段时间一直很想念森林的生活。那些糟糕的事我...","status":"matched","hash_xxh64":"0x7AA170C39EC0F8C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1623260015:1":{"text":"It's strange. I'm a magical creation made by humans, yet I crave the feel of soft soil, with pine needles covering it...","source_cn":"真奇怪，我明明是人类创造的魔法造物，却每天都在怀念脚踩...","status":"matched","hash_xxh64":"0xCB13DCC482C068B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1623260016:1":{"text":"*Cough* Yeah. Me too.","source_cn":"咳，我……也是的。","status":"matched","hash_xxh64":"0x5969F1D5E26201C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1623260017:1":{"text":"We left because we had to. Since they're holding out an olive branch, we should accept it. No?","source_cn":"我们是因为动物们的反对才离开森林的，既然现在他们改变了...","status":"matched","hash_xxh64":"0xD227F975060E9091","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1623260018:1":{"text":"Don't act like we're desperate. It's just a forest. There's nothing special about it...","source_cn":"别说得好像我们没有其他选择了似的，森林也没什么了不起的……","status":"matched","hash_xxh64":"0x5960BC3F24ED13B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1623260019:1":{"text":"They've made the offer. And as two-of-a-kind magical creations, the proper thing is to accept. That's called... basic etiquette.","source_cn":"不过既然那群动物向我们发出了邀请，作为独二无三的魔法造...","status":"matched","hash_xxh64":"0x8FC4515692DA1A8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1623260020:0":{"text":"Okay!","source_cn":"好啊！","status":"matched","hash_xxh64":"0x17E1FCB01729068B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1623260021:1":{"text":"The decision is made. Sweep's flame pops brighter and Candel's bristles spring back to life.","source_cn":"在他们达成了一致决定之后，小蜡烛的火焰“噗”地亮了一截...","status":"matched","hash_xxh64":"0x8DCD6A3A623DE72C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1623260022:1":{"text":"But it only lasts a moment. The memory of the animals' cruel words and cold looks hits them both, and they slow down.","source_cn":"但兴奋只有一瞬，两人似乎同时回想起了动物们拒绝他们时的...","status":"matched","hash_xxh64":"0xB2221E3F66E3D91F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1623260023:0":{"text":"Candel...","source_cn":"坎德尔……","status":"matched","hash_xxh64":"0x315EB43F7E5EBB0A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1623260024:1":{"text":"I know. Let's just... go back for us. To see it through. And if it goes bad... we can leave anytime.","source_cn":"我明白的，就当是为了实现我们自己的愿望，再回去一次。大...","status":"matched","hash_xxh64":"0x88EECFEC12D31669","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1623260025:1":{"text":"Hmm...","source_cn":"嗯……","status":"matched","hash_xxh64":"0xF8CF0592B7A0AD3F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:33:1623260025":{"text":"Hmm...","source_cn":"嗯……","status":"matched","hash_xxh64":"0xF8CF0592B7A0AD3F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1623260026:1":{"text":"Yes. We're going back!","source_cn":"决定了，我们——回森林。","status":"matched","hash_xxh64":"0x732E7DCDEE1F0BA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1623260027:1":{"text":"Let's go, Magister!","source_cn":"现在就出发吧，魔法师大人。","status":"matched","hash_xxh64":"0xDE7E11367698FEA5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:33:0:1":{"text":"You've made up your mind?","source_cn":"你们决定了吗？","status":"matched_runtime_gender","hash_xxh64":"0x7120694C95D8AE3A","variant_status":"runtime_gender_keys_target_same","male":"You've made up your mind?","female":"You've made up your mind?","variant_male_record_index":"86915","variant_female_record_index":"86916","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:0:1":{"text":"Why would I lie about that?","source_cn":"那还能有假？","status":"matched_runtime_gender","hash_xxh64":"0x3AD983CB8B82C915","variant_status":"runtime_gender_keys_target_same","male":"Why would I lie about that?","female":"Why would I lie about that?","variant_male_record_index":"86911","variant_female_record_index":"86912","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:17:1:2":{"text":"I swear it on my good name.","source_cn":"我以我的名誉担保！","status":"matched_runtime_gender","hash_xxh64":"0xE79C798882AC416F","variant_status":"runtime_gender_keys_target_same","male":"I swear it on my good name.","female":"I swear it on my good name.","variant_male_record_index":"86913","variant_female_record_index":"86914","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:15:0:1":{"text":"(Tell him the whole story)","source_cn":"（转述动物的邀请）","status":"matched_runtime_gender","hash_xxh64":"0xA5EB5413A339C5D6","variant_status":"runtime_gender_keys_target_same","male":"(Tell him the whole story)","female":"(Tell him the whole story)","variant_male_record_index":"86909","variant_female_record_index":"86910","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:0:1":{"text":"I have an offer here.","source_cn":"我这里有份邀请书","status":"matched_runtime_gender","hash_xxh64":"0x82B57B052326AE9A","variant_status":"runtime_gender_keys_target_same","male":"I have an offer here.","female":"I have an offer here.","variant_male_record_index":"86905","variant_female_record_index":"86906","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:1:2":{"text":"(Tell him the whole story)","source_cn":"（转述动物的邀请）","status":"matched_runtime_gender","hash_xxh64":"0xE2D2A4B8FBEC0CDC","variant_status":"runtime_gender_keys_target_same","male":"(Tell him the whole story)","female":"(Tell him the whole story)","variant_male_record_index":"86907","variant_female_record_index":"86908","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:斯威普":{"text":"Sweep","source":"斯威普","status":"matched_dialogue_flow"},"speaker:小咩":{"text":"Baa","source":"小咩","status":"matched_dialogue_flow"},"speaker:坎德尔":{"text":"Candel","source":"坎德尔","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":38,"localized_text_count":37,"speaker_count":4}}