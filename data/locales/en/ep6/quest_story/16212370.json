{"asset_key":"ep6/quest_story_16212370","episode":"ep6","category":"quest_story","story_id":"16212370","schema_version":1,"lang":"en","texts":{"say:2:1621237001:0":{"text":"These animals... I'll pick out a few. I'm sure your boss will be pleased.","source_cn":"这些动物……我会挑几只，相信你们的老板会满意。","status":"matched","hash_xxh64":"0xD821F95F5D730DC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1621237002:0":{"text":"Your boss? Don't play dumb, flute boy. He's OUR boss!","source_cn":"你的老板？哈，别装蒜了，小混蛋，是我们的老板！","status":"matched","hash_xxh64":"0xA81EF16C400351B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1621237003:0":{"text":"Boys, round him up! Take them all!","source_cn":"小的们，把这些动物都带走！","status":"matched","hash_xxh64":"0xB217B3CAD156D069","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1621237004:0":{"text":"On it, chief!","source_cn":"是，头儿！","status":"matched","hash_xxh64":"0x16B01B92BC29A595","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1621237005:0":{"text":"Stop! What are you doing?! According to our contract, you're only supposed to take the sick ones!","source_cn":"不行！你们在干什么！按契约，只能带走体弱的动物！","status":"matched","hash_xxh64":"0x193B569DAD83EA0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1621237006:0":{"text":"Not your call anymore. Now move!","source_cn":"这由不得你！滚开！","status":"matched","hash_xxh64":"0xAA77A74561B54BBF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:哈梅尔":{"text":"Hamell","source":"哈梅尔","status":"matched_dialogue_flow"},"speaker:不耐烦的流氓":{"text":"Irritable Thug","source":"不耐烦的流氓","status":"matched_dialogue_flow"},"speaker:憨厚的流氓":{"text":"Dorky Thug","source":"憨厚的流氓","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":3}}