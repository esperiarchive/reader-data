{"asset_key":"ep6/quest_story_16208350","episode":"ep6","category":"quest_story","story_id":"16208350","schema_version":1,"lang":"en","texts":{"say:1:1620835001:1":{"text":"?!","source_cn":"……？<key:dialog4>","status":"matched","hash_xxh64":"0x54350712BDD4B3DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1620835001":{"text":"?!","source_cn":"……？<key:dialog4>","status":"matched","hash_xxh64":"0x54350712BDD4B3DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1620835002:1":{"text":"Will my skill work... on a glimmerbloom? I'll give it a shot...","source_cn":"说服荧荧花……这也可以？让我试试……","status":"matched","hash_xxh64":"0x9F902692E578610C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1620835003:0":{"text":"This is a difficult action. A roll of 16 or above is required to use the \"Persuade\" skill.","source_cn":"行动回合开始。困难行动，使用技能“说服”，需要掷出16...","status":"matched","hash_xxh64":"0x0D1E111EAB98A77B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1620835004:0":{"text":"Rolling the dice...","source_cn":"投掷骰子中……<key:dialog10>","status":"matched","hash_xxh64":"0xE7EFECB7D2F6422A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","do