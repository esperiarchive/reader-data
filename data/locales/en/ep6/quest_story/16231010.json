{"asset_key":"ep6/quest_story_16231010","episode":"ep6","category":"quest_story","story_id":"16231010","schema_version":1,"lang":"en","texts":{"say:2:1623101001:1":{"text":"Strange things... strange things are afoot, Magister!","source_cn":"怪事、怪事啊……魔法师大人，出怪事了！","status":"matched","hash_xxh64":"0xD314F26DC6521C65","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1623101002:1":{"text":"Catch your breath first, sir. Take your time and explain.","source_cn":"先生，你先喘口气，别着急，慢慢说。","status":"matched","hash_xxh64":"0x109B326D7EFD2206","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1623101003:1":{"text":"It's downright strange. Our sheep and horses won't touch their feed! Even the cats and dogs freeze up scared... and at night they start wailing like the world's ending!","source_cn":"太奇怪了，家里的羊和马都不吃草了！猫猫狗狗也都吓得不敢...","status":"matched","hash_xxh64":"0xB666EEB6FE65AA1C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1623101004:1":{"text":"I checked all around the wheat fields and found nothing. So I'm thinking... maybe this is magic?","source_cn":"俺在麦田附近排查了一圈也没发现是怎么回事，所以就想……...","status":"matched","hash_xxh64":"0xEAC0CC81052696E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1623101005:1":{"text":"You know us villagers. We don't know a thing about it. Could you take a look for us?","source_cn":"俺们这些村民，你也知道……对魔法一窍不通，能麻烦你们去...","status":"matched","hash_xxh64":"0x02B5E8E77326A1FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1623101006:1":{"text":"If it's got the whole animal crowd rattled... we're not dealing with anything ordinary.","source_cn":"唔……能让整群动物一起惊慌的，肯定不是普通事情。","status":"matched","hash_xxh64":"0x8087511BAA224C42","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1623101007:1":{"text":"<style=\"stress\"><player_name></style>, could you check it out?","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x26CCAF72270B84A0","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, could you check it out?","female":"<style=\"stress\"><player_name></style>, could you check it out?","variant_male_record_index":"218627","variant_female_record_index":"218628","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:村民查理":{"text":"Villager Charlie","source":"村民查理","status":"matched_dialogue_flow"},"speaker:赫普":{"text":"Hepler","source":"赫普","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}}