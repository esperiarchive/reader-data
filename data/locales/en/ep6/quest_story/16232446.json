{"asset_key":"ep6/quest_story_16232446","episode":"ep6","category":"quest_story","story_id":"16232446","schema_version":1,"lang":"en","texts":{"say:2:1623244601:1":{"text":"Now that's more like it. It's the real deal tonight. Took us long enough to find this place, and we're making it count.","source_cn":"行了，这才像话。今晚我们有大生意——既然好不容易找到这...","status":"matched","hash_xxh64":"0x87EF1B4EA4454A9C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1623244602:1":{"text":"Hehehe... Little forest critters, come to me. I love the look they get when they realize they can't escape.","source_cn":"嘿嘿嘿——森林的小家伙，我最喜欢他们绝望挣扎的样子了。","status":"matched","hash_xxh64":"0xC6F97452383D41AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:不耐烦的男人":{"text":"Impatient Man","source":"不耐烦的男人","status":"matched_dialogue_flow"},"speaker:贪吃的男人":{"text":"Hungry Man","source":"贪吃的男人","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":3,"localized_text_count":2,"speaker_count":2}}