{"asset_key":"ep6/quest_story_16207070","episode":"ep6","category":"quest_story","story_id":"16207070","schema_version":1,"lang":"en","texts":{"say:2:1620707001:1":{"text":"Lenor...","source_cn":"莱纳斯……莱纳斯……","status":"matched","hash_xxh64":"0x835E35B21C14286D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1620707002:1":{"text":"Pippa! Looking for me? I'm right here!","source_cn":"嘿！皮帕，你是在找我吗？我就在你旁边！","status":"matched","hash_xxh64":"0x65DF9A80E3FE0AAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1620707003:1":{"text":"S-sorry! I didn't see you there!","source_cn":"对对对对不起！我刚才没有看到你！","status":"matched","hash_xxh64":"0xCE258A3E04F9AFB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1620707004:1":{"text":"Magister Merlin's here too! He just tried your chaos magic invention!","source_cn":"梅林大人也在呢！<male>他</male><fema...","status":"matched_runtime_gender","hash_xxh64":"0x11A41F7C95FA372E","variant_status":"runtime_gender_keys_target_differs","male":"Magister Merlin's here too! He just tried your chaos magic invention!","female":"Magister Merlin's here too! She just tried your chaos magic invention!","variant_male_record_index":"202306","variant_female_record_index":"202307","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1620707005:1":{"text":"Seriously, thank you for teaching me. It's phenomenal! I can't wait to show the rest of t