e_female":"","document_title_cn":"","document_title_status":""},"say:10:1621736010:1":{"text":"It's because he's diligent and truly loves learning!","source_cn":"这不是无聊，是认真刻苦，以及严谨好学！","status":"matched","hash_xxh64":"0x78E68544052C2644","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1621736011:1":{"text":"Hey, don't assume anything yet! Look what I found... a horror novel! It's buried under this pile of textbooks.","source_cn":"别急着下结论嘛。各位，看看我在吉罗德的桌上找到了什么…...","status":"matched","hash_xxh64":"0x3026FF90F6A3C477","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1621736012:1":{"text":"Ah, that's more like it!","source_cn":"嗯嗯，这就对了嘛！","status":"matched","hash_xxh64":"0x6AB8DABD602C0FED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1621736013:1":{"text":"I don't get it...","source_cn":"怎么就对了……","status":"matched","hash_xxh64":"0x41327999BA565FBA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1621736014:1":{"text":"It's called \"Eyes on You.\" Let me take a look... \"It was a typical afternoon when the protagonist discovered a magical mirror—\"","source_cn":"这本书叫《目光无处不在》。我看看啊……一个平常的午后，...","status":"matched","hash_xxh64":"0x7E612B873A4A153C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_fema