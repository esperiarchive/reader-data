{"asset_key":"ep6/quest_story_16207510","episode":"ep6","category":"quest_story","story_id":"16207510","schema_version":1,"lang":"en","texts":{"say:2:1620751001:1":{"text":"Hey, is something bothering you?","source_cn":"……同学，你在烦恼着什么吗？","status":"matched","hash_xxh64":"0xBE1C7B26667835EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1620751002:1":{"text":"Well, I'm worried that my room is too small.","source_cn":"其实……我在发愁我现在住的屋子空间太小的问题。","status":"matched","hash_xxh64":"0xA4EDC9C085C68D6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1620751003:1":{"text":"Why are you worried about that?","source_cn":"屋子的……空间？","status":"matched","hash_xxh64":"0x5E172BB5909111DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1620751004:1":{"text":"My room has enough space for me only.","source_cn":"我现在所住的屋子，在大小上住我一个人勉强够用。","status":"matched","hash_xxh64":"0x69EB3CF8F99E5A98","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1620751005:0":{"text":"But if I'm going to live with everyone I love... I'd need at least ten extra bedrooms! No, actually, I need to build a mansion to fit everyone!","source_cn":"可如果要和我喜欢的人住在一起，大家一起幸福地生活，起码...","status":"matched","hash_xxh64":"0x52B1C835531CA59E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1620751006:1":{"text":"Oh, so it's a space issue... Wait! Hold on! You're in love with that many people?! That's definitely more than a throuple! This is getting crazier and crazier.","source_cn":"原来是在为房子空间不够而烦恼啊……不对，你有这么多喜欢...","status":"matched","hash_xxh64":"0xD808D673181EF6E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:皮帕":{"text":"Pippa","source":"皮帕","status":"matched_dialogue_flow"},"speaker:里奥":{"text":"Rio","source":"里奥","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":2}}