{"asset_key":"ep6/quest_story_16104350","episode":"ep6","category":"quest_story","story_id":"16104350","schema_version":1,"lang":"en","texts":{"say:1:1610435001:1":{"text":"Oh, <style=\"stress\"><player_name></style>, I'm so glad to see you!","source_cn":"啊，<style=stress><player_nam...","status":"matched_runtime_gender","hash_xxh64":"0xE22D66D198A792AD","variant_status":"runtime_gender_keys_target_same","male":"Oh, <style=\"stress\"><player_name></style>, I'm so glad to see you!","female":"Oh, <style=\"stress\"><player_name></style>, I'm so glad to see you!","variant_male_record_index":"205412","variant_female_record_index":"205413","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1610435002:1":{"text":"I have a question. What monster did you face on the third island?","source_cn":"那个……我想问一下，你面对的第三个岛屿上的怪物是什么？","status":"matched_runtime_gender","hash_xxh64":"0xE129776DF72E3713","variant_status":"runtime_gender_keys_target_same","male":"I have a question. What monster did you face on the third island?","female":"I have a question. What monster did you face on the third island?","variant_male_record_index":"205414","variant_female_record_index":"205415","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1610435002":{"text":"I have a question. What monster did you face on the third island?","source_cn":"那个……我想问一下，你面对的第三个岛屿上的怪物是什么？","status":"matched_runtime_gender","hash_xxh64":"0xE129776DF72E3713","variant_status":"runtime_gender_keys_target_same","male":"I have a question. What monster did you face on the third island?","female":"I have a question. What monster did you face on the third island?","variant_male_record_index":"205414","variant_female_record_index":"205415","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:161