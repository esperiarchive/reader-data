itle_cn":"","document_title_status":""},"narration:12:1610435008:0":{"text":"The portal flickers, and Cassadee and Gervan return simultaneously.","source_cn":"传送门闪烁了起来，科丝蒂和格墨文几乎同一时间现出身形","status":"matched","hash_xxh64":"0x1E5134B1B4312E6D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:1610435009:0":{"text":"Right after them, Silven pops out.","source_cn":"紧接着，休也走了出来","status":"matched","hash_xxh64":"0x97C948A0400902E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1610435010:1":{"text":"Pippa, we were all so worried about you in the first two tests! We never expected you to jump ahead in the third! By the way, did you guys also have to face a flying Hypofiend?!","source_cn":"皮帕，前两场考试我们都很担心你，没想到第三场你就爆发出...","status":"matched","hash_xxh64":"0x2E2F81362D4E655D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1610435011:1":{"text":"Yes.","source_cn":"嗯，我的是飞行魔物。","status":"matched","hash_xxh64":"0x4ACBB28745504545","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1610435012:1":{"text":"Same here. What about you, <style=\"stress\"><player_name></style>?","source_cn":"我的也是，想必<style=stress><playe...","status":"matched_runtime_gender","hash_xxh64":"0x8163A1D6412E0C0A","variant_status":"runtime_gender_keys_target_same","male":"Same here. What about you, <style=\"stress\"><player_name></style>?","female":"Same here. What about you, <style=\"stress\"><player_name></style>?","variant_male_record_index":"205430","variant_female_record_index":"205431","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1610435012":{"text":"Same here. What about you, <style=\"stress\"><player_name></style>?","source_cn":"我的也是，想必<style=stress><player_name></style>的也一样吧？","status":"matched_runtime_gender","hash_xxh64":"0x8163A1D6412E0C0A","variant_status":"runtime_gender_keys_target_same","male":"Same here. What about you, <style=\"stress\"><player_name></style>?","female":"Same here. What about you, <style=\"stress\"><player_name></style>?","variant_male_record_index":"205430","variant_female_record_index":"205431","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1610435013:1":{"text":"Well, for me... my island didn't have any of those! I just, kinda... walked straight through? Didn't see a soul, not even a puff of smoke! It was... weird.","source_cn":"呃，可我……我那座岛上没有会飞的魔物，我……什么都没有...","status":"matched","hash_xxh64":"0x8D217FBA94CCB912","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1610435014:1":{"text":"I told you! Your luck is insane!","source_cn":"什么？没有魔物？！看吧，皮帕，我就说你的运气是我们之中...","status":"matched","hash_xxh64":"0xCA6FEA85FAFD27F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1610435015:1":{"text":"But...","source_cn":"可是，可是……","status":"matched","hash_xxh64":"0xDCEF1136C48F6F4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1610435016:1":{"text":"There's no need to fret. Luck has always favored you, and that fortune is a genuine part of your capabilities.","source_cn":"别担心，皮帕，你一向被好运眷顾，运气也是实力的一部分。","status":"matched","hash_xxh64":"0xFEB4F897E8FE64BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:27:1610435017:0":{"text":"Just as you all are relaxing, an odd sound rings out, and the huge portal is seen.","source_cn":"正在你们放松下来的时候，一声异响传来，大传送门再次被激活","status":"matched_runtime_gender","hash_xxh64":"0x257EBACABB20D28B","variant_status":"runtime_gender_keys_target_same","male":"Just as you all are relaxing, an odd sound rings out, and the huge portal is seen.","female":"Just as you all are relaxing, an odd sound rings out, and the huge portal is seen.","variant_male_record_index":"205436","variant_female_record_index":"205437","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:0:1":{"text":"Yes, the same.","source_cn":"是的","status":"matched_runtime_gender","hash_xxh64":"0x912A49B46D88936C","variant_status":"runtime_gender_keys_target_same","male":"Yes, the same.","female":"Yes, the same.","variant_male_record_index":"83523","variant_female_record_index":"83524","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"You didn't break any rules.","source_cn":"你又没违反规则！","status":"matched_runtime_gender","hash_xxh64":"0xE5C706204F451ECC","variant_status":"runtime_gender_keys_target_same","m