{"asset_key":"ep6/quest_story_16224090","episode":"ep6","category":"quest_story","story_id":"16224090","schema_version":1,"lang":"en","texts":{"say:1:1622409001:1":{"text":"Professor Hepler! Are you here to check on the birds, too?","source_cn":"赫普老师，您也是来照看这些候鸟的吗？","status":"matched","hash_xxh64":"0xEFF71D456DA3A8C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1622409002:0":{"text":"No, Cassadee. I'm here to tell you to stop—","source_cn":"不！科丝蒂！我来是希望你停下……","status":"matched","hash_xxh64":"0xB48E9A9D8A8606EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1622409003:0":{"text":"A cold night wind cuts Hepler short, sending shivers down his spine.","source_cn":"夜晚的凉风拂过，这对赫普来说似乎过于冷冽，他话到一半，...","status":"matched","hash_xxh64":"0x322CD22FED374663","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1622409004:0":{"text":"Stop what, Professor Hepler?","source_cn":"停下？赫普老师，您是说停下什么？","status":"matched","hash_xxh64":"0x614DFA7527E87115","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1622409005:0":{"text":"<shk>Stop... treating th-the birds...</shk>","source_cn":"<shk>停下……救……助……</shk>","status":"matched","hash_xxh64":"0x4F367243BD64C574","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_inde