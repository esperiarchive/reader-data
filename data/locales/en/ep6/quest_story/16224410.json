{"asset_key":"ep6/quest_story_16224410","episode":"ep6","category":"quest_story","story_id":"16224410","schema_version":1,"lang":"en","texts":{"say:3:1622441001:1":{"text":"Chirp! The north wind is coming! When the north wind howls, spread your wings!","source_cn":"啾咕咕……北风！是北风！北风呼啸之时，张开你的翅膀！","status":"matched","hash_xxh64":"0xA77786F9ECED0414","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1622441002:1":{"text":"It's warm yet strong. Our ancestors heard our courage! Thank you, Lord Woodkeeper!","source_cn":"这风……温暖而有力，一定是先祖回应了我们的勇气！感谢您...","status":"matched","hash_xxh64":"0xB877FDB8662BEC7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1622441003:1":{"text":"Hope didn't come from your ancestors or me. It came from the courage you found when you had nothing left... and the wings you were born with.","source_cn":"给予你们希望的不是先祖或我，而是你们自己在绝境中唤醒的...","status":"matched","hash_xxh64":"0x36B9CDD11B5EE1C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1622441004:1":{"text":"The north wind was born in the woods. I only stirred it awake.","source_cn":"这股北风，本就孕育于这片森林的呼吸，我只是提前将它唤醒。","status":"matched","hash_xxh64":"0x6027B2FE7733A743","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1622441005:1":{"text":"Fly on. Go south and build a sweet home there.","source_cn":"飞吧，去南方建立你们的冬季家园。","status":"matched","hash_xxh64":"0x4C126CA1A66D764E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1622441005":{"text":"Fly on. Go south and build a sweet home there.","source_cn":"飞吧，去南方建立你们的冬季家园。","status":"matched","hash_xxh64":"0x4C126CA1A66D764E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1622441006:0":{"text":"Mm. Hope we meet again when the spring wind rises!","source_cn":"嗯！三位，希望来年春风时，我们能再次相遇！","status":"matched","hash_xxh64":"0xA261559D8FCF88AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:12:1622441007:0":{"text":"Carried by the roaring north wind, the flock lifts as one and flies toward the south.","source_cn":"在强劲的北风助力下，候鸟群振翅而起，坚定地飞向南方天际。","status":"matched","hash_xxh64":"0x686B2BAF8C570812","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"Fly high!","source_cn":"振翅高飞吧！","status":"matched_runtime_gender","hash_xxh64":"0x7A6AE35CB63E1DA9","variant_status":"runtime_gender_keys_target_same","male":"Fly high!","female":"Fly high!","variant_male_record_index":"86679","variant_female_record_index":"86680","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"Until we meet again!","source_cn":"未来再会！","status":"matched_runtime_gender","hash_xxh64":"0xAE763F8D7ECEB6A8","variant_status":"runtime_gender_keys_target_same","male":"Until we meet again!","female":"Until we meet again!","variant_male_record_index":"86681","variant_female_record_index":"86682","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:鸟群":{"text":"Bird Flock","source":"鸟群","status":"matched_dialogue_flow"},"speaker:瑟卡":{"text":"Serka","source":"瑟卡","status":"matched_dialogue_flow"},"speaker:赫普":{"text":"Hepler","source":"赫普","status":"matched_dialogue_flow"},"speaker:黑屏":{"text":"Black Screen","source":"黑屏","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":4}}