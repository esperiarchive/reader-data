{"asset_key":"ep6/quest_story_16232040","episode":"ep6","category":"quest_story","story_id":"16232040","schema_version":1,"lang":"en","texts":{"say:2:1623204001:0":{"text":"Lord Owlbear, two strange newcomers have shown up in the forest...","source_cn":"枭熊大人，最近森林里来了两个怪家伙……","status":"matched","hash_xxh64":"0xBBCB40220503D8F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1623204002:0":{"text":"Yes! Yes! The moment they pop up, my tail ties itself into a panic knot!","source_cn":"对对对！只要他们一出现，我就吓得尾巴打结！","status":"matched","hash_xxh64":"0xAE97E92B273373E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1623204003:0":{"text":"Woof! That's true!","source_cn":"汪，是真的！","status":"matched","hash_xxh64":"0x233D6112843272C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1623204004:0":{"text":"Easy, all of you. One at a time. What do they look like, and where were they seen?","source_cn":"好了好了，你们一个一个说。你们说的怪家伙，长什么样？在...","status":"matched","hash_xxh64":"0xDF74AA7BDC3EFBF6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1623204005:0":{"text":"Well... One of 'em goes swish-swish nonstop, and the other's got a big FLAME on his head! I almost dropped my acorns!","source_cn":"他们……一个总是沙沙响，另一个还顶着一团火！吓死个松鼠了！","status":"matched","hash_xxh64":"0xF9042CF1F7D007FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1623204006:0":{"text":"They first turned up near the wheat fields. Lately, they've been edging toward the forest... Everyone's getting nervous.","source_cn":"起初是在麦田附近出现的。最近他们似乎想进森林，大家都有...","status":"matched","hash_xxh64":"0xECE1F232B76A4D83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1623204007:1":{"text":"A-And I... I found this. The swishy one dropped it...","source_cn":"我……我捡到这个。是那个沙沙响的家伙掉的……","status":"matched","hash_xxh64":"0x9C67FA3DC422318F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:13::2":{"text":"Broom Sprout","source_cn":"笤帚苗","status":"matched","hash_xxh64":"0xF38BFF7E50FF3C95","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1623204008:0":{"text":"A broom sprout?","source_cn":"笤帚苗？","status":"matched","hash_xxh64":"0xD32EC27D0C886F74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1623204009:0":{"text":"Yeah! That's why we came to you! You've seen more than anyone!","source_cn":"对对！所以大家才想来请教您嘛！您见识最广了！","status":"matched","hash_xxh64":"0xEFCE59BA61CAED99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1623204010:0":{"text":"Understood. I'll keep an eye on it. Go back, now. Stay alert, but try not to scare yourselves.","source_cn":"我知道了。这件事我会留意的，大家先回去吧，保持警惕，但...","status":"matched","hash_xxh64":"0xE2E79C06CEB57B9E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1623204011:0":{"text":"Sooo, Lord Owlbear... when are you gonna go handle it exactly?","source_cn":"所以枭熊大人你什么时候去解决？","status":"matched","hash_xxh64":"0x0FB6005CA28DFF94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1623204012:0":{"text":"Hey, Lord Owlbear always gets it done. Let's head back.","source_cn":"好啦，枭熊大人答应的事肯定会做的。我们走吧。","status":"matched","hash_xxh64":"0x2C42F31DB6060350","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1623204013:2":{"text":"Let's goooof!","source_cn":"汪，走吧！","status":"matched","hash_xxh64":"0x020B23CD94000F47","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1623204014:0":{"text":"But it has been a while since you visited the woods. Everyone's really missed you!","source_cn":"不过的确好久没见枭熊大人来森林了，动物们都很想念你呢！","status":"matched","hash_xxh64":"0x8437A0F5C52695F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1623204015:0":{"text":"I'll make time.","source_cn":"我会抽时间过去的。","status":"matched","hash_xxh64":"0x14F301A859A8C53F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:25:1623204016:0":{"text":"The animals wander off.","source_cn":"动物们离开了。","status":"matched","hash_xxh64":"0xFF4DDC2B4EF179F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:温和的兔子":{"text":"Gentle Rabbit","source":"温和的兔子","status":"matched_dialogue_flow"},"speaker:语速快的松鼠":{"text":"Chatty Squirrel","source":"语速快的松鼠","status":"matched_dialogue_flow"},"speaker:憨实的狗":{"text":"Goofy Dog","source":"憨实的狗","status":"matched_dialogue_flow"},"speaker:赫普":{"text":"Hepler","source":"赫普","status":"matched_dialogue_flow"},"speaker:黑屏":{"text":"Black Screen","source":"黑屏","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":18,"localized_text_count":17,"speaker_count":5}}