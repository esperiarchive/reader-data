{"asset_key":"ep6/quest_story_16217120","episode":"ep6","category":"quest_story","story_id":"16217120","schema_version":1,"lang":"en","texts":{"say:1:1621712001:1":{"text":"What's the matter with you? There was nobody out there!","source_cn":"哪有什么客人，我到外面找了一圈，连个影子都没看到！","status":"matched","hash_xxh64":"0x300386ED99B550F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1621712002:1":{"text":"Sorry, boss. My eyes must've failed me.","source_cn":"对不起老板，可能是我看错了。","status":"matched","hash_xxh64":"0x384CC77970A9A14C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1621712003:1":{"text":"Hmph... I'll deal with you later.","source_cn":"哼……回头再找你算账。","status":"matched","hash_xxh64":"0xC2097E00E9BDD59A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1621712004:1":{"text":"It's decision time. Either you pay, or I'll make you.","source_cn":"你们几个，考虑得怎么样？我劝你们别挣扎了，赶紧乖乖买下...","status":"matched","hash_xxh64":"0xF194719C17381C7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1621712005:0":{"text":"We won't pay you.","source_cn":"我们不会付钱的。","status":"matched","hash_xxh64":"0x095E4095877D15B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","docu