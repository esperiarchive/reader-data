{"asset_key":"ep6/herohub_story_16411200","episode":"ep6","category":"herohub_story","story_id":"16411200","schema_version":1,"lang":"en","texts":{"say:2:1641120001:1":{"text":"Your Highness, please be careful. We don't even know where some of these desserts came from...","source_cn":"殿下，请小心，这些食物来源不明，万一有问题……","status":"matched","hash_xxh64":"0xDD32BC9F867D9956","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1641120002:1":{"text":"Oh come on, you're all such worrywarts!","source_cn":"唉呀，你们未免太紧张啦。","status":"matched","hash_xxh64":"0x84FA51A1784B2A35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1641120003:1":{"text":"This one's called a Chromaflake. It looks like a cracker, but bite it and it goes poof into rainbow smoke! Isn't that delightful?","source_cn":"这叫“幻彩纸饼”，咬开之后里面会冒出彩色烟雾，是不是很有趣？","status":"matched","hash_xxh64":"0x297714F588E1CCFC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1641120004:1":{"text":"And these are Moondrops. Gold when warm, silver when chilled. A whole mood ring on a stick!","source_cn":"还有这串“月亮丸子”，会随着温度变色，热的时候是金色，...","status":"matched","hash_xxh64":"0x5D11ECC2B27461A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1641120005:1":{"text":"It's just harmless magical street food! Nothing sketchy, I swear.","source_cn":"都是一些魔法小吃而已，不是什么奇怪的东西。","status":"matched","hash_xxh64":"0x8124F14CD12F7B39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1641120006:1":{"text":"But, Your Highness...","source_cn":"可是，殿下……","status":"matched","hash_xxh64":"0x64E2E6C04178BE6D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1641120007:1":{"text":"No buts! Rowan eats this stuff all the time and he's still walking around with all his limbs, isn't he?","source_cn":"没什么可是的！我可没少见罗万吃这些东西，他也没出什么事。","status":"matched","hash_xxh64":"0x7DCF9405A5C8A07E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1641120008:1":{"text":"And if something does go wrong, well, that's what I have you all for, isn't it?","source_cn":"再说啦，就算真的有问题，不是还有你们吗？","status":"matched","hash_xxh64":"0x454503E00BDEFFB1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1641120009:1":{"text":"Tell you what, why don't you try them with me? My treat! Royal decree!","source_cn":"要不这样，你们跟我一起吃好了！全部由本公主请客！","status":"matched","hash_xxh64":"0x6703C9D7EA0D325E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1641120010:1":{"text":"Th-thank you... Your Highness...","source_cn":"这、这……殿下……","status":"matched","hash_xxh64":"0x21C975101765EAB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1641120011:1":{"text":"Relax! It's not like I'm sending you into battle.","source_cn":"哈哈，看把你们吓得，又不是惩罚你们。","status":"matched","hash_xxh64":"0x72667B3AC53C8EA9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1641120012:1":{"text":"Come on, everyone eats! You haven't lived till you've had enchanted desserts!","source_cn":"所有人都跟我一起吃！很好吃的！","status":"matched","hash_xxh64":"0x50FF24E58F320346","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:帝国士兵":{"text":"Imperial Soldier","source":"帝国士兵","status":"matched_dialogue_flow"},"speaker:佩吉":{"text":"Peggy","source":"佩吉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":2}}