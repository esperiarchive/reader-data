{"asset_key":"ep6/gameplay_story_16602110","episode":"ep6","category":"gameplay_story","story_id":"16602110","schema_version":1,"lang":"en","texts":{"say:0:1660211001:2":{"text":"Summer burns high, and with it spreads fury. Hatred scorches the land like wildfire.","source_cn":"夏日炎炎，怒火在大地上蔓延，仇恨烧得滚烫。","status":"matched","hash_xxh64":"0xAB4A1DAA3AC1A2BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1660211002:0":{"text":"By the time you and Ludovic arrive, Soren is already facing off against Bryon, accompanied by a ragged group of Maulers.","source_cn":"你和柳博米尔赶到的时候，正看到索恩带着一群瘦弱的蛮血，...","status":"matched_runtime_gender","hash_xxh64":"0xAA6E97BB5A0801B7","variant_status":"runtime_gender_keys_target_same","male":"By the time you and Ludovic arrive, Soren is already facing off against Bryon, accompanied by a ragged group of Maulers.","female":"By the time you and Ludovic arrive, Soren is already facing off against Bryon, accompanied by a ragged group of Maulers.","variant_male_record_index":"219576","variant_female_record_index":"219577","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1660211003:0":{"text":"Please, Priest, we need to get through!","source_cn":"祭祀大人，让我们过去吧！","status":"matched","hash_xxh64":"0x3FDE0650FD8D4B41","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1660211004:0":{"text":"No.","source_cn":"不行。","status":"matched","hash_xxh64":"0x9652AA7173074632","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1660211005:0":{"text":"Bryon, have you forgotten what our tribe stands for?","source_cn":"布莱恩，你难道忘记了我们夏日部落的传统吗？","status":"matched","hash_xxh64":"0x499C73396E21B34A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1660211006:1":{"text":"We've always protected the weak. That's how we've grown strong together!","source_cn":"帮助和接纳弱小者，这正是我们部落不断壮大的原因！","status":"matched","hash_xxh64":"0xD26613DBBB2272DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1660211007:0":{"text":"But what if the curse follows them in and we all end up turning on each other? That's a risk we can't afford.","source_cn":"正是。但若是夏日诅咒进入部落，使得部落人人仇视，自相残...","status":"matched","hash_xxh64":"0xE2A9280A84C5A4A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1660211008:0":{"text":"If you've got a cure for the <style=\"highlight\">summer curse</style>, I'll let them through. Otherwise, I won't take chances.","source_cn":"您当然可以接纳他们进入部落……只要您能给出解决<sty...","status":"matched","hash_xxh64":"0xDC666CD3D04A5122","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1660211009:1":{"text":"... I don't.","source_cn":"……我不知道。","status":"matched","hash_xxh64":"0xE236C9DA369DA823","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1660211010:0":{"text":"Then that settles it. I'm sorry. You'll have to leave.","source_cn":"那便是了。抱歉，诸位，请回吧。","status":"matched","hash_xxh64":"0x3F15FA78A9BCD2E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1660211011:0":{"text":"No... We have to go now! Even if we have to fight our way through!","source_cn":"不行……我们必须逃离！只能强行闯关了！","status":"matched","hash_xxh64":"0xF9CF2C5CC43A7005","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1660211012:0":{"text":"I didn't want it to come to this... but here we go.","source_cn":"那么，得罪了。","status":"matched","hash_xxh64":"0x434A497D75D894D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1660211012":{"text":"I didn't want it to come to this... but here we go.","source_cn":"那么，得罪了。","status":"matched","hash_xxh64":"0x434A497D75D894D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"Hey, calm down!","source_cn":"喂，冷静点！","status":"matched_runtime_gender","hash_xxh64":"0x13F674104BB5AAF9","variant_status":"runtime_gender_keys_target_same","male":"Hey, calm down!","female":"Hey, calm down!","variant_male_record_index":"87037","variant_female_record_index":"87038","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:1:2":{"text":"I knew it wasn't gonna end without a fight...","source_cn":"果然还是要打一场啊……","status":"matched_runtime_gender","hash_xxh64":"0x821FFE16CF6B9726","variant_status":"runtime_gender_keys_target_same","male":"I knew it wasn't gonna end without a fight...","female":"I knew it wasn't gonna end without a fight...","variant_male_record_index":"87039","variant_female_record_index":"87040","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:2:3":{"text":"Everyone, stop! Just hear me out!","source_cn":"听我的，住手","status":"matched_runtime_gender","hash_xxh64":"0x959B2DC2E279BBB8","variant_status":"runtime_gender_keys_target_same","male":"Everyone, stop! Just hear me out!","female":"Everyone, stop! Just hear me out!","variant_male_record_index":"87041","variant_female_record_index":"87042","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"},"speaker:瘦弱的蛮血":{"text":"Scrawny Mauler","source":"瘦弱的蛮血","status":"matched_dialogue_flow"},"speaker:布莱恩":{"text":"Bryon","source":"布莱恩","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":17,"localized_text_count":16,"speaker_count":4}}