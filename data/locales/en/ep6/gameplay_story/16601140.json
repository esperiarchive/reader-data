{"asset_key":"ep6/gameplay_story_16601140","episode":"ep6","category":"gameplay_story","story_id":"16601140","schema_version":1,"lang":"en","texts":{"say:1:1660114001:0":{"text":"Happy Emberlight Festival, <style=\"stress\"><player_name></style>!","source_cn":"春焰庆快乐，<style=stress><player...","status":"matched_runtime_gender","hash_xxh64":"0x260CD1DCD335D423","variant_status":"runtime_gender_keys_target_same","male":"Happy Emberlight Festival, <style=\"stress\"><player_name></style>!","female":"Happy Emberlight Festival, <style=\"stress\"><player_name></style>!","variant_male_record_index":"218370","variant_female_record_index":"218371","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1660114002:0":{"text":"Satrana said you were putting together a lively market and insisted we stop by. Hope we're not causing trouble.","source_cn":"萨忒娜预感到你在筹备一场热闹的集市，坚持要我和她一起来...","status":"matched_runtime_gender","hash_xxh64":"0x87902571F7C746E4","variant_status":"runtime_gender_keys_target_same","male":"Satrana said you were putting together a lively market and insisted we stop by. Hope we're not causing trouble.","female":"Satrana said you were putting together a lively market and insisted we stop by. Hope we're not causing trouble.","variant_male_record_index":"218372","variant_female_record_index":"218373","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1660114002":{"text":"Satrana said you were putting together a lively market and insisted we stop by. Hope we're not causing trouble.","source_cn":"萨忒娜预感到你在筹备一场热闹的集市，坚持要我和她一起来拜访你，给你添麻烦了。","status":"matched_runtime_gender","hash_xxh64":"0x87902571F7C746E4","variant_status":"runtime_gender_keys_target_same","male":"Satrana said you were putting together a lively market and insisted we stop by. Hope we're not causing trouble.","female":"Satrana said you were putting together a lively market and insisted we stop by. Hope we're not causing trouble.","variant_male_record_index":"218372","variant_female_record_index":"218373","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1660114003:0":{"text":"See? I told you <style=\"stress\"><player_name></style> would welcome us.","source_cn":"看吧，我就说<style=stress><player...","status":"matched_runtime_gender","hash_xxh64":"0x5EBA9DF29F655BC1","variant_status":"runtime_gender_keys_target_same","male":"See? I told you <style=\"stress\"><player_name></style> would welcome us.","female":"See? I told you <style=\"stress\"><player_name></style> would welcome us.","variant_male_record_index":"218374","variant_female_record_index":"218375","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1660114004:0":{"text":"But the real blaze is over here! I can feel it. Your passion's blazing like a roaring flame, ready to spark at any second!","source_cn":"更为热情的是旁边这几位朋友！曼卡拉能感受到，你们的热情...","status":"matched","hash_xxh64":"0x952B868886370C21","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1660114005:0":{"text":"Uh... Pretty sure that isn't passion. That's something known as rage.","source_cn":"呃……我想你感受到的应该不是热情，而是一种名叫怒火的东西。","status":"matched","hash_xxh64":"0x7EB46F9865808DF4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1660114006:0":{"text":"Rage? Oh, you should save that for the Warsong Festival!","source_cn":"怒火？这种东西该留给战歌节才对！","status":"matched","hash_xxh64":"0x2397B5D46E4FB768","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1660114007:0":{"text":"The Emberlight Festival is supposed to be joyful. Why would you be angry with each other today?","source_cn":"春焰庆这么欢乐的日子，为什么要对彼此怀揣着愤怒呢？","status":"matched","hash_xxh64":"0xB64F04A450D8FECA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1660114008:1":{"text":"(Sigh) It's a long story.","source_cn":"唉，这事说来就话长了……","status":"matched","hash_xxh64":"0xC5AE13BF7D9B890B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:1660114009:0":{"text":"Zanie recounts what happened earlier.","source_cn":"祖娅迅速地复述了一遍刚才发生的争吵","status":"matched","hash_xxh64":"0x1CEF765918175451","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1660114010:0":{"text":"Oh? I get it now. Our dwarf friends who've traveled from afar and our Wilder friend... seem to have very different tastes, and just can't see eye to eye, huh?","source_cn":"哦！曼卡拉明白了，远道而来的矮人朋友和绿裔朋友审美不同...","status":"matched","hash_xxh64":"0x7E017CE94CCBC07B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1660114011:0":{"text":"Exactly!","source_cn":"没错，就是这样！","status":"matched","hash_xxh64":"0xE562DF6842F8C124","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1660114012:1":{"text":"So we need some new friends to be the judge of that.","source_cn":"所以我们需要一些新朋友来帮忙判断谁说的更对。","status":"matched","hash_xxh64":"0x3050D57CF6109DEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1660114013:0":{"text":"Why not ask <style=\"stress\"><player_name></style>?","source_cn":"为什么不直接问<style=stress><playe...","status":"matched_runtime_gender","hash_xxh64":"0x8753A8CE3D8C753B","variant_status":"runtime_gender_keys_target_same","male":"Why not ask <style=\"stress\"><player_name></style>?","female":"Why not ask <style=\"stress\"><player_name></style>?","variant_male_record_index":"218385","variant_female_record_index":"218386","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1660114013":{"text":"Why not ask <style=\"stress\"><player_name></style>?","source_cn":"为什么不直接问<style=stress><player_name></style>？<male>他</male><female>她</female>才是阿瓦隆的主人。","status":"matched_runtime_gender","hash_xxh64":"0x8753A8CE3D8C753B","variant_status":"runtime_gender_keys_target_same","male":"Why not ask <style=\"stress\"><player_name></style>?","female":"Why not ask <style=\"stress\"><player_name></style>?","variant_male_record_index":"218385","variant_female_record_index":"218386","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1660114014:0":{"text":"No worries! Leave it to me! I promise I'll make the perfect call for everyone!","source_cn":"不用担心！这件事就交给曼卡拉吧！曼卡拉一定会替大家做出...","status":"matched","hash_xxh64":"0xBB5579BA4A6C4BB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1660114015:0":{"text":"Now then, come on! You three fiery friends, lend me your ears...","source_cn":"来！三位热情高涨的朋友，听我和你们说……","status":"matched","hash_xxh64":"0x85FB8A908559CBFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:0:1":{"text":"Please don't put me in this tough spot!","source_cn":"我不想得罪人！","status":"matched_runtime_gender","hash_xxh64":"0x28E82A7848D84E0E","variant_status":"runtime_gender_keys_target_same","male":"Please don't put me in this tough spot!","female":"Please don't put me in this tough spot!","variant_male_record_index":"86807","variant_female_record_index":"86808","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:1:2":{"text":"I can work with either style.","source_cn":"两种风格我都能接受","status":"matched_runtime_gender","hash_xxh64":"0x85CFAA3DC5A93171","variant_status":"runtime_gender_keys_target_same","male":"I can work with either style.","female":"I can work with either style.","variant_male_record_index":"86809","variant_female_record_index":"86810","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:20:2:3":{"text":"We should prioritize what guests will like.","source_cn":"既然是招待客人的地方，客人喜欢最要紧","status":"matched_runtime_gender","hash_xxh64":"0x6A73FB432375B2CE","variant_status":"runtime_gender_keys_target_same","male":"We should prioritize what guests will like.","female":"We should prioritize what guests will like.","variant_male_record_index":"86811","variant_female_record_index":"86812","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"Satrana's divinations are so accurate!","source_cn":"萨忒娜的占卜还是那么准","status":"matched_runtime_gender","hash_xxh64":"0x95035622DFFF2104","variant_status":"runtime_gender_keys_target_same","male":"Satrana's divinations are so accurate!","female":"Satrana's divinations are so accurate!","variant_male_record_index":"86803","variant_female_record_index":"86804","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:1:2":{"text":"The more, the merrier!","source_cn":"来得正好，人越多越热闹！","status":"matched_runtime_gender","hash_xxh64":"0xFFB97F5EEB3CC28A","variant_status":"runtime_gender_keys_target_same","male":"The more, the merrier!","female":"The more, the merrier!","variant_male_record_index":"86805","variant_female_record_index":"86806","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:安丹德拉":{"text":"Antandra","source":"安丹德拉","status":"matched_dialogue_flow"},"speaker:萨忒娜":{"text":"Satrana","source":"萨忒娜","status":"matched_dialogue_flow"},"speaker:曼卡拉":{"text":"Mikola","source":"曼卡拉","status":"matched_dialogue_flow"},"speaker:祖娅":{"text":"Zanie","source":"祖娅","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"},"speaker:达米安":{"text":"Damian","source":"达米安","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":23,"localized_text_count":22,"speaker_count":6}}