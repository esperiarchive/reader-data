{"asset_key":"ep4/quest_story_14234150","episode":"ep4","category":"quest_story","story_id":"14234150","schema_version":1,"lang":"en","texts":{"say:2:1423415001:1":{"text":"Here's the fish you asked for. Now, about our payment...","source_cn":"你要的鱼钓回来啦！说好的重金求购！","status":"matched","hash_xxh64":"0xFDF06874E344BA4F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423415002:1":{"text":"Of course. Fair trade. Take a look. Happy with the amount?","source_cn":"当然，一手交钱一手交货嘛！您看看，这个数，满意吧？","status":"matched_runtime_gender","hash_xxh64":"0xF7DF8ADF319F0F9D","variant_status":"runtime_gender_keys_target_same","male":"Of course. Fair trade. Take a look. Happy with the amount?","female":"Of course. Fair trade. Take a look. Happy with the amount?","variant_male_record_index":"170300","variant_female_record_index":"170301","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1423415002":{"text":"Of course. Fair trade. Take a look. Happy with the amount?","source_cn":"当然，一手交钱一手交货嘛！您看看，这个数，满意吧？","status":"matched_runtime_gender","hash_xxh64":"0xF7DF8ADF319F0F9D","variant_status":"runtime_gender_keys_target_same","male":"Of course. Fair trade. Take a look. Happy with the amount?","female":"Of course. Fair trade. Take a look. Happy with the amount?","variant_male_record_index":"170300","variant_female_record_index":"170301","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423415003:1":{"text":"Haha! What a steal!","source_cn":"哈哈哈，这下赚了，赚大发了！","status":"matched","hash_xxh64":"0xF44AFFE414EFCB5F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_