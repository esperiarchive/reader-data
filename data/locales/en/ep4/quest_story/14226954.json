{"asset_key":"ep4/quest_story_14226954","episode":"ep4","category":"quest_story","story_id":"14226954","schema_version":1,"lang":"en","texts":{"say:1:1422695401:0":{"text":"No more lies. Tell us, where did you get all the Divine Dew from?","source_cn":"谎言止步于此，德莱雅。灵露从何而来？","status":"matched","hash_xxh64":"0x545B0A5D74B60501","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1422695402:0":{"text":"Hmph! I have nothing to say to you.","source_cn":"哼！我不会告诉你的。","status":"matched","hash_xxh64":"0xF5A27100680B7910","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1422695403:0":{"text":"Do you think being stubborn will get you through this?","source_cn":"你以为嘴硬可以扛过去吗？","status":"matched","hash_xxh64":"0xF7EA6EAF695ADA6E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1422695404:0":{"text":"My faith is unshakable. I'd sooner die than betray it.","source_cn":"我的信仰坚定，宁死也不会背叛。","status":"matched","hash_xxh64":"0xCF82A8740F95708D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1422695405:0":{"text":"Die? Who spoke of killing? Ravion has a thousand ways to make you speak, but none will be quick or painless.","source_cn":"死？谁说要你死了？沙利叶有一千种方法让你开口，却不会给...","status":"matched","hash_xxh64":"0x25160FAABFF4BDFD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1422695406:0":{"text":"You're bluffing! He wouldn't... He's not like that!","source_cn":"沙利叶……他才不会！你在虚张声势！","status":"matched","hash_xxh64":"0x12A2D791E498CBF9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1422695407:0":{"text":"Do you really want to test that belief? You forget who raised him.","source_cn":"你真的想试试？别忘了他是谁的儿子！","status":"matched","hash_xxh64":"0x2AC9AA56078F2DB8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1422695408:0":{"text":"... The Queen. Her Majesty... Fine. I'll speak.","source_cn":"女王……女王陛下……够了，我说。","status":"matched","hash_xxh64":"0xC6286B74576387BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1422695409:0":{"text":"It's Lord Thador. He's hiding in the <style=\"highlight\">Burning Hollow</style>...","source_cn":"是都铎大人……他在地底的<style=highligh...","status":"matched","hash_xxh64":"0xD7708CFC6EF48412","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1422695409":{"text":"It's Lord Thador. He's hiding in the <style=\"highlight\">Burning Hollow</style>...","source_cn":"是都铎大人……他在地底的<style=highlight>烈焰岩窟</style>……","status":"matched","hash_xxh64":"0xD7708CFC6EF48412","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1422695410:0":{"text":"He disappeared after the dragon left. It makes sense now. He's been biding his time in the shadows.","source_cn":"龙飞走后，都铎就不见了。他应该一直藏在暗处。","status":"matched","hash_xxh64":"0xB680BA47A4BD69B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1422695411:0":{"text":"I'll have Delia taken away, and then we'll go straight to Thador.","source_cn":"我叫人把德莱雅带走，然后我们直接去找都铎。","status":"matched","hash_xxh64":"0x3B7ECEFFA8854F90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1422695411":{"text":"I'll have Delia taken away, and then we'll go straight to Thador.","source_cn":"我叫人把德莱雅带走，然后我们直接去找都铎。","status":"matched","hash_xxh64":"0x3B7ECEFFA8854F90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1422695412:0":{"text":"I learned from Ravion. Effective, it seems.","source_cn":"我跟沙利叶学的，目前来看成效尚可。","status":"matched","hash_xxh64":"0x130A263CEA84168E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1422695413:0":{"text":"Ravion inherited Seralyth's cunning but wields it differently.","source_cn":"沙利叶继承了奈萨雷斯的敏锐，却不像她那样直接展示力量。","status":"matched","hash_xxh64":"0x52288C661612094B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1422695414:0":{"text":"He disarms with charm before striking.","source_cn":"他更喜欢用微笑和闲谈让对手放松警惕，然后一击必中。","status":"matched","hash_xxh64":"0xBAFDC21EC7AEBE8F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1422695415:0":{"text":"He sounds quite skilled.","source_cn":"听起来沙利叶很有手段。","status":"matched","hash_xxh64":"0x08006BA66669D25F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1422695416:0":{"text":"Ravion's more complicated than anyone imagines. He was raised in his mother's shadow yet carved an opposite path...","source_cn":"沙利叶比任何人想象的都要复杂。他在他母亲的阴影之下，却...","status":"matched","hash_xxh64":"0xEB4356AD57416ACA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1422695417:0":{"text":"But now's not the time to discuss Ravion. We need to meet with Thador.","source_cn":"不过，现在不是讨论沙利叶的时候，我们得去会一会都铎了。","status":"matched","hash_xxh64":"0x417C94D847A36DC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"You've changed.","source_cn":"你变坏了","status":"matched_runtime_gender","hash_xxh64":"0x3BA21F4D08C05A10","variant_status":"runtime_gender_keys_target_same","male":"You've changed.","female":"You've changed.","variant_male_record_index":"73516","variant_female_record_index":"73517","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:1:2":{"text":"You've learned to bluff.","source_cn":"学会用沙利叶和奈萨雷斯唬人了","status":"matched_runtime_gender","hash_xxh64":"0xC6E75EEE0199BA89","variant_status":"runtime_gender_keys_target_same","male":"You've learned to bluff.","female":"You've learned to bluff.","variant_male_record_index":"73518","variant_female_record_index":"73519","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"Thador? I thought he already...","source_cn":"都铎？我以为他已经……","status":"matched_runtime_gender","hash_xxh64":"0xCA0E9DD26DE58514","variant_status":"runtime_gender_keys_target_same","male":"Thador? I thought he already...","female":"Thador? I thought he already...","variant_male_record_index":"73514","variant_female_record_index":"73515","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"matched_dialogue_flow"},"speaker:祭司德莱雅":{"text":"Priestess Delia","source":"祭司德莱雅","status":"matched_dialogue_flow"},"speaker:埃隆":{"text":"Eironn","source":"埃隆","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":23,"localized_text_count":22,"speaker_count":3}}