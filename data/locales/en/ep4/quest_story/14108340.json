{"asset_key":"ep4/quest_story_14108340","episode":"ep4","category":"quest_story","story_id":"14108340","schema_version":1,"lang":"en","texts":{"say:2:1410834001:1":{"text":"It's beautiful... A mythical relic created by Helthor himself!","source_cn":"太漂亮了……这就是赫托亲手所铸的传奇！","status":"matched","hash_xxh64":"0x635A6B56BEF6A5A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1410834002:1":{"text":"The gears rotate and chase enemies for thousands of miles. It always finds its target. The legendary <style=\"highlight\">Eclipsion</style>!","source_cn":"齿轮交错运转，万里逐敌，开弓必中！伟大而闪耀的<sty...","status":"matched","hash_xxh64":"0xBE083CE459422A97","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1410834003:1":{"text":"Did you two hear that...?","source_cn":"……你们听到了吗？","status":"matched","hash_xxh64":"0x23B9101B909ABCAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410834004:0":{"text":"Do you mean the roar the Eclipsion just let out? Yeah!","source_cn":"你是指杜恩加尔刚才的震鸣声吗？","status":"matched","hash_xxh64":"0x634A2FDE630CD422","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1410834005:0":{"text":"As expected of a weapon forged by a god... It has its own soul. Ah, I wish I had the skills to match...","source_cn":"不愧是神的造物……它拥有自己的灵魂！唉……这就是我无法...","status":"matched","hash_xxh64":"0x9836CEA9D040FC4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1410834006:1":{"text":"No, not that. Do you hear something right now...?","source_cn":"不，和刚才的声音不一样。","status":"matched","hash_xxh64":"0xF12E53AF62554236","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1410834007:1":{"text":"...No? <style=\"stress\"><player_name></style>, do you hear anything?","source_cn":"我没听见。<style=stress><player_...","status":"matched_runtime_gender","hash_xxh64":"0x4567778056B2D112","variant_status":"runtime_gender_keys_target_same","male":"...No? <style=\"stress\"><player_name></style>, do you hear anything?","female":"...No? <style=\"stress\"><player_name></style>, do you hear anything?","variant_male_record_index":"160391","variant_female_record_index":"160392","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1410834007":{"text":"...No? <style=\"stress\"><player_name></style>, do you hear anything?","source_cn":"我没听见。<style=stress><player_name></style>，你听见了吗？","status":"matched_runtime_gender","hash_xxh64":"0x4567778056B2D112","variant_status":"runtime_gender_keys_target_same","male":"...No? <style=\"stress\"><player_name></style>, do you hear anything?","female":"...No? <style=\"stress\"><player_name></style>, do you hear anything?","variant_male_record_index":"160391","variant_female_record_index":"160392","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1410834008:1":{"text":"It's so loud I can hear it over both of your voices...","source_cn":"它并不是在喃喃低语，它的声音很洪亮。你们听不到吗？","status":"matched","hash_xxh64":"0xFBD7D4E343DD89EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1410834010:1":{"text":"What is it, Indris?","source_cn":"因度厄，你听到什么了？","status":"matched","hash_xxh64":"0x92020D1FBD308837","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1410834011:1":{"text":"It's calling my name. <style=\"highlight\">It's telling me to pick it up.</style>","source_cn":"它在呼唤我的名字，<style=highlight>命...","status":"matched","hash_xxh64":"0x325F4EE2927CA311","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1410834011":{"text":"It's calling my name. <style=\"highlight\">It's telling me to pick it up.</style>","source_cn":"它在呼唤我的名字，<style=highlight>命令我拿起它</style>。","status":"matched","hash_xxh64":"0x325F4EE2927CA311","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1410834012:1":{"text":"Yes, it's a deep, powerful voice.","source_cn":"对，是浑厚有力的嗓音。","status":"matched","hash_xxh64":"0xC11BCCB9FA63A836","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1410834014:1":{"text":"Oh... it could be Helthor's voice!","source_cn":"我猜……是赫托老爹的声音。","status":"matched","hash_xxh64":"0x51B8553EA46A962A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1410834015:1":{"text":"But why...? The Eclipsion is a relic of the dwarves!","source_cn":"啊啊啊……为什么！赫托老爷子，杜恩加尔可是我们矮人一族...","status":"matched","hash_xxh64":"0x1EA03F3DE5C4F85E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1410834016:1":{"text":"But... if that's what Helthor really wants...","source_cn":"但是……但是……如果这是赫托的意愿……好吧！","status":"matched","hash_xxh64":"0xEAC8E3EB7E975E9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1410834017:1":{"text":"Okay! Indris, pick up the Eclipsion!","source_cn":"快！因度厄，去拿起杜恩加尔！","status":"matched","hash_xxh64":"0xB86E495921F44619","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1410834018:1":{"text":"Zanie?","source_cn":"祖娅？","status":"matched","hash_xxh64":"0x366293B31DC58291","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1410834019:1":{"text":"You listen to me! The Eclipsion is the light that shoots through the darkness!","source_cn":"你给我听好！杜恩加尔不是用来供奉的圣物，而是用来射穿黑...","status":"matched","hash_xxh64":"0x027ECD7362A2A51F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1410834020:1":{"text":"As a legendary weapon, it deserves a great warrior as its partner.","source_cn":"作为一把武器，它值得被优秀的战士好好使用。","status":"matched","hash_xxh64":"0x0541AADDDC875C2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1410834021:1":{"text":"We dwarves are magical outcasts, disqualified from using this divine bow. Otherwise, I would certainly never hand it to you...","source_cn":"我们是魔法的弃民，已经失去使用神弓的资格了，否则我肯定...","status":"matched","hash_xxh64":"0x5FD43D41E8D88D2B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1410834022:1":{"text":"Stop dawdling! Take it before I regret it! And never let it down!","source_cn":"别磨蹭了，在我后悔前把它拿走！千万……千万不要辜负它！","status":"matched","hash_xxh64":"0x2FFD00FFB2FDAF03","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1410834023:1":{"text":"I understand. I won't disappoint you.","source_cn":"明白，定不负所望。","status":"matched","hash_xxh64":"0xDC6FF336BA1ACB1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:0:1":{"text":"Is it a male voice?","source_cn":"是男性的声音吗？","status":"matched_runtime_gender","hash_xxh64":"0xD1ABD0176664EDC1","variant_status":"runtime_gender_keys_target_same","male":"Is it a male voice?","female":"Is it a male voice?","variant_male_record_index":"72246","variant_female_record_index":"72247","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1410834013:1":{"text":"It sounds like a man...","source_cn":"我认为那是男性的声音。","status":"matched","hash_xxh64":"0x9F3EC20A05342638","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:1:2":{"text":"Is it a female voice?","source_cn":"是女性的声音吗？","status":"matched_runtime_gender","hash_xxh64":"0x7026FA74BFD916EB","variant_status":"runtime_gender_keys_target_same","male":"Is it a female voice?","female":"Is it a female voice?","variant_male_record_index":"72248","variant_female_record_index":"72249","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"I can't hear anything when you're talking.","source_cn":"我仔细听听","status":"matched_runtime_gender","hash_xxh64":"0x9A0C43DC796C1311","variant_status":"runtime_gender_keys_target_same","male":"I can't hear anything when you're talking.","female":"I can't hear anything when you're talking.","variant_male_record_index":"72242","variant_female_record_index":"72243","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1410834009:1":{"text":"Am I the only one who hears it...?","source_cn":"难道只有我能听见……","status":"matched","hash_xxh64":"0xE3BD77BFB0FB3D20","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"I don't hear anything.","source_cn":"我也没听见","status":"matched_runtime_gender","hash_xxh64":"0x37C16D08F77D02DE","variant_status":"runtime_gender_keys_target_same","male":"I don't hear anything.","female":"I don't hear anything.","variant_male_record_index":"72244","variant_female_record_index":"72245","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:祖娅":{"text":"Zanie","source":"祖娅","status":"matched_dialogue_flow"},"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":30,"localized_text_count":29,"speaker_count":2}}