{"asset_key":"ep4/quest_story_14233210","episode":"ep4","category":"quest_story","story_id":"14233210","schema_version":1,"lang":"en","texts":{"say:1:1423321001:1":{"text":"So I hook the bait, cast it out, and watch the bobber... Got it! Let me give it a try!","source_cn":"先往鱼钩上挂上饵料，再甩钩，观察浮漂……我大概了解了。...","status":"matched","hash_xxh64":"0xB6E571589E480BE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:2:1423321002:0":{"text":"After a few tries, Orlana finally reels in a small Prism Trout.","source_cn":"练习多次后，欧罗娜终于钓上了一条体型较小的染虹鳟。","status":"matched","hash_xxh64":"0x32BE14F71E76FE57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423321003:1":{"text":"Caught it!","source_cn":"上钩了！","status":"matched","hash_xxh64":"0xFD97174CAF641FF0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:3::2":{"text":"","source_cn":"","status":"matched_item_resource","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423321004:0":{"text":"Its scales are colorful, and it has those round spots... It's a Prism Trout! I've read about it in a book, but I've never seen one in real life before!","source_cn":"鳞片的颜色五彩斑斓，上面有规律的圆形斑点……这是书上提...","status":"matched","hash_xxh64":"0x2B51204936E2159B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423321005:0":{"text":"You really do know your trivia... Now let's turn that fish into lunch.","source_cn":"你倒是懂一些杂七杂八的……接下来就该用这些鱼填饱肚子了。","status":"matched","hash_xxh64":"0x0838141A5F4F6ED6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423321006:1":{"text":"I'm guessing cooking wasn't part of priestess training?","source_cn":"做饭这种事，肯定不在祭司培训的范畴内吧？","status":"matched","hash_xxh64":"0x11A045D19CC4751A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1423321007:1":{"text":"No, it wasn't...","source_cn":"我不太会……","status":"matched","hash_xxh64":"0xADD8F03E3BE63B31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1423321007":{"text":"No, it wasn't...","source_cn":"我不太会……","status":"matched","hash_xxh64":"0xADD8F03E3BE63B31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1423321008:1":{"text":"I'll write down every step you take! I want to learn!","source_cn":"我一定记录下您的每个步骤，认真学习！","status":"matched_runtime_gender","hash_xxh64":"0xF337262DD9351622","variant_status":"runtime_gender_keys_target_same","male":"I'll write down every step you take! I want to learn!","female":"I'll write down every step you take! I want to learn!","variant_male_record_index":"169848","variant_female_record_index":"169849","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1423321009:1":{"text":"You can borrow my pot. I've got some seasonings too. Should be enough to make a nice, simple fish soup.","source_cn":"那我把锅借给你们吧，还有这些配料和调味品，简单做道鱼汤...","status":"matched","hash_xxh64":"0x4DFB5ED3160E8292","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"Let me show you how it's done.","source_cn":"我来打个样吧","status":"matched_runtime_gender","hash_xxh64":"0xA70CE62B5C798F59","variant_status":"runtime_gender_keys_target_same","male":"Let me show you how it's done.","female":"Let me show you how it's done.","variant_male_record_index":"73904","variant_female_record_index":"73905","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"},"speaker:平民奈琳":{"text":"Nadine","source":"平民奈琳","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":3}}