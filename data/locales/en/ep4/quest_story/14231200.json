{"asset_key":"ep4/quest_story_14231200","episode":"ep4","category":"quest_story","story_id":"14231200","schema_version":1,"lang":"en","texts":{"say:3:1423120001:0":{"text":"Boss, what brings you here?","source_cn":"铁须老大，您怎么来了？","status":"matched","hash_xxh64":"0x1BA08B53703CC6F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423120002:1":{"text":"Got any work for us? We can do it fast and well for you!","source_cn":"有什么活要俺们干的吗？俺们手脚麻利得很！","status":"matched","hash_xxh64":"0x282C5D6BC1B9E03B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423120003:1":{"text":"Look at you, so motivated to work now!","source_cn":"你现在干活倒是积极起来了。","status":"matched","hash_xxh64":"0xC63AEB9C39845FA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423120004:1":{"text":"Well, we've officially joined Ironbeard's side.","source_cn":"毕竟俺们正式加入铁须老大这边了嘛。","status":"matched","hash_xxh64":"0xA0690A0E50E58C26","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423120005:1":{"text":"No need to do anything now.","source_cn":"现在还用不着你们动手干活。","status":"matched","hash_xxh64":"0xD6EC44D77195FA44","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423120006:1":{"text":"If what I see later is good enough, I believe everyone will be eager to put in the work.","source_cn":"要是等会看到的东西能让我满意，我相信大伙干多少活都愿意。","status":"matched","hash_xxh64":"0x304F7833E6E232E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1423120007:1":{"text":"Fair enough... We'll gather the celestrites ourselves.","source_cn":"行吧……既然没有人干活，我们就亲自去采些天青矿吧。","status":"matched","hash_xxh64":"0x3B008C128CB3496D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:怠惰的矮人":{"text":"Lazy Dwarf","source":"怠惰的矮人","status":"matched_dialogue_flow"},"speaker:海拉":{"text":"Hyla","source":"海拉","status":"matched_dialogue_flow"},"speaker:铁须":{"text":"Ironbeard","source":"铁须","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":3}}