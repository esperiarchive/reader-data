{"asset_key":"ep4/quest_story_14221150","episode":"ep4","category":"quest_story","story_id":"14221150","schema_version":1,"lang":"en","texts":{"say:1:1422115001:1":{"text":"Lord Lolde! We finally found you! Come back with us!","source_cn":"少爷！终于找到您了，跟我们回去吧！","status":"matched","hash_xxh64":"0x6A4CB911F2209DB8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1422115002:1":{"text":"I know my mother sent you all to find me... I'm afraid I'll have to disappoint you. I have no plans of returning.","source_cn":"我知道你们是母亲派来找我的……恐怕要让你们失望了，我不...","status":"matched","hash_xxh64":"0xDC21863C5CCFA502","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1422115003:1":{"text":"We know about you and Elsa. Where is she? Would you be willing to return if we remove the Stigma from her?","source_cn":"我们知道你和艾莎的事了，艾莎现在在哪？如果为她消除印记...","status":"matched","hash_xxh64":"0x6D1C3DA79BC36D94","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1422115004:1":{"text":"Ha... Remove the Stigma... Unfortunately, it's too late for that.","source_cn":"呵……消除印记……可惜一切都太晚了。","status":"matched","hash_xxh64":"0xDD610C60E79F3134","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:女仆瑟雅":{"text":"Lowborn Seya","source":"女仆瑟雅","status":"matched_dialogue_flow"},"speaker: