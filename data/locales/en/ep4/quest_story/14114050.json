{"asset_key":"ep4/quest_story_14114050","episode":"ep4","category":"quest_story","story_id":"14114050","schema_version":1,"lang":"en","texts":{"say:1:1411405001:0":{"text":"That took a while. The earthquake must've spooked them, and they ran out here. Luckily, we were here to stop them.","source_cn":"总算击退了，恐怕是被地震吓得跑出来的，这么没头没尾地乱撞。","status":"matched","hash_xxh64":"0xF86D8A24643D8C06","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1411405002:0":{"text":"Is everyone okay?","source_cn":"各位，没什么事吧？","status":"matched","hash_xxh64":"0x66B989F2632DD894","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1411405002":{"text":"Is everyone okay?","source_cn":"各位，没什么事吧？","status":"matched","hash_xxh64":"0x66B989F2632DD894","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1411405003:0":{"text":"No cracks in the walls or floor, and there was little debris.","source_cn":"地面和墙壁也没有裂缝，碎石影响也不大。","status":"matched","hash_xxh64":"0x0E245BCE2A41BFB1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1411405004:0":{"text":"There was a lot of shaking, though. How are the miners inside?","source_cn":"只是刚刚摇晃得太厉害了，里头的矿工会不会有什么问题？","status":"matched","hash_xxh64":"0xB50AF44227AD6706","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1411405005:0":{"text":"Our miners are experienced and have been through earthquakes before, but that one was way too sudden...","source_cn":"这里的矿工经验丰富，应该知道怎么躲避，只是这地震也太突...","status":"matched","hash_xxh64":"0xC3A26F3915BB8E66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1411405006:0":{"text":"Let's go inside and take a look then. If someone needs help, I can lend a hand.","source_cn":"以防万一，我们赶紧进去看看吧，万一有事，我也好搭把手。","status":"matched","hash_xxh64":"0xFD9055AF427C9618","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1411405007:0":{"text":"I can't possibly ask you to help. You're here on business...","source_cn":"这、这怎么行，你们是来商务考察的……","status":"matched","hash_xxh64":"0xEE69F10436421A64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1411405008:0":{"text":"We're wasting time. Didn't you say you wanted our cooperation to be more straightforward?","source_cn":"别浪费时间了，祖娅，你不是说过，讨厌那些弯弯绕绕的交涉...","status":"matched","hash_xxh64":"0x851251A5D4A20CA1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1411405009:0":{"text":"When there's a disaster, every hand is needed. Let's go.","source_cn":"多个人多份力，救灾要及时，我们快走吧。","status":"matched","hash_xxh64":"0x9E641AA4736C74C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1411405010:0":{"text":"Thank you.","source_cn":"那，就多谢你了，巴赫朗。","status":"matched","hash_xxh64":"0x366F5915B8B4B0C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"We're fine.","source_cn":"我们没事","status":"matched_runtime_gender","hash_xxh64":"0x0E5DBEDFF91DF495","variant_status":"runtime_gender_keys_target_same","male":"We're fine.","female":"We're fine.","variant_male_record_index":"73290","variant_female_record_index":"73291","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:祖娅":{"text":"Zanie","source":"祖娅","status":"matched_dialogue_flow"},"speaker:巴赫朗":{"text":"Baelran","source":"巴赫朗","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":2}}