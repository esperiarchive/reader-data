{"asset_key":"ep4/quest_story_14106354","episode":"ep4","category":"quest_story","story_id":"14106354","schema_version":1,"lang":"en","texts":{"say:2:1410635401:1":{"text":"Got everything?","source_cn":"工具都拿到了吗？","status":"matched","hash_xxh64":"0xDCB855FA099D013F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1410635402:1":{"text":"Yes. They're all here.","source_cn":"都在这里了。","status":"matched","hash_xxh64":"0xB684F5A9354B4FBB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1410635403:1":{"text":"Great, perfect haul. Just give me a minute, it's my time to shine!","source_cn":"不错，很齐全。你们等我一会，该我大显身手了！","status":"matched","hash_xxh64":"0x040827B4FC403F27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:6:1410635404:0":{"text":"A series of clinks and clangs later, Zanie fixes the boat.","source_cn":"一阵叮铃哐啷的声音后，祖娅修好了船。","status":"matched_runtime_gender","hash_xxh64":"0x454967B4C91D025A","variant_status":"runtime_gender_keys_target_same","male":"A series of clinks and clangs later, Zanie fixes the boat.","female":"A series of clinks and clangs later, Zanie fixes the boat.","variant_male_record_index":"161667","variant_female_record_index":"161668","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1410635405:1":{"text":"Ta-da! What do you think? All compliments are accepted!","source_cn":"大功告成！如何？看看这完美的修复！","status":"matched","hash_xxh64":"0x26D89C0A89E240FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1410635406:1":{"text":"See, every gear fits together just right, and the system runs smoother than a dream.","source_cn":"每个齿轮都严丝合缝，传动系统比新的还顺滑。","status":"matched","hash_xxh64":"0x629F5D37D86DDEAA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1410635407:1":{"text":"This is true dwarven craftsmanship, not some flashy magic. Give me a wrench, and I can fix anything!","source_cn":"这可是矮人工匠的手艺，不是那些花里胡哨的魔法能比的。给...","status":"matched","hash_xxh64":"0x1C06508FD591E127","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1410635408:1":{"text":"...Alright, it's time to put it to the test.","source_cn":"……时间差不多了，该试试你的船了。","status":"matched","hash_xxh64":"0x8708AD08A9699184","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1410635409:1":{"text":"Hey, don't give me that look! We'll find out for sure—let's go!","source_cn":"喂！别一副信不过我的样子！咱们实践出真知，走！","status":"matched","hash_xxh64":"0xE08FB32874EA7F2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:祖娅":{"text":"Zanie","so