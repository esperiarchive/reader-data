{"asset_key":"ep4/quest_story_14226952","episode":"ep4","category":"quest_story","story_id":"14226952","schema_version":1,"lang":"en","texts":{"say:2:1422695201:1":{"text":"Brothers and sisters, behold the radiance of true Divine Dew! And now... compare it to the diluted mockery in your hands.","source_cn":"兄弟姐妹们，看看这纯净的恩典灵露！再对比你们手中被稀释...","status":"matched","hash_xxh64":"0xADE21A3968CB7E15","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:2::2":{"text":"Divine Dew","source_cn":"恩典灵露","status":"matched","hash_xxh64":"0xAC3E3ED43C4AD3AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1422695202:1":{"text":"You've all been deceived by Ravion! There's no curse! Dragons don't exist!","source_cn":"你们被沙利叶欺骗了！根本没有什么诅咒！龙也并不存在！","status":"matched","hash_xxh64":"0x1E1ED1BBCC270FB5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1422695203:1":{"text":"The truth is this: our supply of Divine Dew is dwindling, and Ravion—","source_cn":"唯一的真相是灵露即将枯竭，沙利叶——","status":"matched","hash_xxh64":"0x946DAD5064E63C97","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1422695204:1":{"text":"Enough lies!","source_cn":"住口，一派胡言！","status":"matched","hash_xxh64":"0xCC785A474F218152","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1422695205:1":{"text":"Indris! Ravion's lapdog! Seize them!","source_cn":"因度厄！是沙利叶的走狗！抓住他们！","status":"matched","hash_xxh64":"0x1AA480A4914A23CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:祭司德莱雅":{"text":"Priestess Delia","source":"祭司德莱雅","status":"matched_dialogue_flow"},"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":2}}