{"asset_key":"ep4/quest_story_14213360","episode":"ep4","category":"quest_story","story_id":"14213360","schema_version":1,"lang":"en","texts":{"say:1:1421336001:1":{"text":"We'll never betray Inna!","source_cn":"我们绝不会出卖伟大的伊娜！","status":"matched","hash_xxh64":"0xD9792D88F24657B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1421336001":{"text":"We'll never betray Inna!","source_cn":"我们绝不会出卖伟大的伊娜！","status":"matched","hash_xxh64":"0xD9792D88F24657B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1421336002:1":{"text":"You better believe it! We may not be the smartest bunch, but our hearts are noble!","source_cn":"你明白就好，我们虽然不聪明，但我们品质高尚！","status":"matched_runtime_gender","hash_xxh64":"0x7B75FE831CEFD65E","variant_status":"runtime_gender_keys_target_same","male":"You better believe it! We may not be the smartest bunch, but our hearts are noble!","female":"You better believe it! We may not be the smartest bunch, but our hearts are noble!","variant_male_record_index":"162179","variant_female_record_index":"162180","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1421336004:1":{"text":"Inna has a plan for us! All of us!","source_cn":"总之，伊娜领袖自有她自己的打算！","status":"matched","hash_xxh64":"0x5D37324CBE136866","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1421336004":{"text":"Inna has a plan for us! All of us!","source_cn":"总之，伊娜领袖自有她自己的打算！","status":"matched","hash_xxh64":"0x5D37324CBE136866","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1421336005:1":{"text":"It's to revive the Ironheart Dominion and restore the glory of our ancient technologies!","source_cn":"就是复兴钢心帝国，重现古代技术的荣光！","status":"matched","hash_xxh64":"0xA85DC190F3B9D7F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1421336007:1":{"text":"Inna can do anything! She can accomplish this as well!","source_cn":"伊娜无论做什么都做得很好，她绝对能办到的！","status":"matched","hash_xxh64":"0x58D0872D1BEB026B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1421336007":{"text":"Inna can do anything! She can accomplish this as well!","source_cn":"伊娜无论做什么都做得很好，她绝对能办到的！","status":"matched","hash_xxh64":"0x58D0872D1BEB026B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1421336008:1":{"text":"Yes, with Inna by our side, no dream is out of reach!","source_cn":"那当然，有伊娜在，无论什么梦想都不会遥不可及！","status":"matched","hash_xxh64":"0x7EADC6751440F342","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1421336010:1":{"text":"We all have our own jobs too!","source_cn":"总之，我们也有自己的工作！","status":"matched","hash_xxh64":"0xE996B1C753C2D64A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1421336010":{"text":"We all have our own jobs too!","source_cn":"总之，我们也有自己的工作！","status":"matched","hash_xxh64":"0xE996B1C753C2D64A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1421336011:1":{"text":"Yes, there are some who have good grades and are smarter than us... but we are the most loyal!","source_cn":"有是有，成绩好的，聪明的……但，但我们也很忠诚！","status":"matched","hash_xxh64":"0x34780E5E34FADCCF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1421336014:1":{"text":"We'll never betray Inna! We'll follow her to the end!","source_cn":"总之，我们一定会跟随伊娜，绝不会出卖她！","status":"matched","hash_xxh64":"0xF1B7CC28B3EAA70A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1421336014":{"text":"We'll never betray Inna! We'll follow her to the end!","source_cn":"总之，我们一定会跟随伊娜，绝不会出卖她！","status":"matched","hash_xxh64":"0xF1B7CC28B3EAA70A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1421336015:1":{"t