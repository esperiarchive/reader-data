{"asset_key":"ep4/quest_story_14213460","episode":"ep4","category":"quest_story","story_id":"14213460","schema_version":1,"lang":"en","texts":{"say:1:1421346001:1":{"text":"Blueprint? I don't know what you're talking about.","source_cn":"什么图纸，我没听说过！","status":"matched","hash_xxh64":"0x441ADE4878A83199","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1421346001":{"text":"Blueprint? I don't know what you're talking about.","source_cn":"什么图纸，我没听说过！","status":"matched","hash_xxh64":"0x441ADE4878A83199","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1421346002:1":{"text":"Like I said, I don't know anything about what you're talking about!","source_cn":"没错，你们说的我都不知道！","status":"matched","hash_xxh64":"0x89A980D8B4CE1384","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1421346004:1":{"text":"You're not going to get anything out of me!","source_cn":"你们想从我这里套话是不可能的！","status":"matched","hash_xxh64":"0x28A913AE6DF5038C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1421346004":{"text":"You're not going to get anything out of me!","source_cn":"你们想从我这里套话是不可能的！","status":"matched","hash_xxh64":"0x28A913AE6DF5038C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1421346005:1":{"text":"Hmph! Believe what you want.","source_cn":"哼，随便你怎么说！","status":"matched_runtime_gender","hash_xxh64":"0x00C7DE5591210AF7","variant_status":"runtime_gender_keys_target_same","male":"Hmph! Believe what you want.","female":"Hmph! Believe what you want.","variant_male_record_index":"163843","variant_female_record_index":"163844","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1421346007:1":{"text":"Even if there really was a blueprint from the Ironheart Dominion, it would belong to me anyway!","source_cn":"就算真有钢心帝国的图纸，归我所有也是理所应当的！","status":"matched","hash_xxh64":"0xE61856842C3A404D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1421346007":{"text":"Even if there really was a blueprint from the Ironheart Dominion, it would belong to me anyway!","source_cn":"就算真有钢心帝国的图纸，归我所有也是理所应当的！","status":"matched","hash_xxh64":"0xE61856842C3A404D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1421346008:1":{"text":"You want it? Get on your knees and beg for it!","source_cn":"哈，想要吗？求我啊！","status":"matched_runtime_gender","hash_xxh64":"0x9895C67AEE8CE8C1","variant_status":"runtime_gender_keys_target_same","male":"You want it? Get on your knees and beg for it!","female":"You want it? Get on your knees and beg for it!","variant_male_record_index":"163847","variant_female_record_index":"163848","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1421346010:1":{"text":"I'm tired of this. You'll never get your hands on the blueprint or my research!","source_cn":"哼，总之，你们不可能拿到图纸，更无法看到我的研究进度！","status":"matched","hash_xxh64":"0x9061405E94378398","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1421346010":{"text":"I'm tired of this. You'll never get your hands on the blueprint or my research!","source_cn":"哼，总之，你们不可能拿到图纸，更无法看到我的研究进度！","status":"matched","hash_xxh64":"0x9061405E94378398","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1421346011:1":{"text":"Are you an idiot?! Don't you know how far I've come with my research?!","source_cn":"开什么玩笑？！你们不知道我伟大的研究进展到了什么程度吗？！","status":"matched","hash_xxh64":"0xF81F9E219DFE9166","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1421346014:1":{"text":"A blueprint as precious as this, from the age of the Ironheart Dominion, will never be surrendered to you!","source_cn":"记载了钢心帝国伟大成果的宝贵图纸绝不可能交给你们！","status":"matched","hash_xxh64":"0x532BDC4590BDBACB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:14:1421346014":{"text":"A blueprint as precious as this, from the age of the Ironheart Dominion, will never be surrendered to you!","source_cn":"记载了钢心帝国伟大成果的宝贵图纸绝不可能交给你们！","status":"matched","hash_xxh64":"0x532BDC4590BDBACB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1421346015:1":{"text":"I tore it up! Put it back together if you can!","source_cn":"我已经把图纸撕碎了！你们有本事就把它复原吧！","status":"matched","hash_xxh64":"0x06134C90D68CC63A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"Where's the blueprint?","source_cn":"图纸到底在哪里！","status":"matched_runtime_gender","hash_xxh64":"0x9B0EE0177B0D670D","variant_status":"runtime_gender_keys_target_same","male":"Where's the blueprint?","female":"Where's the blueprint?","variant_male_record_index":"72722","variant_female_record_index":"72723","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"We just want the blueprint.","source_cn":"我们只想知道图纸","status":"matched_runtime_gender","hash_xxh64":"0x9C58ABAE0E00BB43","variant_status":"runtime_gender_keys_target_same","male":"We just want the blueprint.","female":"We just want the blueprint.","variant_male_record_index":"72716","variant_female_record_index":"72717","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1421346012:1":{"text":"Are you looking down on me?! I hate mages! They all deserve to die!","source_cn":"你看不起我们吗！魔法师果然都该死！","status":"matched_runtime_gender","hash_xxh64":"0x8C5DDD0C4848B9CD","variant_status":"runtime_gender_keys_target_same","male":"Are you looking down on me?! I hate mages! They all deserve to die!","female":"Are you looking down on me?! I hate mages! They all deserve to die!","variant_male_record_index":"163853","variant_female_record_index":"163854","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"It doesn't matter. Not important.","source_cn":"无所谓，不重要","status":"matched_runtime_gender","hash_xxh64":"0xA8AD21416ECD9587","variant_status":"runtime_gender_keys_target_same","male":"It doesn't matter. Not important.","female":"It doesn't matter. Not important.","variant_male_record_index":"72718","variant_female_record_index":"72719","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1421346013:1":{"text":"Who the heck are you talking to?! I'm Inna! I'm the one who's going to revive the Ironheart Dominion!","source_cn":"你在跟谁说话！我是伟大的钢心帝国复兴者，伊娜！","status":"matched_runtime_gender","hash_xxh64":"0x00E8E368F8023773","variant_status":"runtime_gender_keys_target_same","male":"Who the heck are you talking to?! I'm Inna! I'm the one who's going to revive the Ironheart Dominion!","female":"Who the heck are you talking to?! I'm Inna! I'm the one who's going to revive the Ironheart Dominion!","variant_male_record_index":"163855","variant_female_record_index":"163856","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:2:3":{"text":"Can you even understand the blueprint?","source_cn":"你看得懂图纸吗？","status":"matched_runtime_gender","hash_xxh64":"0xEEA547A5DBDEA7D9","variant_status":"runtime_gender_keys_target_same","male":"Can you even understand the blueprint?","female":"Can you even understand the blueprint?","variant_male_record_index":"72720","variant_female_record_index":"72721","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"You'd better hand it over.","source_cn":"你还是交出来吧","status":"matched