{"asset_key":"ep4/quest_story_14103121","episode":"ep4","category":"quest_story","story_id":"14103121","schema_version":1,"lang":"en","texts":{"say:3:1410312101:0":{"text":"Thank you for your hospitality. I plan to depart in two days.","source_cn":"感谢诸位的热情招待，我打算两日后启程返回。","status":"matched","hash_xxh64":"0xFF03565B42BAF27A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1410312102:0":{"text":"I'll make sure to report everything from this inspection with the utmost honesty to my superiors.","source_cn":"此次的视察结果，我也会如实向上汇报。","status":"matched","hash_xxh64":"0x7517869D3264F298","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410312103:0":{"text":"I'll be counting on you to sing our praises back in the city!","source_cn":"那就拜托霍根将军多多美言！","status":"matched","hash_xxh64":"0xF2B56AA095978188","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1410312104:0":{"text":"Roban, don't just stand there—bring the wine, lad!","source_cn":"隆多，隆多，拿酒来！","status":"matched","hash_xxh64":"0xDB58C21C02C08559","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:霍根":{"text":"Hogan","source":"霍根","status":"matched_dialogue_flow"},"speaker:弗林":{"text":"Eldric","source":"弗林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_te