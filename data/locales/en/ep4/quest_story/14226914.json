ocument_title_status":""},"say:7:1422691406:1":{"text":"It throbbed with promise... it sang to me... It was so rich. I took what I needed...","source_cn":"那是、养分、是生命力……","status":"matched","hash_xxh64":"0x5F09DD979B0BDBB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1422691407:0":{"text":"So it was you. The one who forced my people into exile.","source_cn":"这就是当年导致我族被驱逐的罪魁祸首？","status":"matched","hash_xxh64":"0xE15E6B91CC6F5F3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1422691407":{"text":"So it was you. The one who forced my people into exile.","source_cn":"这就是当年导致我族被驱逐的罪魁祸首？","status":"matched","hash_xxh64":"0xE15E6B91CC6F5F3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1422691408:0":{"text":"She's within the Ivory Tree. If she breaks free, every living thing in the Vaduso Mountains could be wiped out!","source_cn":"她竟然身处在皎月树内部，一旦破出，瓦度索山脉的所有生灵...","status":"matched","hash_xxh64":"0x05D509FD49093D55","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1422691409:1":{"text":"In Misarte's name, I will end this!","source_cn":"……以弥萨忒之名，我要终结你的威胁！","status":"matched","hash_xxh64":"0xA877228525428854","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","docum