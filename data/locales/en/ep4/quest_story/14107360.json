{"asset_key":"ep4/quest_story_14107360","episode":"ep4","category":"quest_story","story_id":"14107360","schema_version":1,"lang":"en","texts":{"say:1:1410736001:0":{"text":"It ends here, Zanie.","source_cn":"到此为止了，祖娅。","status":"matched","hash_xxh64":"0xD9A350DD78C4ECC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1410736002:0":{"text":"You nearly destroyed everything I've worked for with the Essail. You'll pay for that.","source_cn":"你们毁了我和艾塞勒的合作，你别想逃！我会亲自送你们上路！","status":"matched","hash_xxh64":"0xE30DA67B30CE482E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1410736003:1":{"text":"You want to kill me? You should've done it before I gathered all my knowledge, Eldric.","source_cn":"想杀我？你还早了两百年！","status":"matched","hash_xxh64":"0xB979CDCE5D9ADBEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1410736004:0":{"text":"Next time you decide to end me, don't wait around—do it right! Fool.","source_cn":"学不乖的蠢货，下次想杀你姑奶奶记得早点下手！","status":"matched","hash_xxh64":"0x64782081E9B8571E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410736005:0":{"text":"Why you—","source_cn":"你——<key:dialog41>","status":"matched","hash_xxh64":"0x94EF5DE6A9311B23","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1410736006:0":{"text":"Oh, wait. There won't be a next time.","source_cn":"哦，不好意思，差点忘了说——没有下次！","status":"matched","hash_xxh64":"0x9ACC304DA651E88A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1410736007:0":{"text":"Let's go, <style=\"stress\"><player_name></style>!","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x6BF9A6FDFAD8D32A","variant_status":"runtime_gender_keys_target_same","male":"Let's go, <style=\"stress\"><player_name></style>!","female":"Let's go, <style=\"stress\"><player_name></style>!","variant_male_record_index":"158532","variant_female_record_index":"158533","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:弗林":{"text":"Eldric","source":"弗林","status":"matched_dialogue_flow"},"speaker:祖娅":{"text":"Zanie","source":"祖娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}}