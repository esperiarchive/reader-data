{"asset_key":"ep4/quest_story_14103330","episode":"ep4","category":"quest_story","story_id":"14103330","schema_version":1,"lang":"en","texts":{"say:3:1410333001:1":{"text":"Mr. Ironbeard! Sorry to bother you, but have you seen General Hogan?","source_cn":"铁须先生，打扰了！你有没有见过霍根将军？","status":"matched","hash_xxh64":"0x211EB17ECAE8ABB5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1410333002:1":{"text":"Bah! How should I know? Don't bother me! I'm up to my beard in work!","source_cn":"不知道！别来问我，我忙死了！","status":"matched","hash_xxh64":"0x952BB94024421449","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410333003:1":{"text":"A supply shortage at a time like this... It's a disaster! Our entire production line's slowing to a crawl!","source_cn":"这个节骨眼上原料供应短缺……已经严重影响到我们的生产进度了！","status":"matched","hash_xxh64":"0xBA1C9423C2C0BC37","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1410333004:1":{"text":"Huh? Mr. Ironbeard—","source_cn":"咦！铁须先生——","status":"matched","hash_xxh64":"0x94535D6D03DC446F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1410333005:1":{"text":"He stormed off in a rage...","source_cn":"……铁须先生怒气冲冲地走了！","status":"matched","hash_xxh64":"0xE93F027E38714D88","variant_status":"","male":"","female":"","variant_male_record_inde