{"asset_key":"ep4/quest_story_14233440","episode":"ep4","category":"quest_story","story_id":"14233440","schema_version":1,"lang":"en","texts":{"say:1:1423344001:1":{"text":"Will they just keep living like this, day after day?","source_cn":"那些孩子，会不会日复一日重复着一样的生活呢？","status":"matched","hash_xxh64":"0x3F1EC2260FEE4B95","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423344002:1":{"text":"Maybe they want to see more of the world too. But if no one tells them it's possible, or shows them how to take that first step...","source_cn":"或许他们也想出去看看，但如果没有人告诉他们有这样的可能...","status":"matched","hash_xxh64":"0xF08C690CEB9100B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423344003:1":{"text":"They'll just keep standing still. Like I did.","source_cn":"他们也会像之前的我一样，一直徘徊不前吧。","status":"matched","hash_xxh64":"0x3C87B7352DC19C1F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}