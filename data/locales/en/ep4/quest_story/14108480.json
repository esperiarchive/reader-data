{"asset_key":"ep4/quest_story_14108480","episode":"ep4","category":"quest_story","story_id":"14108480","schema_version":1,"lang":"en","texts":{"say:1:1410848001:0":{"text":"Ah, the bridge's collapsed! I can't get across! Are you two alright?","source_cn":"糟了，桥塌了！我现在过不去，你们两个没事吧？","status":"matched","hash_xxh64":"0xDEEBBAB892356B5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1410848002:0":{"text":"We're fine. What about you?","source_cn":"我们没事！倒是你，还好吗？","status":"matched","hash_xxh64":"0x092A2C2468FA7BB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1410848003:0":{"text":"Don't worry. This looks like an old dwarven camp; I recognize the structure.","source_cn":"放心吧，这看起来是矮人的旧日营地！我清楚营地的构造，问...","status":"matched","hash_xxh64":"0x44A707EC9DC372A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1410848003":{"text":"Don't worry. This looks like an old dwarven camp; I recognize the structure.","source_cn":"放心吧，再怎么说这也是我们矮人的旧营地，我熟得很！","status":"matched","hash_xxh64":"0x44A707EC9DC372A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410848004:0":{"text":"I can't. The road over here has been sealed off.","source_cn":"不行，这边的路塌的塌，堵的堵。高台倒是好的，但我跳不过去。","status":"matched","hash_xxh64":"0x72C9A7F72BD19030","variant_status":""