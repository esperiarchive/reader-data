{"asset_key":"ep4/quest_story_14105380","episode":"ep4","category":"quest_story","story_id":"14105380","schema_version":1,"lang":"en","texts":{"say:3:1410538001:1":{"text":"Wooow! What's this? It's so beautiful...","source_cn":"这是什么……好美……","status":"matched","hash_xxh64":"0x93F7EED38E207205","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1410538002:1":{"text":"It seems to be alive, breathing, as though life itself is singing through it...","source_cn":"它好像在呼吸，生命似乎在它身上歌唱……","status":"matched","hash_xxh64":"0x1D6BDE00C8E48966","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410538003:1":{"text":"Look, even the sunlight creates shadows through it.","source_cn":"看，阳光甚至能透过它折射出影子。","status":"matched","hash_xxh64":"0xDDD66D4A1FE365B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1410538003":{"text":"Look, even the sunlight creates shadows through it.","source_cn":"看，阳光甚至能透过它折射出影子。","status":"matched","hash_xxh64":"0xDDD66D4A1FE365B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1410538004:1":{"text":"The colors are so different from what we have underground... mmm! And the scent!","source_cn":"它的颜色和地底完全不同……唔！还有香味！","status":"matched_runtime_gender","hash_xxh64":"0xB41825E01A8D4E74","variant_status":"runtime_gender_keys_target_same","male":"The colors are so different from what we have underground... mmm! And the scent!","female":"The colors are so different from what we have underground... mmm! And the scent!","variant_male_record_index":"157870","variant_female_record_index":"157871","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1410538005:1":{"text":"The books always warned that surface plants are poisonous... Was that just another lie?","source_cn":"书上说地表的植物都带着毒……又是骗人的吧？","status":"matched_runtime_gender","hash_xxh64":"0x6C746F7C8B439194","variant_status":"runtime_gender_keys_target_same","male":"The books always warned that surface plants are poisonous... Was that just another lie?","female":"The books always warned that surface plants are poisonous... Was that just another lie?","variant_male_record_index":"157872","variant_female_record_index":"157873","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1410538006:1":{"text":"You're beginning to see it. Look there! A whole sea of flowers.","source_cn":"你开始明白了。看看那边！有整片的花海……","status":"matched","hash_xxh64":"0x9A164FA68785F063","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1410538007:1":{"text":"So this is what the surface looks like... Everything seems so surreal...","source_cn":"原来地表……这么美……","status":"matched","hash_xxh64":"0x6825FCA2BCAAE8FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"That's just a plant.","source_cn":"是地表的植物","status":"matched_runtime_gender","hash_xxh64":"0xDD6F01F42EF79929","variant_status":"runtime_gender_keys_target_same","male":"That's just a plant.","female":"That's just a plant.","variant_male_record_index":"71512","variant_female_record_index":"71513","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:1:2":{"text":"You're right, it is beautiful.","source_cn":"你说得对，很美","status":"matched_runtime_gender","hash_xxh64":"0x621FD9AD47AEDAF9","variant_status":"runtime_gender_keys_target_same","male":"You're right, it is beautiful.","female":"You're right, it is beautiful.","variant_male_record_index":"71514","variant_female_record_index":"71515","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:斐利尔":{"text":"Feli","source":"斐利尔","status":"matched_dialogue_flow"},"speaker:祖娅":{"text":"Zanie","source":"祖娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":2}}