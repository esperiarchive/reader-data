{"asset_key":"ep4/quest_story_14107290","episode":"ep4","category":"quest_story","story_id":"14107290","schema_version":1,"lang":"en","texts":{"say:1:1410729001:0":{"text":"Open your eyes and behold the true visage of this curse...","source_cn":"睁开你们的双眼，见证诅咒的真实面目吧。","status":"matched","hash_xxh64":"0xA42528D1B9AEAFAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1410729002:0":{"text":"To become monsters devoid of reason, driven solely by the urge to slaughter our own kind...","source_cn":"是堕为没有理智，只会戕害同胞的怪物——","status":"matched","hash_xxh64":"0x6AC43435C33D81F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1410729003:0":{"text":"...or shall we explore every path, no matter the cost, to survive and reclaim our own destiny?","source_cn":"还是用尽一切手段活下去，重新掌握自己的命运？","status":"matched","hash_xxh64":"0xBDE28E8A7DA75494","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:奈萨雷斯":{"text":"Seralyth","source":"奈萨雷斯","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}