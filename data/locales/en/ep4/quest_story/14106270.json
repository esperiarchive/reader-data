{"asset_key":"ep4/quest_story_14106270","episode":"ep4","category":"quest_story","story_id":"14106270","schema_version":1,"lang":"en","texts":{"say:1:1410627001:0":{"text":"You lost, big guy!","source_cn":"大块头，你输了！","status":"matched","hash_xxh64":"0xC96DA6F2AC263467","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1410627002:0":{"text":"I must admit, you are quite strong...","source_cn":"我承认……你们，有些本领。","status":"matched","hash_xxh64":"0x7FAD95143FA89747","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1410627003:0":{"text":"Indris, I must ask you one more time. Aren't you afraid you'll regret it?","source_cn":"因度厄，你执意前进……不怕后悔吗？","status":"matched","hash_xxh64":"0xF4401E5775B5D8B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410627004:0":{"text":"I've already made my choice. Regret has no place here.","source_cn":"我不会后悔。","status":"matched","hash_xxh64":"0x74964822C174F7CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1410627005:0":{"text":"*Sigh* How stubborn...","source_cn":"任性……执拗……","status":"matched","hash_xxh64":"0x6E71C968C973C6B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1410627006:0":{"text":"Trust me, you will. I was the same once... *Cough*","source_cn":"不，你会的。当年……我也是——咳咳！","status":"matched","hash_xxh64":"0xC4AB6323E3B75DF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1410627007:0":{"text":"Seems like he's been beaten so badly he can't even speak right... let me finish him off!","source_cn":"这家伙，被揍得话都说不利索了……干脆让我来给他最后一击。","status":"matched","hash_xxh64":"0xDBB8B3A764D2F132","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1410627008:1":{"text":"Don't even think about it!","source_cn":"……休想！","status":"matched","hash_xxh64":"0xBBF6479F21104AD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1410627009:0":{"text":"Ugh! He got away!","source_cn":"别逃！","status":"matched","hash_xxh64":"0x28DD5920F5DFD0F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1410627010:0":{"text":"What a cheap trick!","source_cn":"可恶……看不出来那大块头还会玩阴的！","status":"matched","hash_xxh64":"0xEA1A40FD7B8E0746","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1410627011:0":{"text":"Should we go after him?","source_cn":"这下怎么办？让他给跑了。","status":"matched","hash_xxh64":"0x4715BA8867D30E5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1410627012:0":{"text":"Forget it. It'll only waste time.","source_cn":"别去追击他了，耽误时间。","status":"matched","hash_xxh64":"0x4E7E0230BCD51B5C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1410627013:0":{"text":"You're not seriously letting him go, are you?","source_cn":"你该不会是想要放他一马？","status":"matched","hash_xxh64":"0x4602EA00303DEB77","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1410627014:0":{"text":"Knowing the General, he'll report back to Her Majesty right away. We have to see what they're hiding before reinforcements arrive.","source_cn":"以我对都铎将军的了解，他会立刻向女王汇报这里的情况，我...","status":"matched","hash_xxh64":"0x63BC0DE9E71B95C9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:祖娅":{"text":"Zanie","source":"祖娅","status":"matched_dialogue_flow"},"speaker:都铎":{"text":"Thador","source":"都铎","status":"matched_dialogue_flow"},"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":15,"localized_text_count":14,"speaker_count":3}}