{"asset_key":"ep4/quest_story_14231560","episode":"ep4","category":"quest_story","story_id":"14231560","schema_version":1,"lang":"en","texts":{"say:1:1423156001:1":{"text":"Oh, you're here, <style=\"stress\"><player_name></style>.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xBF7189C88E5068A2","variant_status":"runtime_gender_keys_target_same","male":"Oh, you're here, <style=\"stress\"><player_name></style>.","female":"Oh, you're here, <style=\"stress\"><player_name></style>.","variant_male_record_index":"168979","variant_female_record_index":"168980","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423156002:0":{"text":"Don't worry about me. I just need a drink to blow off some steam.","source_cn":"别担心了，我就是遇到瓶颈了，一个人在这儿喝喝啤酒，散散心。","status":"matched","hash_xxh64":"0x2894807468E41DA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423156003:1":{"text":"Be honest with me—do you think this arcane steel project is doomed?","source_cn":"在你看来，你觉得魔钢研究真的行不通吗？","status":"matched_runtime_gender","hash_xxh64":"0x3393DF44CA78E44B","variant_status":"runtime_gender_keys_target_same","male":"Be honest with me—do you think this arcane steel project is doomed?","female":"Be honest with me—do you think this arcane steel project is doomed?","variant_male_record_index":"168982","variant_female_record_index":"168983","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1423156003":{"text":"Be honest with me—do you think this arcane steel project is doomed?","source_cn":"在你看来，你觉得魔钢研究真的行不通吗？","status":"matched_runtime_gender","hash_xxh64":"0x3393DF44CA78E44B","variant_status":"runtime_gend