{"asset_key":"ep4/quest_story_14226917","episode":"ep4","category":"quest_story","story_id":"14226917","schema_version":1,"lang":"en","texts":{"say:1:1422691701:1":{"text":"Her aura—why did it suddenly spike?!","source_cn":"她的气息怎么会突然变强了！","status":"matched","hash_xxh64":"0xFA22D4C783396968","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1422691701":{"text":"Her aura—why did it suddenly spike?!","source_cn":"她的气息怎么会突然变强了！","status":"matched","hash_xxh64":"0xFA22D4C783396968","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1422691702:1":{"text":"This is bad. We brought the Sylvan Egg into this space, and she's touched it again!","source_cn":"糟了，我们带着翡绿之卵进入了这个空间，这个恶魔又接触到...","status":"matched","hash_xxh64":"0xD68569399D26A9BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1422691703:1":{"text":"And not just that. Look at those seeds on the ground. She's using them to regenerate!","source_cn":"不仅如此，看那些地面上的种子。她借着这些分散的种子在不...","status":"matched","hash_xxh64":"0x2AE98965D43F55CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1422691704:0":{"text":"That's what makes her so dangerous...","source_cn":"看来，这就是棘手之处！","status":"matched","hash_xxh64":"0x374B64825D594A92","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1422691705:1":{"text":"I cannot die...","source_cn":"悉达、将、永远、存在、只要、养分……","status":"matched","hash_xxh64":"0x3DAE3D2A689E2640","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1422691706:1":{"text":"Not while there's a root to cling to... sap to drink... flesh to hollow out.","source_cn":"根系、营养、悉达、再次、壮大……","status":"matched","hash_xxh64":"0x2557975A50ED667E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1422691707:1":{"text":"I spread. I feed.","source_cn":"悉达、繁衍、更多、更多……","status":"matched","hash_xxh64":"0x98AD775F6586039A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1422691708:0":{"text":"I sink into roots... I twist into trees.","source_cn":"悉达、有根、有种子、变成丛林、吃掉丛林……","status":"matched","hash_xxh64":"0x13C1C75DF4B44625","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1422691709:0":{"text":"I hollow the forest...\nAnd now, I breathe through everything.","source_cn":"悉达、会成为丛林……\\n悉达、就是丛林……","status":"matched","hash_xxh64":"0x395C714F30E58AE4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1422691710:0":{"text":"Shut your mouth, Hypogean!","source_cn":"……闭嘴，恶魔！","status":"matched","hash_xxh64":"0x035B09C11DD46C66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1422691711:1":{"text":"Calm down, Eironn! She's still talking, which means we can still get information out of her.","source_cn":"埃隆，冷静！既然她在回答，我们得问出更多情报。","status":"matched","hash_xxh64":"0xE543B19901B13513","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1422691712:0":{"text":"We need to figure out how to beat her.","source_cn":"我们得找到对付她的办法！","status":"matched","hash_xxh64":"0x3831D3A5580568A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1422691712":{"text":"We need to figure out how to beat her.","source_cn":"我们得想办法找到对付她的办法！","status":"matched","hash_xxh64":"0x3831D3A5580568A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1422691713:1":{"text":"I found the fruit... warm, throbbing.","source_cn":"悉达、只是、找到了果实……","status":"matched","hash_xxh64":"0x9D1987885B9D0B40","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1422691714:1":{"text":"They discovered me... Dura tried to cage me, but I slithered free.","source_cn":"悉达、被发现、艾雅、封印、逃离……","status":"matched","hash_xxh64":"0xD98EBA70E6009B71","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1422691715:1":{"text":"My roots sank deep, even as the fruit withered...","source_cn":"但悉达、扎下了根、可是、果实只剩……","status":"matched","hash_xxh64":"0x26F33501119BE8FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1422691716:0":{"text":"Tendrils spreading through dark places... safe, waiting...","source_cn":"悉达的根、越走越远、悉达、地下、安全了……","status":"matched","hash_xxh64":"0xF4D75767531A861E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1422691717:1":{"text":"Then came the fire... it burned... but not all of me. My deepest roots remained hungry, patient.","source_cn":"后来、有火、悉达、怕、但还有、根系……","status":"matched","hash_xxh64":"0x3BE818CBFA9D4620","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1422691718:0":{"text":"You're here. So sweet and tender, you will feed me now... How generous you are.","source_cn":"你们、会是养分、悉达、很开心……","status":"matched","hash_xxh64":"0x5E6590EB42AAB625","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1422691719:0":{"text":"Come closer, let me taste... Through you, I'll live forever.","source_cn":"来吧、供给、悉达、永存……","status":"matched","hash_xxh64":"0x388AC7C6CE97ABC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:25:1422691719":{"text":"Come closer, let me taste... Through you, I'll live forever.","source_cn":"来吧、供给、悉达、永存……","status":"matched","hash_xxh64":"0x388AC7C6CE97ABC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1422691720:1":{"text":"Let's try it!","source_cn":"火焰或许是她的克星！试试吧！","status":"matched","hash_xxh64":"0x8443896A7F55C177","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1422691721:1":{"text":"We'll burn her seeds to stop her from regenerating.","source_cn":"我们焚毁她所有的种子，切断她的重生之路。","status":"matched","hash_xxh64":"0x4FC5FA3FEC110E1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1422691722:1":{"text":"And sever her roots—cut off the source before she regrows.","source_cn":"还要破坏她的根系，阻断她汲取力量的渠道。","status":"matched","hash_xxh64":"0x733743C36E024AFD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1422691723:1":{"text":"I'll use the Eclipsion. My bow is said to never miss and will chase enemies across the land.","source_cn":"让我来试试吧，万里逐敌，开弓必中的杜恩加尔——","status":"matched","hash_xxh64":"0x0B3231A7D5A27837","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1422691724:1":{"text":"Powered by the fiery essence of Helthor and dragonflame, it's made for hunting down evil, like her!","source_cn":"它凝聚了赫托与龙的火焰精粹，正适合焚烧这些。","status":"matched","hash_xxh64":"0x71D46D4467EEAD09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1422691725:1":{"text":"Let's strike her down with everything we've got!","source_cn":"好，一起动手！","status":"matched","hash_xxh64":"0x4FB0D88B6D1727F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:25:0:1":{"text":"She must be afraid of fire!","source_cn":"火？怕？","status":"matched_runtime_gender","hash_xxh64":"0xD6297D3456D97D88","variant_status":"runtime_gender_keys_target_same","male":"She must be afraid of fire!","female":"She must be afraid of fire!","variant_male_record_index":"73486","variant_female_record_index":"73487","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"Saida, how did you get here?","source_cn":"那么悉达，你为什么会在这里？","status":"matched_runtim