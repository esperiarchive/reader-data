{"asset_key":"ep4/quest_story_14104350","episode":"ep4","category":"quest_story","story_id":"14104350","schema_version":1,"lang":"en","texts":{"say:1:1410435001:1":{"text":"Glory to the Queen! Captain, this commoner with the Stigma tried to sneak into the line, but I caught him!","source_cn":"女王荣光永存！报告卫队长！这名带印记的平民妄图混入队伍...","status":"matched","hash_xxh64":"0xFD74C86F1868F943","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1410435002:1":{"text":"It's not for me... it's for Bethwyn! She's too weak...","source_cn":"我不是为了自己，是贝丝薇。贝丝薇太虚弱了。她快要……","status":"matched","hash_xxh64":"0x037B6D3F7EBE6744","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1410435003:1":{"text":"Please, honorable guard, have mercy!","source_cn":"求求你们了，各位卫兵大人们！给贝丝薇一点怜悯吧！","status":"matched","hash_xxh64":"0x61771932570AE04D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410435004:1":{"text":"If she wants Divine Dew, she can come get it herself. The law forbids collecting it for others.","source_cn":"让她自己来取，律法有言，不得代领！","status":"matched","hash_xxh64":"0xC7A0B81741CE86B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1410435005:1":{"text":"She... she can't. She has the Stigma too, she—","source_cn":"贝丝薇……也身负印记，她——","status":"matched","hash_xxh64":"0xC1A7FD1001E02691","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1410435006:1":{"text":"Hmph! Then there's nothing more to say! Do you think the priests punish the innocent or the guilty?","source_cn":"哼！那还有什么好说的！祭司大人们难道会平白无故地惩罚无...","status":"matched","hash_xxh64":"0x533BD077FC0B2E33","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1410435007:1":{"text":"Good sir, please show mercy!","source_cn":"给她一点慈悲吧，卫兵大人！","status":"matched","hash_xxh64":"0x0E2F04F3999034BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1410435008:1":{"text":"Vexa... Thank you, but I already know how this ends...","source_cn":"维克莎，多谢你。我已经知道该怎么做了……","status":"matched","hash_xxh64":"0x2AF0F4E8E72F0E6D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1410435009:1":{"text":"That's right, commoner. Better to give up now.","source_cn":"没错，平民。早点死心为好。","status":"matched","hash_xxh64":"0x0A6B85A74E0C7EF5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1410435010:1":{"text":"Oh, and by the way, report her location later. We'll handle the cleanup.","source_cn":"对了，待会记得上报她的位置，我们会负责清理。","status":"matched","hash_xxh64":"0x4EF2690421B342FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1410435011:1":{"text":"No! Bethwyn's still herself! She can hold on. I have to go... She needs me!","source_cn":"不，贝丝薇还好。她还能坚持……我先走了！她现在很需要我！","status":"matched","hash_xxh64":"0x57829F2BFA423FDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1410435012:1":{"text":"Y-You're all monsters!","source_cn":"你们……太欺负人了！","status":"matched","hash_xxh64":"0xDE3849AC2284E00E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1410435013:1":{"text":"It's getting late. You can end your shift now.","source_cn":"你，时候不早了，准备交接吧。","status":"matched","hash_xxh64":"0xA2B6D02C9B44BB32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1410435014:1":{"text":"Captain, shouldn't we keep an eye on that kid? Just in case...","source_cn":"卫队长，我们真的不用去盯着那小子吗？以防万一……","status":"matched","hash_xxh64":"0x9D97CE37AEF3809F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1410435015:1":{"text":"...I'll take care of it. Go rest.","source_cn":"……无事，我稍后再安排。你早点回去休息。","status":"matched","hash_xxh64":"0x71133FCED0E37672","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1410435016:1":{"text":"Yes, sir! Glory to the Queen!","source_cn":"遵命！女王荣光永存！","status":"matched","hash_xxh64":"0xB0F14F9E84621734","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1410435017:1":{"text":"Everyone, form a proper line! No pushing. You will all get your share.","source_cn":"都排好队，一个一个来领取！","status":"matched","hash_xxh64":"0x631B897D98B30B62","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1410435018:1":{"text":"It's Indris! Everyone, let's line up properly.","source_cn":"是因度厄！大家该排队的好好排队……","status":"matched","hash_xxh64":"0x3D1F94BFC42CBB3E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1410435019:1":{"text":"Captain Indris is here!","source_cn":"因度厄卫队长来了！","status":"matched","hash_xxh64":"0xC3433592303C7E23","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:凶狠的卫兵":{"text":"Vicious Guard","source":"凶狠的卫兵","status":"matched_dialogue_flow"},"speaker:凯登":{"text":"Caiden","source":"凯登","status":"matched_dialogue_flow"},"speaker:平民维克莎":{"text":"Commoner Vexa","source":"平民维克莎","status":"matched_dialogue_flow"},"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"matched_dialogue_flow"},"speaker:反叛的平民":{"text":"Brave Commoner","source":"反叛的平民","status":"matched_dialogue_flow"},"speaker:应声的平民":{"text":"Quiet Commoner","source":"应声的平民","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":20,"localized_text_count":19,"speaker_count":6}}