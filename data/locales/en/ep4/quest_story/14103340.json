{"asset_key":"ep4/quest_story_14103340","episode":"ep4","category":"quest_story","story_id":"14103340","schema_version":1,"lang":"en","texts":{"say:3:1410334001:1":{"text":"Hello, Ms. Hyla! Have you seen General Hogan today?","source_cn":"你好，海拉女士，请问你今天是否见过霍根将军？","status":"matched","hash_xxh64":"0xEE58779D0723F6FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1410334002:1":{"text":"Huh? Oh, you guys! The envoys from the Empire! Weren't you with him?","source_cn":"你们——哦，想起来了！耀光来的使节大人们！你们没有在一...","status":"matched","hash_xxh64":"0xF996CCF4BA4A4255","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410334003:1":{"text":"You'd better ask Eldric. I've got work to do!","source_cn":"这种事得去问弗林！我只关心工作！","status":"matched","hash_xxh64":"0x5AEEDCE7322D104F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1410334003":{"text":"You'd better ask Eldric. I've got work to do!","source_cn":"这种事得去问弗林！我只关心工作！","status":"matched","hash_xxh64":"0x5AEEDCE7322D104F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1410334004:1":{"text":"Either in the village or the mine...","source_cn":"不是在村里就是在矿洞里……","status":"matched","hash_xxh64":"0xACFC508A09345AED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_re