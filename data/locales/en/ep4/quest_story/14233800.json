{"asset_key":"ep4/quest_story_14233800","episode":"ep4","category":"quest_story","story_id":"14233800","schema_version":1,"lang":"en","texts":{"say:1:1423380001:1":{"text":"A little... but mostly excited.","source_cn":"紧张吗……是有一点，不过更多的是期待吧。","status":"matched","hash_xxh64":"0x01FDECBC1A1C7124","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1423380002:1":{"text":"When I look into their eyes, I know I made the right choice.","source_cn":"看着那些孩子的眼睛，我明白我做出了正确的选择。","status":"matched","hash_xxh64":"0xAF22BBB4A55D5DF5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423380003:1":{"text":"I was clumsy in class at first, sure. But I believe that with love and patience, things will keep getting better.","source_cn":"或许一开始上课的时候我有些笨拙，但我相信，爱和耐心能让...","status":"matched","hash_xxh64":"0xBF646D47B77178C9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423380004:1":{"text":"Besides, this place—it feels like home. Like I've finally found where I belong.","source_cn":"更何况，这里……让我觉得温暖，像是找到了属于自己的地方。","status":"matched","hash_xxh64":"0x093BA67418A6878D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:欧罗娜":{"text":"Orlana","source":"欧罗娜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}