{"asset_key":"ep4/quest_story_14106351","episode":"ep4","category":"quest_story","story_id":"14106351","schema_version":1,"lang":"en","texts":{"say:1:1410635101:1":{"text":"The boat's frame seems fine overall, just a bit worn out.","source_cn":"船的大体框架看起来没什么大碍，就是有点年久失修了。","status":"matched","hash_xxh64":"0x88D3612002162A27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1410635102:1":{"text":"It's mostly just some rusted parts and loose bolts—nothing I can't handle!","source_cn":"主要是一些零件腐蚀和松动的问题，都是些小毛病！","status":"matched","hash_xxh64":"0xB3F5AC10F5CF6808","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1410635103:1":{"text":"Just give me the right tools, and I'll fix it right up.","source_cn":"给我些工具，我就能修好它。","status":"matched","hash_xxh64":"0x2AE75FA57113980F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1410635103":{"text":"Just give me the right tools, and I'll fix it right up.","source_cn":"给我些工具，我就能修好它。","status":"matched","hash_xxh64":"0x2AE75FA57113980F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410635104:1":{"text":"Just the usual—a screwdriver, wrench, and a hammer...","source_cn":"基础的修理工具就行。螺丝刀、扳手、铁锤……","status":"matched_runtime_gender","hash_xxh64":"0xE8A8BF1936A396C5","variant_status":"runtime_gen