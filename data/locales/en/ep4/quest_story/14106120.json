{"asset_key":"ep4/quest_story_14106120","episode":"ep4","category":"quest_story","story_id":"14106120","schema_version":1,"lang":"en","texts":{"say:2:1410612001:0":{"text":"Hey, hey! You're going the wrong way!","source_cn":"喂喂！方向错了，不是那边！是这边！","status":"matched","hash_xxh64":"0xB3D5B013B89E5642","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1410612002:1":{"text":"Oh, thank you.","source_cn":"好，多谢。","status":"matched","hash_xxh64":"0x3098584D64EBDFBB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1410612003:1":{"text":"Hold on, don't just rush off—maybe take a break first?","source_cn":"你……你先别闷头走了，要不要先休息一下？","status":"matched","hash_xxh64":"0x1269324FCD4D1FCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1410612004:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1410612005:1":{"text":"<style=\"stress\"><player_name></style>, he's been bottling everything up...","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xB00172DB82A5DDB3","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, he's been bottling everything up...","female":"<style=\"stress\"><player_name></style>, he's been bottling everything up...","variant_male_record_index":"161492","variant_female_record_index":"161493","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1410612005":{"text":"<style=\"stress\"><player_name></style>, he's been bottling everything up...","source_cn":"<style=stress><player_name></style>，这样不行吧？他一直这么憋着……","status":"matched_runtime_gender","hash_xxh64":"0xB00172DB82A5DDB3","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, he's been bottling everything up...","female":"<style=\"stress\"><player_name></style>, he's been bottling everything up...","variant_male_record_index":"161492","variant_female_record_index":"161493","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1410612006:1":{"text":"Argh, I'm no expert either.","source_cn":"我看着像很懂的样子吗？","status":"matched_runtime_gender","hash_xxh64":"0x77AB42302A72CAC8","variant_status":"runtime_gender_keys_target_same","male":"Argh, I'm no expert either.","female":"Argh, I'm no expert either.","variant_male_record_index":"161494","variant_female_record_index":"161495","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1410612009:1":{"text":"When I first became a guard, I'd hesitate when dealing with the Sinned Ones.","source_cn":"刚成为卫兵时，我对孽化者下手总是会犹豫。","status":"matched","hash_xxh64":"0x81DC5F41F5DB1BF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1410612010:1":{"text":"Feli always said I was being too cautious and needed to act more decisively—or else I might get hurt.","source_cn":"斐利尔会说我太过谨慎，应该更果断一些……不然自己容易受伤。","status":"matched","hash_xxh64":"0xBE8151EE201CF740","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1410612011:1":{"text":"He taught me how to protect myself, heal wounds, and hold onto my faith...","source_cn":"他教我保护自己，治愈伤痛，坚守信念……斐利尔教会了我那...","status":"matched","hash_xxh64":"0xCB2C15F9D29B2174","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1410612012:1":{"text":"He taught me so much, yet never how to cope with the pain of losing a close friend...","source_cn":"却从来没有教过我……该如何面对失去挚友的痛苦。","status":"matched","hash_xxh64":"0x2C94DB82C5CE876E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1410612013:1":{"text":"Sometimes, crying it out is better than holding it in.","source_cn":"唉，小子……有时候痛哭一场，比装作若无其事更好。","status":"matched","hash_xxh64":"0x748423237D9A8DBE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1410612014:1":{"text":"Not now... The truth that Feli gave his life for is ahead of us.","source_cn":"不……至少现在不能。斐利尔用生命换来的真相就在前方——","status":"matched","hash_xxh64":"0x2F82E5A4569DCC7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1410612015:1":{"text":"Until I find the answer, I won't allow myself to grieve.","source_cn":"在找到答案之前，我决不允许自己悲伤。","status":"matched","hash_xxh64":"0x4E839F720E735889","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1410612015":{"text":"Until I find the answer, I won't allow myself to grieve.","source_cn":"在找到答案之前，我决不允许自己悲伤。","status":"matched","hash_xxh64":"0x4E839F720E735889","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1410612016:1":{"text":"I'm fine... Where to next?","source_cn":"……谢谢，我没事。接下来要去哪？","status":"matched","hash_xxh64":"0x49FD68E98CB82868","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1410612017:0":{"text":"Oof, you've been wandering around in circles!","source_cn":"……原来你就是在闷头乱走！唉，看在祭司小子的面上——","status":"matched","hash_xxh64":"0x7233628908CD7A4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1410612018:1":{"text":"Follow me. I'll show you the truth that Feli uncovered.","source_cn":"走吧，我带你去见见斐利尔见到的真相。","status":"matched","hash_xxh64":"0x6B4AB006BC1EEA46","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"(Pat his shoulder)","source_cn":"（拍拍他的肩膀）","status":"matched_runtime_gender","hash_xxh64":"0x4139FF9222BD85AF","variant_status":"runtime_gender_keys_target_same","male":"(Pat his shoulder)","female":"(Pat his shoulder)","variant_male_record_index":"72024","variant_female_record_index":"72025","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"Let's find the truth together.","source_cn":"（握住他的手）","status":"matched_runtime_gender","hash_xxh64":"0x62BCD57D0A0B05EA","variant_status":"runtime_gender_keys_target_same","male":"Let's find the truth together.","female":"Let's find the truth together.","variant_male_record_index":"72026","variant_female_record_index":"72027","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"I'm no good at comforting people.","source_cn":"我也不懂安慰人","status":"matched_runtime_gender","hash_xxh64":"0xCE4673BF378C8EEB","variant_status":"runtime_gender_keys_target_same","male":"I'm no good at comforting people.","female":"I'm no good at comforting people.","variant_male_record_index":"72018","variant_female_record_index":"72019","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1410612007:1":{"text":"*Sigh* Alright, let's keep moving for now. I'm getting really tired...","source_cn":"唉……先这样吧，就是一直走，我都有点累了。","status":"matched_runtime_gender","hash_xxh64":"0x5C2EC702D68CC1A3","variant_status":"runtime_gender_keys_target_same","male":"*Sigh* Alright, let's keep moving for now. I'm getting really tired...","female":"*Sigh* Alright, let's keep moving for now. I'm getting really tired...","variant_male_record_index":"161496","variant_female_record_index":"161497","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"Let's just walk with him for now.","source_cn":"我们先陪着他吧","status":"matched_runtime_gender","hash_xxh64":"0xF14B5AF2B9E0AABE","variant_status":"runtime_gender_keys_target_same","male":"Let's just walk with him for now.","female":"Let's just walk with him for now.","variant_male_record_index":"72020","variant_female_record_index":"72021","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1410612008:1":{"text":"You might have better luck waiting for Helthor to come back to life than depending on me!","source_cn":"你指望我这个还不如指望赫托复活呢！","status":"matched_runtime_gender","hash_xxh64":"0x453C1856BE65F8A1","variant_status":"runtime_gender_keys_target_same","male":"You might have better luck waiting for Helthor to come back to life than depending on me!","female":"You might have better luck waiting for Helthor to come back to life than depending on me!","variant_male_record_index":"161498","variant_female_record_index":"161499","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:2:3":{"text":"Got any ideas?","source_cn":"你有什么好办法吗？","status":"matched_runtime_gender","hash_xxh64":"0xE382145F044FD0E3","variant_status":"runtime_gender_keys_target_same","male":"Got any ideas?","female":"Got any ideas?","variant_male_record_index":"72022","variant_female_record_index":"72023","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:祖娅":{"text":"Zanie","source":"祖娅","status":"matched_dialogue_flow"},"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":26,"localized_text_count":25,"speaker_count":2}}