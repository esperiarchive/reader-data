{"asset_key":"ep4/quest_story_14231370","episode":"ep4","category":"quest_story","story_id":"14231370","schema_version":1,"lang":"en","texts":{"say:2:1423137001:1":{"text":"Sorry, I'm late!","source_cn":"抱歉，我来晚啦！","status":"matched","hash_xxh64":"0xDB59E5C39010666F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423137002:1":{"text":"Why is everyone looking so moody?","source_cn":"怎么大家看上去脸色不太好的样子？","status":"matched","hash_xxh64":"0x08EDD2F31A785839","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423137003:1":{"text":"Indris, if Ironbeard has said something offensive, don't take it personally. We dwarves have a habit of sounding more blunt than we mean to be.","source_cn":"因度厄，矮人都是直性子，要是铁须说了啥不中听的话，你别...","status":"matched","hash_xxh64":"0xDADD3B6150BCF399","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423137004:1":{"text":"Don't worry about it.","source_cn":"那是自然的。","status":"matched","hash_xxh64":"0xE56A9F947CF6E336","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1423137005:1":{"text":"Will we be dealing with you later in the discussion?","source_cn":"等会儿是直接和你商谈合作的事吗？","status":"matched","hash_xxh64":"0xC36C6C8FB5EEF699","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1423137006:1":{"text":"Actually, it's Ravion. He's much better at handling negotiations than I am.","source_cn":"是沙利叶。涉及利益纠葛的事他比我更加擅长应对。","status":"matched","hash_xxh64":"0x216B2B0993E91474","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1423137007:1":{"text":"It'll be tricky if it's Ravion...","source_cn":"是沙利叶的话，考验可就艰巨了啊……","status":"matched","hash_xxh64":"0x7EBDE28E5E3A9DDA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1423137008:1":{"text":"Ravion's waiting at the Wisteria Hall. Let's head over there now.","source_cn":"沙利叶已经在紫藤会见厅等待大家，请大家移步会见厅吧。","status":"matched","hash_xxh64":"0xD0643B3D0F71DDD8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:祖娅":{"text":"Zanie","source":"祖娅","status":"matched_dialogue_flow"},"speaker:因度厄":{"text":"Indris","source":"因度厄","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":2}}