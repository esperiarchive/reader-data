{"asset_key":"ep4/env_story_14303051","episode":"ep4","category":"env_story","story_id":"14303051","schema_version":1,"lang":"en","texts":{"say:1:1430305101:1":{"text":"Yes, because there are always those who forget who is safeguarding Sal'thorin.","source_cn":"因为总有人忘记是谁在守护着萨洛克兰。","status":"matched","hash_xxh64":"0x6801DC1897F63418","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1430305102:1":{"text":"There are those who would slander the Queen of the Essail.","source_cn":"他们想方设法，费尽心力去污蔑艾塞勒的女王。","status":"matched","hash_xxh64":"0xC749819EC45A8710","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1430305103:1":{"text":"We of the priesthood are meant to awaken these Essail with proper pain and punishment.","source_cn":"我们祭司便是要以疼痛唤醒这些艾塞勒的记忆。","status":"matched","hash_xxh64":"0x3446CE3FDCB956F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:祭司奥黛":{"text":"Priestess Audei","source":"祭司奥黛","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}