{"asset_key":"ep4/env_story_14334030","episode":"ep4","category":"env_story","story_id":"14334030","schema_version":1,"lang":"en","texts":{"say:1:1433403001:1":{"text":"What brings you here?","source_cn":"请问找我有什么事吗？","status":"matched_runtime_gender","hash_xxh64":"0xA32F7A42A3A9A08B","variant_status":"runtime_gender_keys_target_same","male":"What brings you here?","female":"What brings you here?","variant_male_record_index":"166047","variant_female_record_index":"166048","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1433403001":{"text":"What brings you here?","source_cn":"请问找我有什么事吗？","status":"matched_runtime_gender","hash_xxh64":"0xA32F7A42A3A9A08B","variant_status":"runtime_gender_keys_target_same","male":"What brings you here?","female":"What brings you here?","variant_male_record_index":"166047","variant_female_record_index":"166048","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1433403002:1":{"text":"This seems like his handwriting...","source_cn":"这是安塞尔的笔迹……","status":"matched_runtime_gender","hash_xxh64":"0x30D148400675D3B1","variant_status":"runtime_gender_keys_target_same","male":"This seems like his handwriting...","female":"This seems like his handwriting...","variant_male_record_index":"166049","variant_female_record_index":"166050","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"document:4:208:0":{"text":"Don't be sad.\nJust don't let me vanish from your heart.\n<align=\"right\">Ansiel","source_cn":"不要难过。\n不要忘记我。\n<align=\"right\">——安塞尔","status":"matched","hash_xxh64":"0xD20C0E2214BB7E11","variant_status":"","male":"Don't be sad.\nJust don't let me vanish from your heart.\n<align=\"right\">Ansiel","female":"Don't be sad.\nJust don't let me vanish from your heart.\n<align=\"right\">Ansiel","variant_male_