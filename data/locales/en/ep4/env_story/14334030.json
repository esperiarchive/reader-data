index":"166055","variant_female_record_index":"166056","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1433403006:1":{"text":"You told me not to be sad... and not to forget you. But how can I do both?","source_cn":"“不要难过，不要忘记我”，真是自相矛盾的说法。","status":"matched_runtime_gender","hash_xxh64":"0x094F4960289B8ED7","variant_status":"runtime_gender_keys_target_same","male":"You told me not to be sad... and not to forget you. But how can I do both?","female":"You told me not to be sad... and not to forget you. But how can I do both?","variant_male_record_index":"166057","variant_female_record_index":"166058","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1433403007:1":{"text":"Still... I'll do my best. For you, Ansiel...","source_cn":"安塞尔，为了你，我会努力做到的。","status":"matched_runtime_gender","hash_xxh64":"0x7F68F21F9BFFAFA2","variant_status":"runtime_gender_keys_target_same","male":"Still... I'll do my best. For you, Ansiel...","female":"Still... I'll do my best. For you, Ansiel...","variant_male_record_index":"166059","variant_female_record_index":"166060","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"(Tell her the truth)","source_cn":"（据实相告）","status":"matched_runtime_gender","hash_xxh64":"0xF42D52DD91B1CBCB","variant_status":"runtime_gender_keys_target_same","male":"(Tell her the truth)","female":"(Tell her the truth)","variant_male_record_index":"73078","variant_female_record_index":"73079","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1433403008:1":{"text":"Ansiel, if you sent me a letter, why couldn't you come back yourself?","source_cn":"安塞尔，既然你寄了信给我，为什么不亲自回来呢？","status":"matched_runtime_gender","hash_xxh64":"0xFB4C615902D35921","