{"asset_key":"ep4/env_story_14303061","episode":"ep4","category":"env_story","story_id":"14303061","schema_version":1,"lang":"en","texts":{"say:2:1430306101:1":{"text":"Really? On the contrary, the blood is what makes this rite so holy!","source_cn":"血腥吗？相反，我觉得这样的血腥将会带来圣洁！","status":"matched","hash_xxh64":"0x7209F7F2098E0A1F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1430306102:1":{"text":"Her Majesty should not only bestow gifts to her people but punishment as well!","source_cn":"女王不应该只降下恩赐，也需要有鞭挞罪孽的手段！","status":"matched","hash_xxh64":"0xCB1100A0D9F26985","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1430306103:1":{"text":"Yes, every time I see sinners being rightfully punished, I feel happy.","source_cn":"没错，每次看到罪孽被处置，我都会觉得心情愉悦。","status":"matched","hash_xxh64":"0x9109E1C56A1A711D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:贵族凯尔顿":{"text":"Lord Kylton","source":"贵族凯尔顿","status":"matched_dialogue_flow"},"speaker:贵族莫瑞":{"text":"Lady Marray","source":"贵族莫瑞","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}