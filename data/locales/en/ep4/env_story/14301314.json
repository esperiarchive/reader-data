{"asset_key":"ep4/env_story_14301314","episode":"ep4","category":"env_story","story_id":"14301314","schema_version":1,"lang":"en","texts":{"say:2:1430131401:1":{"text":"It's not a good time right now! If what happened reaches the ears of the Imperial envoys, there will be serious consequences!","source_cn":"当然不好！这里的情况一旦被耀光的特使知道，后果可是很严重的！","status":"matched","hash_xxh64":"0xFC8D284FD60C754E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1430131402:1":{"text":"But if they come, doesn't that mean we'll have another welcome banquet?","source_cn":"可是特使来的话，不就意味着马上就会有下一场接风宴？","status":"matched","hash_xxh64":"0x482270762C19A5BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1430131403:1":{"text":"Can you not think about your stomach at a time like this?!","source_cn":"不会有接风宴！你怎么到这个时候了还在想着吃？","status":"matched","hash_xxh64":"0x299A70F4232FE382","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:矿工凡特":{"text":"Miner Fando","source":"矿工凡特","status":"matched_dialogue_flow"},"speaker:矿工塞尔":{"text":"Miner Cera","source":"矿工塞尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}