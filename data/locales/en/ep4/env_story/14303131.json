{"asset_key":"ep4/env_story_14303131","episode":"ep4","category":"env_story","story_id":"14303131","schema_version":1,"lang":"en","texts":{"say:2:1430313101:0":{"text":"Of course, I envy him! He's the youngest high priest that Sal'thorin has ever seen!","source_cn":"当然羡慕，他可是整个萨洛克兰最年轻的高级祭司。","status":"matched","hash_xxh64":"0x66874708E93453EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1430313102:0":{"text":"Some priests grow to old age and never change their station...","source_cn":"要知道很多祭司即使到老也只是普通祭司……","status":"matched","hash_xxh64":"0xAD4ECCE049A0E6FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1430313103:0":{"text":"Wake up, Cayton! Our ancestors weren't Sage Tasso!","source_cn":"醒醒吧，凯顿，我们的祖上可不是贤者后代！","status":"matched","hash_xxh64":"0x4139B0EAB9DDB662","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:小贵族凯顿":{"text":"Cayton","source":"小贵族凯顿","status":"matched_dialogue_flow"},"speaker:小贵族伊丽":{"text":"Elie","source":"小贵族伊丽","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}