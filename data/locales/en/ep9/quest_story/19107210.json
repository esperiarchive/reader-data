,"female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1910721010:1":{"text":"Are you... hungry?","source_cn":"你饿吗？","status":"matched","hash_xxh64":"0xBD33E26DDED06768","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1910721011:1":{"text":"What? What do you mean?","source_cn":"什么？你在说什么？","status":"matched","hash_xxh64":"0x28761C684A9C4959","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1910721012:1":{"text":"Do you feel a hunger? A hunger to sink your teeth into someone's throat... a gnawing urge in your bones...","source_cn":"饿吗，饿到……想把你的牙齿……嵌进别人喉咙里的……那种...","status":"matched","hash_xxh64":"0xE9CEC908581D6528","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1910721013:1":{"text":"I can only hear the sound... Covering my ears does nothing! Ah...! Why won't it stop?!","source_cn":"我只能听到声音，捂住耳朵也不管用，啊，啊……！为什么它...","status":"matched","hash_xxh64":"0x97A5FEB3665AC919","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1910721014:1":{"text":"The barrier your friend gave us has worn off. But... that's good. This way, I can...","source_cn":"你朋友赠予的防护已经结束了，但是，很好……这样我就可以...","status":"matched","hash_xxh64":"0xD4FEFAA25276DD38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1910721015:1":{"text":"Mister Calix...?","source_cn":"……卡律先生？","status":"matched","hash_xxh64":"0xE0CC2360FF6B8676","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1910721016:1":{"text":"不，不对！不对……你是<style=\"stress\"><player_name></style>的朋友……我不能……！","source_cn":"不，不对！不对……你是<style=stress><p...","status":"target_text_empty","hash_xxh64":"0x302E0AF4C8FE1BA6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1910721017:1":{"text":"Listen to me. You can only hear the sound. That means it hasn't gone to the final step yet...","source_cn":"浅海裔的女儿，听好……你现在只能听到声音，就还没有到最...","status":"matched","hash_xxh64":"0x316ACD5730FE42B5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1910721018:1":{"text":"Final step...?","source_cn":"最后……一步？","status":"matched","hash_xxh64":"0xCD72D819029D124B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1910721019:1":{"text":"你杀死我，或者，像我现在的念头，杀死你，撕碎，吞吃，融化……！你会陷入疯狂，所有人都会陷入疯狂！那鼓声会逼疯你！","source_cn":"你杀死我，或者，像我现在的念头，杀死你，撕碎，吞吃，融...","status":"target_text_empty","hash_xxh64":"0x2505E6288C35B0DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1910721020:1":{"text":"Just like me... just like my clan! Just like those who devoured each other yet were still hungry! That's the destiny of the Merfolk!","source_cn":"就像我，就像我的族裔！就像所有互相吞吃却仍无法满足的人...","status":"matched","hash_xxh64":"0x3A7E103792E92CC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1910721021:1":{"text":"在彻底丧失理智之前，你还有机会可以杀死我，就是现在，趁我……还能……控制自己。","source_cn":"在彻底丧失理智之前，你还有机会可以杀死我，就是现在，趁...","status":"target_text_empty","hash_xxh64":"0x132CF6FFE2797F15","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1910721022:1":{"text":"我不能这么做！你还在努力，你，还有歌尼特弟弟，你们都在努力抵抗！","source_cn":"我不能这么做！你还在努力，你，还有歌尼特弟弟，你们都在...","status":"target_text_empty","hash_xxh64":"0xA1FC7B5238C4EAE0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1910721023:1":{"text":"再坚持一下，卡律先生，鼓声一直不停……但我可以试着不去听，守池人就是这么做的，我可以再坚持……！","source_cn":"再坚持一下，卡律先生，鼓声一直不停……但我可以试着不去...","status":"target_text_empty","hash_xxh64":"0x77B9E3EDE04798B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status"