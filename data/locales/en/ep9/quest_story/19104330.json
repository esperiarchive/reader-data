{"asset_key":"ep9/quest_story_19104330","episode":"ep9","category":"quest_story","story_id":"19104330","schema_version":1,"lang":"en","texts":{"say:1:1910433001:1":{"text":"Did you leave your room last night?","source_cn":"你们，昨晚离开房间了？","status":"matched","hash_xxh64":"0xC965C700554B8671","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1910433002:1":{"text":"卡律先生，请先回答我们的一个问题！昨天网上，我们睡觉的时候……你出门了吗？","source_cn":"卡律先生，请先回答我们的一个问题！昨天网上，我们睡觉的...","status":"target_text_empty","hash_xxh64":"0x5D45901BEAFCF903","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1910433003:1":{"text":"发生了什么？","source_cn":"发生了什么？","status":"ambiguous_source_text","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1910433004:1":{"text":"Are you playing dumb?! Your brother had an episode!","source_cn":"你不知道吗？你弟弟发病了！","status":"matched","hash_xxh64":"0x7E73C21CE9451490","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1910433005:1":{"text":"Come clean already, Tentacle Guy! You knew this would happen to Garnet at night, didn't you?!","source_cn":"喂！触手男，你早就知道他晚上会变成那样，是不是？！","status":"matched","hash_xxh64":"0x7CA307D7C901DA35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1910433006:1":{"text":"You left him here to suffer all alone while you were off having a good time!","source_cn":"你早就知道，才把他一个人扔在这里。他难受得发疯，你倒是...","status":"matched","hash_xxh64":"0x2CE7BC942DD9EF5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1910433007:1":{"text":"And here I thought you were a good brother... Tch! Boy, was I wrong about you!","source_cn":"咱还以为你是个好哥哥……呸！是咱看错你了！","status":"matched","hash_xxh64":"0x3D9A0DDDF73C2AE0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1910433007":{"text":"And here I thought you were a good brother... Tch! Boy, was I wrong about you!","source_cn":"咱还以为你是个好哥哥……呸！是咱看错你了！","status":"matched","hash_xxh64":"0x3D9A0DDDF73C2AE0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1910433008:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1910433009:1":{"text":"It's that sound.","source_cn":"是那个声音。","status":"matched","hash_xxh64":"0xB68ADFB12C24345F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1910433009":{"text":"It's that sound.","source_cn":"是那个声音。","status":"matched","hash_xxh64":"0xB68ADFB12C24345F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1910433010:1":{"text":"Garnet and I can hear it, and so can all other Deepfolk.","source_cn":"深海裔会听到一种声音。歌尼特能听到，我也一样。","status":"matched","hash_xxh64":"0x854C2AFEE8D81333","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1910433011:1":{"text":"The moment we hear that sound, we lose control.","source_cn":"听到声音，我们就会发狂——无法控制地发狂。","status":"matched","hash_xxh64":"0x7E81F1B86341E3C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1910433012:1":{"text":"声音……","source_cn":"声音……","status":"target_text_empty","hash_xxh64":"0x798C050872D5EC62","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1910433013:1":{"text":"At first, the sound only came now and then at night. Then it came more often, more clearly.","source_cn":"一开始，那声音只偶尔在夜间出现，之后越来越频繁，越来越清晰。","status":"matched","hash_xxh64":"0x682DF5E637D45B18","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1910433014:1":{"text":"In the end, when you hear it without pause, you're finished. You slowly become a monster that knows only killing and devouring. You're no longer you.","source_cn":"到最后，你不间断地听到它时，你就完了。你将逐渐变成只知...","status":"matched","hash_xxh64":"0x1F18733541F6A82F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1910433015:1":{"text":"Both Garnet and I hear it at night. The nets can hold Garnet back, but they can't hold me.","source_cn":"我和歌尼特都会在晚上听到它。歌尼特能被渔网拦住，我不能。","status":"matched","hash_xxh64":"0xD435DEA3AEE35444","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1910433016:1":{"text":"That's why I went away last night.","source_cn":"所以昨晚我走了。","status":"matched","hash_xxh64":"0x9F1A799645C67027","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1910433017:1":{"text":"Sound? I didn't hear anything last night. Tentacle Guy, you're not making this up to get yourself off the hook, are you?!","source_cn":"声音？咱可没听到什么奇怪的声音。喂，触手男，你该不会是...","status":"matched","hash_xxh64":"0x633FCE8B5C518D64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1910433018:1":{"text":"... Mister Calix, this sound you're talking about... Is it like...","source_cn":"……卡律先生，你说的声音……是不是……","status":"matched","hash_xxh64":"0x5B60D557472E3834","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1910433019:1":{"text":"Drumbeats? Like someone knocking against the base of a coral, over and over... And there's someone whispering, too...","source_cn":"……鼓声？像鼓声，像有人不停敲击珊瑚的底部……还有人在...","status":"matched","hash_xxh64":"0x2B6902F857A6617A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1910433020:1":{"text":"What?! Elphira, you—","source_cn":"什么？！艾菲拉，你——","status":"matched","hash_xxh64":"0x15D60ED6E9819B28","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1910433021:1":{"text":"Yes, my lord.","source_cn":"是。","status":"matched","hash_xxh64":"0xE9F7DF5D35566E5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1910433022:1":{"text":"Seems like you heard it too, Shallowfolk girl.","source_cn":"浅海裔的女儿，你也听到了。","status":"matched","hash_xxh64":"0x145DFB920434F1CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1910433023:1":{"text":"I-I'm not sure... I was dreaming, so maybe I heard it wrong. Maybe it was only a nightmare, and some proper rest will make it go away. Maybe—","source_cn":"我……我不确定，我当时是在做梦，或许、或许我只是听错了...","status":"matched","hash_xxh64":"0xA256BF64DDC25E8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1910433024:1":{"text":"Nope.","source_cn":"不。","status":"matched","hash_xxh64":"0xEC74AE3C4604443D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1910433025:1":{"text":"Once you start hearing that sound, it never goes away.","source_cn":"那声音一旦出现，就不会停下。","status":"matched","hash_xxh64":"0xC23A09B3197F0CCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1910433026:1":{"text":"If you can hear it, it means the crisis doesn't affect only the Deepfolk.","source_cn":"你能听到，就代表着这不止是深海裔的危机。","status":"matched","hash_xxh64":"0x788BAC23CBE054CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1910433027:1":{"text":"Take me to Coralia as soon as possible. We need to join forces and find a solution.","source_cn":"尽快带我去塔拉萨，我们一起找到解决方法。","status":"matched","hash_xxh64":"0xBFF9D5B5C566E51E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1910433028:1":{"text":"Otherwise, you and your family will go mad too. You'll kill each other, devour each other, tear each other apart.","source_cn":"否则，你和你的家人也会发疯，会互相杀戮、吞噬、肢解。","status":"matched","hash_xxh64":"0x71F4B483FC3BD0A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1910433029:1":{"text":"Just like us Deepfolk.","source_cn":"和我们一样。","status":"matched","hash_xxh64":"0xA222C69B157FBD09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1910433030:1":{"text":"No, they won't!!! That could never happen!","source_cn":"——不，不会的！绝不可能发生那种事！","status":"matched","hash_xxh64":"0x7084BCC3911C19C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1910433031:1":{"text":"... S-Sorry about that...","source_cn":"……对、对不起……我……","status":"matched","hash_xxh64":"0x2E80DAA53A30731A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1910433032:1":{"text":"I need some time to gather my thoughts...","source_cn":"让我冷静一下，让我想想……","status":"matched","hash_xxh64":"0x36D5DF393088B119","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"What?!","source_cn":"什么？","status":"matched_runtime_gender","hash_xxh64":"0x3C643EB1FA1741A7","variant_status":"runtime_gender_keys_target_same","male":"What?!","female":"What?!","variant_male_record_index":"96700","variant_female_record_index":"96701","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"图澜，冷静一点","source_cn":"图澜，冷静一点","status":"target_text_empty","hash_xxh64":"0x69C4F53D5E8597CB","variant_status":"runtime_gender_keys_target_same","male":"","female":"","variant_male_record_index":"96696","variant_female_record_index":"96697","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"Calix, you owe us an explanation.","source_cn":"卡律，我们需要一个解释","status":"matched_runtime_gender","hash_xxh64":"0x124D0A5D1991F750","variant_status":"runtime_gender_keys_target_same","male":"Calix, you owe us an explanation.","female":"Calix, you owe us an explanation.","variant_male_record_index":"96698","variant_female_record_index":"96699","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卡律":{"text":"Calix","source":"卡律","status":"matched_dialogue_flow"},"speaker:艾菲拉":{"text":"Elphira","source":"艾菲拉","status":"matched_dialogue_flow"},"speaker:图澜":{"text":"Tolan","source":"图澜","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":38,"localized_text_count":37,"speaker_count":3}}