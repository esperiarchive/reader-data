{"asset_key":"ep9/quest_story_19104090","episode":"ep9","category":"quest_story","story_id":"19104090","schema_version":1,"lang":"en","texts":{"say:1:1910409001:1":{"text":"Stop... Don't come any closer!","source_cn":"够了……别再靠近！","status":"matched","hash_xxh64":"0xB5B1FA29A24C4089","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1910409001":{"text":"Stop... Don't come any closer!","source_cn":"够了……别再靠近！","status":"matched","hash_xxh64":"0xB5B1FA29A24C4089","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1910409002:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1910409005:1":{"text":"Tentacle Guy, what the heck was that all about?! You almost killed Elphira!","source_cn":"喂，触手男！你刚刚怎么回事？！你差点杀了艾菲拉！","status":"matched","hash_xxh64":"0x3D10B108E2F23653","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1910409006:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1910409007:1":{"text":"Shallowfolk girl... Take me to where your people live!","source_cn":"浅海裔的女儿……带我去你们的栖息地！","status":"matched","hash_xxh64":"0x5B57AD785DF4439C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1910409008:1":{"text":"What? Y-You mean Coralia?! ... No way! I'm not bringing a dangerous predator back home!","source_cn":"什么？你……你要去塔拉萨？！……不行，塔拉萨不欢迎危险...","status":"matched","hash_xxh64":"0xC753A1689A2D7FF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1910409009:1":{"text":"You're from the Deepsea. Why don't you go back to your own home?","source_cn":"更深处才是你们深海裔的栖息地，你为什么不回家？","status":"matched","hash_xxh64":"0x64F71EB159BED0F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1910409010:1":{"text":"Go home... Heh...","source_cn":"回家……呵……","status":"matched","hash_xxh64":"0x4B17C6A18A522A3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1910409010":{"text":"Go home... Heh...","source_cn":"回家……呵……","status":"matched","hash_xxh64":"0x4B17C6A18A522A3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1910409011:1":{"text":"别靠近我！","source_cn":"别靠近我！","status":"target_text_empty","hash_xxh64":"0x36579876C896E39E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1910409012:1":{"text":"Just... stay right where you are.","source_cn":"就……站在那里，别动。","status":"matched","hash_xxh64":"0xE7593744EF4C50AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1910409013:1":{"text":"What you did was terrifying, but I didn't sense any hostility... Who exactly are you, and what do you want from us?","source_cn":"你刚才的行为很可怕，但我并没感觉到敌意……你到底是谁，...","status":"matched","hash_xxh64":"0x65E9126E3D033522","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1910409014:1":{"text":"Terrifying... am I?","source_cn":"可怕……是吗？","status":"matched","hash_xxh64":"0xEA2512D6F2DC4FB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1910409015:1":{"text":"...What color would your blood be if I cut you open? And if I peeled the skin from the edge of your bell bit by bit, would you still be alive?","source_cn":"……你的身体，切开的时候，流出的是什么颜色的血？如果从...","status":"matched","hash_xxh64":"0x289F97A345F4E9C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1910409016:1":{"text":"Would you scream as my tentacles pierce you? If I tore off your limbs one by one and dyed the sea crimson... how would that hot soup taste?!","source_cn":"腕须刺入身体的时候，你会哀嚎吗？将手足逐一撕扯而下，让...","status":"matched","hash_xxh64":"0x21196CE82051CD95","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1910409017:1":{"text":"Hey, you creep! What's with all that crazy talk?","source_cn":"喂，混蛋，你在说什么！","status":"matched","hash_xxh64":"0xCBBABCBAFA99A7DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1910409018:1":{"text":"I want to hurt you, tear you apart. I want it so badly it's driving me mad! Every inch of my body is urging me on!","source_cn":"我想伤害，想撕裂，想得发疯！身体的每一寸都在催促！","status":"matched","hash_xxh64":"0xAAF52809A0CBCD10","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1910409019:1":{"text":"But I mustn't give in...","source_cn":"但我，不能那么做……","status":"matched","hash_xxh64":"0xCBEFB520E01E6403","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:20:1910409019":{"text":"But I mustn't give in...","source_cn":"但我，不能那么做……","status":"matched","hash_xxh64":"0xCBEFB520E01E6403","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1910409020:1":{"text":"Pain... actually does me good.","source_cn":"痛苦……是好事。","status":"matched","hash_xxh64":"0x8C793C01B765E3ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1910409023:1":{"text":"Take me to your city, Shallowfolk girl. I promise I won't harm you.","source_cn":"带我去你们的栖息地，浅海裔的女儿。我保证不会伤你。","status":"matched","hash_xxh64":"0xB89EE30A9A4AC783","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1910409024:1":{"text":"No. You may not be hostile, but your kind are our natural predators... I can't just take your word for it.","source_cn":"不行。或许你没有敌意，可对我们来说，你们天生就是捕猎者...","status":"matched","hash_xxh64":"0xB85509D00C3A68B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1910409025:1":{"text":"If I can restrain myself now, I can do the same later.","source_cn":"我现在能克制，之后也能。","status":"matched","hash_xxh64":"0x0AABD88D62AFB0F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1910409026:1":{"text":"Your city, Coralia, is the only inhabited place in the Shallowsea.","source_cn":"听着，你们的栖息地——塔拉萨——那里是唯一的浅海栖息地。","status":"matched","hash_xxh64":"0xA5D8738576CB1DAA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1910409027:1":{"text":"And I need to bring my younger brother there.","source_cn":"我要，带我弟弟去浅海。","status":"matched","hash_xxh64":"0x3C245D5555D45A50","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:27:1910409027":{"text":"And I need to bring my younger brother there.","source_cn":"我要，带我弟弟去浅海。","status":"matched","hash_xxh64":"0x3C245D5555D45A50","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1910409028:1":{"text":"My people. They've all gone mad.","source_cn":"疯了，所有人。","status":"matched","hash_xxh64":"0xD337D0EA228DF0FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1910409029:1":{"text":"Tearing each other apart. Dismembering. Devouring. Hunger, rage, destruction, fusion. Until no one could be told apart.","source_cn":"互相撕裂，互相肢解，互相吞噬，饥饿，愤怒，破坏，融合。...","status":"matched","hash_xxh64":"0x7EF3FDDA82F2B28A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1910409030:1":{"text":"My brother... He hasn't completely lost himself yet. There's still hope for him.","source_cn":"我的弟弟……还没完全疯狂，还有救。","status":"matched","hash_xxh64":"0x49C0EA4AC8B31B99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1910409031:1":{"text":"He might get better in the Shallowsea.","source_cn":"带他去浅海，让他离开海底，也许他会好起来。","status":"matched","hash_xxh64":"0xB6E3D33C2D1CCFFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1910409032:1":{"text":"... I'm sorry, but I can't take you there. I know you're trying to save your family, but I have to protect mine, too.","source_cn":"……我不能答应。对不起，我知道你想帮助亲人，但是我也要...","status":"matched","hash_xxh64":"0x007168213798F286","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1910409033:1":{"text":"I can't risk putting my family in danger.","source_cn":"我不能……将不可控的危险带到家人的身边。","status":"matched","hash_xxh64":"0x08C88D0F46A3814A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1910409034:1":{"text":"... Did you just say no?!","source_cn":"……不能？！","status":"matched","hash_xxh64":"0x1FBF72BEF3910962","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1910409035:1":{"text":"Heh... I'll make you change your mind!","source_cn":"呵……那就让我来替你选！","status":"matched","hash_xxh64":"0x2A6D87