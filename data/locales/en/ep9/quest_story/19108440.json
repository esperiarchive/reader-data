ale_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1910844011:1":{"text":"我想……我想让大家回来……让阿嬷、姐姐、卡律先生、歌尼...","source_cn":"我想……我想让大家回来……让阿嬷、姐姐、卡律先生、歌尼...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1910844012:1":{"text":"我想让塔拉萨回到原来的样子，我想让深海裔也能安心生活……","source_cn":"我想让塔拉萨回到原来的样子，我想让深海裔也能安心生活……","status":"hash_not_found","hash_xxh64":"0x1EF70D57CC0C5255","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1910844013:1":{"text":"可是……我不知道该怎么做！奥汐娜，她的恳求还在回响，她...","source_cn":"可是……我不知道该怎么做！奥汐娜，她的恳求还在回响，她...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1910844013":{"text":"可是……我不知道该怎么做！奥汐娜，她的恳求还在回响，她也不想消失！","source_cn":"可是……我不知道该怎么做！奥汐娜，她的恳求还在回响，她也不想消失！","status":"hash_not_found","hash_xxh64":"0x84C714025D9F3C13","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1910844014:1":{"text":"守池人说，心愿是人存在过的证明……保护心愿，它们也保护我……","source_cn":"守池人说，心愿是人存在过的证明……保护心愿，它们也保护我……","status":"hash_not_found","hash_xxh64":"0xDDA67797A8426305","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_titl