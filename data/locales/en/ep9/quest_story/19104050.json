title_female":"","document_title_cn":"","document_title_status":""},"say:6:1910405006:1":{"text":"只有在洄游季，深海裔才会上浮到中海区域，为繁育猎取养料...","source_cn":"只有在洄游季，深海裔才会上浮到中海区域，为繁育猎取养料...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1910405007:1":{"text":"他们把你们当食物？！","source_cn":"他们把你们当食物？！","status":"hash_not_found","hash_xxh64":"0x194F0CFDE85196D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1910405008:1":{"text":"是呀，世世代代都是如此。","source_cn":"是呀，世世代代都是如此。","status":"hash_not_found","hash_xxh64":"0xCB59926EC8F1A9AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1910405008":{"text":"是呀，世世代代都是如此。","source_cn":"是呀，世世代代都是如此。","status":"hash_not_found","hash_xxh64":"0xCB59926EC8F1A9AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1910405009:1":{"text":"反对？为什么要反对大海的规则呢？","source_cn":"反对？为什么要反对大海的规则呢？","status":"hash_not_found","hash_xxh64":"0x55BBA96C3C648607","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1910405011:1":{"text":"就像我们会捕猎小鱼虾作为食物一样，深海裔也会将我们视为...","source_cn":"就像我们会捕猎小鱼虾作为食物一样，深海裔也会