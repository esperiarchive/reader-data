{"asset_key":"mn/gameplay_story_10642030","episode":"mn","category":"gameplay_story","story_id":"10642030","schema_version":1,"lang":"en","texts":{"say:2:1064203001:0":{"text":"We've been fortunate. No Hypofiends so far. But don't lower your guard yet—these ones track by scent better than sound. We'll circle around the thorn thicket on the west side.","source_cn":"算我们运气好，到现在都没撞见魔物。但不能大意，这里的魔...","status":"matched","hash_xxh64":"0xBEE7FA4DA9EFD17C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1064203002:0":{"text":"You really know your way around here.","source_cn":"埃因哥哥，你对这里好像很了解。","status":"matched","hash_xxh64":"0xA5FE38B450ADE169","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1064203003:1":{"text":"I just know how Hypofiends hunt.","source_cn":"不，我只是比较了解魔物。","status":"matched","hash_xxh64":"0xAFFD5B127F2775DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1064203004:0":{"text":"Did you hear that? Something's moving...","source_cn":"……埃因哥哥，你听到了吗？草丛里有奇怪的声音……","status":"matched","hash_xxh64":"0x31FC6A6205AB7E67","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1064203005:1":{"text":"Don't panic. I'll take a look. Stay close and keep quiet.","source_cn":"别害怕，我去看看。你跟在我身后，不要惊扰它。","status":"matched","hash_xxh64":"0x085D6AFE1E716F89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:9:1064203006:0":{"text":"Ain tightens his grip on his sword and lowers his stance as he creeps toward the rustling brush.","source_cn":"埃因握紧手中的剑，压低重心向发出声音的草丛走去","status":"matched","hash_xxh64":"0xF3FCEF0FEB991E00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:10:1064203007:0":{"text":"But when he parts the tall grass, what he sees takes him by surprise.","source_cn":"当他拨开野草，出现在眼前的景象却令他震惊不已","status":"matched","hash_xxh64":"0x41C7F914156A49E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1064203008:0":{"text":"Ugh...","source_cn":"……呃……","status":"matched","hash_xxh64":"0x577A255C87A2ED28","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1064203009:0":{"text":"Mi... Micah! It's you!","source_cn":"迈克尔……迈克尔？！真的是你！","status":"matched","hash_xxh64":"0x4FE2BFE957914D15","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1064203010:1":{"text":"Stay with me! It's me, Ain!","source_cn":"振作一点！是我啊，埃因！","status":"matched","hash_xxh64":"0x51CB46C814E862ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1064203011:1":{"text":"Ugh... It hurts...","source_cn":"呃……疼……","status":"matched","hash_xxh64":"0xE92C5FD5056BBF7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1064203012:1":{"text":"He's hurt really badly. He needs help.","source_cn":"埃因哥哥，他受了很重的伤……需要治疗。","status":"matched","hash_xxh64":"0x0C40F87B9271B1B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1064203013:1":{"text":"The adults said there are doctors and mages from the temple behind the lines. They can heal wounds.","source_cn":"大人们说，战场的后方有医生，有圣堂的魔法师，他们可以治...","status":"matched","hash_xxh64":"0x6384343E9ED6A433","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1064203014:1":{"text":"Let's bring him with us.","source_cn":"我们，带他一起逃生吧。","status":"matched","hash_xxh64":"0x7A90D7E477F91775","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1064203015:1":{"text":"What?","source_cn":"逃生……？","status":"matched","hash_xxh64":"0xFE70680E92612023","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1064203016:1":{"text":"Wait... No...","source_cn":"不……不能带上他……","status":"matched","hash_xxh64":"0x01B16C990DCCF2B7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1064203017:1":{"text":"Why not? He just needs treatment.","source_cn":"为什么？他还活着。","status":"matched","hash_xxh64":"0x049C36FAFB672B14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1064203018:1":{"text":"I don't know! We just can't! None of us will make it if we bring him along!","source_cn":"我不知道……总之我们不能带他走……如果带着他，谁都活不了！","status":"matched","hash_xxh64":"0xF7CA733EC80C432A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1064203019:1":{"text":"But you know him... He's your comrade, isn't he?","source_cn":"可是你认识他……他是你的战友，对不对？","status":"matched","hash_xxh64":"0x4D7106A432F6FB71","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1064203020:1":{"text":"And then what? Save him, only for Hypofiends to catch us again? So all three of us can die here?","source_cn":"救了他，然后呢？像上次一样，被魔物追上？三个人一起死在...","status":"matched","hash_xxh64":"0xEC3979AD0DE804AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1064203021:1":{"text":"Wait... It happened before... Micah clearly...","source_cn":"上次……对啊，还有上次。迈克尔他明明——","status":"matched","hash_xxh64":"0xBC0445D0817567D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1064203022:1":{"text":"A-Ain...","source_cn":"埃……埃因……我的，朋友……","status":"matched","hash_xxh64":"0xA4FF62F572D2C0FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1064203023:1":{"text":"He's calling for your help. You're the only one who can save him.","source_cn":"……他在向你求救。只有你能救他。","status":"matched","hash_xxh64":"0x544453CBD4D55FE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1064203024:1":{"text":"...","source_cn":"………………","status":"matched","hash_xxh64":"0x197F0BE8A09E0D34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1064203025:1":{"text":"Ahhh... No. NO!!!\nI can't save him... I don't want to!","source_cn":"啊啊啊……不……不、不、不!\\n我不能救他……我不想救他！","status":"matched","hash_xxh64":"0x4EABC77CE5972007","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1064203026:1":{"text":"Oh, how pathetic. A coward through and through.","source_cn":"噢，天哪……真是一只软脚虾，一个彻头彻尾的懦夫！","status":"matched","hash_xxh64":"0x6360487EE83C83B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1064203027:1":{"text":"...?!","source_cn":"……？！","status":"matched","hash_xxh64":"0x1CC9DC7FC7DBD913","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1064203028:1":{"text":"Where's that man who once trailed after the recruiter, vowing he'd grow into a soldier who'd never back down? Did you throw those vows away too, like a pair of worn-out boots?","source_cn":"当年你追在征兵官屁股后面，保证成为永不退缩的战士的誓言...","status":"matched","hash_xxh64":"0x1AD9FDE6B1C603F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1064203029:1":{"text":"Oh, even worn-out boots still have some use on the battlefield. You? You don't. You're nothing but—","source_cn":"哦不不，磨破的靴子在战场上还有回收利用价值。你呢？你可...","status":"matched","hash_xxh64":"0x96836820B83A1127","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1064203030:1":{"text":"...","source_cn":"……！！","status":"matched","hash_xxh64":"0xA011D3AC55021EC4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1064203031:1":{"text":"That voice again... Who's talking? Who is it?","source_cn":"又是那个声音……到底是谁在说话！谁？！","status":"matched","hash_xxh64":"0x9D59A1D24BDBF5E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1064203032:1":{"text":"I didn't hear anything...","source_cn":"什……什么声音？我没有听到啊……","status":"matched","hash_xxh64":"0x9022EDE60CEF00EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1064203033:1":{"text":"You must be too nervous, Ain...","source_cn":"埃因哥哥，是不是你太紧张了？嗯……一定是这样的。","status":"matched","hash_xxh64":"0x2BB5480B9AD24A75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1064203034:1":{"text":"Relax. You don't have to be afraid. You're just... um... shaken.","source_cn":"放轻松……不用紧张。你只是，唔……只是心里有些动摇……","status":"matched","hash_xxh64":"0x348DA4CA2E78DC66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1064203035:1":{"text":"Shaken?","source_cn":"我的心里……","status":"matched","hash_xxh64":"0x3E2008E1B18AE3CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1064203036:1":{"text":"You're right...\nWhy I chose to join the army... and the promise I made... No one knows that better than I do.","source_cn":"……对，你说得对。\\n加入军队的原因，曾经许下的誓言，...","status":"matched","hash_xxh64":"0xCA78B34191319E98","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1064203037:0":{"text":"Why did you join the army?","source_cn":"你加入军队的原因……是什么？","status":"matched","hash_xxh64":"0x6A73F53CCD3832FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1064203038:1":{"text":"To crush the Hypofiends. To protect others...\nAnd I will never retreat.","source_cn":"……击溃魔物，保护他人……\\n……永不退缩。","status":"matched","hash_xxh64":"0x129F4DE1CDE16F7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:49:1064203039:0":{"text":"Good. You haven't forgotten who you are.","source_cn":"太好了……你记得很清楚。","status":"matched","hash_xxh64":"0x705ACEEB57427AE5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1064203040:0":{"text":"Then please, save Micah... just like how you chose to save me.","source_cn":"那么，请救救迈克尔吧……就像，你愿意对我伸出援手那样。","status":"matched","hash_xxh64":"0xAEDC50736D95ADB6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:51:1064203041:0":{"text":"...","source_cn":"………………","status":"matched","hash_xxh64":"0x197F0BE8A09E0D34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:52:1064203042:0":{"text":"Okay.","source_cn":"——好。","status":"matched","hash_xxh64":"0xB37F7A27FF2EE743","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:55:1064203043:0":{"text":"Micah, hang on... I swear I'll get you out of this hellhole!","source_cn":"迈克尔，再坚持一下……我一定会带你离开这个破地方！","status":"matched","hash_xxh64":"0xAD435C33F3EF23E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:56:1064203044:0":{"text":"A-Ain...","source_cn":"……埃、因……","status":"matched","hash_xxh64":"0x1CD4A95ED66489E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:57:1064203045:0":{"text":"Th-Thank you...","source_cn":"谢……谢谢……","status":"matched","hash_xxh64":"0x332D69223ABFF5F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:58:1064203046:1":{"text":"Come on. You're my comrade, remember?","source_cn":"别说这些。你可是我的战友！","status":"matched","hash_xxh64":"0xF4141B7B61E4802B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:59:1064203047:1":{"text":"Move! Through the woods ahead!","source_cn":"走！先穿过前面那片树林！","status":"matched","hash_xxh64":"0xEA3FE11214D5053D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:61:1064203048:0":{"text":"Under the cover of night, the three of them support one another as they make their way toward the rear of the battlefield.","source_cn":"夜幕之下，三人互相搀扶着走向战场后方","status":"matched","hash_xxh64":"0xF1C4F6CBEB71046C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:62:1064203049:0":{"text":"They haven't gone far before a vast shadow drops from above.","source_cn":"还没走出太远，一道巨大的阴影突然从天而降","status":"matched","hash_xxh64":"0x60C58ACEC8828958","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:65:1064203050:0":{"text":"RAARGHH!","source_cn":"嗬啊啊啊——！<key:dialog106>","status":"matched","hash_xxh64":"0xBE5E930BB4896C27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:67:1064203051:0":{"text":"It's a Hypofiend!","source_cn":"……是魔物！","status":"matched","hash_xxh64":"0xA13C727A23679DEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:70:1064203052:1":{"text":"No... not this again! I fought so hard to save Micah...","source_cn":"又是……又是这样！我好不容易才救下迈克尔，你们却……","status":"matched","hash_xxh64":"0x57BB4BBD9AA1653F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:71:1064203053:1":{"text":"Blasted... Blasted Hypofiend!","source_cn":"该死的……该死的魔物！！","status":"matched","hash_xxh64":"0xADAA5C3A8C96D496","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:72:1064203054:1":{"text":"I won't let you hurt anyone ever again... I'm taking Micah out of here!","source_cn":"这一次我不允许你们再伤害任何人……我一定要带着迈克尔，...","status":"matched","hash_xxh64":"0x725F82ABE282E562","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:埃因":{"text":"Ain","source":"埃因","status":"matched_dialogue_flow"},"speaker:奥萝菈":{"text":"Aurora","source":"奥萝菈","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"Subtitles","source":"黑屏字幕","status":"matched_dialogue_flow"},"speaker:迈克尔":{"text":"Micah","source":"迈克尔","status":"matched_dialogue_flow"},"speaker:雄厚的声音":{"text":"Deep Voice","source":"雄厚的声音","status":"matched_dialogue_flow"},"speaker:魔物":{"text":"Hypofiend","source":"魔物","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":55,"localized_text_count":54,"speaker_count":6}}