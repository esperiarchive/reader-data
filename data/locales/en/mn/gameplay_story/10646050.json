{"asset_key":"mn/gameplay_story_10646050","episode":"mn","category":"gameplay_story","story_id":"10646050","schema_version":1,"lang":"en","texts":{"say:2:1064605001:1":{"text":"梅林大人，有两封你的信。","source_cn":"梅林大人，有两封你的信。","status":"target_text_empty","hash_xxh64":"0xE5C7D65E3A0659C7","variant_status":"runtime_gender_keys_target_same","male":"","female":"","variant_male_record_index":"107044","variant_female_record_index":"107045","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1064605001":{"text":"梅林大人，有两封你的信。","source_cn":"梅林大人，有两封你的信。","status":"target_text_empty","hash_xxh64":"0xE5C7D65E3A0659C7","variant_status":"runtime_gender_keys_target_same","male":"","female":"","variant_male_record_index":"107044","variant_female_record_index":"107045","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1064605002:1":{"text":"你走回待客区，深深陷进柔软的沙发里。","source_cn":"你走回待客区，深深陷进柔软的沙发里。","status":"target_text_empty","hash_xxh64":"0xD6120032CA6A0E26","variant_status":"runtime_gender_keys_target_same","male":"","female":"","variant_male_record_index":"107046","variant_female_record_index":"107047","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1064605003:1":{"text":"揭开蜡封，一股墨香扑面而来。信很厚，其中之一是布蕾兹·朗贝尔的供词副本。","source_cn":"揭开蜡封，一股墨香扑面而来。信很厚，其中之一是布蕾兹·...","status":"target_text_empty","hash_xxh64":"0xF0D5C8924849C986","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1064605004:1":{"text":"你清清嗓子，读了起来。","source_cn":"你清清嗓子，读了起来。","status":"target_text_empty","hash_xxh64":"0x5E1FC439CA59F698","variant_status":"runtime_gender_keys_target_same","male":"","female":"","vari