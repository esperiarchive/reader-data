{"asset_key":"mn/gameplay_story_10642010","episode":"mn","category":"gameplay_story","story_id":"10642010","schema_version":1,"lang":"en","texts":{"say:2:1064201001:0":{"text":"Ain, wake up!","source_cn":"埃因！醒醒！","status":"matched","hash_xxh64":"0x976840BEFCF60790","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1064201002:0":{"text":"Reinforcements!","source_cn":"……是援军！","status":"matched","hash_xxh64":"0x754D88C658BA1AEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1064201003:0":{"text":"Micah...?","source_cn":"迈克尔……?","status":"matched","hash_xxh64":"0x0DA547352FBA73A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1064201004:0":{"text":"Look! A golden magic circle!\nIt's the reinforcements!","source_cn":"看呐！金色的魔法阵！\\n是援军的魔法阵！","status":"matched","hash_xxh64":"0x06C4470C54160E31","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1064201005:1":{"text":"You're... alive...","source_cn":"你竟然……还活着……","status":"matched","hash_xxh64":"0xEFAB4E6CC7789C49","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1064201006:1":{"text":"What are you talking about? Of course I am!","source_cn":"说什么呢！我当然还活着！","status":"matched","hash_xxh64":"0x8E2282CC4B8275EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1064201007:1":{"text":"We made a promise, remember? When this war is over, we'll go back to your place and drink your mother's wine.","source_cn":"不是说好了？等这场仗打完，要回你家，喝你母亲酿的酒。","status":"matched","hash_xxh64":"0x49EA45706437FDCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1064201008:1":{"text":"I haven't even tasted it yet. I'm not dying here, and neither are you.","source_cn":"我连酒味都没闻到呢，可不能死在战场上，你也不能。","status":"matched","hash_xxh64":"0xE4DD3642F97A2DAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1064201009:1":{"text":"Help's almost here. We're both getting out of this alive. We can still save a few more. Just a bit more and—","source_cn":"援军马上到了，你我都死不了，我们还能再多救几个战友！只...","status":"matched","hash_xxh64":"0x9A7E7D0184F1C88C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1064201010:1":{"text":"Ugh...","source_cn":"呃啊！！！","status":"matched","hash_xxh64":"0xB1C5139328AF3E7B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1064201011:0":{"text":"<shk>No... No! Micah...! NOOO!</shk>","source_cn":"<shk>不……不不不！迈克尔……！！不！！！</shk>","status":"matched","hash_xxh64":"0x54ED33CFDE5118AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1064201012:0":{"text":"Tch... Hsssss...!","source_cn":"呜嘻嘻嘻……嘶嘶……！","status":"matched","hash_xxh64":"0xEEE71602DA8358DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1064201013:1":{"text":"<shk>Die... you blasted Hypofiends!! I'll kill you all!</shk>","source_cn":"<shk>杀了你……该死的魔物！我要杀了你！</shk>","status":"matched","hash_xxh64":"0x187D0B9E42EF26DF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1064201014:0":{"text":"I'll kill you! Hypofiends, die!","source_cn":"必须杀了你！魔物……都得死……","status":"matched","hash_xxh64":"0x7D8BDD06F1772510","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1064201015:1":{"text":"Micah... I'll wipe them out...","source_cn":"迈克尔……我会杀光魔物……","status":"matched","hash_xxh64":"0xA51CA4169BF65253","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1064201016:1":{"text":"And... then we...","source_cn":"然后……我们一起……","status":"matched","hash_xxh64":"0x78643E5D3092879B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1064201017:1":{"text":"We'll go home...","source_cn":"一起……","status":"matched","hash_xxh64":"0xAC35BD49A14B1B50","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1064201018:1":{"text":"Together...","source_cn":"回家……","status":"matched","hash_xxh64":"0x54132654101E40CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1064201019:0":{"text":"Ain... Ain!","source_cn":"埃因……埃因!","status":"matched","hash_xxh64":"0xED06D310AFD43B7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1064201020:0":{"text":"Mom...","source_cn":"妈……","status":"matched","hash_xxh64":"0x1754BAE5724FDA08","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1064201021:0":{"text":"Ain opens his eyes. His mother is there in front of him, with worry etched into every line of his mother's tired face.","source_cn":"埃因睁开眼，望着眼前的母亲，从母亲疲惫的脸上，他看见藏...","status":"matched","hash_xxh64":"0xB7F4861A38C941BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1064201022:0":{"text":"When did she last smile? He can't remember.","source_cn":"母亲上次笑是什么时候？他想不起来。","status":"matched","hash_xxh64":"0xFB31D9EE46A35095","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1064201023:1":{"text":"Perhaps the only time was the day he returned alive, when she wept with joy. Since then, sorrow was all that remained.","source_cn":"好像只有他活着回来的那天，母亲喜极而泣。自那以后，只剩...","status":"matched","hash_xxh64":"0x29E16309AFBDFEB5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1064201024:1":{"text":"Every time his eyes met hers, it felt like an invisible hand tightening around his neck.","source_cn":"每每和担忧自己的母亲对上视线，都有一双无形的手伸出来，...","status":"matched","hash_xxh64":"0x450000BCF47FD93F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1064201025:0":{"text":"Ain feels like he can't breathe again. He shuts his eyes hard and turns away.","source_cn":"这一次，埃因又觉得喘不上气了，于是他用力合上眼，不再去看。","status":"matched","hash_xxh64":"0xF26C9624CE7EA184","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1064201026:0":{"text":"You were yelling... That nightmare again?","source_cn":"你叫得好大声……又做那个噩梦了？","status":"matched","hash_xxh64":"0x32CD78A33FC1B375","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1064201027:0":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1064201028:0":{"text":"*Sigh* If you don't want to talk, then don't. The flowers in the yard are in bloom. Want to take a look?","source_cn":"唉……不说就不说吧。院里的花开了，妈推你去看看。","status":"matched","hash_xxh64":"0xF3F5C70E5A2BB264","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1064201029:0":{"text":"Your friends from the army wrote again. This one's from Cate and Samir. You still haven't read Lorne's.","source_cn":"对了，你的战友又给你寄了信来。这次是凯特和萨米尔，上次...","status":"matched","hash_xxh64":"0x7AC28254C42BD467","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1064201030:0":{"text":"Just leave it.","source_cn":"放那吧……","status":"matched","hash_xxh64":"0xE8580DA21EF6AE2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1064201031:0":{"text":"Come on. Put your arm around my shoulder. I'll help you sit up first, then I can change your bedpan.","source_cn":"来，勾着我的肩膀，妈扶你坐起来，咱先把尿布换了。","status":"matched","hash_xxh64":"0xD17D9C794291D576","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1064201032:0":{"text":"I don't need your help!","source_cn":"不用你帮！","status":"matched","hash_xxh64":"0x5B8CA2F1029FE194","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:49:1064201033:0":{"text":"You can't manage this on your own with your legs like that. Let me help—","source_cn":"你的腿又不能动，这些事让妈来——","status":"matched","hash_xxh64":"0x8223070610115F0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1064201034:0":{"text":"I said I don't need it! How many times do I have to repeat myself?","source_cn":"我说了！用不着！你还要让我说多少回？！","status":"matched","hash_xxh64":"0x983A56346591D156","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:51:1064201035:1":{"text":"Ain...","source_cn":"埃因……","status":"matched","hash_xxh64":"0x655769EFEC018176","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:52:1064201036:0":{"text":"I'm a grown man who can't even take care of himself! And my own mother has to change me!","source_cn":"我这么大的人，竟然要用尿布！更别说还要让自己的妈帮我换！","status":"matched","hash_xxh64":"0x0B1306CC8494D830","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:53:1064201037:0":{"text":"I'd rather have died back there with Micah and the others.","source_cn":"如果一辈子都这样……当初，我不如陪迈克尔他们一起死！","status":"matched","hash_xxh64":"0x93EFBE278F6DFDDA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:54:1064201038:0":{"text":"How about me?!\nThe Hypofiends already took your father. How am I supposed to go on if I lose you, too?","source_cn":"妈不要你死！\\n你爹已经被魔物杀了，要是你没了……让妈...","status":"matched","hash_xxh64":"0x4DEF66A52B94AC39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:55:1064201039:1":{"text":"I prayed every single day when you were away at war... I begged Dura to bring you home alive.","source_cn":"你去打仗，妈每天都向艾雅女神祈祷……希望你活着回来，女...","status":"matched","hash_xxh64":"0x9A842FD85F295EC4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:56:1064201040:1":{"text":"I pray at the temple now, begging the goddess to heal your legs.","source_cn":"现在妈也每天去神殿，每天都向女神祈祷！祈祷你的双腿能恢...","status":"matched","hash_xxh64":"0xEEE83E2FCCAAEBE8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:57:1064201041:0":{"text":"She answered me once before. She'll answer me again.","source_cn":"女神也一定会回应我的！","status":"matched","hash_xxh64":"0xB75BA3ACCF1A826F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:58:1064201042:0":{"text":"Dura? Hahaha... ridiculous!","source_cn":"艾雅？呵呵呵……可笑！","status":"matched","hash_xxh64":"0x0860FF12E7E21778","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:59:1064201043:0":{"text":"If the goddess does hear us, then Micah...","source_cn":"要是她真能听到祈祷，迈克尔他……","status":"matched","hash_xxh64":"0xD97C39A18998ACD6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:60:1064201044:0":{"text":"Micah wouldn't have died!","source_cn":"他根本不会死！","status":"matched","hash_xxh64":"0x4B84DC9B9302F3A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:61:1064201045:0":{"text":"After all that happened, I can't believe you're still defending him!","source_cn":"你老提那个人！他害你那么惨，你还提！","status":"matched","hash_xxh64":"0xFF822D85F42B6034","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:62:1064201046:0":{"text":"This is what saving him cost you!","source_cn":"要不是为了救他，你这两条腿，不至于弄成这副德行！","status":"matched","hash_xxh64":"0xEC3453F67A1767C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:63:1064201047:0":{"text":"<shk>Enough!</shk>","source_cn":"<shk>——够了！！！</shk>","status":"matched","hash_xxh64":"0x5D447B39DE9FC987","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:64:1064201048:0":{"text":"I've heard enough...","source_cn":"够了……","status":"matched","hash_xxh64":"0xAE83CDDF66AA216D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:65:1064201049:0":{"text":"Leave me alone. Please.","source_cn":"让我自己待着吧，算我求你……","status":"matched","hash_xxh64":"0x9907D574BDD46A5A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:66:1064201050:1":{"text":"Euria parts her lips, then closes them again. The words cling to her tongue. In the end, she swallows them.","source_cn":"尤里娅的双唇开了又合，她在口中咀嚼着那些粘牙的话，最终...","status":"matched","hash_xxh64":"0xE3F7FAD8486D833D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:67:1064201051:1":{"text":"...\nAll right.","source_cn":"……\\n唉……知道了。","status":"matched","hash_xxh64":"0xD525DB1354BFD252","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:68:1064201052:1":{"text":"I'll come back once breakfast is ready.","source_cn":"妈做好早饭再来。","status":"matched","hash_xxh64":"0x61B0784C4DDEB129","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:69:1064201053:0":{"text":"Ain hears the door close. After a long pause, the footsteps outside finally drifted farther and farther away.","source_cn":"埃因听到关门声，隔了很久，门外才传来渐行渐远的脚步声。","status":"matched","hash_xxh64":"0x7D304AEABCE4F319","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:71:1064201054:0":{"text":"Micah, why...?","source_cn":"迈克尔……为什么？","status":"matched","hash_xxh64":"0x283EB09CCD87CAD8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:72:1064201055:0":{"text":"Why did I survive...","source_cn":"为什么……活下来的是我……","status":"matched","hash_xxh64":"0xF5EB17E9AEA2170A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:73:1064201056:0":{"text":"Only to end up like this?","source_cn":"——以这幅德行。","status":"matched","hash_xxh64":"0xEA2C8807BA0F7476","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:焦急的声音":{"text":"Anxious Voice","source":"焦急的声音","status":"matched_dialogue_flow"},"speaker:埃因":{"text":"Ain","source":"埃因","status":"matched_dialogue_flow"},"speaker:迈克尔":{"text":"Micah","source":"迈克尔","status":"matched_dialogue_flow"},"speaker:魔物":{"text":"Hypofiend","source":"魔物","status":"matched_dialogue_flow"},"speaker:女人的呼唤":{"text":"Woman's Voice","source":"女人的呼唤","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"Narrator","source":"旁白","status":"matched_dialogue_flow"},"speaker:尤里娅":{"text":"Euria","source":"尤里娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":57,"localized_text_count":56,"speaker_count":7}}