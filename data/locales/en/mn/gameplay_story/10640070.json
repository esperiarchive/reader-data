{"asset_key":"mn/gameplay_story_10640070","episode":"mn","category":"gameplay_story","story_id":"10640070","schema_version":1,"lang":"en","texts":{"say:1:1064007001:0":{"text":"Now, we just need one final ingredient—concentrated elemental essence—and we'll be ready to prepare the Summoner's Stew!","source_cn":"只差最后一种食材——浓郁的元素精华，我们就能制作混沌虚...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1064007002:1":{"text":"I hope everything goes well this time...","source_cn":"希望这次能顺利一点……","status":"matched_luae","hash_xxh64":"0x47ACB46555129076","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1064007002":{"text":"I hope everything goes well this time...","source_cn":"希望这次能顺利一点……","status":"matched_luae","hash_xxh64":"0x47ACB46555129076","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1064007003:0":{"text":"Glad to hear that!","source_cn":"那我就放心了！","status":"matched_gender<key:male>","hash_xxh64":"0x4C614FFA6BCA61CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1064007004:0":{"text":"So, about our next stop... Can you guys tell me more about it?","source_cn":"那这次，我们要去的地方是什么样的呢？","status":"matched_gender<key:male>","hash_xxh64":"0xFC01B92E50F5261F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1064007004":{"text":"So, about our next stop... Can you guys tell me more about it?","source_cn":"那这次，我们要去的地方是什么样的呢？","status":"matched_gender<key:male>","hash_xxh64":"0xFC01B92E50F5261F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1064007005:1":{"text":"This place is split into two areas—the surface, where Brimstone Village bustles with talented dwarf craftsmen.","source_cn":"这里有两个区域，一个是地面之上，那里有一个矮人工匠村—...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1064007006:1":{"text":"Dwarves, huh...","source_cn":"矮人啊……","status":"matched_luae","hash_xxh64":"0xF7233F9348C519DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1064007007:1":{"text":"And the underground, and we're now heading to its lava area.","source_cn":"另一个就是地底，我们这次去的就是位于那里的熔岩区。","status":"matched_luae","hash_xxh64":"0xF9D1F64F37956588","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1064007008:1":{"text":"A dragon once lived there, which makes the place special.","source_cn":"那里很特别，还曾经生活着龙呢。","status":"matched_luae","hash_xxh64":"0x38D33BA3F27E4A64","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1064007009:1":{"text":"Say what?! Dragon?!","source_cn":"什么？！龙？！","status":"matched_luae","hash_xxh64":"0x28A1F1A795961702","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1064007010:1":{"text":"Calm down, Laios. The dragon has flown away.","source_cn":"莱欧斯，你不要太激动，龙已经飞走了。","status":"matched_luae","hash_xxh64":"0x747316238B5D10D7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1064007011:1":{"text":"...Ah, we're late.","source_cn":"……来晚了呢。","status":"matched_luae","hash_xxh64":"0xD460EB7FE64A376B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1064007012:1":{"text":"...Why the disappointment?","source_cn":"……你在遗憾什么啊？","status":"matched_luae","hash_xxh64":"0x82B6D7C0448C530D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1064007013:0":{"text":"May I ask some questions about the dragon?","source_cn":"既然已经这样了……那我可以问几个问题吗？","status":"matched_luae","hash_xxh64":"0x76093BFB1492AE4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:24:1064007013":{"text":"May I ask some questions about the dragon?","source_cn":"既然已经这样了……那我可以问几个问题吗？","status":"matched_luae","hash_xxh64":"0x76093BFB1492AE4D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1064007014:1":{"text":"Are there any differences between the Primordial Dragon and the Red Dragon?","source_cn":"好，请问初始之龙跟炎龙有什么区别？","status":"matched_gender<key:male>","hash_xxh64":"0x477F8D938F68B589","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1064007015:1":{"text":"How big is the Primordial Dragon? Can it breathe fire?","source_cn":"体型大小如何？会喷火吗？","status":"matched_gender<key:male>","hash_xxh64":"0x0EDE95F5D84F6CE2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1064007016:1":{"text":"What kind of habitat does it live in? And what does its meat taste like?","source_cn":"生活的环境怎么样呢？肉又是什么味道的呢？","status":"matched_gender<key:male>","hash_xxh64":"0x62A08B505E0CF1FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:29:1064007016":{"text":"What kind of habitat does it live in? And what does its meat taste like?","source_cn":"生活的环境怎么样呢？肉又是什么味道的呢？","status":"matched_gender<key:male>","hash_xxh64":"0x62A08B505E0CF1FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1064007017:1":{"text":"Alas, what a shame.","source_cn":"啊……太可惜了。","status":"matched_gender<key:male>","hash_xxh64":"0x5FAA94A76ECF2772","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1064007018:0":{"text":"What's wrong again?!","source_cn":"你又在可惜什么啊？！","status":"matched_luae","hash_xxh64":"0xABF36B8A78A54202","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:33:1064007018":{"text":"What's wrong again?!","source_cn":"你又在可惜什么啊？！","status":"matched_luae","hash_xxh64":"0xABF36B8A78A54202","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1064007019:1":{"text":"Is that true?! I've never seen a dragon egg!","source_cn":"真的吗！？我还没有见过龙蛋！","status":"matched_gender<key:male>","hash_xxh64":"0x6048B03FA59347E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1064007020:1":{"text":"When I think of a dragon-like creature hatching from an egg, I get goosebumps...","source_cn":"一想到龙这种生物是从龙蛋里孵化出来，我就忍不住战栗了起来。","status":"matched_luae","hash_xxh64":"0x1B35AF7ADD66BB29","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1064007021:1":{"text":"Life is amazing, isn't it? A tiny hatchling can eventually grow into such a mighty creature...","source_cn":"生物真的很不可思议呢……竟然能从那样的蛋成长为如此强大...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1064007022:1":{"text":"He's starting again... monster maniac...","source_cn":"又开始了……魔物控……","status":"matched_luae","hash_xxh64":"0x3C6A3CE284E71115","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1064007023:1":{"text":"Let's speed up!","source_cn":"快点走吧！","status":"matched_luae","hash_xxh64":"0x124B9E464C1E9B5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:42:1064007024:1":{"text":"At Laios' urging, you make it to Ironhold Bay without a hitch.","source_cn":"","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:43:1064007025:1":{"text":"You weave your way through the bustling streets of Brimstone Village and step into the mine, where you run into your old dwarven friend, Zanie.","source_cn":"","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1064007026:0":{"text":"Zanie, long time no see!","source_cn":"祖娅，好久不见！","status":"matched_luae","hash_xxh64":"0x82AA61640572FA92","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1064007027:1":{"text":"Hey there! I see you have four new companions...","source_cn":"嗨，是你们啊！后面这四个……","status":"matched_luae","hash_xxh64":"0x0E719044DFEF8386","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1064007028:1":{"text":"Quite the unusual crew you've brought along today!","source_cn":"真是一个少见的组合啊。","status":"matched_luae","hash_xxh64":"0x44A04D3687AC16AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:48:1064007028":{"text":"Quite the unusual crew you've brought along today!","source_cn":"真是一个少见的组合啊。","status":"matched_luae","hash_xxh64":"0x44A04D3687AC16AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1064007029:1":{"text":"I'm glad that everyone can get to know each other, but introducing everyone each time is quite exhausting...","source_cn":"虽然能让大家认识很开心，但每次都要介绍也是挺累的呢……","status":"matched_luae","hash_xxh64":"0x02157CC89E9D45F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:51:1064007030:1":{"text":"Don't complain, Hammie. I've been introducing myself so much lately.","source_cn":"别抱怨了，我最近可是一直不停的自我介绍呢。","status":"matched_luae","hash_xxh64":"0x413B214C77F8EAD5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:52:1064007031:1":{"text":"Investment, transport, research—one thing after another keeps coming at me, and honestly, I'm sick of it.","source_cn":"什么投资啊、运输啊、研究啊，接二连三地来，说实话我已经...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:53:1064007032:1":{"text":"For a moment, I thought you were bringing Senshi here to mine!","source_cn":"我差点以为你们介绍森西过来采矿呢。","status":"matched_luae","hash_xxh64":"0xFADC9B7716297F1B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:55:1064007033:1":{"text":"...Well, I'm more or less like a cook.","source_cn":"……老夫，可以说是个厨师之类的人吧。","status":"matched_luae","hash_xxh64":"0xE22F96227764D3CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:56:1064007034:1":{"text":"Oh, r-really? I see. That's... quite a rare profession among dwarves.","source_cn":"啊，这样啊。这在矮人中也是挺少见的哈。","status":"matched_luae","hash_xxh64":"0x4F53CA135E89A7A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:58:1064007035:1":{"text":"...This is getting awkward.","source_cn":"……天好像聊死了。","status":"matched_luae","hash_xxh64":"0x47218F8EAA64E8B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:59:1064007036:1":{"text":"So, uh... let's go grab the elemental essence, shall we?","source_cn":"那个，这个……总之我们现在去弄元素精华吧。","status":"matched_luae","hash_xxh64":"0xFF029370138E8C86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:61:1064007037:1":{"text":"Catch you later, Zanie! You're a lovely little girl!","source_cn":"祖娅小妹妹，很高兴认识你，再见！","status":"matched_luae","hash_xxh64":"0x74676E523C79C6CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:62:1064007038:1":{"text":"Hahaha! It's happening again!","source_cn":"哈哈哈哈！又来了！","status":"matched_luae","hash_xxh64":"0xAEE36259EE5B91F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:63:1064007039:1":{"text":"No way I'm a little girl! I'm already several hundred years old!","source_cn":"我可不是小妹妹！我几百岁了哦！","status":"matched_luae","hash_xxh64":"0x7A35BCE1B4335EFF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:65:1064007040:1":{"text":"It's so hard to tell a dwarf's age.","source_cn":"矮人的年龄也太难分辨了吧。","status":"matched_luae","hash_xxh64":"0x7FCD3BEC448B664F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:66:1064007040":{"text":"It's so hard to tell a dwarf's age.","source_cn":"矮人的年龄也太难分辨了吧。","status":"matched_luae","hash_xxh64":"0x7FCD3BEC448B664F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:67:1064007041:1":{"text":"Actually, I've stopped growing after accidentally drinking the dragon egg essence.","source_cn":"我这是误服龙蛋液导致的停止生长。","status":"matched_luae","hash_xxh64":"0x1F6558B11A37D477","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:69:1064007042:0":{"text":"Dragon egg essence has that effect?! Wow...","source_cn":"龙蛋液？！还有这种副作用……","status":"matched_luae","hash_xxh64":"0x95F9FF0F64F40BC5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:70:1064007043:0":{"text":"Ah, there goes another ingredient we can eat.","source_cn":"唉，又少了一种能吃的食材。","status":"matched_luae","hash_xxh64":"0x947C38D4C2FB13BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:72:1064007044:1":{"text":"Were you actually thinking of eating it?!","source_cn":"……你还真想过吃啊？！","status":"matched_luae","hash_xxh64":"0xC59F3EA9F8560DD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:74:1064007045:1":{"text":"Sorry! I just assumed you were a young dwarf...","source_cn":"啊啊，对不起，我完全没看出来！我以为您只是个年轻矮人！","status":"matched_luae","hash_xxh64":"0xBF23782BA7797E6B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:75:1064007046:1":{"text":"If I've offended you, I'll apologize.","source_cn":"实在太不好意思了！","status":"matched_luae","hash_xxh64":"0x27D39431AFAD3E0D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:76:1064007047:1":{"text":"Heh, don't take it to heart! It's always fun to mess with new friends about my age. Haha!","source_cn":"嘿嘿，别放在心上。偶尔用这个吓新认识的人一跳，还是挺有...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:77:1064007048:1":{"text":"The looks on your faces really made my day!","source_cn":"你们现在的表情也值回票价了。","status":"matched_luae","hash_xxh64":"0xF7BD944003079E86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:78:1064007048":{"text":"The looks on your faces really made my day!","source_cn":"你们现在的表情也值回票价了。","status":"matched_luae","hash_xxh64":"0xF7BD944003079E86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:79:1064007049:1":{"text":"I blame that pink pointy-eared dude! I hope you don't have to deal with him this time.","source_cn":"都怪那个粉毛尖耳朵。你们这次不会也要跟他打交道吧？","status":"matched_luae","hash_xxh64":"0x92B59454CA66AB53","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:80:1064007050:1":{"text":"Pointy ears? Are there elves in Esperia too?","source_cn":"尖耳朵？伊索米亚这里也有精灵吗？","status":"matched_luae","hash_xxh64":"0x4EAD5D2E71C572DE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:81:1064007051:1":{"text":"Now that you mention it, their ears are quite similar to yours...","source_cn":"这么说来，耳朵确实有一点像……","status":"matched_luae","hash_xxh64":"0x38AD35026130C557","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:83:1064007052:0":{"text":"Technically, they're not elves, but a unique race with a complicated history.","source_cn":"但准确来说，他们不是精灵。是有着特殊复杂过去的族群……","status":"matched_luae","hash_xxh64":"0x4040ED98DBA25B1C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:84:1064007053:0":{"text":"The story's quite dull, so I'll spare you from it.","source_cn":"那可不是什么多有意思的事情。","status":"matched_luae","hash_xxh64":"0x9A575E2B58C73A17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:86:1064007054:1":{"text":"Let's talk as we go. I'm on my way to collect some nightshards.","source_cn":"我们边走边聊吧，我准备去采集点暗烬晶体。","status":"matched_luae","hash_xxh64":"0xEEE6367FB5927BF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:87:1064007055:1":{"text":"There's this new dish I just learned from Finn—crystallized mushroom soup!","source_cn":"芬恩教了我一个新食谱——晶化伞菇浓汤。","status":"matched_luae","hash_xxh64":"0x4AE7F7368D84B15E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:89:1064007056:1":{"text":"That name isn't exactly appetizing...","source_cn":"这名字，听起来不是很好吃……","status":"matched_luae","hash_xxh64":"0x8781C7F18B561ED7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:90:1064007057:1":{"text":"Haha! Cooking is the same as research. Don't be bound by convention—if you don't take chances once in a while, you'll never make discoveries, right?","source_cn":"嘿！做菜就像搞研究，不能故步自封。有时候冒险才有惊喜！","status":"matched_luae","hash_xxh64":"0x03448A708930609A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:92:1064007058:1":{"text":"I agree. I'm always testing out new recipes with different monsters in the dungeon myself...","source_cn":"老夫很同意这个说法。在迷宫里，老夫也经常尝试各种魔物组合……","status":"matched_luae","hash_xxh64":"0xCD58A83E42836B00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:93:1064007059:1":{"text":"Zanie and Senshi, having found some common ground, dive into a conversation about the ways research and cooking overlap.","source_cn":"","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:94:1064007060:1":{"text":"Later that day, you ride the arcane lift together to gather the ingredients you need.","source_cn":"","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:78:0:1":{"text":"Zanie, you've gone rogue!","source_cn":"祖娅，你学坏了","status":"matched_runtime_gender","hash_xxh64":"0x5BE7EA510AB32067","variant_status":"runtime_gender_keys_target_same","male":"Zanie, you've gone rogue!","female":"Zanie, you've gone rogue!","variant_male_record_index":"59998","variant_female_record_index":"59999","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:66:0:1":{"text":"Zanie's a special case.","source_cn":"祖娅比较特殊","status":"matched_runtime_gender","hash_xxh64":"0x32D179453648DFB1","variant_status":"runtime_gender_keys_target_same","male":"Zanie's a special case.","female":"Zanie's a special case.","variant_male_record_index":"59996","variant_female_record_index":"59997","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:48:0:1":{"text":"They are from another dimension...","source_cn":"（向祖娅介绍了他们）","status":"matched_runtime_gender","hash_xxh64":"0xD3FEC0BDAEDC40A1","variant_status":"runtime_gender_keys_target_same","male":"They are from another dimension...","female":"They are from another dimension...","variant_male_record_index":"59994","variant_female_record_index":"59995","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:33:0:1":{"text":"There are some eggs left.","source_cn":"但部分龙蛋还在","status":"matched_runtime_gender","hash_xxh64":"0xACDC8E79B59A3C75","variant_status":"runtime_gender_keys_target_same","male":"There are some eggs left.","female":"There are some eggs left.","variant_male_record_index":"59992","variant_female_record_index":"59993","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:29:0:1":{"text":"It's an intelligent creature.","source_cn"