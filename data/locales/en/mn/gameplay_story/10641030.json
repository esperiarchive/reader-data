{"asset_key":"mn/gameplay_story_10641030","episode":"mn","category":"gameplay_story","story_id":"10641030","schema_version":1,"lang":"en","texts":{"say:1:1064103001:1":{"text":"So hungry... Good thing there's still some bread left.","source_cn":"好饿……幸好晚餐时剩下了一些面包。","status":"matched","hash_xxh64":"0x8EBE7DF316D3178F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1064103002:1":{"text":"Such gentle moonlight... It would've been another peaceful night if not for the tragedy.","source_cn":"月色多么皎洁啊……如果没有发生那桩惨案，本该是宁静的一夜……","status":"matched","hash_xxh64":"0xDF85CE4493D61EA0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1064103003:1":{"text":"*Squeak*","source_cn":"咔吱——","status":"matched","hash_xxh64":"0x38B6C7D979833F3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1064103004:1":{"text":"Huh? What was that?","source_cn":"……奇怪，哪里来的声音？","status":"matched","hash_xxh64":"0x089B07C3B7B5F758","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:8::0":{"text":"Cabinet","source_cn":"橱柜","status":"matched","hash_xxh64":"0x1FEF9F894DC6E389","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1064103005:1":{"text":"It's coming from the cabinet. Could it be rats?","source_cn":"好像是从那只橱柜里传出来的。难道有老鼠在偷吃？","status":"matched","hash_xxh64":"0xBD71875B6B28DB87","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1064103006:1":{"text":"Oh, absolutely not. I need to chase them out.","source_cn":"这可不行！我得把它们赶走。","status":"matched","hash_xxh64":"0x239749EDFA9CBCF4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:12:1064103007:1":{"text":"Ada tiptoes to the cabinet and yanks the door open!","source_cn":"","status":"matched","hash_xxh64":"0x1EE3A725434FECB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:1064103008:1":{"text":"It's not a rat, but a man with a knife!","source_cn":"","status":"matched","hash_xxh64":"0x5F846ADBAEDAEB61","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1064103009:1":{"text":"Wh-Who are you?","source_cn":"你……你是谁？！","status":"matched","hash_xxh64":"0xA315D60602DDC975","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1064103010:0":{"text":"Damn it...","source_cn":"可恶……","status":"matched","hash_xxh64":"0x4F874984482DC30F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1064103011:0":{"text":"Die!","source_cn":"——去死吧！！","status":"matched","hash_xxh64":"0x1BD802988910ED97","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1064103012:0":{"text":"Ah! H-Help!","source_cn":"啊——！救、救命啊——！","status":"matched","hash_xxh64":"0xDCA90DF0831B0E3B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1064103013:0":{"text":"Stop right there! You're m—","source_cn":"别想跑！今天就是你的——","status":"matched","hash_xxh64":"0xFBC41111445F3903","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:27:1064103014:0":{"text":"A beam of holy light slams down from above, cutting the villain's words short.","source_cn":"一道神光从天而降，终结了恶徒的话语","status":"matched","hash_xxh64":"0x0314DCE59A647138","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:28:1064103015:1":{"text":"Trembling, Ada forces her eyes open... and the scene before her takes her breath away.","source_cn":"","status":"matched","hash_xxh64":"0x95F8C7D0D5D4EAB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:29:1064103016:1":{"text":"A shiny ivory lance pierces the attacker straight through his chest. He's dead before he hits the floor.","source_cn":"","status":"matched","hash_xxh64":"0xA29AD611B563D01A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:30:1064103017:1":{"text":"The lance is transformed into an ethereal woman, radiating sacred presence.","source_cn":"","status":"matched","hash_xxh64":"0x7EF52D53E436FBB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1064103018:1":{"text":"Judgment made.","source_cn":"裁决已至。","status":"matched","hash_xxh64":"0x46A888042F5B8C60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1064103019:1":{"text":"Y-You are...?","source_cn":"您、您是……","status":"matched","hash_xxh64":"0x5831AC0C12DCAFAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1064103020:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1064103021:1":{"text":"What's going—Oh my!","source_cn":"发生了什——噢，天哪……","status":"matched","hash_xxh64":"0xF884EB5C08AAE4B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1064103022:1":{"text":"Dura above. You are Lady Athalia!","source_cn":"艾雅在上……是、是阿塔利娅大人！","status":"matched","hash_xxh64":"0x76BE8CCF77925DBF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1064103023:1":{"text":"Lady Athalia? The Harbinger of Justice?","source_cn":"真、真的是阿塔利娅大人，传说中的天罚之刃……","status":"matched","hash_xxh64":"0x759B4472F1CAC833","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1064103024:1":{"text":"The evil has been purged.","source_cn":"恶徒已经清除。","status":"matched","hash_xxh64":"0x21F5CB7462479D7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1064103025:1":{"text":"You mean him?","source_cn":"您是说这个男人？","status":"matched","hash_xxh64":"0xFE5EDE4BBDBF5C58","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1064103026:1":{"text":"Yes! I found him hiding in the cabinet and he tried to kill me!","source_cn":"是的！路易莎修女，他一直躲在橱柜里，被我发现后还想伤害我！","status":"matched","hash_xxh64":"0x7A634AA10931E7AE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1064103027:1":{"text":"Dura above... Vincenzo?","source_cn":"艾雅在上……这不是文森佐吗？！","status":"matched","hash_xxh64":"0x81361E56AB70A3C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1064103028:1":{"text":"You know him?","source_cn":"文森佐？您认识他？","status":"matched","hash_xxh64":"0x5686B0E10B7E8331","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1064103029:1":{"text":"The temple took in many war refugees ten years ago. Vincenzo was one of them. He hid in this very cabinet.","source_cn":"十年前，教堂曾收留过很多战争难民，文森佐就是其中之一。...","status":"matched","hash_xxh64":"0x1AA5A6C23FA397F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1064103030:1":{"text":"He was no refugee. He was one of the Adamant Syndicate members, an outlaw who brings ruin wherever he goes.","source_cn":"他不是战争难民，他是黑金商会的残党，四处为非作歹。","status":"matched","hash_xxh64":"0x92E94BD7987B309E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:48:1064103031:0":{"text":"Can't believe he joined the Syndicate...","source_cn":"没想到，他竟然加入了黑金商会……","status":"matched","hash_xxh64":"0x4D5BE45A0CEC965A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1064103032:0":{"text":"I hope you don't mind me asking, but has he committed many crimes?","source_cn":"阿塔利娅大人，请宽恕我的冒昧询问。他做了很多坏事吗？","status":"matched","hash_xxh64":"0xC81DF42CE4C76D20","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:51:1064103033:0":{"text":"Yes. Such is the nature of the Adamant Syndicate.","source_cn":"是。黑金商会成员皆是如此。","status":"matched","hash_xxh64":"0xDAC80B225D85D61C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:52:1064103034:1":{"text":"His comrades have been erased under the name of justice. But this one dared to defile the Dura's refuge by hiding here! Unforgivable.","source_cn":"其余同党都已被我裁决。而他，竟敢躲藏于教堂，玷污女神庇...","status":"matched","hash_xxh64":"0xF95CAA5B015BBC51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:53:1064103035:1":{"text":"Could he be the one who killed Lero?","source_cn":"那么，杀害列罗的凶手，有没有可能也是他？","status":"matched","hash_xxh64":"0xD22900452DA7977F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:54:1064103036:1":{"text":"A murder?","source_cn":"杀害他人？","status":"matched","hash_xxh64":"0x1777775CCF874BD8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:55:1064103037:1":{"text":"Yes. A tragedy struck Ensar...","source_cn":"是，恩莎村发生了一桩惨案……","status":"matched","hash_xxh64":"0xCF99C69E07308A16","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:56:1064103038:1":{"text":"The two tell Athalia Lero's death in detail.","source_cn":"","status":"matched","hash_xxh64":"0x392BCA8FEFE3C7F2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:57:1064103039:1":{"text":"That's everything.","source_cn":"……事情就是如此。","status":"matched","hash_xxh64":"0x64F44C2DBA93A9CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:58:1064103040:1":{"text":"Lady Athalia, we humbly seek your aid. Could you, by your divine power, confirm whether Vincenzo is the one who killed Lero? A grieving wife and son beg for your mercy.","source_cn":"尊敬的阿塔利娅大人，能否恳请您用神力确认文森佐是否为杀...","status":"matched","hash_xxh64":"0x31E91CA67C15176A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:59:1064103041:1":{"text":"I need to compare the weapon, the wound, and the blood.","source_cn":"需要比对凶器、伤口和血液。","status":"matched","hash_xxh64":"0x14B6E3CC9A628D37","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:60:1064103042:1":{"text":"Where is the body?","source_cn":"尸体在哪？","status":"matched","hash_xxh64":"0xF6A18F2783DB5B8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:61:1064103043:1":{"text":"Please follow me.","source_cn":"请随我来。","status":"matched","hash_xxh64":"0x7F6596F9C2B88DFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:62:1064103044:0":{"text":"The acolytes lead Athalia to the side hall.","source_cn":"两位修女带领阿塔利娅来到教堂侧厅","status":"matched","hash_xxh64":"0xA86993D18E80BDDF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:63:1064103045:0":{"text":"Lero's body lies quietly within a coffin.","source_cn":"列罗的遗体静静躺在棺材内","status":"matched","hash_xxh64":"0x1C379FD8A9AC9C5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:65:1064103046:1":{"text":"Lady Athalia, this is Lero.","source_cn":"阿塔利娅大人，这就是那位可怜之人，列罗的遗体。","status":"matched","hash_xxh64":"0xCA7ED1DD8ECF75F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:66:1064103047:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:67:1064103048:1":{"text":"Dark magic was cast upon him. One meant to turn a human into a Hypofiend. The same craft the Adamant Syndicate wields.","source_cn":"有人曾向他施加过将其转化为魔物的黑魔法，和黑金商会所掌...","status":"matched","hash_xxh64":"0x9B2588474913EB34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:68:1064103049:1":{"text":"There are more of them!","source_cn":"附近必定藏有其他黑金残党！","status":"matched","hash_xxh64":"0xCB1D454CB680E165","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:69:1064103050:1":{"text":"Dura above. How could this be?","source_cn":"艾雅在上……怎么会这样？","status":"matched","hash_xxh64":"0xD54514A77E581CF9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:70:1064103051:1":{"text":"You mean... Syndicate stragglers here in the village? How did they have the chance to use dark magic on him?","source_cn":"难道恩莎村还藏着漏网之鱼？！可就算是这样……那个人又是...","status":"matched","hash_xxh64":"0x32CA98A153CB3E8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:71:1064103052:1":{"text":"...","source_cn":"……","status":"matched","hash_xxh64":"0xC4D94AD9463C9058","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:72:1064103053:0":{"text":"We did.","source_cn":"找到了。","status":"matched","hash_xxh64":"0x431B8DE52D65174D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:77:1064103054:1":{"text":"Wh-Where are you going, Lady Athalia?","source_cn":"您要去哪里？！阿塔利娅大人！","status":"matched","hash_xxh64":"0x9A2EB858715E6A10","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:78:1064103055:1":{"text":"Ada, keep with Lady Athalia. Hurry!","source_cn":"艾达修女，你快跟上阿塔利娅大人！快，快！","status":"matched","hash_xxh64":"0xD6848F4390F646A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修女艾达":{"text":"Acolyte Ada","source":"修女艾达","status":"matched_dialogue_flow"},"speaker:奇怪的异响":{"text":"Strange Noise","source":"奇怪的异响","status":"matched_dialogue_flow"},"speaker:黑屏文字":{"text":"Black Screen Text","source":"黑屏文字","status":"matched_dialogue_flow"},"speaker:？？？":{"text":"???","source":"？？？","status":"matched_dialogue_flow"},"speaker:阿塔利娅":{"text":"Athalia","source":"阿塔利娅","status":"matched_dialogue_flow"},"speaker:修女路易莎":{"text":"Acolyte Louisa","source":"修女路易莎","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":57,"localized_text_count":56,"speaker_count":6}}