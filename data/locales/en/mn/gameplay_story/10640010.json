{"asset_key":"mn/gameplay_story_10640010","episode":"mn","category":"gameplay_story","story_id":"10640010","schema_version":1,"lang":"en","texts":{"say:2:1064001001:0":{"text":"Hm...","source_cn":"唔……<key:dialog64>","status":"matched_luae","hash_xxh64":"0x16ADADC6BAFAD984","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1064001002:1":{"text":"Laios, you're finally awake!","source_cn":"莱欧斯！你终于醒了！","status":"matched_luae","hash_xxh64":"0x629D551451BE71D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1064001003:1":{"text":"You guys are here... Wait, where's Senshi?","source_cn":"玛露西尔、齐尔查克、森……呃？森西呢？","status":"matched_luae","hash_xxh64":"0xAEC5B9402B29287F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1064001004:1":{"text":"Senshi has teleportation sickness, so he's resting over there.","source_cn":"森西晕传送，正在一旁休息。","status":"matched_luae","hash_xxh64":"0xCEC233DF66F36C01","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1064001005:1":{"text":"I think we got here from the dungeon through teleportation.","source_cn":"我们似乎在迷宫里被传送出来了。","status":"matched_luae","hash_xxh64":"0x270D75194005D00D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1064001006:1":{"text":"Where are we?","source_cn":"所以，这里是……？","status":"matched_luae","hash_xxh64":"0x979634A0BCCB8BF4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1064001007:1":{"text":"Hi, my name is Hammie, and you're in the land of Esperia.","source_cn":"你好，我是漫漫。这里是伊索米亚。","status":"matched_luae","hash_xxh64":"0xF94679DB350208ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1064001008:1":{"text":"Wait, a talking mouse monster?","source_cn":"等等——会说话的仓鼠魔物？","status":"matched_luae","hash_xxh64":"0xAA7E78EFD812A862","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1064001009:1":{"text":"They are familiars!","source_cn":"……他们是使魔啦！","status":"matched_luae","hash_xxh64":"0xBE56B90F85A33204","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1064001010:1":{"text":"Chippy and Hammie are familiars that can only be created by strong mages. We call them Magisters.","source_cn":"满满和漫漫是强大的魔法师——也就是我们那里被称为魔术师...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1064001011:1":{"text":"Marcille's right! We're the familiars of Magister Merlin, the most powerful mage in Esperia!","source_cn":"玛露西尔小姐说得没错！我们的主人正是伊索米亚最强大的魔...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1064001012:1":{"text":"That name doesn't ring a bell...","source_cn":"完全没听说过……","status":"matched_luae","hash_xxh64":"0xC87A5BDEF55E37DC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1064001013:1":{"text":"*Blech* Ugh...","source_cn":"老……呕……","status":"matched_luae","hash_xxh64":"0x9E1B6F42FF0573C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1064001014:1":{"text":"Are you alright, Sir? You don't seem well. Please, allow us to take you to the Mystical House for treatment.","source_cn":"这位森西先生看起来状态不是很好，先跟我们回神秘屋治疗一下吧。","status":"matched_luae","hash_xxh64":"0x7461B5B521238BED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1064001015:1":{"text":"You can help Senshi? Thank you!","source_cn":"有办法治疗吗？那就拜托你们了。","status":"matched_luae","hash_xxh64":"0x25E57CBBDC3AF367","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1064001016:0":{"text":"Hey, don't go just yet! I'm still confused!","source_cn":"等等，还是没有人跟我解释清楚状况啊！别走啊——","status":"matched_luae","hash_xxh64":"0x3D8528EFF16B50B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:30:1064001017:1":{"text":"Hammie and Chippy bring Marcille and her companions back to the Mystical House...","source_cn":"漫漫和满满带着玛露西尔一行人返回了神秘屋……","status":"matched_luae","hash_xxh64":"0xCC56AC51449DC902","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1064001018:1":{"text":"Magister! Here!","source_cn":"梅林，梅林——快来帮帮忙！","status":"matched_gender<key:male>","hash_xxh64":"0x81254A07E3F8CCD2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1064001019:1":{"text":"This gentleman just teleported here, and he's feeling sick!","source_cn":"这位森西先生晕传送晕得很厉害！","status":"matched_gender<key:male>","hash_xxh64":"0x88CFD2626653834F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1064001020:1":{"text":"Senshi's a dwarf, so he easily gets teleportation sickness...","source_cn":"森西是矮人，是很容易晕传送的体质……","status":"matched_luae","hash_xxh64":"0x19D3E1BC3580AF05","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1064001021:1":{"text":"Oh, I forgot to introduce myself. Nice to meet you, Magister Merlin! I'm Marcille, also a mage.","source_cn":"啊，忘记自我介绍了。梅林<male>先生</male>...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:37:1064001021":{"text":"Oh, I forgot to introduce myself. Nice to meet you, Magister Merlin! I'm Marcille, also a mage.","source_cn":"啊，忘记自我介绍了。梅林<male>先生</male><female>女士</female>，我是玛露西尔，也是一名魔法师。","status":"matched_luae_markup","hash_xxh64":"0xE994AB8C6FA2B556","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1064001022:1":{"text":"I can help!","source_cn":"我也来一起帮忙吧！","status":"matched_gender<key:male>","hash_xxh64":"0xC22896E2E85DCB9F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1064001023:1":{"text":"No... Ugh...","source_cn":"不……要……呃……","status":"matched_luae","hash_xxh64":"0x152D35E755171AAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:42:1064001023":{"text":"No... Ugh...","source_cn":"不……要……呃……","status":"matched_luae","hash_xxh64":"0x152D35E755171AAF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:43:1064001024:1":{"text":"Under your treatment, Senshi is starting to feel better.","source_cn":"","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:44:1064001025:0":{"text":"Chippy and Hammie eagerly recount your past feats to the four, their tone laced with enthusiasm and a hint of bragging.","source_cn":"莱欧斯、玛露西尔、齐尔查克和森西也在满满和漫漫的热情说...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:45:1064001026:0":{"text":"Meanwhile, you learn that they are adventurers from another dimension. They explored the dungeon in search of Falin, their companion who was eaten by the Red Dragon.","source_cn":"你也得知了他们是来自于另一个世界的冒险者。他们在迷宫中...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:46:1064001027:1":{"text":"After reviving Falin, they encountered the Lord of the Dungeon and were forced to part ways with her once more.","source_cn":"","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:47:1064001028:1":{"text":"They then lost their way in the ever-changing dungeon and encountered a monster they had neither seen nor heard of.","source_cn":"","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:48:1064001029:1":{"text":"They passed out while battling the monster. When they woke up, they found themselves in Esperia.","source_cn":"","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1064001030:1":{"text":"Your journey is full of ups and downs! Chippy feels for you...","source_cn":"好曲折的冒险！满满听着都觉得辛苦……","status":"matched_luae","hash_xxh64":"0x8417DFDDC0F9EEB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:51:1064001031:0":{"text":"It's definitely been a tough ride, but along the way, we got to taste monsters with different flavors.","source_cn":"是有点辛苦了，但也品尝到了很多不同风味的魔物。","status":"matched_luae","hash_xxh64":"0x5D2C61DDA5AC4B32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:52:1064001032:1":{"text":"You mean you ate them?! Good heavens! You won't eat Chippy, will you?","source_cn":"……吃魔物？！呜哇，你们不会、不会吃满满吧？！","status":"matched_luae","hash_xxh64":"0xB3FB8FB1D3861FDA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:54:1064001033:0":{"text":"*Growl*","source_cn":"咕——","status":"matched_luae","hash_xxh64":"0x50227C51D4BBA586","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:57:1064001034:0":{"text":"Laios, don't scare them! And seriously, can you quiet your stomach down for a bit?","source_cn":"莱欧斯！不要吓人啦！还有，你的肚子叫得太大声了——","status":"matched_luae","hash_xxh64":"0xD54356F65584482B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:58:1064001035:1":{"text":"Fret not, Chippy! We don't eat every monster we come across—we pick and choose which kinds to eat.","source_cn":"别担心，满满！我们可不是什么魔物都吃的，我们会挑选对象的。","status":"matched_luae","hash_xxh64":"0x9D56E917C8DD67A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:60:1064001036:1":{"text":"...Is that supposed to be reassuring?","source_cn":"……那算是圆场吗？","status":"matched_luae","hash_xxh64":"0xB02411C27F8E8BB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:62:1064001037:0":{"text":"*Cough* I can't let youngsters go hungry...","source_cn":"咳咳，不能……让年轻人饿肚子……","status":"matched_luae","hash_xxh64":"0x4893B25613E6ED0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:65:1064001038:1":{"text":"Sorry to keep you waiting! Magister Merlin asked me to prepare a meal for you. Please eat this and take a good rest.","source_cn":"久等了！根据梅林大人的吩咐我准备了食物，请好好享用并休息吧。","status":"matched_luae","hash_xxh64":"0xB5AB3A98374C857F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:65::2":{"text":"Noble Tavern Signature Combo","source_cn":"月桂酒馆套餐","status":"matched","hash_xxh64":"0xDCCAD1C9B43A1A2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:66:1064001039:1":{"text":"Behold, the Noble Tavern's signature set! It comes with fried chicken wings with radish sauce, paired with the refreshing glowfly fruit brew.","source_cn":"请品尝我们月桂酒馆的招牌套餐吧！秘制炸鸡翅配特色葱萝酱...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:68:1064001040:0":{"text":"Chicken wings?! Finally, some normal food! *Sob*","source_cn":"鸡翅？！好正常的食材，呜呜——","status":"matched_luae","hash_xxh64":"0xCFE0FA73A293D236","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:70:1064001041:1":{"text":"Finally, I get to eat a meal that doesn't involve monsters!","source_cn":"太好了！终于能吃到魔物以外的食物了！","status":"matched_luae","hash_xxh64":"0xC80B2DA8BAB8FA7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:72:1064001042:1":{"text":"Wow, this ale smells great!","source_cn":"唔，这个啤酒闻起来好香——","status":"matched_luae","hash_xxh64":"0x1EBB48E8CD35B18F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:73:1064001043:1":{"text":"Let me take a gulp...","source_cn":"我来尝一尝——","status":"matched_luae","hash_xxh64":"0x808E7D41BBD78A0B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:75:1064001044:1":{"text":"Ahh! The foam is fine, and the body is rich and smooth! The fruity and malty flavors are perfectly balanced!","source_cn":"嗝——上层泡沫细腻，酒体醇厚顺滑！果味和麦芽醇香完美平衡！","status":"matched_luae","hash_xxh64":"0x95A23084BFDF2989","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:77:1064001045:1":{"text":"Mmm, this is divine! I'm feeling better already.","source_cn":"呼！老夫也觉得不错，似乎觉得连眩晕感都好了不少。","status":"matched_luae","hash_xxh64":"0x38A1AAD0CA0E99C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:79:1064001046:1":{"text":"Yummy! Crispy skin and succulent, juicy meat... Quite similar to the texture of Basilisk, if you ask me.","source_cn":"美味！外皮酥脆，内里多汁……和蛇尾鸡的口感有一些相似呢。","status":"matched_luae","hash_xxh64":"0x778E24B8E095FF3D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:81:1064001047:1":{"text":"It's the other way around! This is the real chicken!","source_cn":"本末倒置了！这才是纯正的鸡肉啊！","status":"matched_luae","hash_xxh64":"0x8BDABBD93D90ACBC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:83:1064001048:1":{"text":"...Speaking of Basilisk, how do we get back to the dungeon?","source_cn":"……说到蛇尾鸡，我们要怎么回迷宫啊？","status":"matched_luae","hash_xxh64":"0x9FEB26E5054106B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:84:1064001049:0":{"text":"I'm just as lost as you.","source_cn":"我也不知道。","status":"matched_luae","hash_xxh64":"0x7E12E4FA1E8840D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:85:1064001050:0":{"text":"We haven't even figured out how we got here...","source_cn":"我们怎么过来的都没有搞清楚……","status":"matched_luae","hash_xxh64":"0x6AAFA5C6468DB455","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:86:1064001051:0":{"text":"We were fighting a monster before we passed out, right?","source_cn":"我们晕过去之前是跟一个魔物战斗吧？","status":"matched_luae","hash_xxh64":"0xE7A46C9C1585E356","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:87:1064001051":{"text":"We were fighting a monster before we passed out, right?","source_cn":"我们晕过去之前是跟一个魔物战斗吧？","status":"matched_luae","hash_xxh64":"0xE7A46C9C1585E356","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:88:1064001052:1":{"text":"None of us has seen or heard of the monster before.","source_cn":"我们没有一个人见过或者听说过。","status":"matched_gender<key:male>","hash_xxh64":"0x7EEE69B41AFDB382","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:89:1064001052":{"text":"None of us has seen or heard of the monster before.","source_cn":"我们没有一个人见过或者听说过。","status":"matched_gender<key:male>","hash_xxh64":"0x7EEE69B41AFDB382","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:90:1064001053:1":{"text":"Hmm... It looked like an octopus, with eight tentacles protecting its sac-like core.","source_cn":"唔……那个魔物有着类似章鱼的构造，有八个腕足保护着囊状核心。","status":"matched_gender<key:male>","hash_xxh64":"0xBF99E6677A703722","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:91:1064001054:1":{"text":"It had several eyes on its head; its deep purple body is covered in star-like spots.","source_cn":"头上有着好几只深紫色的眼睛，并且带着星光状的斑点。","status":"matched_gender<key:male>","hash_xxh64":"0xE61DB7BC0AE59B2E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:92:1064001055:1":{"text":"You noticed all that in such a short time...","source_cn":"亏你能在短时间内观察这么细……","status":"matched_luae","hash_xxh64":"0xE57DE4928E623653","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:95:1064001056:1":{"text":"Magister... I think I might have seen it in one of your magic tomes.","source_cn":"梅林……我好像在你珍藏的魔法书里有见到过这样的魔物。","status":"matched_gender<key:male>","hash_xxh64":"0x2E3A4FE6854BAA7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:97:1064001057:1":{"text":"Oh, is that so? Magister Merlin, may I have a look at that tome?","source_cn":"咦？真的吗？梅林<male>先生</male><fem...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:98:1064001057":{"text":"Oh, is that so? Magister Merlin, may I have a look at that tome?","source_cn":"咦？真的吗？梅林<male>先生</male><female>女士</female>，请问那本书在哪里？","status":"matched_luae_markup","hash_xxh64":"0xCF79555AABB8B8CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:99:1064001058:1":{"text":"No... We need to find a way back, or Falin...","source_cn":"那怎么办？我们得想办法回去，毕竟法琳现在……","status":"matched_gender<key:male>","hash_xxh64":"0x7EECBF85C5DCE3AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:100:1064001059:1":{"text":"Don't worry, Marcille. The magic tome should be around here somewhere. The Magister and I will look for it!","source_cn":"玛露西尔，先别着急。那本书应该就在神秘屋里，我和主人去...","status":"matched_manual_luae_source","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:101:1064001060:1":{"text":"I'll help too! I study ancient magic! Maybe I could help!","source_cn":"我也来帮忙！我研究的是古代魔法，或许能派上用场！","status":"matched_luae","hash_xxh64":"0x5F222DDAAA607166","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:102:1064001061:1":{"text":"Alright, come along with us!","source_cn":"那就一起吧！","status":"matched_luae","hash_xxh64":"0xC34241D6F6F70CD7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:98:0:1":{"text":"I've lost my memory...","source_cn":"我失忆了……","status":"matched_runtime_gender","hash_xxh64":"0xDC7F2B5C61E6E02A","variant_status":"runtime_gender_keys_target_same","male":"I've lost my memory...","female":"I've lost my memory...","variant_male_record_index":"59924","variant_female_record_index":"59925","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:98:1:2":{"text":"I can't recall.","source_cn":"完全没有印象","status":"matched_runtime_gender","hash_xxh64":"0x796DB0AE6996EB57","variant_status":"runtime_gender_keys_target_same","male":"I can't recall.","female":"I can't recall.","variant_male_record_index":"59926","variant_female_record_index":"59927","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:89:0:1":{"text":"Any distinctive features?","source_cn":"那有什么特征吗？","status":"matched_runtime_gender","hash_xxh64":"0x3194AD2293B2B422","variant_status":"runtime_gender_keys_target_same","male":"Any distinctive features?","female":"Any distinctive features?","variant_male_record_index":"59922","variant_female_record_index":"59923","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:87:0:1":{"text":"What's the monster called?","source_cn":"那个魔物叫什么？","status":"matched_runtime_gender","hash_xxh64":"0x74980A97B44C3DAC","variant_status":"runtime_gender_keys_target_same","male":"What's the monster called?","female":"What's the monster called?","variant_male_record_index":"59920","variant_female_record_index":"59921","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:42:0:1":{"text":"(Treat Senshi with Marcille)","source_cn":"（和玛露西尔一起治疗森西）","status":"matched_runtime_gender","hash_xxh64":"0x52C2FB89C93F8213","variant_status":"runtime_gender_keys_target_same","male":"(Treat Senshi with Marcille)","female":"(Treat Senshi with Marcille)","variant_male_record_index":"59918","variant_female_record_index":"59919","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:37:0:1":{"text":"Nice to meet you! Let me see what I can do.","source_cn":"认识你很高兴，我先看看森西先生的情况","status":"matched_runtime_gender","hash_xxh64":"0xFF3979F12CF476AB","variant_status":"runtime_gender_keys_target_same","male":"Nice to meet you! Let me see what I can do.","female":"Nice to meet you! Let me see what I can do.","variant_male_record_index":"59916","variant_female_record_index":"59917","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱欧斯":{"text":"Laios","source":"莱欧斯","status":"matched_dialogue_flow"},"speaker:玛露西尔":{"text":"Marcille","source":"玛露西尔","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:齐尔查克":{"text":"Chilchuck","source":"齐尔查克","status":"matched_dialogue_flow"},"speaker:森西":{"text":"Senshi","source":"森西","status":"matched_dialogue_flow"},"speaker:多莉":{"text":"Dolly","source":"多莉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":74,"localized_text_count":73,"speaker_count":7}}