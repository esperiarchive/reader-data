{"asset_key":"mn/gameplay_story_10610030","episode":"mn","category":"gameplay_story","story_id":"10610030","schema_version":1,"lang":"en","texts":{"narration:0:1061003001:2":{"text":"The moment you leave port, Natsu's eyes glaze over—yet he keeps muttering about fighting...","source_cn":"一上船，纳兹就双眸失神，但嘴里还念叨着要战斗……","status":"matched","hash_xxh64":"0x5C5AED47290B47A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1061003002:0":{"text":"Natsu! Stay with me!","source_cn":"纳兹，你振作一点！","status":"matched","hash_xxh64":"0xD9C9A600EF01F4F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1061003003:0":{"text":"Ugh... Lucy... Multiple Lucys...","source_cn":"呃、露西……好多露西！","status":"matched","hash_xxh64":"0x056DBB0325B046E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1061003004:1":{"text":"Brace yourselves, we're nearing the sea dragon's waters.","source_cn":"就快驶进有海龙的海域了，再坚持一下吧。","status":"matched","hash_xxh64":"0x5315C8C6ABC1174C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1061003005:1":{"text":"W-why are those ships firing at us?!","source_cn":"有、有船在炮轰我们！","status":"matched","hash_xxh64":"0xB047CD9530774499","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1061003006:1":{"text":"Let 'em. With me steering? I'm gonna turn them into firewood.","source_cn":"不用担心，有辛巴达船长在。等着吧，看我撞飞他们！","status":"matched","hash_xxh64":"0x7C42FBEFCF4A6630","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1061003007:0":{"text":"Wait—you're not dodging?! You're ramming them?!","source_cn":"什么，不是甩开而是撞飞吗？！！！","status":"matched","hash_xxh64":"0x1DCC05B3735976B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:15:1061003008:0":{"text":"After a thunderous boom, Sinbad sets sail and rams the ship that fired on us—leaving a huge hole in its hull...","source_cn":"一声巨响后，辛巴达开船把炮轰我们的船撞了个大洞……","status":"matched","hash_xxh64":"0xC7CA14282905C900","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1061003009:0":{"text":"Relax! After that kraken incident, I had Hugin reinforce this beauty. She can take anything!","source_cn":"别怕，上次被海怪袭击后，我特意找呼金加固了船体，我们的...","status":"matched","hash_xxh64":"0x539922AF23C63FB0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1061003010:1":{"text":"Looks like they're boarding. I'll handle the bow. You two, keep the rest off my ship!","source_cn":"那艘船上的人跳上来了！趁现在，把碍事的人干掉吧，我盯着...","status":"matched","hash_xxh64":"0x8FE81AF30B0CBBEF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1061003011:1":{"text":"Natsu! Come on, wake up! We need you!","source_cn":"纳兹……纳兹！醒醒，要战斗了！","status":"matched","hash_xxh64":"0x4770ED3801895A8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1061003012:1":{"text":"...","source_cn":"…………","status":"matched","hash_xxh64":"0x70646B5D874C111A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1061003013:0":{"text":"Tch. The kid's down for the count—too seasick to even swing a punch.","source_cn":"啧，这小子已经晕船到不省人事了。","status":"matched","hash_xxh64":"0x35C5807890F12767","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1061003014:0":{"text":"Looks like it's up to you, <style=\"stress\"><player_name></style>.","source_cn":"那就拜托<style=stress><player_n...","status":"matched_runtime_gender","hash_xxh64":"0xA6B2E7E680C2F18D","variant_status":"runtime_gender_keys_target_same","male":"Looks like it's up to you, <style=\"stress\"><player_name></style>.","female":"Looks like it's up to you, <style=\"stress\"><player_name></style>.","variant_male_record_index":"103629","variant_female_record_index":"103630","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1061003015:0":{"text":"Listen up, you bilge rats! By Lord Borut's decree, these waters are closed to dragon hunters! Now hand over your loot, or else!","source_cn":"船上的听着！我们受伯特兰老爷的命令，封锁这片海域！任何...","status":"matched","hash_xxh64":"0x8C6A9EEBA4F1EF70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1061003016:0":{"text":"If you don't cough it up, we'll ram you into the seabed!","source_cn":"他奶奶的！不交钱！撞船这事没完！","status":"matched","hash_xxh64":"0x8357DB402D660FDE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1061003017:0":{"text":"Boys, strip the ship clean!","source_cn":"小的们，冲！看到什么拿什么！","status":"matched","hash_xxh64":"0xA76AA8C0D979CBF7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1061003018:0":{"text":"Aye, captain!","source_cn":"是！！！","status":"matched","hash_xxh64":"0x2A09702C3999EBD8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:32:1061003018":{"text":"Aye, captain!","source_cn":"是！！！","status":"matched","hash_xxh64":"0x2A09702C3999EBD8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1061003019:1":{"text":"B-Boss... they're monsters!","source_cn":"头儿……！碰到硬茬了！","status":"matched","hash_xxh64":"0x77C3EFB2ED597E7D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1061003020:0":{"text":"Hold it! One more step and the girl gets it!","source_cn":"住手！不然我就要她的命！","status":"matched","hash_xxh64":"0x767E6347E80511E9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1061003021:1":{"text":"...Lucy!","source_cn":"……露西！","status":"matched","hash_xxh64":"0x8BD8E35767A42874","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1061003022:0":{"text":"I, uh... tried sneaking around behind them. Bad idea.","source_cn":"那个，我想绕到后面偷袭，但失算了……","status":"matched","hash_xxh64":"0x21CD715FBA77D93D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1061003023:0":{"text":"Heh heh. One wrong move, and she's fish food. Now fork over the gold!","source_cn":"嘿嘿，不想让她受伤的话就把钱交出来！","status":"matched","hash_xxh64":"0x336E346BE3C90912","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1061003024:0":{"text":"<style=\"stress\"><player_name></style>, your friend's a mage, right? Why's she just standing there?","source_cn":"呼……<style=stress><player_na...","status":"matched_runtime_gender","hash_xxh64":"0x39FF372E9ECA6106","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, your friend's a mage, right? Why's she just standing there?","female":"<style=\"stress\"><player_name></style>, your friend's a mage, right? Why's she just standing there?","variant_male_record_index":"103642","variant_female_record_index":"103643","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1061003025:0":{"text":"I'm a Celestial Spirit Mage! But I only brought one key today and... my spirit's gone...","source_cn":"我是星灵魔导士！可我……我只带了一把星灵之钥……能召唤...","status":"matched","hash_xxh64":"0x35AA80A4523F1D41","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1061003026:0":{"text":"Don't move, little missy. This blade's itching for a taste!","source_cn":"喔哟，小姑娘不要乱动哦，我的刀可不长眼睛！","status":"matched","hash_xxh64":"0xD3210D20FBCBDFF5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:49:1061003027:0":{"text":"Fire...","source_cn":"火龙的……","status":"matched","hash_xxh64":"0x95741B0B7FAB5696","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1061003028:0":{"text":"W-when did you get up?!","source_cn":"啊，你是什么时候冒出来的！","status":"matched","hash_xxh64":"0x4E0C446F983E81FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:51:1061003029:1":{"text":"FIRE DRAGON'S RO—BLARGH!!","source_cn":"火龙的咆……呕！！","status":"matched","hash_xxh64":"0xB025A20EE726E94D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:52:1061003030:0":{"text":"Pfft. Pathetic seasick wimp. Stay down.","source_cn":"原来是个软脚虾，滚一边去！","status":"matched","hash_xxh64":"0xFABEA710016C5FEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:53:1061003031:0":{"text":"Ngh... Don't touch Lucy!","source_cn":"可恶……不许！不许伤害露西！","status":"matched","hash_xxh64":"0x2C8847B2CF0C4039","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:55:1061003032:1":{"text":"Don't hurt Natsu!","source_cn":"纳兹！不许你们动他！","status":"matched","hash_xxh64":"0xAB46B18DBB2915CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:56:1061003033:1":{"text":"Aquarius! If you can hear me, come forth!","source_cn":"阿葵亚！如果你在附近，请聆听我的呼唤，现身吧！！！","status":"matched","hash_xxh64":"0x8BEC3130B22FD782","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:59:1061003034:1":{"text":"The sky darkens, and the sea suddenly erupts in a massive whirlpool.","source_cn":"阴沉的天空下，海面卷起了骇人的风浪……！","status":"matched","hash_xxh64":"0x290B6F9E2F37DEC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:62:1061003035:1":{"text":"Wh-What the—?! It's the sea dragon! ABANDON SHIP!!!","source_cn":"风浪……这风浪不对！是海龙！海龙出来了！快跑！","status":"matched","hash_xxh64":"0x2C06EE5981C308A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:64:1061003036:0":{"text":"Aw, what's wrong? Thought you were hunting dragons, not running from a splash.","source_cn":"哟，你们不是来猎龙的吗？怎么海龙出来就要逃了？","status":"matched","hash_xxh64":"0x441245BDCDB34113","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:65:1061003037:0":{"text":"Better swim fast! That dragon must be hungry!","source_cn":"跑快点啊，海龙要追上你们喽！","status":"matched","hash_xxh64":"0xC135DAFDBADC2BA8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:67:1061003038:0":{"text":"The pirates abandon ship in complete panic as Sinbad taunts them...","source_cn":"在辛巴达的调侃下，海盗们像下饺子一样争先恐后跳入水中……","status":"matched","hash_xxh64":"0x3410AE88CED4DE37","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:69:1061003039:0":{"text":"Pathetic. Honestly, I'm embarrassed for them.","source_cn":"真是不禁吓啊……从这里游回锈锚港恐怕够呛，愿风浪与漂泊...","status":"matched","hash_xxh64":"0x400C8662FCFD3EB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:70:1061003039":{"text":"Pathetic. Honestly, I'm embarrassed for them.","source_cn":"真是不禁吓啊……从这里游回锈锚港恐怕够呛，愿风浪与漂泊之神保佑他们。","status":"matched","hash_xxh64":"0x400C8662FCFD3EB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:72:1061003040:0":{"text":"...Lucy?","source_cn":"……露西？","status":"matched","hash_xxh64":"0x92015C9EE7293C8A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:75:1061003041:1":{"text":"Aquarius! Thank goodness we found you!","source_cn":"阿葵亚！太好了，找到你了！","status":"matched","hash_xxh64":"0xE30692F3036936D0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:76:1061003042:1":{"text":"How many times do I have to say it? Don't interrupt my vacation!","source_cn":"说过多少次了，不要来打扰我的假期！","status":"matched","hash_xxh64":"0x9DA62AB8EF738AFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:77:1061003043:0":{"text":"Are you here to clear your head? No wonder the Celestial Spirit Gate you opened led here... but why couldn't I summon you?","source_cn":"你是来散心的吗？怪不得召唤你的星灵之门通向了这里……但...","status":"matched","hash_xxh64":"0x5ACE726BEFE47D38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:78:1061003044:0":{"text":"I guess you could say that. I got pulled here by some kind of strange magic, and the scenery turned out to be pretty nice, so I wasn't in a hurry to return to the Spirit World.","source_cn":"算是散心吧，我无意间被某种力量传送到这里，没想到这里风...","status":"matched","hash_xxh64":"0x3E48760C8276B261","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:79:1061003045:0":{"text":"I knew something was off! Even though Aquarius is strong, I still couldn't help but worry—so I came after you...","source_cn":"果然是出了意外！虽然阿葵亚很强，但我还是担心你，就跟着...","status":"matched","hash_xxh64":"0x57EDD62D247D80EB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:80:1061003046:0":{"text":"...Hmph. Still meddling where you shouldn't.","source_cn":"……哼，还是那么爱多管闲事。","status":"matched","hash_xxh64":"0x65D4E0BE054056A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:83:1061003047:0":{"text":"So you're the sea dragon those pirates were after? Huh. Gotta say, first time I've seen a mermaid scarier than an actual dragon.","source_cn":"所以海盗们在找的海龙就是你？哇，第一次见到比海龙还要强...","status":"matched","hash_xxh64":"0x623E848D40F7D927","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:84:1061003048:1":{"text":"...Scarier?","source_cn":"……强壮？","status":"matched","hash_xxh64":"0xBC399ED8DFB27ADA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:85:1061003049:0":{"text":"I meant... more powerful! Very majestic! Ten out of ten!","source_cn":"……是强大！","status":"matched","hash_xxh64":"0xBD5F8079B0D6B0C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:88:1061003050:0":{"text":"Aquarius, Natsu and I promised to go home together once we found you. Let's head back now!","source_cn":"阿葵亚，我和纳兹约好找到你就一起回家。现在我们可以一起...","status":"matched","hash_xxh64":"0x49346066831D7374","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:89:1061003051:0":{"text":"That brat came too? Where is he?","source_cn":"那小子也来了？他人呢？","status":"matched","hash_xxh64":"0x67D33F6DF2D5D512","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:90:1061003052:0":{"text":"Huh? He was right next to me—","source_cn":"纳兹……？刚刚还在这里的呀……","status":"matched","hash_xxh64":"0xF288D4EA29AC2EC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:91:1061003051":{"text":"That brat came too? Where is he?","source_cn":"那小子也来了？他人呢？","status":"matched","hash_xxh64":"0x67D33F6DF2D5D512","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:92:1061003053:1":{"text":"Natsu! I have to save him!","source_cn":"纳兹！我得去救他！","status":"matched","hash_xxh64":"0xC7D22C2E601B8883","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:95:1061003054:0":{"text":"Wait, can you even swim?","source_cn":"喂喂！你会游泳吗？","status":"matched","hash_xxh64":"0x8D50E0F50F1F9BCE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:96:1061003055:1":{"text":"No, but—glub glub!","source_cn":"不会，但是——咕噜噜！","status":"matched","hash_xxh64":"0x26D852231D3BDD89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:97:1061003056:0":{"text":"She actually jumped in?! That takes guts!","source_cn":"这妹子，不会也跳下海了，真勇敢啊！","status":"matched","hash_xxh64":"0x06BF5364DC8CAEA8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:98:1061003055":{"text":"No, but—glub glub!","source_cn":"不会，但是——咕噜噜！","status":"matched","hash_xxh64":"0x26D852231D3BDD89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:99:1061003057:0":{"text":"Right! <style=\"stress\"><player_name></style>, lower the anchor! I'll get them!","source_cn":"啊，说的对，<style=stress><player...","status":"matched_runtime_gender","hash_xxh64":"0x3D35FCB7C8883031","variant_status":"runtime_gender_keys_target_same","male":"Right! <style=\"stress\"><player_name></style>, lower the anchor! I'll get them!","female":"Right! <style=\"stress\"><player_name></style>, lower the anchor! I'll get them!","variant_male_record_index":"103679","variant_female_record_index":"103680","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:98:0:1":{"text":"We need to save them!","source_cn":"赶紧救人","status":"matched_runtime_gender","hash_xxh64":"0x42348996DAB51390","variant_status":"runtime_gender_keys_target_same","male":"We need to save them!","female":"We need to save them!","variant_male_record_index":"60034","variant_female_record_index":"60035","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:91:0:1":{"text":"He may be in the sea.","source_cn":"他或许在海里","status":"matched_runtime_gender","hash_xxh64":"0x205A92ECE597FEA1","variant_status":"runtime_gender_keys_target_same","male":"He may be in the sea.","female":"He may be in the sea.","variant_male_record