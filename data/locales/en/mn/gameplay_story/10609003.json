{"asset_key":"mn/gameplay_story_10609003","episode":"mn","category":"gameplay_story","story_id":"10609003","schema_version":1,"lang":"en","texts":{"say:1:1060900301:1":{"text":"I'm Bowa Ironhoof, one of the finest craftsmen among the Maulers clans!","source_cn":"哼哧，看就知道了，老子就是博瓦·铁蹄！蛮血部族最厉害的...","status":"matched","hash_xxh64":"0x1B5CF43B088F120F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1060900302:1":{"text":"I'm came here for ore. Everything you see here I made myself with this hammer.","source_cn":"老子来这里就是为了收集矿石，这里的所有装备都是老子一锤...","status":"matched","hash_xxh64":"0xA78DF894623ADBFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1060900303:1":{"text":"Grab what you need and get outta here! I've got iron to forge!","source_cn":"想要什么就随便拿吧，老子还想早点回去继续打铁！哼哧！","status":"matched","hash_xxh64":"0x8B1F66F74A4C68FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:博瓦·铁蹄":{"text":"Bowa Ironhoof","source":"博瓦·铁蹄","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}