{"asset_key":"mn/herohub_story_10415772","episode":"mn","category":"herohub_story","story_id":"10415772","schema_version":1,"lang":"en","texts":{"say:1:1041577201:0":{"text":"Mar, look at this guy!","source_cn":"马尔，看这家伙！","status":"matched","hash_xxh64":"0x432843433ECB719C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1041577202:0":{"text":"Aha! Kar, he's got two heads too!","source_cn":"嘿嘿，喀尔！他也有两个头！","status":"matched","hash_xxh64":"0xF8D05246B858F1B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1041577203:0":{"text":"Idiot, it's three heads!","source_cn":"蠢货，是三个头！","status":"matched","hash_xxh64":"0x2C9B1EDA85612ED5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041577204:0":{"text":"Not heads. Guns and Cannons.","source_cn":"不是头，枪炮。","status":"matched","hash_xxh64":"0x228508548D8979AF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041577205:1":{"text":"What's he saying?","source_cn":"他什么意思？","status":"matched","hash_xxh64":"0xB8C8B1ED6616FA93","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041577206:1":{"text":"Guns! Cannons! Obliterate!","source_cn":"枪炮！火力！轰碎！","status":"matched","hash_xxh64":"0xB8E884258A3944BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1041577207:1":{"text":"Alright! Calm down!","source_cn":"好了！冷静！","status":"matched","hash_xxh64":"0x1BAC4289D972A2D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1041577208:1":{"text":"I get it. You're Gunnar. And these two heads of yours are called Guns and Cannons.","source_cn":"明白了，你叫勒图姆，你这两个头，一个叫枪炮，一个叫火力。","status":"matched","hash_xxh64":"0x570D6E6A5DD22450","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1041577209:1":{"text":"But that won't do. Look at us—I'm Kar. He's Mar. Together we're Karma.","source_cn":"这可不行。就像我叫喀尔，他叫马尔。我们合起来叫喀尔马。","status":"matched","hash_xxh64":"0x5228E051ACAD0CE8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1041577210:1":{"text":"You need proper names like that!","source_cn":"你得给他俩起更像样的名字！","status":"matched","hash_xxh64":"0x101F16813B1D2AED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1041577211:1":{"text":"... Proper names?","source_cn":"……名字？","status":"matched","hash_xxh64":"0xD45E871BDCF265B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1041577212:1":{"text":"Yeah, names that make it obvious you all belong together!","source_cn":"一提起来就知道你们仨是一伙的，那种名字！","status":"matched","hash_xxh64":"0xAA26771ACF960691","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1041577213:1":{"text":"Guns need names...","source_cn":"枪炮，需要，名字。","status":"matched","hash_xxh64":"0xAC28BEDE5235121B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1041577214:1":{"text":"Exactly! Now go home and think long and hard about it!","source_cn":"对！你好好回去想想吧！","status":"matched","hash_xxh64":"0x4777E7069D09DA9F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1041577215:1":{"text":"And if you can't think of anything, come find us!","source_cn":"想不到就来找马尔和喀尔！","status":"matched","hash_xxh64":"0xD57745F05F47DC32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1041577216:1":{"text":"We'll give those two the best damn names you've ever heard!","source_cn":"马尔和喀尔绝对会给它俩起一对顶棒的名字！","status":"matched","hash_xxh64":"0x94CA9A3928E62189","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:喀尔":{"text":"Kar","source":"喀尔","status":"matched_dialogue_flow"},"speaker:马尔":{"text":"Mar","source":"马尔","status":"matched_dialogue_flow"},"speaker:勒图姆":{"text":"Gunnar","source":"勒图姆","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":17,"localized_text_count":16,"speaker_count":3}}