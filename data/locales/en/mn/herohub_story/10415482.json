{"asset_key":"mn/herohub_story_10415482","episode":"mn","category":"herohub_story","story_id":"10415482","schema_version":1,"lang":"en","texts":{"say:1:1041548201:1":{"text":"Ah, there you are!","source_cn":"嘿，小伙子！","status":"matched","hash_xxh64":"0x5D606C63EF9195E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1041548202:1":{"text":"Signal unknown. Engaging alert protocol.","source_cn":"陌生信号，警戒。","status":"matched","hash_xxh64":"0x6049C652944DE810","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1041548203:1":{"text":"Relax! I'm not here to cause trouble. I just want to take a closer look at you.","source_cn":"小伙子，别那么紧张。我只是想好好研究研究你。","status":"matched","hash_xxh64":"0x3DC0F1179F9C2D8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041548204:1":{"text":"Those mechanisms in your body are marvelous! Even your eyes are aligned with dwarven precision!","source_cn":"你身上的机巧十分精致！瞧瞧，齿轮、锁链……嚯嚯，就连你...","status":"matched","hash_xxh64":"0xE4138BE43FDFF878","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041548205:1":{"text":"Whoever built you had a touch of a true master. I'd bet my anvil it was one of my kin. Any chance you remember who made you?","source_cn":"制作你的人肯定是我的同胞，这准没错，你还记得制作你的人...","status":"matched","hash_xxh64":"0x7ACB38AB441CCCD8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041548206:1":{"text":"... This unit, Callan.","source_cn":"……本机体，铐兰。","status":"matched","hash_xxh64":"0x5495E698D7E2C7FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1041548207:1":{"text":"Oh, I know your name! No need to keep repeating it.","source_cn":"噢，我当然知道你的名字，小伙子。光重复这些没意义。","status":"matched","hash_xxh64":"0x7F9A83495EF3C0C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1041548208:1":{"text":"I'd love to take you apart for a quick peek inside. I'm confident I could create a similar mechanical golem!","source_cn":"真想再把你拆开研究研究，只要再仔细观察一次你的内部构造...","status":"matched","hash_xxh64":"0x5DF21EECBA537B15","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1041548209:1":{"text":"Recreate. Forbidden. Pain... Cannot continue.","source_cn":"再造，禁止。痛苦……不能延续。","status":"matched","hash_xxh64":"0x3C67FDA601EEFA67","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1041548210:1":{"text":"Stop!","source_cn":"——阻止！","status":"matched","hash_xxh64":"0x30267C133593F359","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1041548211:1":{"text":"Whoa, no need to get all wound up! I wasn't suggesting making another you!","source_cn":"嚯，嚯，别生气！我不是说要再造一个你……","status":"matched","hash_xxh64":"0x723172936A6A8013","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1041548212:1":{"text":"That sound from your system sounds troubling... I'll abandon my reverse-engineering plans, so please calm down!","source_cn":"机器的声音更不妙了——好吧，我放弃逆向计划，我放弃！平...","status":"matched","hash_xxh64":"0x0400FF90235A0498","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:呼金":{"text":"Hugin","source":"呼金","status":"matched_dialogue_flow"},"speaker:铐兰":{"text":"Callan","source":"铐兰","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":13,"localized_text_count":12,"speaker_count":2}}