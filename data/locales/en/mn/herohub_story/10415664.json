{"asset_key":"mn/herohub_story_10415664","episode":"mn","category":"herohub_story","story_id":"10415664","schema_version":1,"lang":"en","texts":{"say:2:1041566401:1":{"text":"The temperature here... is mild... Seeding could be done...","source_cn":"这里，温度，适中，准备播种……","status":"matched","hash_xxh64":"0x8BDD90255C489B99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1041566402:1":{"text":"Ha! Is that a tentacle?! A perfect snack delivered to my door!","source_cn":"这是触手吗？哈，送上门来的点心！","status":"matched","hash_xxh64":"0xAA52A1FB8A220985","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041566403:1":{"text":"*Chomp*Chomp*... Ugh! What is that?! Is that wood?!","source_cn":"嗷——咳，呸！什么东西，木头？！","status":"matched","hash_xxh64":"0xA7E7C318D157490A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041566404:1":{"text":"Roots and branches...","source_cn":"根和枝，被吞食……播种吧。","status":"matched","hash_xxh64":"0x17CC987D8AEE813D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041566405:1":{"text":"Do you want more...?","source_cn":"……被……消化了？","status":"matched","hash_xxh64":"0x7B3497F940CE13A5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1041566406:1":{"text":"Okay, stop it! I need flesh and blood!","source_cn":"别闹了！给我血和肉——！","status":"matched","hash_xxh64":"0x945A8F28B63AF5F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1041566407:1":{"text":"I only have seeds, branches, and leaves.","source_cn":"悉达只有，种子，枝，叶。","status":"matched","hash_xxh64":"0xB8C894B5DF044194","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1041566408:1":{"text":"Well, I ain't hungry enough to eat that crap.","source_cn":"没劲，伟大的哈拉克大人还没饿到想吃素的地步。","status":"matched","hash_xxh64":"0x5276D383433723FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1041566409:1":{"text":"Go away, you brainless weed! And stop spreading your spores around here!","source_cn":"滚吧，没脑子的植物，别往哈拉克大人这里再丢你那些小零嘴了！","status":"matched","hash_xxh64":"0x5894E6C98C92818E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1041566410:1":{"text":"I cannot infuse with this creature. Too strong.","source_cn":"……无法寄生。对象，食欲，过于旺盛。","status":"matched","hash_xxh64":"0x150171DC369FA68F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":