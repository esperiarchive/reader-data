{"asset_key":"mn/herohub_story_10415034","episode":"mn","category":"herohub_story","story_id":"10415034","schema_version":1,"lang":"en","texts":{"say:2:1041503401:1":{"text":"Ahahaha! Yarn balls! Rolling, rolling yarn balls!","source_cn":"啊哈哈哈哈！毛线球！滚来滚去的毛线球！","status":"matched","hash_xxh64":"0x369DE25489AC74A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1041503402:1":{"text":"Lenya, shush! And let go of my yarn!","source_cn":"蕾米雅，安静点！还有，放开我的毛线！","status":"matched","hash_xxh64":"0x5C2BD33D97EED5CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041503403:1":{"text":"Every time you play with my yarn, they end up all over the floor!","source_cn":"每次你都把毛线球拿出来，滚得满地都是！","status":"matched","hash_xxh64":"0xEBABDC0AD104D1A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041503404:1":{"text":"You aren't a child anymore. If you make a mess, you'd better clean it up yourself!","source_cn":"你已经不是小孩子了——弄乱了毛线，就自己给我缠回去！","status":"matched","hash_xxh64":"0xD53860E64888FC66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041503405:1":{"text":"How about you come here and have a bowl of the soup I just made?","source_cn":"或者过来，喝一碗婆婆刚炖好的汤！","status":"matched","hash_xxh64":"0xAF814886F62B0599","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1041503406:1":{"text":"Coming! I love soup! Is it chicken? Or fish? I love both!","source_cn":"来啦！我最喜欢喝汤了！是鸡？还是鱼？我都喜欢！","status":"matched","hash_xxh64":"0x5C41DCFEDCABDBB5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1041503407:1":{"text":"Meow... Ow! It's too hot! My tongue! My tongue!","source_cn":"喵嗷嗷嗷！好烫！舌头！我的舌头！","status":"matched","hash_xxh64":"0x28CF00BDC6673B17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:蕾米雅":{"text":"Lenya","source":"蕾米雅","status":"matched_dialogue_flow"},"speaker:达赫妮婆婆":{"text":"Granny Dahnie","source":"达赫妮婆婆","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":2}}