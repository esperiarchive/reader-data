{"asset_key":"mn/herohub_story_10415029","episode":"mn","category":"herohub_story","story_id":"10415029","schema_version":1,"lang":"en","texts":{"say:2:1041502901:1":{"text":"The raspberries taste heavenly, don't they, Soren?","source_cn":"索恩，树莓味道很不错吧？","status":"matched","hash_xxh64":"0xC3C487B04AF8C7E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1041502902:1":{"text":"They're so refreshing. Plus, there are no seeds, making them easy to eat too!","source_cn":"味道很清爽，又没有籽，吃起来很方便！","status":"matched","hash_xxh64":"0xEA99D10E8A929545","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041502903:1":{"text":"Ugh... So sour.","source_cn":"……嘶……好酸。","status":"matched","hash_xxh64":"0xD6877AFAD3C96821","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041502904:1":{"text":"Huh? Let me try some... They're not sour at all! You aren't a fan of sour food, right?","source_cn":"咦？我尝尝……不酸啊？\\n该不会索恩你很怕酸吧？","status":"matched","hash_xxh64":"0x7BC3BC7431DD4EDF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041502905:1":{"text":"Maybe...","source_cn":"有点。\\n……一点点。","status":"matched","hash_xxh64":"0xB7CC5E2FDFCD4388","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1041502906:1":{"text":"Hmm. Come, try this! A raspberry yogurt bowl with honey!","source_cn":"真没办法！\\n来！尝尝这个！加了蜂蜜和酸奶的特制树莓碗！","status":"matched","hash_xxh64":"0x5AA1157AF2DCA10C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1041502907:1":{"text":"... Just the honey will do.","source_cn":"……只要蜂蜜，就可以了。","status":"matched","hash_xxh64":"0x9253DDF712875AC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1041502908:1":{"text":"You really can't handle sour stuff, huh?","source_cn":"你也太怕酸了啊！","status":"matched","hash_xxh64":"0x288A84F2E0A2840E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1041502909:1":{"text":"Well, looks like we'll have to make them into raspberry jam...","source_cn":"没办法，只能做成树莓果酱了……","status":"matched","hash_xxh64":"0xBD0FF2991DFCDE22","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:阿尔萨":{"text":"Alsa","source":"阿尔萨","status":"matched_dialogue_flow"},"speaker:索恩":{"text":"Soren","source":"索恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":2}}