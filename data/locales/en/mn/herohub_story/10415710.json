{"asset_key":"mn/herohub_story_10415710","episode":"mn","category":"herohub_story","story_id":"10415710","schema_version":1,"lang":"en","texts":{"say:1:1041571001:1":{"text":"It's raining outside... So wet and humid...","source_cn":"外面，下雨了……好潮湿……","status":"matched","hash_xxh64":"0xE41898A3DC78F787","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1041571002:0":{"text":"Don't you like rainy days?","source_cn":"你不喜欢雨天吗？空气会很清新。","status":"matched","hash_xxh64":"0x3EE2368FD949776C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1041571003:1":{"text":"It's uncomfortable. Puts me in a bad mood.","source_cn":"下雨……不舒服。心情不好。","status":"matched","hash_xxh64":"0xCB062D3F9D71A683","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041571004:1":{"text":"My feathers will get wet... Then things may get dangerous.","source_cn":"如果雨很大，羽毛会被打湿……这很危险。","status":"matched","hash_xxh64":"0x2CD571166D7E504B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041571005:1":{"text":"You can always take shelter when it rains.","source_cn":"你可以躲起来，避雨。","status":"matched","hash_xxh64":"0x21CFB1875FABD6A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041571006:1":{"text":"I can't. The task my lady gave me is unfinished...","source_cn":"不，不行。主君给我的任务，还没有完成……","status":"matched","hash_xxh64":"0xEAD49B6AE8FF847C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1041571007:1":{"text":"Who is your lady?","source_cn":"主君？那是谁？","status":"matched","hash_xxh64":"0x8D6D4DBA2A22DDE1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1041571008:1":{"text":"My lady is... my lady. She saved me...","source_cn":"主君……就是主君。救了我的人。","status":"matched","hash_xxh64":"0xF46BAAF661E3FEBC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1041571009:1":{"text":"Is your lady a good person? Does she feed you well and take care of you?","source_cn":"你的主君是个好人吗？会给你食物，照顾你吗？","status":"matched","hash_xxh64":"0x04C45971A3641670","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1041571010:1":{"text":"Take care of me? No, my lady should not do such things.","source_cn":"照顾……我？主君不该做这种事。","status":"matched","hash_xxh64":"0x50F4498E3EEC98F7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1041571011:1":{"text":"I am her servant... No, I am unlike the servants.","source_cn":"我是主君的仆人……不，我和仆人不一样。","status":"matched","hash_xxh64":"0xF4F7EB49A784FD4E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1041571012:1":{"text":"I just need to complete my task...","source_cn":"我只要完成任务……不需要，照顾主君。","status":"matched","hash_xxh64":"0x9654A38C2A0C949B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1041571013:1":{"text":"What task did your lady give you?","source_cn":"你的主君给你什么任务？","status":"matched","hash_xxh64":"0xA51D126BCED3DEBA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1041571014:1":{"text":"Catch annoying, troublesome mice...","source_cn":"……抓老鼠。讨厌的、捣乱的老鼠。","status":"matched","hash_xxh64":"0xE038E6D3F07DC4BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1041571015:1":{"text":"I don't quite understand...","source_cn":"这里没有老鼠。我不太明白你要做什么。","status":"matched","hash_xxh64":"0xC150FC0C62FFF9C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1041571016:1":{"text":"... Come, sit here. Watch the rain alongside me.","source_cn":"但是，和我一起躲雨吧。","status":"matched","hash_xxh64":"0x1ACF67893E419504","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1041571017:1":{"text":"On rainy days like these, birds of a feather should flock together.","source_cn":"在雨天，所有鸟儿都有休息的权力。","status":"matched","hash_xxh64":"0x546DFCAA829B2977","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:翼":{"text":"Shadewing","source":"翼","status":"matched_dialogue_flow"},"speaker:五月":{"text":"Lily May","source":"五月","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":18,"localized_text_count":17,"speaker_count":2}}