{"asset_key":"mn/herohub_story_10415017","episode":"mn","category":"herohub_story","story_id":"10415017","schema_version":1,"lang":"en","texts":{"say:2:1041501701:1":{"text":"Add some red here... And add more red flowers right there on the ground!","source_cn":"这里加一点红色……这里的地面上，再加上很多红色的花！","status":"matched","hash_xxh64":"0x55185DA8DC05B5C6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1041501702:1":{"text":"Red flowers... Very good. It's a lovely painting.","source_cn":"红色的花……\\n不，没事，很漂亮，画得非常好。","status":"matched","hash_xxh64":"0xB44895ED0BF8F5DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:4:1041501702":{"text":"Red flowers... Very good. It's a lovely painting.","source_cn":"红色的花……\\n不，没事，很漂亮，画得非常好。","status":"matched","hash_xxh64":"0xB44895ED0BF8F5DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041501703:1":{"text":"Lumont is painting!","source_cn":"噜噜在画画！","status":"matched","hash_xxh64":"0x4B3EF2773B01E3E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041501704:1":{"text":"He draws mostly battlefields, but he can see beauty that no one else does.","source_cn":"他画的基本都是战场上的情景。但他有一双明亮的眼睛，能看...","status":"matched","hash_xxh64":"0xF00D9107E3EC9DF1","variant_status":"","male":"","female":"","variant_male_re