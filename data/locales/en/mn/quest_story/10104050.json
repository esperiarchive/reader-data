{"asset_key":"mn/quest_story_10104050","episode":"mn","category":"quest_story","story_id":"10104050","schema_version":1,"lang":"en","texts":{"say:2:1010405001:0":{"text":"...In any case, my lady is tending to important business. You may take your leave now, Lord Franz.","source_cn":"……总之，夫人有事外出了，弗朗茨先生，请回吧。","status":"matched","hash_xxh64":"0xC01F3A83F26540A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1010405002:0":{"text":"Wait! Wait! Tell me what you want. I'll give you anything. Just let me see <style=\"highlight\">Lady Vala</style>!","source_cn":"等等！你想要什么？我都可以给你！让我见见维拉夫人！","status":"matched","hash_xxh64":"0x340920EFD4B56113","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1010405003:0":{"text":"Please excuse me. I have to leave to attend some other matters.","source_cn":"抱歉，我还有事，先告退了。","status":"matched","hash_xxh64":"0x571C2BAEA85ADB04","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1010405004:0":{"text":"Hmph! Damn that woman...","source_cn":"啧，可恶的女人……","status":"matched_runtime_gender","hash_xxh64":"0xF7A9D0F56A7825F8","variant_status":"runtime_gender_keys_target_same","male":"Hmph! Damn that woman...","female":"Hmph! Damn that woman...","variant_male_record_index":"99263","variant_female_record_index":"99264","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1010405005:0":{"text":"There are some things money can't buy.","source_cn":"这世界上有不少东西，无法用金钱购买。","status":"matched","hash_xxh64":"0xB270148886087817","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1010405006:0":{"text":"It seems you're still having trouble understanding that, Lord Franz.","source_cn":"看来，尊贵的弗朗茨先生并不懂得这个道理。","status":"matched","hash_xxh64":"0x3C25034C7F6403C1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1010405007:0":{"text":"You lot again? Such an unseemly group of people... Like diseased rats spreading their plague everywhere they go!","source_cn":"又是你们……看看这一张张令人心烦的面孔。像是沾染了疫病...","status":"matched","hash_xxh64":"0x7B918D25BC2EB159","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1010405008:0":{"text":"It seems like you're the one being treated like a pest. She wouldn't even see you.","source_cn":"在那位夫人眼里，弗朗茨先生您怕是连老鼠都不如。","status":"matched","hash_xxh64":"0x94F87FDBF14B3DFD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1010405009:0":{"text":"Silence, you vermin! Guards!","source_cn":"住口！你们这群该死的老鼠！！来人啊！！！","status":"matched","hash_xxh64":"0xC8CAF6C115463DE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1010405010:0":{"text":"Scum like you have no business roaming around these civilized streets! My men will teach you not to leave whatever hole you came from!","source_cn":"去！给我教教他们！老鼠就该乖乖活在下水道，不要在大街上...","status":"matched","hash_xxh64":"0x7F7696FAEEF564AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:女仆":{"text":"Maid","source":"女仆","status":"matched_dialogue_flow"},"speaker:弗朗茨":{"text":"Franz","source":"弗朗茨","status":"matched_dialogue_flow"},"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":3}}