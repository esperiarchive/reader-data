{"asset_key":"mn/quest_story_10106030","episode":"mn","category":"quest_story","story_id":"10106030","schema_version":1,"lang":"en","texts":{"say:0:1010603001:0":{"text":"So many mercenaries patrolling... Did Lord Franz hire them?","source_cn":"有好多佣兵在巡逻……他们是弗朗茨的手下？","status":"matched","hash_xxh64":"0x89152B9F27046CE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1010603002:0":{"text":"Unfortunately, even my ears can't hear that far.","source_cn":"可惜隔着这么远的距离，连我的耳朵也不灵啦。","status":"matched","hash_xxh64":"0xD35CE96476A6B358","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1010603003:0":{"text":"Even after all this time I never saw Franz go to the Heights.","source_cn":"我盯着弗朗茨很久了，没见过他去过那片高地。","status":"matched","hash_xxh64":"0xD0B5FA385134F301","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1010603004:0":{"text":"A secret passage? Typical of the rich. Let's look around.","source_cn":"有钱人的老把戏——密道，我们在附近搜索看看吧。","status":"matched","hash_xxh64":"0xE7E9B82FAADAFCB9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"},"speaker:米瑞尔":{"text":"Mirael","source":"米瑞尔","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_d