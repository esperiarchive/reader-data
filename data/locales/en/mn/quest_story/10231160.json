{"asset_key":"mn/quest_story_10231160","episode":"mn","category":"quest_story","story_id":"10231160","schema_version":1,"lang":"en","texts":{"say:2:1023116001:1":{"text":"It's you! Where is Jumeo? Is he here?","source_cn":"是你们！朱密欧呢？他也来了吗？","status":"matched","hash_xxh64":"0x24795C848E7EA4CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1023116002:1":{"text":"I'm sorry. He could not make it here with all his injuries.","source_cn":"抱歉，他可能来不了——他受伤了。","status":"matched","hash_xxh64":"0x15CF70956E8ACF12","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1023116003:1":{"text":"What?! Injuries?! Is he alright? It's not serious, is it?","source_cn":"什么？受伤了？！他还好吗？没有大碍吧？","status":"matched","hash_xxh64":"0x03D6975BD879506D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1023116004:1":{"text":"That poor young man got driven off by your father, and then some gruglins dragged him to their lair...!","source_cn":"那位可怜的先生，被你父亲拒绝后，又被咕布林拖进了巢穴……","status":"matched","hash_xxh64":"0x1DE590F523BE174D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1023116005:1":{"text":"What?!","source_cn":"什么？！","status":"matched","hash_xxh64":"0xC31E78CBE8737231","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1023116006:1":{"text":"Bunny-ears here is exaggerating a bit. He's fine now.\nWe plan to take you out of here so you two can be together.","source_cn":"兔耳朵有点夸大其词，他现在已经脱离危险了。\\n我们正在...","status":"matched","hash_xxh64":"0xA271EBC6AD3E8F66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1023116007:1":{"text":"Oh, my poor Jumeo...","source_cn":"哦，我可怜的朱密欧……","status":"matched","hash_xxh64":"0xC62469E98E14E07F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1023116008:1":{"text":"Miss Roliet, please take a few steps back. My sword here is going to grant you your freedom...","source_cn":"那么，罗丽叶小姐，请你后退几步，我手中的剑很快就会还你...","status":"matched","hash_xxh64":"0x25A33348FB6109D5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1023116009:1":{"text":"Wait!","source_cn":"——请等一下！","status":"matched","hash_xxh64":"0x7A276CD1B445E11F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1023116010:1":{"text":"What happened?!","source_cn":"怎么了？","status":"matched","hash_xxh64":"0x017E66B46D51B81B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_ti