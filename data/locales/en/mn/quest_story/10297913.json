{"asset_key":"mn/quest_story_10297913","episode":"mn","category":"quest_story","story_id":"10297913","schema_version":1,"lang":"en","texts":{"say:3:1029791301:1":{"text":"So many people here... Florabelle, stay close. Don't get lost.","source_cn":"这里的人可真多啊……芙拉贝尔，跟好我，别走丢了。","status":"matched","hash_xxh64":"0xE2AD1C842BDB9E6C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1029791302:1":{"text":"Heh, are you mistaking me for one of my students?","source_cn":"放心吧，我又不是班上的那些小孩子。","status":"matched","hash_xxh64":"0xCD59829931E85525","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1029791303:1":{"text":"If we're talking raw strength, I could probably take you down, Lyca.","source_cn":"光是比力气，莱卡可不一定能赢得过我哦？","status":"matched","hash_xxh64":"0xF98602510209C26F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1029791304:1":{"text":"No need to prove that!","source_cn":"那不用比了，我甘拜下风。","status":"matched","hash_xxh64":"0xDDE826E994A53870","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1029791305:1":{"text":"Who could possibly beat someone who wrangles three wild kids with one hand?","source_cn":"谁能和你这种单手就制服三个乱跑的小孩子的家伙比啊。","status":"matched","hash_xxh64":"0xC61713CD19BA1D35","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1029791306:1":{"text":"Haha, I'll take that as a compliment.","source_cn":"呵呵呵，我就当你是在羡慕我好了。","status":"matched","hash_xxh64":"0xF2D11CEAB7C76BAA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1029791307:1":{"text":"Since we've got a little break, how about we look for souvenirs to bring back?","source_cn":"说起来，难得的假期，我们好好逛逛，多买些特产带回去当礼物吧？","status":"matched","hash_xxh64":"0x80D4EBB1F1080065","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1029791308:1":{"text":"I already made a list!","source_cn":"嗯，我已经列好清单了！","status":"matched","hash_xxh64":"0x1C8229D88410BEC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:芙拉贝尔":{"text":"Florabelle","source":"芙拉贝尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":2}}