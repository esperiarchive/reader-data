{"asset_key":"mn/quest_story_10102020","episode":"mn","category":"quest_story","story_id":"10102020","schema_version":1,"lang":"en","texts":{"say:2:1010202001:0":{"text":"No... These baskets of Gemvine are the wrong weight!","source_cn":"不对……这几筐藤水晶的重量不对！","status":"matched","hash_xxh64":"0x27524B29E3293F9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1010202002:0":{"text":"I told you Lord Franz is personally coming to inspect the village. I won't be able to protect you if he finds that people are secretly eating or hiding the produce!","source_cn":"我告诉你们，弗朗茨老爷正亲自在村里视察。要是被他发现有...","status":"matched","hash_xxh64":"0xA7E0E2DE01E51BCA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1010202003:0":{"text":"What...? Lord Franz is coming himself?","source_cn":"什么……弗朗茨老爷竟然亲自来了？","status":"matched","hash_xxh64":"0x3EA819A050AE0479","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1010202003":{"text":"What...? Lord Franz is coming himself?","source_cn":"什么……弗朗茨老爷竟然亲自来了？","status":"matched","hash_xxh64":"0x3EA819A050AE0479","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1010202004:0":{"text":"Who are you...? Don't go asking what shouldn't be asked!","source_cn":"你是谁……外乡人，不该问的不要问！","status":"matched","hash_xxh64":"0x2699A1A5FDB2E268","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1010202006:0":{"text":"Wait a minute... You're not Lord Franz's spy, are you?","source_cn":"等等……你不会是弗朗茨老爷的眼线吧？！","status":"matched_runtime_gender","hash_xxh64":"0x729141BE28F4D801","variant_status":"runtime_gender_keys_target_same","male":"Wait a minute... You're not Lord Franz's spy, are you?","female":"Wait a minute... You're not Lord Franz's spy, are you?","variant_male_record_index":"98047","variant_female_record_index":"98048","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1010202006":{"text":"Wait a minute... You're not Lord Franz's spy, are you?","source_cn":"等等……你不会是弗朗茨先生的眼线吧？！","status":"matched_runtime_gender","hash_xxh64":"0x729141BE28F4D801","variant_status":"runtime_gender_keys_target_same","male":"Wait a minute... You're not Lord Franz's spy, are you?","female":"Wait a minute... You're not Lord Franz's spy, are you?","variant_male_record_index":"98047","variant_female_record_index":"98048","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1010202007:0":{"text":"Yeah, Lord Franz's spies wouldn't just be wandering around the village doing nothing.","source_cn":"哼，我就说，弗朗茨老爷的眼线才不会在村里到处闲逛。","status":"matched","hash_xxh64":"0x76D7352D8E228CE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"I'm not.","source_cn":"我不是","status":"matched_runtime_gender","hash_xxh64":"0x4832ECD01734A2ED","variant_status":"runtime_gender_keys_target_same","male":"I'm n