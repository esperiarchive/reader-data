{"asset_key":"mn/quest_story_11211420","episode":"mn","category":"quest_story","story_id":"11211420","schema_version":1,"lang":"en","texts":{"say:1:1121142001:1":{"text":"General Hogan, we're here!","source_cn":"霍根将军，我们来赴约啦！","status":"matched_runtime_gender","hash_xxh64":"0x2A13E827C8A08433","variant_status":"runtime_gender_keys_target_same","male":"General Hogan, we're here!","female":"General Hogan, we're here!","variant_male_record_index":"101053","variant_female_record_index":"101054","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1121142002:1":{"text":"Welcome! I've had Joseline prepare everything. I finally have the chance to treat you guys to a proper meal.","source_cn":"欢迎！我已经让乔思琳准备好了，终于有一次，能请你们坐在...","status":"matched","hash_xxh64":"0x26803FE23CED87E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1121142003:0":{"text":"Before this, emergencies arose every single time I invited you for dinner. It's almost like a curse.","source_cn":"之前每次说要吃饭，你们都被突发事件拉走，简直像是诅咒一样。","status":"matched","hash_xxh64":"0x62C1BEC80948A672","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1121142004:1":{"text":"The general's finally treating us! I've been waiting for this for so long...","source_cn":"终于可以让将军请客了！我等这天已经好久——咳，希望这顿...","status":"matched","hash_xxh64":"0xBB13E0B4A3D661D1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1121142004":{"text":"The general's finally treating us! I've been waiting for this for so long...","source_cn":"终于可以让将军请客了！我等这天已经好久——咳，希望这顿饭没让你们久等，不然骑士团就太过意不去了。","status":"matched","hash_xxh64":"0xBB13E0B4A3D661D1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1121142005:3":{"text":"Eh? She isn't here yet.","source_cn":"嗯？她还没来。","status":"matched","hash_xxh64":"0x6878EFF37D29B81E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1121142006:1":{"text":"Let's wait a little longer. We shouldn't disrespect the Celestial.","source_cn":"再等等，不能怠慢了半神殿下。","status":"matched","hash_xxh64":"0x73C6194D9E55BC56","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:1121142007:1":{"text":"Moments later...","source_cn":"","status":"matched","hash_xxh64":"0x84C4429B007DA7E5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1121142008:1":{"text":"How have you all been?","source_cn":"诸位近来安好？","status":"matched","hash_xxh64":"0x9A16292E5D5EE1A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1121142009:0":{"text":"It's been a while. There's something I want to discuss with you all...","source_cn":"久未传讯，在下布莱恩。有一事相商……","status":"matched","hash_xxh64":"0xCAA7D5F361E5BB1F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1121142010:1":{"text":"Magister, Chippy just heard Bryon's voice. There must be something wrong with Chippy's ears...","source_cn":"主人，满满的听力好像出问题了，我刚才好像听到了布莱恩的...","status":"matched_runtime_gender","hash_xxh64":"0xB061AE09D5E94690","variant_status":"runtime_gender_keys_target_same","male":"Magister, Chippy just heard Bryon's voice. There must be something wrong with Chippy's ears...","female":"Magister, Chippy just heard Bryon's voice. There must be something wrong with Chippy's ears...","variant_male_record_index":"101063","variant_female_record_index":"101064","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:19:1121142010":{"text":"Magister, Chippy just heard Bryon's voice. There must be something wrong with Chippy's ears...","source_cn":"主人，满满的听力好像出问题了，我刚才好像听到了布莱恩的声音……","status":"matched_runtime_gender","hash_xxh64":"0xB061AE09D5E94690","variant_status":"runtime_gender_keys_target_same","male":"Magister, Chippy just heard Bryon's voice. There must be something wrong with Chippy's ears...","female":"Magister, Chippy just heard Bryon's voice. There must be something wrong with Chippy's ears...","variant_male_record_index":"101063","variant_female_record_index":"101064","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1121142011:1":{"text":"I heard it too!","source_cn":"我也听到了！","status":"matched","hash_xxh64":"0x3277AAAF4FDF4A5D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1121142012:1":{"text":"Could it be a wind message that Lorsan and the others were talking about? It felt like Bryon was whispering in my ear!","source_cn":"难道这是洛桑他们之前说的风讯吗？好厉害！就像直接在耳边...","status":"matched","hash_xxh64":"0x51577C2001CC5C37","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1121142013:1":{"text":"If you all have some time to spare, please come to <style=\"highlight\">Ivoryshade</style>. The Deer Spirit has manifested again.","source_cn":"鹿灵显灵。若诸位闲暇，请来<style=highlig...","status":"matched","hash_xxh64":"0x54147F562411C8B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1121142014:0":{"text":"Best, Lyca and Bryon.","source_cn":"发信人，莱卡。代发人，布莱恩。又及，以上内容已做简化。","status":"matched","hash_xxh64":"0xE6F261C166BCE242","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1121142015:1":{"text":"Um, that's really concise...","source_cn":"呃，真是言简意赅……","status":"matched_runtime_gender","hash_xxh64":"0xD2A96F4E424245C3","variant_status":"runtime_gender_keys_target_same","male":"Um, that's really concise...","female":"Um, that's really concise...","variant_male_record_index":"101069","variant_female_record_index":"101070","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:26:1121142015":{"text":"Um, that's really concise...","source_cn":"呃，真是言简意赅……","status":"matched_runtime_gender","hash_xxh64":"0xD2A96F4E424245C3","variant_status":"runtime_gender_keys_target_same","male":"Um, that's really concise...","female":"Um, that's really concise...","variant_male_record_index":"101069","variant_female_record_index":"101070","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1121142016:1":{"text":"By the way, when the Sun Temple acolytes first saw the two Dura Statues, they also thought it was a manifestation of Dura!","source_cn":"对哦，之前日神殿的圣堂修士刚看到两座女神像时，也以为是...","status":"matched_runtime_gender","hash_xxh64":"0x47A43A5AE1D9362E","variant_status":"runtime_gender_keys_target_same","male":"By the way, when the Sun Temple acolytes first saw the two Dura Statues, they also thought it was a manifestation of Dura!","female":"By the way, when the Sun Temple acolytes first saw the two Dura Statues, they also thought it was a manifestation of Dura!","variant_male_record_index":"101071","variant_female_record_index":"101072","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1121142017:0":{"text":"Hmm, sounds worrying... I think we should swing by and check things out. If a Hypogean is involved again, we can't take it lightly.","source_cn":"哼，真可疑……感觉有必要去看看，如果又是恶魔作祟的话，...","status":"matched","hash_xxh64":"0xD2E16197DE6E32EE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1121142018:0":{"text":"There you are...","source_cn":"原来你在这里……","status":"matched","hash_xxh64":"0x11DD284699FE009F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1121142019:1":{"text":"You're just in time, Talene! We're heading to Ivoryshade to check out a similar issue.","source_cn":"来得正好，塔琳小姐！我们准备去月影乡看看另一个“神明显...","status":"matched","hash_xxh64":"0x5146D83C4855D6B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1121142020:1":{"text":"Another \"manifestation\"...?","source_cn":"另一个“神明显灵”……？","status":"matched","hash_xxh64":"0xB2116D0AE80E3B63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1121142021:1":{"text":"Alas, I suppose we have to call off the dinner again. I was right to say it was a curse.","source_cn":"唉，这顿饭又吃不成了。我就说，这一定是某种诅咒。","status":"matched","hash_xxh64":"0xAC15C35BC7212B06","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1121142022:1":{"text":"Go ahead, my friend. The Wilders need you. We can always reschedule.","source_cn":"去吧，朋友。绿裔联盟的朋友需要你。虽然可惜，但我们永远...","status":"matched_runtime_gender","hash_xxh64":"0x166A35FD249A5070","variant_status":"runtime_gender_keys_target_same","male":"Go ahead, my friend. The Wilders need you. We can always reschedule.","female":"Go ahead, my friend. The Wilders need you. We can always reschedule.","variant_male_record_index":"101078","variant_female_record_index":"101079","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1121142023:1":{"text":"Well, let's go then! We'll find out what's the deal with the Deer Spirit in Ivoryshade!","source_cn":"那，我们出发吧！去月影乡看看鹿灵显灵到底是怎么回事！","status":"matched_runtime_gender","hash_xxh64":"0x3FF0945CE148DEE4","variant_status":"runtime_gender_keys_target_same","male":"Well, let's go then! We'll find out what's the deal with the Deer Spirit in Ivoryshade!","female":"Well, let's go then! We'll find out what's the deal with the Deer Spirit in Ivoryshade!","variant_male_record_index":"101080","variant_female_record_index":"101081","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:0:1":{"text":"The Deer Spirit?!","source_cn":"这次又轮到鹿灵显灵了？","status":"matched_runtime_gender","hash_xxh64":"0xD374020116FE77EB","variant_status":"runtime_gender_keys_target_same","male":"The Deer Spirit?!","female":"The Deer Spirit?!","variant_male_record_index":"59544","variant_female_record_index":"59545","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:1:2":{"text":"I wonder why...","source_cn":"感觉是之前事件的后续","status":"matched_runtime_gender","hash_xxh64":"0xCC00D147FB246983","variant_status":"runtime_gender_keys_target_same","male":"I wonder why...","female":"I wonder why...","variant_male_record_index":"59546","variant_female_record_index":"59547","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:26:2:3":{"text":"I have a bad feeling about this.","source_cn":"我猜事情不会那么简单！","status":"matched_runtime_gender","hash_xxh64":"0x131BCCBB5406C33D","variant_status":"runtime_gender_keys_target_same","male":"I have a bad feeling about this.","female":"I have a bad feeling about this.","variant_male_record_index":"59548","variant_female_record_index":"59549","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:0:1":{"text":"I heard it too.","source_cn":"不是幻觉，我也听到了","status":"matched_runtime_gender","hash_xxh64":"0x222B5BCDF558F00E","variant_status":"runtime_gender_keys_target_same","male":"I heard it too.","female":"I heard it too.","variant_male_record_index":"59538","variant_female_record_index":"59539","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:1:2":{"text":"But he's nowhere in sight.","source_cn":"但是没看到布莱恩的人？","status":"matched_runtime_gender","hash_xxh64":"0x056EC949CFC36058","variant_status":"runtime_gender_keys_target_same","male":"But he's nowhere in sight.","female":"But he's nowhere in sight.","variant_male_record_index":"59540","variant_female_record_index":"59541","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:19:2:3":{"text":"When did he come to Holistone?","source_cn":"他什么时候来圣石镇了？","status":"matched_runtime_gender","hash_xxh64":"0x1FC2FCD025F348B6","variant_status":"runtime_gender_keys_target_same","male":"When did he come to Holistone?","female":"When did he come to Holistone?","variant_male_record_index":"59542","variant_female_record_index":"59543","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"Where's Talene?","source_cn":"塔琳呢？","status":"matched_runtime_gender","hash_xxh64":"0xEF0A7D4045BF6716","variant_status":"runtime_gender_keys_target_same","male":"Where's Talene?","female":"Where's Talene?","variant_male_record_index":"59534","variant_female_record_index":"59535","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"Where's our wonderful Celestial?","source_cn":"我们的半神殿下呢？","status":"matched_runtime_gender","hash_xxh64":"0x2F6800BB0BEBD2ED","variant_status":"runtime_gender_keys_target_same","male":"Where's our wonderful Celestial?","female":"Where's our wonderful Celestial?","variant_male_record_index":"59536","variant_female_record_index":"59537","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:霍根":{"text":"Hogan","source":"霍根","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"},"speaker:布莱恩":{"text":"Bryon","source":"布莱恩","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:塔琳":{"text":"Talene","source":"塔琳","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":35,"localized_text_count":34,"speaker_count":6}}