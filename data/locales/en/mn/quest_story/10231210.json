{"asset_key":"mn/quest_story_10231210","episode":"mn","category":"quest_story","story_id":"10231210","schema_version":1,"lang":"en","texts":{"say:5:1023121001:0":{"text":"Roliet! I thought I would never see you again... I've been waiting here all this time!","source_cn":"罗丽叶！我以为我再也见不到你了……我一直这里在等你！","status":"matched","hash_xxh64":"0x511DBE1E369E1292","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1023121002:0":{"text":"Jumeo, I missed you! I heard that you're hurt, are you alright? Let me see.","source_cn":"朱密欧，我也一直在思念你！听说你受伤了，伤的重吗？让我看看。","status":"matched","hash_xxh64":"0x4B6541376F568B17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1023121003:0":{"text":"You know, I'd walk a thousand miles if I could just see you.","source_cn":"能够见到你，再重的伤又算得上什么呢？","status":"matched","hash_xxh64":"0x352B335D10FD7275","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1023121004:0":{"text":"Jumeo, nothing will ever separate us from now on!","source_cn":"朱密欧，从今往后，再也没有什么能把我们分开了！","status":"matched","hash_xxh64":"0x1E9C7C1F7380C285","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1023121005:0":{"text":"Yes, nothing!","source_cn":"是的，再也没有。","status":"matched","hash_xxh64":"0x7B3A921B345631A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:11:1023153:0":{"text":"With your guidance, Jumeo and Roliet finally reunite.","source_cn":"在你们的引路下，罗丽叶与朱密欧终于重逢。","status":"matched","hash_xxh64":"0xBB033817DE717D63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:朱密欧":{"text":"Jumeo","source":"朱密欧","status":"matched_dialogue_flow"},"speaker:罗丽叶":{"text":"Roliet","source":"罗丽叶","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":6,"speaker_count":2}}