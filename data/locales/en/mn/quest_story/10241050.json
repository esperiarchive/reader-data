{"asset_key":"mn/quest_story_10241050","episode":"mn","category":"quest_story","story_id":"10241050","schema_version":1,"lang":"en","texts":{"say:3:1024105001:0":{"text":"Young man, have you seen the duck on the notice board?","source_cn":"小哥，你有见过告示板上那只黑鸭吗？","status":"matched","hash_xxh64":"0xC13C3FB39C5D34F1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1024105002:0":{"text":"Bradduck is not—","source_cn":"布拉达克不是——","status":"matched","hash_xxh64":"0x0D4DC4DE53F44D15","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1024105003:0":{"text":"Shh... Rowan. Let me do the talking.","source_cn":"嘘，小少爷，问话就交给我吧。","status":"matched","hash_xxh64":"0x97894AC8B07975CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1024105004:0":{"text":"So you are looking for that duck!","source_cn":"原来是你们在找那只鸭子！","status":"matched","hash_xxh64":"0xC28664BDC9088488","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1024105005:0":{"text":"That duck has been hanging around my barn! When I first saw it, it was quacking and mocking me!","source_cn":"就是它，几天前在我家的谷仓乱转！看到它的时候，它竟然还...","status":"matched","hash_xxh64":"0x5998B3C2E49767B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1024105006:0":{"text":"A duck mocking ME! Ducks around here wouldn't be eating happy if it weren't for the grain that I grow!","source_cn":"一只鸭子——嘲笑我？！它们吃的谷物还是我种出来的呢！！","status":"matched","hash_xxh64":"0x9B2BDB55B89F4C26","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1024105007:0":{"text":"Umm... thanks for your information. Here's some compensation for the emotional damage!","source_cn":"呃，谢谢您提供情报，这是给您的精神损失补偿！","status":"matched","hash_xxh64":"0x585B3C0552C5F287","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"},"speaker:罗万":{"text":"Rowan","source":"罗万","status":"matched_dialogue_flow"},"speaker:种谷子的农民":{"text":"Farmer","source":"种谷子的农民","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":3}}