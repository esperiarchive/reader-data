{"asset_key":"mn/quest_story_10251130","episode":"mn","category":"quest_story","story_id":"10251130","schema_version":1,"lang":"en","texts":{"say:2:1025113001:0":{"text":"Is there a problem?","source_cn":"怎么样，有问题吗？","status":"matched_runtime_gender","hash_xxh64":"0x7D829BAD86E8F6AA","variant_status":"runtime_gender_keys_target_same","male":"Is there a problem?","female":"Is there a problem?","variant_male_record_index":"98255","variant_female_record_index":"98256","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1025113001":{"text":"Is there a problem?","source_cn":"怎么样，有问题吗？","status":"matched_runtime_gender","hash_xxh64":"0x7D829BAD86E8F6AA","variant_status":"runtime_gender_keys_target_same","male":"Is there a problem?","female":"Is there a problem?","variant_male_record_index":"98255","variant_female_record_index":"98256","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1025113002:0":{"text":"The circle is fine. Each step was followed, but the results... Maybe I need to consider how I guide the magic during the process...","source_cn":"法阵没有问题，步骤没有问题，但结果出了问题。嗯，得考虑...","status":"matched","hash_xxh64":"0xF4577BB88DD183D4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1025113003:0":{"text":"According to the 12th Principle of the Code for Magical Experimentation, I should adjust the magical energy, control the variants, and establish a comparison.","source_cn":"根据《魔法实验守则》第十二条，我应该调整魔法能量，控制...","status":"matched","hash_xxh64":"0x282576FD763DEDF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1025113004:0":{"text":"Hey, wait...","source_cn":"哎，等等……","status":"matched","hash_xxh64":"0xC259974B75679F1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1025113005:0":{"text":"When I try to activate the magic circle this time, I will increase my magical energy by 10%.\nIf it doesn't work, I'll increase it by another 10%...","source_cn":"这次激活法阵，我先增加10%的魔法力量。\\n如果还不行...","status":"matched","hash_xxh64":"0xC9E9D3A7AF036C51","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1025113006:0":{"text":"Hey, you're the great Merlin. Aren't you going to stop her before she takes it too far?","source_cn":"我说，大魔法师梅林，你不拦着你的崇拜者吗？","status":"matched_runtime_gender","hash_xxh64":"0xA4EE57F20D2E0710","variant_status":"runtime_gender_keys_target_same","male":"Hey, you're the great Merlin. Aren't you going to stop her before she takes it too far?","female":"Hey, you're the great Merlin. Aren't you going to stop her before she takes it too far?","variant_male_record_index":"98261","variant_female_record_index":"98262","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1025113006":{"text":"Hey, you're the great Merlin. Aren't you going to stop her before she takes it too far?","source_cn":"我说，大魔法师梅林，你不拦着你的崇拜者吗？","status":"matched_runtime_gender","hash_xxh64":"0xA4EE57F20D2E0710","variant_status":"runtime_gender_keys_target_same","male":"Hey, you're the great Merlin. Aren't you going to stop her before she takes it too far?","female":"Hey, you're the great Merlin. Aren't you going to stop her before she takes it too far?","variant_male_record_index":"98261","variant_female_record_index":"98262","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1025113007:0":{"text":"Increase my magic energy, draw, guide, and now steady. I'm seeing improvements... Hmm?","source_cn":"增加能量，汲取、引导、固化，这次好像有进展……咦？","status":"matched","hash_xxh64":"0x6ADCCDC28B0F49AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1025113007":{"text":"Increase my magic energy, draw, guide, and now steady. I'm seeing improvements... Hmm?","source_cn":"增加能量，汲取、引导、固化，这次好像有进展……咦？","status":"matched","hash_xxh64":"0x6ADCCDC28B0F49AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1025113008:0":{"text":"Oh no, it's gonna explode—","source_cn":"不好，要爆炸——","status":"matched","hash_xxh64":"0xE4F303782C486E2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:1025113009:0":{"text":"The magic energy was disturbed. The circle went out of control. Wild streams of magic rushed through everyone.","source_cn":"魔能紊乱，魔法阵陡然失控，狂乱的能量流从众人身边冲击而过。","status":"matched","hash_xxh64":"0x98C54882D92770A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1025113010:0":{"text":"Dura above! Cassadee, what did you just do? All the elemental magic inside escaped!","source_cn":"艾雅在上，科丝蒂，你刚才干了什么啊？里面的元素能量都逃...","status":"matched","hash_xxh64":"0x44303142B2C072E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1025113011:0":{"text":"Strange... What did I do wrong...?\nAh! We can't let these elementals harm the folks here!","source_cn":"奇怪，我的操作到底哪里有误……\\n啊，糟了，不能让这些...","status":"matched","hash_xxh64":"0xF2E2285897278604","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1025113011":{"text":"Strange... What did I do wrong...?\nAh! We can't let these elementals harm the folks here!","source_cn":"奇怪，我的操作到底哪里有误……\\n啊，糟了，不能让这些元素对这里的人造成伤害！","status":"matched","hash_xxh64":"0xF2E2285897278604","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1025113012:0":{"text":"I suggest we split up to deal with these elementals first. The circle can wait.","source_cn":"我看还是先分头处理好这些逃逸的元素，之后再说法阵问题吧。","status":"matched","hash_xxh64":"0xB7912732C5370F87","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1025113013:0":{"text":"Uh? Oh! Alright!","source_cn":"诶？啊！好的！","status":"matched_runtime_gender","hash_xxh64":"0xD7A4D4B67E64A5D2","variant_status":"runtime_gender_keys_target_same","male":"Uh? Oh! Alright!","female":"Uh? Oh! Alright!","variant_male_record_index":"98269","variant_female_record_index":"98270","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"I know where you went wrong.","source_cn":"我知道问题在哪里了","status":"matched_runtime_gender","hash_xxh64":"0x32DFC5FDF07CEAD4","variant_status":"runtime_gender_keys_target_same","male":"I know where you went wrong.","female":"I know where you went wrong.","variant_male_record_index":"58978","variant_female_record_index":"58979","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"Careful! It's out of control!","source_cn":"小心，魔法能量紊乱了！","status":"matched_runtime_gender","hash_xxh64":"0xBC7D16DCF5194B63","variant_status":"runtime_gender_keys_target_same","male":"Careful! It's out of control!","female":"Careful! It's out of control!","variant_male_record_index":"58976","variant_female_record_index":"58977","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:0:1":{"text":"She'll find out what's wrong.","source_cn":"她的实践能帮助我确定问题","status":"matched_runtime_gender","hash_xxh64":"0x2C78CB09EFBFA0EA","variant_status":"runtime_gender_keys_target_same","male":"She'll find out what's wrong.","female":"She'll find out what's wrong.","variant_male_record_index":"58972","variant_female_record_index":"58973","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:1:2":{"text":"It's a good idea. Let her try.","source_cn":"思路很清晰，让她试试","status":"matched_runtime_gender","hash_xxh64":"0x6ABD8D21B7898571","variant_status":"runtime_gender_keys_target_same","male":"It's a good idea. Let her try.","female":"It's a good idea. Let her try.","variant_male_record_index":"58974","variant_female_record_index"