{"asset_key":"mn/quest_story_10101218","episode":"mn","category":"quest_story","story_id":"10101218","schema_version":1,"lang":"en","texts":{"say:2:1010121801:1":{"text":"Great! Now we can get across to Southville!","source_cn":"太好啦！这下就能过桥去南村了！","status":"matched","hash_xxh64":"0xB4778DA85FD43C57","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1010121802:1":{"text":"Why do you look unhappy, Rowan?","source_cn":"罗万少爷，你怎么看起来不太开心的样子？","status":"matched","hash_xxh64":"0xEE50CDDD3E91F030","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1010121803:1":{"text":"Well, it's because of the bridge... It was all too easy to stop traffic between the two places. All you have to do is break the lever.","source_cn":"唔，因为这座桥的位置……只要破坏掉机关，就能轻而易举地...","status":"matched","hash_xxh64":"0xDA0610DF8D94306D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1010121804:1":{"text":"I was able to repair it this time, but it'll be a problem for caravans in the future.","source_cn":"这次是因为恰巧我能修理，所以能够恢复通行，但对于商队货...","status":"matched","hash_xxh64":"0xA1A697F910DA7317","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:6:1010121804":{"text":"I was able to repair it this time, but it'll be a problem for caravans in the future.","source_cn":"这次是因为恰巧我能修理，所以能够恢复通行，但对于商队货车来说可就麻烦了。","status":"matched","hash_xxh64":"0xA1A697F910DA7317","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1010121805:1":{"text":"Yes, a bridge that can be rendered uncrossable so easily, as well as an unsafe business environment...","source_cn":"是啊。一座如此轻易就能被破坏的桥，以及混乱而危险的商贸...","status":"matched","hash_xxh64":"0x6747ABDF77F1FD0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1010121806:1":{"text":"I need to re-evaluate my business venture...","source_cn":"有必要重新评估构建周边商贸渠道的计划了……","status":"matched","hash_xxh64":"0x42DE00E322454C53","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:6:0:1":{"text":"It may hinder trade routes.","source_cn":"会阻碍你打通商路","status":"matched_runtime_gender","hash_xxh64":"0xAA50ED66DFE37072","variant_status":"runtime_gender_keys_target_same","male":"It may hinder trade routes.","female":"It may hinder trade routes.","variant_male_record_index":"59298","variant_female_record_index":"59299","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:罗万":{"text":"Rowan","source":"罗万","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":2}}