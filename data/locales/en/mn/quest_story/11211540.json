{"asset_key":"mn/quest_story_11211540","episode":"mn","category":"quest_story","story_id":"11211540","schema_version":1,"lang":"en","texts":{"say:1:1121154001:1":{"text":"Talene, are you alright? And have you found the Hypogean?","source_cn":"塔琳小姐，你没事吧？找到恶魔了吗？","status":"matched","hash_xxh64":"0xD85D5BE1191CC5C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1121154002:1":{"text":"There was no trace of the Hypogean when I arrived.","source_cn":"抱歉，我来到这里时，已经没有恶魔的踪影了。","status":"matched","hash_xxh64":"0x017046B3A21A852F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1121154003:1":{"text":"Its minions, however, appeared out of nowhere. It's like they were trying to hinder my pursuit...","source_cn":"那些恶魔的眷属反而突然出现，好像有意要拖延我的追踪。","status":"matched","hash_xxh64":"0x05C25593C75A8B0F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1121154004:2":{"text":"Talene, can you still detect the Hypogean's aura?","source_cn":"那，塔琳小姐，你现在还能感受到恶魔气息吗？","status":"matched","hash_xxh64":"0xFBF5CEFADDCDAE07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1121154005:1":{"text":"Not anymore. It's gone without a trace.","source_cn":"已经找不到了。","status":"matched","hash_xxh64":"0x729A6C4219DB1BC8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1121154006:1":{"text":"During our journey, Elona was vigilant of her surroundings but didn't spot anything suspicious.","source_cn":"来的路上，艾洛娜留意过四周，月影乡没有其他变化。","status":"matched","hash_xxh64":"0x08819207A3134FDE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1121154007:0":{"text":"Well, what should we do now? Even if we remain here, there's no guarantee the Hypogean will emerge.","source_cn":"唔，那怎么办呢……即便在这里继续守候，恶魔也不一定会再...","status":"matched","hash_xxh64":"0x39ADA2EF6BC1B199","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1121154007":{"text":"Well, what should we do now? Even if we remain here, there's no guarantee the Hypogean will emerge.","source_cn":"唔，那怎么办呢……即便这里继续守候，恶魔也不一定会再在这里出现。","status":"matched","hash_xxh64":"0x39ADA2EF6BC1B199","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1121154008:0":{"text":"I'll have Elona stay on guard.","source_cn":"我会让艾洛娜继续警戒。","status":"matched","hash_xxh64":"0x618D4C7BEC88FCC7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1121154009:1":{"text":"Everyone, please.","source_cn":"诸位，请。","status":"matched","hash_xxh64":"0x1EA2594EC6211EF8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"Let's go to the Spirit Mound.","source_cn":"提高警惕，先去鹿灵圣丘","status":"matched_runtime_gender","hash_xxh64":"0xE75DE53E7DC42DFC","variant_status":"runtime_gender_keys_target_same","male":"Let's go to the Spirit Mound.","female":"Let's go to the Spirit Mound.","variant_male_record_index":"59118","variant_female_record_index":"59119","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"Await the Hypogean's return.","source_cn":"我们等恶魔自己找上来","status":"matched_runtime_gender","hash_xxh64":"0x699A2CF65E5BC9DE","variant_status":"runtime_gender_keys_target_same","male":"Await the Hypogean's return.","female":"Await the Hypogean's return.","variant_male_record_index":"59120","variant_female_record_index":"59121","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:2:3":{"text":"But can we leave this area?","source_cn":"我更好奇鹿灵圣丘那边……","status":"matched_runtime_gender","hash_xxh64":"0xB2209D624B33FA1A","variant_status":"runtime_gender_keys_target_same","male":"But can we leave this area?","female":"But can we leave this area?","variant_male_record_index":"59122","variant_female_record_index":"59123","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:塔琳":{"text":"Talene","source":"塔琳","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:布莱恩":{"text":"Bryon","source":"布莱恩","status":"match