{"asset_key":"mn2/gameplay_story_10604050","episode":"mn2","category":"gameplay_story","story_id":"10604050","schema_version":1,"lang":"en","texts":{"say:1:1060405001:1":{"text":"Sorry for such a mess.","source_cn":"让你看见这么狼狈的一面，真是抱歉。","status":"matched","hash_xxh64":"0xC13E67D226118201","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1060405002:1":{"text":"We should've known them better before we moved... Didn't know there were going to be so many of them.","source_cn":"是我们太轻敌了，没调查清楚就贸然行动……没想到这里居然...","status":"matched","hash_xxh64":"0x84C4E8B6F0F1C9FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1060405003:1":{"text":"Thank goodness you're here. We would've lost long ago if we had waited for the patrol to come.","source_cn":"幸好遇到了你。要是真的等到巡逻队过来，我们估计早就败下...","status":"matched","hash_xxh64":"0xA514531E9D6C3D0E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1060405004:1":{"text":"Please take this little something as a thank-you gift.","source_cn":"这一点东西算是感谢，请你务必收下。","status":"matched","hash_xxh64":"0x421F026B7BD4D62B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:薄暮队员德兰克":{"text":"Patroller Dylan","source":"薄暮队员德兰克","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}