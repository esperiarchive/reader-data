{"asset_key":"mn2/herohub_story_10412040","episode":"mn2","category":"herohub_story","story_id":"10412040","schema_version":1,"lang":"en","texts":{"say:3:1041204001:1":{"text":"Hey, everyone!","source_cn":"诸位！","status":"matched","hash_xxh64":"0x9723E22CC66530F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041204002:1":{"text":"Ahhh! You're that bird guy... Oops! Chippy didn't say anything!","source_cn":"哇啊啊！你不是那个鸟人……不不不，满满什么也没说！","status":"matched","hash_xxh64":"0x944C9F7314220814","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1041204002":{"text":"Ahhh! You're that bird guy... Oops! Chippy didn't say anything!","source_cn":"哇啊啊！你不是那个鸟人……不不不，满满什么也没说！","status":"matched","hash_xxh64":"0x944C9F7314220814","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041204003:1":{"text":"Ye must be hungry from the journey. I have gathered fruits to aid thee in restoring thy strength!","source_cn":"诸位舟车劳顿，吾特意采集野果，可助汝等恢复精力！","status":"matched","hash_xxh64":"0x510C644078F296A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1041204004:1":{"text":"Mr. Hamster, doth I inspire fear in thee?","source_cn":"……鼠君。吾，如此令你畏惧？","status":"matched","hash_xxh64":"0x87CFBF705B3B1A4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1041204005:1":{"text":"O-of course not... Chippy... Chippy just didn't notice you, that's why Chippy got shocked!","source_cn":"没……没有啊！满满……满满只不过是没注意到你，才被吓了一跳！","status":"matched","hash_xxh64":"0xFCD66564227871CF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1041204006:1":{"text":"Hoot...","source_cn":"……咕唔。","status":"matched","hash_xxh64":"0xF7A3B31EC3EA3FFC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1041204007:0":{"text":"Thank you for the fruit, Kafra.","source_cn":"果子我们收下啦，谢谢你，卡夫拉。","status":"matched","hash_xxh64":"0xC54E71274A9007E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1041204008:1":{"text":"Hoot...","source_cn":"咕……唔。","status":"matched","hash_xxh64":"0xC5978B6959876BD3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1041204009:0":{"text":"Would you like to eat with us? There's an empty seat here.","source_cn":"怎么，你想和我们一起吃吗？这里还有空位。","status":"matched","hash_xxh64":"0xE2FD0431CC6CDBDC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1041204010:1":{"text":"I...","source_cn":"吾……另有……","status":"matched","hash_xxh64":"0x3FEDEB54B1AA437D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1041204011:1":{"text":"Hmmm... Never mind! I shouldn't!","source_cn":"不……不可，不可！","status":"matched","hash_xxh64":"0xEC913FED39363B60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:15:1041204011":{"text":"Hmmm... Never mind! I shouldn't!","source_cn":"不……不可，不可！","status":"matched","hash_xxh64":"0xEC913FED39363B60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1041204012:1":{"text":"I-I wish to lay hands upon the downy faces of the two hamster familiars!","source_cn":"吾、吾想触碰两位仓鼠使魔之面颊！","status":"matched","hash_xxh64":"0x9CDF2DB9EB697E66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1041204013:0":{"text":"WHHHHATTTT???!!!","source_cn":"——什什什什么！！！","status":"matched","hash_xxh64":"0x12223A8366746754","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1041204014:1":{"text":"Hamsters, those delicate and lovely creatures, so round and flawless, charming and delightful, are truly the most exquisite beings in this world!","source_cn":"两位仓鼠这般柔软娇小的生物，珠圆玉润，憨态可掬，实乃世...","status":"matched","hash_xxh64":"0xFF10E977E5CE021F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1041204015:1":{"text":"As the lieutenant of the Thorned Guards, I must maintain solemnity at all times... Those in the forest seldom wish to draw near me.","source_cn":"吾身为荆棘副官，需得时时肃穆，不可有片刻懈怠。丛林众人...","status":"matched","hash_xxh64":"0x96019C36850C50DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1041204016:1":{"text":"If aught offends... I earnestly implore both of thee to pardon my impoliteness!","source_cn":"若有冒犯……恳请两位，宽恕吾的无礼！","status":"matched","hash_xxh64":"0x5491047FE85570E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1041204017:1":{"text":"Uh, well... Even if you praise us for being cute, this request is just...","source_cn":"呃，唔……！真、真是的，就算你夸我们可爱，这要求也实在是……","status":"matched","hash_xxh64":"0x25514FE84C880B9D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1041204018:1":{"text":"Verily, I seek thy forgiveness, for my request was untoward and discourteous.","source_cn":"无妨，遭拒在吾意料之中，本就是无礼请求！","status":"matched","hash_xxh64":"0xA30C2B1D68AE3862","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1041204019:1":{"text":"Alright, let's do this! Chippy, let's shake hands with Kafra!","source_cn":"……算了，豁出去了！满满，咱们和卡夫拉握握手吧！","status":"matched","hash_xxh64":"0x5457F0725742B472","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1041204020:1":{"text":"There's nothing to be afraid of! Kafra seems like a nice guy! He won't bite!","source_cn":"不要害怕！卡夫拉看起来不是那么可怕的人！也不会以仓鼠为食！","status":"matched","hash_xxh64":"0x752DD9A4D6EB0619","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1041204021:0":{"text":"V-very well, if it's just a handshake, Chippy will muster the courage!","source_cn":"好……好吧，只是握手的话，满满会……鼓足勇气！","status":"matched","hash_xxh64":"0xE684C12F40E980A5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1041204022:0":{"text":"My thanks to thee, esteemed creatures, my longing finds fruition this day!","source_cn":"多谢诸位，吾的心愿，今日已近实现！","status":"matched","hash_xxh64":"0xEEEEAB6D93F7DD69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:15:0:1":{"text":"Just say it!","source_cn":"你想说什么？大胆说出来！","status":"matched_runtime_gender","hash_xxh64":"0xA020BB61D97A70BE","variant_status":"runtime_gender_keys_target_same","male":"Just say it!","female":"Just say it!","variant_male_record_index":"61412","variant_female_record_index":"61413","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"Kafra, what brought you here?","source_cn":"卡夫拉，你怎么来了？","status":"matched_runtime_gender","hash_xxh64":"0xDFA8D2BA2991CFCA","variant_status":"runtime_gender_keys_target_same","male":"Kafra, what brought you here?","female":"Kafra, what brought you here?","variant_male_record_index":"61410","variant_female_record_index":"61411","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卡夫拉":{"text":"Kafra","source":"卡夫拉","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满和漫漫":{"text":"Chippy & Hammie","source":"满满和漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":27,"localized_text_count":26,"speaker_count":4}}