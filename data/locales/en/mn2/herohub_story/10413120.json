{"asset_key":"mn2/herohub_story_10413120","episode":"mn2","category":"herohub_story","story_id":"10413120","schema_version":1,"lang":"en","texts":{"say:3:1041312001:1":{"text":"This is an iris, and this is a green orchid... Here, Hammie, come. These smell very nice.","source_cn":"这是纸鸢尾，这是绿黛兰……喏，漫漫你来闻闻，很香的。","status":"matched","hash_xxh64":"0xE0C5B6267879F4E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041312002:1":{"text":"Wow, such a refreshing scent! I've never seen these kinds of beautiful-smelling flowers anywhere else.","source_cn":"哇，令人头脑舒畅的清香味！这几种又好闻又好看的花，我在...","status":"matched","hash_xxh64":"0xD7528C5D0EF58353","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041312003:1":{"text":"I want to collect some seeds and plant them in the Mystical House.","source_cn":"真想收集一些花种，把这些花都种在神秘屋里……","status":"matched","hash_xxh64":"0x7B9837D2E8D41D74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041312004:1":{"text":"Planted them... *Sneeze*.... Mystical House... *Sneeze*...","source_cn":"种在……阿嚏！神秘屋……阿嚏……！！","status":"matched","hash_xxh64":"0xA496E8A9B22BFFB3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1041312005:1":{"text":"Chippy objects! No way! I'm allergic! *Sneeze*","source_cn":"反对！满满反对这个提议！会过敏……阿嚏……！","status":"matched","hash_xxh64":"0x4202E6743CAB378E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":6,"localized_text_count":5,"speaker_count":3}}