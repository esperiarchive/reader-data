{"asset_key":"mn2/env_story_10370190","episode":"mn2","category":"env_story","story_id":"10370190","schema_version":1,"lang":"en","texts":{"say:1:1037019001:1":{"text":"You're an outlander. Of course, you can be indifferent!","source_cn":"你是外乡人，当然可以满不在乎！","status":"matched","hash_xxh64":"0xB4742EE312C16B43","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1037019002:1":{"text":"We've been trying to clean up all the corruption.","source_cn":"我们一直尝试清理腐化的土地。","status":"matched","hash_xxh64":"0xD2905255453E8EFC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1037019003:1":{"text":"But no matter what we try, the corrupted land remains unchanged. How dreadful!","source_cn":"可是无论怎么做，那片腐化的土地却毫无变化。这多么可怕啊！","status":"matched","hash_xxh64":"0xAA4CF448F2BA7D92","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1037019004:1":{"text":"I honestly don't know how long it'll all take to return to normal.","source_cn":"真不知道还要多久才能恢复正常……","status":"matched","hash_xxh64":"0xADF08FF3D953FBEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:村民柯米丽尔":{"text":"Kamari","source":"村民柯米丽尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}