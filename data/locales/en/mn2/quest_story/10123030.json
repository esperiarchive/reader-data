{"asset_key":"mn2/quest_story_10123030","episode":"mn2","category":"quest_story","story_id":"10123030","schema_version":1,"lang":"en","texts":{"say:1:1012303001:1":{"text":"Is that horrible creature about to come back...?","source_cn":"那种可怕的生物是不是又要出现了……","status":"matched","hash_xxh64":"0xAA062B191C802976","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1012303001":{"text":"Is that horrible creature about to come back...?","source_cn":"那种可怕的生物是不是又要出现了……","status":"matched","hash_xxh64":"0xAA062B191C802976","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1012303002:1":{"text":"Really? I'm psyching myself up for nothing.","source_cn":"什么……那我白做心理准备了。","status":"matched","hash_xxh64":"0xC0320EE80AB41A23","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1012303003:1":{"text":"Pray to Misarte, may this be our last test.","source_cn":"你向弥萨忒祈祷吧，但愿这是我们最后的考验。","status":"matched","hash_xxh64":"0xB2DE15FA2B066353","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1012303004:1":{"text":"You think this is a test? A test of what? There won't be a test of courage, will there?","source_cn":"你认为这是考验？考验什么啊……该不是考验胆量？","status":"matched","hash_xxh64":"0x550725C130213335","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1012303005:1":{"text":"A test to see if we're allowed into Ivoryshade.","source_cn":"考验我们是否有进入月影乡的资格。","status":"matched","hash_xxh64":"0xD1A41371616E241B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1012303006:1":{"text":"Where can we go? There's no road ahead.","source_cn":"从哪进？前面根本没路。","status":"matched","hash_xxh64":"0x4C41005102CEE1A1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1012303007:1":{"text":"There is indeed no path if you're just using your eyes.","source_cn":"只是用肉眼看的话，前方确实没有路了。","status":"matched","hash_xxh64":"0xF96A5A5B03C1DCC1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1012303008:1":{"text":"Lorsan, Bryon, can you hear anything?","source_cn":"洛桑，布莱恩，你们能否听出什么？","status":"matched","hash_xxh64":"0xC414112FD18F5E53","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1012303009:2":{"text":"Not right now.","source_cn":"暂时不行。","status":"matched","hash_xxh64":"0x149C5ABA52F2023D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1012303010:1":{"text":"If this really is a test, they first tested my archery, and then they tested Eironn's swordsmanship.","source_cn":"如果这一切真的是考验，第一次，是考验我的箭术，第二次，...","status":"matched","hash_xxh64":"0xEA448076343DE2CE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1012303011:1":{"text":"Perhaps this time, they want to test your perception as a Windwhisperer, Bryon.","source_cn":"这一次，或许是考验你作为风语者的感知力，布莱恩。","status":"matched","hash_xxh64":"0xD2577514C934ED0B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1012303012:2":{"text":"I'm not the only Windwhisperer here. Lorsan is more skilled at scrying than I am.","source_cn":"这里不止我一个风语者，洛桑比我更擅长探查。","status":"matched","hash_xxh64":"0xDFC672F33B27FDC6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1012303013:1":{"text":"You weren't so humble yesterday...","source_cn":"这时候你反倒谦虚起来了……","status":"matched","hash_xxh64":"0x81A7FF2F570EF40E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:16:1012303013":{"text":"You weren't so humble yesterday...","source_cn":"这时候你反倒谦虚起来了……","status":"matched","hash_xxh64":"0x81A7FF2F570EF40E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1012303014:0":{"text":"Since you said that, I guess I have to do my best.","source_cn":"有你这么说，我一定会努力的！","status":"matched_runtime_gender","hash_xxh64":"0x96FA183A24A90891","variant_status":"runtime_gender_keys_target_same","male":"Since you said that, I guess I have to do my best.","female":"Since you said that, I guess I have to do my best.","variant_male_record_index":"111415","variant_female_record_index":"111416","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1012303017:0":{"text":"<style=\"stress\"><player_name></style>, I'll need to prepare the ritual that you witnessed in Ryeham.","source_cn":"接下来我会使用聚灵仪式，<style=stress><...","status":"matched_runtime_gender","hash_xxh64":"0x623210FE004D8C58","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, I'll need to prepare the ritual that you witnessed in Ryeham.","female":"<style=\"stress\"><player_name></style>, I'll need to prepare the ritual that you witnessed in Ryeham.","variant_male_record_index":"111419","variant_female_record_index":"111420","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1012303018:1":{"text":"This time, I'm going to ask you to collect <style=\"highlight\">bay twigs</style> for the ritual. I need to stay here and prepare.","source_cn":"这次也要麻烦你们去收集仪式所需的<style=high...","status":"matched_runtime_gender","hash_xxh64":"0x51BDA181C205ED26","variant_status":"runtime_gender_keys_target_same","male":"This time, I'm going to ask you to collect <style=\"highlight\">bay twigs</style> for the ritual. I need to stay here and prepare.","female":"This time, I'm going to ask you to collect <style=\"highlight\">bay twigs</style> for the ritual. I need to stay here and prepare.","variant_male_record_index":"111421","variant_female_record_index":"111422","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1012303019:1":{"text":"Just like before!","source_cn":"——就和之前咱们曾经做过的一样！","status":"matched_runtime_gender","hash_xxh64":"0x25C1A112800ABA64","variant_status":"runtime_gender_keys_target_same","male":"Just like before!","female":"Just like before!","variant_male_record_index":"111423","variant_female_record_index":"111424","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:0:1":{"text":"I believe in you, Lorsan.","source_cn":"洛桑，我相信你","status":"matched_runtime_gender","hash_xxh64":"0x0A08BE940065AFFA","variant_status":"runtime_gender_keys_target_same","male":"I believe in you, Lorsan.","female":"I believe in you, Lorsan.","variant_male_record_index":"61500","variant_female_record_index":"61501","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1012303015:2":{"text":"If the concern of failure troubles him, I will do it on his behalf.","source_cn":"你要是担心出现闪失，我不介意代劳。","status":"matched","hash_xxh64":"0xA5F4742E39B16450","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1012303016:1":{"text":"No thanks! I can handle it.","source_cn":"谢谢，不劳你费心了！","status":"matched","hash_xxh64":"0xC085B9DA4115DE93","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:16:1:2":{"text":"You should try again, Bryon.","source_cn":"布莱