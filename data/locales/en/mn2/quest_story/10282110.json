{"asset_key":"mn2/quest_story_10282110","episode":"mn2","category":"quest_story","story_id":"10282110","schema_version":1,"lang":"en","texts":{"say:3:1028211001:1":{"text":"It's the wind! You heard my call, didn't you?","source_cn":"风……是风！你……你听到我的召唤了，对不对？","status":"matched","hash_xxh64":"0x9E05F5F0FE07C582","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028211002:1":{"text":"Amazing! Misarte really gave me the power to speak with the wind! ","source_cn":"太棒了！弥萨忒真的赐予了我风语天赋！","status":"matched","hash_xxh64":"0xC99CEA41BFF8933B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028211003:1":{"text":"Could you please pass a message to my mama and papa? Just say that I can talk to the wind now. When I grow up, I will become the best Windwhisperer...","source_cn":"请你传个信息给我的爸爸妈妈好不好？就说……对，就说我现...","status":"matched","hash_xxh64":"0x040187CAF883ECB2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1028211004:1":{"text":"...Hmm? Why is the wind blowing so strong? Please wind, heed my words, and calm down...","source_cn":"……嗯？怎么风越来越大了，风啊，聆听我的话语，请你不要...","status":"matched","hash_xxh64":"0x4C10DBE564E9B741","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1028211005:1":{"text":"Why does Chippy feel the wind elemental isn't very happy...","source_cn":"满满怎么觉得风元素有点不太高兴……","status":"matched","hash_xxh64":"0x448220F6EF16693B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1028211006:1":{"text":"He can't speak to the wind at all. The elemental doesn't understand what's going on and may think it's being provoked! ","source_cn":"糟了，他根本不会风语。这样“沟通”，风元素可能会觉得他...","status":"matched","hash_xxh64":"0xC338DC0DB92D9209","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1028211007:1":{"text":"What's happening? Listen! Please listen to me!","source_cn":"怎么回事……听我、听我说——","status":"matched","hash_xxh64":"0xFF59359E25801F90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1028211008:1":{"text":"Wait! Don't come any closer!","source_cn":"别、别过来——！！","status":"matched","hash_xxh64":"0xB61BFF461B718087","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1028211009:1":{"text":"Oh no, the wind elemental is going berserk! Quick! Let's go! ","source_cn":"不好，风元素狂暴了！快、快阻止它！","status":"matched","hash_xxh64":"0xD09E1C7E16E18C83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:兰迪":{"text":"Randy","source":"兰迪","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":3}}