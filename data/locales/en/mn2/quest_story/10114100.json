{"asset_key":"mn2/quest_story_10114100","episode":"mn2","category":"quest_story","story_id":"10114100","schema_version":1,"lang":"en","texts":{"say:2:1011410001:1":{"text":"Drisga, we are here to see Master Eomir.","source_cn":"德里斯加，我们求见伊米尔贤者。","status":"matched","hash_xxh64":"0xDD3B2D7083622364","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1011410002:1":{"text":"Parisa...? Why are you here?","source_cn":"帕瑞莎……？你怎么回来了？","status":"matched","hash_xxh64":"0xF9651BD28C9CA463","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1011410003:1":{"text":"Wait no, you're no longer the captain. You have no right to enter the Thorned camp!","source_cn":"不对，你已经不再是队长，无权进入荆棘营地！","status":"matched","hash_xxh64":"0x93297254C226D44B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1011410004:1":{"text":"Please step aside and let us in.","source_cn":"请让开，别阻拦我们。","status":"matched","hash_xxh64":"0xF35F3D7781212868","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1011410005:1":{"text":"They all claimed you were conspiring with outsiders. I didn't believe it. But now, it appears to be true.","source_cn":"……他们都说你勾结外人，我还不相信。如今亲眼所见，果然...","status":"matched","hash_xxh64":"0xA2E1360603FA4005","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1011410006:0":{"text":"Why are you bringing a Dusk Patroller and a Windwhisperer into our camp? You were once Master Eomir's most trusted advisor, and now you're defying his orders?!","source_cn":"你带着薄暮和风语的人，闯进营地是想做什么？当初是伊米尔...","status":"matched","hash_xxh64":"0x8FE27B21774647D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1011410007:1":{"text":"Drisga, the Thorned Guards' mission is to protect the forest, not blindly champion the will of one sage.","source_cn":"德里斯加，荆棘卫队的使命是保护丛林，而非一昧拥护贤者。","status":"matched","hash_xxh64":"0x26C2B61F0CFDE618","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1011410008:0":{"text":"Now, are the Thorned Guards still worthy of being called the guardians of the forest?","source_cn":"现在的荆棘，还称得上是丛林的护卫吗？","status":"matched","hash_xxh64":"0xC8D5E18B1956563C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1011410009:0":{"text":"You're the one who betrayed us!","source_cn":"——真正的叛徒明明是你！","status":"matched","hash_xxh64":"0x8CA0351249B6D3FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1011410010:0":{"text":"Guards! Get them out of here!","source_cn":"卫士们，列队！把他们赶出去！","status":"matched","hash_xxh64":"0x198CA9A54ECF1E33","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:帕瑞莎":{"text":"Parisa","source":"帕瑞莎","status":"matched_dialogue_flow"},"speaker:荆棘卫士德里斯加":{"text":"Guard Drisga","source":"荆棘卫士德里斯加","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":2}}