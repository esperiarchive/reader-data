{"asset_key":"mn2/quest_story_10112130","episode":"mn2","category":"quest_story","story_id":"10112130","schema_version":1,"lang":"en","texts":{"say:0:1011213001:0":{"text":"What's this? Oh, a cute toy car with... wings?","source_cn":"唔，这是什么？挺可爱的玩具车……但长着翅膀？","status":"matched","hash_xxh64":"0x2FE4CFEB862EEE14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1011213002:0":{"text":"That must be Damian's little gadget. He loves tinkering with these odd inventions!","source_cn":"一看就是达米安的小玩意，他最喜欢鼓捣这些奇奇怪怪的发明了！","status":"matched","hash_xxh64":"0xF039A5AF4A169020","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1011213003:0":{"text":"Damian loves his creation. How could he have left it on the side of the road... No, he's in danger!","source_cn":"达米安很爱惜他的造物，怎么会丢在路边……不对，他有危险！","status":"matched","hash_xxh64":"0x9A7A6ABD5806867E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"},"speaker:埃隆":{"text":"Eironn","source":"埃隆","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":3}}