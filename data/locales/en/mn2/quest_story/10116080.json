{"asset_key":"mn2/quest_story_10116080","episode":"mn2","category":"quest_story","story_id":"10116080","schema_version":1,"lang":"en","texts":{"say:1:1011608001:1":{"text":"<style=\"highlight\">Kafra</style>?!","source_cn":"<style=highlight>卡夫拉</style...","status":"matched","hash_xxh64":"0xCA1F8A701EC43728","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1011608002:1":{"text":"Hoot! Captain Parisa, 'tis verily thou!","source_cn":"咕唔，帕瑞莎长官，真的是您！","status":"matched","hash_xxh64":"0x70E638E4DC6C4724","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1011608002":{"text":"Hoot! Captain Parisa, 'tis verily thou!","source_cn":"咕唔，帕瑞莎长官，真的是您！","status":"matched","hash_xxh64":"0x70E638E4DC6C4724","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1011608003:1":{"text":"Kafra is my former deputy.","source_cn":"这是卡夫拉，我曾经的副手。","status":"matched_runtime_gender","hash_xxh64":"0xB65D129804FFCF11","variant_status":"runtime_gender_keys_target_same","male":"Kafra is my former deputy.","female":"Kafra is my former deputy.","variant_male_record_index":"108757","variant_female_record_index":"108758","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1011608004:1":{"text":"I, remain the deputy unto Captain Parisa!","source_cn":"吾，此时也是帕瑞莎长官的副手！","status":"matched_runtime_gender","hash_xxh64":"0x195AC1E85256C2BD","variant_status":"runtime_gender_keys_target_same","male":"I, remain the deputy unto Captain Parisa!","female":"I, remain the deputy unto Captain Parisa!","variant_male_record_index":"108759","variant_female_record_index":"108760","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1011608005:1":{"text":"I'm no longer captain of the Thorned Guards, so you should stop calling me that.","source_cn":"……我已经不是荆棘卫队的队长了，不该再这么称呼我。","status":"matched","hash_xxh64":"0x4D13A37B2FBFCFD9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1011608006:1":{"text":"I doth persist!","source_cn":"此乃吾的坚持！","status":"matched","hash_xxh64":"0xFA242CCEB7B7A025","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1011608006":{"text":"I doth persist!","source_cn":"此乃吾的坚持！","status":"matched","hash_xxh64":"0xFA242CCEB7B7A025","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1011608007:1":{"text":"Hoot! Outlander! Utterance cometh only with Captain Parisa's grant!","source_cn":"咕唔！外乡人！帕瑞莎长官许可后才可发言！","status":"matched_runtime_gender","hash_xxh64":"0xC1B801A905266853","variant_status":"runtime_gender_keys_target_same","male":"Hoot! Outlander! Utterance cometh only with Captain Parisa's grant!","female":"Hoot! Outlander! Utterance cometh only with Captain Parisa's grant!","variant_male_record_index":"108763","variant_female_record_index":"108764","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1011608008:1":{"text":"Kafra, <style=\"stress\"><player_name></style> is a mage brought in by the Windwhisperer, and I've seen him use magic firsthand to clear out corruption.","source_cn":"卡夫拉，这是风语从外界请回的魔法师<style=str...","status":"matched_runtime_gender","hash_xxh64":"0x1AEAEFDFC13508CE","variant_status":"runtime_gender_keys_target_differs","male":"Kafra, <style=\"stress\"><player_name></style> is a mage brought in by the Windwhisperer, and I've seen him use magic firsthand to clear out corruption.","female":"Kafra, <style=\"stress\"><player_name></style> is a mage brought in by the Windwhisperer, and I've seen her use magic firsthand to clear out corruption.","variant_male_record_index":"108765","variant_female_record_index":"108766","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1011608009:1":{"text":"Clear out corruption...!","source_cn":"……清除腐化！","status":"matched_runtime_gender","hash_xxh64":"0xF15AD7F8BE957C19","variant_status":"runtime_gender_keys_target_same","male":"Clear out corruption...!","female":"Clear out corruption...!","variant_male_record_index":"108767","variant_female_record_index":"108768","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1011608010:1":{"text":"An outlander graced with such might! It behooves us to accord him the utmost courtesy!","source_cn":"竟——竟有如此之能的外乡人！吾等当用最高礼节迎接才是！","status":"matched_runtime_gender","hash_xxh64":"0x8EDAE0C25C43F286","variant_status":"runtime_gender_keys_target_differs","male":"An outlander graced with such might! It behooves us to accord him the utmost courtesy!","female":"An outlander graced with such might! It behooves us to accord her the utmost courtesy!","variant_male_record_index":"108769","variant_female_record_index":"108770","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1011608010":{"text":"An outlander graced with such might! It behooves us to accord him the utmost courtesy!","source_cn":"竟——竟有如此之能的外乡人！吾等当用最高礼节迎接才是！","status":"matched_runtime_gender","hash_xxh64":"0x8EDAE0C25C43F286","variant_status":"runtime_gender_keys_target_differs","male":"An outlander graced with such might! It behooves us to accord him the utmost courtesy!","female":"An outlander graced with such might! It behooves us to accord her the utmost courtesy!","variant_male_record_index":"108769","variant_female_record_index":"108770","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1011608012:0":{"text":"I take it you're not working for Eomir?","source_cn":"所以，听你们的意思……你们和伊米尔不是一伙的？","status":"matched","hash_xxh64":"0x5BEA436FA9D76B80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1011608013:0":{"text":"We art the subordinates of Captain Parisa. After the captain's departure, we hath been reassigned and stationed hither.","source_cn":"吾等是帕瑞莎部下。长官离任后，吾等被接连调职，下放于此。","status":"matched","hash_xxh64":"0xE895FE8DEF6B4848","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1011608014:1":{"text":"Were you all affected by my dismissal?!","source_cn":"我被革职，连你们也受牵连了吗？！","status":"matched","hash_xxh64":"0x0753ED1CF7B79890","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1011608015:1":{"text":"We pledge fealty to the Thorned Faction.\nA sage bereft of wisdom merits no allegiance, verily!","source_cn":"吾等效忠荆棘。\\n贤者不贤，当然无忠可献！","status":"matched","hash_xxh64":"0x2DAF37B4D31718FD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1011608016:1":{"text":"You saw more clearly than I did...","source_cn":"……好……你们看的比我透彻。","status":"matched","hash_xxh64":"0x3BF235C365568A06","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1011608017:1":{"text":"Captain, we are assembled nigh. Thou mayst proceed to inspect and take respite!","source_cn":"长官，吾等已在附近重新集结，您可前往视察休憩！","status":"matched","hash_xxh64":"0x85DA57E8E28F989F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1011608018:1":{"text":"Brillia, Rosetta, secure the found provisions and make haste to return to camp!","source_cn":"布拉苜，萝赛塔，收好寻到的物资，列队回营！","status":"matched","hash_xxh64":"0x98FCACED01E3CEFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:0:1":{"text":"That's not necessary...","source_cn":"那倒是不用了……","status":"matched_runtime_gender","hash_xxh64":"0x2BB51439B532C531","variant_status":"runtime_gender_keys_target_same","male":"That's not necessary...","female":"That's not necessary...","variant_male_record_index":"60998","variant_female_record_index":"60999","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1011608011:0":{"text":"I prithee pardon mine discourtesy!","source_cn":"是，恳请宽恕吾的无礼！","status":"matched_runtime_gender","hash_xxh64":"0xBA81CC176A2CFE9B","variant_status":"runtime_gender_keys_target_same","male":"I prithee pardon mine discourtesy!","female":"I prithee pardon mine discourtesy!","variant_male_record_index":"108771","variant_female_record_index":"108772","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:13:1:2":{"text":"You better apologize to me!","source_cn":"要好好向我道歉！","status":"matched_runtime_gender","hash_xxh64":"0x440133A07A3E4F1D","variant_status":"runtime_gender_keys_target_same","male":"You better apologize to me!","female":"You better apologize to me!","variant_male_record_index":"61000","variant_female_record_index":"61001","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"Why is Parisa's deputy here?","source_cn":"帕瑞莎的副手，为什么在这里？","status":"matched_runtime_gender","hash_xxh64":"0x5FD4BB52F4A7E4C1","variant_status":"runtime_gender_keys_target_same","male":"Why is Parisa's deputy here?","female":"Why is Parisa's deputy here?","variant_male_record_index":"60996","variant_female_record_index":"60997","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"You know each other?","source_cn":"你们认识？","status":"matched_runtime_gender","hash_xxh64":"0x035B038C26C16062","variant_status":"runtime_gender_keys_target_same","male":"You know each other?","female":"You know each other?","variant_male_record_index":"60994","variant_female_record_index":"60995","document_title":"","document_title_male":"","document_title_fema