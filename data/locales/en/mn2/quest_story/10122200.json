{"asset_key":"mn2/quest_story_10122200","episode":"mn2","category":"quest_story","story_id":"10122200","schema_version":1,"lang":"en","texts":{"say:2:1012220001:0":{"text":"This medicine can cure you, little ones.","source_cn":"小朋友，这些草药可以治疗你们的病痛。","status":"matched","hash_xxh64":"0x4DE3EE19A5E65E52","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1012220002:0":{"text":"You're strangers. Can we even trust you? We won't be easily fooled.","source_cn":"没见过的面孔呢，你们的话能信吗？我们可不是好骗的小孩子。","status":"matched","hash_xxh64":"0xB6E49E509659CC42","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1012220003:0":{"text":"We're friends. Granny Fennel sent us to bring you medicine.","source_cn":"我们不是坏人，是塔兰村的茴姆婆婆嘱咐我们把草药送来。","status":"matched","hash_xxh64":"0x4232CACBF5748A60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1012220004:0":{"text":"No! Our teacher told us not to accept things from strangers! Even if the stranger is a pretty lady!","source_cn":"不吃不吃！老师说不能吃陌生人给的东西！就算你是漂亮姐姐...","status":"matched","hash_xxh64":"0x241B7C1026A3784A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1012220005:0":{"text":"That's right... I don't want it...","source_cn":"没、没错……我不吃……","status":"matched","hash_xxh64":"0x78F455830D9475B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1012220006:0":{"text":"It's alright, children. She's an old friend of mine.","source_cn":"孩子们，放心吧，那位姐姐可是老师的好朋友哦。","status":"matched","hash_xxh64":"0x79DE3156DA6DA1B1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:冷静的花灵":{"text":"Calm Bulbsprite","source":"冷静的花灵","status":"matched_dialogue_flow"},"speaker:勇敢的花灵":{"text":"Brave Bulbsprite","source":"勇敢的花灵","status":"matched_dialogue_flow"},"speaker:胆怯的花灵":{"text":"Shy Bulbsprite","source":"胆怯的花灵","status":"matched_dialogue_flow"},"speaker:温柔的声音":{"text":"Gentle Lady","source":"温柔的声音","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":5}}