{"asset_key":"mn2/quest_story_10284130","episode":"mn2","category":"quest_story","story_id":"10284130","schema_version":1,"lang":"en","texts":{"say:2:1028413001:1":{"text":"How do you feel? Are you also weak and tired?","source_cn":"你感觉怎么样，也是全身乏力吗？","status":"matched","hash_xxh64":"0xCC4E119A837FB249","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1028413002:1":{"text":"Look, I used to be the strongest of us, but now even walking is tiring me out!","source_cn":"你瞧瞧，以前我是队伍里最壮的！现在可好，连走路都累。","status":"matched","hash_xxh64":"0x630F770BACA27683","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028413003:1":{"text":"What kind of dreadful illness is this? Misarte, please help me recover.","source_cn":"唉，这到底是什么病啊。弥萨忒在上，赶紧让我好起来吧。","status":"matched","hash_xxh64":"0x13160F6B772B9319","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028413004:1":{"text":"General weakness and pronounced blue veins... indeed these are more signs of corruption sickness.","source_cn":"嗯，全身乏力，血管发青……确实是一样的腐化侵蚀症状。","status":"matched","hash_xxh64":"0xC7472577C74F6574","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:采集队员沃尔森":{"text":"Harvester Walson","source":"采集队员沃尔森","s