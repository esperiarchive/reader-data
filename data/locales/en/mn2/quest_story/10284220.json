lose inspection.","female":"I suggest a close inspection.","variant_male_record_index":"61864","variant_female_record_index":"61865","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:9:2:3":{"text":"Evasive magic is quite abundant.","source_cn":"有很多种魔法可以让人失去踪迹","status":"matched_runtime_gender","hash_xxh64":"0x01CAF7F3D812D9D9","variant_status":"runtime_gender_keys_target_same","male":"Evasive magic is quite abundant.","female":"Evasive magic is quite abundant.","variant_male_record_index":"61866","variant_female_record_index":"61867","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"They should be the herbalists'.","source_cn":"应该是那两个植物学家","status":"matched_runtime_gender","hash_xxh64":"0xC1A1E74E4B08E9F8","variant_status":"runtime_gender_keys_target_same","male":"They should be the herbalists'.","female":"They should be the herbalists'.","variant_male_record_index":"61860","variant_female_record_index":"61861","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":22,"localized_text_count":21,"speaker_count":3}}