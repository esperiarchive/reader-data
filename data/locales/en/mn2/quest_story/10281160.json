{"asset_key":"mn2/quest_story_10281160","episode":"mn2","category":"quest_story","story_id":"10281160","schema_version":1,"lang":"en","texts":{"say:3:1028116001:0":{"text":"Well... this is the magic bellflower Florabelle planted. ","source_cn":"嗯……这是芙拉贝尔种下的魔法铃兰。","status":"matched","hash_xxh64":"0x76F772CDD4DCAA49","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028116002:1":{"text":"Just like Florabelle, this flower has a kind, gentle aura. ","source_cn":"真的，和芙拉贝尔一样，这朵花好美丽，还给人一种温柔的感觉呢。","status":"matched","hash_xxh64":"0x536E12FBFE73A612","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028116003:1":{"text":"The lost magic must have been drawn to the bellflower! ","source_cn":"散逸的魔力也在这里。太神奇了，它一定是被这朵铃兰花吸引来的！","status":"matched","hash_xxh64":"0x4DA4F76705997888","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1028116004:1":{"text":"Please activate the memory fragment... this is the final one. ","source_cn":"请开始激活记忆碎片吧，这是最后一处了。","status":"matched","hash_xxh64":"0x7B6337D8BFD3D2D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1028116004":{"text":"Please activate the memory fragment... this is the final one. ","source_cn":"请开始激活记忆碎片吧，这是最后一处了。","status":"matched","hash_xxh64":"0x7B6337D8BFD3D2D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1028116005:1":{"text":"Will more monsters come? ","source_cn":"诶，还会有怪物来吗？","status":"matched","hash_xxh64":"0xD98742BFBB5084FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1028116006:0":{"text":"This is the last of the lost magic. If the monsters come this time, they'll be even more wild. ","source_cn":"这是最后一处散逸的魔力，如果魔物是为了吞噬伊温小姐的力...","status":"matched","hash_xxh64":"0x9B5031DCF8C8E66A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1028116007:0":{"text":"Chippy will be on high alert!","source_cn":"……满满会提高警惕！","status":"matched","hash_xxh64":"0x0CDB1CE834DE7391","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1028116008:0":{"text":"Magister, activate the memory fragment! ","source_cn":"主人，开始激活记忆碎片吧！","status":"matched_runtime_gender","hash_xxh64":"0x7ACD787EF634F066","variant_status":"runtime_gender_keys_target_same","male":"Magister, activate the memory fragment! ","female":"Magister, activate the memory fragment! ","variant_male_record_index":"112341","variant_female_record_index":"112342","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"We'll be more careful this time. ","source_cn":"这次要更加小心","stat