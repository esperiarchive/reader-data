{"asset_key":"mn2/quest_story_10284260","episode":"mn2","category":"quest_story","story_id":"10284260","schema_version":1,"lang":"en","texts":{"say:1:1028426001:1":{"text":"...Who are you?!","source_cn":"……你们是谁？！","status":"matched","hash_xxh64":"0x067D78997DF6F380","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1028426002:1":{"text":"My name is Lyca of the Dusk Patrollers. Are you the two herbalists who parted ways with the Harvesters?","source_cn":"我是薄暮巡游队的莱卡，你们是从采集队营地出发的那两位植...","status":"matched","hash_xxh64":"0x23A1026BDFEBA05F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1028426003:1":{"text":"Wait, why is your companion on the ground? Is he alright?","source_cn":"咦……为什么你的同伴躺在地上？！他没事吗？！","status":"matched","hash_xxh64":"0x50ED6947706EEFAE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028426004:1":{"text":"D-d-dusk Patrollers? I see. Oh, he, um... he's petrified! Scared stiff!","source_cn":"巡……巡游队啊，哦，对，他是……吓坏了！对，吓晕了！","status":"matched","hash_xxh64":"0x117CBD2035D8FCB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028426005:1":{"text":"Hypofiends were chasing us so we ran and ran and well... he just sort of... passed out?","source_cn":"外面有魔物追击，我们一路逃……对，然后他……他就晕过去了！","status":"matched","hash_xxh64":"0x3BBFA9B907E4B107","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1028426006:1":{"text":"Are you unwell? Why are you stuttering?","source_cn":"你不舒服吗？为什么结结巴巴的？","status":"matched","hash_xxh64":"0xF90206FE20CB5372","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1028426007:1":{"text":"I... *Cough*, feel a little uncomfortable *Cough*...Cough*","source_cn":"我……咳，我是有点不舒服……咳咳！","status":"matched","hash_xxh64":"0x985866C74FADD6FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1028426008:1":{"text":"How long has your companion been unconscious? Do you need our help?","source_cn":"你的同伴晕过去多久了？需要我们帮忙吗？","status":"matched","hash_xxh64":"0xF08250B31378A4E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1028426009:1":{"text":"Ah? Oh, no... he, uh, should wake up... some time...","source_cn":"啊？哦，不，没事……他……他应该过一会就能醒过来……","status":"matched","hash_xxh64":"0x33C39E02083395F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:10:1028426009":{"text":"Ah? Oh, no... he, uh, should wake up... some time...","source_cn":"啊？哦，不，没事……他……他应该过一会就能醒过来……","status":"matched","hash_xxh64":"0x33C39E02083395F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1028426010:1":{"text":"Sir, I'd like to know more about your situation...","source_cn":"先生，我想再多了解一下你们之前遇到的状况……","status":"matched","hash_xxh64":"0x6B5A96256AAC8582","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:12:1028426011:1":{"text":"As Lyca speaks to the herbalists, Chippy uses the shadows on the wall to sneak to the side of the table.","source_cn":"","status":"matched","hash_xxh64":"0xF6C76B245353397F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1028426012:1":{"text":"Magister, look what Chippy found!","source_cn":"这是……主人，我拿回来了，你们看！","status":"matched_runtime_gender","hash_xxh64":"0x43790CD8109A0589","variant_status":"runtime_gender_keys_target_same","male":"Magister, look what Chippy found!","female":"Magister, look what Chippy found!","variant_male_record_index":"111768","variant_female_record_index":"111769","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1028426013:1":{"text":"Hey! You dirty rat! Don't touch my things!","source_cn":"——喂！肮脏的耗子！别碰我的东西！","status":"matched","hash_xxh64":"0x1A4076C5428AADCB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1028426014:1":{"text":"Is that... the letter of aid from the Harvesters?","source_cn":"这是……采集队写给村子的求助信？","status":"matched","hash_xxh64":"0xEC2757D58F9C0EF5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1028426015:1":{"text":"Why did you open the letter without permission?!","source_cn":"你们……你为什么私自把信拆开了？！","status":"matched","hash_xxh64":"0xD2FC5526D13B6AC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1028426016:0":{"text":"How did your companion truly come to faint? Answer honestly!","source_cn":"你的同伴到底是怎么昏倒的，请诚实地回答！","status":"matched","hash_xxh64":"0x1C805C1FD901565B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1028426017:1":{"text":"Hmph... I thought I could handle things, but you people certainly are persistent.","source_cn":"哼……本来还想着能应付过去的，你们这些人真是麻烦！","status":"matched","hash_xxh64":"0xB0BE7F1A1F94A03B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1028426018:1":{"text":"You'll only have yourselves to blame for poking your nose where it doesn't belong...","source_cn":"非要问那么多问题，这只能怪你们自己——","status":"matched","hash_xxh64":"0xE7A01E6088AFFADA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1028426019:1":{"text":"Enough talk!","source_cn":"多此一举！","status":"matched","hash_xxh64":"0xDE1E0A886795C10C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1028426020:1":{"text":"Oh, no! Hypofiends are closing in!","source_cn":"糟了，周围有魔物围过来了……！","status":"matched","hash_xxh64":"0x62F8F1ED3E44603C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1028426021:1":{"text":"Magister, be careful!","source_cn":"主人，小心！","status":"matched_runtime_gender","hash_xxh64":"0x7F3D026858902BF4","variant_status":"runtime_gender_keys_target_same","male":"Magister, be careful!","female":"Magister, be careful!","variant_male_record_index":"111778","variant_female_record_index":"111779","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:0:1":{"text":"Definitely not suspicious at all...","source_cn":"真是一点也不可疑呢","status":"matched_runtime_gender","hash_xxh64":"0xBA91896338E0A3FA","variant_status":"runtime_gender_keys_target_same","male":"Definitely not suspicious at all...","female":"Definitely not suspicious at all...","variant_male_record_index":"61402","variant_female_record_index":"61403","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:10:1:2":{"text":"(Hint at Chippy to investigate)","source_cn":"（暗示满满去调查）","status":"matched_runtime_gender","hash_xxh64":"0x7BF11DE254D69480","variant_status":"runtime_gender_keys_target_same","male":"(Hint at Chippy to investigate)","female":"(Hint