{"asset_key":"mn2/quest_story_10111190","episode":"mn2","category":"quest_story","story_id":"10111190","schema_version":1,"lang":"en","texts":{"say:0:1011119001:0":{"text":"That's strange. They seem to know the Dusk Patrollers' routine very well.","source_cn":"怪了，这些人怎么会对薄暮巡游队的行动时间了解得这么清楚。","status":"matched","hash_xxh64":"0xC07D2A568AC7EA00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1011119002:0":{"text":"Sparing humans but targeting the Wilders... It's a deliberate attempt to stoke conflict on both sides!","source_cn":"放过人类，却针对绿裔……这是故意挑起两边的矛盾！","status":"matched","hash_xxh64":"0x60386BB06CF72830","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1011119003:0":{"text":"Who's behind all this?! I will pierce through that scoundrel's chest!","source_cn":"谁在指使他们？！我要用枪刺穿那家伙的胸膛！","status":"matched","hash_xxh64":"0x9519150DB27FAB70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"},"speaker:科林":{"text":"Korin","source":"科林","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":2}}