{"asset_key":"mn2/quest_story_10126120","episode":"mn2","category":"quest_story","story_id":"10126120","schema_version":1,"lang":"en","texts":{"say:1:1012612001:1":{"text":"Medicinal herbs! You were able to get them so quickly!","source_cn":"是药草，你们竟然这么快就拿到了！","status":"matched","hash_xxh64":"0x408B749763344EE1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1012612002:1":{"text":"I'll brew these herbs right away.","source_cn":"我马上将药草加工一下。","status":"matched","hash_xxh64":"0xBD0FE9CFFB8E384D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:4:1012612003:0":{"text":"A short while later...","source_cn":"一段时间后……","status":"matched","hash_xxh64":"0x9FE836DB92391A38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1012612004:0":{"text":"Mama, this medicine tastes so bad... but my headache is better.","source_cn":"妈妈，这药好苦呀……但是没有刚才头痛了。","status":"matched","hash_xxh64":"0x4961DC1D4FD26FE1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1012612005:0":{"text":"You're finally feeling better...","source_cn":"好孩子，你终于没事了……","status":"matched","hash_xxh64":"0x09A50FC00CB31251","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1012612006:1":{"text":"Kelvin is already distributing medicine to everyone. Do you have time to come to Timberhide for a rest? Everyone in the village wants to express their gratitude.","source_cn":"凯尔温已经在分药给大家了，各位大人，有时间来林隐村歇歇...","status":"matched","hash_xxh64":"0xE035D6140066DA91","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1012612007:1":{"text":"By the way, Chief Ivan, among the various rumors you mentioned earlier, was there one about an injured Wilder who passed through here?","source_cn":"伊凡，你之前提到的各种传闻，有没有一个负伤的绿裔经过这里。","status":"matched","hash_xxh64":"0x5FD510F948385542","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1012612008:0":{"text":"Some people claimed to have seen <style=\"highlight\">Master Eomir</style>, but how could that be possible? They must've recognized the wrong person.","source_cn":"倒是有人说，好像看到了大贤者<style=highli...","status":"matched","hash_xxh64":"0xAE5F485BB2BE022C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1012612009:1":{"text":"What? Which direction was he going?","source_cn":"什么？伊米尔往哪走了！","status":"matched","hash_xxh64":"0xA97F46A0D710294B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1012612010:1":{"text":"I'm not sure, but there are no forks in the road near Timberhide. If you keep going, you'll reach <style=\"highlight\">Slopeville</style>.","source_cn":"这就无从得知了，但是，林隐村附近没什么岔口，一直往前走...","status":"matched","hash_xxh64":"0x06AF7F2121A437CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1012612011:1":{"text":"Okay, Slopeville. We have to act quickly. We can't let Eomir escape this time!","source_cn":"南坡村，我们得快点行动！这次无论如何都不能让伊米尔逃跑！","status":"matched","hash_xxh64":"0x303F1E51712220E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:维娜":{"text":"Vina","source":"维娜","status":"matched_dialogue_flow"},"speaker:村长伊凡":{"text":"Chief Ivan","source":"村长伊凡","status":"matched_dialogue_flow"},"speaker:（占位）":{"text":"（占位）","source":"（占位）","status":"source"},"speaker:菲菲莉":{"text":"Fifili","source":"菲菲莉","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"},"speaker:埃隆":{"text":"Eironn","source":"埃隆","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":12,"localized_text_count":11,"speaker_count":7}}