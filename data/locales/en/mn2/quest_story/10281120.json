{"asset_key":"mn2/quest_story_10281120","episode":"mn2","category":"quest_story","story_id":"10281120","schema_version":1,"lang":"en","texts":{"say:1:1028112001:1":{"text":"I'm ready to absorb the magic. ","source_cn":"我已经准备好吸收散逸的魔力了。","status":"matched","hash_xxh64":"0x508F7AC8F703F972","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1028112001":{"text":"I'm ready to absorb the magic. ","source_cn":"我已经准备好吸收散逸的魔力了。","status":"matched","hash_xxh64":"0x508F7AC8F703F972","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028112002:0":{"text":"*Growl*... *Roar!*","source_cn":"吼……吼……吼！","status":"matched","hash_xxh64":"0x5610C76A2D206156","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1028112003:0":{"text":"Sorry... did I disturb you? ","source_cn":"对不起……我打扰到你了？","status":"matched","hash_xxh64":"0x401DA76D403ABA8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1028112004:0":{"text":"You're hurt... Mr. Bear, I can heal you... Come closer and let me take a look...","source_cn":"……咦，你受伤了……熊先生，可以让我来治疗吗？我，能不...","status":"matched","hash_xxh64":"0x06E19A95E7CBEC49","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1028112005:1":{"text":"*Growl*...","source_cn":"吼……","status":"matched","hash_xxh64":"0x6C43CCAC1E8149C3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1028112006:0":{"text":"Your wounds are bad... they must be so painful... I'm going to help you. You might get a little wet from the rain, but don't worry... it'll help. ","source_cn":"伤得好重，一定很难受吧……我要治疗了，可能会让你淋一点...","status":"matched","hash_xxh64":"0x0B4AF1BB6EEC776B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1028112007:0":{"text":"Don't worry, it'll be better in a moment... Look! It's healing already! ","source_cn":"别着急，马上就好……瞧，已经开始愈合了！","status":"matched","hash_xxh64":"0xD990965176CF9AA9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1028112008:0":{"text":"*Growl*... *Nuzzle*...","source_cn":"吼……咕……","status":"matched","hash_xxh64":"0x07FE7EB7F6E217BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1028112009:0":{"text":"This honey...? Is it all for me? ","source_cn":"这些蜂蜜是……？都是给我的吗？","status":"matched","hash_xxh64":"0xE6C0F9FB9E0C35FE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1028112010:0":{"text":"That's sweet! Thank you, Mr. Bear! ","source_cn":"……真甜！谢谢你，熊先生！","status":"matched","hash_xxh64":"0x8ABE54886EC21B8C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1028112011:0":{"text":"I'm Hewynn, by the way. Do you have a name? ","source_cn":"对了，我叫伊温，你有名字吗？","status":"matched","hash_xxh64":"0x72F4377E4260BA32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1028112012:1":{"text":"*Growl*... *Grunt*... ","source_cn":"吼……呼？","status":"matched","hash_xxh64":"0x5C877C41A5AF8828","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1028112013:0":{"text":"You don't have a name? What if I call you \"Softpaw\", our big friend of the forest!","source_cn":"没有名字啊……那我叫你“伊尔贡”好不好？伊尔贡，丛林里...","status":"matched","hash_xxh64":"0x33E8E32798C10161","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1028112014:1":{"text":"*Tongue click!*","source_cn":"咕噜！","status":"matched","hash_xxh64":"0x1C9F004F6E69CFE6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1028112015:0":{"text":"Is this for me, too? What a beautiful leaf! Thank you, Softpaw! ","source_cn":"这也是送给我的吗？好漂亮的叶子……谢谢，伊尔贡！","status":"matched","hash_xxh64":"0x2DE5F8FB5C26DACB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1028112016:0":{"text":"We're friends now, right..? ","source_cn":"我们……是朋友了，对吧？我们是朋友了！","status":"matched","hash_xxh64":"0xB069F6142468A980","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1028112017:1":{"text":"*Grunt*... *Tongue click*","source_cn":"咕噜……吼……咕噜……","status":"matched","hash_xxh64":"0xB18013894A5BDCE4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1028112018:0":{"text":"You want me to rub your belly? Ha! So fluffy! ","source_cn":"你想……让我摸摸你？哈，毛绒绒的，好可爱……","status":"matched","hash_xxh64":"0xD7F1CF50A03C862E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1028112019:0":{"text":"It's over? At least no monsters came...","source_cn":"……咦，结束了？这次很顺利嘛，没有魔物来侵扰——","status":"matched","hash_xxh64":"0x8E3CF602A380379B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1028112020:2":{"text":"*Roar!*","source_cn":"吼……噢噢！","status":"matched","hash_xxh64":"0x81B46411A3CAD671","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:27:1028112020":{"text":"*Roar!*","source_cn":"吼……噢噢！","status":"matched","hash_xxh64":"0x81B46411A3CAD671","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1028112021:0":{"text":"Don't blame this on Chippy! ","source_cn":"满满就是随便说说……这、这可不能怪满满呀！","status":"matched","hash_xxh64":"0xDD964CBEA71F4263","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1028112022:0":{"text":"Have no fear, Hewynn! We'll protect you! ","source_cn":"伊温小姐，不要担心，我们会保护你的！","status":"matched","hash_xxh64":"0xFA93C92630D7A7A2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:27:0:1":{"text":"Prepare to fight! ","source_cn":"准备战斗！","status":"matched_runtime_gender","hash_xxh64":"0xDF786CE1E9B2FEF9","variant_status":"runtime_gender_keys_target_same","male":"Prepare to fight! ","female":"Prepare to fight! ","variant_male_record_index":"61192","variant_female_record_index":"61193","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:27:1:2":{"text":"Chippy, you're a seer!","source_cn":"满满，你去当预言家吧","status":"matched_runtime_gender","hash_xxh64":"0x5C207AA921BEADB9","variant_status":"run