{"asset_key":"mn2/quest_story_10281180","episode":"mn2","category":"quest_story","story_id":"10281180","schema_version":1,"lang":"en","texts":{"say:2:1028118001:0":{"text":"Hewynn, why won't you answer me?!","source_cn":"伊温，你为什么不回答我？！","status":"matched","hash_xxh64":"0x228C472D8FAB9E22","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1028118002:0":{"text":"Florabelle? ","source_cn":"芙拉贝尔？","status":"matched","hash_xxh64":"0x125174165CD7D3E8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028118003:0":{"text":"Even without your answer, I know you don't have the courage to journey to Lovers' Wish! You're a coward! ","source_cn":"不用你回答我也知道，你没有胆量踏出情人之愿，对不对？因...","status":"matched","hash_xxh64":"0xCFC7C6A84EB120BD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028118004:0":{"text":"Your cowardice made you lose Softpaw, keeps you from Lovers' Wish, and is hurting the people of Taran. ","source_cn":"就是因为懦弱，你才会一直失去，伊尔贡，情人之愿的风景，...","status":"matched","hash_xxh64":"0x8971E8E329A49034","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1028118005:0":{"text":"Florabelle... w-what's wrong with you? You're not well... ","source_cn":"芙拉贝尔……你、你怎么了？你不舒服吗？","status":"matched","hash_xxh64":"0xB3BD3EFCC2133880","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1028118006:0":{"text":"You're too weak! One day, you'll lose everything!","source_cn":"你太弱小了，总有一天你会因此失去一切，无法挽回！","status":"matched","hash_xxh64":"0x992B2614C43DF4B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1028118007:1":{"text":"No... Florabelle...","source_cn":"不、不是的……芙拉贝尔……","status":"matched","hash_xxh64":"0x0FA8865C2683B7BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1028118008:0":{"text":"Magister, Hewynn's memory... there's something wrong. Florabelle isn't an evil person! ","source_cn":"主人，伊温小姐的回忆……是不是哪里出错了？芙拉贝尔明明...","status":"matched_runtime_gender","hash_xxh64":"0x2ABB9C081AD48CB0","variant_status":"runtime_gender_keys_target_same","male":"Magister, Hewynn's memory... there's something wrong. Florabelle isn't an evil person! ","female":"Magister, Hewynn's memory... there's something wrong. Florabelle isn't an evil person! ","variant_male_record_index":"110817","variant_female_record_index":"110818","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1028118009:0":{"text":"Is this a real memory? ","source_cn":"那是真实的记忆吗？","status":"matched","hash_xxh64":"0x952E50E231EEBEA1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},