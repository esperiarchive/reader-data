{"asset_key":"mn2/quest_story_10282270","episode":"mn2","category":"quest_story","story_id":"10282270","schema_version":1,"lang":"en","texts":{"say:3:1028227001:1":{"text":"I-I'm fine now, thanks. ","source_cn":"我……我没事了，谢谢。","status":"matched","hash_xxh64":"0xD5FA928785ECBD6F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028227002:1":{"text":"It's just such a shame... they were all so pretty...","source_cn":"我只是觉得很可惜，它们曾经那么美丽……","status":"matched","hash_xxh64":"0xA20F6A906BDED3FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028227003:1":{"text":"Don't be sad, Randy. Misarte will return all these flowers to forests and mountains nearby! ","source_cn":"不要难过了，兰迪。你瞧，弥萨忒会让这些花回归山林的！","status":"matched","hash_xxh64":"0x2C48D094B96D975F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1028227004:1":{"text":"There will be new plants and flowers growing here again one day!","source_cn":"这里也总有一天，会再长出新的花草！","status":"matched","hash_xxh64":"0x90FA9AF6F48ACBF2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1028227005:1":{"text":"Thank you all. I-I'd like to go back to the academy now. ","source_cn":"嗯……谢谢你们。我、我想回学院了……","status":"matched","hash_xxh64":"0xBB92BDB2C0BA4995","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1028227006:1":{"text":"Great! Finally... Chippy and I will go ahead and make sure the way is clear of danger. ","source_cn":"太好了！总算……我和满满先走一步，保证路上没有危险！","status":"matched_runtime_gender","hash_xxh64":"0x653BC6BF014535A8","variant_status":"runtime_gender_keys_target_same","male":"Great! Finally... Chippy and I will go ahead and make sure the way is clear of danger. ","female":"Great! Finally... Chippy and I will go ahead and make sure the way is clear of danger. ","variant_male_record_index":"111082","variant_female_record_index":"111083","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1028227007:1":{"text":"Magister, please watch over him! ","source_cn":"主人，就麻烦你陪着他啦！","status":"matched_runtime_gender","hash_xxh64":"0xDD7D61DFC827E977","variant_status":"runtime_gender_keys_target_same","male":"Magister, please watch over him! ","female":"Magister, please watch over him! ","variant_male_record_index":"111084","variant_female_record_index":"111085","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:兰迪":{"text":"Randy","source":"兰迪","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":3}}