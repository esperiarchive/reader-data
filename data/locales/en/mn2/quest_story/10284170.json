{"asset_key":"mn2/quest_story_10284170","episode":"mn2","category":"quest_story","story_id":"10284170","schema_version":1,"lang":"en","texts":{"say:1:1028417001:1":{"text":"It's you again... what is it now? I have no energy, so please don't try and put me up to anything.","source_cn":"又是你们……还有什么事吗？先说好，我真的没力气，别让我...","status":"matched","hash_xxh64":"0xC9DB68EA1CA01CBB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1028417002:1":{"text":"Please try these herbs, they should help you regain some strength.","source_cn":"请试试这些草药，应该可以让你恢复一些气力。","status":"matched","hash_xxh64":"0x8BA76C841B7CBBC4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1028417003:1":{"text":"Can you really heal us? Blessed Misarte, I hope this works!","source_cn":"你们能治疗我们身上的病？弥萨忒保佑，希望有效果。","status":"matched","hash_xxh64":"0xFA424F46A4BBAD74","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028417004:1":{"text":"The flavor is a bit odd...","source_cn":"味道有点怪怪的……","status":"matched","hash_xxh64":"0x16D18A1AEE9FC4ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028417005:1":{"text":"I feel so light and relaxed! I can even hold my axe again!","source_cn":"……感觉身上轻松了，也能拿动斧子了……","status":"matched","hash_xxh64":"0xF382ED2064E7358A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1028417006:1":{"text":"Thank you! Misarte herself must have sent you!","source_cn":"谢谢你们！你们一定是弥萨忒派来的使者！","status":"matched","hash_xxh64":"0x7EF8428A246FAD83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1028417007:1":{"text":"...Maybe not Misarte, but if it works, it works!","source_cn":"……也不一定是弥萨忒，不过，有用就好！","status":"matched","hash_xxh64":"0xC196C87B7033B3FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:采集队员沃尔森":{"text":"Harvester Walson","source":"采集队员沃尔森","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":3}}