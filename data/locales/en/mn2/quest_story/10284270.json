{"asset_key":"mn2/quest_story_10284270","episode":"mn2","category":"quest_story","story_id":"10284270","schema_version":1,"lang":"en","texts":{"say:1:1028427001:0":{"text":"So you've shown your true colors... you're not an herbalist at all!","source_cn":"好呀，原来这才是你的真面目，你根本不是植物学家！","status":"matched","hash_xxh64":"0x23C01C5DAC81977A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1028427002:0":{"text":"You crook!","source_cn":"——坏人！","status":"matched","hash_xxh64":"0x135E55DF75DB5A1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028427003:0":{"text":"It's high time you came clean.","source_cn":"先生，你现在可以说实话了吧！","status":"matched","hash_xxh64":"0xF4EDBB726B08ADD5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028427004:0":{"text":"I... I'm with the Adamant Syndicate. Look, here's an antidote to wake the herbalist.","source_cn":"我、我是黑金商会的……别动手，给，这是能让那个植物学家...","status":"matched","hash_xxh64":"0xF023DB791FAEA892","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1028427005:0":{"text":"I took away his child and forced him to work for me.","source_cn":"我带走了他的孩子，胁迫他和我合作……","status":"matched","hash_xxh64":"0x942396AD8643E716","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:7:1028427005":{"text":"I took away his child and forced him to work for me.","source_cn":"我带走了他的孩子，胁迫他和我合作……","status":"matched","hash_xxh64":"0x942396AD8643E716","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1028427006:0":{"text":"I've kept her locked up... don't hit me! I'll tell you where she is!","source_cn":"我把他的孩子关起来了……我会把地方告诉你们！别、别打！","status":"matched","hash_xxh64":"0x43C0052AC5875C92","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1028427007:0":{"text":"What exactly are you doing here?!","source_cn":"你们到底在这里做什么？！","status":"matched","hash_xxh64":"0xEEEEFD55366C34C5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1028427008:0":{"text":"Well, researching and experimenting with... corruption.","source_cn":"做、做研究……腐化的研究……","status":"matched","hash_xxh64":"0xE96396D7236B900B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:11:1028427008":{"text":"Well, researching and experimenting with... corruption.","source_cn":"做、做研究……腐化的研究……","status":"matched","hash_xxh64":"0xE96396D7236B900B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1028427009:0":{"text":"Yes, it was me. Who would've thought such a remote forest would see so many people...","source_cn":"是我，谁知道那么偏僻的地方，突然来了一队人……","status":"matched","hash_xxh64":"0x9E2C836A0D58A1B9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1028427013:0":{"text":"We can't let him go! Magister, let's just...","source_cn":"不行！不能放过他！主人，我们干脆把他——","status":"matched_runtime_gender","hash_xxh64":"0x6B48E85425A25379","variant_status":"runtime_gender_keys_target_same","male":"We can't let him go! Magister, let's just...","female":"We can't let him go! Magister, let's just...","variant_male_record_index":"111792","variant_female_record_index":"111793","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1028427014:0":{"text":"Huh? No, don't! I've already told you everything! Help! Please!","source_cn":"哎？别……别别……我、我都说了，都说了啊！救命！求求你！","status":"matched","hash_xxh64":"0x8EFBCB35958C0E7B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1028427015:0":{"text":"Tie him up! We'll have a patrol team take him away!","source_cn":"——把他绑起来！叫巡游队把他带走！","status":"matched","hash_xxh64":"0xD943611C04229F34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1028427016:0":{"text":"Hmph! Chippy is furious!","source_cn":"哼！气死满满了！","status":"matched","hash_xxh64":"0x9460F10A82F40B60","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1028427017:1":{"text":"Oh, he'll get what he deserves. Let's wake up the real herbalist.","source_cn":"巡游队会给他应有的待遇，我们先把那位真正的植物学家救醒吧。","status":"matched","hash_xxh64":"0xC2769C0FCB4DD553","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:0:1":{"text":"The corruption is your doing?","source_cn":"林场的腐化是你做的吧","status":"matched_runtime_gender","hash_xxh64":"0xCBF65DF1DE8A1F7E","variant_status":"runtime_gender_keys_target_same","male":"The corruption is your doing?","female":"The corruption is your doing?","variant_male_record_index":"61410","variant_female_record_index":"61411","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1028427010:0":{"text":"Well, besides studying how the forest would be corrupted, naturally we had to see how other local organisms would respond to corruption.","source_cn":"研究嘛，除了研究森林腐化，当然也要研究当地生物被腐化侵...","status":"matched","hash_xxh64":"0xA15EFECF9603FEFC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1028427011:0":{"text":"The Harvesters just so happened to arrive and... well, their ailments weren't too severe...","source_cn":"这不刚好那些采集队来了……而且，事实上也没有造成很严重...","status":"matched","hash_xxh64":"0x8FFE371EF57D2DFB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1028427012:0":{"text":"You! You're a monster!","source_cn":"你！你简直毫无人性！","status":"matched","hash_xxh64":"0xDD558D694BC1F215","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:11:1:2":{"text":"What about the illness of the Harvesters?","source_cn":"采集队的病情……","status":"matched_runtime_gender","hash_xxh64":"0x327E3E0C3560C2C5","variant_status":"runtime_gender_keys_target_same","male":"What about the illness of the Harvesters?","female":"What about the illness of the Harvesters?","variant_male_record_index":"61412","variant_female_record_index":"61413","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:0:1":{"text":"Where is his child?","source_cn":"说，他的孩子在哪里？","status":"matched_runtime_gender","hash_xxh64":"0xC61B741B5A11497A","variant_status":"runtime_gender_keys_target_same","male":"Where is his child?","female":"Where is his child?","variant_male_record_index":"61406","variant_female_record_index":"61407","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:7:1:2":{"text":"You used a child as collateral?!","source_cn":"竟然用小孩子做威胁！","status":"matched_runtime_gender","hash_xxh64":"0x453F54665505612F","variant_status":"runtime_gender_keys_target_same","male":"You used a child as collateral?!","female":"You used a child as collateral?!","variant_male_record_index":"61408","variant_female_record_index":"61409","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:“黑金学者”瓦西里":{"text":"Scholar Vasil","source":"“黑金学者”瓦西里","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":24,"localized_text_count":23,"speaker_count":4}}