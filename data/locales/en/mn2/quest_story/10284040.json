{"asset_key":"mn2/quest_story_10284040","episode":"mn2","category":"quest_story","story_id":"10284040","schema_version":1,"lang":"en","texts":{"say:1:1028404001:1":{"text":"The Harvesters should be nearby... Wait, where did all the trees go?!","source_cn":"采集队应该就在这附近吧。咦？这里的树呢……怎么全没了？！","status":"matched","hash_xxh64":"0xB16AF2782A734188","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1028404002:1":{"text":"This just isn't right. How could they have felled every last tree?","source_cn":"这……不对，他们怎么会把所有的树都砍伐了呢？","status":"matched","hash_xxh64":"0xEB68EFF6649C5FF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:3:1028404002":{"text":"This just isn't right. How could they have felled every last tree?","source_cn":"这……不对，他们怎么会把所有的树都砍伐了呢？","status":"matched","hash_xxh64":"0xEB68EFF6649C5FF1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028404003:1":{"text":"<style=\"stress\"><player_name></style> is right! the Wilders have always respected nature. They would never chop down any trees that hadn't matured!","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x1E4934AE6991F2C0","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style> is right! the Wilders have always respected nature. They would never chop down any trees that hadn't matured!","female":"<style=\"stress\"><player_name></style> is right! the Wilders have always respected nature. They would never chop down any trees that hadn't matured!","variant_male_record_index":"111626","variant_female_record_index":"111627","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1028404006:1":{"text":"All the lumber is piled up over here, but the Harvesters are nowhere to be found...","source_cn":"采集队砍下来的木材堆在这里，人却不见了……","status":"matched","hash_xxh64":"0x8CA2E8A3FC51F398","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1028404007:1":{"text":"What happened here?","source_cn":"这里到底发生了什么？","status":"matched","hash_xxh64":"0xC49B3D973F06CBEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1028404008:1":{"text":"Magister, let's investigate the area!","source_cn":"主人，我们在周围调查一下看看吧！","status":"matched_runtime_gender","hash_xxh64":"0xD5E142709CAF5CD0","variant_status":"runtime_gender_keys_target_same","male":"Magister, let's investigate the area!","female":"Magister, let's investigate the area!","variant_male_record_index":"111632","variant_female_record_index":"111633","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:3:0:1":{"text":"Definitely not Wilder behavior.","source_cn":"这不像绿裔的作风","status":"matched_runtime_gender","hash_xxh64":"0x45887498CCEDBA27","variant_status":"runtime_gender_keys_target_same","male":"Definitely not Wilder behavior.","female":"Definitely not Wilder behavior.","variant_male_record_index":"61362","variant_female_record_index":"61363","document_title":"","document_title_male":"","document_title_fe