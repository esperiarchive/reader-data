{"asset_key":"mn2/quest_story_10281080","episode":"mn2","category":"quest_story","story_id":"10281080","schema_version":1,"lang":"en","texts":{"say:2:1028108001:0":{"text":"The Hypofiends are gone! Hewynn, can you keep going? Was the ritual ruined?","source_cn":"魔物解决啦！伊温小姐，你还能继续吸收魔力吗，不会因为中...","status":"matched","hash_xxh64":"0xB9031066F1723AEA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1028108002:0":{"text":"It's fine...","source_cn":"嗯，没关系……","status":"matched","hash_xxh64":"0xB1A9C9A8BB67C7FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028108003:0":{"text":"<style=\"stress\"><player_name></style>, please...","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0xD2583D3EF16A6D60","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, please...","female":"<style=\"stress\"><player_name></style>, please...","variant_male_record_index":"112257","variant_female_record_index":"112258","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1028108003":{"text":"<style=\"stress\"><player_name></style>, please...","source_cn":"<style=stress><player_name></style>，麻烦你了……","status":"matched_runtime_gender","hash_xxh64":"0xD2583D3EF16A6D60","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, please...","female":"<style=\"stress\"><player_name></style>, please...","variant_male_record_index":"112257","variant_female_record_index":"112258","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1028108004:0":{"text":"What's the matter, child? You look so sad. ","source_cn":"怎么啦，孩子？你看起来很难过。","status":"matched","hash_xxh64":"0x3680E11BD2E45CAD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1028108005:0":{"text":"Who... who are you? ","source_cn":"是……是谁？","status":"matched","hash_xxh64":"0xD6291A195EFDA718","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1028108006:0":{"text":"Don't be afraid, child. What is the matter? Has someone been unkind to you? ","source_cn":"孩子，别害怕。你怎么了，有谁欺负你了吗？","status":"matched","hash_xxh64":"0xEABA4F3EF0FC54A7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1028108007:0":{"text":"Unkind, no... I'm not...","source_cn":"没有欺负……我、我不是……","status":"matched","hash_xxh64":"0x41A8C0AF9AD2E583","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1028108008:0":{"text":"You look ever so sad. Do not suffer in silence, dear. Speak up if something is troubling you. ","source_cn":"你看着伤心得很，唉，是不是受了什么委屈。孩子，要是心里...","status":"matched","hash_xxh64":"0x52273CC25F0C207A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1028108009:0":{"text":"I... I...","source_cn":"我……我……","status":"matched","hash_xxh64":"0xCD3B1462D53D41FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1028108010:0":{"text":"If you don't wish to speak, just cry, and you'll feel better. ","source_cn":"你要是不想说呀，那就大哭上一场，哭出来就能好。","status":"matched","hash_xxh64":"0x58BE0FF1A0CA3C85","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1028108011:0":{"text":"I'm afraid...","source_cn":"我怕……","status":"matched","hash_xxh64":"0x464913F6C9A1C2E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1028108012:0":{"text":"No, no, dear, don't be afraid to cry. Who can say they never have? Even at my age, I still cry sometimes. What's wrong with that? ","source_cn":"不怕、不怕，哭就哭了，谁还没哭过？哪怕长到我这么大岁数...","status":"matched","hash_xxh64":"0x40950B4DBD810AF7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1028108013:0":{"text":"I... *Cry*...","source_cn":"我……呜、呜呜……呜呜……","status":"matched","hash_xxh64":"0xAE5AB92BCE14F73E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:23:1028108014:0":{"text":"Hewynn cried as tears streaked down her face. Magical raindrops started falling from the sky.","source_cn":"伊温哭泣出声，她的泪水划过脸庞，天空中的雨滴也魔法般地落下。","status":"matched","hash_xxh64":"0xE3105320AC3BFECB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1028108015:2":{"text":"It's raining. Let's go back to the house. You shouldn't get wet. ","source_cn":"下雨了，我们先回屋，你不能淋雨的。","status":"matched","hash_xxh64":"0x31DA1CF3BEA98ED5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:27:1028108016:0":{"text":"Wait, dear... the rain seems so warm and soft... it seems to be lending me strength. ","source_cn":"等等……亲爱的，这雨淋在身上很舒服，很温暖……我好像有...","status":"matched","hash_xxh64":"0xF20F96704DF6E006","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1028108017:0":{"text":"Your cheeks are a bit rosier. Are you feeling better? Let me see... your hands are not so cold anymore!","source_cn":"你的脸色红润了些，真的好点了吗？让我看看……你、你的手...","status":"matched","hash_xxh64":"0x305092F3EAE966BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1028108018:0":{"text":"It must have been Misarte who heard your cries. This wonderful rain... it must have come from the gods above!","source_cn":"一定是弥萨忒听到了我们的祈求。太好了，这雨……这雨一定...","status":"matched","hash_xxh64":"0x99DF011CECCDB7AC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1028108019:0":{"text":"...Is this the power I unleashed? This divine rain...","source_cn":"……这是，我释放出的力量吗？这些雨水……","status":"matched","hash_xxh64":"0x5183E060034FD12A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1028108020:0":{"text":"Does it require emotional resonance to awaken this... power of healing? ","source_cn":"是需要情绪共鸣才能唤醒的……“治愈”的力量吗……？","status":"matched","hash_xxh64":"0x33843A081022EDDC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:5:0:1":{"text":"(Reactivate the Memory Fragment)","source_cn":"重新激活记忆碎片","status":"matched_runtime_gender","hash_xxh64":"0x41997E9D36BBC828","variant_status":"runtime_gender_keys_target_same","male":"(Reactivate the Memory Fragment)","female":"(Reactivate the Memory Fragment)","variant_male_record_index":"61652","variant_female_record_index":"61653","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"},"speaker:伊温":{"text":"Hewynn","source":"伊温","status":"matched_dialogue_flow"},"speaker:回忆中的老婆婆":{"text":"Old Woman","source":"回忆中的老婆婆","status":"matched_dialogue_flow"},"speaker:回忆中的伊温":{"text":"Hewynn","source":"回忆中的伊温","status":"matched_dialogue_flow"},"speaker:黑屏":{"text":"Black Screen","source":"黑屏","status":"matched_di