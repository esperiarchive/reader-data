{"asset_key":"mn2/quest_story_10281190","episode":"mn2","category":"quest_story","story_id":"10281190","schema_version":1,"lang":"en","texts":{"say:2:1028119001:0":{"text":"You're right... I'm not afraid of these Hypofiends or their foul tricks. ","source_cn":"你们说得对。这些魔物，污染，和扭曲的回忆……我不该害怕它们。","status":"matched","hash_xxh64":"0xE138351285E94B63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1028119002:0":{"text":"The corruption here has been cleansed by our many companions. I can't save everyone by myself, but I will do the best I can.","source_cn":"这里的腐化已经被很多很多的同伴一起清除了。我无法一个人...","status":"matched","hash_xxh64":"0x44D697D15A71BCB5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1028119003:0":{"text":"Water is the power of life and convergence... Droplets gather together to form a river of hope.","source_cn":"水是生命和汇聚的力量。许多的水滴聚在一起，才是希望的河流。","status":"matched","hash_xxh64":"0x9D14351FEE7DAAD1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1028119004:0":{"text":"Alone, I'm weak, but as we gather together, we are strong! ","source_cn":"我是很弱小，可和这里的每一个人汇聚在一起，我们就会很强大！","status":"matched","hash_xxh64":"0x0D5C507DCC00B64B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1028119005:0":{"text":"Hewynn... are you alright? ","source_cn":"伊温小姐，你……没事了？","status":"matched","hash_xxh64":"0xDE31A7391845EE5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1028119006:0":{"text":"Thank you for keeping the Hypofiends at bay. ","source_cn":"嗯……谢谢你们阻拦这些魔物。","status":"matched","hash_xxh64":"0x4ED21CE12D7C7D83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1028119007:0":{"text":"Although I'm not at my full strength, please let me stand beside you and fight! ","source_cn":"虽然我的力量还没有完全恢复，但请让我和你们一起战斗吧！","status":"matched","hash_xxh64":"0xB8CFFD9F520D06C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1028119008:0":{"text":"There's only one Hypofiend left! Hewynn, let's finish this together! ","source_cn":"只剩最后一只魔物了！伊温小姐，我们一起干掉它！","status":"matched","hash_xxh64":"0x6CDD12160E00FD5F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:伊温":{"text":"Hewynn","source":"伊温","status":"matched_dialogue_flow"},"speaker:满满":{"text":"Chippy","source":"满满","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":2}}