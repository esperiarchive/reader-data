{"asset_key":"mn2/quest_story_10123010","episode":"mn2","category":"quest_story","story_id":"10123010","schema_version":1,"lang":"en","texts":{"say:0:1012301001:0":{"text":"I've never seen a beautiful creature like that.","source_cn":"刚才那美丽的生物是什么？我从未见过。","status":"matched","hash_xxh64":"0x7936DAB3EA61AAEB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1012301002:0":{"text":"Uh... did you not see how its head split into three?","source_cn":"呃……你是不是没看见它裂成三瓣的脑袋？","status":"matched","hash_xxh64":"0x8A0E76446269E205","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1012301003:0":{"text":"No, I saw it. It's as beautiful as a blooming flower.","source_cn":"看见了，像盛开的花朵一样美丽。","status":"matched","hash_xxh64":"0xCBA6402EC661760D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1012301004:0":{"text":"Our opinions on what constitutes beauty are very different...","source_cn":"好吧……反正我们的审美从来都天差地别。","status":"matched","hash_xxh64":"0x1894EBECC875D3BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:洛桑":{"text":"Lorsan","source":"洛桑","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}