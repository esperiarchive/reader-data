{"asset_key":"mn2/quest_story_10127010","episode":"mn2","category":"quest_story","story_id":"10127010","schema_version":1,"lang":"en","texts":{"say:2:1012701001:0":{"text":"Give yourself up, Eomir!","source_cn":"伊米尔，束手就擒吧！","status":"matched","hash_xxh64":"0x0B450ECFFFE85AFE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1012701002:0":{"text":"Silence! I am the only one who is fit to lead the Dark Forest! Who are you to talk to me this way?!","source_cn":"住口！我才是有资格号令薄暮丛林的人！而你算什么东西……...","status":"matched","hash_xxh64":"0x79AE45345E7730D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1012701003:0":{"text":"My only crime was being born at the wrong time. It is you who do not deserve to lead! As long as I have the power of the Dark Forest... <style=\"highlight\">I will live forever</style>!","source_cn":"我生不逢时……才让你钻了空子！然而只要拥有薄暮丛林的力...","status":"matched","hash_xxh64":"0xADEAAD52F4CDBF9D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1012701004:0":{"text":"The life force of the forest does not belong to you! All the leaves will eventually wither! Face your fate!","source_cn":"丛林的生命力不属于你，所有的叶子终将枯萎，面对你的命运吧！","status":"matched","hash_xxh64":"0xEDA8BFC701551352","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1012701005:0":{"text":"Hold your tongue! Dahnie and Arden are destined to perish and fall to the earth! But I will not!","source_cn":"闭上你的嘴！烂在土里是达赫妮跟雅顿的命运！不是我！","status":"matched","hash_xxh64":"0x028DA4F28DFA5DA0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1012701006:0":{"text":"You are a goat-kissing fool, Eomir!","source_cn":"你简直是一颗彻头彻尾的臭豆子！伊米尔！","status":"matched","hash_xxh64":"0xBC1E17C7546DF4BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1012701007:0":{"text":"Granny Dahnie?!","source_cn":"达赫妮婆婆？！","status":"matched","hash_xxh64":"0x1F334BFB9DFFE3E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1012701008:0":{"text":"*Laugh*... It seems like we old-timers have finally caught up!","source_cn":"噢呵呵……看来我们这两把老骨头赶上了。","status":"matched","hash_xxh64":"0x435461BA36A8448F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1012701009:0":{"text":"Master Arden!","source_cn":"雅顿老师！","status":"matched","hash_xxh64":"0x23EDCCC26A8BDB6E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1012701010:0":{"text":"Speak for yourself, Arden! I'm still a spring chick