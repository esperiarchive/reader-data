{"asset_key":"mn3/env_story_10357220","episode":"mn3","category":"env_story","story_id":"10357220","schema_version":1,"lang":"en","texts":{"say:1:1035722001:1":{"text":"Boss says we're returning to the Ashen Wastes, but I just wanna stand guard here.","source_cn":"老大说要回荒角沙漠去了，但我还想继续守在这里。","status":"matched","hash_xxh64":"0x6F2893FB231D5729","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1035722002:1":{"text":"I'd rather spend my days peacefully in front of this door than go back to wandering.","source_cn":"在这里安安定定地过了一段日子，也不想再四处漂泊了。","status":"matched","hash_xxh64":"0x99D8865BAE41D2F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1035722003:1":{"text":"That way, my guys will always have a place to return to.","source_cn":"以后弟兄们要是回来，还能有个去处。","status":"matched","hash_xxh64":"0xB44452829F3C3BA2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1035722004:1":{"text":"Who knows, I might even become the boss of this place! Haha!","source_cn":"到时候我就算是这里的老大了吧，哈哈！","status":"matched","hash_xxh64":"0xB3DF86BED64049C8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:盗宝贼维梅":{"text":"Thief Vemay","source":"盗宝贼维梅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}