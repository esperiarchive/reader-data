{"asset_key":"mn3/env_story_10357260","episode":"mn3","category":"env_story","story_id":"10357260","schema_version":1,"lang":"en","texts":{"say:1:1035726001:0":{"text":"I'm following the boss back to the Ashen Wastes.","source_cn":"我打算跟着老大一起去荒角沙漠。","status":"matched","hash_xxh64":"0x56E55AF2E25127FF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1035726002:1":{"text":"My place is on the road at our strong leader's side.","source_cn":"想在道上混得好，还得跟个厉害的老大。","status":"matched","hash_xxh64":"0x5FA593741233B15A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1035726003:1":{"text":"As much as he enjoys a good scrap, the boss treats us pretty well.","source_cn":"老大除了爱打人以外，对兄弟们还算不错。","status":"matched","hash_xxh64":"0x420F45FFD5771FBA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1035726004:1":{"text":"Sticking with him should be a good time.","source_cn":"跟着老大肯定不会吃亏的。","status":"matched","hash_xxh64":"0x5A4E1A3EC7D4B2D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:盗宝贼哈尔比":{"text":"Thief Halbert","source":"盗宝贼哈尔比","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}