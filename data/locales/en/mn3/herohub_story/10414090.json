{"asset_key":"mn3/herohub_story_10414090","episode":"mn3","category":"herohub_story","story_id":"10414090","schema_version":1,"lang":"en","texts":{"say:2:1041409001:1":{"text":"Hammie, do you have a favorite gem? Take whichever you like.","source_cn":"漫漫，有喜欢的宝石吗？喜欢哪颗就拿走吧。","status":"matched","hash_xxh64":"0x63F3FBC00D901919","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1041409002:1":{"text":"Ah, no, Fay! These are much too precious!","source_cn":"不行啊，菲，这些太珍贵了！","status":"matched","hash_xxh64":"0x527D0C65A1484C1C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041409003:1":{"text":"Friendship is more precious than gems, Hammie.","source_cn":"友情要比宝石更珍贵啊，漫漫。","status":"matched","hash_xxh64":"0xE0D3033A6CEF1F37","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041409004:1":{"text":"Besides, you can find these gems anywhere. No need to be shy!","source_cn":"而且这些宝石随便就能找到的，不用客气……","status":"matched","hash_xxh64":"0x2EBC775E1DCBB45D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:菲":{"text":"Fay","source":"菲","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"Hammie","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}