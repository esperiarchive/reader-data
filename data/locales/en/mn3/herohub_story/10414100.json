{"asset_key":"mn3/herohub_story_10414100","episode":"mn3","category":"herohub_story","story_id":"10414100","schema_version":1,"lang":"en","texts":{"say:2:1041410001:1":{"text":"I didn't expect you to be so quick with your hands...","source_cn":"没想到，你身手居然这么快……","status":"matched","hash_xxh64":"0xFB8123FE2F074DE2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1041410002:1":{"text":"I've revised my opinion about knights.","source_cn":"我对骑士改观了。","status":"matched","hash_xxh64":"0xADB9D74D6795EE89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1041410003:1":{"text":"Do you have some prejudice against knights? You think we're all slow fools in armor?","source_cn":"你对骑士有什么偏见？穿着铠甲的迟钝笨蛋吗？","status":"matched","hash_xxh64":"0x349E3BEEA1B69901","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1041410004:1":{"text":"I thought knights always relied on horses and couldn't do anything without them.","source_cn":"我以为骑士们都要靠骑马呢。","status":"matched","hash_xxh64":"0xE55CD1F914DF515D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1041410005:1":{"text":"Seems like that's not the case for you. Aha, you're surprisingly reliable!","source_cn":"看起来穷光蛋只能靠自己，天下皆同啊。","status":"matched","hash_xxh64":"0x60608F3B666CF518","variant_status":"","male":"","fem