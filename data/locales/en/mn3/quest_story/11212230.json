{"asset_key":"mn3/quest_story_11212230","episode":"mn3","category":"quest_story","story_id":"11212230","schema_version":1,"lang":"en","texts":{"say:1:1121223001:0":{"text":"Please, speak... I need answers.","source_cn":"说吧……我非常需要答案。","status":"matched","hash_xxh64":"0xDF1EB27C63C49705","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1121223002:0":{"text":"Actually, we brought something for you.","source_cn":"别着急。在那之前，有个东西，需要你确认。","status":"matched","hash_xxh64":"0xC76D3ADB1A3FA7BE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1121223003:1":{"text":"Recognize this?","source_cn":"你认得这是什么吗？","status":"matched","hash_xxh64":"0x0B250D04FC195B08","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"picture:3::2":{"text":"Stone Carving","source_cn":"小鸟雕像","status":"matched","hash_xxh64":"0xDB6A6A6FA6C2784A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1121223004:0":{"text":"This is... Why... I don't understand...","source_cn":"这是……\\n为什么……我不理解……","status":"matched","hash_xxh64":"0xE3584E5191096523","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1121223005:0":{"text":"Is it yours?","source_cn":"这是不是你的东西？","status":"matched","hash_xxh64":"0xB22389E2BD8363B4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1121223006:0":{"text":"This is the first time I've seen it.","source_cn":"我第一次见到它。","status":"matched","hash_xxh64":"0xB20618BDA1158F2C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1121223007:0":{"text":"But I felt such warmth the moment you brought it out.","source_cn":"但是，看到它的一瞬间，身体变得很温暖。","status":"matched","hash_xxh64":"0xE338ECEFA8BBD329","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1121223008:0":{"text":"What's happening? Ever since I met you my world has been spinning.","source_cn":"为什么呢……遇到你们以后，我的问题越来越多了。","status":"matched","hash_xxh64":"0x1ADA8C1918C8B567","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1121223009:0":{"text":"Perhaps only when we reach the Vaduso Mountains will our speculations be confirmed.","source_cn":"或许只有到了瓦度索山脉，我们的种种猜想才能得到证实。","status":"matched","hash_xxh64":"0x20492B56FD9F5FBC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1121223010:1":{"text":"Well, in that case—","source_cn":"嗯，既然如此——","status":"matched","hash_xxh64":"0x5F53DD31317705DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1121223011:1":{"text":"You have permission to take Aves 11 out of Holistone.","source_cn":"好吧，我允许你们带阿尔法十一离开圣石镇。","status":"matched","hash_xxh64":"0x62FDAAA4C319F42A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1121223012:1":{"text":"General, are you sure?","source_cn":"将军，真的可以吗？","status":"matched","hash_xxh64":"0x7760BC6900E83D09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1121223013:1":{"text":"Lyca, if she truly is a Wilder, you are well within your rights to take over this matter.","source_cn":"莱卡小姐，假如她真的属于绿裔联盟，你们有权接管此事。","status":"matched","hash_xxh64":"0xC727B202FC582811","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1121223014:1":{"text":"Illucia may have used dark magic to manipulate her, and she should not be punished until the truth is revealed.","source_cn":"黑金女士可能用了黑魔法操纵她，在弄清真相前，她不该被惩罚。","status":"matched","hash_xxh64":"0xD26930F7826B92A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1121223015:0":{"text":"Thank you so much!","source_cn":"太感谢您了！","status":"matched","hash_xxh64":"0xCF5A6F58FB17BB0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1121223016:1":{"text":"As for the sculpture, I think Aves 11 should hold onto it for the time being.","source_cn":"至于这个石雕。我看，暂时交给阿尔法十一吧。","status":"matched","hash_xxh64":"0x030082E82A802FF5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1121223017:0":{"text":"Aves 11, take care of it.","source_cn":"阿尔法十一，它有可能是你的，希望你能好好保管。","status":"matched","hash_xxh64":"0x60867774BD4E5CBB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1121223018:0":{"text":"Why would you trust your enemy?","source_cn":"你为什么相信敌人？","status":"matched","hash_xxh64":"0x57DE8B67700D0A79","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1121223019:0":{"text":"I don't trust my enemies... but I would like to have more friends of the forest.","source_cn":"我并不相信敌人，但我愿意相信来自丛林的朋友。","status":"matched","hash_xxh64":"0x71B078B09B8CEDC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1121223020:0":{"text":"Your words, I don't quite understand them... but I'll accept this sculpture.","source_cn":"你的话，我不太懂。不过……我愿意保管它。","status":"matched","hash_xxh64":"0x7707097A37DF1C8B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1121223021:0":{"text":"Sweet! I'll shoot Arden a message and fill him in. Arden knows Laura.","source_cn":"好吧！那我去给雅顿贤者写封信，将这边的情况告诉他，雅顿...","status":"matched","hash_xxh64":"0x4EE8C01887567418","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1121223022:0":{"text":"I haven't agreed to go with you.","source_cn":"我还没有答应要和你们走。","status":"matched","hash_xxh64":"0xA0729B6453C81484","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1121223023:0":{"text":"So you're going to carry around that silly name forever? Aves 11...","source_cn":"那你打算永远顶着那个没有感情的名字吗？阿尔法十一。","status":"matched","hash_xxh64":"0x846AFB7602E5BE0B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1121223024:0":{"text":"But that's what Mother picked out for me and—","source_cn":"这是妈妈为我取的，我——","status":"matched","hash_xxh64":"0x006CFCA1113D2E5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1121223025:0":{"text":"A real mom wouldn't saddle her kid with a code name!","source_cn":"真正的母亲不会取那种代号般的名字！","status":"matched","hash_xxh64":"0x6EC11B791250428C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1121223026:0":{"text":"Don't you want to know who Laura is? It's time I told you...","source_cn":"你不是想知道阿露拉是谁的名字吗？那我告诉你好了。","status":"matched","hash_xxh64":"0x731FE29254474749","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1121223027:0":{"text":"Kiddo, we believe that name belongs to you.","source_cn":"我们认为，那个名字属于你。","status":"matched","hash_xxh64":"0x57EA452C0BDCCD09","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:阿尔法十一":{"text":"Aves 11","source":"阿尔法十一","status":"matched_dialogue_flow"},"speaker:蕾米雅":{"text":"Lenya","source":"蕾米雅","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:霍根":{"text":"Hogan","source":"霍根","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":29,"localized_text_count":28,"speaker_count":4}}