{"asset_key":"mn3/quest_story_11212290","episode":"mn3","category":"quest_story","story_id":"11212290","schema_version":1,"lang":"en","texts":{"say:1:1121229001:0":{"text":"Aves 11! Are you okay?","source_cn":"阿尔法十一！你还好吗？","status":"matched","hash_xxh64":"0x38C05B96569B82BC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1121229002:0":{"text":"My body hurts... I need candy.","source_cn":"身体很痛……请给我一颗糖果……","status":"matched","hash_xxh64":"0xDC89C6BDAF03BF3A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1121229003:2":{"text":"Aves 11, are you feeling pain again?","source_cn":"阿尔法十一，身体是不是又开始痛了？","status":"matched","hash_xxh64":"0x1533643EE937BBC9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1121229004:0":{"text":"Yes...","source_cn":"是……","status":"matched","hash_xxh64":"0xE6CFBC882AB0D9FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1121229005:0":{"text":"Hmm... It's happening more frequently now.","source_cn":"……嗯，正常的时间变短了啊。","status":"matched","hash_xxh64":"0xA7F23351E4FC9D7C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1121229006:0":{"text":"You're a strong one, aren't you? Come... Mother will give you sweets.","source_cn":"好了，你是个坚强的孩子。快到妈妈身边来吧，妈妈给你糖果吃。","status":"matched","hash_xxh64":"0x7DC5486D1C289C67","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1121229007:0":{"text":"Just eat the candy and everything will be alright. Here, have two this time.","source_cn":"只要吃下糖果，一切都会好起来。这次要多吃两颗哦。","status":"matched","hash_xxh64":"0x52CB7F3CDA76499A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1121229008:1":{"text":"Thank you, Mother.","source_cn":"谢谢妈妈……","status":"matched","hash_xxh64":"0x54C7EA0C8E646EA5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1121229009:0":{"text":"The candy is bitter, but it makes the pain go away.","source_cn":"虽然糖果很苦……但是只要吃下去，身体就不痛了。","status":"matched","hash_xxh64":"0x5F126A75B1B7AE34","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1121229010:0":{"text":"Hey, candy is sweet, right? That's not candy! You were tricked!","source_cn":"喂喂喂……糖果是甜的吧？那肯定不是什么糖果！你被骗了！","status":"matched","hash_xxh64":"0xA6611115CC763923","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1121229011:0":{"text":"Mother wouldn't lie to me...","source_cn":"妈妈不会骗我的……","status":"matched","hash_xxh64":"0xF731BE4864EAF33C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1121229012:0":{"text":"Master Arden, what's wrong with her?!","source_cn":"雅顿贤者！她这是怎么了？","status":"matched","hash_xxh64":"0xCAC9FEE6A4EBA0D2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1121229013:0":{"text":"These are the side effects of dark magic.","source_cn":"是黑魔法的副作用。","status":"matched","hash_xxh64":"0x9EC4FAEEE3CC736D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1121229014:2":{"text":"There's no telling exactly what Illucia did to her, but her body has been tainted by dark magic for quite some time.","source_cn":"不知道伊露西卡具体对她做了什么……但是可以看出，她的身...","status":"matched","hash_xxh64":"0x916B74919D33AA32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1121229015:0":{"text":"The candy she consumed was likely an antidote to suppress these side effects.","source_cn":"她吃的糖果应该是一种魔药，能够抑制住这些副作用。","status":"matched","hash_xxh64":"0xDE67D1FCB69F5EAE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1121229016:0":{"text":"Aves 11, I must ask, do you know how old you are?","source_cn":"阿尔法十一，冒昧问一句，你知道自己多大吗？","status":"matched","hash_xxh64":"0x91C0C18337B9E694","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1121229017:0":{"text":"I don't know... I can't remember.","source_cn":"我不知道……我不记得自己的年龄。","status":"matched","hash_xxh64":"0xB65FEDE2D4762C24","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1121229018:0":{"text":"Hmm... Lyca and Lenya, I want you to go to Lunadorf and find Dahnie.","source_cn":"唉……莱卡、蕾米雅，你们先去一趟月湖村，去找达赫妮。","status":"matched","hash_xxh64":"0xDAA7F66D7DF3D6E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1121229019:0":{"text":"The girl is in no condition to travel to the Vaduso Mountains.","source_cn":"这孩子现在的状态，没法和你们一起去瓦度索山脉。","status":"matched","hash_xxh64":"0xBCD98CD77CE72FA3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1121229020:0":{"text":"Bryon, tell Elona to take my handwritten message to Dahnie. She'll know what to do.","source_cn":"布莱恩，你让艾洛娜把我的手信捎给达赫妮，她知道该怎么做。","status":"matched","hash_xxh64":"0xD5FAC94F2712B317","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1121229021:0":{"text":"Understood.","source_cn":"是。","status":"matched","hash_xxh64":"0x2A937FC73CA79F89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:阿尔法十一":{"text":"Aves 11","source":"阿尔法十一","status":"matched_dialogue_flow"},"speaker:伊露西卡":{"text":"Illucia","source":"伊露西卡","status":"matched_dialogue_flow"},"speaker:蕾米雅":{"text":"Lenya","source":"蕾米雅","status":"matched_dialogue_flow"},"speaker:雅顿":{"text":"Arden","source":"雅顿","status":"matched_dialogue_flow"},"speaker:布莱恩":{"text":"Bryon","source":"布莱恩","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":22,"localized_text_count":21,"speaker_count":6}}