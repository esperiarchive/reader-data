{"asset_key":"mn3/quest_story_10291220","episode":"mn3","category":"quest_story","story_id":"10291220","schema_version":1,"lang":"en","texts":{"say:1:1029122001:1":{"text":"Who art thou? Speak.","source_cn":"尔等何人？报上名来。","status":"matched","hash_xxh64":"0xCC6397A17F3D6AC7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1029122002:2":{"text":"You're up, Dora.","source_cn":"朵拉，到了你发挥能力的时候了。","status":"matched","hash_xxh64":"0x659B9F7A1A8EB77D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1029122003:1":{"text":"I-I'm not actually a member of Shadow Chasers, it's not like I'd know their secret password...","source_cn":"我、我还不是追影者的成员呢，怎么会知道他们的接头暗号……","status":"matched","hash_xxh64":"0xFCE1EEF97A749EC7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1029122004:1":{"text":"I see. That's troublesome. Maybe we should get your parents here to help?","source_cn":"这样啊。那就麻烦了呢……要不还是把你爸爸妈妈也叫过来帮个忙？","status":"matched","hash_xxh64":"0xC7A69A65204DAC14","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1029122005:1":{"text":"Hmph, you big bully! Fine!","source_cn":"哼，你欺负小孩！我——","status":"matched","hash_xxh64":"0x9D261DA133AF57F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1029122006:1":{"text":"O son of the abyss, who sleeps in karmic fire, I am thy most devout kin.","source_cn":"沉睡在业火中的深渊之子啊，吾是您最虔诚的眷属。","status":"matched","hash_xxh64":"0xBBEA4919A6ACA503","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1029122007:1":{"text":"Call the name of our Lord.","source_cn":"请呼唤吾主之名。","status":"matched","hash_xxh64":"0xA844B0258FCCEAA8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1029122008:1":{"text":"Lord Syriosus, we sincerely pray for thy forgiveness.","source_cn":"赛利欧斯大人，吾等眷属，唯虔诚祈祷之心，愿您宽恕。","status":"matched","hash_xxh64":"0x212B6F9F3C41FD0C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1029122009:1":{"text":"My Lord hears. You may enter.","source_cn":"吾主知晓，后门可入。","status":"matched","hash_xxh64":"0x8B1D2B75328D25A4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:马克塔":{"text":"Makta","source":"马克塔","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"},"speaker:朵拉":{"text":"Dora","source":"朵拉","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":3}}