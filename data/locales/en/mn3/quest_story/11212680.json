{"asset_key":"mn3/quest_story_11212680","episode":"mn3","category":"quest_story","story_id":"11212680","schema_version":1,"lang":"en","texts":{"say:1:1121268001:0":{"text":"This is...","source_cn":"这是……","status":"matched","hash_xxh64":"0xA5FED4F331856505","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1121268002:0":{"text":"It was in a broken crate! It's a letter from Laura, to you!","source_cn":"我在一个破箱子里找到的！\\n这是阿露拉的亲笔信哦——留...","status":"matched","hash_xxh64":"0x0C5EE6551D499BD6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1121268003:0":{"text":"Your name is not Aves 11.","source_cn":"你的名字才不是什么阿尔法十一。","status":"matched","hash_xxh64":"0xD3498F0E61F6F60D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1121268004:0":{"text":"Your real name is <style=\"highlight\">Lily May</style>!","source_cn":"<style=highlight>五月</style>...","status":"matched","hash_xxh64":"0x35081C9A37076590","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1121268005:0":{"text":"Lily May... I do appreciate the smell of lilies, and the month of May... It's such a warm time of the year.","source_cn":"五月……我喜欢五月。\\n那是，很温暖的时节。","status":"matched","hash_xxh64":"0x6C7633B2F8E42F82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1121268006:0":{"text":"I like this name.","source_cn":"我喜欢这个名字。","status":"matched","hash_xxh64":"0x6C2AC8E6A5B3BFD0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1121268007:0":{"text":"My name... is Lily May. This is one of the answers I've been searching for.","source_cn":"我的名字，五月。这是我找到的答案。","status":"matched","hash_xxh64":"0x3272A0B0593F45C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1121268008:0":{"text":"Not only that, but the letter also mentions that they went east of the Vaduso Mountains, and your mother even left a map of their route.","source_cn":"不止如此，信中也提到他们去了瓦度索山脉以东的地方，你的...","status":"matched","hash_xxh64":"0xA3181637A83159C9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1121268009:0":{"text":"Lily May, you can go look for her!","source_cn":"五月，你可以去寻找他们！","status":"matched","hash_xxh64":"0x4D15DCD7E8E39D7A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1121268010:0":{"text":"I'll actually be able to see her...","source_cn":"也就是说，我真的能见到他们了。","status":"matched","hash_xxh64":"0xAAF27670F2171AF2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1121268011:0":{"text":"If you follow the directions marked on the map, I'm sure you'll find the clan.","source_cn":"是的，只要你按地图标注的方位寻找，一定可以找到族人们。","status":"matched","hash_xxh64":"0x526DBCECA93C7CAB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1121268012:0":{"text":"But I can't go... I must return to that general in Holistone.","source_cn":"可是我不能走……我得回到圣石镇，回到那位将军面前。","status":"matched","hash_xxh64":"0x9EE3EA914FAED6E2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1121268013:0":{"text":"Aves 11... Has Mother done something wrong? You tell me I've done nothing wrong! Say it!","source_cn":"阿尔法十一……是妈妈做错了吗？你告诉妈妈，妈妈没有错，...","status":"matched","hash_xxh64":"0xCADBB335FD3B7680","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1121268014:0":{"text":"Mother... what's wrong with you?","source_cn":"妈妈……你怎么了？","status":"matched","hash_xxh64":"0x8FA8469FB855A75A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1121268015:0":{"text":"It's not me who's wrong! NOT ME! I was ready to sacrifice everything!","source_cn":"对……错的不是我！\\n——不是我！我明明愿意付出一切！","status":"matched","hash_xxh64":"0xB04D0C559C5A1A73","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1121268016:0":{"text":"Illucia, you've had too much! Put down the glass!","source_cn":"伊露西卡女士，您喝醉了！快把酒杯放下吧！","status":"matched","hash_xxh64":"0xB52FED012391E3FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1121268017:0":{"text":"SHUT UP! I'm not the one who has to pay for their sins! NOT ME!","source_cn":"滚开！你们听着……我没有错，要偿还罪孽的人，也不是我！","status":"matched","hash_xxh64":"0x15A90230A6933199","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1121268018:1":{"text":"Mother... Calm down! I'll take the blame for you!","source_cn":"妈妈……您冷静点！我愿意替您承担！","status":"matched","hash_xxh64":"0x77DAB5D6E800E0F0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1121268019:0":{"text":"I... can't run away from it.","source_cn":"我……不能逃避。","status":"matched","hash_xxh64":"0x260878F425DE6D2C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1121268020:0":{"text":"I'm still carrying sins I can't wash away.","source_cn":"因为我还背负着无法洗清的罪孽。","status":"matched","hash_xxh64":"0x177D1A02798C7311","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:24:1121268020":{"text":"I'm still carrying sins I can't wash away.","source_cn":"因为我还背负着无法洗清的罪孽。","status":"matched","hash_xxh64":"0x177D1A02798C7311","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1121268021:0":{"text":"<style=\"stress\"><player_name></style>, I appreciate your kindness, but...","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x2A98C8587651507E","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, I appreciate your kindness, but...","female":"<style=\"stress\"><player_name></style>, I appreciate your kindness, but...","variant_male_record_index":"119013","variant_female_record_index":"119014","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:26:1121268022:0":{"text":"You made me realize that I cannot escape my past.","source_cn":"因为你让我意识到，我曾经做了多么过分的事情。我不能逃避惩罚。","status":"matched","hash_xxh64":"0xAEE9B84A2C2AFC59","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1121268024:0":{"text":"Lily May, I'm so happy to see your growth.","source_cn":"五月，看到你的成长，我很高兴。","status":"matched","hash_xxh64":"0x86280B9A801684DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1121268025:0":{"text":"Lenya, this time you'll escort them to Holistone.","source_cn":"那么，蕾米雅，这次就由你护送他们去圣石镇。","status":"matched","hash_xxh64":"0x12057B74A064E817","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:31:1121268026:0":{"text":"Huh? Me?","source_cn":"哎？我？","status":"matched","hash_xxh64":"0x3D8A8421790ECCFA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1121268027:0":{"text":"I'm going to update Granny Dahnie and Arden. You're already in charge, so surely you can handle this?","source_cn":"我要向达赫妮婆婆和雅顿贤者说明情况。你已经独当一面了，...","status":"matched","hash_xxh64":"0x05E76205C1E333CB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:33:1121268028:0":{"text":"Fine by me, I'm just looking forward to the grub at the Traveler's Light!","source_cn":"我是无所谓啦，反正我很喜欢吃旅人灯火的饭！","status":"matched","hash_xxh64":"0x8FAD5FE1C7212857","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:34:1121268029:0":{"text":"... Try to focus on more than just food.","source_cn":"……不要只想着吃。","status":"matched","hash_xxh64":"0xE293E39F7E72C11D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:35:1121268030:0":{"text":"<style=\"stress\"><player_name></style>, please pass on some much needed guidance to Lenya.","source_cn":"唉，<style=stress><player_nam...","status":"matched_runtime_gender","hash_xxh64":"0x37F3CD0D2FA5ACCC","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, please pass on some much needed guidance to Lenya.","female":"<style=\"stress\"><player_name></style>, please pass on some much needed guidance to Lenya.","variant_male_record_index":"119024","variant_female_record_index":"119025","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:36:1121268030":{"text":"<style=\"stress\"><player_name></style>, please pass on some much needed guidance to Lenya.","source_cn":"唉，<style=stress><player_name></style>，还要麻烦你多多教导蕾米雅了。","status":"matched_runtime_gender","hash_xxh64":"0x37F3CD0D2FA5ACCC","variant_status":"runtime_gender_keys_target_same","male":"<style=\"stress\"><player_name></style>, please pass on some much needed guidance to Lenya.","female":"<style=\"stress\"><player_name></style>, please pass on some much needed guidance to Lenya.","variant_male_record_index":"119024","variant_female_record_index":"119025","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1121268031:0":{"text":"Ohh, private guidance from Magister Merlin himself? How'd I get so lucky?","source_cn":"又能得到梅林大人的私家指导了？我真是幸运。","status":"matched_runtime_gender","hash_xxh64":"0x3A381409148AE6C8","variant_status":"runtime_gender_keys_target_differs","male":"Ohh, private guidance from Magister Merlin himself? How'd I get so lucky?","female":"Ohh, private guidance from Magister Merlin herself? How'd I get so lucky?","variant_male_record_index":"119026","variant_female_record_index":"119027","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1121268033:0":{"text":"Alright, then. I wish you all a safe journey.","source_cn":"好了好了，那么，我祝各位一路顺风。","status":"matched","hash_xxh64":"0xEA252F33D9753AC2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1121268034:0":{"text":"Especially you, Lily May. Misarte's blessings upon you.","source_cn":"尤其是你，五月。愿弥萨忒庇佑你。","status":"matched","hash_xxh64":"0x05F78C9D117B12F4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1121268035:0":{"text":"Farewell, Lyca.","source_cn":"嗯，再见，莱卡。","status":"matched","hash_xxh64":"0x64E2A7C7F1BC05D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1121268036:0":{"text":"Farewell... Vaduso Mountains.","source_cn":"再见了……瓦度索山脉。","status":"matched","hash_xxh64":"0x543A4DADED2A2C08","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1121268037:0":{"text":"I'll be back one day.","source_cn":"以后，我一定会回来。","status":"matched","hash_xxh64":"0x3206CB27F37FAA7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:36:0:1":{"text":"I got it covered!","source_cn":"放心吧","status":"matched_runtime_gender","hash_xxh64":"0xB31D82FE33041EA2","variant_status":"runtime_gender_keys_target_same","male":"I got it covered!","female":"I got it covered!","variant_male_record_index":"63298","variant_female_record_index":"63299","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1121268032:0":{"text":"Am I really giving you that much of a headache already? How sad...","source_cn":"哎？我这么让你头疼吗？人家好伤心……","status":"matched_runtime_gender","hash_xxh64":"0xE4EE53C72046A1F9","variant_status":"runtime_gender_keys_target_same","male":"Am I really giving you that much of a headache already? How sad...","female":"Am I really giving you that much of a headache already? How sad...","variant_male_record_index":"119028","variant_female_record_index":"119029","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:36:1:2":{"text":"I guess I'll do my best...","source_cn":"我尽力","status":"matched_runtime_gender","hash_xxh64":"0x449E08A1A3854084","variant_status":"runtime_gender_keys_target_same","male":"I guess I'll do my best...","female":"I guess I'll do my best...","variant_male_record_index":"63300","variant_female_record_index":"63301","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:0:1":{"text":"Go to your mother.","source_cn":"你去找族人吧","status":"matched_runtime_gender","hash_xxh64":"0x7C9DBC0C9D4569B0","variant_status":"runtime_gender_keys_target_same","male":"Go to your mother.","female":"Go to your mother.","variant_male_record_index":"63294","variant_female_record_index":"63295","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1121268023:0":{"text":"Thank you, <style=\"stress\"><player_name></style>.","source_cn":"谢谢你，<style=stress><player_n...","status":"matched_runtime_gender","hash_xxh64":"0x62B3F2D2247BDD6C","variant_status":"runtime_gender_keys_target_same","male":"Thank you, <style=\"stress\"><player_name></style>.","female":"Thank you, <style=\"stress\"><player_name></style>.","variant_male_record_index":"119016","variant_female_record_index":"119017","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:24:1:2":{"text":"I'll take you to Holistone.","source_cn":"我带你回圣石镇","status":"matched_runtime_gender","hash_xxh64":"0xD1CFB008F27A78EC","variant_status":"runtime_gender_keys_target_same","male":"I'll take you to Holistone.","female":"I'll take you to Holistone.","variant_male_record_index":"63296","variant_female_record_index":"63297","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:阿尔法十一":{"text":"Aves 11","source":"阿尔法十一","status":"matched_dialogue_flow"},"speaker:蕾米雅":{"text":"Lenya","source":"蕾米雅","status":"matched_dialogue_flow"},"speaker:五月":{"text":"Lily May","source":"五月","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:伊露西卡":{"text":"Illucia","source":"伊露西卡","status":"matched_dialogue_flow"},"speaker:焦急的黑金成员":{"text":"Syndicate Member","source":"焦急的黑金成员","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":44,"localized_text_count":43,"speaker_count":6}}