{"asset_key":"mn3/quest_story_11212250","episode":"mn3","category":"quest_story","story_id":"11212250","schema_version":1,"lang":"en","texts":{"say:1:1121225001:1":{"text":"One, two, three girls... is that it? You, mage, are you coming aboard?","source_cn":"一、二、三……只有这三位姑娘乘船吗？那边的魔法师，你上不上？","status":"matched_runtime_gender","hash_xxh64":"0x23B4F35722882142","variant_status":"runtime_gender_keys_target_same","male":"One, two, three girls... is that it? You, mage, are you coming aboard?","female":"One, two, three girls... is that it? You, mage, are you coming aboard?","variant_male_record_index":"117206","variant_female_record_index":"117207","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:2:1121225001":{"text":"One, two, three girls... is that it? You, mage, are you coming aboard?","source_cn":"一、二、三……只有这三位姑娘乘船吗？那边的魔法师，你上不上？","status":"matched_runtime_gender","hash_xxh64":"0x23B4F35722882142","variant_status":"runtime_gender_keys_target_same","male":"One, two, three girls... is that it? You, mage, are you coming aboard?","female":"One, two, three girls... is that it? You, mage, are you coming aboard?","variant_male_record_index":"117206","variant_female_record_index":"117207","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1121225002:1":{"text":"Alright, that makes a total of four.","source_cn":"好嘞。","status":"matched_runtime_gender","hash_xxh64":"0x1BBB24524483EE5C","variant_status":"runtime_gender_keys_target_same","male":"Alright, that makes a total of four.","female":"Alright, that makes a total of four.","variant_male_record_index":"117208","variant_female_record_index":"117209","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1121225004:0":{"text":"Sit back and relax, we're departing now.","source_cn":"那总共是四个人，坐好吧，我们马上出发。","status":"matched","hash_xxh64":"0xA4120BBE7AD26DDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1121225005:0":{"text":"We can't leave now.","source_cn":"现在不能走。","status":"matched","hash_xxh64":"0xC2E1C35CCC7ACB00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1121225006:0":{"text":"What? You want off the boat?","source_cn":"啊？你又不坐船了？","status":"matched","hash_xxh64":"0xC4F4AFEB6DDE0E00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1121225007:0":{"text":"It's going to start pouring rain. It's dangerous to sail at this time of year.","source_cn":"要下大雨了。这时候出航，有危险。","status":"matched","hash_xxh64":"0xD6C7393D22FDB3BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1121225008:0":{"text":"Nonsense! It's a beautiful, sunny day.","source_cn":"胡说八道……这大晴天的。","status":"matched","hash_xxh64":"0x3E15DD2FBE29397F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1121225009:0":{"text":"I'm serious. Dark clouds will come soon.","source_cn":"我没有胡说，乌云很快就要来了。","status":"matched","hash_xxh64":"0x42335B95DA0C2DDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1121225010:0":{"text":"Sure, sure... Sit down if you want, or get off quickly. Time is money.","source_cn":"行行行……你爱坐不坐，不坐就快下船，别耽误我挣钱。","status":"matched","hash_xxh64":"0x4F87590AE0F37764","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1121225011:1":{"text":"Hold on... It's actually raining.","source_cn":"等等……真的下雨了。","status":"matched","hash_xxh64":"0x24EA290F075A6683","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:16:1121225012:0":{"text":"Looks like the rain will get heavy!","source_cn":"啊哦！好厚的一坨乌云。","status":"matched","hash_xxh64":"0x43FD5B19CDAF10B3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1121225013:0":{"text":"Let's find some shelter from the rain... I don't want my fur getting all soggy.","source_cn":"我们还是找个地方避避雨吧，我可不想弄湿自己的毛发。","status":"matched","hash_xxh64":"0xB8F12C7B187EF29D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:18:1121225014:1":{"text":"A while later, the rain stops.","source_cn":"一段时间后……雨停了","status":"matched","hash_xxh64":"0x111E71102ED83E32","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1121225015:0":{"text":"Phew... This sure is a lot of rain. It's fortunate we didn't set off.","source_cn":"呼，这雨真不小……幸好刚才没走。","status":"matched","hash_xxh64":"0x10E8F9C74F154ED6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:22:1121225016:0":{"text":"I'm sorry, little girl... I misjudged you.","source_cn":"对不起啊小姑娘……错怪你了。","status":"matched","hash_xxh64":"0x5FB110C5C4719E75","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:23:1121225017:0":{"text":"I'm not used to hearing that word... \"sorry\".","source_cn":"我不习惯听见道歉。","status":"matched","hash_xxh64":"0x9FE261AABC6CEE24","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:24:1121225018:1":{"text":"What a strange girl...","source_cn":"奇怪的姑娘……","status":"matched","hash_xxh64":"0x9B99D36A31DF3082","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:25:1121225019:0":{"text":"Alright, sit tight everyone. Now we're really departing.","source_cn":"行吧……都坐稳咯，要出发了。","status":"matched","hash_xxh64":"0xE3D4CCDEEA4B28FC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:28:1121225020:0":{"text":"I wish you all a safe journey!","source_cn":"各位，祝你们一路顺风。","status":"matched","hash_xxh64":"0x3862A6D03B5C0EAE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:29:1121225021:0":{"text":"Traveling by boat, you arrive at the familiar Dark Forest again.","source_cn":"坐上小船，我们再次来到了熟悉的薄暮丛林","status":"matched","hash_xxh64":"0x8C9C70EA7D26EA50","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:2:0:1":{"text":"Yup!","source_cn":"这就来","status":"matched_runtime_gender","hash_xxh64":"0x5E6727D672C143A1","variant_status":"runtime_gender_keys_target_same","male":"Yup!","female":"Yup!","variant_male_record_index":"62794","variant_female_record_index":"62795","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:32:1121225003:1":{"text":"You're not? Please, General Hogan said he'd only feel at ease if you went along.","source_cn":"你不去吗？这可伤脑筋了……将军刚才还在说呢，有你同行他...","status":"matched_runtime_gender","hash_xxh64":"0xA72FE6003CD9FD69","variant_status":"runtime_gender_keys_target_same","male":"You're not? Please, General Hogan said he'd only feel at ease if you went along.","female":"You're not? Please, General Hogan said he'd only feel at ease if you went along.","variant_male_record_index":"117210","variant_female_record_index":"117211","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:33:1121225003":