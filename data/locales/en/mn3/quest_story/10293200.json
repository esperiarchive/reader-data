{"asset_key":"mn3/quest_story_10293200","episode":"mn3","category":"quest_story","story_id":"10293200","schema_version":1,"lang":"en","texts":{"say:1:1029320001:1":{"text":"I only came to get water! I never thought I'd run into so many Hypofiends...","source_cn":"我只是出来取个水，没想到会遇到这么多魔物……","status":"matched","hash_xxh64":"0x8DAB0BA2ED28BF82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1029320002:1":{"text":"Dura above, thank you for your assistance.","source_cn":"艾雅在上，感激诸位相救。","status":"matched","hash_xxh64":"0x4A9CB459C0240FE7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1029320003:1":{"text":"Okay, now that it's been successfully resolved, can we keep investigating the theft of the Faith Stone? I still have many questions I intend to ask!","source_cn":"好啦，既然事情已经顺利解决了，那我们是不是可以继续调查...","status":"matched","hash_xxh64":"0x6D2532EAAA7317BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1029320004:1":{"text":"I didn't agree to keep cooperating with you, girl.","source_cn":"我可没答应要继续配合你啊，小姑娘。","status":"matched","hash_xxh64":"0x651FC873570224E7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1029320005:1":{"text":"Everyone, I may have more knowledge than Atalanta about what happened after the Faith Stone was stolen. But right now, please allow me to escort the acolytes back to Holistone safely.","source_cn":"各位，圣石失窃之后的事，比起阿塔兰忒，我或许更为了解。...","status":"matched","hash_xxh64":"0xE9C380EDE725D176","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1029320006:1":{"text":"After that, if you still wish to know more of the story... come find me in Holistone.","source_cn":"在那之后，如果你们还想要了解这个故事的话……可以来圣石...","status":"matched","hash_xxh64":"0xC16A761F11E7A77D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1029320007:1":{"text":"Actually, Temesia, I can continue—","source_cn":"特弥希娅，其实我可以继续——","status":"matched","hash_xxh64":"0x236CA5D60AF0A648","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1029320008:1":{"text":"I'm sorry, Atalanta. I must insist on this.","source_cn":"抱歉，阿塔兰忒。在这一点上，我坚持。","status":"matched","hash_xxh64":"0xA71C233EB33BC505","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1029320009:1":{"text":"...I understand.","source_cn":"……我明白了。","status":"matched","hash_xxh64":"0xABFA82D623652764","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1029320010:1":{"text":"See you in Holistone, Magister <style=\"stress\"><player_name></style>.","source_cn":"<style=stress><player_name>...","status":"matched_runtime_gender","hash_xxh64":"0x3F6E98B4694326B6","variant_status":"runtime_gender_keys_target_same","male":"See you in Holistone, Magister <style=\"stress\"><player_name></style>.","female":"See you in Holistone, Magister <style=\"stress\"><player_name></style>.","variant_male_record_index":"116085","variant_female_record_index":"116086","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修士盖尔迪":{"text":"Acolyte Geordie","source":"修士盖尔迪","status":"matched_dialogue_flow"},"speaker:菲":{"text":"Fay","source":"菲","status":"matched_dialogue_flow"},"speaker:阿塔兰忒":{"text":"Atalanta","source":"阿塔兰忒","status":"matched_dialogue_flow"},"speaker:特弥希娅":{"text":"Temesia","source":"特弥希娅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":11,"localized_text_count":10,"speaker_count":4}}