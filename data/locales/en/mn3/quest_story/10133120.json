{"asset_key":"mn3/quest_story_10133120","episode":"mn3","category":"quest_story","story_id":"10133120","schema_version":1,"lang":"en","texts":{"say:1:1013312001:1":{"text":"Thanks for gathering the info, everyone. Now, let's take a look...","source_cn":"辛苦诸位收集石碑。那么，请看……","status":"matched","hash_xxh64":"0xECB5F3D1C86A9B38","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013312002:0":{"text":"This stone tablet records local legends, linking the Faith Stone and the Divine War.","source_cn":"这块石碑上记录着本地传说，表明圣石与神魔大战有关。","status":"matched","hash_xxh64":"0xC87208BEE8FF2FF3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1013312003:1":{"text":"This lines up with some official statements from the Temple. Many believe the Faith Stone was left by Dura.","source_cn":"这也与圣堂的部分官方说法有所印证。虽然没有考据支持，但...","status":"matched","hash_xxh64":"0xB9AF0AEB3123B2D6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1013312004:1":{"text":"Indeed, that would make sense.","source_cn":"确实如此，圣石是为女神遗留下的珍宝。","status":"matched","hash_xxh64":"0x246E54B30376E0C4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1013312005:1":{"text":"That raises a question... Why was the Faith Stone left in Holistone, rather than with the Temple?","source_cn":"那么问题来了，女神的珍宝为什么没有被圣堂供奉，反而留在...","status":"matched","hash_xxh64":"0x1394A940348A770C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1013312006:1":{"text":"Good question! Unfortunately, neither side of the war recorded that info, so there's no explanation...","source_cn":"绝妙的问题！中间似乎有一些故事，但是双方都没有记载，因...","status":"matched","hash_xxh64":"0x8541F4DC41622C89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1013312007:2":{"text":"We—<shk>Ahh! A golem!</shk>","source_cn":"我们——<shk>哇！是魔偶！</shk>","status":"matched","hash_xxh64":"0xCC37316562893895","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1013312008:4":{"text":"<shk>Zzzz...click...</shk>","source_cn":"<shk>嗞……咔咔……</shk>","status":"matched","hash_xxh64":"0x28D1E59420031743","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1013312009:0":{"text":"Everyone, watch out!","source_cn":"诸位小心应对。","status":"matched","hash_xxh64":"0x5FF7159EA3D25520","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:阿斯玛":{"text":"Asma","source":"阿斯玛","status":"matched_dialogue_flow"},"speaker:卢修斯":{"text":"Lucius","source":"卢修斯","st