{"asset_key":"mn3/quest_story_10137040","episode":"mn3","category":"quest_story","story_id":"10137040","schema_version":1,"lang":"en","texts":{"say:1:1013704001:1":{"text":"Shakir! I've got orders from higher up.","source_cn":"沙奎尔！我带来了上面的命令。","status":"matched","hash_xxh64":"0x1455ACFB784DA39D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013704002:1":{"text":"You're to start guarding the camp's gates and prevent outsiders from getting near the Sun Temple—","source_cn":"这段时间，你要严守营地门户，防止闲杂人等接近日神殿——","status":"matched","hash_xxh64":"0xAF21FE331A2D307F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1013704003:2":{"text":"Outsiders? Are you talking about us?","source_cn":"闲杂人等？指的是我们吗？","status":"matched","hash_xxh64":"0xC1033C0BF1B447BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1013704004:1":{"text":"Huh?! Outsiders! Shakir, who are they?","source_cn":"嗯？！闲杂人等竟然就在这里！沙奎尔，他们是谁？","status":"matched","hash_xxh64":"0xC130F8E81BCA896B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1013704005:1":{"text":"They're my respected adversaries, possessing power beyond typical golems.","source_cn":"是我可敬的对手，拥有着超出普通魔偶的力量。","status":"matched","hash_xxh64":"0xDE956F27EC7ED5C9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1013704006:2":{"text":"Huh? Are you defying the Adamant Syndicate's orders? Seize them!","source_cn":"你这是要违抗黑金商会的命令吗？给我把他们抓起来！","status":"matched","hash_xxh64":"0x36B0194488942098","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:高傲的黑金掮客":{"text":"Proud Broker","source":"高傲的黑金掮客","status":"matched_dialogue_flow"},"speaker:卢修斯":{"text":"Lucius","source":"卢修斯","status":"matched_dialogue_flow"},"speaker:不耐烦的黑金掮客":{"text":"Impatient Broker","source":"不耐烦的黑金掮客","status":"matched_dialogue_flow"},"speaker:沙奎尔":{"text":"Shakir","source":"沙奎尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":4}}