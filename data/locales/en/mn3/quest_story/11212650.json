{"asset_key":"mn3/quest_story_11212650","episode":"mn3","category":"quest_story","story_id":"11212650","schema_version":1,"lang":"en","texts":{"say:1:1121265001:0":{"text":"There's not a soul in sight.","source_cn":"唉，一个人都没见着……","status":"matched","hash_xxh64":"0x6492B757FB31C10E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1121265002:0":{"text":"They foresaw the corruption long ago and migrated elsewhere.","source_cn":"他们早早预见到了腐化发生，在那之前迁徙去了别处。","status":"matched","hash_xxh64":"0x0A7BA3A8B9AD8F73","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1121265003:0":{"text":"Aves 11, don't feel sad. Now that the corruption has been addressed at the source, maybe they'll return.","source_cn":"阿尔法十一，你别难过……如今腐化已经从源头解决了，或许...","status":"matched","hash_xxh64":"0x7A5FC522E11285EF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1121265004:0":{"text":"Maybe I can wait here until they come back?","source_cn":"如果我在这里等待……能等到他们回来吗？","status":"matched","hash_xxh64":"0x1ADA483F6A1D4519","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1121265005:0":{"text":"How long will I have to wait?","source_cn":"我需要等多久呢？","status":"matched","hash_xxh64":"0x1E7082C13CE1B2D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1121265006:0":{"text":"It's... hard to say. And I don't want to lie to you or give you false hope.","source_cn":"这个……不好说啊。我也不想撒谎骗你。","status":"matched","hash_xxh64":"0x701993B71F1929C2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1121265007:0":{"text":"... It's alright, I understand this time.","source_cn":"……没关系，这次我懂了。","status":"matched","hash_xxh64":"0xA5A1E1F51ABB9341","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1121265008:0":{"text":"Can I be alone for a while? I'd like to sit in the quiet.","source_cn":"我可以独自待一会儿吗？我想稍微静一静。","status":"matched","hash_xxh64":"0x8B87A8B0198D6862","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1121265009:0":{"text":"Okay...","source_cn":"好……","status":"matched","hash_xxh64":"0x03B4FED286515789","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:蕾米雅":{"text":"Lenya","source":"蕾米雅","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:阿尔法十一":{"text":"Aves 11","source":"阿尔法十一","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":9,