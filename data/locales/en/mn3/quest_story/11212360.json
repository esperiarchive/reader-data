{"asset_key":"mn3/quest_story_11212360","episode":"mn3","category":"quest_story","story_id":"11212360","schema_version":1,"lang":"en","texts":{"say:1:1121236001:0":{"text":"The girl ran away! She was injured, yet she moved faster than anyone I've ever seen!","source_cn":"那姑娘跑了！气死我了……伤成那样，跑得比谁都快！","status":"matched","hash_xxh64":"0xF288030A2ED6AA5F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1121236002:0":{"text":"Ran away? Why would she... Does she still not believe us?","source_cn":"跑了？怎么会……她还是不愿意相信我们吗？","status":"matched","hash_xxh64":"0x0C02522C11B72250","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1121236003:1":{"text":"Lyca, it will not be easy to win her trust.","source_cn":"莱卡，想赢得她的信任，没那么容易。","status":"matched","hash_xxh64":"0xFCA7A2AC3EC5C6BF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1121236004:0":{"text":"She's been indoctrinated by the Adamant Syndicate for quite some time. We must be patient.","source_cn":"她被黑金商会养了那么久，我们需要多给她一点耐心。","status":"matched","hash_xxh64":"0xF51EDD21720E575A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1121236005:0":{"text":"Granny Dahnie! She was seen heading toward the Bizarre Labyrinth!","source_cn":"达赫妮婆婆！有人看见她往诡幻迷宫的方向去了！","status":"matched","hash_xxh64":"0xCB4D30FA5C68FD2A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1121236006:0":{"text":"Hurry and bring her back! Leave the herbs, and as soon as she returns, make sure she drinks the potion.","source_cn":"快去把她追回来！药草留下，等她回来了立马给我喝干净！","status":"matched","hash_xxh64":"0x3454DE79751078B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1121236007:0":{"text":"On it!","source_cn":"知道了！","status":"matched","hash_xxh64":"0x20F0387DF9E563F6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:达赫妮":{"text":"Dahnie","source":"达赫妮","status":"matched_dialogue_flow"},"speaker:莱卡":{"text":"Lyca","source":"莱卡","status":"matched_dialogue_flow"},"speaker:蕾米雅":{"text":"Lenya","source":"蕾米雅","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":8,"localized_text_count":7,"speaker_count":3}}