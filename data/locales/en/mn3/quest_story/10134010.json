{"asset_key":"mn3/quest_story_10134010","episode":"mn3","category":"quest_story","story_id":"10134010","schema_version":1,"lang":"en","texts":{"say:2:1013401001:2":{"text":"Lucius, can we swap positions? I'll take the rear.","source_cn":"——卢修斯，我们换个位置吧。我来殿后。","status":"matched","hash_xxh64":"0x7B0F53E71CFAA5B0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1013401002:1":{"text":"Now look what you've done, guys! Stop making Temesia so uncomfortable with your gossiping!","source_cn":"啊，好的。拜托你们几个，讲别人的事情能不能别那么大声——！！","status":"matched","hash_xxh64":"0x8156D6408382368E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1013401003:3":{"text":"Thanks, Lucius. Now people miles away can hear you yelling.","source_cn":"卢修斯，多谢你，现在几十里外的镇民也能听清楚了。","status":"matched","hash_xxh64":"0x0B33C6E418D4EE27","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1013401004:2":{"text":"... Dura above. Temesia, I apologize...","source_cn":"……艾雅在上，特弥希娅，我很抱歉……","status":"matched","hash_xxh64":"0x113509117DDFA3EA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1013401004":{"text":"... Dura above. Temesia, I apologize...","source_cn":"……艾雅在上，特弥希娅，我很抱歉……","status":"matched","hash_xxh64":"0x113509117DDFA3EA","variant_status":"","male":"","female":"","vari