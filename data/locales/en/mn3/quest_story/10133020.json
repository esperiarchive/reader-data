{"asset_key":"mn3/quest_story_10133020","episode":"mn3","category":"quest_story","story_id":"10133020","schema_version":1,"lang":"en","texts":{"say:0:1013302001:0":{"text":"I remember when I first put on my armor, I couldn't even stand...","source_cn":"特弥希娅比我厉害，我刚刚开始穿着重甲的时候，只是站着都...","status":"matched","hash_xxh64":"0x6C4CE90CC4F85D2C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:1:1013302002:0":{"text":"But now I'm used to it. I even forget to take it off to sleep! *Laughter*","source_cn":"不过，现在也习惯了。偶尔还会忘记脱掉睡觉呢。嘿嘿。","status":"matched","hash_xxh64":"0xCD056098AA11B3F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1013302003:0":{"text":"You Temple folk really have a weird sense of humor...","source_cn":"搞不懂。居然在笑着说这种可怕的事，你们圣堂的人是不是都...","status":"matched","hash_xxh64":"0xF4075DF21254A805","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1013302004:0":{"text":"You're laughing? I thought you'd never drop your guard around us!","source_cn":"咦，等等，特弥希娅在笑？原来混熟之后，你也会露出这种表情啊。","status":"matched","hash_xxh64":"0x12D7EBDCAF41D5F9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1013302005:0":{"text":"Ahem... The camp's up ahead, we're almost there.","source_cn":"……有什么问题吗？请看，前方那片营地，应该就是我们的目...","status":"matched","hash_xxh64":"0x5876C983B37ACBA0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1013302006:0":{"text":"I'll go greet everyone first!","source_cn":"没错，就是前面的营地，我先去跟大家打个招呼！","status":"matched","hash_xxh64":"0x0A4F74525218D606","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:卢修斯":{"text":"Lucius","source":"卢修斯","status":"matched_dialogue_flow"},"speaker:维伦":{"text":"Valen","source":"维伦","status":"matched_dialogue_flow"},"speaker:特弥希娅":{"text":"Temesia","source":"特弥希娅","status":"matched_dialogue_flow"},"speaker:菲":{"text":"Fay","source":"菲","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":7,"localized_text_count":6,"speaker_count":4}}