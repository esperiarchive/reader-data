{"asset_key":"mn3/quest_story_10293160","episode":"mn3","category":"quest_story","story_id":"10293160","schema_version":1,"lang":"en","texts":{"say:1:1029316001:2":{"text":"It's been a long time, Temesia! I've missed you!","source_cn":"特弥希娅！好久不见，我好想你呀！","status":"matched","hash_xxh64":"0xEABACDC0253192A0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1029316002:0":{"text":"Hi, Fay. It's been a while. May Dura bless you.","source_cn":"你好，菲。好久不见，愿女神保佑你。","status":"matched","hash_xxh64":"0xCCADFD7BF9671163","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1029316003:0":{"text":"I'm here too! Aren't you gonna say hello to me?","source_cn":"我也在呢，你不和我打招呼吗？","status":"matched","hash_xxh64":"0xE2501F4021A7F779","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1029316004:0":{"text":"Y-You're the prime suspect in this case! As the lead detective, it's only right that I treat suspects seriously!","source_cn":"你、你这可是本案的重点嫌疑人！作为侦探，我对嫌疑人态度...","status":"matched","hash_xxh64":"0xD95D020E43621971","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1029316005:0":{"text":"Huh? What do you mean \"suspect\"? I haven't stolen anything recently.","source_cn":"啊，你说什么嫌疑人？我最近可没有偷什么东西。","status":"matched","hash_xxh64":"0x1A4516ABE6167004","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1029316006:0":{"text":"The Faith Stone! You're a suspect in the case of the stolen Faith Stone!","source_cn":"圣石！你是圣石失窃案的嫌疑人！","status":"matched","hash_xxh64":"0xD645968A4B1F2C00","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1029316007:0":{"text":"The Faith Stone? Why... are you investigating that?","source_cn":"圣石？你们……调查这个做什么？","status":"matched","hash_xxh64":"0x7888F88925726576","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:8:1029316007":{"text":"The Faith Stone? Why... are you investigating that?","source_cn":"圣石？你们……调查这个做什么？","status":"matched","hash_xxh64":"0x7888F88925726576","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1029316008:0":{"text":"That all happened so long ago, I can barely remember it myself.","source_cn":"这是太久之前的事情了，我已经忘得差不多了。","status":"matched","hash_xxh64":"0xCAD03A69E48C30D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1029316009:2":{"text":"Actually, Atalanta... I also want to know what really happened back then.","source_cn":"阿塔兰忒，其实……我也想要知道当时发生了什么。","status":"matched","hash_xxh64":"0x922C2F6B22C88FAC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1029316010:0":{"text":"Temesia, you... Fine. I understand. So this is what happened—","source_cn":"特弥希娅，你……好吧，我明白了。事情是这样的——","status":"matched","hash_xxh64":"0x920635D2B32DF8D9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:13:1029316011:1":{"text":"Atalanta closed her eyes and lost herself in the memory...","source_cn":"","status":"matched","hash_xxh64":"0xF5824181FD52CD90","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:0:1":{"text":"Pure curiosity.","source_cn":"只是好奇","status":"matched_runtime_gender","hash_xxh64":"0x47A785581A4A7D57","variant_status":"runtime_gender_keys_target_same","male":"Pure curiosity.","female":"Pure curiosity.","variant_male_record_index":"62944","variant_female_record_index":"62945","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:8:1:2":{"text":"We want to know the truth.","source_cn":"只是想知道真相","status":"matched_runtime_gender","hash_xxh64":"0x698D38BA2F6A6D5B","variant_status":"runtime_gender_keys_target_same","male":"We want to know the truth.","female":"We want to know the truth.","variant_male_record_index":"62946","variant_female_record_index":"62947","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:菲":{"text":"F