{"asset_key":"timeline/dialoguetree_story_10102060","episode":"timeline","category":"dialoguetree_story","story_id":"10102060","schema_version":1,"lang":"jp","texts":{"say:2:1010206001:0":{"text":"ちっ……","source_cn":"啧……","status":"matched","hash_xxh64":"0xE7CE38C819493F96","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1010206002:1":{"text":"逃がすか！","source_cn":"别想跑！","status":"matched","hash_xxh64":"0x639013CB835217BA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1010206003:0":{"text":"うーん……何かがおかしいな……","source_cn":"奇怪……有哪里不太对……","status":"matched","hash_xxh64":"0x4F2EC2A2B311E9C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1010206004:0":{"text":"申し訳ありません、ロワン坊ちゃま。下民どもには相応の報いを受けさせますので！","source_cn":"罗万少爷，抱歉让这些刁民打扰了您，我会让他们付出代价！","status":"matched","hash_xxh64":"0x45BEE480993506E3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1010206005:0":{"text":"あいつらのことを言ってるんじゃない。","source_cn":"我不是在说他们。","status":"matched","hash_xxh64":"0xE8E65509FC14B799","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1010206006:0":{"text":"この南村の人たち……昔どこかで見た気がするんだよ