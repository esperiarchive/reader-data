76B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1511453003:0":{"text":"悪くない働きであったぞ。獣の鮮血に赤く染まる大地……実に悦い光景じゃ。","source_cn":"你们两个做得不错。野兽的鲜血浸染了土地和沼泽，令我非常喜悦。","status":"matched","hash_xxh64":"0x9AD162EF66D62A3C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1511453004:0":{"text":"そなたらに褒美をつかわそう……<style=\"highlight\">妾に挑む</style>という褒美をな。","source_cn":"为了奖励你们，我赐予你们无上的殊荣——<style=h...","status":"matched","hash_xxh64":"0x1BF43E294EFC1FD9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1511453005:0":{"text":"妾に勝利した者を、猟血祭の勝者とし、神の力を授けようぞ。","source_cn":"战胜我之人，将成为猎血节的胜者，获得我赐下的神力。","status":"matched","hash_xxh64":"0xDD4C7BEA5935F804","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1511453006:0":{"text":"挑む……神に？","source_cn":"挑战……神？！","status":"matched","hash_xxh64":"0x178623961004D364","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1511453006":{"text":"挑む……神に？","source_cn":"挑战……神？！","status":"matched","hash_xxh64":"0x178623961004D364","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1511453007:0":{"text":"か弱きしもべよ、何を迷うておる？そなたらの信心と武勇を、妾に示してみせよ！","source_cn":"软弱无用的仆从，犹豫什么？向我证明你们的虔诚和勇武！","status":"matched","hash_xxh64":"0x7CCB8707823E67ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1511453008:0":{"text":"……はっ！","source_cn":"……是！","status":"matched","hash_xxh64":"0x0D7CF9AF25CA9511","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1511453009:0":{"text":"待て！ダンヌ――","source_cn":"等等！顿——！","status":"matched","hash_xxh64":"0xEFE0C003F0273659","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511452001:":{"text":"しっかりしろ。行くぞ。","source_cn":"别再伤心了，走吧","status":"matched","hash_xxh64":"0x5C0CD586E640713D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511452002:":{"text":"じゅ、獣群の主……！？","source_cn":"是……是兽群之主！","status":"matched","hash_xxh64":"0x417902575433F379","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:21:1511452003:":{"text":"ヤクボルの月……","source_cn":"雅库伯尔之月…