{"asset_key":"timeline/quest_story_15114190","episode":"timeline","category":"quest_story","story_id":"15114190","schema_version":1,"lang":"jp","texts":{"cinematic_dialogue:2:1511418001:":{"text":"諦めなさい。","source_cn":"放弃挣扎吧","status":"matched","hash_xxh64":"0xAC10CBF7FB5C7C83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511418002:":{"text":"おれたちを惑わそうとしても無駄だ！","source_cn":"别想蛊惑我们！","status":"matched","hash_xxh64":"0x57A7D1E5D70F5A4C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511418003:":{"text":"あれは、ネフィルと……ルウ！？","source_cn":"那非和……露？！","status":"matched_runtime_gender","hash_xxh64":"0x615038B79330B841","variant_status":"runtime_gender_keys_target_same","male":"あれは、ネフィルと……ルウ！？","female":"あれは、ネフィルと……ルウ！？","variant_male_record_index":"190953","variant_female_record_index":"190954","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511420001:":{"text":"魔法が使えない！？","source_cn":"怎么回事？！","status":"matched_runtime_gender","hash_xxh64":"0xECEBD5C8CB078A2C","variant_status":"runtime_gender_keys_target_same","male":"魔法が使えない！？","female":"魔法が使えない！？","variant_male_record_index":"191000","variant_female_record_index":"191001","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1511420002:":{"text":"誰だ！？","source_cn":"谁在说话？","status":"matched","hash_xxh64":"0xF2A126E771F47FE1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document