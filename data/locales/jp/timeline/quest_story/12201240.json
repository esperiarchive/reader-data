{"asset_key":"timeline/quest_story_12201240","episode":"timeline","category":"quest_story","story_id":"12201240","schema_version":1,"lang":"jp","texts":{"say:5:1220124001:0":{"text":"……サ……セシ……","source_cn":"……萨……赛西……","status":"matched","hash_xxh64":"0x1C95B0E235D02D1D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1220124002:0":{"text":"まったく！こんなに待たせるなんてヒドいじゃないの！","source_cn":"真是的，居然让我等了这么久！","status":"matched","hash_xxh64":"0xB02198FA7930AC39","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1220124003:0":{"text":"ア……ア……","source_cn":"啊……啊……","status":"matched","hash_xxh64":"0xE884EE72FDDD0CFE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1220124004:0":{"text":"……ええ、私も会いたかったわ。","source_cn":"……嗯，我也很想你。","status":"matched","hash_xxh64":"0x141D5A7ACDD93DFF","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1220124005:0":{"text":"ほら！二人ともこんな姿になってしまったんだから、今更逃げる必要もないでしょう？","source_cn":"你瞧，我们现在都已经是这个样子了，就别再逃跑啦？","status":"matched","hash_xxh64":"0xBE43B169D64DF261","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1220124006:0":{"text":"……セシ……リア……","s