回る。","variant_male_record_index":"183131","variant_female_record_index":"183132","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1521012005:0":{"text":"中身は何ですか？","source_cn":"包裹里面是什么？","status":"matched","hash_xxh64":"0x2C4355DFFBD63BC8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1521012006:0":{"text":"ふふん、それは秘密――\nっておい！誰が開けていいと言った！？","source_cn":"哼哼，那就是秘——\\n哎！你怎么可以擅自打开！","status":"matched","hash_xxh64":"0x4A04044CAEC7AEB5","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1521012007:1":{"text":"ガーラが荷物を開けると、中から大量のライ麦パンや服が出てきた……","source_cn":"加拉打开包裹，数量可观的黑面包和保暖衣物争先恐后地涌了...","status":"matched","hash_xxh64":"0x536709E4986D0D1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1521012008:0":{"text":"……","source_cn":"……<key:dialog99>","status":"matched","hash_xxh64":"0xEA6DA3CF1C181486","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:13:1521012008":{"text":"……","source_cn":"……","status":"matched","hash_xxh64":"0xEA6DA3CF1C181486","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_ti