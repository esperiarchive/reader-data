{"asset_key":"timeline/quest_story_13221160","episode":"timeline","category":"quest_story","story_id":"13221160","schema_version":1,"lang":"jp","texts":{"cinematic_dialogue:2:1322115001:":{"text":"女神様……","source_cn":"女神啊……","status":"matched","hash_xxh64":"0xB9B1000F3820762C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1322115002:":{"text":"どうか、彼らに永遠の安らぎを。","source_cn":"请赐下永恒的安息","status":"matched","hash_xxh64":"0x9A2B4FC526464571","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1322115003:":{"text":"死者の魂に――","source_cn":"让所有逝者的灵魂","status":"matched","hash_xxh64":"0xCADD2919254AD538","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1322115004:":{"text":"祝福と安寧を与えたまえ……","source_cn":"得到祝福与安宁……","status":"matched","hash_xxh64":"0xED7930FEE3B29DA8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1322116001:1":{"text":"な、何の音です？……そこにいるのは誰ですか！？","source_cn":"奇怪，什么声音……谁！谁在那里？！","status":"matched","hash_xxh64":"0x169F8DB279AF7A2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1322116002:1":{"text":"あなたは……葬儀に参列される方ですか？なぜ突然墓地の裏から……？先ほど見回りしたときは誰もいなかったはず……","source_cn":"咦，这位女士，你是来参加葬礼仪式的吗？为什么会突然从墓...","status":"matched","hash_xxh64":"0xE099580131DD0877","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1322116003:1":{"text":"私は……","source_cn":"我……<key:dialog31>","status":"matched","hash_xxh64":"0x842BD49F1E0099A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1322116004:1":{"text":"ま、待てください……その顔色……まるで生きた屍のように白い――ま、まさか、人間じゃない！？","source_cn":"等等……你、你的脸色……苍白得和活死人一样！你——你不...","status":"matched","hash_xxh64":"0xFFB57ECA6982AAC0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1322116005:1":{"text":"な！？生きた屍！？は、早く彼女を止めて！みんなが危ない！","source_cn":"什么，活死人？！快……快拦住她，不要让她伤害这里的人！","status":"matched","hash_xxh64":"0xD91BA7DFFB4521AB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1322116006:1":{"text":"警告、脅威を発見！","source_cn":"警告，发现威胁！","status":"matched","hash_xxh64":"0x5995F2AD780DD859","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1322116007:1":{"text":"カーシャを、守る。脅威、排除！","source_cn":"必须清除！保护，小卡莎！","status":"matched","hash_xxh64":"0xC39A0F780DA8B9F3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1322116008:1":{"text":"な、何ですかあれは！？あ、あなたたち、一体何をするつもりです！？ああ、デューラ様！","source_cn":"艾雅啊！这……这是什么东西……你……你们要干什么！","status":"matched","hash_xxh64":"0x17B4705845241F2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1322116009:1":{"text":"やめてください、お兄様！彼らを傷つけてはだめです！","source_cn":"铐兰哥哥，快住手！不要伤害他们！","status":"matched","hash_xxh64":"0x2598C0ABE18D8C9B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1322116010:1":{"text":"カタストロフ……カタストロフの眷族です！皆さん、早く逃げてください！","source_cn":"恶魔……他们肯定是恶魔的眷属！大家快跑、快跑啊！！","status":"matched","hash_xxh64":"0x9B8107B616D3B01F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1322117001:":{"text":"カタストロフの眷族です！早く逃げて！","source_cn":"恶魔眷属来了！快跑啊！","status":"matched","hash_xxh64":"0xCA12F5891F420E86","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1322117002:":{"text":"に、逃げろ！カタストロフだ！","source_cn":"快跑！恶魔出现了！","status":"matched","hash_xxh64":"0x88CC81DFC50FA0AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:18:1322117003:":{"text":"ああ、デューラ様、どうか我々をお救いください！","source_cn":"艾雅在上，救救我们！","status":"matched","hash_xxh64":"0x8A1FF4AEF6028917","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:20:13050313:0":{"text":"カレリーナを守ろうと現れたゴーランを見て、怖がった人々が逃げ出した。","source_cn":"铐兰出现保护卡列琳娜，却意外吓跑了所有的民众。","status":"matched","hash_xxh64":"0x1865D919CA834B66","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:21:13050312:0":{"text":"人々が死者のために祈っていると、二人の修道者が同じく祈りに来たカレリーナに気づいた。","source_cn":"众人正为亡者祈祷时，两位修士发现了前来祈祷的卡列琳娜。","status":"matched","hash_xxh64":"0xB0AC1C15A21BDB07","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:修士马克西姆":{"text":"修道士のマクシム","source":"修士马克西姆","status":"matched_dialogue_flow"},"speaker:修士费尔德南":{"text":"フェルディナン","source":"修士费尔德南","status":"matched_dialogue_flow"},"speaker:修女特里莎":{"text":"シスターのテリーサ","source":"修女特里莎","status":"matched_dialogue_flow"},"speaker:卡列琳娜":{"text":"カレリーナ","source":"卡列琳娜","status":"matched_dialogue_flow"},"speaker:铐兰":{"text":"ゴーラン","source":"铐兰","status":"matched_dialogue_flow"},"speaker:参加葬礼的男子":{"text":"男の参列者","source":"参加葬礼的男子","status":"matched_dialogue_flow"},"speaker:参加葬礼的老人":{"text":"年老いた参列者","source":"参加葬礼的老人","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"黒画面字幕","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count