rd_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1521043035:0":{"text":"彼らは本当に、あなたたちが思っているような、獣なのかを……","source_cn":"去亲眼看看，雅库伯尔人是不是和你们想的一样，是野兽。","status":"matched","hash_xxh64":"0x4E17EB148F0D5A8E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1521043036:0":{"text":"……そ、それは考えたことがなかったな。","source_cn":"……我、我没想过。","status":"matched","hash_xxh64":"0x427AF00EB6B2877A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:39:1521043037:0":{"text":"余は彼らの長ではないし……姿や格好が違いすぎる。服を着替えただけで紛れ込めるような場所ではないだろう。","source_cn":"我不是他们的首领。而且……我们太不一样了。我没办法普普...","status":"matched","hash_xxh64":"0xBBEC028AE1F733FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1521043038:0":{"text":"もし、それができるとしたら？","source_cn":"如果可以呢？","status":"matched","hash_xxh64":"0x9AA3D103763C2982","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:41:1521043039:0":{"text":"できるとしたら……","source_cn":"如果可以……","status":"matched","hash_xxh64":"0x2CC10C0263A1CB69","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1521043