{"asset_key":"mn2/quest_story_10115120","episode":"mn2","category":"quest_story","story_id":"10115120","schema_version":1,"lang":"jp","texts":{"cinematic_dialogue:2:1011513001:":{"text":"エルーナです。","source_cn":"是艾洛娜","status":"matched","hash_xxh64":"0x6F555E66B2E28DB4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1011513002:":{"text":"ブライアンからの葉文……","source_cn":"布莱恩捎来一封叶信……","status":"matched","hash_xxh64":"0x911DA8A62232B1B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:2:1011513003:":{"text":"ブライアンがこの先の埠頭で待っているそうです！","source_cn":"让我们去前面的码头找他！","status":"matched","hash_xxh64":"0x11C18A2BD5B8F6FA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1011512001:1":{"text":"ああ！くそっ！イミル様……いや、イミルが流光の樹を腐敗させようとしてたなんて！","source_cn":"可恶……可恶！为什么想腐化流荧树的人是伊米尔？！","status":"matched","hash_xxh64":"0xC118DC91D9888044","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1011512002:0":{"text":"森を傷つけるなんて、ボクはもうあいつを賢者とは認めない！","source_cn":"做出伤害丛林的事，他已经不配被称为贤者了！","status":"matched","hash_xxh64":"0xB40047641E9D90D3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_s