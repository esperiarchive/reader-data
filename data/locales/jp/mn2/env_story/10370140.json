{"asset_key":"mn2/env_story_10370140","episode":"mn2","category":"env_story","story_id":"10370140","schema_version":1,"lang":"jp","texts":{"say:1:1037014001:1":{"text":"あたりを見張ってるんだ。","source_cn":"我在观察附近的情况。","status":"matched","hash_xxh64":"0xAA5AD82EF303AB89","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1037014002:1":{"text":"風語りの知らせで、何が起こったのかは分かったけど……","source_cn":"虽然风语者传来消息，告知了发生的一切。","status":"matched","hash_xxh64":"0xDC8630E5C1A20FB7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1037014003:1":{"text":"やっぱりまだ安心できなくてね。","source_cn":"但我还是有些不放心。","status":"matched","hash_xxh64":"0xD2CB4A5D3B24D364","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1037014004:1":{"text":"だからチェルットを村に帰らせて、僕はもう少し残って見張ることにしたんだよ。","source_cn":"所以我让契尔忒先回村子，自己留在这里再观察一阵子。","status":"matched","hash_xxh64":"0x2EAE13854B0DE5EC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:守卫美特苏尔":{"text":"守衛メッツァー","source":"守卫美特苏尔","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":1}}