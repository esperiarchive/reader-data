{"asset_key":"ep3/quest_story_13212020","episode":"ep3","category":"quest_story","story_id":"13212020","schema_version":1,"lang":"jp","texts":{"say:1:1321202001:1":{"text":"あっ！雪だるまがありますよ！","source_cn":"啊！那边有个雪人！","status":"matched","hash_xxh64":"0x921D3ED061E446ED","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1321202002:1":{"text":"今、何か喋ってませんでした……？","source_cn":"我好像听到它在说话……","status":"matched","hash_xxh64":"0xA7C60D0A373E83DB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1321202003:1":{"text":"それに、あの雪だるまどこかで……","source_cn":"看着有些眼熟啊。","status":"matched","hash_xxh64":"0x1B37614B51677709","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321202004:1":{"text":"ああっ！思い出した！お祭りのときの雪だるまですよ！","source_cn":"啊！我想起来了，这不是祭典上面的那个雪人吗！","status":"matched","hash_xxh64":"0xE17BC716812B984B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321202005:1":{"text":"あのメイジさんに魔法を付与されたんですよね。確か名前が……","source_cn":"那个魔法师激活了好多雪人……叫什么来着？","status":"matched","hash_xxh64":"0x4AF63CF78EF07A2B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1321202006:1":{"text":"――スヴァルフ！むやみに魔法を使ったせいで、雪だるまたちが暴走したのよ！","source_cn":"——维茨瓦夫！乱用魔法让雪人们都狂化了！","status":"matched","hash_xxh64":"0x689FF20A85D116DD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321202007:1":{"text":"お祭りで危うく人を傷つけるところだったわ……ここが辺鄙な場所でよかった。","source_cn":"幸好这里荒郊野岭，当时那些狂暴的雪人，太容易伤人了。","status":"matched","hash_xxh64":"0x84EB9E5AC9483C25","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1321202008:1":{"text":"マスター、早く魔法を解いてあげましょう！","source_cn":"主人，我们得赶紧消除它身上错误的魔法！","status":"matched_runtime_gender","hash_xxh64":"0x2A3F55332635E52E","variant_status":"runtime_gender_keys_target_same","male":"マスター、早く魔法を解いてあげましょう！","female":"マスター、早く魔法を解いてあげましょう！","variant_male_record_index":"145134","variant_female_record_index":"145135","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1321202009:1":{"text":"なに？人間……？それに二匹の喋るネズミ！","source_cn":"什么？有人类……还有两只会说话的老鼠！咱被发现了！","status":"matched","hash_xxh64":"0x0F46EC339817D4B6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1321202010:1":{"text":"しまった！花を見る前に捕まるわけにはいかない！","source_cn":"快跑快跑！咱还没见过花呢！可不能在这里被逮到。","status":"matched","hash_xxh64":"0x582B8F1C93DDD3E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:15:1321201001:":{"text":"ここにも花はないか……","source_cn":"这里怎么也没有野花啊……","status":"matched","hash_xxh64":"0xC1A3A07129BD7293","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:15:1321201002:":{"text":"雪だるまとして生きるのは大変だなぁ。","source_cn":"雪生艰难啊~","status":"matched","hash_xxh64":"0x9BEA87D3D1567628","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"cinematic_dialogue:15:1321201003:":{"text":"でも、解けるまでには必ず！","source_cn":"在化掉前，一定要看到！","status":"matched","hash_xxh64":"0x1E908C56036EAC99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:17:13021211:0":{"text":"祭典中に逃げ出した雪だるまを荒野で発見したが、あなたたちは再び取り逃がしてしまった。","source_cn":"你们在野外遇到一只从祭典上逃跑的雪人，却不小心把它吓跑了。","status":"matched","hash_xxh64":"0xD794A65A9DFD4FE9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"},"speaker:雪人":{"text":"雪だるま","source":"雪人","status":"matched_dialogue_flow"},"speaker:黑屏字幕":{"text":"黒画面字幕","source":"黑屏字幕","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":19,"localized_text_count":14,"speaker_count":4}}