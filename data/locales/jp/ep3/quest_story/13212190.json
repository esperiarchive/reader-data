{"asset_key":"ep3/quest_story_13212190","episode":"ep3","category":"quest_story","story_id":"13212190","schema_version":1,"lang":"jp","texts":{"say:1:1321219001:1":{"text":"誰もいない……ああ、やっぱり遅すぎたんだ！","source_cn":"完全没有看到人影……也许，还是晚了一步吧。","status":"matched","hash_xxh64":"0xB7C23B570357E6E4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1321219002:1":{"text":"だから陰気なことを言うな！まだ分からないだろ！","source_cn":"不许说丧气话！还没走到头呢！","status":"matched","hash_xxh64":"0x2C012DCCC36C6749","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1321219003:1":{"text":"足跡はあっちに向かっていますね。","source_cn":"唔，鞋印往那边去了。","status":"matched","hash_xxh64":"0x1F9AE6C53C15726E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1321219004:1":{"text":"これに沿って歩いてみましょう。","source_cn":"沿着这个方向再走走吧。","status":"matched","hash_xxh64":"0x01D58B7178FC0E4B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1321219005:1":{"text":"こんなのんびり歩いてたんじゃ、間に合わねぇぞ！","source_cn":"你们慢吞吞地，怎么来得及！","status":"matched","hash_xxh64":"0xB5F35EF46E6EF20A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1321219006:1":{"text":"絵を貸せ！オイラが先に行って探してきてやる！","source_cn":"把画给我，我帮你们先去看看！","status":"matched","hash_xxh64":"0x797D82682F938091","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1321219007:1":{"text":"僕の絵を……雪だるまなのに意外と力持ちだね！","source_cn":"我的画——这小雪人力气还真不小！","status":"matched","hash_xxh64":"0x8D09BC07FAADF9CD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1321219008:1":{"text":"あらら……一人で行っちゃいましたよ。","source_cn":"哎！一不留神就让它给跑了。","status":"matched","hash_xxh64":"0x5BA0CF1242684ADE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:画家派特":{"text":"画家のパルト","source":"画家派特","status":"matched_dialogue_flow"},"speaker:雪人":{"text":"雪だるま","source":"雪人","status":"matched_dialogue_flow"},"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"},"speaker:漫漫":{"text":"メイメイ","source":"漫漫","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":9,"localized_text_count":8,"speaker_count":4}}