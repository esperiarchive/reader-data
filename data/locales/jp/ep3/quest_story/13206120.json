cument_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1320612005:1":{"text":"だが、それもそろそろ限界なのだろう……","source_cn":"我想……他濒临极限，快坚持不下去了。","status":"matched","hash_xxh64":"0xF1F0B9335F3EA24B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1320612006:1":{"text":"そんな！一体誰がゴーランさんにこんな残酷なことを！？","source_cn":"怎么会这样，谁会对铐兰做出这么残忍的事情？！","status":"matched","hash_xxh64":"0xF2D3CE95E8349225","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1320612007:1":{"text":"カタストロフか、その眷族……？確かラジノフ家は、最前線で魔物と戦っていたのですよね？","source_cn":"会是恶魔或是眷属吗……？你说过，魔物大举入侵的时候，拉...","status":"matched","hash_xxh64":"0x646ADA5A712C6E98","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1320612008:1":{"text":"だとしたら、荘園に押し入った彼らが、報復にまだ生きていたゴーランさんを……","source_cn":"难道它们攻破拉季诺夫庄园之后，作为报复，他们把当时还活...","status":"matched","hash_xxh64":"0x2046D7F445CF500A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1320612009:1":{"text":"そ、それ以上は言わないで……！","source_cn":"请——请不要说了……！","status":"matched","hash_xxh64":"0x654021B1A2DD02DA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say