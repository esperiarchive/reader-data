nt_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:1310140006:1":{"text":"この季節は雪で滑りやすいし、山道も入り組んでいて危険だ。ホワイトマウンテンまでは馬車で運んでやれるけど、町へは徒歩で行くしかないよ。","source_cn":"不过这个季节白山一定会下雪。积雪湿滑，山路曲折危险，驿...","status":"matched","hash_xxh64":"0x626C6256FF1E93A3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1310140007:1":{"text":"ほほっ、問題ない！ホワイトマウンテンに行けるなら何だっていい！","source_cn":"嚯，走路无所谓，只要能到白山，什么都好说！","status":"matched","hash_xxh64":"0x3268FAE2933E2523","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:9:1310140008:1":{"text":"そういうことなら、早速馬車を手配しよう。必ず祭典が始まる前に送り届けるよ。","source_cn":"既然这样，那我就去安排驿车了。放心，一定在祭典开幕前把...","status":"matched","hash_xxh64":"0xE0681BC8B0BC388D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1310140009:1":{"text":"準備ができたら教えてくれ。","source_cn":"你们准备好了就来找我吧。","status":"matched","hash_xxh64":"0xAB8859E1CCFC3B9A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:满满":{"text":"ロンロン","source":"满满","status":"matched_dialogue_flow"},"speaker:秘银商人":{"text":"ミスリル商人","source":"秘银商人","status":"matched_dialogue_flow"},"speaker:呼金":{"text":"フーキン","source":"呼金","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":10,"localized_text_count":9,"speaker_count":3}}