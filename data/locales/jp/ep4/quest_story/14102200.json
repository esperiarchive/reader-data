variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:7:1410220006:0":{"text":"そう言って、フリン村長はその場を離れた。どうやらその「いい物」とやらを取りに行ったようだ。","source_cn":"弗林村长离开，看样子是准备亲自去取那件“好东西”","status":"matched","hash_xxh64":"0xA9362237130C6920","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:8:1410220007:1":{"text":"……友よ、どう思う？","source_cn":"……老朋友，你怎么看这位“新朋友”？","status":"matched_runtime_gender","hash_xxh64":"0xB4557D977CB47B3C","variant_status":"runtime_gender_keys_target_same","male":"……友よ、どう思う？","female":"……友よ、どう思う？","variant_male_record_index":"156234","variant_female_record_index":"156235","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:9:1410220007":{"text":"……友よ、どう思う？","source_cn":"……老朋友，你怎么看这位“新朋友”？","status":"matched_runtime_gender","hash_xxh64":"0xB4557D977CB47B3C","variant_status":"runtime_gender_keys_target_same","male":"……友よ、どう思う？","female":"……友よ、どう思う？","variant_male_record_index":"156234","variant_female_record_index":"156235","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:10:1410220008:1":{"text":"ああ、昼間に出会った職人や村人たちも、飾り気のない大らかな態度で接してくれていたが……","source_cn":"是啊。我们白天见到的工匠，在村里的村民，都是真的豪爽，...","status":"matched","hash_xxh64":"0x7605767C033EF191","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1410220009:1":{"text":"彼らのは「素」で、村長のは少し違うようだな。","source_cn":"但这位村长绝非如此。","status":"matched","hash_xxh64":"0xE3DFFB4B41CEC6F5","variant_status":"","male":