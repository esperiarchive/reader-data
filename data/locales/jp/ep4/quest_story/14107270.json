_female":"","document_title_cn":"","document_title_status":""},"say:16:1410727010:0":{"text":"そうだ。ミサタは、我らが川の水を飲むことも、日の光を浴びることも許さなかった。","source_cn":"正是。祂不允许我们饮用河川之水，不允许我们踏足光照之地。","status":"matched","hash_xxh64":"0xAC63D455B033D3E6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:0:1":{"text":"ミサタ……","source_cn":"弥萨忒……","status":"matched_runtime_gender","hash_xxh64":"0xC7DC3C239E7F4D00","variant_status":"runtime_gender_keys_target_same","male":"ミサタ……","female":"ミサタ……","variant_male_record_index":"71628","variant_female_record_index":"71629","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1410727011:0":{"text":"懐かしき我らの故郷……だがほんの些細な過失で、ミサタは我らの努力をすべて否定し、森から追放したのだ。","source_cn":"那里是我们的故乡，然而，只因一点小小的过失，我们的辛苦...","status":"matched","hash_xxh64":"0xE182C204C4E0EF17","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:14:1:2":{"text":"ユグドラシル……","source_cn":"薄暮丛林……","status":"matched_runtime_gender","hash_xxh64":"0x50A996D75DA45536","variant_status":"runtime_gender_keys_target_same","male":"ユグドラシル……","female":"ユグドラシル……","variant_male_record_index":"71630","variant_female_record_index":"71631","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:20:1410727012:0":{"text":"私たちの先祖が故郷を失ったのは、カタストロフに襲われたからではなく、神に追放されたから……？","source_cn":"我们的祖先之所以流离失所，并非故土被恶魔侵袭，而是被那...","status":"matched","hash_xxh64":"0x657C5827FA6219CC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_m