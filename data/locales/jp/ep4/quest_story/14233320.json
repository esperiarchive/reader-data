{"asset_key":"ep4/quest_story_14233320","episode":"ep4","category":"quest_story","story_id":"14233320","schema_version":1,"lang":"jp","texts":{"say:2:1423332001:1":{"text":"こんにちは！子どもたちの名前を呼んでいたようだけど、何かあったの？","source_cn":"您好！我听到您在叫孩子们的名字，这里的孩子怎么了？","status":"matched","hash_xxh64":"0xE2D3799EAC5A6E99","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1423332002:1":{"text":"うちのジェミーと村の子どもたちの姿が見えないの。森に入ってないか心配で……","source_cn":"我的孩子詹米和村里的几个小孩都跑得不见人影，我害怕他们...","status":"matched","hash_xxh64":"0xAAE37C8A4DA82A18","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1423332003:1":{"text":"もう、本当に世話が焼けるんだから！子どもたちだけで、万が一何かあったら……","source_cn":"真是不让人省心！没有大人在身边，遇到危险可怎么办……","status":"matched","hash_xxh64":"0x93B8EEAB0A77AE54","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1423332004:1":{"text":"焦らないで、私たちも一緒に探すわ！","source_cn":"您别着急，我们也来帮忙找孩子们！","status":"matched","hash_xxh64":"0x48BEB4EADFD4D48C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:欧罗娜":{"text":"オーロナ","source":"欧罗娜","status":"matched_dialogue_flow"},"speaker:平民胡丽诺":{"text":"平民のフリノ","source":"平民胡丽诺","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":5,"localized_text_count":4,"speaker_count":2}}