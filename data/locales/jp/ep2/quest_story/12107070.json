{"asset_key":"ep2/quest_story_12107070","episode":"ep2","category":"quest_story","story_id":"12107070","schema_version":1,"lang":"jp","texts":{"say:2:1210707001:0":{"text":"おい、そこのお前たち！こっちに来い！","source_cn":"站住！你们几个，过来！","status":"matched","hash_xxh64":"0x8A9927C59887CDD4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1210707002:0":{"text":"見たことない顔だな。どこのもんだ？","source_cn":"我没见过你们，混哪条道上的。","status":"matched","hash_xxh64":"0x984986CD73E3CFDD","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1210707003:0":{"text":"おや？ライクさんじゃないっすか！最近調子どうです？","source_cn":"啊，这不是我莱克大哥吗？最近手气怎么样？","status":"matched","hash_xxh64":"0xEBEAA7D622AA91C0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1210707004:0":{"text":"お前は……？","source_cn":"你是……？","status":"matched","hash_xxh64":"0xF106FBDC8E0BD674","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1210707005:0":{"text":"シンドバッドですよ！一緒に海ネズミを捕まえたのを忘れたんっすか？ライクさんは海ネズミに顔を這われて――","source_cn":"辛巴！我们一起抓过水耗子的，忘了？您不是还被水耗子爬了脸？","status":"matched","hash_xxh64":"0xB6B1A92E162DC3C7","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:7:121070700