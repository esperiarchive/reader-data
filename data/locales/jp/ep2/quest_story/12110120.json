{"asset_key":"ep2/quest_story_12110120","episode":"ep2","category":"quest_story","story_id":"12110120","schema_version":1,"lang":"jp","texts":{"say:1:1211012001:0":{"text":"グワワワワ！","source_cn":"咕哇哇哇哇！","status":"matched","hash_xxh64":"0x66CE7E076D3C3086","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1211012002:0":{"text":"またグブリン！マスター、下がっていてください！ロンロンが皆さんを守りま――","source_cn":"又是咕布林！主人，你们退后！满满来保护你们——","status":"matched_runtime_gender","hash_xxh64":"0xFADE5C2F467D89A7","variant_status":"runtime_gender_keys_target_same","male":"またグブリン！マスター、下がっていてください！ロンロンが皆さんを守りま――","female":"またグブリン！マスター、下がっていてください！ロンロンが皆さんを守りま――","variant_male_record_index":"129279","variant_female_record_index":"129280","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1211012003:1":{"text":"ググ！人！人だ！試練だ！","source_cn":"咕咕！人！人！人来试炼！","status":"matched","hash_xxh64":"0x9D0B9A2A603AAD80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice_prompt:5:1211012003":{"text":"ググ！人！人だ！試練だ！","source_cn":"咕咕！人！人！人来试炼！","status":"matched","hash_xxh64":"0x9D0B9A2A603AAD80","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1211012005:0":{"text":"試練、魚！<style=\"highlight\">三種の魚</style>！","source_cn":"试炼，鱼！<style=highlight>三种鱼</...","status":"matched","hash_xxh64":"0x134D18FC8ADDC713","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","docum