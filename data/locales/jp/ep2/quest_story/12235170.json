"0x1932D08B036E0448","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:12:1223517010:1":{"text":"で、でも……ブラッディ・マリーのところなんて、自ら捕まりに行くようなものだろ！？","source_cn":"但是、但是……让我去找血薇帮要解药，不就等于自投罗网？！","status":"matched","hash_xxh64":"0xC1F65655BB3A281C","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:13:1223517011:1":{"text":"そう、行って罪を認めるのです！そうすれば命は助かる！","source_cn":"没错，你必须乖乖认罪！才能保命！","status":"matched","hash_xxh64":"0xABE9E5F67BA003FB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:14:1223517012:1":{"text":"くそっ、それを甘んじて受け入れろと……！","source_cn":"可恶，不甘心啊……！","status":"matched","hash_xxh64":"0xB984EC677760DCF6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1223517013:1":{"text":"死んでしまえば復讐もくそもないだろ？","source_cn":"命都没了还谈什么报仇？","status":"matched","hash_xxh64":"0xE3562ADFC85684B8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:19:1223517014:1":{"text":"お前には解毒剤が不要でも、俺たちは欲しいんだよ！","source_cn":"没错啊，你不要解药，我们要！","status":"matched","hash_xxh64":"0x177EF6DC30716C83","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title"