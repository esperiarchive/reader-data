{"asset_key":"ep2/env_story_12311590","episode":"ep2","category":"env_story","story_id":"12311590","schema_version":1,"lang":"jp","texts":{"say:1:1231159001:1":{"text":"そりゃあもう、たくさんあるわよ！","source_cn":"我不习惯的地方可太多了！","status":"matched","hash_xxh64":"0x13EA54692B9ACAE3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1231159002:1":{"text":"まずはこの宿屋のサービスね。いろんなところに行ったけど、こんなにサービスの悪い宿屋は初めてよ。","source_cn":"首先就是这家旅馆的服务，我去了那么多地方，还没见过服务...","status":"matched","hash_xxh64":"0xBA835BF5D7FF7987","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1231159003:1":{"text":"あとは部屋のベッドよ。宿泊してから一度も干してくれないの！絞ったら水が出てくるくらいよ！","source_cn":"还有房间的床铺，自我入住，从来都没干过！简直可以拧出水来！","status":"matched","hash_xxh64":"0x30B3625DE0069681","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:旅行家文斯":{"text":"旅人ヴィンス","source":"旅行家文斯","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":4,"localized_text_count":3,"speaker_count":1}}