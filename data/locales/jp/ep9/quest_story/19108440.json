{"asset_key":"ep9/quest_story_19108440","episode":"ep9","category":"quest_story","story_id":"19108440","schema_version":1,"lang":"jp","texts":{"say:1:1910844001:1":{"text":"あたしは、エフィラ。","source_cn":"我是艾菲拉。","status":"matched","hash_xxh64":"0x6508F92F69088BFC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:2:1910844002:1":{"text":"タラサの民、リトラの娘！","source_cn":"塔拉萨的子民，浅海裔的女儿！","status":"matched","hash_xxh64":"0xD3FBA311F05E2426","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:3:1910844003:1":{"text":"いいえ、違うわ……！私から離れないで、私の意志を拒まないで！","source_cn":"不……！别离开我，别抗拒我的意志！","status":"matched","hash_xxh64":"0x6F95EEFEFB2840AA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:4:1910844004:1":{"text":"あなたは私の一部、私たちは一つなのよ！","source_cn":"你是我的一部分，我们是一体！","status":"matched","hash_xxh64":"0x617378112BA4E433","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:5:1910844005:1":{"text":"自分を見捨てるなんて……できないよ。","source_cn":"我怎么能……抛弃……自己？","status":"matched","hash_xxh64":"0x26576082A7E6AC2D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:6:1910844006:1":{"text":"月が……光ってる……","source_cn":"月亮……