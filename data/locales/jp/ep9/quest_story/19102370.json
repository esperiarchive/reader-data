le_cn":"","document_title_status":""},"say:53:1910237043:0":{"text":"想，爬高……去天上。","source_cn":"想，爬高……去天上。","status":"hash_not_found","hash_xxh64":"0xB935B69E2970B8B2","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:54:1910237044:1":{"text":"年幼的海裔呆呆地盯着图澜的头顶，然后……竟然灵活地爬了上去！","source_cn":"年幼的海裔呆呆地盯着图澜的头顶，然后……竟然灵活地爬了上去！","status":"hash_not_found","hash_xxh64":"0x27386F0CED245077","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:55:1910237045:1":{"text":"像……骑水行器。","source_cn":"像……骑水行器。","status":"hash_not_found","hash_xxh64":"0x8FA69EE9D916D472","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:56:1910237046:1":{"text":"哈？小崽子，你把咱当成水行器骑？","source_cn":"哈？小崽子，你把咱当成水行器骑？","status":"hash_not_found","hash_xxh64":"0xA670E8A21BC5AFEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:57:1910237047:1":{"text":"嘴上这么说着，但图澜却真的装作水行器，背上年幼的小海裔...","source_cn":"嘴上这么说着，但图澜却真的装作水行器，背上年幼的小海裔...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:58:1910237048:1":{"text":"塔拉萨，神秘的海中之城……在这里，你需要探索的事情还有...","source_cn":"塔拉萨，神秘的海中之城……在这里，你需要探索的事情还有...","status":"truncated_preview","hash_xxh64":"","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"narration:59:1910237049:0":{"text":"你们沉浸在欢乐之中，直到一声巨响，打破了此刻难得的安宁","source_cn":"你们沉浸在欢乐之中，直到一声巨响，打破了此刻难得的安宁","status":"hash_not_found","hash_xxh64":"0xEB585E69AC4A6575","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:15:0:1":{"text":"我要来十份！","source_cn":"我要来十份！","status":"hash_not_found","hash_xxh64":"0x2869585FB0CE7E9F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:61:1910237015:1":{"text":"呵呵，那在阿嬷眼里，也都还是孩子。来，多吃点！","source_cn":"呵呵，那在阿嬷眼里，也都还是孩子。来，多吃点！","status":"hash_not_found","hash_xxh64":"0x55E349758B490A7E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:15:1:2":{"text":"其实我已经不在发育期了……","source_cn":"其实我已经不在发育期了……","status":"hash_not_found","hash_xxh64":"0x0441EBC02857C989","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:1910237002":{"text":"1910237002","source":"1910237002","status":"source"},"speaker:1910237003":{"text":"1910237003","source":"1910237003","status":"source"},"speaker:1910237004":{"text":"1910237004","source":"1910237004"