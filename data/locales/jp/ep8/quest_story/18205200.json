_cn":"","document_title_status":""},"say:28:1820520020:0":{"text":"……まだ信じられないなら、私と勝負しろ。","source_cn":"……不信的话，就和我比试一场。","status":"matched","hash_xxh64":"0x2192B5DBBF729260","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:29:1820520021:0":{"text":"待って、セイン！","source_cn":"等等！瑟恩——！","status":"matched","hash_xxh64":"0x9DC2F8C2D3E4914D","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:30:1820520022:0":{"text":"もうっ……レナード、この剣を受け取って！","source_cn":"真讨厌……里纳，接住这把剑！","status":"matched","hash_xxh64":"0x57024B64E0419BE4","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""}},"speakers":{"speaker:里纳":{"text":"レナード","source":"里纳","status":"matched_dialogue_flow"},"speaker:爱丝特瑞达":{"text":"セリス","source":"爱丝特瑞达","status":"matched_dialogue_flow"},"speaker:瑟恩":{"text":"セイン","source":"瑟恩","status":"matched_dialogue_flow"},"speaker:旁白":{"text":"ナレーション","source":"旁白","status":"matched_dialogue_flow"}},"stats":{"flow_row_count":23,"localized_text_count":22,"speaker_count":4}}