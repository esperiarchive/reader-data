cord_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:11:1121222011:0":{"text":"それができればとっくにしてるわよ。彼女、ほぼ隠居状態だから、どこにいるかさっぱり分からないの。","source_cn":"要是能联系上，我早就告诉你了。她一直在隐居，我并不知道...","status":"matched","hash_xxh64":"0x3CAC5BBF97725B70","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:15:1121222012:0":{"text":"ホーガン将軍！逃げたブラックゴールドの残党を捕まえました！","source_cn":"霍根将军！我们抓住了逃跑的黑金残党！","status":"matched","hash_xxh64":"0xAC0DCE1369889CD1","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:17:1121222013:2":{"text":"汚い手をどけろ！偽善ぶった騎士どもめ！俺たちはイルシカ様に育てられた精鋭だぞ！死んでも屈してたまるか！","source_cn":"把你的脏手拿开！虚伪的骑士！我们可是伊露西卡女士培养的...","status":"matched","hash_xxh64":"0x38EF7E9687730388","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:18:1121222014:2":{"text":"殺すならさっさと殺せ！お前らがアルファⅪにしたのと同じようにな！","source_cn":"赶紧拿走我的性命吧！就像你们对阿尔法十一做的那样！","status":"matched","hash_xxh64":"0xDA6D6292A26CB0E0","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:21:1121222015:0":{"text":"誤解しているようだが、我々はあの子に危害を加えてなどいない。","source_cn":"你猜错了，我们没有伤害那姑娘。","status":"matched","hash_xxh64":"0x42005E9B5A4E6FDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","documen