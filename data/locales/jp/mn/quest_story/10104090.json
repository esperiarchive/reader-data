","hash_xxh64":"0x917FAD97DFC545F8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:70:1010409047:0":{"text":"それなら、一人心当たりがあるぜ。","source_cn":"我猜，说不定有一个人可以。","status":"matched","hash_xxh64":"0x30B7FB821ADBBE82","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:72:1010409048:0":{"text":"その通り。あのお坊ちゃんなら力になってくれるかも。\nさっそくミスリル商会に行こう。","source_cn":"没错，那位高贵的小少爷也许有办法。\\n我们动身去秘银商...","status":"matched","hash_xxh64":"0x968AD7789EADC314","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:71:0:1":{"text":"ロワンを探そう。","source_cn":"去找罗万","status":"matched_runtime_gender","hash_xxh64":"0xD0F079663EBCCE40","variant_status":"runtime_gender_keys_target_differs","male":"ロワンを探そう。","female":"ロワンを探しましょう。","variant_male_record_index":"58740","variant_female_record_index":"58741","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"choice:66:0:1":{"text":"罠だな。","source_cn":"有阴谋","status":"matched_runtime_gender","hash_xxh64":"0x7E83C0C055B42373","variant_status":"runtime_gender_keys_target_differs","male":"罠だな。","female":"罠ね。","variant_male_record_index":"58736","variant_female_record_index":"58737","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:74:1010409044:0":{"text":"お金持ちはいいですねぇ……適当な理由をつければ、いくらでも宴を開けるのですから。","source_cn":"真羡慕有钱人呀……随便找个理由，就能举办宴会。","status":"matched","hash_xxh64":"0x9512D0F2198574FB