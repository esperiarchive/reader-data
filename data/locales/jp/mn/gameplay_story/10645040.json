ument_title_status":""},"say:35:1064504021:0":{"text":"グォ……グオオォォッ！！","source_cn":"嗬——！！","status":"matched","hash_xxh64":"0xC636999ED87AF2A8","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:36:1064504022:1":{"text":"バルトーク先生、気をつけろ……","source_cn":"巴托克先生，小心……","status":"matched","hash_xxh64":"0xB9BF3DBC54A7796F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:37:1064504023:0":{"text":"――ディッチさん！","source_cn":"——蒂奇！","status":"matched","hash_xxh64":"0xBCE44C48533ABB63","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:38:1064504024:0":{"text":"お、俺に構うな……！続けろ……ぐっ……","source_cn":"别、别管我！继续……呃……","status":"matched","hash_xxh64":"0xB271C0FD2C6658CA","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:40:1064504025:1":{"text":"魔物はディッチを踏みつけ、そのままバルトークへ猛然と突っ込んだ――","source_cn":"魔物踏过蒂奇，狠狠冲向巴托克——","status":"matched","hash_xxh64":"0xFB75B791E2412DDB","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:42:1064504026:0":{"text":"雑音が、聞こえてきますわね。","source_cn":"失序的噪音，到此为止。","status":"matched","hash_xxh64":"0x5E4D1DA2DD3CDD1E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:43:1064504027:1":{"text":"シルフィスが悠然とバルトークの傍らへ歩み寄る。その足取りは一歩ごとに美しい拍を刻み、魔物までもが動きを止めた。","source_cn":"奥菲戈斯从容地走到巴托克声旁，一步一拍，在伴随她而来的...","status":"matched","hash_xxh64":"0x0DA41083D3773641","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:44:1064504028:0":{"text":"……し、シルフィス様！","source_cn":"……奥、奥菲戈斯女士！","status":"matched","hash_xxh64":"0x9E8C8E0FA078BC67","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:45:1064504029:0":{"text":"わたくしは以前、調和の音を選ぶのは人自身だと申しました。今、その答えをしかと聞き届けましたわ。","source_cn":"我曾说过，凡人必须自己选择和谐之声。如今，我听到了你们...","status":"matched","hash_xxh64":"0xF59FEEF6849829A6","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:46:1064504030:0":{"text":"恐れることはありません。演奏に集中するのです。","source_cn":"不必惊惶，专心演奏。","status":"matched","hash_xxh64":"0xEA9FC0934DE75F7F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:47:1064504031:0":{"text":"……はい！","source_cn":"……是！","status":"matched","hash_xxh64":"0x8216977961D15CDE","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:49:1064504032:0":{"text":"シルフィスが音叉を軽く鳴らすと、その澄んだ響きが正確な拍を刻んだ。\nバルトークもまた弦を弾き、シルフィスの旋律に合わせて奏でる。","source_cn":"奥菲戈斯举起音叉，轻轻一振，为演奏划下精准的节拍。\\n...","status":"matched","hash_xxh64":"0x11B8F00C6CDF5A2F","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:50:1064504033:0":{"text":"ワルツが響き始めた――三拍子の軽やかで優雅なリズムに、立ち尽くしていた魔物はぎこちなく体を揺らし、そのまま静かに消えていった。","source_cn":"圆舞曲响起——3/4拍的节奏轻快而优雅，怔住的魔物仿佛...","status":"matched","hash_xxh64":"0x1653F2177041532A","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:51:1064504034:0":{"text":"正気を取り戻した人々も、音楽に合わせて次々と踊り始める。ついにはブラックゴールドのメンバーまで、武器を下して、音楽に身を委ね始めた。","source_cn":"清醒后的民众纷纷随乐声共舞华尔兹，就连黑金成员们也纷纷...","status":"matched","hash_xxh64":"0x1CFF8BA1C46C913B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:54:1064504035:0":{"text":"なんだ……青い川が見える……","source_cn":"我好像看到了一条蓝色的河流……","status":"matched","hash_xxh64":"0xDE7B3382203360A9","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:55:1064504036:0":{"text":"きれい……これが……本当の音楽……","source_cn":"好美……这……这才是音乐……","status":"matched","hash_xxh64":"0xD7B3A45B77E79BEC","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:58:1064504037:0":{"text":"馬鹿か、お前ら！何をしてやがる！？","source_cn":"蠢货，你们在干什么？！","status":"matched","hash_xxh64":"0xFE47595AC53D989B","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:59:1064504038:0":{"text":"どいつもこいつも、役立たずめ……！こうなったら、深淵の楽章を一気にクライマックスへ持っていくぞ！","source_cn":"废物，都是废物！既然这样，就让深渊的乐章提前进入高潮吧！","status":"matched","hash_xxh64":"0x26BE7B5C5514D719","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:60:1064504039:1":{"text":"リラは再び、狂ったように戦鼓を打ち鳴らした。大地が震え、先ほどよりも遥かに巨大な魔物が次々と姿を現した。","source_cn":"利拉以更疯狂的力量捶打起战鼓，地面剧烈震颤，数只比先前...","status":"matched","hash_xxh64":"0x1F9E4AD7AD26A932","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:62:1064504040:0":{"text":"グオオオオッ！ギィィィィ――ッ！","source_cn":"吼吼吼！嘶嘶嘶嘶——！！！","status":"matched","hash_xxh64":"0x3CFA2E7E1AB0FA5E","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:66:1064504041:0":{"text":"まだ演奏の途中だというのに、随分と無粋な振る舞いですわね。","source_cn":"在演奏尚未结束时制造噪音，可是相当失礼的行为。","status":"matched","hash_xxh64":"0x931EAC1125363DC3","variant_status":"","male":"","female":"","variant_male_record_index":"","variant_female_record_index":"","document_title":"","document_title_male":"","document_title_female":"","document_title_cn":"","document_title_status":""},"say:67:1064504042:0":{"text":"これほど調和を乱す雑音には、こ