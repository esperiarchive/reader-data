rce_node_id":"17","runtime_scope":"ep4/quest_story_14211410","instruction":{"op":"continue"},"next":"runtime:18"},"runtime:18":{"id":"runtime:18","type":"runtime","source_node_id":"18","runtime_scope":"ep4/quest_story_14211410","instruction":{"op":"continue"},"next":"line:18:say:1421141006:1"},"runtime:18:after":{"id":"runtime:18:after","type":"runtime","source_node_id":"18","runtime_scope":"ep4/quest_story_14211410","instruction":{"op":"continue"},"next":"runtime:19"},"runtime:19":{"id":"runtime:19","type":"runtime","source_node_id":"19","runtime_scope":"ep4/quest_story_14211410","instruction":{"op":"continue"},"next":"line:19:say:1421141007:1"},"runtime:19:after":{"id":"runtime:19:after","type":"runtime","source_node_id":"19","runtime_scope":"ep4/quest_story_14211410","instruction":{"op":"continue"},"next":"runtime:20"},"runtime:20":{"id":"runtime:20","type":"runtime","source_node_id":"20","runtime_scope":"ep4/quest_story_14211410","instruction":{"op":"continue"},"next":"runtime:end"},"runtime:end":{"id":"runtime:end","type":"end","runtime_scope":"ep4/quest_story_14211410"}},"text_entries":{"document:3:192:0":{"key":"document:3:192:0","kind":"document","source_node_id":"3","source_node_type":"__DT.ActionNode","statementID":"","action_index":"0","choice_index":"","choice_id":"","source_cn":"<style=\"highlight\">沙利叶的绝妙特调·星与夜的低语</style>\n净化后的<style=\"highlight\">暗泉水</style>犹如夜晚般深沉幽雅。而<style=\"highlight\">幻晶盐粉</style>的加入，不仅让它的口感愈发清淡，又让它仿佛闪烁着点点璀璨的星光。\n最终，倒入<style=\"highlight\">秘制基酒</style>，以高超的手法进行调制——\n看吧，它诞生了！它的外形就已然足够美丽，尤其适合在暗处欣赏。\n轻轻摇晃酒杯，那摇曳的绚丽星彩几乎能在入口前就令人为之沉醉。\n而那柔和甜蜜的风味与清淡的口感，也完全不会造成任何饮用障碍，不由自主地就会让人一杯接着一杯。\n但务必要注意！它可是一杯货真价实的高度烈性酒，甚至能点燃火苗！","textdes_id":"192","document_page_count":"1","document_title_cn":"沙利叶特调秘方","document_order":"1","document_object_id":"0","document_item_id":"4801710","document_icon":"UI/Icon/Item/item_quest_mapstory_item17.png","document_image_icon":"","document_base_image":"UI/Prefabs/StoryReadItem/items/pbui_map_story_detail_item17.prefab","